        \cup { [ZeroTesUploadBroadcast EXCEPT !.underlyingMaturityDate = one] : one \in Sample(4) }
        \cup { [ZeroTesUploadBroadcast EXCEPT !.relatedTradeId = one] : one \in Sample(4) }
        \cup { [ZeroTesUploadBroadcast EXCEPT !.relatedMarketSegmentId = one] : one \in Sample(4) }
        \cup { [ZeroTesUploadBroadcast EXCEPT !.trdType = one] : one \in Sample(2) }
        \cup { [ZeroTesUploadBroadcast EXCEPT !.productComplex = one] : one \in Sample(1) }
        \cup { [ZeroTesUploadBroadcast EXCEPT !.tradeReportType = one] : one \in Sample(1) }
        \cup { [ZeroTesUploadBroadcast EXCEPT !.trdRptStatus = one] : one \in Sample(1) }
        \cup { [ZeroTesUploadBroadcast EXCEPT !.tradePublishIndicator = one] : one \in Sample(1) }
        \cup { [ZeroTesUploadBroadcast EXCEPT !.tradePlatform = one] : one \in Sample(1) }
        \cup { [ZeroTesUploadBroadcast EXCEPT !.hedgeType = one] : one \in Sample(1) }
        \cup { [ZeroTesUploadBroadcast EXCEPT !.partyIdSettlementLocation = one] : one \in Sample(1) }
        \cup { [ZeroTesUploadBroadcast EXCEPT !.messageEventSource = one] : one \in Sample(1) }
        \cup { [ZeroTesUploadBroadcast EXCEPT !.tradeReportId = one] : one \in Sample(20) }
        \cup { [ZeroTesUploadBroadcast EXCEPT !.rootPartyExecutingFirm = one] : one \in Sample(5) }
        \cup { [ZeroTesUploadBroadcast EXCEPT !.rootPartyExecutingTrader = one] : one \in Sample(6) }
        \cup { [ZeroTesUploadBroadcast EXCEPT !.underlyingSecurityId = one] : one \in Sample(12) }
        \cup { [ZeroTesUploadBroadcast EXCEPT !.underlyingSecurityDesc = one] : one \in Sample(30) }
