      ordStatus                 : Sample(1),
      execType                  : Sample(1),
      execRestatementReason     : Sample(2),
      crossedIndicator          : Sample(1),
      productComplex            : Sample(1),
      triggered                 : Sample(1),
      transactionDelayIndicator : Sample(1) ]

