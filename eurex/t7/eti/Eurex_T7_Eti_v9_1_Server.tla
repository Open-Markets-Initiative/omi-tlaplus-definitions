      partitionId                |-> [i \in 1 .. 2 |-> 0],
      matchingEngineStatus       |-> [i \in 1 .. 1 |-> 0],
      tradeManagerStatus         |-> [i \in 1 .. 1 |-> 0],
      applSeqStatus              |-> [i \in 1 .. 1 |-> 0],
      t7EntryServiceStatus       |-> [i \in 1 .. 1 |-> 0],
      t7EntryServiceRtmStatus    |-> [i \in 1 .. 1 |-> 0],
      pad5                       |-> [i \in 1 .. 5 |-> 0] ]

