(***************************************************************************)
EXTENDS Integers, Sequences

(***************************************************************************)
(* Wire primitives                                                         *)
(***************************************************************************)

Byte == 0 .. 255

(* An unsigned integer, least significant byte first. Read only where a rule *)
(* depends on the value: a length, a count, a message type. *)
RECURSIVE DecodeUIntLE(_)
DecodeUIntLE(bytes) ==
    IF bytes = << >>
    THEN 0
    ELSE Head(bytes) + 256 * DecodeUIntLE(Tail(bytes))

RECURSIVE EncodeUIntLE(_, _)
EncodeUIntLE(value, width) ==
    IF width = 0
    THEN << >>
    ELSE <<value % 256>> \o EncodeUIntLE(value \div 256, width - 1)

(* The same, most significant byte first, which is how a big endian protocol writes it *)
RECURSIVE DecodeUIntBE(_)
DecodeUIntBE(bytes) ==
    IF bytes = << >>
    THEN 0
    ELSE DecodeUIntBE(SubSeq(bytes, 1, Len(bytes) - 1)) * 256 + bytes[Len(bytes)]

RECURSIVE EncodeUIntBE(_, _)
EncodeUIntBE(value, width) ==
    IF width = 0
    THEN << >>
    ELSE EncodeUIntBE(value \div 256, width - 1) \o <<value % 256>>

(***************************************************************************)
(* A decoder yields the value it read and the bytes left, or fails         *)
(***************************************************************************)

Fail == [ok |-> FALSE]
Ok(value, rest) == [ok |-> TRUE, value |-> value, rest |-> rest]

(* The bytes a field of this width occupies, kept as they lie *)
ReadBytes(bytes, width) ==
    IF Len(bytes) < width
    THEN Fail
    ELSE Ok(SubSeq(bytes, 1, width), SubSeq(bytes, width + 1, Len(bytes)))

(* The integer a rule depends on, in the byte order the field states *)
ReadUIntLE(bytes, width) ==
    IF Len(bytes) < width
    THEN Fail
    ELSE Ok(DecodeUIntLE(SubSeq(bytes, 1, width)), SubSeq(bytes, width + 1, Len(bytes)))

ReadUIntBE(bytes, width) ==
    IF Len(bytes) < width
    THEN Fail
    ELSE Ok(DecodeUIntBE(SubSeq(bytes, 1, width)), SubSeq(bytes, width + 1, Len(bytes)))

(***************************************************************************)
(* The values a field is checked at: zero, the spaces a text field is      *)
(* padded with, and                                                        *)
(* every bit set, which is where an encoding goes wrong if it goes wrong   *)
(***************************************************************************)

Sample(width) ==
    { [i \in 1 .. width |-> 0],
      [i \in 1 .. width |-> 32],
      [i \in 1 .. width |-> 255] }

(* The bytes a field of no width of its own is checked at: none, one, and a short run *)
SampleBytes == { << >>, <<0>>, <<32, 255>> }

(* The lists a record is checked over: none, one, and a run of two. What a run has *)
(* to get right is reading one entry after another, which two of a kind already say. *)
SampleLists(entries) ==
    { << >> }
        \cup { <<one>> : one \in entries }
        \cup { <<one, one>> : one \in entries }

(***************************************************************************)
(* Nr Response Header Me Comp: 48 bytes                                    *)
(***************************************************************************)

NrResponseHeaderMeComp ==
    [ requestTime     : Sample(8),
      trdRegTsTimeIn  : Sample(8),
      trdRegTsTimeOut : Sample(8),
      responseIn      : Sample(8),
      sendingTime     : Sample(8),
      msgSeqNum       : Sample(4),
      lastFragment    : Sample(1),
      pad3            : Sample(3) ]

EncodeNrResponseHeaderMeComp(message) ==
    message.requestTime
        \o message.trdRegTsTimeIn
        \o message.trdRegTsTimeOut
        \o message.responseIn
        \o message.sendingTime
        \o message.msgSeqNum
        \o message.lastFragment
        \o message.pad3

DecodeNrResponseHeaderMeComp(bytes) ==
    LET requestTime == ReadBytes(bytes, 8) IN IF ~requestTime.ok THEN Fail ELSE
    LET trdRegTsTimeIn == ReadBytes(requestTime.rest, 8) IN IF ~trdRegTsTimeIn.ok THEN Fail ELSE
    LET trdRegTsTimeOut == ReadBytes(trdRegTsTimeIn.rest, 8) IN IF ~trdRegTsTimeOut.ok THEN Fail ELSE
    LET responseIn == ReadBytes(trdRegTsTimeOut.rest, 8) IN IF ~responseIn.ok THEN Fail ELSE
    LET sendingTime == ReadBytes(responseIn.rest, 8) IN IF ~sendingTime.ok THEN Fail ELSE
    LET msgSeqNum == ReadBytes(sendingTime.rest, 4) IN IF ~msgSeqNum.ok THEN Fail ELSE
    LET lastFragment == ReadBytes(msgSeqNum.rest, 1) IN IF ~lastFragment.ok THEN Fail ELSE
    LET pad3 == ReadBytes(lastFragment.rest, 3) IN IF ~pad3.ok THEN Fail ELSE
    Ok([ requestTime     |-> requestTime.value,
         trdRegTsTimeIn  |-> trdRegTsTimeIn.value,
         trdRegTsTimeOut |-> trdRegTsTimeOut.value,
         responseIn      |-> responseIn.value,
         sendingTime     |-> sendingTime.value,
         msgSeqNum       |-> msgSeqNum.value,
         lastFragment    |-> lastFragment.value,
         pad3            |-> pad3.value ], pad3.rest)

ZeroNrResponseHeaderMeComp ==
    [ requestTime     |-> [i \in 1 .. 8 |-> 0],
      trdRegTsTimeIn  |-> [i \in 1 .. 8 |-> 0],
      trdRegTsTimeOut |-> [i \in 1 .. 8 |-> 0],
      responseIn      |-> [i \in 1 .. 8 |-> 0],
      sendingTime     |-> [i \in 1 .. 8 |-> 0],
      msgSeqNum       |-> [i \in 1 .. 4 |-> 0],
      lastFragment    |-> [i \in 1 .. 1 |-> 0],
      pad3            |-> [i \in 1 .. 3 |-> 0] ]

(* Nr Response Header Me Comp at zero, then each field in turn at the values it is checked at *)
CheckedNrResponseHeaderMeComp ==
    { ZeroNrResponseHeaderMeComp }
        \cup { [ZeroNrResponseHeaderMeComp EXCEPT !.requestTime = one] : one \in Sample(8) }
        \cup { [ZeroNrResponseHeaderMeComp EXCEPT !.trdRegTsTimeIn = one] : one \in Sample(8) }
        \cup { [ZeroNrResponseHeaderMeComp EXCEPT !.trdRegTsTimeOut = one] : one \in Sample(8) }
        \cup { [ZeroNrResponseHeaderMeComp EXCEPT !.responseIn = one] : one \in Sample(8) }
        \cup { [ZeroNrResponseHeaderMeComp EXCEPT !.sendingTime = one] : one \in Sample(8) }
        \cup { [ZeroNrResponseHeaderMeComp EXCEPT !.msgSeqNum = one] : one \in Sample(4) }
        \cup { [ZeroNrResponseHeaderMeComp EXCEPT !.lastFragment = one] : one \in Sample(1) }
        \cup { [ZeroNrResponseHeaderMeComp EXCEPT !.pad3 = one] : one \in Sample(3) }

(***************************************************************************)
(* Instrmt Leg Grp Comp: 32 bytes                                          *)
(***************************************************************************)

InstrmtLegGrpComp ==
    [ legSecurityId   : Sample(8),
      legPrice        : Sample(8),
      legSymbol       : Sample(4),
      legRatioQty     : Sample(4),
      legSide         : Sample(1),
      legSecurityType : Sample(1),
      pad6            : Sample(6) ]

EncodeInstrmtLegGrpComp(message) ==
    message.legSecurityId
        \o message.legPrice
        \o message.legSymbol
        \o message.legRatioQty
        \o message.legSide
        \o message.legSecurityType
        \o message.pad6

DecodeInstrmtLegGrpComp(bytes) ==
    LET legSecurityId == ReadBytes(bytes, 8) IN IF ~legSecurityId.ok THEN Fail ELSE
    LET legPrice == ReadBytes(legSecurityId.rest, 8) IN IF ~legPrice.ok THEN Fail ELSE
    LET legSymbol == ReadBytes(legPrice.rest, 4) IN IF ~legSymbol.ok THEN Fail ELSE
    LET legRatioQty == ReadBytes(legSymbol.rest, 4) IN IF ~legRatioQty.ok THEN Fail ELSE
    LET legSide == ReadBytes(legRatioQty.rest, 1) IN IF ~legSide.ok THEN Fail ELSE
    LET legSecurityType == ReadBytes(legSide.rest, 1) IN IF ~legSecurityType.ok THEN Fail ELSE
    LET pad6 == ReadBytes(legSecurityType.rest, 6) IN IF ~pad6.ok THEN Fail ELSE
    Ok([ legSecurityId   |-> legSecurityId.value,
         legPrice        |-> legPrice.value,
         legSymbol       |-> legSymbol.value,
         legRatioQty     |-> legRatioQty.value,
         legSide         |-> legSide.value,
         legSecurityType |-> legSecurityType.value,
         pad6            |-> pad6.value ], pad6.rest)

ZeroInstrmtLegGrpComp ==
    [ legSecurityId   |-> [i \in 1 .. 8 |-> 0],
      legPrice        |-> [i \in 1 .. 8 |-> 0],
      legSymbol       |-> [i \in 1 .. 4 |-> 0],
      legRatioQty     |-> [i \in 1 .. 4 |-> 0],
      legSide         |-> [i \in 1 .. 1 |-> 0],
      legSecurityType |-> [i \in 1 .. 1 |-> 0],
      pad6            |-> [i \in 1 .. 6 |-> 0] ]

(* Instrmt Leg Grp Comp at zero, then each field in turn at the values it is checked at *)
CheckedInstrmtLegGrpComp ==
    { ZeroInstrmtLegGrpComp }
        \cup { [ZeroInstrmtLegGrpComp EXCEPT !.legSecurityId = one] : one \in Sample(8) }
        \cup { [ZeroInstrmtLegGrpComp EXCEPT !.legPrice = one] : one \in Sample(8) }
        \cup { [ZeroInstrmtLegGrpComp EXCEPT !.legSymbol = one] : one \in Sample(4) }
        \cup { [ZeroInstrmtLegGrpComp EXCEPT !.legRatioQty = one] : one \in Sample(4) }
        \cup { [ZeroInstrmtLegGrpComp EXCEPT !.legSide = one] : one \in Sample(1) }
        \cup { [ZeroInstrmtLegGrpComp EXCEPT !.legSecurityType = one] : one \in Sample(1) }
        \cup { [ZeroInstrmtLegGrpComp EXCEPT !.pad6 = one] : one \in Sample(6) }

(* A run of Instrmt Leg Grp Comp, written one after another *)
RECURSIVE EncodeInstrmtLegGrpCompList(_)
EncodeInstrmtLegGrpCompList(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeInstrmtLegGrpComp(Head(messages)) \o EncodeInstrmtLegGrpCompList(Tail(messages))

(* As many Instrmt Leg Grp Comp as the field that counts them says *)
RECURSIVE ReadInstrmtLegGrpCompList(_, _)
ReadInstrmtLegGrpCompList(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeInstrmtLegGrpComp(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadInstrmtLegGrpCompList(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Instrmt Leg Grp Comp of each kind, for the lists that carry them *)
OneInstrmtLegGrpComp == { ZeroInstrmtLegGrpComp }

(***************************************************************************)
(* Add Complex Instrument Response                                         *)
(***************************************************************************)

AddComplexInstrumentResponse ==
    [ pad2                   : Sample(2),
      nrResponseHeaderMeComp : NrResponseHeaderMeComp,
      lowLimitPrice          : Sample(8),
      highLimitPrice         : Sample(8),
      securityId             : Sample(8),
      lastUpdateTime         : Sample(8),
      securityResponseId     : Sample(8),
      marketSegmentId        : Sample(4),
      numberOfSecurities     : Sample(4),
      securitySubType        : Sample(4),
      multilegModel          : Sample(1),
      impliedMarketIndicator : Sample(1),
      productComplex         : Sample(1),
      instrmtLegGrpComp      : SampleLists(OneInstrmtLegGrpComp) ]

EncodeAddComplexInstrumentResponse(message) ==
    message.pad2
        \o EncodeNrResponseHeaderMeComp(message.nrResponseHeaderMeComp)
        \o message.lowLimitPrice
        \o message.highLimitPrice
        \o message.securityId
        \o message.lastUpdateTime
        \o message.securityResponseId
        \o message.marketSegmentId
        \o message.numberOfSecurities
        \o message.securitySubType
        \o message.multilegModel
        \o message.impliedMarketIndicator
        \o message.productComplex
        \o EncodeUIntBE(Len(message.instrmtLegGrpComp), 1)
        \o EncodeInstrmtLegGrpCompList(message.instrmtLegGrpComp)

DecodeAddComplexInstrumentResponse(bytes) ==
    LET pad2 == ReadBytes(bytes, 2) IN IF ~pad2.ok THEN Fail ELSE
    LET nrResponseHeaderMeComp == DecodeNrResponseHeaderMeComp(pad2.rest) IN IF ~nrResponseHeaderMeComp.ok THEN Fail ELSE
    LET lowLimitPrice == ReadBytes(nrResponseHeaderMeComp.rest, 8) IN IF ~lowLimitPrice.ok THEN Fail ELSE
    LET highLimitPrice == ReadBytes(lowLimitPrice.rest, 8) IN IF ~highLimitPrice.ok THEN Fail ELSE
    LET securityId == ReadBytes(highLimitPrice.rest, 8) IN IF ~securityId.ok THEN Fail ELSE
    LET lastUpdateTime == ReadBytes(securityId.rest, 8) IN IF ~lastUpdateTime.ok THEN Fail ELSE
    LET securityResponseId == ReadBytes(lastUpdateTime.rest, 8) IN IF ~securityResponseId.ok THEN Fail ELSE
    LET marketSegmentId == ReadBytes(securityResponseId.rest, 4) IN IF ~marketSegmentId.ok THEN Fail ELSE
    LET numberOfSecurities == ReadBytes(marketSegmentId.rest, 4) IN IF ~numberOfSecurities.ok THEN Fail ELSE
    LET securitySubType == ReadBytes(numberOfSecurities.rest, 4) IN IF ~securitySubType.ok THEN Fail ELSE
    LET multilegModel == ReadBytes(securitySubType.rest, 1) IN IF ~multilegModel.ok THEN Fail ELSE
    LET impliedMarketIndicator == ReadBytes(multilegModel.rest, 1) IN IF ~impliedMarketIndicator.ok THEN Fail ELSE
    LET productComplex == ReadBytes(impliedMarketIndicator.rest, 1) IN IF ~productComplex.ok THEN Fail ELSE
    LET noLegs == ReadUIntBE(productComplex.rest, 1) IN IF ~noLegs.ok THEN Fail ELSE
    LET instrmtLegGrpComp == ReadInstrmtLegGrpCompList(noLegs.rest, noLegs.value) IN IF ~instrmtLegGrpComp.ok THEN Fail ELSE
    Ok([ pad2                   |-> pad2.value,
         nrResponseHeaderMeComp |-> nrResponseHeaderMeComp.value,
         lowLimitPrice          |-> lowLimitPrice.value,
         highLimitPrice         |-> highLimitPrice.value,
         securityId             |-> securityId.value,
         lastUpdateTime         |-> lastUpdateTime.value,
         securityResponseId     |-> securityResponseId.value,
         marketSegmentId        |-> marketSegmentId.value,
         numberOfSecurities     |-> numberOfSecurities.value,
         securitySubType        |-> securitySubType.value,
         multilegModel          |-> multilegModel.value,
         impliedMarketIndicator |-> impliedMarketIndicator.value,
         productComplex         |-> productComplex.value,
         instrmtLegGrpComp      |-> instrmtLegGrpComp.value ], instrmtLegGrpComp.rest)

ZeroAddComplexInstrumentResponse ==
    [ pad2                   |-> [i \in 1 .. 2 |-> 0],
      nrResponseHeaderMeComp |-> ZeroNrResponseHeaderMeComp,
      lowLimitPrice          |-> [i \in 1 .. 8 |-> 0],
      highLimitPrice         |-> [i \in 1 .. 8 |-> 0],
      securityId             |-> [i \in 1 .. 8 |-> 0],
      lastUpdateTime         |-> [i \in 1 .. 8 |-> 0],
      securityResponseId     |-> [i \in 1 .. 8 |-> 0],
      marketSegmentId        |-> [i \in 1 .. 4 |-> 0],
      numberOfSecurities     |-> [i \in 1 .. 4 |-> 0],
      securitySubType        |-> [i \in 1 .. 4 |-> 0],
      multilegModel          |-> [i \in 1 .. 1 |-> 0],
      impliedMarketIndicator |-> [i \in 1 .. 1 |-> 0],
      productComplex         |-> [i \in 1 .. 1 |-> 0],
      instrmtLegGrpComp      |-> << >> ]

(* Add Complex Instrument Response at zero, then each field in turn at the values it is checked at *)
CheckedAddComplexInstrumentResponse ==
    { ZeroAddComplexInstrumentResponse }
        \cup { [ZeroAddComplexInstrumentResponse EXCEPT !.pad2 = one] : one \in Sample(2) }
        \cup { [ZeroAddComplexInstrumentResponse EXCEPT !.nrResponseHeaderMeComp = one] : one \in CheckedNrResponseHeaderMeComp }
        \cup { [ZeroAddComplexInstrumentResponse EXCEPT !.lowLimitPrice = one] : one \in Sample(8) }
        \cup { [ZeroAddComplexInstrumentResponse EXCEPT !.highLimitPrice = one] : one \in Sample(8) }
        \cup { [ZeroAddComplexInstrumentResponse EXCEPT !.securityId = one] : one \in Sample(8) }
        \cup { [ZeroAddComplexInstrumentResponse EXCEPT !.lastUpdateTime = one] : one \in Sample(8) }
        \cup { [ZeroAddComplexInstrumentResponse EXCEPT !.securityResponseId = one] : one \in Sample(8) }
        \cup { [ZeroAddComplexInstrumentResponse EXCEPT !.marketSegmentId = one] : one \in Sample(4) }
        \cup { [ZeroAddComplexInstrumentResponse EXCEPT !.numberOfSecurities = one] : one \in Sample(4) }
        \cup { [ZeroAddComplexInstrumentResponse EXCEPT !.securitySubType = one] : one \in Sample(4) }
        \cup { [ZeroAddComplexInstrumentResponse EXCEPT !.multilegModel = one] : one \in Sample(1) }
        \cup { [ZeroAddComplexInstrumentResponse EXCEPT !.impliedMarketIndicator = one] : one \in Sample(1) }
        \cup { [ZeroAddComplexInstrumentResponse EXCEPT !.productComplex = one] : one \in Sample(1) }
        \cup { [ZeroAddComplexInstrumentResponse EXCEPT !.instrmtLegGrpComp = one] : one \in SampleLists(OneInstrmtLegGrpComp) }

(***************************************************************************)
(* Nr Response Header Me Comp: 48 bytes                                    *)
(***************************************************************************)

NrResponseHeaderMeComp2 ==
    [ requestTime     : Sample(8),
      trdRegTsTimeIn  : Sample(8),
      trdRegTsTimeOut : Sample(8),
      responseIn      : Sample(8),
      sendingTime     : Sample(8),
      msgSeqNum       : Sample(4),
      lastFragment    : Sample(1),
      pad3            : Sample(3) ]

EncodeNrResponseHeaderMeComp2(message) ==
    message.requestTime
        \o message.trdRegTsTimeIn
        \o message.trdRegTsTimeOut
        \o message.responseIn
        \o message.sendingTime
        \o message.msgSeqNum
        \o message.lastFragment
        \o message.pad3

DecodeNrResponseHeaderMeComp2(bytes) ==
    LET requestTime == ReadBytes(bytes, 8) IN IF ~requestTime.ok THEN Fail ELSE
    LET trdRegTsTimeIn == ReadBytes(requestTime.rest, 8) IN IF ~trdRegTsTimeIn.ok THEN Fail ELSE
    LET trdRegTsTimeOut == ReadBytes(trdRegTsTimeIn.rest, 8) IN IF ~trdRegTsTimeOut.ok THEN Fail ELSE
    LET responseIn == ReadBytes(trdRegTsTimeOut.rest, 8) IN IF ~responseIn.ok THEN Fail ELSE
    LET sendingTime == ReadBytes(responseIn.rest, 8) IN IF ~sendingTime.ok THEN Fail ELSE
    LET msgSeqNum == ReadBytes(sendingTime.rest, 4) IN IF ~msgSeqNum.ok THEN Fail ELSE
    LET lastFragment == ReadBytes(msgSeqNum.rest, 1) IN IF ~lastFragment.ok THEN Fail ELSE
    LET pad3 == ReadBytes(lastFragment.rest, 3) IN IF ~pad3.ok THEN Fail ELSE
    Ok([ requestTime     |-> requestTime.value,
         trdRegTsTimeIn  |-> trdRegTsTimeIn.value,
         trdRegTsTimeOut |-> trdRegTsTimeOut.value,
         responseIn      |-> responseIn.value,
         sendingTime     |-> sendingTime.value,
         msgSeqNum       |-> msgSeqNum.value,
         lastFragment    |-> lastFragment.value,
         pad3            |-> pad3.value ], pad3.rest)

ZeroNrResponseHeaderMeComp2 ==
    [ requestTime     |-> [i \in 1 .. 8 |-> 0],
      trdRegTsTimeIn  |-> [i \in 1 .. 8 |-> 0],
      trdRegTsTimeOut |-> [i \in 1 .. 8 |-> 0],
      responseIn      |-> [i \in 1 .. 8 |-> 0],
      sendingTime     |-> [i \in 1 .. 8 |-> 0],
      msgSeqNum       |-> [i \in 1 .. 4 |-> 0],
      lastFragment    |-> [i \in 1 .. 1 |-> 0],
      pad3            |-> [i \in 1 .. 3 |-> 0] ]

(* Nr Response Header Me Comp at zero, then each field in turn at the values it is checked at *)
CheckedNrResponseHeaderMeComp2 ==
    { ZeroNrResponseHeaderMeComp2 }
        \cup { [ZeroNrResponseHeaderMeComp2 EXCEPT !.requestTime = one] : one \in Sample(8) }
        \cup { [ZeroNrResponseHeaderMeComp2 EXCEPT !.trdRegTsTimeIn = one] : one \in Sample(8) }
        \cup { [ZeroNrResponseHeaderMeComp2 EXCEPT !.trdRegTsTimeOut = one] : one \in Sample(8) }
        \cup { [ZeroNrResponseHeaderMeComp2 EXCEPT !.responseIn = one] : one \in Sample(8) }
        \cup { [ZeroNrResponseHeaderMeComp2 EXCEPT !.sendingTime = one] : one \in Sample(8) }
        \cup { [ZeroNrResponseHeaderMeComp2 EXCEPT !.msgSeqNum = one] : one \in Sample(4) }
        \cup { [ZeroNrResponseHeaderMeComp2 EXCEPT !.lastFragment = one] : one \in Sample(1) }
        \cup { [ZeroNrResponseHeaderMeComp2 EXCEPT !.pad3 = one] : one \in Sample(3) }

(***************************************************************************)
(* Add Flexible Instrument Response: 90 bytes                              *)
(***************************************************************************)

AddFlexibleInstrumentResponse ==
    [ pad2                   : Sample(2),
      nrResponseHeaderMeComp : NrResponseHeaderMeComp2,
      securityResponseId     : Sample(8),
      securityId             : Sample(8),
      strikePrice            : Sample(8),
      marketSegmentId        : Sample(4),
      maturityDate           : Sample(4),
      productComplex         : Sample(1),
      settlMethod            : Sample(1),
      optAttribute           : Sample(1),
      putOrCall              : Sample(1),
      exerciseStyle          : Sample(1),
      pad3                   : Sample(3) ]

EncodeAddFlexibleInstrumentResponse(message) ==
    message.pad2
        \o EncodeNrResponseHeaderMeComp2(message.nrResponseHeaderMeComp)
        \o message.securityResponseId
        \o message.securityId
        \o message.strikePrice
        \o message.marketSegmentId
        \o message.maturityDate
        \o message.productComplex
        \o message.settlMethod
        \o message.optAttribute
        \o message.putOrCall
        \o message.exerciseStyle
        \o message.pad3

DecodeAddFlexibleInstrumentResponse(bytes) ==
    LET pad2 == ReadBytes(bytes, 2) IN IF ~pad2.ok THEN Fail ELSE
    LET nrResponseHeaderMeComp == DecodeNrResponseHeaderMeComp2(pad2.rest) IN IF ~nrResponseHeaderMeComp.ok THEN Fail ELSE
    LET securityResponseId == ReadBytes(nrResponseHeaderMeComp.rest, 8) IN IF ~securityResponseId.ok THEN Fail ELSE
    LET securityId == ReadBytes(securityResponseId.rest, 8) IN IF ~securityId.ok THEN Fail ELSE
    LET strikePrice == ReadBytes(securityId.rest, 8) IN IF ~strikePrice.ok THEN Fail ELSE
    LET marketSegmentId == ReadBytes(strikePrice.rest, 4) IN IF ~marketSegmentId.ok THEN Fail ELSE
    LET maturityDate == ReadBytes(marketSegmentId.rest, 4) IN IF ~maturityDate.ok THEN Fail ELSE
    LET productComplex == ReadBytes(maturityDate.rest, 1) IN IF ~productComplex.ok THEN Fail ELSE
    LET settlMethod == ReadBytes(productComplex.rest, 1) IN IF ~settlMethod.ok THEN Fail ELSE
    LET optAttribute == ReadBytes(settlMethod.rest, 1) IN IF ~optAttribute.ok THEN Fail ELSE
    LET putOrCall == ReadBytes(optAttribute.rest, 1) IN IF ~putOrCall.ok THEN Fail ELSE
    LET exerciseStyle == ReadBytes(putOrCall.rest, 1) IN IF ~exerciseStyle.ok THEN Fail ELSE
    LET pad3 == ReadBytes(exerciseStyle.rest, 3) IN IF ~pad3.ok THEN Fail ELSE
    Ok([ pad2                   |-> pad2.value,
         nrResponseHeaderMeComp |-> nrResponseHeaderMeComp.value,
         securityResponseId     |-> securityResponseId.value,
         securityId             |-> securityId.value,
         strikePrice            |-> strikePrice.value,
         marketSegmentId        |-> marketSegmentId.value,
         maturityDate           |-> maturityDate.value,
         productComplex         |-> productComplex.value,
         settlMethod            |-> settlMethod.value,
         optAttribute           |-> optAttribute.value,
         putOrCall              |-> putOrCall.value,
         exerciseStyle          |-> exerciseStyle.value,
         pad3                   |-> pad3.value ], pad3.rest)

ZeroAddFlexibleInstrumentResponse ==
    [ pad2                   |-> [i \in 1 .. 2 |-> 0],
      nrResponseHeaderMeComp |-> ZeroNrResponseHeaderMeComp2,
      securityResponseId     |-> [i \in 1 .. 8 |-> 0],
      securityId             |-> [i \in 1 .. 8 |-> 0],
      strikePrice            |-> [i \in 1 .. 8 |-> 0],
      marketSegmentId        |-> [i \in 1 .. 4 |-> 0],
      maturityDate           |-> [i \in 1 .. 4 |-> 0],
      productComplex         |-> [i \in 1 .. 1 |-> 0],
      settlMethod            |-> [i \in 1 .. 1 |-> 0],
      optAttribute           |-> [i \in 1 .. 1 |-> 0],
      putOrCall              |-> [i \in 1 .. 1 |-> 0],
      exerciseStyle          |-> [i \in 1 .. 1 |-> 0],
      pad3                   |-> [i \in 1 .. 3 |-> 0] ]

(* Add Flexible Instrument Response at zero, then each field in turn at the values it is checked at *)
CheckedAddFlexibleInstrumentResponse ==
    { ZeroAddFlexibleInstrumentResponse }
        \cup { [ZeroAddFlexibleInstrumentResponse EXCEPT !.pad2 = one] : one \in Sample(2) }
        \cup { [ZeroAddFlexibleInstrumentResponse EXCEPT !.nrResponseHeaderMeComp = one] : one \in CheckedNrResponseHeaderMeComp2 }
        \cup { [ZeroAddFlexibleInstrumentResponse EXCEPT !.securityResponseId = one] : one \in Sample(8) }
        \cup { [ZeroAddFlexibleInstrumentResponse EXCEPT !.securityId = one] : one \in Sample(8) }
        \cup { [ZeroAddFlexibleInstrumentResponse EXCEPT !.strikePrice = one] : one \in Sample(8) }
        \cup { [ZeroAddFlexibleInstrumentResponse EXCEPT !.marketSegmentId = one] : one \in Sample(4) }
        \cup { [ZeroAddFlexibleInstrumentResponse EXCEPT !.maturityDate = one] : one \in Sample(4) }
        \cup { [ZeroAddFlexibleInstrumentResponse EXCEPT !.productComplex = one] : one \in Sample(1) }
        \cup { [ZeroAddFlexibleInstrumentResponse EXCEPT !.settlMethod = one] : one \in Sample(1) }
        \cup { [ZeroAddFlexibleInstrumentResponse EXCEPT !.optAttribute = one] : one \in Sample(1) }
        \cup { [ZeroAddFlexibleInstrumentResponse EXCEPT !.putOrCall = one] : one \in Sample(1) }
        \cup { [ZeroAddFlexibleInstrumentResponse EXCEPT !.exerciseStyle = one] : one \in Sample(1) }
        \cup { [ZeroAddFlexibleInstrumentResponse EXCEPT !.pad3 = one] : one \in Sample(3) }

(***************************************************************************)
(* Rbc Header Comp: 32 bytes                                               *)
(***************************************************************************)

RbcHeaderComp ==
    [ sendingTime    : Sample(8),
      applSeqNum     : Sample(8),
      applSubId      : Sample(4),
      partitionId    : Sample(2),
      applResendFlag : Sample(1),
      applId         : Sample(1),
      lastFragment   : Sample(1),
      pad7           : Sample(7) ]

EncodeRbcHeaderComp(message) ==
    message.sendingTime
        \o message.applSeqNum
        \o message.applSubId
        \o message.partitionId
        \o message.applResendFlag
        \o message.applId
        \o message.lastFragment
        \o message.pad7

DecodeRbcHeaderComp(bytes) ==
    LET sendingTime == ReadBytes(bytes, 8) IN IF ~sendingTime.ok THEN Fail ELSE
    LET applSeqNum == ReadBytes(sendingTime.rest, 8) IN IF ~applSeqNum.ok THEN Fail ELSE
    LET applSubId == ReadBytes(applSeqNum.rest, 4) IN IF ~applSubId.ok THEN Fail ELSE
    LET partitionId == ReadBytes(applSubId.rest, 2) IN IF ~partitionId.ok THEN Fail ELSE
    LET applResendFlag == ReadBytes(partitionId.rest, 1) IN IF ~applResendFlag.ok THEN Fail ELSE
    LET applId == ReadBytes(applResendFlag.rest, 1) IN IF ~applId.ok THEN Fail ELSE
    LET lastFragment == ReadBytes(applId.rest, 1) IN IF ~lastFragment.ok THEN Fail ELSE
    LET pad7 == ReadBytes(lastFragment.rest, 7) IN IF ~pad7.ok THEN Fail ELSE
    Ok([ sendingTime    |-> sendingTime.value,
         applSeqNum     |-> applSeqNum.value,
         applSubId      |-> applSubId.value,
         partitionId    |-> partitionId.value,
         applResendFlag |-> applResendFlag.value,
         applId         |-> applId.value,
         lastFragment   |-> lastFragment.value,
         pad7           |-> pad7.value ], pad7.rest)

ZeroRbcHeaderComp ==
    [ sendingTime    |-> [i \in 1 .. 8 |-> 0],
      applSeqNum     |-> [i \in 1 .. 8 |-> 0],
      applSubId      |-> [i \in 1 .. 4 |-> 0],
      partitionId    |-> [i \in 1 .. 2 |-> 0],
      applResendFlag |-> [i \in 1 .. 1 |-> 0],
      applId         |-> [i \in 1 .. 1 |-> 0],
      lastFragment   |-> [i \in 1 .. 1 |-> 0],
      pad7           |-> [i \in 1 .. 7 |-> 0] ]

(* Rbc Header Comp at zero, then each field in turn at the values it is checked at *)
CheckedRbcHeaderComp ==
    { ZeroRbcHeaderComp }
        \cup { [ZeroRbcHeaderComp EXCEPT !.sendingTime = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderComp EXCEPT !.applSeqNum = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderComp EXCEPT !.applSubId = one] : one \in Sample(4) }
        \cup { [ZeroRbcHeaderComp EXCEPT !.partitionId = one] : one \in Sample(2) }
        \cup { [ZeroRbcHeaderComp EXCEPT !.applResendFlag = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp EXCEPT !.applId = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp EXCEPT !.lastFragment = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp EXCEPT !.pad7 = one] : one \in Sample(7) }

(***************************************************************************)
(* Basket Root Party Grp Comp: 40 bytes                                    *)
(***************************************************************************)

BasketRootPartyGrpComp ==
    [ rootPartySubIdType      : Sample(2),
      rootPartyContraFirm     : Sample(5),
      rootPartyContraTrader   : Sample(6),
      basketSideTradeReportId : Sample(20),
      pad7                    : Sample(7) ]

EncodeBasketRootPartyGrpComp(message) ==
    message.rootPartySubIdType
        \o message.rootPartyContraFirm
        \o message.rootPartyContraTrader
        \o message.basketSideTradeReportId
        \o message.pad7

DecodeBasketRootPartyGrpComp(bytes) ==
    LET rootPartySubIdType == ReadBytes(bytes, 2) IN IF ~rootPartySubIdType.ok THEN Fail ELSE
    LET rootPartyContraFirm == ReadBytes(rootPartySubIdType.rest, 5) IN IF ~rootPartyContraFirm.ok THEN Fail ELSE
    LET rootPartyContraTrader == ReadBytes(rootPartyContraFirm.rest, 6) IN IF ~rootPartyContraTrader.ok THEN Fail ELSE
    LET basketSideTradeReportId == ReadBytes(rootPartyContraTrader.rest, 20) IN IF ~basketSideTradeReportId.ok THEN Fail ELSE
    LET pad7 == ReadBytes(basketSideTradeReportId.rest, 7) IN IF ~pad7.ok THEN Fail ELSE
    Ok([ rootPartySubIdType      |-> rootPartySubIdType.value,
         rootPartyContraFirm     |-> rootPartyContraFirm.value,
         rootPartyContraTrader   |-> rootPartyContraTrader.value,
         basketSideTradeReportId |-> basketSideTradeReportId.value,
         pad7                    |-> pad7.value ], pad7.rest)

ZeroBasketRootPartyGrpComp ==
    [ rootPartySubIdType      |-> [i \in 1 .. 2 |-> 0],
      rootPartyContraFirm     |-> [i \in 1 .. 5 |-> 0],
      rootPartyContraTrader   |-> [i \in 1 .. 6 |-> 0],
      basketSideTradeReportId |-> [i \in 1 .. 20 |-> 0],
      pad7                    |-> [i \in 1 .. 7 |-> 0] ]

(* Basket Root Party Grp Comp at zero, then each field in turn at the values it is checked at *)
CheckedBasketRootPartyGrpComp ==
    { ZeroBasketRootPartyGrpComp }
        \cup { [ZeroBasketRootPartyGrpComp EXCEPT !.rootPartySubIdType = one] : one \in Sample(2) }
        \cup { [ZeroBasketRootPartyGrpComp EXCEPT !.rootPartyContraFirm = one] : one \in Sample(5) }
        \cup { [ZeroBasketRootPartyGrpComp EXCEPT !.rootPartyContraTrader = one] : one \in Sample(6) }
        \cup { [ZeroBasketRootPartyGrpComp EXCEPT !.basketSideTradeReportId = one] : one \in Sample(20) }
        \cup { [ZeroBasketRootPartyGrpComp EXCEPT !.pad7 = one] : one \in Sample(7) }

(* A run of Basket Root Party Grp Comp, written one after another *)
RECURSIVE EncodeBasketRootPartyGrpCompList(_)
EncodeBasketRootPartyGrpCompList(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeBasketRootPartyGrpComp(Head(messages)) \o EncodeBasketRootPartyGrpCompList(Tail(messages))

(* As many Basket Root Party Grp Comp as the field that counts them says *)
RECURSIVE ReadBasketRootPartyGrpCompList(_, _)
ReadBasketRootPartyGrpCompList(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeBasketRootPartyGrpComp(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadBasketRootPartyGrpCompList(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Basket Root Party Grp Comp of each kind, for the lists that carry them *)
OneBasketRootPartyGrpComp == { ZeroBasketRootPartyGrpComp }

(***************************************************************************)
(* Basket Side Alloc Ext Bc Grp Comp: 192 bytes                            *)
(***************************************************************************)

BasketSideAllocExtBcGrpComp ==
    [ allocQty                    : Sample(8),
      securityId                  : Sample(8),
      lastPx                      : Sample(8),
      transBkdTime                : Sample(8),
      relatedClosePrice           : Sample(8),
      packageId                   : Sample(4),
      sideMarketSegmentId         : Sample(4),
      allocId                     : Sample(4),
      sideTrdSubTyp               : Sample(2),
      partySubIdType              : Sample(2),
      side                        : Sample(1),
      positionEffect              : Sample(1),
      effectOnBasket              : Sample(1),
      tradingCapacity             : Sample(1),
      tradeAllocStatus            : Sample(1),
      productComplex              : Sample(1),
      tradePublishIndicator       : Sample(1),
      partyExecutingFirm          : Sample(5),
      partyExecutingTrader        : Sample(6),
      account                     : Sample(2),
      freeText1                   : Sample(12),
      freeText2                   : Sample(12),
      freeText3                   : Sample(12),
      partyIdTakeUpTradingFirm    : Sample(5),
      partyIdOrderOriginationFirm : Sample(7),
      partyIdBeneficiary          : Sample(9),
      partyIdPositionAccount      : Sample(32),
      partyIdLocationId           : Sample(2),
      custOrderHandlingInst       : Sample(1),
      complianceText              : Sample(20),
      pad4                        : Sample(4) ]

EncodeBasketSideAllocExtBcGrpComp(message) ==
    message.allocQty
        \o message.securityId
        \o message.lastPx
        \o message.transBkdTime
        \o message.relatedClosePrice
        \o message.packageId
        \o message.sideMarketSegmentId
        \o message.allocId
        \o message.sideTrdSubTyp
        \o message.partySubIdType
        \o message.side
        \o message.positionEffect
        \o message.effectOnBasket
        \o message.tradingCapacity
        \o message.tradeAllocStatus
        \o message.productComplex
        \o message.tradePublishIndicator
        \o message.partyExecutingFirm
        \o message.partyExecutingTrader
        \o message.account
        \o message.freeText1
        \o message.freeText2
        \o message.freeText3
        \o message.partyIdTakeUpTradingFirm
        \o message.partyIdOrderOriginationFirm
        \o message.partyIdBeneficiary
        \o message.partyIdPositionAccount
        \o message.partyIdLocationId
        \o message.custOrderHandlingInst
        \o message.complianceText
        \o message.pad4

DecodeBasketSideAllocExtBcGrpComp(bytes) ==
    LET allocQty == ReadBytes(bytes, 8) IN IF ~allocQty.ok THEN Fail ELSE
    LET securityId == ReadBytes(allocQty.rest, 8) IN IF ~securityId.ok THEN Fail ELSE
    LET lastPx == ReadBytes(securityId.rest, 8) IN IF ~lastPx.ok THEN Fail ELSE
    LET transBkdTime == ReadBytes(lastPx.rest, 8) IN IF ~transBkdTime.ok THEN Fail ELSE
    LET relatedClosePrice == ReadBytes(transBkdTime.rest, 8) IN IF ~relatedClosePrice.ok THEN Fail ELSE
    LET packageId == ReadBytes(relatedClosePrice.rest, 4) IN IF ~packageId.ok THEN Fail ELSE
    LET sideMarketSegmentId == ReadBytes(packageId.rest, 4) IN IF ~sideMarketSegmentId.ok THEN Fail ELSE
    LET allocId == ReadBytes(sideMarketSegmentId.rest, 4) IN IF ~allocId.ok THEN Fail ELSE
    LET sideTrdSubTyp == ReadBytes(allocId.rest, 2) IN IF ~sideTrdSubTyp.ok THEN Fail ELSE
    LET partySubIdType == ReadBytes(sideTrdSubTyp.rest, 2) IN IF ~partySubIdType.ok THEN Fail ELSE
    LET side == ReadBytes(partySubIdType.rest, 1) IN IF ~side.ok THEN Fail ELSE
    LET positionEffect == ReadBytes(side.rest, 1) IN IF ~positionEffect.ok THEN Fail ELSE
    LET effectOnBasket == ReadBytes(positionEffect.rest, 1) IN IF ~effectOnBasket.ok THEN Fail ELSE
    LET tradingCapacity == ReadBytes(effectOnBasket.rest, 1) IN IF ~tradingCapacity.ok THEN Fail ELSE
    LET tradeAllocStatus == ReadBytes(tradingCapacity.rest, 1) IN IF ~tradeAllocStatus.ok THEN Fail ELSE
    LET productComplex == ReadBytes(tradeAllocStatus.rest, 1) IN IF ~productComplex.ok THEN Fail ELSE
    LET tradePublishIndicator == ReadBytes(productComplex.rest, 1) IN IF ~tradePublishIndicator.ok THEN Fail ELSE
    LET partyExecutingFirm == ReadBytes(tradePublishIndicator.rest, 5) IN IF ~partyExecutingFirm.ok THEN Fail ELSE
    LET partyExecutingTrader == ReadBytes(partyExecutingFirm.rest, 6) IN IF ~partyExecutingTrader.ok THEN Fail ELSE
    LET account == ReadBytes(partyExecutingTrader.rest, 2) IN IF ~account.ok THEN Fail ELSE
    LET freeText1 == ReadBytes(account.rest, 12) IN IF ~freeText1.ok THEN Fail ELSE
    LET freeText2 == ReadBytes(freeText1.rest, 12) IN IF ~freeText2.ok THEN Fail ELSE
    LET freeText3 == ReadBytes(freeText2.rest, 12) IN IF ~freeText3.ok THEN Fail ELSE
    LET partyIdTakeUpTradingFirm == ReadBytes(freeText3.rest, 5) IN IF ~partyIdTakeUpTradingFirm.ok THEN Fail ELSE
    LET partyIdOrderOriginationFirm == ReadBytes(partyIdTakeUpTradingFirm.rest, 7) IN IF ~partyIdOrderOriginationFirm.ok THEN Fail ELSE
    LET partyIdBeneficiary == ReadBytes(partyIdOrderOriginationFirm.rest, 9) IN IF ~partyIdBeneficiary.ok THEN Fail ELSE
    LET partyIdPositionAccount == ReadBytes(partyIdBeneficiary.rest, 32) IN IF ~partyIdPositionAccount.ok THEN Fail ELSE
    LET partyIdLocationId == ReadBytes(partyIdPositionAccount.rest, 2) IN IF ~partyIdLocationId.ok THEN Fail ELSE
    LET custOrderHandlingInst == ReadBytes(partyIdLocationId.rest, 1) IN IF ~custOrderHandlingInst.ok THEN Fail ELSE
    LET complianceText == ReadBytes(custOrderHandlingInst.rest, 20) IN IF ~complianceText.ok THEN Fail ELSE
    LET pad4 == ReadBytes(complianceText.rest, 4) IN IF ~pad4.ok THEN Fail ELSE
    Ok([ allocQty                    |-> allocQty.value,
         securityId                  |-> securityId.value,
         lastPx                      |-> lastPx.value,
         transBkdTime                |-> transBkdTime.value,
         relatedClosePrice           |-> relatedClosePrice.value,
         packageId                   |-> packageId.value,
         sideMarketSegmentId         |-> sideMarketSegmentId.value,
         allocId                     |-> allocId.value,
         sideTrdSubTyp               |-> sideTrdSubTyp.value,
         partySubIdType              |-> partySubIdType.value,
         side                        |-> side.value,
         positionEffect              |-> positionEffect.value,
         effectOnBasket              |-> effectOnBasket.value,
         tradingCapacity             |-> tradingCapacity.value,
         tradeAllocStatus            |-> tradeAllocStatus.value,
         productComplex              |-> productComplex.value,
         tradePublishIndicator       |-> tradePublishIndicator.value,
         partyExecutingFirm          |-> partyExecutingFirm.value,
         partyExecutingTrader        |-> partyExecutingTrader.value,
         account                     |-> account.value,
         freeText1                   |-> freeText1.value,
         freeText2                   |-> freeText2.value,
         freeText3                   |-> freeText3.value,
         partyIdTakeUpTradingFirm    |-> partyIdTakeUpTradingFirm.value,
         partyIdOrderOriginationFirm |-> partyIdOrderOriginationFirm.value,
         partyIdBeneficiary          |-> partyIdBeneficiary.value,
         partyIdPositionAccount      |-> partyIdPositionAccount.value,
         partyIdLocationId           |-> partyIdLocationId.value,
         custOrderHandlingInst       |-> custOrderHandlingInst.value,
         complianceText              |-> complianceText.value,
         pad4                        |-> pad4.value ], pad4.rest)

ZeroBasketSideAllocExtBcGrpComp ==
    [ allocQty                    |-> [i \in 1 .. 8 |-> 0],
      securityId                  |-> [i \in 1 .. 8 |-> 0],
      lastPx                      |-> [i \in 1 .. 8 |-> 0],
      transBkdTime                |-> [i \in 1 .. 8 |-> 0],
      relatedClosePrice           |-> [i \in 1 .. 8 |-> 0],
      packageId                   |-> [i \in 1 .. 4 |-> 0],
      sideMarketSegmentId         |-> [i \in 1 .. 4 |-> 0],
      allocId                     |-> [i \in 1 .. 4 |-> 0],
      sideTrdSubTyp               |-> [i \in 1 .. 2 |-> 0],
      partySubIdType              |-> [i \in 1 .. 2 |-> 0],
      side                        |-> [i \in 1 .. 1 |-> 0],
      positionEffect              |-> [i \in 1 .. 1 |-> 0],
      effectOnBasket              |-> [i \in 1 .. 1 |-> 0],
      tradingCapacity             |-> [i \in 1 .. 1 |-> 0],
      tradeAllocStatus            |-> [i \in 1 .. 1 |-> 0],
      productComplex              |-> [i \in 1 .. 1 |-> 0],
      tradePublishIndicator       |-> [i \in 1 .. 1 |-> 0],
      partyExecutingFirm          |-> [i \in 1 .. 5 |-> 0],
      partyExecutingTrader        |-> [i \in 1 .. 6 |-> 0],
      account                     |-> [i \in 1 .. 2 |-> 0],
      freeText1                   |-> [i \in 1 .. 12 |-> 0],
      freeText2                   |-> [i \in 1 .. 12 |-> 0],
      freeText3                   |-> [i \in 1 .. 12 |-> 0],
      partyIdTakeUpTradingFirm    |-> [i \in 1 .. 5 |-> 0],
      partyIdOrderOriginationFirm |-> [i \in 1 .. 7 |-> 0],
      partyIdBeneficiary          |-> [i \in 1 .. 9 |-> 0],
      partyIdPositionAccount      |-> [i \in 1 .. 32 |-> 0],
      partyIdLocationId           |-> [i \in 1 .. 2 |-> 0],
      custOrderHandlingInst       |-> [i \in 1 .. 1 |-> 0],
      complianceText              |-> [i \in 1 .. 20 |-> 0],
      pad4                        |-> [i \in 1 .. 4 |-> 0] ]

(* Basket Side Alloc Ext Bc Grp Comp at zero, then each field in turn at the values it is checked at *)
CheckedBasketSideAllocExtBcGrpComp ==
    { ZeroBasketSideAllocExtBcGrpComp }
        \cup { [ZeroBasketSideAllocExtBcGrpComp EXCEPT !.allocQty = one] : one \in Sample(8) }
        \cup { [ZeroBasketSideAllocExtBcGrpComp EXCEPT !.securityId = one] : one \in Sample(8) }
        \cup { [ZeroBasketSideAllocExtBcGrpComp EXCEPT !.lastPx = one] : one \in Sample(8) }
        \cup { [ZeroBasketSideAllocExtBcGrpComp EXCEPT !.transBkdTime = one] : one \in Sample(8) }
        \cup { [ZeroBasketSideAllocExtBcGrpComp EXCEPT !.relatedClosePrice = one] : one \in Sample(8) }
        \cup { [ZeroBasketSideAllocExtBcGrpComp EXCEPT !.packageId = one] : one \in Sample(4) }
        \cup { [ZeroBasketSideAllocExtBcGrpComp EXCEPT !.sideMarketSegmentId = one] : one \in Sample(4) }
        \cup { [ZeroBasketSideAllocExtBcGrpComp EXCEPT !.allocId = one] : one \in Sample(4) }
        \cup { [ZeroBasketSideAllocExtBcGrpComp EXCEPT !.sideTrdSubTyp = one] : one \in Sample(2) }
        \cup { [ZeroBasketSideAllocExtBcGrpComp EXCEPT !.partySubIdType = one] : one \in Sample(2) }
        \cup { [ZeroBasketSideAllocExtBcGrpComp EXCEPT !.side = one] : one \in Sample(1) }
        \cup { [ZeroBasketSideAllocExtBcGrpComp EXCEPT !.positionEffect = one] : one \in Sample(1) }
        \cup { [ZeroBasketSideAllocExtBcGrpComp EXCEPT !.effectOnBasket = one] : one \in Sample(1) }
        \cup { [ZeroBasketSideAllocExtBcGrpComp EXCEPT !.tradingCapacity = one] : one \in Sample(1) }
        \cup { [ZeroBasketSideAllocExtBcGrpComp EXCEPT !.tradeAllocStatus = one] : one \in Sample(1) }
        \cup { [ZeroBasketSideAllocExtBcGrpComp EXCEPT !.productComplex = one] : one \in Sample(1) }
        \cup { [ZeroBasketSideAllocExtBcGrpComp EXCEPT !.tradePublishIndicator = one] : one \in Sample(1) }
        \cup { [ZeroBasketSideAllocExtBcGrpComp EXCEPT !.partyExecutingFirm = one] : one \in Sample(5) }
        \cup { [ZeroBasketSideAllocExtBcGrpComp EXCEPT !.partyExecutingTrader = one] : one \in Sample(6) }
        \cup { [ZeroBasketSideAllocExtBcGrpComp EXCEPT !.account = one] : one \in Sample(2) }
        \cup { [ZeroBasketSideAllocExtBcGrpComp EXCEPT !.freeText1 = one] : one \in Sample(12) }
        \cup { [ZeroBasketSideAllocExtBcGrpComp EXCEPT !.freeText2 = one] : one \in Sample(12) }
        \cup { [ZeroBasketSideAllocExtBcGrpComp EXCEPT !.freeText3 = one] : one \in Sample(12) }
        \cup { [ZeroBasketSideAllocExtBcGrpComp EXCEPT !.partyIdTakeUpTradingFirm = one] : one \in Sample(5) }
        \cup { [ZeroBasketSideAllocExtBcGrpComp EXCEPT !.partyIdOrderOriginationFirm = one] : one \in Sample(7) }
        \cup { [ZeroBasketSideAllocExtBcGrpComp EXCEPT !.partyIdBeneficiary = one] : one \in Sample(9) }
        \cup { [ZeroBasketSideAllocExtBcGrpComp EXCEPT !.partyIdPositionAccount = one] : one \in Sample(32) }
        \cup { [ZeroBasketSideAllocExtBcGrpComp EXCEPT !.partyIdLocationId = one] : one \in Sample(2) }
        \cup { [ZeroBasketSideAllocExtBcGrpComp EXCEPT !.custOrderHandlingInst = one] : one \in Sample(1) }
        \cup { [ZeroBasketSideAllocExtBcGrpComp EXCEPT !.complianceText = one] : one \in Sample(20) }
        \cup { [ZeroBasketSideAllocExtBcGrpComp EXCEPT !.pad4 = one] : one \in Sample(4) }

(* A run of Basket Side Alloc Ext Bc Grp Comp, written one after another *)
RECURSIVE EncodeBasketSideAllocExtBcGrpCompList(_)
EncodeBasketSideAllocExtBcGrpCompList(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeBasketSideAllocExtBcGrpComp(Head(messages)) \o EncodeBasketSideAllocExtBcGrpCompList(Tail(messages))

(* As many Basket Side Alloc Ext Bc Grp Comp as the field that counts them says *)
RECURSIVE ReadBasketSideAllocExtBcGrpCompList(_, _)
ReadBasketSideAllocExtBcGrpCompList(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeBasketSideAllocExtBcGrpComp(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadBasketSideAllocExtBcGrpCompList(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Basket Side Alloc Ext Bc Grp Comp of each kind, for the lists that carry them *)
OneBasketSideAllocExtBcGrpComp == { ZeroBasketSideAllocExtBcGrpComp }

(***************************************************************************)
(* Basket Approve Broadcast                                                *)
(***************************************************************************)

BasketApproveBroadcast ==
    [ pad2                        : Sample(2),
      rbcHeaderComp               : RbcHeaderComp,
      basketTrdMatchId            : Sample(8),
      transactTime                : Sample(8),
      basketExecId                : Sample(4),
      marketSegmentId             : Sample(4),
      basketProfileId             : Sample(4),
      trdType                     : Sample(2),
      tradeReportType             : Sample(1),
      basketTradeReportType       : Sample(1),
      messageEventSource          : Sample(1),
      partyIdEnteringFirm         : Sample(1),
      partyEnteringTrader         : Sample(6),
      basketTradeReportText       : Sample(20),
      tradeReportId               : Sample(20),
      pad5                        : Sample(5),
      basketRootPartyGrpComp      : SampleLists(OneBasketRootPartyGrpComp),
      basketSideAllocExtBcGrpComp : SampleLists(OneBasketSideAllocExtBcGrpComp) ]

EncodeBasketApproveBroadcast(message) ==
    message.pad2
        \o EncodeRbcHeaderComp(message.rbcHeaderComp)
        \o message.basketTrdMatchId
        \o message.transactTime
        \o message.basketExecId
        \o message.marketSegmentId
        \o message.basketProfileId
        \o message.trdType
        \o EncodeUIntLE(Len(message.basketSideAllocExtBcGrpComp), 2)
        \o message.tradeReportType
        \o message.basketTradeReportType
        \o message.messageEventSource
        \o EncodeUIntBE(Len(message.basketRootPartyGrpComp), 1)
        \o message.partyIdEnteringFirm
        \o message.partyEnteringTrader
        \o message.basketTradeReportText
        \o message.tradeReportId
        \o message.pad5
        \o EncodeBasketRootPartyGrpCompList(message.basketRootPartyGrpComp)
        \o EncodeBasketSideAllocExtBcGrpCompList(message.basketSideAllocExtBcGrpComp)

DecodeBasketApproveBroadcast(bytes) ==
    LET pad2 == ReadBytes(bytes, 2) IN IF ~pad2.ok THEN Fail ELSE
    LET rbcHeaderComp == DecodeRbcHeaderComp(pad2.rest) IN IF ~rbcHeaderComp.ok THEN Fail ELSE
    LET basketTrdMatchId == ReadBytes(rbcHeaderComp.rest, 8) IN IF ~basketTrdMatchId.ok THEN Fail ELSE
    LET transactTime == ReadBytes(basketTrdMatchId.rest, 8) IN IF ~transactTime.ok THEN Fail ELSE
    LET basketExecId == ReadBytes(transactTime.rest, 4) IN IF ~basketExecId.ok THEN Fail ELSE
    LET marketSegmentId == ReadBytes(basketExecId.rest, 4) IN IF ~marketSegmentId.ok THEN Fail ELSE
    LET basketProfileId == ReadBytes(marketSegmentId.rest, 4) IN IF ~basketProfileId.ok THEN Fail ELSE
    LET trdType == ReadBytes(basketProfileId.rest, 2) IN IF ~trdType.ok THEN Fail ELSE
    LET noBasketSideAlloc == ReadUIntLE(trdType.rest, 2) IN IF ~noBasketSideAlloc.ok THEN Fail ELSE
    LET tradeReportType == ReadBytes(noBasketSideAlloc.rest, 1) IN IF ~tradeReportType.ok THEN Fail ELSE
    LET basketTradeReportType == ReadBytes(tradeReportType.rest, 1) IN IF ~basketTradeReportType.ok THEN Fail ELSE
    LET messageEventSource == ReadBytes(basketTradeReportType.rest, 1) IN IF ~messageEventSource.ok THEN Fail ELSE
    LET noBasketRootPartyGrps == ReadUIntBE(messageEventSource.rest, 1) IN IF ~noBasketRootPartyGrps.ok THEN Fail ELSE
    LET partyIdEnteringFirm == ReadBytes(noBasketRootPartyGrps.rest, 1) IN IF ~partyIdEnteringFirm.ok THEN Fail ELSE
    LET partyEnteringTrader == ReadBytes(partyIdEnteringFirm.rest, 6) IN IF ~partyEnteringTrader.ok THEN Fail ELSE
    LET basketTradeReportText == ReadBytes(partyEnteringTrader.rest, 20) IN IF ~basketTradeReportText.ok THEN Fail ELSE
    LET tradeReportId == ReadBytes(basketTradeReportText.rest, 20) IN IF ~tradeReportId.ok THEN Fail ELSE
    LET pad5 == ReadBytes(tradeReportId.rest, 5) IN IF ~pad5.ok THEN Fail ELSE
    LET basketRootPartyGrpComp == ReadBasketRootPartyGrpCompList(pad5.rest, noBasketRootPartyGrps.value) IN IF ~basketRootPartyGrpComp.ok THEN Fail ELSE
    LET basketSideAllocExtBcGrpComp == ReadBasketSideAllocExtBcGrpCompList(basketRootPartyGrpComp.rest, noBasketSideAlloc.value) IN IF ~basketSideAllocExtBcGrpComp.ok THEN Fail ELSE
    Ok([ pad2                        |-> pad2.value,
         rbcHeaderComp               |-> rbcHeaderComp.value,
         basketTrdMatchId            |-> basketTrdMatchId.value,
         transactTime                |-> transactTime.value,
         basketExecId                |-> basketExecId.value,
         marketSegmentId             |-> marketSegmentId.value,
         basketProfileId             |-> basketProfileId.value,
         trdType                     |-> trdType.value,
         tradeReportType             |-> tradeReportType.value,
         basketTradeReportType       |-> basketTradeReportType.value,
         messageEventSource          |-> messageEventSource.value,
         partyIdEnteringFirm         |-> partyIdEnteringFirm.value,
         partyEnteringTrader         |-> partyEnteringTrader.value,
         basketTradeReportText       |-> basketTradeReportText.value,
         tradeReportId               |-> tradeReportId.value,
         pad5                        |-> pad5.value,
         basketRootPartyGrpComp      |-> basketRootPartyGrpComp.value,
         basketSideAllocExtBcGrpComp |-> basketSideAllocExtBcGrpComp.value ], basketSideAllocExtBcGrpComp.rest)

ZeroBasketApproveBroadcast ==
    [ pad2                        |-> [i \in 1 .. 2 |-> 0],
      rbcHeaderComp               |-> ZeroRbcHeaderComp,
      basketTrdMatchId            |-> [i \in 1 .. 8 |-> 0],
      transactTime                |-> [i \in 1 .. 8 |-> 0],
      basketExecId                |-> [i \in 1 .. 4 |-> 0],
      marketSegmentId             |-> [i \in 1 .. 4 |-> 0],
      basketProfileId             |-> [i \in 1 .. 4 |-> 0],
      trdType                     |-> [i \in 1 .. 2 |-> 0],
      tradeReportType             |-> [i \in 1 .. 1 |-> 0],
      basketTradeReportType       |-> [i \in 1 .. 1 |-> 0],
      messageEventSource          |-> [i \in 1 .. 1 |-> 0],
      partyIdEnteringFirm         |-> [i \in 1 .. 1 |-> 0],
      partyEnteringTrader         |-> [i \in 1 .. 6 |-> 0],
      basketTradeReportText       |-> [i \in 1 .. 20 |-> 0],
      tradeReportId               |-> [i \in 1 .. 20 |-> 0],
      pad5                        |-> [i \in 1 .. 5 |-> 0],
      basketRootPartyGrpComp      |-> << >>,
      basketSideAllocExtBcGrpComp |-> << >> ]

(* Basket Approve Broadcast at zero, then each field in turn at the values it is checked at *)
CheckedBasketApproveBroadcast ==
    { ZeroBasketApproveBroadcast }
        \cup { [ZeroBasketApproveBroadcast EXCEPT !.pad2 = one] : one \in Sample(2) }
        \cup { [ZeroBasketApproveBroadcast EXCEPT !.rbcHeaderComp = one] : one \in CheckedRbcHeaderComp }
        \cup { [ZeroBasketApproveBroadcast EXCEPT !.basketTrdMatchId = one] : one \in Sample(8) }
        \cup { [ZeroBasketApproveBroadcast EXCEPT !.transactTime = one] : one \in Sample(8) }
        \cup { [ZeroBasketApproveBroadcast EXCEPT !.basketExecId = one] : one \in Sample(4) }
        \cup { [ZeroBasketApproveBroadcast EXCEPT !.marketSegmentId = one] : one \in Sample(4) }
        \cup { [ZeroBasketApproveBroadcast EXCEPT !.basketProfileId = one] : one \in Sample(4) }
        \cup { [ZeroBasketApproveBroadcast EXCEPT !.trdType = one] : one \in Sample(2) }
        \cup { [ZeroBasketApproveBroadcast EXCEPT !.tradeReportType = one] : one \in Sample(1) }
        \cup { [ZeroBasketApproveBroadcast EXCEPT !.basketTradeReportType = one] : one \in Sample(1) }
        \cup { [ZeroBasketApproveBroadcast EXCEPT !.messageEventSource = one] : one \in Sample(1) }
        \cup { [ZeroBasketApproveBroadcast EXCEPT !.partyIdEnteringFirm = one] : one \in Sample(1) }
        \cup { [ZeroBasketApproveBroadcast EXCEPT !.partyEnteringTrader = one] : one \in Sample(6) }
        \cup { [ZeroBasketApproveBroadcast EXCEPT !.basketTradeReportText = one] : one \in Sample(20) }
        \cup { [ZeroBasketApproveBroadcast EXCEPT !.tradeReportId = one] : one \in Sample(20) }
        \cup { [ZeroBasketApproveBroadcast EXCEPT !.pad5 = one] : one \in Sample(5) }
        \cup { [ZeroBasketApproveBroadcast EXCEPT !.basketRootPartyGrpComp = one] : one \in SampleLists(OneBasketRootPartyGrpComp) }
        \cup { [ZeroBasketApproveBroadcast EXCEPT !.basketSideAllocExtBcGrpComp = one] : one \in SampleLists(OneBasketSideAllocExtBcGrpComp) }

(***************************************************************************)
(* Rbc Header Comp: 32 bytes                                               *)
(***************************************************************************)

RbcHeaderComp2 ==
    [ sendingTime    : Sample(8),
      applSeqNum     : Sample(8),
      applSubId      : Sample(4),
      partitionId    : Sample(2),
      applResendFlag : Sample(1),
      applId         : Sample(1),
      lastFragment   : Sample(1),
      pad7           : Sample(7) ]

EncodeRbcHeaderComp2(message) ==
    message.sendingTime
        \o message.applSeqNum
        \o message.applSubId
        \o message.partitionId
        \o message.applResendFlag
        \o message.applId
        \o message.lastFragment
        \o message.pad7

DecodeRbcHeaderComp2(bytes) ==
    LET sendingTime == ReadBytes(bytes, 8) IN IF ~sendingTime.ok THEN Fail ELSE
    LET applSeqNum == ReadBytes(sendingTime.rest, 8) IN IF ~applSeqNum.ok THEN Fail ELSE
    LET applSubId == ReadBytes(applSeqNum.rest, 4) IN IF ~applSubId.ok THEN Fail ELSE
    LET partitionId == ReadBytes(applSubId.rest, 2) IN IF ~partitionId.ok THEN Fail ELSE
    LET applResendFlag == ReadBytes(partitionId.rest, 1) IN IF ~applResendFlag.ok THEN Fail ELSE
    LET applId == ReadBytes(applResendFlag.rest, 1) IN IF ~applId.ok THEN Fail ELSE
    LET lastFragment == ReadBytes(applId.rest, 1) IN IF ~lastFragment.ok THEN Fail ELSE
    LET pad7 == ReadBytes(lastFragment.rest, 7) IN IF ~pad7.ok THEN Fail ELSE
    Ok([ sendingTime    |-> sendingTime.value,
         applSeqNum     |-> applSeqNum.value,
         applSubId      |-> applSubId.value,
         partitionId    |-> partitionId.value,
         applResendFlag |-> applResendFlag.value,
         applId         |-> applId.value,
         lastFragment   |-> lastFragment.value,
         pad7           |-> pad7.value ], pad7.rest)

ZeroRbcHeaderComp2 ==
    [ sendingTime    |-> [i \in 1 .. 8 |-> 0],
      applSeqNum     |-> [i \in 1 .. 8 |-> 0],
      applSubId      |-> [i \in 1 .. 4 |-> 0],
      partitionId    |-> [i \in 1 .. 2 |-> 0],
      applResendFlag |-> [i \in 1 .. 1 |-> 0],
      applId         |-> [i \in 1 .. 1 |-> 0],
      lastFragment   |-> [i \in 1 .. 1 |-> 0],
      pad7           |-> [i \in 1 .. 7 |-> 0] ]

(* Rbc Header Comp at zero, then each field in turn at the values it is checked at *)
CheckedRbcHeaderComp2 ==
    { ZeroRbcHeaderComp2 }
        \cup { [ZeroRbcHeaderComp2 EXCEPT !.sendingTime = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderComp2 EXCEPT !.applSeqNum = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderComp2 EXCEPT !.applSubId = one] : one \in Sample(4) }
        \cup { [ZeroRbcHeaderComp2 EXCEPT !.partitionId = one] : one \in Sample(2) }
        \cup { [ZeroRbcHeaderComp2 EXCEPT !.applResendFlag = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp2 EXCEPT !.applId = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp2 EXCEPT !.lastFragment = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp2 EXCEPT !.pad7 = one] : one \in Sample(7) }

(***************************************************************************)
(* Basket Root Party Grp Comp: 40 bytes                                    *)
(***************************************************************************)

BasketRootPartyGrpComp2 ==
    [ rootPartySubIdType      : Sample(2),
      rootPartyContraFirm     : Sample(5),
      rootPartyContraTrader   : Sample(6),
      basketSideTradeReportId : Sample(20),
      pad7                    : Sample(7) ]

EncodeBasketRootPartyGrpComp2(message) ==
    message.rootPartySubIdType
        \o message.rootPartyContraFirm
        \o message.rootPartyContraTrader
        \o message.basketSideTradeReportId
        \o message.pad7

DecodeBasketRootPartyGrpComp2(bytes) ==
    LET rootPartySubIdType == ReadBytes(bytes, 2) IN IF ~rootPartySubIdType.ok THEN Fail ELSE
    LET rootPartyContraFirm == ReadBytes(rootPartySubIdType.rest, 5) IN IF ~rootPartyContraFirm.ok THEN Fail ELSE
    LET rootPartyContraTrader == ReadBytes(rootPartyContraFirm.rest, 6) IN IF ~rootPartyContraTrader.ok THEN Fail ELSE
    LET basketSideTradeReportId == ReadBytes(rootPartyContraTrader.rest, 20) IN IF ~basketSideTradeReportId.ok THEN Fail ELSE
    LET pad7 == ReadBytes(basketSideTradeReportId.rest, 7) IN IF ~pad7.ok THEN Fail ELSE
    Ok([ rootPartySubIdType      |-> rootPartySubIdType.value,
         rootPartyContraFirm     |-> rootPartyContraFirm.value,
         rootPartyContraTrader   |-> rootPartyContraTrader.value,
         basketSideTradeReportId |-> basketSideTradeReportId.value,
         pad7                    |-> pad7.value ], pad7.rest)

ZeroBasketRootPartyGrpComp2 ==
    [ rootPartySubIdType      |-> [i \in 1 .. 2 |-> 0],
      rootPartyContraFirm     |-> [i \in 1 .. 5 |-> 0],
      rootPartyContraTrader   |-> [i \in 1 .. 6 |-> 0],
      basketSideTradeReportId |-> [i \in 1 .. 20 |-> 0],
      pad7                    |-> [i \in 1 .. 7 |-> 0] ]

(* Basket Root Party Grp Comp at zero, then each field in turn at the values it is checked at *)
CheckedBasketRootPartyGrpComp2 ==
    { ZeroBasketRootPartyGrpComp2 }
        \cup { [ZeroBasketRootPartyGrpComp2 EXCEPT !.rootPartySubIdType = one] : one \in Sample(2) }
        \cup { [ZeroBasketRootPartyGrpComp2 EXCEPT !.rootPartyContraFirm = one] : one \in Sample(5) }
        \cup { [ZeroBasketRootPartyGrpComp2 EXCEPT !.rootPartyContraTrader = one] : one \in Sample(6) }
        \cup { [ZeroBasketRootPartyGrpComp2 EXCEPT !.basketSideTradeReportId = one] : one \in Sample(20) }
        \cup { [ZeroBasketRootPartyGrpComp2 EXCEPT !.pad7 = one] : one \in Sample(7) }

(* A run of Basket Root Party Grp Comp, written one after another *)
RECURSIVE EncodeBasketRootPartyGrpComp2List(_)
EncodeBasketRootPartyGrpComp2List(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeBasketRootPartyGrpComp2(Head(messages)) \o EncodeBasketRootPartyGrpComp2List(Tail(messages))

(* As many Basket Root Party Grp Comp as the field that counts them says *)
RECURSIVE ReadBasketRootPartyGrpComp2List(_, _)
ReadBasketRootPartyGrpComp2List(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeBasketRootPartyGrpComp2(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadBasketRootPartyGrpComp2List(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Basket Root Party Grp Comp of each kind, for the lists that carry them *)
OneBasketRootPartyGrpComp2 == { ZeroBasketRootPartyGrpComp2 }

(***************************************************************************)
(* Instrmt Match Side Grp Comp: 72 bytes                                   *)
(***************************************************************************)

InstrmtMatchSideGrpComp ==
    [ securityId            : Sample(8),
      lastPx                : Sample(8),
      transBkdTime          : Sample(8),
      relatedClosePrice     : Sample(8),
      packageId             : Sample(4),
      sideMarketSegmentId   : Sample(4),
      sideTrdSubTyp         : Sample(2),
      productComplex        : Sample(1),
      tradePublishIndicator : Sample(1),
      instrmtMatchSideId    : Sample(1),
      effectOnBasket        : Sample(1),
      tradeReportText       : Sample(20),
      pad6                  : Sample(6) ]

EncodeInstrmtMatchSideGrpComp(message) ==
    message.securityId
        \o message.lastPx
        \o message.transBkdTime
        \o message.relatedClosePrice
        \o message.packageId
        \o message.sideMarketSegmentId
        \o message.sideTrdSubTyp
        \o message.productComplex
        \o message.tradePublishIndicator
        \o message.instrmtMatchSideId
        \o message.effectOnBasket
        \o message.tradeReportText
        \o message.pad6

DecodeInstrmtMatchSideGrpComp(bytes) ==
    LET securityId == ReadBytes(bytes, 8) IN IF ~securityId.ok THEN Fail ELSE
    LET lastPx == ReadBytes(securityId.rest, 8) IN IF ~lastPx.ok THEN Fail ELSE
    LET transBkdTime == ReadBytes(lastPx.rest, 8) IN IF ~transBkdTime.ok THEN Fail ELSE
    LET relatedClosePrice == ReadBytes(transBkdTime.rest, 8) IN IF ~relatedClosePrice.ok THEN Fail ELSE
    LET packageId == ReadBytes(relatedClosePrice.rest, 4) IN IF ~packageId.ok THEN Fail ELSE
    LET sideMarketSegmentId == ReadBytes(packageId.rest, 4) IN IF ~sideMarketSegmentId.ok THEN Fail ELSE
    LET sideTrdSubTyp == ReadBytes(sideMarketSegmentId.rest, 2) IN IF ~sideTrdSubTyp.ok THEN Fail ELSE
    LET productComplex == ReadBytes(sideTrdSubTyp.rest, 1) IN IF ~productComplex.ok THEN Fail ELSE
    LET tradePublishIndicator == ReadBytes(productComplex.rest, 1) IN IF ~tradePublishIndicator.ok THEN Fail ELSE
    LET instrmtMatchSideId == ReadBytes(tradePublishIndicator.rest, 1) IN IF ~instrmtMatchSideId.ok THEN Fail ELSE
    LET effectOnBasket == ReadBytes(instrmtMatchSideId.rest, 1) IN IF ~effectOnBasket.ok THEN Fail ELSE
    LET tradeReportText == ReadBytes(effectOnBasket.rest, 20) IN IF ~tradeReportText.ok THEN Fail ELSE
    LET pad6 == ReadBytes(tradeReportText.rest, 6) IN IF ~pad6.ok THEN Fail ELSE
    Ok([ securityId            |-> securityId.value,
         lastPx                |-> lastPx.value,
         transBkdTime          |-> transBkdTime.value,
         relatedClosePrice     |-> relatedClosePrice.value,
         packageId             |-> packageId.value,
         sideMarketSegmentId   |-> sideMarketSegmentId.value,
         sideTrdSubTyp         |-> sideTrdSubTyp.value,
         productComplex        |-> productComplex.value,
         tradePublishIndicator |-> tradePublishIndicator.value,
         instrmtMatchSideId    |-> instrmtMatchSideId.value,
         effectOnBasket        |-> effectOnBasket.value,
         tradeReportText       |-> tradeReportText.value,
         pad6                  |-> pad6.value ], pad6.rest)

ZeroInstrmtMatchSideGrpComp ==
    [ securityId            |-> [i \in 1 .. 8 |-> 0],
      lastPx                |-> [i \in 1 .. 8 |-> 0],
      transBkdTime          |-> [i \in 1 .. 8 |-> 0],
      relatedClosePrice     |-> [i \in 1 .. 8 |-> 0],
      packageId             |-> [i \in 1 .. 4 |-> 0],
      sideMarketSegmentId   |-> [i \in 1 .. 4 |-> 0],
      sideTrdSubTyp         |-> [i \in 1 .. 2 |-> 0],
      productComplex        |-> [i \in 1 .. 1 |-> 0],
      tradePublishIndicator |-> [i \in 1 .. 1 |-> 0],
      instrmtMatchSideId    |-> [i \in 1 .. 1 |-> 0],
      effectOnBasket        |-> [i \in 1 .. 1 |-> 0],
      tradeReportText       |-> [i \in 1 .. 20 |-> 0],
      pad6                  |-> [i \in 1 .. 6 |-> 0] ]

(* Instrmt Match Side Grp Comp at zero, then each field in turn at the values it is checked at *)
CheckedInstrmtMatchSideGrpComp ==
    { ZeroInstrmtMatchSideGrpComp }
        \cup { [ZeroInstrmtMatchSideGrpComp EXCEPT !.securityId = one] : one \in Sample(8) }
        \cup { [ZeroInstrmtMatchSideGrpComp EXCEPT !.lastPx = one] : one \in Sample(8) }
        \cup { [ZeroInstrmtMatchSideGrpComp EXCEPT !.transBkdTime = one] : one \in Sample(8) }
        \cup { [ZeroInstrmtMatchSideGrpComp EXCEPT !.relatedClosePrice = one] : one \in Sample(8) }
        \cup { [ZeroInstrmtMatchSideGrpComp EXCEPT !.packageId = one] : one \in Sample(4) }
        \cup { [ZeroInstrmtMatchSideGrpComp EXCEPT !.sideMarketSegmentId = one] : one \in Sample(4) }
        \cup { [ZeroInstrmtMatchSideGrpComp EXCEPT !.sideTrdSubTyp = one] : one \in Sample(2) }
        \cup { [ZeroInstrmtMatchSideGrpComp EXCEPT !.productComplex = one] : one \in Sample(1) }
        \cup { [ZeroInstrmtMatchSideGrpComp EXCEPT !.tradePublishIndicator = one] : one \in Sample(1) }
        \cup { [ZeroInstrmtMatchSideGrpComp EXCEPT !.instrmtMatchSideId = one] : one \in Sample(1) }
        \cup { [ZeroInstrmtMatchSideGrpComp EXCEPT !.effectOnBasket = one] : one \in Sample(1) }
        \cup { [ZeroInstrmtMatchSideGrpComp EXCEPT !.tradeReportText = one] : one \in Sample(20) }
        \cup { [ZeroInstrmtMatchSideGrpComp EXCEPT !.pad6 = one] : one \in Sample(6) }

(* A run of Instrmt Match Side Grp Comp, written one after another *)
RECURSIVE EncodeInstrmtMatchSideGrpCompList(_)
EncodeInstrmtMatchSideGrpCompList(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeInstrmtMatchSideGrpComp(Head(messages)) \o EncodeInstrmtMatchSideGrpCompList(Tail(messages))

(* As many Instrmt Match Side Grp Comp as the field that counts them says *)
RECURSIVE ReadInstrmtMatchSideGrpCompList(_, _)
ReadInstrmtMatchSideGrpCompList(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeInstrmtMatchSideGrpComp(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadInstrmtMatchSideGrpCompList(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Instrmt Match Side Grp Comp of each kind, for the lists that carry them *)
OneInstrmtMatchSideGrpComp == { ZeroInstrmtMatchSideGrpComp }

(***************************************************************************)
(* Basket Side Alloc Grp Comp: 32 bytes                                    *)
(***************************************************************************)

BasketSideAllocGrpComp ==
    [ allocQty             : Sample(8),
      individualAllocId    : Sample(4),
      partySubIdType       : Sample(2),
      side                 : Sample(1),
      instrmtMatchSideId   : Sample(1),
      tradeAllocStatus     : Sample(1),
      partyExecutingFirm   : Sample(5),
      partyExecutingTrader : Sample(6),
      pad4                 : Sample(4) ]

EncodeBasketSideAllocGrpComp(message) ==
    message.allocQty
        \o message.individualAllocId
        \o message.partySubIdType
        \o message.side
        \o message.instrmtMatchSideId
        \o message.tradeAllocStatus
        \o message.partyExecutingFirm
        \o message.partyExecutingTrader
        \o message.pad4

DecodeBasketSideAllocGrpComp(bytes) ==
    LET allocQty == ReadBytes(bytes, 8) IN IF ~allocQty.ok THEN Fail ELSE
    LET individualAllocId == ReadBytes(allocQty.rest, 4) IN IF ~individualAllocId.ok THEN Fail ELSE
    LET partySubIdType == ReadBytes(individualAllocId.rest, 2) IN IF ~partySubIdType.ok THEN Fail ELSE
    LET side == ReadBytes(partySubIdType.rest, 1) IN IF ~side.ok THEN Fail ELSE
    LET instrmtMatchSideId == ReadBytes(side.rest, 1) IN IF ~instrmtMatchSideId.ok THEN Fail ELSE
    LET tradeAllocStatus == ReadBytes(instrmtMatchSideId.rest, 1) IN IF ~tradeAllocStatus.ok THEN Fail ELSE
    LET partyExecutingFirm == ReadBytes(tradeAllocStatus.rest, 5) IN IF ~partyExecutingFirm.ok THEN Fail ELSE
    LET partyExecutingTrader == ReadBytes(partyExecutingFirm.rest, 6) IN IF ~partyExecutingTrader.ok THEN Fail ELSE
    LET pad4 == ReadBytes(partyExecutingTrader.rest, 4) IN IF ~pad4.ok THEN Fail ELSE
    Ok([ allocQty             |-> allocQty.value,
         individualAllocId    |-> individualAllocId.value,
         partySubIdType       |-> partySubIdType.value,
         side                 |-> side.value,
         instrmtMatchSideId   |-> instrmtMatchSideId.value,
         tradeAllocStatus     |-> tradeAllocStatus.value,
         partyExecutingFirm   |-> partyExecutingFirm.value,
         partyExecutingTrader |-> partyExecutingTrader.value,
         pad4                 |-> pad4.value ], pad4.rest)

ZeroBasketSideAllocGrpComp ==
    [ allocQty             |-> [i \in 1 .. 8 |-> 0],
      individualAllocId    |-> [i \in 1 .. 4 |-> 0],
      partySubIdType       |-> [i \in 1 .. 2 |-> 0],
      side                 |-> [i \in 1 .. 1 |-> 0],
      instrmtMatchSideId   |-> [i \in 1 .. 1 |-> 0],
      tradeAllocStatus     |-> [i \in 1 .. 1 |-> 0],
      partyExecutingFirm   |-> [i \in 1 .. 5 |-> 0],
      partyExecutingTrader |-> [i \in 1 .. 6 |-> 0],
      pad4                 |-> [i \in 1 .. 4 |-> 0] ]

(* Basket Side Alloc Grp Comp at zero, then each field in turn at the values it is checked at *)
CheckedBasketSideAllocGrpComp ==
    { ZeroBasketSideAllocGrpComp }
        \cup { [ZeroBasketSideAllocGrpComp EXCEPT !.allocQty = one] : one \in Sample(8) }
        \cup { [ZeroBasketSideAllocGrpComp EXCEPT !.individualAllocId = one] : one \in Sample(4) }
        \cup { [ZeroBasketSideAllocGrpComp EXCEPT !.partySubIdType = one] : one \in Sample(2) }
        \cup { [ZeroBasketSideAllocGrpComp EXCEPT !.side = one] : one \in Sample(1) }
        \cup { [ZeroBasketSideAllocGrpComp EXCEPT !.instrmtMatchSideId = one] : one \in Sample(1) }
        \cup { [ZeroBasketSideAllocGrpComp EXCEPT !.tradeAllocStatus = one] : one \in Sample(1) }
        \cup { [ZeroBasketSideAllocGrpComp EXCEPT !.partyExecutingFirm = one] : one \in Sample(5) }
        \cup { [ZeroBasketSideAllocGrpComp EXCEPT !.partyExecutingTrader = one] : one \in Sample(6) }
        \cup { [ZeroBasketSideAllocGrpComp EXCEPT !.pad4 = one] : one \in Sample(4) }

(* A run of Basket Side Alloc Grp Comp, written one after another *)
RECURSIVE EncodeBasketSideAllocGrpCompList(_)
EncodeBasketSideAllocGrpCompList(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeBasketSideAllocGrpComp(Head(messages)) \o EncodeBasketSideAllocGrpCompList(Tail(messages))

(* As many Basket Side Alloc Grp Comp as the field that counts them says *)
RECURSIVE ReadBasketSideAllocGrpCompList(_, _)
ReadBasketSideAllocGrpCompList(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeBasketSideAllocGrpComp(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadBasketSideAllocGrpCompList(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Basket Side Alloc Grp Comp of each kind, for the lists that carry them *)
OneBasketSideAllocGrpComp == { ZeroBasketSideAllocGrpComp }

(***************************************************************************)
(* Basket Broadcast                                                        *)
(***************************************************************************)

BasketBroadcast ==
    [ pad2                    : Sample(2),
      rbcHeaderComp           : RbcHeaderComp2,
      basketTrdMatchId        : Sample(8),
      transactTime            : Sample(8),
      basketExecId            : Sample(4),
      marketSegmentId         : Sample(4),
      maturityMonthYear       : Sample(4),
      basketProfileId         : Sample(4),
      trdType                 : Sample(2),
      tradeReportType         : Sample(1),
      basketTradeReportType   : Sample(1),
      messageEventSource      : Sample(1),
      basketTradeReportText   : Sample(20),
      tradeReportId           : Sample(20),
      pad7                    : Sample(7),
      basketRootPartyGrpComp  : SampleLists(OneBasketRootPartyGrpComp2),
      instrmtMatchSideGrpComp : SampleLists(OneInstrmtMatchSideGrpComp),
      basketSideAllocGrpComp  : SampleLists(OneBasketSideAllocGrpComp) ]

EncodeBasketBroadcast(message) ==
    message.pad2
        \o EncodeRbcHeaderComp2(message.rbcHeaderComp)
        \o message.basketTrdMatchId
        \o message.transactTime
        \o message.basketExecId
        \o message.marketSegmentId
        \o message.maturityMonthYear
        \o message.basketProfileId
        \o EncodeUIntLE(Len(message.basketSideAllocGrpComp), 2)
        \o message.trdType
        \o message.tradeReportType
        \o message.basketTradeReportType
        \o message.messageEventSource
        \o EncodeUIntBE(Len(message.basketRootPartyGrpComp), 1)
        \o EncodeUIntBE(Len(message.instrmtMatchSideGrpComp), 1)
        \o message.basketTradeReportText
        \o message.tradeReportId
        \o message.pad7
        \o EncodeBasketRootPartyGrpComp2List(message.basketRootPartyGrpComp)
        \o EncodeInstrmtMatchSideGrpCompList(message.instrmtMatchSideGrpComp)
        \o EncodeBasketSideAllocGrpCompList(message.basketSideAllocGrpComp)

DecodeBasketBroadcast(bytes) ==
    LET pad2 == ReadBytes(bytes, 2) IN IF ~pad2.ok THEN Fail ELSE
    LET rbcHeaderComp == DecodeRbcHeaderComp2(pad2.rest) IN IF ~rbcHeaderComp.ok THEN Fail ELSE
    LET basketTrdMatchId == ReadBytes(rbcHeaderComp.rest, 8) IN IF ~basketTrdMatchId.ok THEN Fail ELSE
    LET transactTime == ReadBytes(basketTrdMatchId.rest, 8) IN IF ~transactTime.ok THEN Fail ELSE
    LET basketExecId == ReadBytes(transactTime.rest, 4) IN IF ~basketExecId.ok THEN Fail ELSE
    LET marketSegmentId == ReadBytes(basketExecId.rest, 4) IN IF ~marketSegmentId.ok THEN Fail ELSE
    LET maturityMonthYear == ReadBytes(marketSegmentId.rest, 4) IN IF ~maturityMonthYear.ok THEN Fail ELSE
    LET basketProfileId == ReadBytes(maturityMonthYear.rest, 4) IN IF ~basketProfileId.ok THEN Fail ELSE
    LET noBasketSideAlloc == ReadUIntLE(basketProfileId.rest, 2) IN IF ~noBasketSideAlloc.ok THEN Fail ELSE
    LET trdType == ReadBytes(noBasketSideAlloc.rest, 2) IN IF ~trdType.ok THEN Fail ELSE
    LET tradeReportType == ReadBytes(trdType.rest, 1) IN IF ~tradeReportType.ok THEN Fail ELSE
    LET basketTradeReportType == ReadBytes(tradeReportType.rest, 1) IN IF ~basketTradeReportType.ok THEN Fail ELSE
    LET messageEventSource == ReadBytes(basketTradeReportType.rest, 1) IN IF ~messageEventSource.ok THEN Fail ELSE
    LET noBasketRootPartyGrpsBc == ReadUIntBE(messageEventSource.rest, 1) IN IF ~noBasketRootPartyGrpsBc.ok THEN Fail ELSE
    LET noInstrmtMatchSides == ReadUIntBE(noBasketRootPartyGrpsBc.rest, 1) IN IF ~noInstrmtMatchSides.ok THEN Fail ELSE
    LET basketTradeReportText == ReadBytes(noInstrmtMatchSides.rest, 20) IN IF ~basketTradeReportText.ok THEN Fail ELSE
    LET tradeReportId == ReadBytes(basketTradeReportText.rest, 20) IN IF ~tradeReportId.ok THEN Fail ELSE
    LET pad7 == ReadBytes(tradeReportId.rest, 7) IN IF ~pad7.ok THEN Fail ELSE
    LET basketRootPartyGrpComp == ReadBasketRootPartyGrpComp2List(pad7.rest, noBasketRootPartyGrpsBc.value) IN IF ~basketRootPartyGrpComp.ok THEN Fail ELSE
    LET instrmtMatchSideGrpComp == ReadInstrmtMatchSideGrpCompList(basketRootPartyGrpComp.rest, noInstrmtMatchSides.value) IN IF ~instrmtMatchSideGrpComp.ok THEN Fail ELSE
    LET basketSideAllocGrpComp == ReadBasketSideAllocGrpCompList(instrmtMatchSideGrpComp.rest, noBasketSideAlloc.value) IN IF ~basketSideAllocGrpComp.ok THEN Fail ELSE
    Ok([ pad2                    |-> pad2.value,
         rbcHeaderComp           |-> rbcHeaderComp.value,
         basketTrdMatchId        |-> basketTrdMatchId.value,
         transactTime            |-> transactTime.value,
         basketExecId            |-> basketExecId.value,
         marketSegmentId         |-> marketSegmentId.value,
         maturityMonthYear       |-> maturityMonthYear.value,
         basketProfileId         |-> basketProfileId.value,
         trdType                 |-> trdType.value,
         tradeReportType         |-> tradeReportType.value,
         basketTradeReportType   |-> basketTradeReportType.value,
         messageEventSource      |-> messageEventSource.value,
         basketTradeReportText   |-> basketTradeReportText.value,
         tradeReportId           |-> tradeReportId.value,
         pad7                    |-> pad7.value,
         basketRootPartyGrpComp  |-> basketRootPartyGrpComp.value,
         instrmtMatchSideGrpComp |-> instrmtMatchSideGrpComp.value,
         basketSideAllocGrpComp  |-> basketSideAllocGrpComp.value ], basketSideAllocGrpComp.rest)

ZeroBasketBroadcast ==
    [ pad2                    |-> [i \in 1 .. 2 |-> 0],
      rbcHeaderComp           |-> ZeroRbcHeaderComp2,
      basketTrdMatchId        |-> [i \in 1 .. 8 |-> 0],
      transactTime            |-> [i \in 1 .. 8 |-> 0],
      basketExecId            |-> [i \in 1 .. 4 |-> 0],
      marketSegmentId         |-> [i \in 1 .. 4 |-> 0],
      maturityMonthYear       |-> [i \in 1 .. 4 |-> 0],
      basketProfileId         |-> [i \in 1 .. 4 |-> 0],
      trdType                 |-> [i \in 1 .. 2 |-> 0],
      tradeReportType         |-> [i \in 1 .. 1 |-> 0],
      basketTradeReportType   |-> [i \in 1 .. 1 |-> 0],
      messageEventSource      |-> [i \in 1 .. 1 |-> 0],
      basketTradeReportText   |-> [i \in 1 .. 20 |-> 0],
      tradeReportId           |-> [i \in 1 .. 20 |-> 0],
      pad7                    |-> [i \in 1 .. 7 |-> 0],
      basketRootPartyGrpComp  |-> << >>,
      instrmtMatchSideGrpComp |-> << >>,
      basketSideAllocGrpComp  |-> << >> ]

(* Basket Broadcast at zero, then each field in turn at the values it is checked at *)
CheckedBasketBroadcast ==
    { ZeroBasketBroadcast }
        \cup { [ZeroBasketBroadcast EXCEPT !.pad2 = one] : one \in Sample(2) }
        \cup { [ZeroBasketBroadcast EXCEPT !.rbcHeaderComp = one] : one \in CheckedRbcHeaderComp2 }
        \cup { [ZeroBasketBroadcast EXCEPT !.basketTrdMatchId = one] : one \in Sample(8) }
        \cup { [ZeroBasketBroadcast EXCEPT !.transactTime = one] : one \in Sample(8) }
        \cup { [ZeroBasketBroadcast EXCEPT !.basketExecId = one] : one \in Sample(4) }
        \cup { [ZeroBasketBroadcast EXCEPT !.marketSegmentId = one] : one \in Sample(4) }
        \cup { [ZeroBasketBroadcast EXCEPT !.maturityMonthYear = one] : one \in Sample(4) }
        \cup { [ZeroBasketBroadcast EXCEPT !.basketProfileId = one] : one \in Sample(4) }
        \cup { [ZeroBasketBroadcast EXCEPT !.trdType = one] : one \in Sample(2) }
        \cup { [ZeroBasketBroadcast EXCEPT !.tradeReportType = one] : one \in Sample(1) }
        \cup { [ZeroBasketBroadcast EXCEPT !.basketTradeReportType = one] : one \in Sample(1) }
        \cup { [ZeroBasketBroadcast EXCEPT !.messageEventSource = one] : one \in Sample(1) }
        \cup { [ZeroBasketBroadcast EXCEPT !.basketTradeReportText = one] : one \in Sample(20) }
        \cup { [ZeroBasketBroadcast EXCEPT !.tradeReportId = one] : one \in Sample(20) }
        \cup { [ZeroBasketBroadcast EXCEPT !.pad7 = one] : one \in Sample(7) }
        \cup { [ZeroBasketBroadcast EXCEPT !.basketRootPartyGrpComp = one] : one \in SampleLists(OneBasketRootPartyGrpComp2) }
        \cup { [ZeroBasketBroadcast EXCEPT !.instrmtMatchSideGrpComp = one] : one \in SampleLists(OneInstrmtMatchSideGrpComp) }
        \cup { [ZeroBasketBroadcast EXCEPT !.basketSideAllocGrpComp = one] : one \in SampleLists(OneBasketSideAllocGrpComp) }

(***************************************************************************)
(* Rbc Header Comp: 32 bytes                                               *)
(***************************************************************************)

RbcHeaderComp3 ==
    [ sendingTime    : Sample(8),
      applSeqNum     : Sample(8),
      applSubId      : Sample(4),
      partitionId    : Sample(2),
      applResendFlag : Sample(1),
      applId         : Sample(1),
      lastFragment   : Sample(1),
      pad7           : Sample(7) ]

EncodeRbcHeaderComp3(message) ==
    message.sendingTime
        \o message.applSeqNum
        \o message.applSubId
        \o message.partitionId
        \o message.applResendFlag
        \o message.applId
        \o message.lastFragment
        \o message.pad7

DecodeRbcHeaderComp3(bytes) ==
    LET sendingTime == ReadBytes(bytes, 8) IN IF ~sendingTime.ok THEN Fail ELSE
    LET applSeqNum == ReadBytes(sendingTime.rest, 8) IN IF ~applSeqNum.ok THEN Fail ELSE
    LET applSubId == ReadBytes(applSeqNum.rest, 4) IN IF ~applSubId.ok THEN Fail ELSE
    LET partitionId == ReadBytes(applSubId.rest, 2) IN IF ~partitionId.ok THEN Fail ELSE
    LET applResendFlag == ReadBytes(partitionId.rest, 1) IN IF ~applResendFlag.ok THEN Fail ELSE
    LET applId == ReadBytes(applResendFlag.rest, 1) IN IF ~applId.ok THEN Fail ELSE
    LET lastFragment == ReadBytes(applId.rest, 1) IN IF ~lastFragment.ok THEN Fail ELSE
    LET pad7 == ReadBytes(lastFragment.rest, 7) IN IF ~pad7.ok THEN Fail ELSE
    Ok([ sendingTime    |-> sendingTime.value,
         applSeqNum     |-> applSeqNum.value,
         applSubId      |-> applSubId.value,
         partitionId    |-> partitionId.value,
         applResendFlag |-> applResendFlag.value,
         applId         |-> applId.value,
         lastFragment   |-> lastFragment.value,
         pad7           |-> pad7.value ], pad7.rest)

ZeroRbcHeaderComp3 ==
    [ sendingTime    |-> [i \in 1 .. 8 |-> 0],
      applSeqNum     |-> [i \in 1 .. 8 |-> 0],
      applSubId      |-> [i \in 1 .. 4 |-> 0],
      partitionId    |-> [i \in 1 .. 2 |-> 0],
      applResendFlag |-> [i \in 1 .. 1 |-> 0],
      applId         |-> [i \in 1 .. 1 |-> 0],
      lastFragment   |-> [i \in 1 .. 1 |-> 0],
      pad7           |-> [i \in 1 .. 7 |-> 0] ]

(* Rbc Header Comp at zero, then each field in turn at the values it is checked at *)
CheckedRbcHeaderComp3 ==
    { ZeroRbcHeaderComp3 }
        \cup { [ZeroRbcHeaderComp3 EXCEPT !.sendingTime = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderComp3 EXCEPT !.applSeqNum = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderComp3 EXCEPT !.applSubId = one] : one \in Sample(4) }
        \cup { [ZeroRbcHeaderComp3 EXCEPT !.partitionId = one] : one \in Sample(2) }
        \cup { [ZeroRbcHeaderComp3 EXCEPT !.applResendFlag = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp3 EXCEPT !.applId = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp3 EXCEPT !.lastFragment = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp3 EXCEPT !.pad7 = one] : one \in Sample(7) }

(***************************************************************************)
(* Basket Delete Broadcast: 90 bytes                                       *)
(***************************************************************************)

BasketDeleteBroadcast ==
    [ pad2               : Sample(2),
      rbcHeaderComp      : RbcHeaderComp3,
      basketTrdMatchId   : Sample(8),
      transactTime       : Sample(8),
      marketSegmentId    : Sample(4),
      basketExecId       : Sample(4),
      basketProfileId    : Sample(4),
      trdType            : Sample(2),
      deleteReason       : Sample(1),
      messageEventSource : Sample(1),
      tradeReportId      : Sample(20),
      pad4               : Sample(4) ]

EncodeBasketDeleteBroadcast(message) ==
    message.pad2
        \o EncodeRbcHeaderComp3(message.rbcHeaderComp)
        \o message.basketTrdMatchId
        \o message.transactTime
        \o message.marketSegmentId
        \o message.basketExecId
        \o message.basketProfileId
        \o message.trdType
        \o message.deleteReason
        \o message.messageEventSource
        \o message.tradeReportId
        \o message.pad4

DecodeBasketDeleteBroadcast(bytes) ==
    LET pad2 == ReadBytes(bytes, 2) IN IF ~pad2.ok THEN Fail ELSE
    LET rbcHeaderComp == DecodeRbcHeaderComp3(pad2.rest) IN IF ~rbcHeaderComp.ok THEN Fail ELSE
    LET basketTrdMatchId == ReadBytes(rbcHeaderComp.rest, 8) IN IF ~basketTrdMatchId.ok THEN Fail ELSE
    LET transactTime == ReadBytes(basketTrdMatchId.rest, 8) IN IF ~transactTime.ok THEN Fail ELSE
    LET marketSegmentId == ReadBytes(transactTime.rest, 4) IN IF ~marketSegmentId.ok THEN Fail ELSE
    LET basketExecId == ReadBytes(marketSegmentId.rest, 4) IN IF ~basketExecId.ok THEN Fail ELSE
    LET basketProfileId == ReadBytes(basketExecId.rest, 4) IN IF ~basketProfileId.ok THEN Fail ELSE
    LET trdType == ReadBytes(basketProfileId.rest, 2) IN IF ~trdType.ok THEN Fail ELSE
    LET deleteReason == ReadBytes(trdType.rest, 1) IN IF ~deleteReason.ok THEN Fail ELSE
    LET messageEventSource == ReadBytes(deleteReason.rest, 1) IN IF ~messageEventSource.ok THEN Fail ELSE
    LET tradeReportId == ReadBytes(messageEventSource.rest, 20) IN IF ~tradeReportId.ok THEN Fail ELSE
    LET pad4 == ReadBytes(tradeReportId.rest, 4) IN IF ~pad4.ok THEN Fail ELSE
    Ok([ pad2               |-> pad2.value,
         rbcHeaderComp      |-> rbcHeaderComp.value,
         basketTrdMatchId   |-> basketTrdMatchId.value,
         transactTime       |-> transactTime.value,
         marketSegmentId    |-> marketSegmentId.value,
         basketExecId       |-> basketExecId.value,
         basketProfileId    |-> basketProfileId.value,
         trdType            |-> trdType.value,
         deleteReason       |-> deleteReason.value,
         messageEventSource |-> messageEventSource.value,
         tradeReportId      |-> tradeReportId.value,
         pad4               |-> pad4.value ], pad4.rest)

ZeroBasketDeleteBroadcast ==
    [ pad2               |-> [i \in 1 .. 2 |-> 0],
      rbcHeaderComp      |-> ZeroRbcHeaderComp3,
      basketTrdMatchId   |-> [i \in 1 .. 8 |-> 0],
      transactTime       |-> [i \in 1 .. 8 |-> 0],
      marketSegmentId    |-> [i \in 1 .. 4 |-> 0],
      basketExecId       |-> [i \in 1 .. 4 |-> 0],
      basketProfileId    |-> [i \in 1 .. 4 |-> 0],
      trdType            |-> [i \in 1 .. 2 |-> 0],
      deleteReason       |-> [i \in 1 .. 1 |-> 0],
      messageEventSource |-> [i \in 1 .. 1 |-> 0],
      tradeReportId      |-> [i \in 1 .. 20 |-> 0],
      pad4               |-> [i \in 1 .. 4 |-> 0] ]

(* Basket Delete Broadcast at zero, then each field in turn at the values it is checked at *)
CheckedBasketDeleteBroadcast ==
    { ZeroBasketDeleteBroadcast }
        \cup { [ZeroBasketDeleteBroadcast EXCEPT !.pad2 = one] : one \in Sample(2) }
        \cup { [ZeroBasketDeleteBroadcast EXCEPT !.rbcHeaderComp = one] : one \in CheckedRbcHeaderComp3 }
        \cup { [ZeroBasketDeleteBroadcast EXCEPT !.basketTrdMatchId = one] : one \in Sample(8) }
        \cup { [ZeroBasketDeleteBroadcast EXCEPT !.transactTime = one] : one \in Sample(8) }
        \cup { [ZeroBasketDeleteBroadcast EXCEPT !.marketSegmentId = one] : one \in Sample(4) }
        \cup { [ZeroBasketDeleteBroadcast EXCEPT !.basketExecId = one] : one \in Sample(4) }
        \cup { [ZeroBasketDeleteBroadcast EXCEPT !.basketProfileId = one] : one \in Sample(4) }
        \cup { [ZeroBasketDeleteBroadcast EXCEPT !.trdType = one] : one \in Sample(2) }
        \cup { [ZeroBasketDeleteBroadcast EXCEPT !.deleteReason = one] : one \in Sample(1) }
        \cup { [ZeroBasketDeleteBroadcast EXCEPT !.messageEventSource = one] : one \in Sample(1) }
        \cup { [ZeroBasketDeleteBroadcast EXCEPT !.tradeReportId = one] : one \in Sample(20) }
        \cup { [ZeroBasketDeleteBroadcast EXCEPT !.pad4 = one] : one \in Sample(4) }

(***************************************************************************)
(* Rbc Header Comp: 32 bytes                                               *)
(***************************************************************************)

RbcHeaderComp4 ==
    [ sendingTime    : Sample(8),
      applSeqNum     : Sample(8),
      applSubId      : Sample(4),
      partitionId    : Sample(2),
      applResendFlag : Sample(1),
      applId         : Sample(1),
      lastFragment   : Sample(1),
      pad7           : Sample(7) ]

EncodeRbcHeaderComp4(message) ==
    message.sendingTime
        \o message.applSeqNum
        \o message.applSubId
        \o message.partitionId
        \o message.applResendFlag
        \o message.applId
        \o message.lastFragment
        \o message.pad7

DecodeRbcHeaderComp4(bytes) ==
    LET sendingTime == ReadBytes(bytes, 8) IN IF ~sendingTime.ok THEN Fail ELSE
    LET applSeqNum == ReadBytes(sendingTime.rest, 8) IN IF ~applSeqNum.ok THEN Fail ELSE
    LET applSubId == ReadBytes(applSeqNum.rest, 4) IN IF ~applSubId.ok THEN Fail ELSE
    LET partitionId == ReadBytes(applSubId.rest, 2) IN IF ~partitionId.ok THEN Fail ELSE
    LET applResendFlag == ReadBytes(partitionId.rest, 1) IN IF ~applResendFlag.ok THEN Fail ELSE
    LET applId == ReadBytes(applResendFlag.rest, 1) IN IF ~applId.ok THEN Fail ELSE
    LET lastFragment == ReadBytes(applId.rest, 1) IN IF ~lastFragment.ok THEN Fail ELSE
    LET pad7 == ReadBytes(lastFragment.rest, 7) IN IF ~pad7.ok THEN Fail ELSE
    Ok([ sendingTime    |-> sendingTime.value,
         applSeqNum     |-> applSeqNum.value,
         applSubId      |-> applSubId.value,
         partitionId    |-> partitionId.value,
         applResendFlag |-> applResendFlag.value,
         applId         |-> applId.value,
         lastFragment   |-> lastFragment.value,
         pad7           |-> pad7.value ], pad7.rest)

ZeroRbcHeaderComp4 ==
    [ sendingTime    |-> [i \in 1 .. 8 |-> 0],
      applSeqNum     |-> [i \in 1 .. 8 |-> 0],
      applSubId      |-> [i \in 1 .. 4 |-> 0],
      partitionId    |-> [i \in 1 .. 2 |-> 0],
      applResendFlag |-> [i \in 1 .. 1 |-> 0],
      applId         |-> [i \in 1 .. 1 |-> 0],
      lastFragment   |-> [i \in 1 .. 1 |-> 0],
      pad7           |-> [i \in 1 .. 7 |-> 0] ]

(* Rbc Header Comp at zero, then each field in turn at the values it is checked at *)
CheckedRbcHeaderComp4 ==
    { ZeroRbcHeaderComp4 }
        \cup { [ZeroRbcHeaderComp4 EXCEPT !.sendingTime = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderComp4 EXCEPT !.applSeqNum = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderComp4 EXCEPT !.applSubId = one] : one \in Sample(4) }
        \cup { [ZeroRbcHeaderComp4 EXCEPT !.partitionId = one] : one \in Sample(2) }
        \cup { [ZeroRbcHeaderComp4 EXCEPT !.applResendFlag = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp4 EXCEPT !.applId = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp4 EXCEPT !.lastFragment = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp4 EXCEPT !.pad7 = one] : one \in Sample(7) }

(***************************************************************************)
(* Basket Exec Grp Comp: 16 bytes                                          *)
(***************************************************************************)

BasketExecGrpComp ==
    [ packageId           : Sample(4),
      sideMarketSegmentId : Sample(4),
      allocId             : Sample(4),
      sideTrdSubTyp       : Sample(2),
      pad2                : Sample(2) ]

EncodeBasketExecGrpComp(message) ==
    message.packageId
        \o message.sideMarketSegmentId
        \o message.allocId
        \o message.sideTrdSubTyp
        \o message.pad2

DecodeBasketExecGrpComp(bytes) ==
    LET packageId == ReadBytes(bytes, 4) IN IF ~packageId.ok THEN Fail ELSE
    LET sideMarketSegmentId == ReadBytes(packageId.rest, 4) IN IF ~sideMarketSegmentId.ok THEN Fail ELSE
    LET allocId == ReadBytes(sideMarketSegmentId.rest, 4) IN IF ~allocId.ok THEN Fail ELSE
    LET sideTrdSubTyp == ReadBytes(allocId.rest, 2) IN IF ~sideTrdSubTyp.ok THEN Fail ELSE
    LET pad2 == ReadBytes(sideTrdSubTyp.rest, 2) IN IF ~pad2.ok THEN Fail ELSE
    Ok([ packageId           |-> packageId.value,
         sideMarketSegmentId |-> sideMarketSegmentId.value,
         allocId             |-> allocId.value,
         sideTrdSubTyp       |-> sideTrdSubTyp.value,
         pad2                |-> pad2.value ], pad2.rest)

ZeroBasketExecGrpComp ==
    [ packageId           |-> [i \in 1 .. 4 |-> 0],
      sideMarketSegmentId |-> [i \in 1 .. 4 |-> 0],
      allocId             |-> [i \in 1 .. 4 |-> 0],
      sideTrdSubTyp       |-> [i \in 1 .. 2 |-> 0],
      pad2                |-> [i \in 1 .. 2 |-> 0] ]

(* Basket Exec Grp Comp at zero, then each field in turn at the values it is checked at *)
CheckedBasketExecGrpComp ==
    { ZeroBasketExecGrpComp }
        \cup { [ZeroBasketExecGrpComp EXCEPT !.packageId = one] : one \in Sample(4) }
        \cup { [ZeroBasketExecGrpComp EXCEPT !.sideMarketSegmentId = one] : one \in Sample(4) }
        \cup { [ZeroBasketExecGrpComp EXCEPT !.allocId = one] : one \in Sample(4) }
        \cup { [ZeroBasketExecGrpComp EXCEPT !.sideTrdSubTyp = one] : one \in Sample(2) }
        \cup { [ZeroBasketExecGrpComp EXCEPT !.pad2 = one] : one \in Sample(2) }

(* A run of Basket Exec Grp Comp, written one after another *)
RECURSIVE EncodeBasketExecGrpCompList(_)
EncodeBasketExecGrpCompList(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeBasketExecGrpComp(Head(messages)) \o EncodeBasketExecGrpCompList(Tail(messages))

(* As many Basket Exec Grp Comp as the field that counts them says *)
RECURSIVE ReadBasketExecGrpCompList(_, _)
ReadBasketExecGrpCompList(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeBasketExecGrpComp(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadBasketExecGrpCompList(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Basket Exec Grp Comp of each kind, for the lists that carry them *)
OneBasketExecGrpComp == { ZeroBasketExecGrpComp }

(***************************************************************************)
(* Basket Execution Broadcast                                              *)
(***************************************************************************)

BasketExecutionBroadcast ==
    [ pad2                    : Sample(2),
      rbcHeaderComp           : RbcHeaderComp4,
      basketTrdMatchId        : Sample(8),
      transactTime            : Sample(8),
      basketExecId            : Sample(4),
      marketSegmentId         : Sample(4),
      basketProfileId         : Sample(4),
      trdType                 : Sample(2),
      tradeReportType         : Sample(1),
      messageEventSource      : Sample(1),
      basketSideTradeReportId : Sample(20),
      pad3                    : Sample(3),
      basketExecGrpComp       : SampleLists(OneBasketExecGrpComp) ]

EncodeBasketExecutionBroadcast(message) ==
    message.pad2
        \o EncodeRbcHeaderComp4(message.rbcHeaderComp)
        \o message.basketTrdMatchId
        \o message.transactTime
        \o message.basketExecId
        \o message.marketSegmentId
        \o message.basketProfileId
        \o message.trdType
        \o message.tradeReportType
        \o EncodeUIntBE(Len(message.basketExecGrpComp), 1)
        \o message.messageEventSource
        \o message.basketSideTradeReportId
        \o message.pad3
        \o EncodeBasketExecGrpCompList(message.basketExecGrpComp)

DecodeBasketExecutionBroadcast(bytes) ==
    LET pad2 == ReadBytes(bytes, 2) IN IF ~pad2.ok THEN Fail ELSE
    LET rbcHeaderComp == DecodeRbcHeaderComp4(pad2.rest) IN IF ~rbcHeaderComp.ok THEN Fail ELSE
    LET basketTrdMatchId == ReadBytes(rbcHeaderComp.rest, 8) IN IF ~basketTrdMatchId.ok THEN Fail ELSE
    LET transactTime == ReadBytes(basketTrdMatchId.rest, 8) IN IF ~transactTime.ok THEN Fail ELSE
    LET basketExecId == ReadBytes(transactTime.rest, 4) IN IF ~basketExecId.ok THEN Fail ELSE
    LET marketSegmentId == ReadBytes(basketExecId.rest, 4) IN IF ~marketSegmentId.ok THEN Fail ELSE
    LET basketProfileId == ReadBytes(marketSegmentId.rest, 4) IN IF ~basketProfileId.ok THEN Fail ELSE
    LET trdType == ReadBytes(basketProfileId.rest, 2) IN IF ~trdType.ok THEN Fail ELSE
    LET tradeReportType == ReadBytes(trdType.rest, 1) IN IF ~tradeReportType.ok THEN Fail ELSE
    LET noInstrmtMatchSides == ReadUIntBE(tradeReportType.rest, 1) IN IF ~noInstrmtMatchSides.ok THEN Fail ELSE
    LET messageEventSource == ReadBytes(noInstrmtMatchSides.rest, 1) IN IF ~messageEventSource.ok THEN Fail ELSE
    LET basketSideTradeReportId == ReadBytes(messageEventSource.rest, 20) IN IF ~basketSideTradeReportId.ok THEN Fail ELSE
    LET pad3 == ReadBytes(basketSideTradeReportId.rest, 3) IN IF ~pad3.ok THEN Fail ELSE
    LET basketExecGrpComp == ReadBasketExecGrpCompList(pad3.rest, noInstrmtMatchSides.value) IN IF ~basketExecGrpComp.ok THEN Fail ELSE
    Ok([ pad2                    |-> pad2.value,
         rbcHeaderComp           |-> rbcHeaderComp.value,
         basketTrdMatchId        |-> basketTrdMatchId.value,
         transactTime            |-> transactTime.value,
         basketExecId            |-> basketExecId.value,
         marketSegmentId         |-> marketSegmentId.value,
         basketProfileId         |-> basketProfileId.value,
         trdType                 |-> trdType.value,
         tradeReportType         |-> tradeReportType.value,
         messageEventSource      |-> messageEventSource.value,
         basketSideTradeReportId |-> basketSideTradeReportId.value,
         pad3                    |-> pad3.value,
         basketExecGrpComp       |-> basketExecGrpComp.value ], basketExecGrpComp.rest)

ZeroBasketExecutionBroadcast ==
    [ pad2                    |-> [i \in 1 .. 2 |-> 0],
      rbcHeaderComp           |-> ZeroRbcHeaderComp4,
      basketTrdMatchId        |-> [i \in 1 .. 8 |-> 0],
      transactTime            |-> [i \in 1 .. 8 |-> 0],
      basketExecId            |-> [i \in 1 .. 4 |-> 0],
      marketSegmentId         |-> [i \in 1 .. 4 |-> 0],
      basketProfileId         |-> [i \in 1 .. 4 |-> 0],
      trdType                 |-> [i \in 1 .. 2 |-> 0],
      tradeReportType         |-> [i \in 1 .. 1 |-> 0],
      messageEventSource      |-> [i \in 1 .. 1 |-> 0],
      basketSideTradeReportId |-> [i \in 1 .. 20 |-> 0],
      pad3                    |-> [i \in 1 .. 3 |-> 0],
      basketExecGrpComp       |-> << >> ]

(* Basket Execution Broadcast at zero, then each field in turn at the values it is checked at *)
CheckedBasketExecutionBroadcast ==
    { ZeroBasketExecutionBroadcast }
        \cup { [ZeroBasketExecutionBroadcast EXCEPT !.pad2 = one] : one \in Sample(2) }
        \cup { [ZeroBasketExecutionBroadcast EXCEPT !.rbcHeaderComp = one] : one \in CheckedRbcHeaderComp4 }
        \cup { [ZeroBasketExecutionBroadcast EXCEPT !.basketTrdMatchId = one] : one \in Sample(8) }
        \cup { [ZeroBasketExecutionBroadcast EXCEPT !.transactTime = one] : one \in Sample(8) }
        \cup { [ZeroBasketExecutionBroadcast EXCEPT !.basketExecId = one] : one \in Sample(4) }
        \cup { [ZeroBasketExecutionBroadcast EXCEPT !.marketSegmentId = one] : one \in Sample(4) }
        \cup { [ZeroBasketExecutionBroadcast EXCEPT !.basketProfileId = one] : one \in Sample(4) }
        \cup { [ZeroBasketExecutionBroadcast EXCEPT !.trdType = one] : one \in Sample(2) }
        \cup { [ZeroBasketExecutionBroadcast EXCEPT !.tradeReportType = one] : one \in Sample(1) }
        \cup { [ZeroBasketExecutionBroadcast EXCEPT !.messageEventSource = one] : one \in Sample(1) }
        \cup { [ZeroBasketExecutionBroadcast EXCEPT !.basketSideTradeReportId = one] : one \in Sample(20) }
        \cup { [ZeroBasketExecutionBroadcast EXCEPT !.pad3 = one] : one \in Sample(3) }
        \cup { [ZeroBasketExecutionBroadcast EXCEPT !.basketExecGrpComp = one] : one \in SampleLists(OneBasketExecGrpComp) }

(***************************************************************************)
(* Response Header Comp: 24 bytes                                          *)
(***************************************************************************)

ResponseHeaderComp ==
    [ requestTime : Sample(8),
      sendingTime : Sample(8),
      msgSeqNum   : Sample(4),
      pad4        : Sample(4) ]

EncodeResponseHeaderComp(message) ==
    message.requestTime
        \o message.sendingTime
        \o message.msgSeqNum
        \o message.pad4

DecodeResponseHeaderComp(bytes) ==
    LET requestTime == ReadBytes(bytes, 8) IN IF ~requestTime.ok THEN Fail ELSE
    LET sendingTime == ReadBytes(requestTime.rest, 8) IN IF ~sendingTime.ok THEN Fail ELSE
    LET msgSeqNum == ReadBytes(sendingTime.rest, 4) IN IF ~msgSeqNum.ok THEN Fail ELSE
    LET pad4 == ReadBytes(msgSeqNum.rest, 4) IN IF ~pad4.ok THEN Fail ELSE
    Ok([ requestTime |-> requestTime.value,
         sendingTime |-> sendingTime.value,
         msgSeqNum   |-> msgSeqNum.value,
         pad4        |-> pad4.value ], pad4.rest)

ZeroResponseHeaderComp ==
    [ requestTime |-> [i \in 1 .. 8 |-> 0],
      sendingTime |-> [i \in 1 .. 8 |-> 0],
      msgSeqNum   |-> [i \in 1 .. 4 |-> 0],
      pad4        |-> [i \in 1 .. 4 |-> 0] ]

(* Response Header Comp at zero, then each field in turn at the values it is checked at *)
CheckedResponseHeaderComp ==
    { ZeroResponseHeaderComp }
        \cup { [ZeroResponseHeaderComp EXCEPT !.requestTime = one] : one \in Sample(8) }
        \cup { [ZeroResponseHeaderComp EXCEPT !.sendingTime = one] : one \in Sample(8) }
        \cup { [ZeroResponseHeaderComp EXCEPT !.msgSeqNum = one] : one \in Sample(4) }
        \cup { [ZeroResponseHeaderComp EXCEPT !.pad4 = one] : one \in Sample(4) }

(***************************************************************************)
(* Basket Response: 50 bytes                                               *)
(***************************************************************************)

BasketResponse ==
    [ pad2               : Sample(2),
      responseHeaderComp : ResponseHeaderComp,
      basketExecId       : Sample(4),
      tradeReportId      : Sample(20) ]

EncodeBasketResponse(message) ==
    message.pad2
        \o EncodeResponseHeaderComp(message.responseHeaderComp)
        \o message.basketExecId
        \o message.tradeReportId

DecodeBasketResponse(bytes) ==
    LET pad2 == ReadBytes(bytes, 2) IN IF ~pad2.ok THEN Fail ELSE
    LET responseHeaderComp == DecodeResponseHeaderComp(pad2.rest) IN IF ~responseHeaderComp.ok THEN Fail ELSE
    LET basketExecId == ReadBytes(responseHeaderComp.rest, 4) IN IF ~basketExecId.ok THEN Fail ELSE
    LET tradeReportId == ReadBytes(basketExecId.rest, 20) IN IF ~tradeReportId.ok THEN Fail ELSE
    Ok([ pad2               |-> pad2.value,
         responseHeaderComp |-> responseHeaderComp.value,
         basketExecId       |-> basketExecId.value,
         tradeReportId      |-> tradeReportId.value ], tradeReportId.rest)

ZeroBasketResponse ==
    [ pad2               |-> [i \in 1 .. 2 |-> 0],
      responseHeaderComp |-> ZeroResponseHeaderComp,
      basketExecId       |-> [i \in 1 .. 4 |-> 0],
      tradeReportId      |-> [i \in 1 .. 20 |-> 0] ]

(* Basket Response at zero, then each field in turn at the values it is checked at *)
CheckedBasketResponse ==
    { ZeroBasketResponse }
        \cup { [ZeroBasketResponse EXCEPT !.pad2 = one] : one \in Sample(2) }
        \cup { [ZeroBasketResponse EXCEPT !.responseHeaderComp = one] : one \in CheckedResponseHeaderComp }
        \cup { [ZeroBasketResponse EXCEPT !.basketExecId = one] : one \in Sample(4) }
        \cup { [ZeroBasketResponse EXCEPT !.tradeReportId = one] : one \in Sample(20) }

(***************************************************************************)
(* Notif Header Comp: 8 bytes                                              *)
(***************************************************************************)

NotifHeaderComp ==
    [ sendingTime : Sample(8) ]

EncodeNotifHeaderComp(message) ==
    message.sendingTime

DecodeNotifHeaderComp(bytes) ==
    LET sendingTime == ReadBytes(bytes, 8) IN IF ~sendingTime.ok THEN Fail ELSE
    Ok([ sendingTime |-> sendingTime.value ], sendingTime.rest)

ZeroNotifHeaderComp ==
    [ sendingTime |-> [i \in 1 .. 8 |-> 0] ]

(* Notif Header Comp at zero, then each field in turn at the values it is checked at *)
CheckedNotifHeaderComp ==
    { ZeroNotifHeaderComp }
        \cup { [ZeroNotifHeaderComp EXCEPT !.sendingTime = one] : one \in Sample(8) }

(***************************************************************************)
(* Broadcast Error Notification                                            *)
(***************************************************************************)

BroadcastErrorNotification ==
    [ pad2             : Sample(2),
      notifHeaderComp  : NotifHeaderComp,
      applIdStatus     : Sample(4),
      refApplSubId     : Sample(4),
      refApplId        : Sample(1),
      sessionStatus    : Sample(1),
      pad4             : Sample(4),
      varText          : SampleBytes,
      alignmentPadding : SampleBytes ]

EncodeBroadcastErrorNotification(message) ==
    message.pad2
        \o EncodeNotifHeaderComp(message.notifHeaderComp)
        \o message.applIdStatus
        \o message.refApplSubId
        \o EncodeUIntLE(Len(message.varText), 2)
        \o message.refApplId
        \o message.sessionStatus
        \o message.pad4
        \o message.varText
        \o message.alignmentPadding

DecodeBroadcastErrorNotification(bytes) ==
    LET pad2 == ReadBytes(bytes, 2) IN IF ~pad2.ok THEN Fail ELSE
    LET notifHeaderComp == DecodeNotifHeaderComp(pad2.rest) IN IF ~notifHeaderComp.ok THEN Fail ELSE
    LET applIdStatus == ReadBytes(notifHeaderComp.rest, 4) IN IF ~applIdStatus.ok THEN Fail ELSE
    LET refApplSubId == ReadBytes(applIdStatus.rest, 4) IN IF ~refApplSubId.ok THEN Fail ELSE
    LET varTextLen == ReadUIntLE(refApplSubId.rest, 2) IN IF ~varTextLen.ok THEN Fail ELSE
    LET refApplId == ReadBytes(varTextLen.rest, 1) IN IF ~refApplId.ok THEN Fail ELSE
    LET sessionStatus == ReadBytes(refApplId.rest, 1) IN IF ~sessionStatus.ok THEN Fail ELSE
    LET pad4 == ReadBytes(sessionStatus.rest, 4) IN IF ~pad4.ok THEN Fail ELSE
    LET varText == ReadBytes(pad4.rest, varTextLen.value) IN IF ~varText.ok THEN Fail ELSE
    LET alignmentPadding == Ok(varText.rest, << >>) IN IF ~alignmentPadding.ok THEN Fail ELSE
    Ok([ pad2             |-> pad2.value,
         notifHeaderComp  |-> notifHeaderComp.value,
         applIdStatus     |-> applIdStatus.value,
         refApplSubId     |-> refApplSubId.value,
         refApplId        |-> refApplId.value,
         sessionStatus    |-> sessionStatus.value,
         pad4             |-> pad4.value,
         varText          |-> varText.value,
         alignmentPadding |-> alignmentPadding.value ], alignmentPadding.rest)

ZeroBroadcastErrorNotification ==
    [ pad2             |-> [i \in 1 .. 2 |-> 0],
      notifHeaderComp  |-> ZeroNotifHeaderComp,
      applIdStatus     |-> [i \in 1 .. 4 |-> 0],
      refApplSubId     |-> [i \in 1 .. 4 |-> 0],
      refApplId        |-> [i \in 1 .. 1 |-> 0],
      sessionStatus    |-> [i \in 1 .. 1 |-> 0],
      pad4             |-> [i \in 1 .. 4 |-> 0],
      varText          |-> << >>,
      alignmentPadding |-> << >> ]

(* Broadcast Error Notification at zero, then each field in turn at the values it is checked at *)
CheckedBroadcastErrorNotification ==
    { ZeroBroadcastErrorNotification }
        \cup { [ZeroBroadcastErrorNotification EXCEPT !.pad2 = one] : one \in Sample(2) }
        \cup { [ZeroBroadcastErrorNotification EXCEPT !.notifHeaderComp = one] : one \in CheckedNotifHeaderComp }
        \cup { [ZeroBroadcastErrorNotification EXCEPT !.applIdStatus = one] : one \in Sample(4) }
        \cup { [ZeroBroadcastErrorNotification EXCEPT !.refApplSubId = one] : one \in Sample(4) }
        \cup { [ZeroBroadcastErrorNotification EXCEPT !.refApplId = one] : one \in Sample(1) }
        \cup { [ZeroBroadcastErrorNotification EXCEPT !.sessionStatus = one] : one \in Sample(1) }
        \cup { [ZeroBroadcastErrorNotification EXCEPT !.pad4 = one] : one \in Sample(4) }
        \cup { [ZeroBroadcastErrorNotification EXCEPT !.varText = one] : one \in SampleBytes }
        \cup { [ZeroBroadcastErrorNotification EXCEPT !.alignmentPadding = one] : one \in SampleBytes }

(***************************************************************************)
(* Rbc Header Me Comp: 56 bytes                                            *)
(***************************************************************************)

RbcHeaderMeComp ==
    [ trdRegTsTimeOut : Sample(8),
      notificationIn  : Sample(8),
      sendingTime     : Sample(8),
      applSubId       : Sample(4),
      partitionId     : Sample(2),
      applMsgId       : Sample(16),
      applId          : Sample(1),
      applResendFlag  : Sample(1),
      lastFragment    : Sample(1),
      pad7            : Sample(7) ]

EncodeRbcHeaderMeComp(message) ==
    message.trdRegTsTimeOut
        \o message.notificationIn
        \o message.sendingTime
        \o message.applSubId
        \o message.partitionId
        \o message.applMsgId
        \o message.applId
        \o message.applResendFlag
        \o message.lastFragment
        \o message.pad7

DecodeRbcHeaderMeComp(bytes) ==
    LET trdRegTsTimeOut == ReadBytes(bytes, 8) IN IF ~trdRegTsTimeOut.ok THEN Fail ELSE
    LET notificationIn == ReadBytes(trdRegTsTimeOut.rest, 8) IN IF ~notificationIn.ok THEN Fail ELSE
    LET sendingTime == ReadBytes(notificationIn.rest, 8) IN IF ~sendingTime.ok THEN Fail ELSE
    LET applSubId == ReadBytes(sendingTime.rest, 4) IN IF ~applSubId.ok THEN Fail ELSE
    LET partitionId == ReadBytes(applSubId.rest, 2) IN IF ~partitionId.ok THEN Fail ELSE
    LET applMsgId == ReadBytes(partitionId.rest, 16) IN IF ~applMsgId.ok THEN Fail ELSE
    LET applId == ReadBytes(applMsgId.rest, 1) IN IF ~applId.ok THEN Fail ELSE
    LET applResendFlag == ReadBytes(applId.rest, 1) IN IF ~applResendFlag.ok THEN Fail ELSE
    LET lastFragment == ReadBytes(applResendFlag.rest, 1) IN IF ~lastFragment.ok THEN Fail ELSE
    LET pad7 == ReadBytes(lastFragment.rest, 7) IN IF ~pad7.ok THEN Fail ELSE
    Ok([ trdRegTsTimeOut |-> trdRegTsTimeOut.value,
         notificationIn  |-> notificationIn.value,
         sendingTime     |-> sendingTime.value,
         applSubId       |-> applSubId.value,
         partitionId     |-> partitionId.value,
         applMsgId       |-> applMsgId.value,
         applId          |-> applId.value,
         applResendFlag  |-> applResendFlag.value,
         lastFragment    |-> lastFragment.value,
         pad7            |-> pad7.value ], pad7.rest)

ZeroRbcHeaderMeComp ==
    [ trdRegTsTimeOut |-> [i \in 1 .. 8 |-> 0],
      notificationIn  |-> [i \in 1 .. 8 |-> 0],
      sendingTime     |-> [i \in 1 .. 8 |-> 0],
      applSubId       |-> [i \in 1 .. 4 |-> 0],
      partitionId     |-> [i \in 1 .. 2 |-> 0],
      applMsgId       |-> [i \in 1 .. 16 |-> 0],
      applId          |-> [i \in 1 .. 1 |-> 0],
      applResendFlag  |-> [i \in 1 .. 1 |-> 0],
      lastFragment    |-> [i \in 1 .. 1 |-> 0],
      pad7            |-> [i \in 1 .. 7 |-> 0] ]

(* Rbc Header Me Comp at zero, then each field in turn at the values it is checked at *)
CheckedRbcHeaderMeComp ==
    { ZeroRbcHeaderMeComp }
        \cup { [ZeroRbcHeaderMeComp EXCEPT !.trdRegTsTimeOut = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderMeComp EXCEPT !.notificationIn = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderMeComp EXCEPT !.sendingTime = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderMeComp EXCEPT !.applSubId = one] : one \in Sample(4) }
        \cup { [ZeroRbcHeaderMeComp EXCEPT !.partitionId = one] : one \in Sample(2) }
        \cup { [ZeroRbcHeaderMeComp EXCEPT !.applMsgId = one] : one \in Sample(16) }
        \cup { [ZeroRbcHeaderMeComp EXCEPT !.applId = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderMeComp EXCEPT !.applResendFlag = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderMeComp EXCEPT !.lastFragment = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderMeComp EXCEPT !.pad7 = one] : one \in Sample(7) }

(***************************************************************************)
(* Clip Deletion Notification: 106 bytes                                   *)
(***************************************************************************)

ClipDeletionNotification ==
    [ pad2                  : Sample(2),
      rbcHeaderMeComp       : RbcHeaderMeComp,
      orderId               : Sample(8),
      execId                : Sample(8),
      securityId            : Sample(8),
      cxlQty                : Sample(8),
      marketSegmentId       : Sample(4),
      execRestatementReason : Sample(2),
      productComplex        : Sample(1),
      side                  : Sample(1),
      ordStatus             : Sample(1),
      execType              : Sample(1),
      pad6                  : Sample(6) ]

EncodeClipDeletionNotification(message) ==
    message.pad2
        \o EncodeRbcHeaderMeComp(message.rbcHeaderMeComp)
        \o message.orderId
        \o message.execId
        \o message.securityId
        \o message.cxlQty
        \o message.marketSegmentId
        \o message.execRestatementReason
        \o message.productComplex
        \o message.side
        \o message.ordStatus
        \o message.execType
        \o message.pad6

DecodeClipDeletionNotification(bytes) ==
    LET pad2 == ReadBytes(bytes, 2) IN IF ~pad2.ok THEN Fail ELSE
    LET rbcHeaderMeComp == DecodeRbcHeaderMeComp(pad2.rest) IN IF ~rbcHeaderMeComp.ok THEN Fail ELSE
    LET orderId == ReadBytes(rbcHeaderMeComp.rest, 8) IN IF ~orderId.ok THEN Fail ELSE
    LET execId == ReadBytes(orderId.rest, 8) IN IF ~execId.ok THEN Fail ELSE
    LET securityId == ReadBytes(execId.rest, 8) IN IF ~securityId.ok THEN Fail ELSE
    LET cxlQty == ReadBytes(securityId.rest, 8) IN IF ~cxlQty.ok THEN Fail ELSE
    LET marketSegmentId == ReadBytes(cxlQty.rest, 4) IN IF ~marketSegmentId.ok THEN Fail ELSE
    LET execRestatementReason == ReadBytes(marketSegmentId.rest, 2) IN IF ~execRestatementReason.ok THEN Fail ELSE
    LET productComplex == ReadBytes(execRestatementReason.rest, 1) IN IF ~productComplex.ok THEN Fail ELSE
    LET side == ReadBytes(productComplex.rest, 1) IN IF ~side.ok THEN Fail ELSE
    LET ordStatus == ReadBytes(side.rest, 1) IN IF ~ordStatus.ok THEN Fail ELSE
    LET execType == ReadBytes(ordStatus.rest, 1) IN IF ~execType.ok THEN Fail ELSE
    LET pad6 == ReadBytes(execType.rest, 6) IN IF ~pad6.ok THEN Fail ELSE
    Ok([ pad2                  |-> pad2.value,
         rbcHeaderMeComp       |-> rbcHeaderMeComp.value,
         orderId               |-> orderId.value,
         execId                |-> execId.value,
         securityId            |-> securityId.value,
         cxlQty                |-> cxlQty.value,
         marketSegmentId       |-> marketSegmentId.value,
         execRestatementReason |-> execRestatementReason.value,
         productComplex        |-> productComplex.value,
         side                  |-> side.value,
         ordStatus             |-> ordStatus.value,
         execType              |-> execType.value,
         pad6                  |-> pad6.value ], pad6.rest)

ZeroClipDeletionNotification ==
    [ pad2                  |-> [i \in 1 .. 2 |-> 0],
      rbcHeaderMeComp       |-> ZeroRbcHeaderMeComp,
      orderId               |-> [i \in 1 .. 8 |-> 0],
      execId                |-> [i \in 1 .. 8 |-> 0],
      securityId            |-> [i \in 1 .. 8 |-> 0],
      cxlQty                |-> [i \in 1 .. 8 |-> 0],
      marketSegmentId       |-> [i \in 1 .. 4 |-> 0],
      execRestatementReason |-> [i \in 1 .. 2 |-> 0],
      productComplex        |-> [i \in 1 .. 1 |-> 0],
      side                  |-> [i \in 1 .. 1 |-> 0],
      ordStatus             |-> [i \in 1 .. 1 |-> 0],
      execType              |-> [i \in 1 .. 1 |-> 0],
      pad6                  |-> [i \in 1 .. 6 |-> 0] ]

(* Clip Deletion Notification at zero, then each field in turn at the values it is checked at *)
CheckedClipDeletionNotification ==
    { ZeroClipDeletionNotification }
        \cup { [ZeroClipDeletionNotification EXCEPT !.pad2 = one] : one \in Sample(2) }
        \cup { [ZeroClipDeletionNotification EXCEPT !.rbcHeaderMeComp = one] : one \in CheckedRbcHeaderMeComp }
        \cup { [ZeroClipDeletionNotification EXCEPT !.orderId = one] : one \in Sample(8) }
        \cup { [ZeroClipDeletionNotification EXCEPT !.execId = one] : one \in Sample(8) }
        \cup { [ZeroClipDeletionNotification EXCEPT !.securityId = one] : one \in Sample(8) }
        \cup { [ZeroClipDeletionNotification EXCEPT !.cxlQty = one] : one \in Sample(8) }
        \cup { [ZeroClipDeletionNotification EXCEPT !.marketSegmentId = one] : one \in Sample(4) }
        \cup { [ZeroClipDeletionNotification EXCEPT !.execRestatementReason = one] : one \in Sample(2) }
        \cup { [ZeroClipDeletionNotification EXCEPT !.productComplex = one] : one \in Sample(1) }
        \cup { [ZeroClipDeletionNotification EXCEPT !.side = one] : one \in Sample(1) }
        \cup { [ZeroClipDeletionNotification EXCEPT !.ordStatus = one] : one \in Sample(1) }
        \cup { [ZeroClipDeletionNotification EXCEPT !.execType = one] : one \in Sample(1) }
        \cup { [ZeroClipDeletionNotification EXCEPT !.pad6 = one] : one \in Sample(6) }

(***************************************************************************)
(* Rbc Header Me Comp: 56 bytes                                            *)
(***************************************************************************)

RbcHeaderMeComp2 ==
    [ trdRegTsTimeOut : Sample(8),
      notificationIn  : Sample(8),
      sendingTime     : Sample(8),
      applSubId       : Sample(4),
      partitionId     : Sample(2),
      applMsgId       : Sample(16),
      applId          : Sample(1),
      applResendFlag  : Sample(1),
      lastFragment    : Sample(1),
      pad7            : Sample(7) ]

EncodeRbcHeaderMeComp2(message) ==
    message.trdRegTsTimeOut
        \o message.notificationIn
        \o message.sendingTime
        \o message.applSubId
        \o message.partitionId
        \o message.applMsgId
        \o message.applId
        \o message.applResendFlag
        \o message.lastFragment
        \o message.pad7

DecodeRbcHeaderMeComp2(bytes) ==
    LET trdRegTsTimeOut == ReadBytes(bytes, 8) IN IF ~trdRegTsTimeOut.ok THEN Fail ELSE
    LET notificationIn == ReadBytes(trdRegTsTimeOut.rest, 8) IN IF ~notificationIn.ok THEN Fail ELSE
    LET sendingTime == ReadBytes(notificationIn.rest, 8) IN IF ~sendingTime.ok THEN Fail ELSE
    LET applSubId == ReadBytes(sendingTime.rest, 4) IN IF ~applSubId.ok THEN Fail ELSE
    LET partitionId == ReadBytes(applSubId.rest, 2) IN IF ~partitionId.ok THEN Fail ELSE
    LET applMsgId == ReadBytes(partitionId.rest, 16) IN IF ~applMsgId.ok THEN Fail ELSE
    LET applId == ReadBytes(applMsgId.rest, 1) IN IF ~applId.ok THEN Fail ELSE
    LET applResendFlag == ReadBytes(applId.rest, 1) IN IF ~applResendFlag.ok THEN Fail ELSE
    LET lastFragment == ReadBytes(applResendFlag.rest, 1) IN IF ~lastFragment.ok THEN Fail ELSE
    LET pad7 == ReadBytes(lastFragment.rest, 7) IN IF ~pad7.ok THEN Fail ELSE
    Ok([ trdRegTsTimeOut |-> trdRegTsTimeOut.value,
         notificationIn  |-> notificationIn.value,
         sendingTime     |-> sendingTime.value,
         applSubId       |-> applSubId.value,
         partitionId     |-> partitionId.value,
         applMsgId       |-> applMsgId.value,
         applId          |-> applId.value,
         applResendFlag  |-> applResendFlag.value,
         lastFragment    |-> lastFragment.value,
         pad7            |-> pad7.value ], pad7.rest)

ZeroRbcHeaderMeComp2 ==
    [ trdRegTsTimeOut |-> [i \in 1 .. 8 |-> 0],
      notificationIn  |-> [i \in 1 .. 8 |-> 0],
      sendingTime     |-> [i \in 1 .. 8 |-> 0],
      applSubId       |-> [i \in 1 .. 4 |-> 0],
      partitionId     |-> [i \in 1 .. 2 |-> 0],
      applMsgId       |-> [i \in 1 .. 16 |-> 0],
      applId          |-> [i \in 1 .. 1 |-> 0],
      applResendFlag  |-> [i \in 1 .. 1 |-> 0],
      lastFragment    |-> [i \in 1 .. 1 |-> 0],
      pad7            |-> [i \in 1 .. 7 |-> 0] ]

(* Rbc Header Me Comp at zero, then each field in turn at the values it is checked at *)
CheckedRbcHeaderMeComp2 ==
    { ZeroRbcHeaderMeComp2 }
        \cup { [ZeroRbcHeaderMeComp2 EXCEPT !.trdRegTsTimeOut = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderMeComp2 EXCEPT !.notificationIn = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderMeComp2 EXCEPT !.sendingTime = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderMeComp2 EXCEPT !.applSubId = one] : one \in Sample(4) }
        \cup { [ZeroRbcHeaderMeComp2 EXCEPT !.partitionId = one] : one \in Sample(2) }
        \cup { [ZeroRbcHeaderMeComp2 EXCEPT !.applMsgId = one] : one \in Sample(16) }
        \cup { [ZeroRbcHeaderMeComp2 EXCEPT !.applId = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderMeComp2 EXCEPT !.applResendFlag = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderMeComp2 EXCEPT !.lastFragment = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderMeComp2 EXCEPT !.pad7 = one] : one \in Sample(7) }

(***************************************************************************)
(* Fills Grp Comp: 32 bytes                                                *)
(***************************************************************************)

FillsGrpComp ==
    [ fillPx           : Sample(8),
      fillQty          : Sample(8),
      fillMatchId      : Sample(4),
      fillExecId       : Sample(4),
      fillLiquidityInd : Sample(1),
      pad7             : Sample(7) ]

EncodeFillsGrpComp(message) ==
    message.fillPx
        \o message.fillQty
        \o message.fillMatchId
        \o message.fillExecId
        \o message.fillLiquidityInd
        \o message.pad7

DecodeFillsGrpComp(bytes) ==
    LET fillPx == ReadBytes(bytes, 8) IN IF ~fillPx.ok THEN Fail ELSE
    LET fillQty == ReadBytes(fillPx.rest, 8) IN IF ~fillQty.ok THEN Fail ELSE
    LET fillMatchId == ReadBytes(fillQty.rest, 4) IN IF ~fillMatchId.ok THEN Fail ELSE
    LET fillExecId == ReadBytes(fillMatchId.rest, 4) IN IF ~fillExecId.ok THEN Fail ELSE
    LET fillLiquidityInd == ReadBytes(fillExecId.rest, 1) IN IF ~fillLiquidityInd.ok THEN Fail ELSE
    LET pad7 == ReadBytes(fillLiquidityInd.rest, 7) IN IF ~pad7.ok THEN Fail ELSE
    Ok([ fillPx           |-> fillPx.value,
         fillQty          |-> fillQty.value,
         fillMatchId      |-> fillMatchId.value,
         fillExecId       |-> fillExecId.value,
         fillLiquidityInd |-> fillLiquidityInd.value,
         pad7             |-> pad7.value ], pad7.rest)

ZeroFillsGrpComp ==
    [ fillPx           |-> [i \in 1 .. 8 |-> 0],
      fillQty          |-> [i \in 1 .. 8 |-> 0],
      fillMatchId      |-> [i \in 1 .. 4 |-> 0],
      fillExecId       |-> [i \in 1 .. 4 |-> 0],
      fillLiquidityInd |-> [i \in 1 .. 1 |-> 0],
      pad7             |-> [i \in 1 .. 7 |-> 0] ]

(* Fills Grp Comp at zero, then each field in turn at the values it is checked at *)
CheckedFillsGrpComp ==
    { ZeroFillsGrpComp }
        \cup { [ZeroFillsGrpComp EXCEPT !.fillPx = one] : one \in Sample(8) }
        \cup { [ZeroFillsGrpComp EXCEPT !.fillQty = one] : one \in Sample(8) }
        \cup { [ZeroFillsGrpComp EXCEPT !.fillMatchId = one] : one \in Sample(4) }
        \cup { [ZeroFillsGrpComp EXCEPT !.fillExecId = one] : one \in Sample(4) }
        \cup { [ZeroFillsGrpComp EXCEPT !.fillLiquidityInd = one] : one \in Sample(1) }
        \cup { [ZeroFillsGrpComp EXCEPT !.pad7 = one] : one \in Sample(7) }

(* A run of Fills Grp Comp, written one after another *)
RECURSIVE EncodeFillsGrpCompList(_)
EncodeFillsGrpCompList(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeFillsGrpComp(Head(messages)) \o EncodeFillsGrpCompList(Tail(messages))

(* As many Fills Grp Comp as the field that counts them says *)
RECURSIVE ReadFillsGrpCompList(_, _)
ReadFillsGrpCompList(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeFillsGrpComp(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadFillsGrpCompList(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Fills Grp Comp of each kind, for the lists that carry them *)
OneFillsGrpComp == { ZeroFillsGrpComp }

(***************************************************************************)
(* Instrmnt Leg Exec Grp Comp: 32 bytes                                    *)
(***************************************************************************)

InstrmntLegExecGrpComp ==
    [ legSecurityId : Sample(8),
      legLastPx     : Sample(8),
      legLastQty    : Sample(8),
      legExecId     : Sample(4),
      legSide       : Sample(1),
      fillRefId     : Sample(1),
      pad2          : Sample(2) ]

EncodeInstrmntLegExecGrpComp(message) ==
    message.legSecurityId
        \o message.legLastPx
        \o message.legLastQty
        \o message.legExecId
        \o message.legSide
        \o message.fillRefId
        \o message.pad2

DecodeInstrmntLegExecGrpComp(bytes) ==
    LET legSecurityId == ReadBytes(bytes, 8) IN IF ~legSecurityId.ok THEN Fail ELSE
    LET legLastPx == ReadBytes(legSecurityId.rest, 8) IN IF ~legLastPx.ok THEN Fail ELSE
    LET legLastQty == ReadBytes(legLastPx.rest, 8) IN IF ~legLastQty.ok THEN Fail ELSE
    LET legExecId == ReadBytes(legLastQty.rest, 4) IN IF ~legExecId.ok THEN Fail ELSE
    LET legSide == ReadBytes(legExecId.rest, 1) IN IF ~legSide.ok THEN Fail ELSE
    LET fillRefId == ReadBytes(legSide.rest, 1) IN IF ~fillRefId.ok THEN Fail ELSE
    LET pad2 == ReadBytes(fillRefId.rest, 2) IN IF ~pad2.ok THEN Fail ELSE
    Ok([ legSecurityId |-> legSecurityId.value,
         legLastPx     |-> legLastPx.value,
         legLastQty    |-> legLastQty.value,
         legExecId     |-> legExecId.value,
         legSide       |-> legSide.value,
         fillRefId     |-> fillRefId.value,
         pad2          |-> pad2.value ], pad2.rest)

ZeroInstrmntLegExecGrpComp ==
    [ legSecurityId |-> [i \in 1 .. 8 |-> 0],
      legLastPx     |-> [i \in 1 .. 8 |-> 0],
      legLastQty    |-> [i \in 1 .. 8 |-> 0],
      legExecId     |-> [i \in 1 .. 4 |-> 0],
      legSide       |-> [i \in 1 .. 1 |-> 0],
      fillRefId     |-> [i \in 1 .. 1 |-> 0],
      pad2          |-> [i \in 1 .. 2 |-> 0] ]

(* Instrmnt Leg Exec Grp Comp at zero, then each field in turn at the values it is checked at *)
CheckedInstrmntLegExecGrpComp ==
    { ZeroInstrmntLegExecGrpComp }
        \cup { [ZeroInstrmntLegExecGrpComp EXCEPT !.legSecurityId = one] : one \in Sample(8) }
        \cup { [ZeroInstrmntLegExecGrpComp EXCEPT !.legLastPx = one] : one \in Sample(8) }
        \cup { [ZeroInstrmntLegExecGrpComp EXCEPT !.legLastQty = one] : one \in Sample(8) }
        \cup { [ZeroInstrmntLegExecGrpComp EXCEPT !.legExecId = one] : one \in Sample(4) }
        \cup { [ZeroInstrmntLegExecGrpComp EXCEPT !.legSide = one] : one \in Sample(1) }
        \cup { [ZeroInstrmntLegExecGrpComp EXCEPT !.fillRefId = one] : one \in Sample(1) }
        \cup { [ZeroInstrmntLegExecGrpComp EXCEPT !.pad2 = one] : one \in Sample(2) }

(* A run of Instrmnt Leg Exec Grp Comp, written one after another *)
RECURSIVE EncodeInstrmntLegExecGrpCompList(_)
EncodeInstrmntLegExecGrpCompList(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeInstrmntLegExecGrpComp(Head(messages)) \o EncodeInstrmntLegExecGrpCompList(Tail(messages))

(* As many Instrmnt Leg Exec Grp Comp as the field that counts them says *)
RECURSIVE ReadInstrmntLegExecGrpCompList(_, _)
ReadInstrmntLegExecGrpCompList(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeInstrmntLegExecGrpComp(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadInstrmntLegExecGrpCompList(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Instrmnt Leg Exec Grp Comp of each kind, for the lists that carry them *)
OneInstrmntLegExecGrpComp == { ZeroInstrmntLegExecGrpComp }

(***************************************************************************)
(* Clip Execution Notification                                             *)
(***************************************************************************)

ClipExecutionNotification ==
    [ pad2                   : Sample(2),
      rbcHeaderMeComp        : RbcHeaderMeComp2,
      orderId                : Sample(8),
      execId                 : Sample(8),
      securityId             : Sample(8),
      cxlQty                 : Sample(8),
      leavesQty              : Sample(8),
      cumQty                 : Sample(8),
      marketSegmentId        : Sample(4),
      execRestatementReason  : Sample(2),
      productComplex         : Sample(1),
      side                   : Sample(1),
      ordStatus              : Sample(1),
      execType               : Sample(1),
      matchType              : Sample(1),
      pad2v2                 : Sample(2),
      fillsGrpComp           : SampleLists(OneFillsGrpComp),
      instrmntLegExecGrpComp : SampleLists(OneInstrmntLegExecGrpComp) ]

EncodeClipExecutionNotification(message) ==
    message.pad2
        \o EncodeRbcHeaderMeComp2(message.rbcHeaderMeComp)
        \o message.orderId
        \o message.execId
        \o message.securityId
        \o message.cxlQty
        \o message.leavesQty
        \o message.cumQty
        \o message.marketSegmentId
        \o message.execRestatementReason
        \o EncodeUIntLE(Len(message.instrmntLegExecGrpComp), 2)
        \o message.productComplex
        \o message.side
        \o message.ordStatus
        \o message.execType
        \o message.matchType
        \o EncodeUIntBE(Len(message.fillsGrpComp), 1)
        \o message.pad2v2
        \o EncodeFillsGrpCompList(message.fillsGrpComp)
        \o EncodeInstrmntLegExecGrpCompList(message.instrmntLegExecGrpComp)

DecodeClipExecutionNotification(bytes) ==
    LET pad2 == ReadBytes(bytes, 2) IN IF ~pad2.ok THEN Fail ELSE
    LET rbcHeaderMeComp == DecodeRbcHeaderMeComp2(pad2.rest) IN IF ~rbcHeaderMeComp.ok THEN Fail ELSE
    LET orderId == ReadBytes(rbcHeaderMeComp.rest, 8) IN IF ~orderId.ok THEN Fail ELSE
    LET execId == ReadBytes(orderId.rest, 8) IN IF ~execId.ok THEN Fail ELSE
    LET securityId == ReadBytes(execId.rest, 8) IN IF ~securityId.ok THEN Fail ELSE
    LET cxlQty == ReadBytes(securityId.rest, 8) IN IF ~cxlQty.ok THEN Fail ELSE
    LET leavesQty == ReadBytes(cxlQty.rest, 8) IN IF ~leavesQty.ok THEN Fail ELSE
    LET cumQty == ReadBytes(leavesQty.rest, 8) IN IF ~cumQty.ok THEN Fail ELSE
    LET marketSegmentId == ReadBytes(cumQty.rest, 4) IN IF ~marketSegmentId.ok THEN Fail ELSE
    LET execRestatementReason == ReadBytes(marketSegmentId.rest, 2) IN IF ~execRestatementReason.ok THEN Fail ELSE
    LET noLegExecs == ReadUIntLE(execRestatementReason.rest, 2) IN IF ~noLegExecs.ok THEN Fail ELSE
    LET productComplex == ReadBytes(noLegExecs.rest, 1) IN IF ~productComplex.ok THEN Fail ELSE
    LET side == ReadBytes(productComplex.rest, 1) IN IF ~side.ok THEN Fail ELSE
    LET ordStatus == ReadBytes(side.rest, 1) IN IF ~ordStatus.ok THEN Fail ELSE
    LET execType == ReadBytes(ordStatus.rest, 1) IN IF ~execType.ok THEN Fail ELSE
    LET matchType == ReadBytes(execType.rest, 1) IN IF ~matchType.ok THEN Fail ELSE
    LET noFills == ReadUIntBE(matchType.rest, 1) IN IF ~noFills.ok THEN Fail ELSE
    LET pad2v2 == ReadBytes(noFills.rest, 2) IN IF ~pad2v2.ok THEN Fail ELSE
    LET fillsGrpComp == ReadFillsGrpCompList(pad2v2.rest, noFills.value) IN IF ~fillsGrpComp.ok THEN Fail ELSE
    LET instrmntLegExecGrpComp == ReadInstrmntLegExecGrpCompList(fillsGrpComp.rest, noLegExecs.value) IN IF ~instrmntLegExecGrpComp.ok THEN Fail ELSE
    Ok([ pad2                   |-> pad2.value,
         rbcHeaderMeComp        |-> rbcHeaderMeComp.value,
         orderId                |-> orderId.value,
         execId                 |-> execId.value,
         securityId             |-> securityId.value,
         cxlQty                 |-> cxlQty.value,
         leavesQty              |-> leavesQty.value,
         cumQty                 |-> cumQty.value,
         marketSegmentId        |-> marketSegmentId.value,
         execRestatementReason  |-> execRestatementReason.value,
         productComplex         |-> productComplex.value,
         side                   |-> side.value,
         ordStatus              |-> ordStatus.value,
         execType               |-> execType.value,
         matchType              |-> matchType.value,
         pad2v2                 |-> pad2v2.value,
         fillsGrpComp           |-> fillsGrpComp.value,
         instrmntLegExecGrpComp |-> instrmntLegExecGrpComp.value ], instrmntLegExecGrpComp.rest)

ZeroClipExecutionNotification ==
    [ pad2                   |-> [i \in 1 .. 2 |-> 0],
      rbcHeaderMeComp        |-> ZeroRbcHeaderMeComp2,
      orderId                |-> [i \in 1 .. 8 |-> 0],
      execId                 |-> [i \in 1 .. 8 |-> 0],
      securityId             |-> [i \in 1 .. 8 |-> 0],
      cxlQty                 |-> [i \in 1 .. 8 |-> 0],
      leavesQty              |-> [i \in 1 .. 8 |-> 0],
      cumQty                 |-> [i \in 1 .. 8 |-> 0],
      marketSegmentId        |-> [i \in 1 .. 4 |-> 0],
      execRestatementReason  |-> [i \in 1 .. 2 |-> 0],
      productComplex         |-> [i \in 1 .. 1 |-> 0],
      side                   |-> [i \in 1 .. 1 |-> 0],
      ordStatus              |-> [i \in 1 .. 1 |-> 0],
      execType               |-> [i \in 1 .. 1 |-> 0],
      matchType              |-> [i \in 1 .. 1 |-> 0],
      pad2v2                 |-> [i \in 1 .. 2 |-> 0],
      fillsGrpComp           |-> << >>,
      instrmntLegExecGrpComp |-> << >> ]

(* Clip Execution Notification at zero, then each field in turn at the values it is checked at *)
CheckedClipExecutionNotification ==
    { ZeroClipExecutionNotification }
        \cup { [ZeroClipExecutionNotification EXCEPT !.pad2 = one] : one \in Sample(2) }
        \cup { [ZeroClipExecutionNotification EXCEPT !.rbcHeaderMeComp = one] : one \in CheckedRbcHeaderMeComp2 }
        \cup { [ZeroClipExecutionNotification EXCEPT !.orderId = one] : one \in Sample(8) }
        \cup { [ZeroClipExecutionNotification EXCEPT !.execId = one] : one \in Sample(8) }
        \cup { [ZeroClipExecutionNotification EXCEPT !.securityId = one] : one \in Sample(8) }
        \cup { [ZeroClipExecutionNotification EXCEPT !.cxlQty = one] : one \in Sample(8) }
        \cup { [ZeroClipExecutionNotification EXCEPT !.leavesQty = one] : one \in Sample(8) }
        \cup { [ZeroClipExecutionNotification EXCEPT !.cumQty = one] : one \in Sample(8) }
        \cup { [ZeroClipExecutionNotification EXCEPT !.marketSegmentId = one] : one \in Sample(4) }
        \cup { [ZeroClipExecutionNotification EXCEPT !.execRestatementReason = one] : one \in Sample(2) }
        \cup { [ZeroClipExecutionNotification EXCEPT !.productComplex = one] : one \in Sample(1) }
        \cup { [ZeroClipExecutionNotification EXCEPT !.side = one] : one \in Sample(1) }
        \cup { [ZeroClipExecutionNotification EXCEPT !.ordStatus = one] : one \in Sample(1) }
        \cup { [ZeroClipExecutionNotification EXCEPT !.execType = one] : one \in Sample(1) }
        \cup { [ZeroClipExecutionNotification EXCEPT !.matchType = one] : one \in Sample(1) }
        \cup { [ZeroClipExecutionNotification EXCEPT !.pad2v2 = one] : one \in Sample(2) }
        \cup { [ZeroClipExecutionNotification EXCEPT !.fillsGrpComp = one] : one \in SampleLists(OneFillsGrpComp) }
        \cup { [ZeroClipExecutionNotification EXCEPT !.instrmntLegExecGrpComp = one] : one \in SampleLists(OneInstrmntLegExecGrpComp) }

(***************************************************************************)
(* Nr Response Header Me Comp: 48 bytes                                    *)
(***************************************************************************)

NrResponseHeaderMeComp3 ==
    [ requestTime     : Sample(8),
      trdRegTsTimeIn  : Sample(8),
      trdRegTsTimeOut : Sample(8),
      responseIn      : Sample(8),
      sendingTime     : Sample(8),
      msgSeqNum       : Sample(4),
      lastFragment    : Sample(1),
      pad3            : Sample(3) ]

EncodeNrResponseHeaderMeComp3(message) ==
    message.requestTime
        \o message.trdRegTsTimeIn
        \o message.trdRegTsTimeOut
        \o message.responseIn
        \o message.sendingTime
        \o message.msgSeqNum
        \o message.lastFragment
        \o message.pad3

DecodeNrResponseHeaderMeComp3(bytes) ==
    LET requestTime == ReadBytes(bytes, 8) IN IF ~requestTime.ok THEN Fail ELSE
    LET trdRegTsTimeIn == ReadBytes(requestTime.rest, 8) IN IF ~trdRegTsTimeIn.ok THEN Fail ELSE
    LET trdRegTsTimeOut == ReadBytes(trdRegTsTimeIn.rest, 8) IN IF ~trdRegTsTimeOut.ok THEN Fail ELSE
    LET responseIn == ReadBytes(trdRegTsTimeOut.rest, 8) IN IF ~responseIn.ok THEN Fail ELSE
    LET sendingTime == ReadBytes(responseIn.rest, 8) IN IF ~sendingTime.ok THEN Fail ELSE
    LET msgSeqNum == ReadBytes(sendingTime.rest, 4) IN IF ~msgSeqNum.ok THEN Fail ELSE
    LET lastFragment == ReadBytes(msgSeqNum.rest, 1) IN IF ~lastFragment.ok THEN Fail ELSE
    LET pad3 == ReadBytes(lastFragment.rest, 3) IN IF ~pad3.ok THEN Fail ELSE
    Ok([ requestTime     |-> requestTime.value,
         trdRegTsTimeIn  |-> trdRegTsTimeIn.value,
         trdRegTsTimeOut |-> trdRegTsTimeOut.value,
         responseIn      |-> responseIn.value,
         sendingTime     |-> sendingTime.value,
         msgSeqNum       |-> msgSeqNum.value,
         lastFragment    |-> lastFragment.value,
         pad3            |-> pad3.value ], pad3.rest)

ZeroNrResponseHeaderMeComp3 ==
    [ requestTime     |-> [i \in 1 .. 8 |-> 0],
      trdRegTsTimeIn  |-> [i \in 1 .. 8 |-> 0],
      trdRegTsTimeOut |-> [i \in 1 .. 8 |-> 0],
      responseIn      |-> [i \in 1 .. 8 |-> 0],
      sendingTime     |-> [i \in 1 .. 8 |-> 0],
      msgSeqNum       |-> [i \in 1 .. 4 |-> 0],
      lastFragment    |-> [i \in 1 .. 1 |-> 0],
      pad3            |-> [i \in 1 .. 3 |-> 0] ]

(* Nr Response Header Me Comp at zero, then each field in turn at the values it is checked at *)
CheckedNrResponseHeaderMeComp3 ==
    { ZeroNrResponseHeaderMeComp3 }
        \cup { [ZeroNrResponseHeaderMeComp3 EXCEPT !.requestTime = one] : one \in Sample(8) }
        \cup { [ZeroNrResponseHeaderMeComp3 EXCEPT !.trdRegTsTimeIn = one] : one \in Sample(8) }
        \cup { [ZeroNrResponseHeaderMeComp3 EXCEPT !.trdRegTsTimeOut = one] : one \in Sample(8) }
        \cup { [ZeroNrResponseHeaderMeComp3 EXCEPT !.responseIn = one] : one \in Sample(8) }
        \cup { [ZeroNrResponseHeaderMeComp3 EXCEPT !.sendingTime = one] : one \in Sample(8) }
        \cup { [ZeroNrResponseHeaderMeComp3 EXCEPT !.msgSeqNum = one] : one \in Sample(4) }
        \cup { [ZeroNrResponseHeaderMeComp3 EXCEPT !.lastFragment = one] : one \in Sample(1) }
        \cup { [ZeroNrResponseHeaderMeComp3 EXCEPT !.pad3 = one] : one \in Sample(3) }

(***************************************************************************)
(* Cross Request Ack Side Grp Comp: 16 bytes                               *)
(***************************************************************************)

CrossRequestAckSideGrpComp ==
    [ orderId     : Sample(8),
      inputSource : Sample(1),
      side        : Sample(1),
      pad6        : Sample(6) ]

EncodeCrossRequestAckSideGrpComp(message) ==
    message.orderId
        \o message.inputSource
        \o message.side
        \o message.pad6

DecodeCrossRequestAckSideGrpComp(bytes) ==
    LET orderId == ReadBytes(bytes, 8) IN IF ~orderId.ok THEN Fail ELSE
    LET inputSource == ReadBytes(orderId.rest, 1) IN IF ~inputSource.ok THEN Fail ELSE
    LET side == ReadBytes(inputSource.rest, 1) IN IF ~side.ok THEN Fail ELSE
    LET pad6 == ReadBytes(side.rest, 6) IN IF ~pad6.ok THEN Fail ELSE
    Ok([ orderId     |-> orderId.value,
         inputSource |-> inputSource.value,
         side        |-> side.value,
         pad6        |-> pad6.value ], pad6.rest)

ZeroCrossRequestAckSideGrpComp ==
    [ orderId     |-> [i \in 1 .. 8 |-> 0],
      inputSource |-> [i \in 1 .. 1 |-> 0],
      side        |-> [i \in 1 .. 1 |-> 0],
      pad6        |-> [i \in 1 .. 6 |-> 0] ]

(* Cross Request Ack Side Grp Comp at zero, then each field in turn at the values it is checked at *)
CheckedCrossRequestAckSideGrpComp ==
    { ZeroCrossRequestAckSideGrpComp }
        \cup { [ZeroCrossRequestAckSideGrpComp EXCEPT !.orderId = one] : one \in Sample(8) }
        \cup { [ZeroCrossRequestAckSideGrpComp EXCEPT !.inputSource = one] : one \in Sample(1) }
        \cup { [ZeroCrossRequestAckSideGrpComp EXCEPT !.side = one] : one \in Sample(1) }
        \cup { [ZeroCrossRequestAckSideGrpComp EXCEPT !.pad6 = one] : one \in Sample(6) }

(* A run of Cross Request Ack Side Grp Comp, written one after another *)
RECURSIVE EncodeCrossRequestAckSideGrpCompList(_)
EncodeCrossRequestAckSideGrpCompList(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeCrossRequestAckSideGrpComp(Head(messages)) \o EncodeCrossRequestAckSideGrpCompList(Tail(messages))

(* As many Cross Request Ack Side Grp Comp as the field that counts them says *)
RECURSIVE ReadCrossRequestAckSideGrpCompList(_, _)
ReadCrossRequestAckSideGrpCompList(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeCrossRequestAckSideGrpComp(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadCrossRequestAckSideGrpCompList(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Cross Request Ack Side Grp Comp of each kind, for the lists that carry them *)
OneCrossRequestAckSideGrpComp == { ZeroCrossRequestAckSideGrpComp }

(***************************************************************************)
(* Clip Response                                                           *)
(***************************************************************************)

ClipResponse ==
    [ pad2                       : Sample(2),
      nrResponseHeaderMeComp     : NrResponseHeaderMeComp3,
      execId                     : Sample(8),
      securityId                 : Sample(8),
      marketSegmentId            : Sample(4),
      crossRequestId             : Sample(4),
      pad7                       : Sample(7),
      crossRequestAckSideGrpComp : SampleLists(OneCrossRequestAckSideGrpComp) ]

EncodeClipResponse(message) ==
    message.pad2
        \o EncodeNrResponseHeaderMeComp3(message.nrResponseHeaderMeComp)
        \o message.execId
        \o message.securityId
        \o message.marketSegmentId
        \o message.crossRequestId
        \o EncodeUIntBE(Len(message.crossRequestAckSideGrpComp), 1)
        \o message.pad7
        \o EncodeCrossRequestAckSideGrpCompList(message.crossRequestAckSideGrpComp)

DecodeClipResponse(bytes) ==
    LET pad2 == ReadBytes(bytes, 2) IN IF ~pad2.ok THEN Fail ELSE
    LET nrResponseHeaderMeComp == DecodeNrResponseHeaderMeComp3(pad2.rest) IN IF ~nrResponseHeaderMeComp.ok THEN Fail ELSE
    LET execId == ReadBytes(nrResponseHeaderMeComp.rest, 8) IN IF ~execId.ok THEN Fail ELSE
    LET securityId == ReadBytes(execId.rest, 8) IN IF ~securityId.ok THEN Fail ELSE
    LET marketSegmentId == ReadBytes(securityId.rest, 4) IN IF ~marketSegmentId.ok THEN Fail ELSE
    LET crossRequestId == ReadBytes(marketSegmentId.rest, 4) IN IF ~crossRequestId.ok THEN Fail ELSE
    LET noSides == ReadUIntBE(crossRequestId.rest, 1) IN IF ~noSides.ok THEN Fail ELSE
    LET pad7 == ReadBytes(noSides.rest, 7) IN IF ~pad7.ok THEN Fail ELSE
    LET crossRequestAckSideGrpComp == ReadCrossRequestAckSideGrpCompList(pad7.rest, noSides.value) IN IF ~crossRequestAckSideGrpComp.ok THEN Fail ELSE
    Ok([ pad2                       |-> pad2.value,
         nrResponseHeaderMeComp     |-> nrResponseHeaderMeComp.value,
         execId                     |-> execId.value,
         securityId                 |-> securityId.value,
         marketSegmentId            |-> marketSegmentId.value,
         crossRequestId             |-> crossRequestId.value,
         pad7                       |-> pad7.value,
         crossRequestAckSideGrpComp |-> crossRequestAckSideGrpComp.value ], crossRequestAckSideGrpComp.rest)

ZeroClipResponse ==
    [ pad2                       |-> [i \in 1 .. 2 |-> 0],
      nrResponseHeaderMeComp     |-> ZeroNrResponseHeaderMeComp3,
      execId                     |-> [i \in 1 .. 8 |-> 0],
      securityId                 |-> [i \in 1 .. 8 |-> 0],
      marketSegmentId            |-> [i \in 1 .. 4 |-> 0],
      crossRequestId             |-> [i \in 1 .. 4 |-> 0],
      pad7                       |-> [i \in 1 .. 7 |-> 0],
      crossRequestAckSideGrpComp |-> << >> ]

(* Clip Response at zero, then each field in turn at the values it is checked at *)
CheckedClipResponse ==
    { ZeroClipResponse }
        \cup { [ZeroClipResponse EXCEPT !.pad2 = one] : one \in Sample(2) }
        \cup { [ZeroClipResponse EXCEPT !.nrResponseHeaderMeComp = one] : one \in CheckedNrResponseHeaderMeComp3 }
        \cup { [ZeroClipResponse EXCEPT !.execId = one] : one \in Sample(8) }
        \cup { [ZeroClipResponse EXCEPT !.securityId = one] : one \in Sample(8) }
        \cup { [ZeroClipResponse EXCEPT !.marketSegmentId = one] : one \in Sample(4) }
        \cup { [ZeroClipResponse EXCEPT !.crossRequestId = one] : one \in Sample(4) }
        \cup { [ZeroClipResponse EXCEPT !.pad7 = one] : one \in Sample(7) }
        \cup { [ZeroClipResponse EXCEPT !.crossRequestAckSideGrpComp = one] : one \in SampleLists(OneCrossRequestAckSideGrpComp) }

(***************************************************************************)
(* Nr Response Header Me Comp: 48 bytes                                    *)
(***************************************************************************)

NrResponseHeaderMeComp4 ==
    [ requestTime     : Sample(8),
      trdRegTsTimeIn  : Sample(8),
      trdRegTsTimeOut : Sample(8),
      responseIn      : Sample(8),
      sendingTime     : Sample(8),
      msgSeqNum       : Sample(4),
      lastFragment    : Sample(1),
      pad3            : Sample(3) ]

EncodeNrResponseHeaderMeComp4(message) ==
    message.requestTime
        \o message.trdRegTsTimeIn
        \o message.trdRegTsTimeOut
        \o message.responseIn
        \o message.sendingTime
        \o message.msgSeqNum
        \o message.lastFragment
        \o message.pad3

DecodeNrResponseHeaderMeComp4(bytes) ==
    LET requestTime == ReadBytes(bytes, 8) IN IF ~requestTime.ok THEN Fail ELSE
    LET trdRegTsTimeIn == ReadBytes(requestTime.rest, 8) IN IF ~trdRegTsTimeIn.ok THEN Fail ELSE
    LET trdRegTsTimeOut == ReadBytes(trdRegTsTimeIn.rest, 8) IN IF ~trdRegTsTimeOut.ok THEN Fail ELSE
    LET responseIn == ReadBytes(trdRegTsTimeOut.rest, 8) IN IF ~responseIn.ok THEN Fail ELSE
    LET sendingTime == ReadBytes(responseIn.rest, 8) IN IF ~sendingTime.ok THEN Fail ELSE
    LET msgSeqNum == ReadBytes(sendingTime.rest, 4) IN IF ~msgSeqNum.ok THEN Fail ELSE
    LET lastFragment == ReadBytes(msgSeqNum.rest, 1) IN IF ~lastFragment.ok THEN Fail ELSE
    LET pad3 == ReadBytes(lastFragment.rest, 3) IN IF ~pad3.ok THEN Fail ELSE
    Ok([ requestTime     |-> requestTime.value,
         trdRegTsTimeIn  |-> trdRegTsTimeIn.value,
         trdRegTsTimeOut |-> trdRegTsTimeOut.value,
         responseIn      |-> responseIn.value,
         sendingTime     |-> sendingTime.value,
         msgSeqNum       |-> msgSeqNum.value,
         lastFragment    |-> lastFragment.value,
         pad3            |-> pad3.value ], pad3.rest)

ZeroNrResponseHeaderMeComp4 ==
    [ requestTime     |-> [i \in 1 .. 8 |-> 0],
      trdRegTsTimeIn  |-> [i \in 1 .. 8 |-> 0],
      trdRegTsTimeOut |-> [i \in 1 .. 8 |-> 0],
      responseIn      |-> [i \in 1 .. 8 |-> 0],
      sendingTime     |-> [i \in 1 .. 8 |-> 0],
      msgSeqNum       |-> [i \in 1 .. 4 |-> 0],
      lastFragment    |-> [i \in 1 .. 1 |-> 0],
      pad3            |-> [i \in 1 .. 3 |-> 0] ]

(* Nr Response Header Me Comp at zero, then each field in turn at the values it is checked at *)
CheckedNrResponseHeaderMeComp4 ==
    { ZeroNrResponseHeaderMeComp4 }
        \cup { [ZeroNrResponseHeaderMeComp4 EXCEPT !.requestTime = one] : one \in Sample(8) }
        \cup { [ZeroNrResponseHeaderMeComp4 EXCEPT !.trdRegTsTimeIn = one] : one \in Sample(8) }
        \cup { [ZeroNrResponseHeaderMeComp4 EXCEPT !.trdRegTsTimeOut = one] : one \in Sample(8) }
        \cup { [ZeroNrResponseHeaderMeComp4 EXCEPT !.responseIn = one] : one \in Sample(8) }
        \cup { [ZeroNrResponseHeaderMeComp4 EXCEPT !.sendingTime = one] : one \in Sample(8) }
        \cup { [ZeroNrResponseHeaderMeComp4 EXCEPT !.msgSeqNum = one] : one \in Sample(4) }
        \cup { [ZeroNrResponseHeaderMeComp4 EXCEPT !.lastFragment = one] : one \in Sample(1) }
        \cup { [ZeroNrResponseHeaderMeComp4 EXCEPT !.pad3 = one] : one \in Sample(3) }

(***************************************************************************)
(* Cross Request Response: 58 bytes                                        *)
(***************************************************************************)

CrossRequestResponse ==
    [ pad2                   : Sample(2),
      nrResponseHeaderMeComp : NrResponseHeaderMeComp4,
      execId                 : Sample(8) ]

EncodeCrossRequestResponse(message) ==
    message.pad2
        \o EncodeNrResponseHeaderMeComp4(message.nrResponseHeaderMeComp)
        \o message.execId

DecodeCrossRequestResponse(bytes) ==
    LET pad2 == ReadBytes(bytes, 2) IN IF ~pad2.ok THEN Fail ELSE
    LET nrResponseHeaderMeComp == DecodeNrResponseHeaderMeComp4(pad2.rest) IN IF ~nrResponseHeaderMeComp.ok THEN Fail ELSE
    LET execId == ReadBytes(nrResponseHeaderMeComp.rest, 8) IN IF ~execId.ok THEN Fail ELSE
    Ok([ pad2                   |-> pad2.value,
         nrResponseHeaderMeComp |-> nrResponseHeaderMeComp.value,
         execId                 |-> execId.value ], execId.rest)

ZeroCrossRequestResponse ==
    [ pad2                   |-> [i \in 1 .. 2 |-> 0],
      nrResponseHeaderMeComp |-> ZeroNrResponseHeaderMeComp4,
      execId                 |-> [i \in 1 .. 8 |-> 0] ]

(* Cross Request Response at zero, then each field in turn at the values it is checked at *)
CheckedCrossRequestResponse ==
    { ZeroCrossRequestResponse }
        \cup { [ZeroCrossRequestResponse EXCEPT !.pad2 = one] : one \in Sample(2) }
        \cup { [ZeroCrossRequestResponse EXCEPT !.nrResponseHeaderMeComp = one] : one \in CheckedNrResponseHeaderMeComp4 }
        \cup { [ZeroCrossRequestResponse EXCEPT !.execId = one] : one \in Sample(8) }

(***************************************************************************)
(* Rbc Header Me Comp: 56 bytes                                            *)
(***************************************************************************)

RbcHeaderMeComp3 ==
    [ trdRegTsTimeOut : Sample(8),
      notificationIn  : Sample(8),
      sendingTime     : Sample(8),
      applSubId       : Sample(4),
      partitionId     : Sample(2),
      applMsgId       : Sample(16),
      applId          : Sample(1),
      applResendFlag  : Sample(1),
      lastFragment    : Sample(1),
      pad7            : Sample(7) ]

EncodeRbcHeaderMeComp3(message) ==
    message.trdRegTsTimeOut
        \o message.notificationIn
        \o message.sendingTime
        \o message.applSubId
        \o message.partitionId
        \o message.applMsgId
        \o message.applId
        \o message.applResendFlag
        \o message.lastFragment
        \o message.pad7

DecodeRbcHeaderMeComp3(bytes) ==
    LET trdRegTsTimeOut == ReadBytes(bytes, 8) IN IF ~trdRegTsTimeOut.ok THEN Fail ELSE
    LET notificationIn == ReadBytes(trdRegTsTimeOut.rest, 8) IN IF ~notificationIn.ok THEN Fail ELSE
    LET sendingTime == ReadBytes(notificationIn.rest, 8) IN IF ~sendingTime.ok THEN Fail ELSE
    LET applSubId == ReadBytes(sendingTime.rest, 4) IN IF ~applSubId.ok THEN Fail ELSE
    LET partitionId == ReadBytes(applSubId.rest, 2) IN IF ~partitionId.ok THEN Fail ELSE
    LET applMsgId == ReadBytes(partitionId.rest, 16) IN IF ~applMsgId.ok THEN Fail ELSE
    LET applId == ReadBytes(applMsgId.rest, 1) IN IF ~applId.ok THEN Fail ELSE
    LET applResendFlag == ReadBytes(applId.rest, 1) IN IF ~applResendFlag.ok THEN Fail ELSE
    LET lastFragment == ReadBytes(applResendFlag.rest, 1) IN IF ~lastFragment.ok THEN Fail ELSE
    LET pad7 == ReadBytes(lastFragment.rest, 7) IN IF ~pad7.ok THEN Fail ELSE
    Ok([ trdRegTsTimeOut |-> trdRegTsTimeOut.value,
         notificationIn  |-> notificationIn.value,
         sendingTime     |-> sendingTime.value,
         applSubId       |-> applSubId.value,
         partitionId     |-> partitionId.value,
         applMsgId       |-> applMsgId.value,
         applId          |-> applId.value,
         applResendFlag  |-> applResendFlag.value,
         lastFragment    |-> lastFragment.value,
         pad7            |-> pad7.value ], pad7.rest)

ZeroRbcHeaderMeComp3 ==
    [ trdRegTsTimeOut |-> [i \in 1 .. 8 |-> 0],
      notificationIn  |-> [i \in 1 .. 8 |-> 0],
      sendingTime     |-> [i \in 1 .. 8 |-> 0],
      applSubId       |-> [i \in 1 .. 4 |-> 0],
      partitionId     |-> [i \in 1 .. 2 |-> 0],
      applMsgId       |-> [i \in 1 .. 16 |-> 0],
      applId          |-> [i \in 1 .. 1 |-> 0],
      applResendFlag  |-> [i \in 1 .. 1 |-> 0],
      lastFragment    |-> [i \in 1 .. 1 |-> 0],
      pad7            |-> [i \in 1 .. 7 |-> 0] ]

(* Rbc Header Me Comp at zero, then each field in turn at the values it is checked at *)
CheckedRbcHeaderMeComp3 ==
    { ZeroRbcHeaderMeComp3 }
        \cup { [ZeroRbcHeaderMeComp3 EXCEPT !.trdRegTsTimeOut = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderMeComp3 EXCEPT !.notificationIn = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderMeComp3 EXCEPT !.sendingTime = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderMeComp3 EXCEPT !.applSubId = one] : one \in Sample(4) }
        \cup { [ZeroRbcHeaderMeComp3 EXCEPT !.partitionId = one] : one \in Sample(2) }
        \cup { [ZeroRbcHeaderMeComp3 EXCEPT !.applMsgId = one] : one \in Sample(16) }
        \cup { [ZeroRbcHeaderMeComp3 EXCEPT !.applId = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderMeComp3 EXCEPT !.applResendFlag = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderMeComp3 EXCEPT !.lastFragment = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderMeComp3 EXCEPT !.pad7 = one] : one \in Sample(7) }

(***************************************************************************)
(* Not Affected Orders Grp Comp: 16 bytes                                  *)
(***************************************************************************)

NotAffectedOrdersGrpComp ==
    [ notAffectedOrderId : Sample(8),
      notAffOrigClOrdId  : Sample(8) ]

EncodeNotAffectedOrdersGrpComp(message) ==
    message.notAffectedOrderId
        \o message.notAffOrigClOrdId

DecodeNotAffectedOrdersGrpComp(bytes) ==
    LET notAffectedOrderId == ReadBytes(bytes, 8) IN IF ~notAffectedOrderId.ok THEN Fail ELSE
    LET notAffOrigClOrdId == ReadBytes(notAffectedOrderId.rest, 8) IN IF ~notAffOrigClOrdId.ok THEN Fail ELSE
    Ok([ notAffectedOrderId |-> notAffectedOrderId.value,
         notAffOrigClOrdId  |-> notAffOrigClOrdId.value ], notAffOrigClOrdId.rest)

ZeroNotAffectedOrdersGrpComp ==
    [ notAffectedOrderId |-> [i \in 1 .. 8 |-> 0],
      notAffOrigClOrdId  |-> [i \in 1 .. 8 |-> 0] ]

(* Not Affected Orders Grp Comp at zero, then each field in turn at the values it is checked at *)
CheckedNotAffectedOrdersGrpComp ==
    { ZeroNotAffectedOrdersGrpComp }
        \cup { [ZeroNotAffectedOrdersGrpComp EXCEPT !.notAffectedOrderId = one] : one \in Sample(8) }
        \cup { [ZeroNotAffectedOrdersGrpComp EXCEPT !.notAffOrigClOrdId = one] : one \in Sample(8) }

(* A run of Not Affected Orders Grp Comp, written one after another *)
RECURSIVE EncodeNotAffectedOrdersGrpCompList(_)
EncodeNotAffectedOrdersGrpCompList(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeNotAffectedOrdersGrpComp(Head(messages)) \o EncodeNotAffectedOrdersGrpCompList(Tail(messages))

(* As many Not Affected Orders Grp Comp as the field that counts them says *)
RECURSIVE ReadNotAffectedOrdersGrpCompList(_, _)
ReadNotAffectedOrdersGrpCompList(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeNotAffectedOrdersGrpComp(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadNotAffectedOrdersGrpCompList(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Not Affected Orders Grp Comp of each kind, for the lists that carry them *)
OneNotAffectedOrdersGrpComp == { ZeroNotAffectedOrdersGrpComp }

(***************************************************************************)
(* Affected Order Requests Grp Comp: 8 bytes                               *)
(***************************************************************************)

AffectedOrderRequestsGrpComp ==
    [ affectedOrderRequestId : Sample(4),
      pad4                   : Sample(4) ]

EncodeAffectedOrderRequestsGrpComp(message) ==
    message.affectedOrderRequestId
        \o message.pad4

DecodeAffectedOrderRequestsGrpComp(bytes) ==
    LET affectedOrderRequestId == ReadBytes(bytes, 4) IN IF ~affectedOrderRequestId.ok THEN Fail ELSE
    LET pad4 == ReadBytes(affectedOrderRequestId.rest, 4) IN IF ~pad4.ok THEN Fail ELSE
    Ok([ affectedOrderRequestId |-> affectedOrderRequestId.value,
         pad4                   |-> pad4.value ], pad4.rest)

ZeroAffectedOrderRequestsGrpComp ==
    [ affectedOrderRequestId |-> [i \in 1 .. 4 |-> 0],
      pad4                   |-> [i \in 1 .. 4 |-> 0] ]

(* Affected Order Requests Grp Comp at zero, then each field in turn at the values it is checked at *)
CheckedAffectedOrderRequestsGrpComp ==
    { ZeroAffectedOrderRequestsGrpComp }
        \cup { [ZeroAffectedOrderRequestsGrpComp EXCEPT !.affectedOrderRequestId = one] : one \in Sample(4) }
        \cup { [ZeroAffectedOrderRequestsGrpComp EXCEPT !.pad4 = one] : one \in Sample(4) }

(* A run of Affected Order Requests Grp Comp, written one after another *)
RECURSIVE EncodeAffectedOrderRequestsGrpCompList(_)
EncodeAffectedOrderRequestsGrpCompList(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeAffectedOrderRequestsGrpComp(Head(messages)) \o EncodeAffectedOrderRequestsGrpCompList(Tail(messages))

(* As many Affected Order Requests Grp Comp as the field that counts them says *)
RECURSIVE ReadAffectedOrderRequestsGrpCompList(_, _)
ReadAffectedOrderRequestsGrpCompList(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeAffectedOrderRequestsGrpComp(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadAffectedOrderRequestsGrpCompList(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Affected Order Requests Grp Comp of each kind, for the lists that carry them *)
OneAffectedOrderRequestsGrpComp == { ZeroAffectedOrderRequestsGrpComp }

(***************************************************************************)
(* Delete All Order Broadcast                                              *)
(***************************************************************************)

DeleteAllOrderBroadcast ==
    [ pad2                         : Sample(2),
      rbcHeaderMeComp              : RbcHeaderMeComp3,
      massActionReportId           : Sample(8),
      securityId                   : Sample(8),
      price                        : Sample(8),
      marketSegmentId              : Sample(4),
      targetPartyIdSessionId       : Sample(4),
      targetPartyIdExecutingTrader : Sample(4),
      partyIdEnteringTrader        : Sample(4),
      partyIdEnteringFirm          : Sample(1),
      massActionReason             : Sample(1),
      execInst                     : Sample(1),
      side                         : Sample(1),
      notAffectedOrdersGrpComp     : SampleLists(OneNotAffectedOrdersGrpComp),
      affectedOrderRequestsGrpComp : SampleLists(OneAffectedOrderRequestsGrpComp) ]

EncodeDeleteAllOrderBroadcast(message) ==
    message.pad2
        \o EncodeRbcHeaderMeComp3(message.rbcHeaderMeComp)
        \o message.massActionReportId
        \o message.securityId
        \o message.price
        \o message.marketSegmentId
        \o message.targetPartyIdSessionId
        \o message.targetPartyIdExecutingTrader
        \o message.partyIdEnteringTrader
        \o EncodeUIntLE(Len(message.notAffectedOrdersGrpComp), 2)
        \o EncodeUIntLE(Len(message.affectedOrderRequestsGrpComp), 2)
        \o message.partyIdEnteringFirm
        \o message.massActionReason
        \o message.execInst
        \o message.side
        \o EncodeNotAffectedOrdersGrpCompList(message.notAffectedOrdersGrpComp)
        \o EncodeAffectedOrderRequestsGrpCompList(message.affectedOrderRequestsGrpComp)

DecodeDeleteAllOrderBroadcast(bytes) ==
    LET pad2 == ReadBytes(bytes, 2) IN IF ~pad2.ok THEN Fail ELSE
    LET rbcHeaderMeComp == DecodeRbcHeaderMeComp3(pad2.rest) IN IF ~rbcHeaderMeComp.ok THEN Fail ELSE
    LET massActionReportId == ReadBytes(rbcHeaderMeComp.rest, 8) IN IF ~massActionReportId.ok THEN Fail ELSE
    LET securityId == ReadBytes(massActionReportId.rest, 8) IN IF ~securityId.ok THEN Fail ELSE
    LET price == ReadBytes(securityId.rest, 8) IN IF ~price.ok THEN Fail ELSE
    LET marketSegmentId == ReadBytes(price.rest, 4) IN IF ~marketSegmentId.ok THEN Fail ELSE
    LET targetPartyIdSessionId == ReadBytes(marketSegmentId.rest, 4) IN IF ~targetPartyIdSessionId.ok THEN Fail ELSE
    LET targetPartyIdExecutingTrader == ReadBytes(targetPartyIdSessionId.rest, 4) IN IF ~targetPartyIdExecutingTrader.ok THEN Fail ELSE
    LET partyIdEnteringTrader == ReadBytes(targetPartyIdExecutingTrader.rest, 4) IN IF ~partyIdEnteringTrader.ok THEN Fail ELSE
    LET noNotAffectedOrders == ReadUIntLE(partyIdEnteringTrader.rest, 2) IN IF ~noNotAffectedOrders.ok THEN Fail ELSE
    LET noAffectedOrderRequests == ReadUIntLE(noNotAffectedOrders.rest, 2) IN IF ~noAffectedOrderRequests.ok THEN Fail ELSE
    LET partyIdEnteringFirm == ReadBytes(noAffectedOrderRequests.rest, 1) IN IF ~partyIdEnteringFirm.ok THEN Fail ELSE
    LET massActionReason == ReadBytes(partyIdEnteringFirm.rest, 1) IN IF ~massActionReason.ok THEN Fail ELSE
    LET execInst == ReadBytes(massActionReason.rest, 1) IN IF ~execInst.ok THEN Fail ELSE
    LET side == ReadBytes(execInst.rest, 1) IN IF ~side.ok THEN Fail ELSE
    LET notAffectedOrdersGrpComp == ReadNotAffectedOrdersGrpCompList(side.rest, noNotAffectedOrders.value) IN IF ~notAffectedOrdersGrpComp.ok THEN Fail ELSE
    LET affectedOrderRequestsGrpComp == ReadAffectedOrderRequestsGrpCompList(notAffectedOrdersGrpComp.rest, noAffectedOrderRequests.value) IN IF ~affectedOrderRequestsGrpComp.ok THEN Fail ELSE
    Ok([ pad2                         |-> pad2.value,
         rbcHeaderMeComp              |-> rbcHeaderMeComp.value,
         massActionReportId           |-> massActionReportId.value,
         securityId                   |-> securityId.value,
         price                        |-> price.value,
         marketSegmentId              |-> marketSegmentId.value,
         targetPartyIdSessionId       |-> targetPartyIdSessionId.value,
         targetPartyIdExecutingTrader |-> targetPartyIdExecutingTrader.value,
         partyIdEnteringTrader        |-> partyIdEnteringTrader.value,
         partyIdEnteringFirm          |-> partyIdEnteringFirm.value,
         massActionReason             |-> massActionReason.value,
         execInst                     |-> execInst.value,
         side                         |-> side.value,
         notAffectedOrdersGrpComp     |-> notAffectedOrdersGrpComp.value,
         affectedOrderRequestsGrpComp |-> affectedOrderRequestsGrpComp.value ], affectedOrderRequestsGrpComp.rest)

ZeroDeleteAllOrderBroadcast ==
    [ pad2                         |-> [i \in 1 .. 2 |-> 0],
      rbcHeaderMeComp              |-> ZeroRbcHeaderMeComp3,
      massActionReportId           |-> [i \in 1 .. 8 |-> 0],
      securityId                   |-> [i \in 1 .. 8 |-> 0],
      price                        |-> [i \in 1 .. 8 |-> 0],
      marketSegmentId              |-> [i \in 1 .. 4 |-> 0],
      targetPartyIdSessionId       |-> [i \in 1 .. 4 |-> 0],
      targetPartyIdExecutingTrader |-> [i \in 1 .. 4 |-> 0],
      partyIdEnteringTrader        |-> [i \in 1 .. 4 |-> 0],
      partyIdEnteringFirm          |-> [i \in 1 .. 1 |-> 0],
      massActionReason             |-> [i \in 1 .. 1 |-> 0],
      execInst                     |-> [i \in 1 .. 1 |-> 0],
      side                         |-> [i \in 1 .. 1 |-> 0],
      notAffectedOrdersGrpComp     |-> << >>,
      affectedOrderRequestsGrpComp |-> << >> ]

(* Delete All Order Broadcast at zero, then each field in turn at the values it is checked at *)
CheckedDeleteAllOrderBroadcast ==
    { ZeroDeleteAllOrderBroadcast }
        \cup { [ZeroDeleteAllOrderBroadcast EXCEPT !.pad2 = one] : one \in Sample(2) }
        \cup { [ZeroDeleteAllOrderBroadcast EXCEPT !.rbcHeaderMeComp = one] : one \in CheckedRbcHeaderMeComp3 }
        \cup { [ZeroDeleteAllOrderBroadcast EXCEPT !.massActionReportId = one] : one \in Sample(8) }
        \cup { [ZeroDeleteAllOrderBroadcast EXCEPT !.securityId = one] : one \in Sample(8) }
        \cup { [ZeroDeleteAllOrderBroadcast EXCEPT !.price = one] : one \in Sample(8) }
        \cup { [ZeroDeleteAllOrderBroadcast EXCEPT !.marketSegmentId = one] : one \in Sample(4) }
        \cup { [ZeroDeleteAllOrderBroadcast EXCEPT !.targetPartyIdSessionId = one] : one \in Sample(4) }
        \cup { [ZeroDeleteAllOrderBroadcast EXCEPT !.targetPartyIdExecutingTrader = one] : one \in Sample(4) }
        \cup { [ZeroDeleteAllOrderBroadcast EXCEPT !.partyIdEnteringTrader = one] : one \in Sample(4) }
        \cup { [ZeroDeleteAllOrderBroadcast EXCEPT !.partyIdEnteringFirm = one] : one \in Sample(1) }
        \cup { [ZeroDeleteAllOrderBroadcast EXCEPT !.massActionReason = one] : one \in Sample(1) }
        \cup { [ZeroDeleteAllOrderBroadcast EXCEPT !.execInst = one] : one \in Sample(1) }
        \cup { [ZeroDeleteAllOrderBroadcast EXCEPT !.side = one] : one \in Sample(1) }
        \cup { [ZeroDeleteAllOrderBroadcast EXCEPT !.notAffectedOrdersGrpComp = one] : one \in SampleLists(OneNotAffectedOrdersGrpComp) }
        \cup { [ZeroDeleteAllOrderBroadcast EXCEPT !.affectedOrderRequestsGrpComp = one] : one \in SampleLists(OneAffectedOrderRequestsGrpComp) }

(***************************************************************************)
(* Nr Response Header Me Comp: 48 bytes                                    *)
(***************************************************************************)

NrResponseHeaderMeComp5 ==
    [ requestTime     : Sample(8),
      trdRegTsTimeIn  : Sample(8),
      trdRegTsTimeOut : Sample(8),
      responseIn      : Sample(8),
      sendingTime     : Sample(8),
      msgSeqNum       : Sample(4),
      lastFragment    : Sample(1),
      pad3            : Sample(3) ]

EncodeNrResponseHeaderMeComp5(message) ==
    message.requestTime
        \o message.trdRegTsTimeIn
        \o message.trdRegTsTimeOut
        \o message.responseIn
        \o message.sendingTime
        \o message.msgSeqNum
        \o message.lastFragment
        \o message.pad3

DecodeNrResponseHeaderMeComp5(bytes) ==
    LET requestTime == ReadBytes(bytes, 8) IN IF ~requestTime.ok THEN Fail ELSE
    LET trdRegTsTimeIn == ReadBytes(requestTime.rest, 8) IN IF ~trdRegTsTimeIn.ok THEN Fail ELSE
    LET trdRegTsTimeOut == ReadBytes(trdRegTsTimeIn.rest, 8) IN IF ~trdRegTsTimeOut.ok THEN Fail ELSE
    LET responseIn == ReadBytes(trdRegTsTimeOut.rest, 8) IN IF ~responseIn.ok THEN Fail ELSE
    LET sendingTime == ReadBytes(responseIn.rest, 8) IN IF ~sendingTime.ok THEN Fail ELSE
    LET msgSeqNum == ReadBytes(sendingTime.rest, 4) IN IF ~msgSeqNum.ok THEN Fail ELSE
    LET lastFragment == ReadBytes(msgSeqNum.rest, 1) IN IF ~lastFragment.ok THEN Fail ELSE
    LET pad3 == ReadBytes(lastFragment.rest, 3) IN IF ~pad3.ok THEN Fail ELSE
    Ok([ requestTime     |-> requestTime.value,
         trdRegTsTimeIn  |-> trdRegTsTimeIn.value,
         trdRegTsTimeOut |-> trdRegTsTimeOut.value,
         responseIn      |-> responseIn.value,
         sendingTime     |-> sendingTime.value,
         msgSeqNum       |-> msgSeqNum.value,
         lastFragment    |-> lastFragment.value,
         pad3            |-> pad3.value ], pad3.rest)

ZeroNrResponseHeaderMeComp5 ==
    [ requestTime     |-> [i \in 1 .. 8 |-> 0],
      trdRegTsTimeIn  |-> [i \in 1 .. 8 |-> 0],
      trdRegTsTimeOut |-> [i \in 1 .. 8 |-> 0],
      responseIn      |-> [i \in 1 .. 8 |-> 0],
      sendingTime     |-> [i \in 1 .. 8 |-> 0],
      msgSeqNum       |-> [i \in 1 .. 4 |-> 0],
      lastFragment    |-> [i \in 1 .. 1 |-> 0],
      pad3            |-> [i \in 1 .. 3 |-> 0] ]

(* Nr Response Header Me Comp at zero, then each field in turn at the values it is checked at *)
CheckedNrResponseHeaderMeComp5 ==
    { ZeroNrResponseHeaderMeComp5 }
        \cup { [ZeroNrResponseHeaderMeComp5 EXCEPT !.requestTime = one] : one \in Sample(8) }
        \cup { [ZeroNrResponseHeaderMeComp5 EXCEPT !.trdRegTsTimeIn = one] : one \in Sample(8) }
        \cup { [ZeroNrResponseHeaderMeComp5 EXCEPT !.trdRegTsTimeOut = one] : one \in Sample(8) }
        \cup { [ZeroNrResponseHeaderMeComp5 EXCEPT !.responseIn = one] : one \in Sample(8) }
        \cup { [ZeroNrResponseHeaderMeComp5 EXCEPT !.sendingTime = one] : one \in Sample(8) }
        \cup { [ZeroNrResponseHeaderMeComp5 EXCEPT !.msgSeqNum = one] : one \in Sample(4) }
        \cup { [ZeroNrResponseHeaderMeComp5 EXCEPT !.lastFragment = one] : one \in Sample(1) }
        \cup { [ZeroNrResponseHeaderMeComp5 EXCEPT !.pad3 = one] : one \in Sample(3) }

(***************************************************************************)
(* Delete All Order Nr Response: 58 bytes                                  *)
(***************************************************************************)

DeleteAllOrderNrResponse ==
    [ pad2                   : Sample(2),
      nrResponseHeaderMeComp : NrResponseHeaderMeComp5,
      massActionReportId     : Sample(8) ]

EncodeDeleteAllOrderNrResponse(message) ==
    message.pad2
        \o EncodeNrResponseHeaderMeComp5(message.nrResponseHeaderMeComp)
        \o message.massActionReportId

DecodeDeleteAllOrderNrResponse(bytes) ==
    LET pad2 == ReadBytes(bytes, 2) IN IF ~pad2.ok THEN Fail ELSE
    LET nrResponseHeaderMeComp == DecodeNrResponseHeaderMeComp5(pad2.rest) IN IF ~nrResponseHeaderMeComp.ok THEN Fail ELSE
    LET massActionReportId == ReadBytes(nrResponseHeaderMeComp.rest, 8) IN IF ~massActionReportId.ok THEN Fail ELSE
    Ok([ pad2                   |-> pad2.value,
         nrResponseHeaderMeComp |-> nrResponseHeaderMeComp.value,
         massActionReportId     |-> massActionReportId.value ], massActionReportId.rest)

ZeroDeleteAllOrderNrResponse ==
    [ pad2                   |-> [i \in 1 .. 2 |-> 0],
      nrResponseHeaderMeComp |-> ZeroNrResponseHeaderMeComp5,
      massActionReportId     |-> [i \in 1 .. 8 |-> 0] ]

(* Delete All Order Nr Response at zero, then each field in turn at the values it is checked at *)
CheckedDeleteAllOrderNrResponse ==
    { ZeroDeleteAllOrderNrResponse }
        \cup { [ZeroDeleteAllOrderNrResponse EXCEPT !.pad2 = one] : one \in Sample(2) }
        \cup { [ZeroDeleteAllOrderNrResponse EXCEPT !.nrResponseHeaderMeComp = one] : one \in CheckedNrResponseHeaderMeComp5 }
        \cup { [ZeroDeleteAllOrderNrResponse EXCEPT !.massActionReportId = one] : one \in Sample(8) }

(***************************************************************************)
(* Rbc Header Me Comp: 56 bytes                                            *)
(***************************************************************************)

RbcHeaderMeComp4 ==
    [ trdRegTsTimeOut : Sample(8),
      notificationIn  : Sample(8),
      sendingTime     : Sample(8),
      applSubId       : Sample(4),
      partitionId     : Sample(2),
      applMsgId       : Sample(16),
      applId          : Sample(1),
      applResendFlag  : Sample(1),
      lastFragment    : Sample(1),
      pad7            : Sample(7) ]

EncodeRbcHeaderMeComp4(message) ==
    message.trdRegTsTimeOut
        \o message.notificationIn
        \o message.sendingTime
        \o message.applSubId
        \o message.partitionId
        \o message.applMsgId
        \o message.applId
        \o message.applResendFlag
        \o message.lastFragment
        \o message.pad7

DecodeRbcHeaderMeComp4(bytes) ==
    LET trdRegTsTimeOut == ReadBytes(bytes, 8) IN IF ~trdRegTsTimeOut.ok THEN Fail ELSE
    LET notificationIn == ReadBytes(trdRegTsTimeOut.rest, 8) IN IF ~notificationIn.ok THEN Fail ELSE
    LET sendingTime == ReadBytes(notificationIn.rest, 8) IN IF ~sendingTime.ok THEN Fail ELSE
    LET applSubId == ReadBytes(sendingTime.rest, 4) IN IF ~applSubId.ok THEN Fail ELSE
    LET partitionId == ReadBytes(applSubId.rest, 2) IN IF ~partitionId.ok THEN Fail ELSE
    LET applMsgId == ReadBytes(partitionId.rest, 16) IN IF ~applMsgId.ok THEN Fail ELSE
    LET applId == ReadBytes(applMsgId.rest, 1) IN IF ~applId.ok THEN Fail ELSE
    LET applResendFlag == ReadBytes(applId.rest, 1) IN IF ~applResendFlag.ok THEN Fail ELSE
    LET lastFragment == ReadBytes(applResendFlag.rest, 1) IN IF ~lastFragment.ok THEN Fail ELSE
    LET pad7 == ReadBytes(lastFragment.rest, 7) IN IF ~pad7.ok THEN Fail ELSE
    Ok([ trdRegTsTimeOut |-> trdRegTsTimeOut.value,
         notificationIn  |-> notificationIn.value,
         sendingTime     |-> sendingTime.value,
         applSubId       |-> applSubId.value,
         partitionId     |-> partitionId.value,
         applMsgId       |-> applMsgId.value,
         applId          |-> applId.value,
         applResendFlag  |-> applResendFlag.value,
         lastFragment    |-> lastFragment.value,
         pad7            |-> pad7.value ], pad7.rest)

ZeroRbcHeaderMeComp4 ==
    [ trdRegTsTimeOut |-> [i \in 1 .. 8 |-> 0],
      notificationIn  |-> [i \in 1 .. 8 |-> 0],
      sendingTime     |-> [i \in 1 .. 8 |-> 0],
      applSubId       |-> [i \in 1 .. 4 |-> 0],
      partitionId     |-> [i \in 1 .. 2 |-> 0],
      applMsgId       |-> [i \in 1 .. 16 |-> 0],
      applId          |-> [i \in 1 .. 1 |-> 0],
      applResendFlag  |-> [i \in 1 .. 1 |-> 0],
      lastFragment    |-> [i \in 1 .. 1 |-> 0],
      pad7            |-> [i \in 1 .. 7 |-> 0] ]

(* Rbc Header Me Comp at zero, then each field in turn at the values it is checked at *)
CheckedRbcHeaderMeComp4 ==
    { ZeroRbcHeaderMeComp4 }
        \cup { [ZeroRbcHeaderMeComp4 EXCEPT !.trdRegTsTimeOut = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderMeComp4 EXCEPT !.notificationIn = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderMeComp4 EXCEPT !.sendingTime = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderMeComp4 EXCEPT !.applSubId = one] : one \in Sample(4) }
        \cup { [ZeroRbcHeaderMeComp4 EXCEPT !.partitionId = one] : one \in Sample(2) }
        \cup { [ZeroRbcHeaderMeComp4 EXCEPT !.applMsgId = one] : one \in Sample(16) }
        \cup { [ZeroRbcHeaderMeComp4 EXCEPT !.applId = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderMeComp4 EXCEPT !.applResendFlag = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderMeComp4 EXCEPT !.lastFragment = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderMeComp4 EXCEPT !.pad7 = one] : one \in Sample(7) }

(***************************************************************************)
(* Delete All Order Quote Event Broadcast: 82 bytes                        *)
(***************************************************************************)

DeleteAllOrderQuoteEventBroadcast ==
    [ pad2               : Sample(2),
      rbcHeaderMeComp    : RbcHeaderMeComp4,
      massActionReportId : Sample(8),
      securityId         : Sample(8),
      marketSegmentId    : Sample(4),
      massActionReason   : Sample(1),
      execInst           : Sample(1),
      pad2v2             : Sample(2) ]

EncodeDeleteAllOrderQuoteEventBroadcast(message) ==
    message.pad2
        \o EncodeRbcHeaderMeComp4(message.rbcHeaderMeComp)
        \o message.massActionReportId
        \o message.securityId
        \o message.marketSegmentId
        \o message.massActionReason
        \o message.execInst
        \o message.pad2v2

DecodeDeleteAllOrderQuoteEventBroadcast(bytes) ==
    LET pad2 == ReadBytes(bytes, 2) IN IF ~pad2.ok THEN Fail ELSE
    LET rbcHeaderMeComp == DecodeRbcHeaderMeComp4(pad2.rest) IN IF ~rbcHeaderMeComp.ok THEN Fail ELSE
    LET massActionReportId == ReadBytes(rbcHeaderMeComp.rest, 8) IN IF ~massActionReportId.ok THEN Fail ELSE
    LET securityId == ReadBytes(massActionReportId.rest, 8) IN IF ~securityId.ok THEN Fail ELSE
    LET marketSegmentId == ReadBytes(securityId.rest, 4) IN IF ~marketSegmentId.ok THEN Fail ELSE
    LET massActionReason == ReadBytes(marketSegmentId.rest, 1) IN IF ~massActionReason.ok THEN Fail ELSE
    LET execInst == ReadBytes(massActionReason.rest, 1) IN IF ~execInst.ok THEN Fail ELSE
    LET pad2v2 == ReadBytes(execInst.rest, 2) IN IF ~pad2v2.ok THEN Fail ELSE
    Ok([ pad2               |-> pad2.value,
         rbcHeaderMeComp    |-> rbcHeaderMeComp.value,
         massActionReportId |-> massActionReportId.value,
         securityId         |-> securityId.value,
         marketSegmentId    |-> marketSegmentId.value,
         massActionReason   |-> massActionReason.value,
         execInst           |-> execInst.value,
         pad2v2             |-> pad2v2.value ], pad2v2.rest)

ZeroDeleteAllOrderQuoteEventBroadcast ==
    [ pad2               |-> [i \in 1 .. 2 |-> 0],
      rbcHeaderMeComp    |-> ZeroRbcHeaderMeComp4,
      massActionReportId |-> [i \in 1 .. 8 |-> 0],
      securityId         |-> [i \in 1 .. 8 |-> 0],
      marketSegmentId    |-> [i \in 1 .. 4 |-> 0],
      massActionReason   |-> [i \in 1 .. 1 |-> 0],
      execInst           |-> [i \in 1 .. 1 |-> 0],
      pad2v2             |-> [i \in 1 .. 2 |-> 0] ]

(* Delete All Order Quote Event Broadcast at zero, then each field in turn at the values it is checked at *)
CheckedDeleteAllOrderQuoteEventBroadcast ==
    { ZeroDeleteAllOrderQuoteEventBroadcast }
        \cup { [ZeroDeleteAllOrderQuoteEventBroadcast EXCEPT !.pad2 = one] : one \in Sample(2) }
        \cup { [ZeroDeleteAllOrderQuoteEventBroadcast EXCEPT !.rbcHeaderMeComp = one] : one \in CheckedRbcHeaderMeComp4 }
        \cup { [ZeroDeleteAllOrderQuoteEventBroadcast EXCEPT !.massActionReportId = one] : one \in Sample(8) }
        \cup { [ZeroDeleteAllOrderQuoteEventBroadcast EXCEPT !.securityId = one] : one \in Sample(8) }
        \cup { [ZeroDeleteAllOrderQuoteEventBroadcast EXCEPT !.marketSegmentId = one] : one \in Sample(4) }
        \cup { [ZeroDeleteAllOrderQuoteEventBroadcast EXCEPT !.massActionReason = one] : one \in Sample(1) }
        \cup { [ZeroDeleteAllOrderQuoteEventBroadcast EXCEPT !.execInst = one] : one \in Sample(1) }
        \cup { [ZeroDeleteAllOrderQuoteEventBroadcast EXCEPT !.pad2v2 = one] : one \in Sample(2) }

(***************************************************************************)
(* Response Header Me Comp: 64 bytes                                       *)
(***************************************************************************)

ResponseHeaderMeComp ==
    [ requestTime     : Sample(8),
      trdRegTsTimeIn  : Sample(8),
      trdRegTsTimeOut : Sample(8),
      responseIn      : Sample(8),
      sendingTime     : Sample(8),
      msgSeqNum       : Sample(4),
      partitionId     : Sample(2),
      applId          : Sample(1),
      applMsgId       : Sample(16),
      lastFragment    : Sample(1) ]

EncodeResponseHeaderMeComp(message) ==
    message.requestTime
        \o message.trdRegTsTimeIn
        \o message.trdRegTsTimeOut
        \o message.responseIn
        \o message.sendingTime
        \o message.msgSeqNum
        \o message.partitionId
        \o message.applId
        \o message.applMsgId
        \o message.lastFragment

DecodeResponseHeaderMeComp(bytes) ==
    LET requestTime == ReadBytes(bytes, 8) IN IF ~requestTime.ok THEN Fail ELSE
    LET trdRegTsTimeIn == ReadBytes(requestTime.rest, 8) IN IF ~trdRegTsTimeIn.ok THEN Fail ELSE
    LET trdRegTsTimeOut == ReadBytes(trdRegTsTimeIn.rest, 8) IN IF ~trdRegTsTimeOut.ok THEN Fail ELSE
    LET responseIn == ReadBytes(trdRegTsTimeOut.rest, 8) IN IF ~responseIn.ok THEN Fail ELSE
    LET sendingTime == ReadBytes(responseIn.rest, 8) IN IF ~sendingTime.ok THEN Fail ELSE
    LET msgSeqNum == ReadBytes(sendingTime.rest, 4) IN IF ~msgSeqNum.ok THEN Fail ELSE
    LET partitionId == ReadBytes(msgSeqNum.rest, 2) IN IF ~partitionId.ok THEN Fail ELSE
    LET applId == ReadBytes(partitionId.rest, 1) IN IF ~applId.ok THEN Fail ELSE
    LET applMsgId == ReadBytes(applId.rest, 16) IN IF ~applMsgId.ok THEN Fail ELSE
    LET lastFragment == ReadBytes(applMsgId.rest, 1) IN IF ~lastFragment.ok THEN Fail ELSE
    Ok([ requestTime     |-> requestTime.value,
         trdRegTsTimeIn  |-> trdRegTsTimeIn.value,
         trdRegTsTimeOut |-> trdRegTsTimeOut.value,
         responseIn      |-> responseIn.value,
         sendingTime     |-> sendingTime.value,
         msgSeqNum       |-> msgSeqNum.value,
         partitionId     |-> partitionId.value,
         applId          |-> applId.value,
         applMsgId       |-> applMsgId.value,
         lastFragment    |-> lastFragment.value ], lastFragment.rest)

ZeroResponseHeaderMeComp ==
    [ requestTime     |-> [i \in 1 .. 8 |-> 0],
      trdRegTsTimeIn  |-> [i \in 1 .. 8 |-> 0],
      trdRegTsTimeOut |-> [i \in 1 .. 8 |-> 0],
      responseIn      |-> [i \in 1 .. 8 |-> 0],
      sendingTime     |-> [i \in 1 .. 8 |-> 0],
      msgSeqNum       |-> [i \in 1 .. 4 |-> 0],
      partitionId     |-> [i \in 1 .. 2 |-> 0],
      applId          |-> [i \in 1 .. 1 |-> 0],
      applMsgId       |-> [i \in 1 .. 16 |-> 0],
      lastFragment    |-> [i \in 1 .. 1 |-> 0] ]

(* Response Header Me Comp at zero, then each field in turn at the values it is checked at *)
CheckedResponseHeaderMeComp ==
    { ZeroResponseHeaderMeComp }
        \cup { [ZeroResponseHeaderMeComp EXCEPT !.requestTime = one] : one \in Sample(8) }
        \cup { [ZeroResponseHeaderMeComp EXCEPT !.trdRegTsTimeIn = one] : one \in Sample(8) }
        \cup { [ZeroResponseHeaderMeComp EXCEPT !.trdRegTsTimeOut = one] : one \in Sample(8) }
        \cup { [ZeroResponseHeaderMeComp EXCEPT !.responseIn = one] : one \in Sample(8) }
        \cup { [ZeroResponseHeaderMeComp EXCEPT !.sendingTime = one] : one \in Sample(8) }
        \cup { [ZeroResponseHeaderMeComp EXCEPT !.msgSeqNum = one] : one \in Sample(4) }
        \cup { [ZeroResponseHeaderMeComp EXCEPT !.partitionId = one] : one \in Sample(2) }
        \cup { [ZeroResponseHeaderMeComp EXCEPT !.applId = one] : one \in Sample(1) }
        \cup { [ZeroResponseHeaderMeComp EXCEPT !.applMsgId = one] : one \in Sample(16) }
        \cup { [ZeroResponseHeaderMeComp EXCEPT !.lastFragment = one] : one \in Sample(1) }

(***************************************************************************)
(* Not Affected Orders Grp Comp: 16 bytes                                  *)
(***************************************************************************)

NotAffectedOrdersGrpComp2 ==
    [ notAffectedOrderId : Sample(8),
      notAffOrigClOrdId  : Sample(8) ]

EncodeNotAffectedOrdersGrpComp2(message) ==
    message.notAffectedOrderId
        \o message.notAffOrigClOrdId

DecodeNotAffectedOrdersGrpComp2(bytes) ==
    LET notAffectedOrderId == ReadBytes(bytes, 8) IN IF ~notAffectedOrderId.ok THEN Fail ELSE
    LET notAffOrigClOrdId == ReadBytes(notAffectedOrderId.rest, 8) IN IF ~notAffOrigClOrdId.ok THEN Fail ELSE
    Ok([ notAffectedOrderId |-> notAffectedOrderId.value,
         notAffOrigClOrdId  |-> notAffOrigClOrdId.value ], notAffOrigClOrdId.rest)

ZeroNotAffectedOrdersGrpComp2 ==
    [ notAffectedOrderId |-> [i \in 1 .. 8 |-> 0],
      notAffOrigClOrdId  |-> [i \in 1 .. 8 |-> 0] ]

(* Not Affected Orders Grp Comp at zero, then each field in turn at the values it is checked at *)
CheckedNotAffectedOrdersGrpComp2 ==
    { ZeroNotAffectedOrdersGrpComp2 }
        \cup { [ZeroNotAffectedOrdersGrpComp2 EXCEPT !.notAffectedOrderId = one] : one \in Sample(8) }
        \cup { [ZeroNotAffectedOrdersGrpComp2 EXCEPT !.notAffOrigClOrdId = one] : one \in Sample(8) }

(* A run of Not Affected Orders Grp Comp, written one after another *)
RECURSIVE EncodeNotAffectedOrdersGrpComp2List(_)
EncodeNotAffectedOrdersGrpComp2List(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeNotAffectedOrdersGrpComp2(Head(messages)) \o EncodeNotAffectedOrdersGrpComp2List(Tail(messages))

(* As many Not Affected Orders Grp Comp as the field that counts them says *)
RECURSIVE ReadNotAffectedOrdersGrpComp2List(_, _)
ReadNotAffectedOrdersGrpComp2List(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeNotAffectedOrdersGrpComp2(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadNotAffectedOrdersGrpComp2List(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Not Affected Orders Grp Comp of each kind, for the lists that carry them *)
OneNotAffectedOrdersGrpComp2 == { ZeroNotAffectedOrdersGrpComp2 }

(***************************************************************************)
(* Affected Order Requests Grp Comp: 8 bytes                               *)
(***************************************************************************)

AffectedOrderRequestsGrpComp2 ==
    [ affectedOrderRequestId : Sample(4),
      pad4                   : Sample(4) ]

EncodeAffectedOrderRequestsGrpComp2(message) ==
    message.affectedOrderRequestId
        \o message.pad4

DecodeAffectedOrderRequestsGrpComp2(bytes) ==
    LET affectedOrderRequestId == ReadBytes(bytes, 4) IN IF ~affectedOrderRequestId.ok THEN Fail ELSE
    LET pad4 == ReadBytes(affectedOrderRequestId.rest, 4) IN IF ~pad4.ok THEN Fail ELSE
    Ok([ affectedOrderRequestId |-> affectedOrderRequestId.value,
         pad4                   |-> pad4.value ], pad4.rest)

ZeroAffectedOrderRequestsGrpComp2 ==
    [ affectedOrderRequestId |-> [i \in 1 .. 4 |-> 0],
      pad4                   |-> [i \in 1 .. 4 |-> 0] ]

(* Affected Order Requests Grp Comp at zero, then each field in turn at the values it is checked at *)
CheckedAffectedOrderRequestsGrpComp2 ==
    { ZeroAffectedOrderRequestsGrpComp2 }
        \cup { [ZeroAffectedOrderRequestsGrpComp2 EXCEPT !.affectedOrderRequestId = one] : one \in Sample(4) }
        \cup { [ZeroAffectedOrderRequestsGrpComp2 EXCEPT !.pad4 = one] : one \in Sample(4) }

(* A run of Affected Order Requests Grp Comp, written one after another *)
RECURSIVE EncodeAffectedOrderRequestsGrpComp2List(_)
EncodeAffectedOrderRequestsGrpComp2List(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeAffectedOrderRequestsGrpComp2(Head(messages)) \o EncodeAffectedOrderRequestsGrpComp2List(Tail(messages))

(* As many Affected Order Requests Grp Comp as the field that counts them says *)
RECURSIVE ReadAffectedOrderRequestsGrpComp2List(_, _)
ReadAffectedOrderRequestsGrpComp2List(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeAffectedOrderRequestsGrpComp2(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadAffectedOrderRequestsGrpComp2List(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Affected Order Requests Grp Comp of each kind, for the lists that carry them *)
OneAffectedOrderRequestsGrpComp2 == { ZeroAffectedOrderRequestsGrpComp2 }

(***************************************************************************)
(* Delete All Order Response                                               *)
(***************************************************************************)

DeleteAllOrderResponse ==
    [ pad2                         : Sample(2),
      responseHeaderMeComp         : ResponseHeaderMeComp,
      massActionReportId           : Sample(8),
      pad4                         : Sample(4),
      notAffectedOrdersGrpComp     : SampleLists(OneNotAffectedOrdersGrpComp2),
      affectedOrderRequestsGrpComp : SampleLists(OneAffectedOrderRequestsGrpComp2) ]

EncodeDeleteAllOrderResponse(message) ==
    message.pad2
        \o EncodeResponseHeaderMeComp(message.responseHeaderMeComp)
        \o message.massActionReportId
        \o EncodeUIntLE(Len(message.notAffectedOrdersGrpComp), 2)
        \o EncodeUIntLE(Len(message.affectedOrderRequestsGrpComp), 2)
        \o message.pad4
        \o EncodeNotAffectedOrdersGrpComp2List(message.notAffectedOrdersGrpComp)
        \o EncodeAffectedOrderRequestsGrpComp2List(message.affectedOrderRequestsGrpComp)

DecodeDeleteAllOrderResponse(bytes) ==
    LET pad2 == ReadBytes(bytes, 2) IN IF ~pad2.ok THEN Fail ELSE
    LET responseHeaderMeComp == DecodeResponseHeaderMeComp(pad2.rest) IN IF ~responseHeaderMeComp.ok THEN Fail ELSE
    LET massActionReportId == ReadBytes(responseHeaderMeComp.rest, 8) IN IF ~massActionReportId.ok THEN Fail ELSE
    LET noNotAffectedOrders == ReadUIntLE(massActionReportId.rest, 2) IN IF ~noNotAffectedOrders.ok THEN Fail ELSE
    LET noAffectedOrderRequests == ReadUIntLE(noNotAffectedOrders.rest, 2) IN IF ~noAffectedOrderRequests.ok THEN Fail ELSE
    LET pad4 == ReadBytes(noAffectedOrderRequests.rest, 4) IN IF ~pad4.ok THEN Fail ELSE
    LET notAffectedOrdersGrpComp == ReadNotAffectedOrdersGrpComp2List(pad4.rest, noNotAffectedOrders.value) IN IF ~notAffectedOrdersGrpComp.ok THEN Fail ELSE
    LET affectedOrderRequestsGrpComp == ReadAffectedOrderRequestsGrpComp2List(notAffectedOrdersGrpComp.rest, noAffectedOrderRequests.value) IN IF ~affectedOrderRequestsGrpComp.ok THEN Fail ELSE
    Ok([ pad2                         |-> pad2.value,
         responseHeaderMeComp         |-> responseHeaderMeComp.value,
         massActionReportId           |-> massActionReportId.value,
         pad4                         |-> pad4.value,
         notAffectedOrdersGrpComp     |-> notAffectedOrdersGrpComp.value,
         affectedOrderRequestsGrpComp |-> affectedOrderRequestsGrpComp.value ], affectedOrderRequestsGrpComp.rest)

ZeroDeleteAllOrderResponse ==
    [ pad2                         |-> [i \in 1 .. 2 |-> 0],
      responseHeaderMeComp         |-> ZeroResponseHeaderMeComp,
      massActionReportId           |-> [i \in 1 .. 8 |-> 0],
      pad4                         |-> [i \in 1 .. 4 |-> 0],
      notAffectedOrdersGrpComp     |-> << >>,
      affectedOrderRequestsGrpComp |-> << >> ]

(* Delete All Order Response at zero, then each field in turn at the values it is checked at *)
CheckedDeleteAllOrderResponse ==
    { ZeroDeleteAllOrderResponse }
        \cup { [ZeroDeleteAllOrderResponse EXCEPT !.pad2 = one] : one \in Sample(2) }
        \cup { [ZeroDeleteAllOrderResponse EXCEPT !.responseHeaderMeComp = one] : one \in CheckedResponseHeaderMeComp }
        \cup { [ZeroDeleteAllOrderResponse EXCEPT !.massActionReportId = one] : one \in Sample(8) }
        \cup { [ZeroDeleteAllOrderResponse EXCEPT !.pad4 = one] : one \in Sample(4) }
        \cup { [ZeroDeleteAllOrderResponse EXCEPT !.notAffectedOrdersGrpComp = one] : one \in SampleLists(OneNotAffectedOrdersGrpComp2) }
        \cup { [ZeroDeleteAllOrderResponse EXCEPT !.affectedOrderRequestsGrpComp = one] : one \in SampleLists(OneAffectedOrderRequestsGrpComp2) }

(***************************************************************************)
(* Rbc Header Me Comp: 56 bytes                                            *)
(***************************************************************************)

RbcHeaderMeComp5 ==
    [ trdRegTsTimeOut : Sample(8),
      notificationIn  : Sample(8),
      sendingTime     : Sample(8),
      applSubId       : Sample(4),
      partitionId     : Sample(2),
      applMsgId       : Sample(16),
      applId          : Sample(1),
      applResendFlag  : Sample(1),
      lastFragment    : Sample(1),
      pad7            : Sample(7) ]

EncodeRbcHeaderMeComp5(message) ==
    message.trdRegTsTimeOut
        \o message.notificationIn
        \o message.sendingTime
        \o message.applSubId
        \o message.partitionId
        \o message.applMsgId
        \o message.applId
        \o message.applResendFlag
        \o message.lastFragment
        \o message.pad7

DecodeRbcHeaderMeComp5(bytes) ==
    LET trdRegTsTimeOut == ReadBytes(bytes, 8) IN IF ~trdRegTsTimeOut.ok THEN Fail ELSE
    LET notificationIn == ReadBytes(trdRegTsTimeOut.rest, 8) IN IF ~notificationIn.ok THEN Fail ELSE
    LET sendingTime == ReadBytes(notificationIn.rest, 8) IN IF ~sendingTime.ok THEN Fail ELSE
    LET applSubId == ReadBytes(sendingTime.rest, 4) IN IF ~applSubId.ok THEN Fail ELSE
    LET partitionId == ReadBytes(applSubId.rest, 2) IN IF ~partitionId.ok THEN Fail ELSE
    LET applMsgId == ReadBytes(partitionId.rest, 16) IN IF ~applMsgId.ok THEN Fail ELSE
    LET applId == ReadBytes(applMsgId.rest, 1) IN IF ~applId.ok THEN Fail ELSE
    LET applResendFlag == ReadBytes(applId.rest, 1) IN IF ~applResendFlag.ok THEN Fail ELSE
    LET lastFragment == ReadBytes(applResendFlag.rest, 1) IN IF ~lastFragment.ok THEN Fail ELSE
    LET pad7 == ReadBytes(lastFragment.rest, 7) IN IF ~pad7.ok THEN Fail ELSE
    Ok([ trdRegTsTimeOut |-> trdRegTsTimeOut.value,
         notificationIn  |-> notificationIn.value,
         sendingTime     |-> sendingTime.value,
         applSubId       |-> applSubId.value,
         partitionId     |-> partitionId.value,
         applMsgId       |-> applMsgId.value,
         applId          |-> applId.value,
         applResendFlag  |-> applResendFlag.value,
         lastFragment    |-> lastFragment.value,
         pad7            |-> pad7.value ], pad7.rest)

ZeroRbcHeaderMeComp5 ==
    [ trdRegTsTimeOut |-> [i \in 1 .. 8 |-> 0],
      notificationIn  |-> [i \in 1 .. 8 |-> 0],
      sendingTime     |-> [i \in 1 .. 8 |-> 0],
      applSubId       |-> [i \in 1 .. 4 |-> 0],
      partitionId     |-> [i \in 1 .. 2 |-> 0],
      applMsgId       |-> [i \in 1 .. 16 |-> 0],
      applId          |-> [i \in 1 .. 1 |-> 0],
      applResendFlag  |-> [i \in 1 .. 1 |-> 0],
      lastFragment    |-> [i \in 1 .. 1 |-> 0],
      pad7            |-> [i \in 1 .. 7 |-> 0] ]

(* Rbc Header Me Comp at zero, then each field in turn at the values it is checked at *)
CheckedRbcHeaderMeComp5 ==
    { ZeroRbcHeaderMeComp5 }
        \cup { [ZeroRbcHeaderMeComp5 EXCEPT !.trdRegTsTimeOut = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderMeComp5 EXCEPT !.notificationIn = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderMeComp5 EXCEPT !.sendingTime = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderMeComp5 EXCEPT !.applSubId = one] : one \in Sample(4) }
        \cup { [ZeroRbcHeaderMeComp5 EXCEPT !.partitionId = one] : one \in Sample(2) }
        \cup { [ZeroRbcHeaderMeComp5 EXCEPT !.applMsgId = one] : one \in Sample(16) }
        \cup { [ZeroRbcHeaderMeComp5 EXCEPT !.applId = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderMeComp5 EXCEPT !.applResendFlag = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderMeComp5 EXCEPT !.lastFragment = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderMeComp5 EXCEPT !.pad7 = one] : one \in Sample(7) }

(***************************************************************************)
(* Not Affected Securities Grp Comp: 8 bytes                               *)
(***************************************************************************)

NotAffectedSecuritiesGrpComp ==
    [ notAffectedSecurityId : Sample(8) ]

EncodeNotAffectedSecuritiesGrpComp(message) ==
    message.notAffectedSecurityId

DecodeNotAffectedSecuritiesGrpComp(bytes) ==
    LET notAffectedSecurityId == ReadBytes(bytes, 8) IN IF ~notAffectedSecurityId.ok THEN Fail ELSE
    Ok([ notAffectedSecurityId |-> notAffectedSecurityId.value ], notAffectedSecurityId.rest)

ZeroNotAffectedSecuritiesGrpComp ==
    [ notAffectedSecurityId |-> [i \in 1 .. 8 |-> 0] ]

(* Not Affected Securities Grp Comp at zero, then each field in turn at the values it is checked at *)
CheckedNotAffectedSecuritiesGrpComp ==
    { ZeroNotAffectedSecuritiesGrpComp }
        \cup { [ZeroNotAffectedSecuritiesGrpComp EXCEPT !.notAffectedSecurityId = one] : one \in Sample(8) }

(* A run of Not Affected Securities Grp Comp, written one after another *)
RECURSIVE EncodeNotAffectedSecuritiesGrpCompList(_)
EncodeNotAffectedSecuritiesGrpCompList(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeNotAffectedSecuritiesGrpComp(Head(messages)) \o EncodeNotAffectedSecuritiesGrpCompList(Tail(messages))

(* As many Not Affected Securities Grp Comp as the field that counts them says *)
RECURSIVE ReadNotAffectedSecuritiesGrpCompList(_, _)
ReadNotAffectedSecuritiesGrpCompList(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeNotAffectedSecuritiesGrpComp(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadNotAffectedSecuritiesGrpCompList(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Not Affected Securities Grp Comp of each kind, for the lists that carry them *)
OneNotAffectedSecuritiesGrpComp == { ZeroNotAffectedSecuritiesGrpComp }

(***************************************************************************)
(* Delete All Quote Broadcast                                              *)
(***************************************************************************)

DeleteAllQuoteBroadcast ==
    [ pad2                         : Sample(2),
      rbcHeaderMeComp              : RbcHeaderMeComp5,
      massActionReportId           : Sample(8),
      securityId                   : Sample(8),
      marketSegmentId              : Sample(4),
      targetPartyIdSessionId       : Sample(4),
      partyIdEnteringTrader        : Sample(4),
      targetPartyIdExecutingTrader : Sample(4),
      massActionReason             : Sample(1),
      partyIdEnteringFirm          : Sample(1),
      targetPartyIdDeskId          : Sample(3),
      pad1                         : Sample(1),
      notAffectedSecuritiesGrpComp : SampleLists(OneNotAffectedSecuritiesGrpComp) ]

EncodeDeleteAllQuoteBroadcast(message) ==
    message.pad2
        \o EncodeRbcHeaderMeComp5(message.rbcHeaderMeComp)
        \o message.massActionReportId
        \o message.securityId
        \o message.marketSegmentId
        \o message.targetPartyIdSessionId
        \o message.partyIdEnteringTrader
        \o message.targetPartyIdExecutingTrader
        \o EncodeUIntLE(Len(message.notAffectedSecuritiesGrpComp), 2)
        \o message.massActionReason
        \o message.partyIdEnteringFirm
        \o message.targetPartyIdDeskId
        \o message.pad1
        \o EncodeNotAffectedSecuritiesGrpCompList(message.notAffectedSecuritiesGrpComp)

DecodeDeleteAllQuoteBroadcast(bytes) ==
    LET pad2 == ReadBytes(bytes, 2) IN IF ~pad2.ok THEN Fail ELSE
    LET rbcHeaderMeComp == DecodeRbcHeaderMeComp5(pad2.rest) IN IF ~rbcHeaderMeComp.ok THEN Fail ELSE
    LET massActionReportId == ReadBytes(rbcHeaderMeComp.rest, 8) IN IF ~massActionReportId.ok THEN Fail ELSE
    LET securityId == ReadBytes(massActionReportId.rest, 8) IN IF ~securityId.ok THEN Fail ELSE
    LET marketSegmentId == ReadBytes(securityId.rest, 4) IN IF ~marketSegmentId.ok THEN Fail ELSE
    LET targetPartyIdSessionId == ReadBytes(marketSegmentId.rest, 4) IN IF ~targetPartyIdSessionId.ok THEN Fail ELSE
    LET partyIdEnteringTrader == ReadBytes(targetPartyIdSessionId.rest, 4) IN IF ~partyIdEnteringTrader.ok THEN Fail ELSE
    LET targetPartyIdExecutingTrader == ReadBytes(partyIdEnteringTrader.rest, 4) IN IF ~targetPartyIdExecutingTrader.ok THEN Fail ELSE
    LET noNotAffectedSecurities == ReadUIntLE(targetPartyIdExecutingTrader.rest, 2) IN IF ~noNotAffectedSecurities.ok THEN Fail ELSE
    LET massActionReason == ReadBytes(noNotAffectedSecurities.rest, 1) IN IF ~massActionReason.ok THEN Fail ELSE
    LET partyIdEnteringFirm == ReadBytes(massActionReason.rest, 1) IN IF ~partyIdEnteringFirm.ok THEN Fail ELSE
    LET targetPartyIdDeskId == ReadBytes(partyIdEnteringFirm.rest, 3) IN IF ~targetPartyIdDeskId.ok THEN Fail ELSE
    LET pad1 == ReadBytes(targetPartyIdDeskId.rest, 1) IN IF ~pad1.ok THEN Fail ELSE
    LET notAffectedSecuritiesGrpComp == ReadNotAffectedSecuritiesGrpCompList(pad1.rest, noNotAffectedSecurities.value) IN IF ~notAffectedSecuritiesGrpComp.ok THEN Fail ELSE
    Ok([ pad2                         |-> pad2.value,
         rbcHeaderMeComp              |-> rbcHeaderMeComp.value,
         massActionReportId           |-> massActionReportId.value,
         securityId                   |-> securityId.value,
         marketSegmentId              |-> marketSegmentId.value,
         targetPartyIdSessionId       |-> targetPartyIdSessionId.value,
         partyIdEnteringTrader        |-> partyIdEnteringTrader.value,
         targetPartyIdExecutingTrader |-> targetPartyIdExecutingTrader.value,
         massActionReason             |-> massActionReason.value,
         partyIdEnteringFirm          |-> partyIdEnteringFirm.value,
         targetPartyIdDeskId          |-> targetPartyIdDeskId.value,
         pad1                         |-> pad1.value,
         notAffectedSecuritiesGrpComp |-> notAffectedSecuritiesGrpComp.value ], notAffectedSecuritiesGrpComp.rest)

ZeroDeleteAllQuoteBroadcast ==
    [ pad2                         |-> [i \in 1 .. 2 |-> 0],
      rbcHeaderMeComp              |-> ZeroRbcHeaderMeComp5,
      massActionReportId           |-> [i \in 1 .. 8 |-> 0],
      securityId                   |-> [i \in 1 .. 8 |-> 0],
      marketSegmentId              |-> [i \in 1 .. 4 |-> 0],
      targetPartyIdSessionId       |-> [i \in 1 .. 4 |-> 0],
      partyIdEnteringTrader        |-> [i \in 1 .. 4 |-> 0],
      targetPartyIdExecutingTrader |-> [i \in 1 .. 4 |-> 0],
      massActionReason             |-> [i \in 1 .. 1 |-> 0],
      partyIdEnteringFirm          |-> [i \in 1 .. 1 |-> 0],
      targetPartyIdDeskId          |-> [i \in 1 .. 3 |-> 0],
      pad1                         |-> [i \in 1 .. 1 |-> 0],
      notAffectedSecuritiesGrpComp |-> << >> ]

(* Delete All Quote Broadcast at zero, then each field in turn at the values it is checked at *)
CheckedDeleteAllQuoteBroadcast ==
    { ZeroDeleteAllQuoteBroadcast }
        \cup { [ZeroDeleteAllQuoteBroadcast EXCEPT !.pad2 = one] : one \in Sample(2) }
        \cup { [ZeroDeleteAllQuoteBroadcast EXCEPT !.rbcHeaderMeComp = one] : one \in CheckedRbcHeaderMeComp5 }
        \cup { [ZeroDeleteAllQuoteBroadcast EXCEPT !.massActionReportId = one] : one \in Sample(8) }
        \cup { [ZeroDeleteAllQuoteBroadcast EXCEPT !.securityId = one] : one \in Sample(8) }
        \cup { [ZeroDeleteAllQuoteBroadcast EXCEPT !.marketSegmentId = one] : one \in Sample(4) }
        \cup { [ZeroDeleteAllQuoteBroadcast EXCEPT !.targetPartyIdSessionId = one] : one \in Sample(4) }
        \cup { [ZeroDeleteAllQuoteBroadcast EXCEPT !.partyIdEnteringTrader = one] : one \in Sample(4) }
        \cup { [ZeroDeleteAllQuoteBroadcast EXCEPT !.targetPartyIdExecutingTrader = one] : one \in Sample(4) }
        \cup { [ZeroDeleteAllQuoteBroadcast EXCEPT !.massActionReason = one] : one \in Sample(1) }
        \cup { [ZeroDeleteAllQuoteBroadcast EXCEPT !.partyIdEnteringFirm = one] : one \in Sample(1) }
        \cup { [ZeroDeleteAllQuoteBroadcast EXCEPT !.targetPartyIdDeskId = one] : one \in Sample(3) }
        \cup { [ZeroDeleteAllQuoteBroadcast EXCEPT !.pad1 = one] : one \in Sample(1) }
        \cup { [ZeroDeleteAllQuoteBroadcast EXCEPT !.notAffectedSecuritiesGrpComp = one] : one \in SampleLists(OneNotAffectedSecuritiesGrpComp) }

(***************************************************************************)
(* Nr Response Header Me Comp: 48 bytes                                    *)
(***************************************************************************)

NrResponseHeaderMeComp6 ==
    [ requestTime     : Sample(8),
      trdRegTsTimeIn  : Sample(8),
      trdRegTsTimeOut : Sample(8),
      responseIn      : Sample(8),
      sendingTime     : Sample(8),
      msgSeqNum       : Sample(4),
      lastFragment    : Sample(1),
      pad3            : Sample(3) ]

EncodeNrResponseHeaderMeComp6(message) ==
    message.requestTime
        \o message.trdRegTsTimeIn
        \o message.trdRegTsTimeOut
        \o message.responseIn
        \o message.sendingTime
        \o message.msgSeqNum
        \o message.lastFragment
        \o message.pad3

DecodeNrResponseHeaderMeComp6(bytes) ==
    LET requestTime == ReadBytes(bytes, 8) IN IF ~requestTime.ok THEN Fail ELSE
    LET trdRegTsTimeIn == ReadBytes(requestTime.rest, 8) IN IF ~trdRegTsTimeIn.ok THEN Fail ELSE
    LET trdRegTsTimeOut == ReadBytes(trdRegTsTimeIn.rest, 8) IN IF ~trdRegTsTimeOut.ok THEN Fail ELSE
    LET responseIn == ReadBytes(trdRegTsTimeOut.rest, 8) IN IF ~responseIn.ok THEN Fail ELSE
    LET sendingTime == ReadBytes(responseIn.rest, 8) IN IF ~sendingTime.ok THEN Fail ELSE
    LET msgSeqNum == ReadBytes(sendingTime.rest, 4) IN IF ~msgSeqNum.ok THEN Fail ELSE
    LET lastFragment == ReadBytes(msgSeqNum.rest, 1) IN IF ~lastFragment.ok THEN Fail ELSE
    LET pad3 == ReadBytes(lastFragment.rest, 3) IN IF ~pad3.ok THEN Fail ELSE
    Ok([ requestTime     |-> requestTime.value,
         trdRegTsTimeIn  |-> trdRegTsTimeIn.value,
         trdRegTsTimeOut |-> trdRegTsTimeOut.value,
         responseIn      |-> responseIn.value,
         sendingTime     |-> sendingTime.value,
         msgSeqNum       |-> msgSeqNum.value,
         lastFragment    |-> lastFragment.value,
         pad3            |-> pad3.value ], pad3.rest)

ZeroNrResponseHeaderMeComp6 ==
    [ requestTime     |-> [i \in 1 .. 8 |-> 0],
      trdRegTsTimeIn  |-> [i \in 1 .. 8 |-> 0],
      trdRegTsTimeOut |-> [i \in 1 .. 8 |-> 0],
      responseIn      |-> [i \in 1 .. 8 |-> 0],
      sendingTime     |-> [i \in 1 .. 8 |-> 0],
      msgSeqNum       |-> [i \in 1 .. 4 |-> 0],
      lastFragment    |-> [i \in 1 .. 1 |-> 0],
      pad3            |-> [i \in 1 .. 3 |-> 0] ]

(* Nr Response Header Me Comp at zero, then each field in turn at the values it is checked at *)
CheckedNrResponseHeaderMeComp6 ==
    { ZeroNrResponseHeaderMeComp6 }
        \cup { [ZeroNrResponseHeaderMeComp6 EXCEPT !.requestTime = one] : one \in Sample(8) }
        \cup { [ZeroNrResponseHeaderMeComp6 EXCEPT !.trdRegTsTimeIn = one] : one \in Sample(8) }
        \cup { [ZeroNrResponseHeaderMeComp6 EXCEPT !.trdRegTsTimeOut = one] : one \in Sample(8) }
        \cup { [ZeroNrResponseHeaderMeComp6 EXCEPT !.responseIn = one] : one \in Sample(8) }
        \cup { [ZeroNrResponseHeaderMeComp6 EXCEPT !.sendingTime = one] : one \in Sample(8) }
        \cup { [ZeroNrResponseHeaderMeComp6 EXCEPT !.msgSeqNum = one] : one \in Sample(4) }
        \cup { [ZeroNrResponseHeaderMeComp6 EXCEPT !.lastFragment = one] : one \in Sample(1) }
        \cup { [ZeroNrResponseHeaderMeComp6 EXCEPT !.pad3 = one] : one \in Sample(3) }

