        \cup { [ZeroResponseHeaderComp15 EXCEPT !.requestTime = one] : one \in Sample(8) }
        \cup { [ZeroResponseHeaderComp15 EXCEPT !.sendingTime = one] : one \in Sample(8) }
        \cup { [ZeroResponseHeaderComp15 EXCEPT !.msgSeqNum = one] : one \in Sample(4) }
        \cup { [ZeroResponseHeaderComp15 EXCEPT !.pad4 = one] : one \in Sample(4) }

(***************************************************************************)
(* Unsubscribe Response: 26 bytes                                          *)
(***************************************************************************)

UnsubscribeResponse ==
    [ pad2               : Sample(2),
      responseHeaderComp : ResponseHeaderComp15 ]

EncodeUnsubscribeResponse(message) ==
