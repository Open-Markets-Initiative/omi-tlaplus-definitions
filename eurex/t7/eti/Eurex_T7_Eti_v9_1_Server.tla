ServerPayload ==
    [ tag : {AddComplexInstrumentResponseCode}, body : AddComplexInstrumentResponse ]
        \cup [ tag : {AddFlexibleInstrumentResponseCode}, body : AddFlexibleInstrumentResponse ]
        \cup [ tag : {BasketApproveBroadcastCode}, body : BasketApproveBroadcast ]
        \cup [ tag : {BasketBroadcastCode}, body : BasketBroadcast ]
