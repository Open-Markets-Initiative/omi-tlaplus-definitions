    Ok([ pad2                   |-> pad2.value,
         nrResponseHeaderMeComp |-> nrResponseHeaderMeComp.value,
         execId                 |-> execId.value ], execId.rest)

ZeroMmParameterDefinitionResponse ==
    [ pad2                   |-> [i \in 1 .. 2 |-> 0],
      nrResponseHeaderMeComp |-> ZeroNrResponseHeaderMeComp9,
      execId                 |-> [i \in 1 .. 8 |-> 0] ]

(* Mm Parameter Definition Response at zero, then each field in turn at the values it is checked at *)
CheckedMmParameterDefinitionResponse ==
    { ZeroMmParameterDefinitionResponse }
        \cup { [ZeroMmParameterDefinitionResponse EXCEPT !.pad2 = one] : one \in Sample(2) }
        \cup { [ZeroMmParameterDefinitionResponse EXCEPT !.nrResponseHeaderMeComp = one] : one \in CheckedNrResponseHeaderMeComp9 }
        \cup { [ZeroMmParameterDefinitionResponse EXCEPT !.execId = one] : one \in Sample(8) }

