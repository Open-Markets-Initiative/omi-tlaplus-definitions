      partitionId    |-> [i \in 1 .. 2 |-> 0],
      applResendFlag |-> [i \in 1 .. 1 |-> 0],
      applId         |-> [i \in 1 .. 1 |-> 0],
      lastFragment   |-> [i \in 1 .. 1 |-> 0],
      pad7           |-> [i \in 1 .. 7 |-> 0] ]

(* Rbc Header Comp at zero, then each field in turn at the values it is checked at *)
CheckedRbcHeaderComp23 ==
    { ZeroRbcHeaderComp23 }
        \cup { [ZeroRbcHeaderComp23 EXCEPT !.sendingTime = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderComp23 EXCEPT !.applSeqNum = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderComp23 EXCEPT !.applSubId = one] : one \in Sample(4) }
        \cup { [ZeroRbcHeaderComp23 EXCEPT !.partitionId = one] : one \in Sample(2) }
        \cup { [ZeroRbcHeaderComp23 EXCEPT !.applResendFlag = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp23 EXCEPT !.applId = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp23 EXCEPT !.lastFragment = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp23 EXCEPT !.pad7 = one] : one \in Sample(7) }

(***************************************************************************)
(* Tes Execution Broadcast: 74 bytes                                       *)
(***************************************************************************)

TesExecutionBroadcast ==
    [ pad2               : Sample(2),
      rbcHeaderComp      : RbcHeaderComp23,
      transactTime       : Sample(8),
      compressionId      : Sample(8),
      marketSegmentId    : Sample(4),
      packageId          : Sample(4),
      tesExecId          : Sample(4),
      allocId            : Sample(4),
      trdType            : Sample(2),
      tradeReportType    : Sample(1),
      side               : Sample(1),
      trdRptStatus       : Sample(1),
      messageEventSource : Sample(1),
      pad2v2             : Sample(2) ]

EncodeTesExecutionBroadcast(message) ==
    message.pad2
        \o EncodeRbcHeaderComp23(message.rbcHeaderComp)
        \o message.transactTime
        \o message.compressionId
        \o message.marketSegmentId
        \o message.packageId
        \o message.tesExecId
        \o message.allocId
        \o message.trdType
        \o message.tradeReportType
        \o message.side
        \o message.trdRptStatus
        \o message.messageEventSource
        \o message.pad2v2

DecodeTesExecutionBroadcast(bytes) ==
    LET pad2 == ReadBytes(bytes, 2) IN IF ~pad2.ok THEN Fail ELSE
    LET rbcHeaderComp == DecodeRbcHeaderComp23(pad2.rest) IN IF ~rbcHeaderComp.ok THEN Fail ELSE
    LET transactTime == ReadBytes(rbcHeaderComp.rest, 8) IN IF ~transactTime.ok THEN Fail ELSE
    LET compressionId == ReadBytes(transactTime.rest, 8) IN IF ~compressionId.ok THEN Fail ELSE
    LET marketSegmentId == ReadBytes(compressionId.rest, 4) IN IF ~marketSegmentId.ok THEN Fail ELSE
    LET packageId == ReadBytes(marketSegmentId.rest, 4) IN IF ~packageId.ok THEN Fail ELSE
    LET tesExecId == ReadBytes(packageId.rest, 4) IN IF ~tesExecId.ok THEN Fail ELSE
    LET allocId == ReadBytes(tesExecId.rest, 4) IN IF ~allocId.ok THEN Fail ELSE
    LET trdType == ReadBytes(allocId.rest, 2) IN IF ~trdType.ok THEN Fail ELSE
    LET tradeReportType == ReadBytes(trdType.rest, 1) IN IF ~tradeReportType.ok THEN Fail ELSE
    LET side == ReadBytes(tradeReportType.rest, 1) IN IF ~side.ok THEN Fail ELSE
    LET trdRptStatus == ReadBytes(side.rest, 1) IN IF ~trdRptStatus.ok THEN Fail ELSE
    LET messageEventSource == ReadBytes(trdRptStatus.rest, 1) IN IF ~messageEventSource.ok THEN Fail ELSE
    LET pad2v2 == ReadBytes(messageEventSource.rest, 2) IN IF ~pad2v2.ok THEN Fail ELSE
    Ok([ pad2               |-> pad2.value,
         rbcHeaderComp      |-> rbcHeaderComp.value,
         transactTime       |-> transactTime.value,
         compressionId      |-> compressionId.value,
         marketSegmentId    |-> marketSegmentId.value,
         packageId          |-> packageId.value,
         tesExecId          |-> tesExecId.value,
         allocId            |-> allocId.value,
         trdType            |-> trdType.value,
         tradeReportType    |-> tradeReportType.value,
         side               |-> side.value,
         trdRptStatus       |-> trdRptStatus.value,
         messageEventSource |-> messageEventSource.value,
         pad2v2             |-> pad2v2.value ], pad2v2.rest)

ZeroTesExecutionBroadcast ==
    [ pad2               |-> [i \in 1 .. 2 |-> 0],
      rbcHeaderComp      |-> ZeroRbcHeaderComp23,
      transactTime       |-> [i \in 1 .. 8 |-> 0],
      compressionId      |-> [i \in 1 .. 8 |-> 0],
      marketSegmentId    |-> [i \in 1 .. 4 |-> 0],
      packageId          |-> [i \in 1 .. 4 |-> 0],
      tesExecId          |-> [i \in 1 .. 4 |-> 0],
      allocId            |-> [i \in 1 .. 4 |-> 0],
      trdType            |-> [i \in 1 .. 2 |-> 0],
      tradeReportType    |-> [i \in 1 .. 1 |-> 0],
      side               |-> [i \in 1 .. 1 |-> 0],
      trdRptStatus       |-> [i \in 1 .. 1 |-> 0],
      messageEventSource |-> [i \in 1 .. 1 |-> 0],
      pad2v2             |-> [i \in 1 .. 2 |-> 0] ]

(* Tes Execution Broadcast at zero, then each field in turn at the values it is checked at *)
CheckedTesExecutionBroadcast ==
    { ZeroTesExecutionBroadcast }
        \cup { [ZeroTesExecutionBroadcast EXCEPT !.pad2 = one] : one \in Sample(2) }
        \cup { [ZeroTesExecutionBroadcast EXCEPT !.rbcHeaderComp = one] : one \in CheckedRbcHeaderComp23 }
        \cup { [ZeroTesExecutionBroadcast EXCEPT !.transactTime = one] : one \in Sample(8) }
        \cup { [ZeroTesExecutionBroadcast EXCEPT !.compressionId = one] : one \in Sample(8) }
        \cup { [ZeroTesExecutionBroadcast EXCEPT !.marketSegmentId = one] : one \in Sample(4) }
        \cup { [ZeroTesExecutionBroadcast EXCEPT !.packageId = one] : one \in Sample(4) }
        \cup { [ZeroTesExecutionBroadcast EXCEPT !.tesExecId = one] : one \in Sample(4) }
        \cup { [ZeroTesExecutionBroadcast EXCEPT !.allocId = one] : one \in Sample(4) }
        \cup { [ZeroTesExecutionBroadcast EXCEPT !.trdType = one] : one \in Sample(2) }
        \cup { [ZeroTesExecutionBroadcast EXCEPT !.tradeReportType = one] : one \in Sample(1) }
        \cup { [ZeroTesExecutionBroadcast EXCEPT !.side = one] : one \in Sample(1) }
        \cup { [ZeroTesExecutionBroadcast EXCEPT !.trdRptStatus = one] : one \in Sample(1) }
        \cup { [ZeroTesExecutionBroadcast EXCEPT !.messageEventSource = one] : one \in Sample(1) }
        \cup { [ZeroTesExecutionBroadcast EXCEPT !.pad2v2 = one] : one \in Sample(2) }

(***************************************************************************)
(* Response Header Comp: 24 bytes                                          *)
(***************************************************************************)

ResponseHeaderComp14 ==
    [ requestTime : Sample(8),
      sendingTime : Sample(8),
      msgSeqNum   : Sample(4),
      pad4        : Sample(4) ]

EncodeResponseHeaderComp14(message) ==
    message.requestTime
        \o message.sendingTime
        \o message.msgSeqNum
        \o message.pad4

DecodeResponseHeaderComp14(bytes) ==
    LET requestTime == ReadBytes(bytes, 8) IN IF ~requestTime.ok THEN Fail ELSE
    LET sendingTime == ReadBytes(requestTime.rest, 8) IN IF ~sendingTime.ok THEN Fail ELSE
    LET msgSeqNum == ReadBytes(sendingTime.rest, 4) IN IF ~msgSeqNum.ok THEN Fail ELSE
    LET pad4 == ReadBytes(msgSeqNum.rest, 4) IN IF ~pad4.ok THEN Fail ELSE
    Ok([ requestTime |-> requestTime.value,
         sendingTime |-> sendingTime.value,
         msgSeqNum   |-> msgSeqNum.value,
         pad4        |-> pad4.value ], pad4.rest)

ZeroResponseHeaderComp14 ==
    [ requestTime |-> [i \in 1 .. 8 |-> 0],
      sendingTime |-> [i \in 1 .. 8 |-> 0],
      msgSeqNum   |-> [i \in 1 .. 4 |-> 0],
      pad4        |-> [i \in 1 .. 4 |-> 0] ]

(* Response Header Comp at zero, then each field in turn at the values it is checked at *)
CheckedResponseHeaderComp14 ==
    { ZeroResponseHeaderComp14 }
        \cup { [ZeroResponseHeaderComp14 EXCEPT !.requestTime = one] : one \in Sample(8) }
        \cup { [ZeroResponseHeaderComp14 EXCEPT !.sendingTime = one] : one \in Sample(8) }
        \cup { [ZeroResponseHeaderComp14 EXCEPT !.msgSeqNum = one] : one \in Sample(4) }
        \cup { [ZeroResponseHeaderComp14 EXCEPT !.pad4 = one] : one \in Sample(4) }

(***************************************************************************)
(* Tes Response: 50 bytes                                                  *)
(***************************************************************************)

TesResponse ==
    [ pad2               : Sample(2),
      responseHeaderComp : ResponseHeaderComp14,
      tesExecId          : Sample(4),
      tradeReportId      : Sample(20) ]

EncodeTesResponse(message) ==
    message.pad2
        \o EncodeResponseHeaderComp14(message.responseHeaderComp)
        \o message.tesExecId
        \o message.tradeReportId

DecodeTesResponse(bytes) ==
    LET pad2 == ReadBytes(bytes, 2) IN IF ~pad2.ok THEN Fail ELSE
    LET responseHeaderComp == DecodeResponseHeaderComp14(pad2.rest) IN IF ~responseHeaderComp.ok THEN Fail ELSE
    LET tesExecId == ReadBytes(responseHeaderComp.rest, 4) IN IF ~tesExecId.ok THEN Fail ELSE
    LET tradeReportId == ReadBytes(tesExecId.rest, 20) IN IF ~tradeReportId.ok THEN Fail ELSE
    Ok([ pad2               |-> pad2.value,
         responseHeaderComp |-> responseHeaderComp.value,
         tesExecId          |-> tesExecId.value,
         tradeReportId      |-> tradeReportId.value ], tradeReportId.rest)

ZeroTesResponse ==
    [ pad2               |-> [i \in 1 .. 2 |-> 0],
      responseHeaderComp |-> ZeroResponseHeaderComp14,
      tesExecId          |-> [i \in 1 .. 4 |-> 0],
      tradeReportId      |-> [i \in 1 .. 20 |-> 0] ]

(* Tes Response at zero, then each field in turn at the values it is checked at *)
CheckedTesResponse ==
    { ZeroTesResponse }
        \cup { [ZeroTesResponse EXCEPT !.pad2 = one] : one \in Sample(2) }
        \cup { [ZeroTesResponse EXCEPT !.responseHeaderComp = one] : one \in CheckedResponseHeaderComp14 }
        \cup { [ZeroTesResponse EXCEPT !.tesExecId = one] : one \in Sample(4) }
        \cup { [ZeroTesResponse EXCEPT !.tradeReportId = one] : one \in Sample(20) }

(***************************************************************************)
(* Rbc Header Comp: 32 bytes                                               *)
(***************************************************************************)

RbcHeaderComp24 ==
    [ sendingTime    : Sample(8),
      applSeqNum     : Sample(8),
      applSubId      : Sample(4),
      partitionId    : Sample(2),
      applResendFlag : Sample(1),
      applId         : Sample(1),
      lastFragment   : Sample(1),
      pad7           : Sample(7) ]

EncodeRbcHeaderComp24(message) ==
    message.sendingTime
        \o message.applSeqNum
        \o message.applSubId
        \o message.partitionId
        \o message.applResendFlag
        \o message.applId
        \o message.lastFragment
        \o message.pad7

DecodeRbcHeaderComp24(bytes) ==
    LET sendingTime == ReadBytes(bytes, 8) IN IF ~sendingTime.ok THEN Fail ELSE
    LET applSeqNum == ReadBytes(sendingTime.rest, 8) IN IF ~applSeqNum.ok THEN Fail ELSE
    LET applSubId == ReadBytes(applSeqNum.rest, 4) IN IF ~applSubId.ok THEN Fail ELSE
    LET partitionId == ReadBytes(applSubId.rest, 2) IN IF ~partitionId.ok THEN Fail ELSE
    LET applResendFlag == ReadBytes(partitionId.rest, 1) IN IF ~applResendFlag.ok THEN Fail ELSE
    LET applId == ReadBytes(applResendFlag.rest, 1) IN IF ~applId.ok THEN Fail ELSE
    LET lastFragment == ReadBytes(applId.rest, 1) IN IF ~lastFragment.ok THEN Fail ELSE
    LET pad7 == ReadBytes(lastFragment.rest, 7) IN IF ~pad7.ok THEN Fail ELSE
    Ok([ sendingTime    |-> sendingTime.value,
         applSeqNum     |-> applSeqNum.value,
         applSubId      |-> applSubId.value,
         partitionId    |-> partitionId.value,
         applResendFlag |-> applResendFlag.value,
         applId         |-> applId.value,
         lastFragment   |-> lastFragment.value,
         pad7           |-> pad7.value ], pad7.rest)

ZeroRbcHeaderComp24 ==
    [ sendingTime    |-> [i \in 1 .. 8 |-> 0],
      applSeqNum     |-> [i \in 1 .. 8 |-> 0],
      applSubId      |-> [i \in 1 .. 4 |-> 0],
      partitionId    |-> [i \in 1 .. 2 |-> 0],
      applResendFlag |-> [i \in 1 .. 1 |-> 0],
      applId         |-> [i \in 1 .. 1 |-> 0],
      lastFragment   |-> [i \in 1 .. 1 |-> 0],
      pad7           |-> [i \in 1 .. 7 |-> 0] ]

(* Rbc Header Comp at zero, then each field in turn at the values it is checked at *)
CheckedRbcHeaderComp24 ==
    { ZeroRbcHeaderComp24 }
        \cup { [ZeroRbcHeaderComp24 EXCEPT !.sendingTime = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderComp24 EXCEPT !.applSeqNum = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderComp24 EXCEPT !.applSubId = one] : one \in Sample(4) }
        \cup { [ZeroRbcHeaderComp24 EXCEPT !.partitionId = one] : one \in Sample(2) }
        \cup { [ZeroRbcHeaderComp24 EXCEPT !.applResendFlag = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp24 EXCEPT !.applId = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp24 EXCEPT !.lastFragment = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp24 EXCEPT !.pad7 = one] : one \in Sample(7) }

(***************************************************************************)
(* Side Alloc Grp Bc Comp: 40 bytes                                        *)
(***************************************************************************)

SideAllocGrpBcComp2 ==
    [ allocQty             : Sample(8),
      reversalApprovalTime : Sample(8),
      individualAllocId    : Sample(4),
      tesEnrichmentRuleId  : Sample(4),
      partyExecutingFirm   : Sample(5),
      partyExecutingTrader : Sample(6),
      side                 : Sample(1),
      tradeAllocStatus     : Sample(1),
      pad3                 : Sample(3) ]

EncodeSideAllocGrpBcComp2(message) ==
    message.allocQty
        \o message.reversalApprovalTime
        \o message.individualAllocId
        \o message.tesEnrichmentRuleId
        \o message.partyExecutingFirm
        \o message.partyExecutingTrader
        \o message.side
        \o message.tradeAllocStatus
        \o message.pad3

DecodeSideAllocGrpBcComp2(bytes) ==
    LET allocQty == ReadBytes(bytes, 8) IN IF ~allocQty.ok THEN Fail ELSE
    LET reversalApprovalTime == ReadBytes(allocQty.rest, 8) IN IF ~reversalApprovalTime.ok THEN Fail ELSE
    LET individualAllocId == ReadBytes(reversalApprovalTime.rest, 4) IN IF ~individualAllocId.ok THEN Fail ELSE
    LET tesEnrichmentRuleId == ReadBytes(individualAllocId.rest, 4) IN IF ~tesEnrichmentRuleId.ok THEN Fail ELSE
    LET partyExecutingFirm == ReadBytes(tesEnrichmentRuleId.rest, 5) IN IF ~partyExecutingFirm.ok THEN Fail ELSE
    LET partyExecutingTrader == ReadBytes(partyExecutingFirm.rest, 6) IN IF ~partyExecutingTrader.ok THEN Fail ELSE
    LET side == ReadBytes(partyExecutingTrader.rest, 1) IN IF ~side.ok THEN Fail ELSE
    LET tradeAllocStatus == ReadBytes(side.rest, 1) IN IF ~tradeAllocStatus.ok THEN Fail ELSE
    LET pad3 == ReadBytes(tradeAllocStatus.rest, 3) IN IF ~pad3.ok THEN Fail ELSE
    Ok([ allocQty             |-> allocQty.value,
         reversalApprovalTime |-> reversalApprovalTime.value,
         individualAllocId    |-> individualAllocId.value,
         tesEnrichmentRuleId  |-> tesEnrichmentRuleId.value,
         partyExecutingFirm   |-> partyExecutingFirm.value,
         partyExecutingTrader |-> partyExecutingTrader.value,
         side                 |-> side.value,
         tradeAllocStatus     |-> tradeAllocStatus.value,
         pad3                 |-> pad3.value ], pad3.rest)

ZeroSideAllocGrpBcComp2 ==
    [ allocQty             |-> [i \in 1 .. 8 |-> 0],
      reversalApprovalTime |-> [i \in 1 .. 8 |-> 0],
      individualAllocId    |-> [i \in 1 .. 4 |-> 0],
      tesEnrichmentRuleId  |-> [i \in 1 .. 4 |-> 0],
      partyExecutingFirm   |-> [i \in 1 .. 5 |-> 0],
      partyExecutingTrader |-> [i \in 1 .. 6 |-> 0],
      side                 |-> [i \in 1 .. 1 |-> 0],
      tradeAllocStatus     |-> [i \in 1 .. 1 |-> 0],
      pad3                 |-> [i \in 1 .. 3 |-> 0] ]

(* Side Alloc Grp Bc Comp at zero, then each field in turn at the values it is checked at *)
CheckedSideAllocGrpBcComp2 ==
    { ZeroSideAllocGrpBcComp2 }
        \cup { [ZeroSideAllocGrpBcComp2 EXCEPT !.allocQty = one] : one \in Sample(8) }
        \cup { [ZeroSideAllocGrpBcComp2 EXCEPT !.reversalApprovalTime = one] : one \in Sample(8) }
        \cup { [ZeroSideAllocGrpBcComp2 EXCEPT !.individualAllocId = one] : one \in Sample(4) }
        \cup { [ZeroSideAllocGrpBcComp2 EXCEPT !.tesEnrichmentRuleId = one] : one \in Sample(4) }
        \cup { [ZeroSideAllocGrpBcComp2 EXCEPT !.partyExecutingFirm = one] : one \in Sample(5) }
        \cup { [ZeroSideAllocGrpBcComp2 EXCEPT !.partyExecutingTrader = one] : one \in Sample(6) }
        \cup { [ZeroSideAllocGrpBcComp2 EXCEPT !.side = one] : one \in Sample(1) }
        \cup { [ZeroSideAllocGrpBcComp2 EXCEPT !.tradeAllocStatus = one] : one \in Sample(1) }
        \cup { [ZeroSideAllocGrpBcComp2 EXCEPT !.pad3 = one] : one \in Sample(3) }

(* A run of Side Alloc Grp Bc Comp, written one after another *)
RECURSIVE EncodeSideAllocGrpBcComp2List(_)
EncodeSideAllocGrpBcComp2List(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeSideAllocGrpBcComp2(Head(messages)) \o EncodeSideAllocGrpBcComp2List(Tail(messages))

(* As many Side Alloc Grp Bc Comp as the field that counts them says *)
RECURSIVE ReadSideAllocGrpBcComp2List(_, _)
ReadSideAllocGrpBcComp2List(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeSideAllocGrpBcComp2(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadSideAllocGrpBcComp2List(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Side Alloc Grp Bc Comp of each kind, for the lists that carry them *)
OneSideAllocGrpBcComp2 == { ZeroSideAllocGrpBcComp2 }

(***************************************************************************)
(* Tes Reversal Broadcast                                                  *)
(***************************************************************************)

TesReversalBroadcast ==
    [ pad2                       : Sample(2),
      rbcHeaderComp              : RbcHeaderComp24,
      reversalInitiationTime     : Sample(8),
      marketSegmentId            : Sample(4),
      packageId                  : Sample(4),
      tesExecId                  : Sample(4),
      relatedMarketSegmentId     : Sample(4),
      trdType                    : Sample(2),
      trdRptStatus               : Sample(1),
      reversalCancellationReason : Sample(1),
      tradeReportId              : Sample(20),
      reversalReasonText         : Sample(132),
      pad3                       : Sample(3),
      sideAllocGrpBcComp         : SampleLists(OneSideAllocGrpBcComp2) ]

EncodeTesReversalBroadcast(message) ==
    message.pad2
        \o EncodeRbcHeaderComp24(message.rbcHeaderComp)
        \o message.reversalInitiationTime
        \o message.marketSegmentId
        \o message.packageId
        \o message.tesExecId
        \o message.relatedMarketSegmentId
        \o message.trdType
        \o message.trdRptStatus
        \o message.reversalCancellationReason
        \o EncodeUIntBE(Len(message.sideAllocGrpBcComp), 1)
        \o message.tradeReportId
        \o message.reversalReasonText
        \o message.pad3
        \o EncodeSideAllocGrpBcComp2List(message.sideAllocGrpBcComp)

DecodeTesReversalBroadcast(bytes) ==
    LET pad2 == ReadBytes(bytes, 2) IN IF ~pad2.ok THEN Fail ELSE
    LET rbcHeaderComp == DecodeRbcHeaderComp24(pad2.rest) IN IF ~rbcHeaderComp.ok THEN Fail ELSE
    LET reversalInitiationTime == ReadBytes(rbcHeaderComp.rest, 8) IN IF ~reversalInitiationTime.ok THEN Fail ELSE
    LET marketSegmentId == ReadBytes(reversalInitiationTime.rest, 4) IN IF ~marketSegmentId.ok THEN Fail ELSE
    LET packageId == ReadBytes(marketSegmentId.rest, 4) IN IF ~packageId.ok THEN Fail ELSE
    LET tesExecId == ReadBytes(packageId.rest, 4) IN IF ~tesExecId.ok THEN Fail ELSE
    LET relatedMarketSegmentId == ReadBytes(tesExecId.rest, 4) IN IF ~relatedMarketSegmentId.ok THEN Fail ELSE
    LET trdType == ReadBytes(relatedMarketSegmentId.rest, 2) IN IF ~trdType.ok THEN Fail ELSE
    LET trdRptStatus == ReadBytes(trdType.rest, 1) IN IF ~trdRptStatus.ok THEN Fail ELSE
    LET reversalCancellationReason == ReadBytes(trdRptStatus.rest, 1) IN IF ~reversalCancellationReason.ok THEN Fail ELSE
    LET noSideAllocs == ReadUIntBE(reversalCancellationReason.rest, 1) IN IF ~noSideAllocs.ok THEN Fail ELSE
    LET tradeReportId == ReadBytes(noSideAllocs.rest, 20) IN IF ~tradeReportId.ok THEN Fail ELSE
    LET reversalReasonText == ReadBytes(tradeReportId.rest, 132) IN IF ~reversalReasonText.ok THEN Fail ELSE
    LET pad3 == ReadBytes(reversalReasonText.rest, 3) IN IF ~pad3.ok THEN Fail ELSE
    LET sideAllocGrpBcComp == ReadSideAllocGrpBcComp2List(pad3.rest, noSideAllocs.value) IN IF ~sideAllocGrpBcComp.ok THEN Fail ELSE
    Ok([ pad2                       |-> pad2.value,
         rbcHeaderComp              |-> rbcHeaderComp.value,
         reversalInitiationTime     |-> reversalInitiationTime.value,
         marketSegmentId            |-> marketSegmentId.value,
         packageId                  |-> packageId.value,
         tesExecId                  |-> tesExecId.value,
         relatedMarketSegmentId     |-> relatedMarketSegmentId.value,
         trdType                    |-> trdType.value,
         trdRptStatus               |-> trdRptStatus.value,
         reversalCancellationReason |-> reversalCancellationReason.value,
         tradeReportId              |-> tradeReportId.value,
         reversalReasonText         |-> reversalReasonText.value,
         pad3                       |-> pad3.value,
         sideAllocGrpBcComp         |-> sideAllocGrpBcComp.value ], sideAllocGrpBcComp.rest)

ZeroTesReversalBroadcast ==
    [ pad2                       |-> [i \in 1 .. 2 |-> 0],
      rbcHeaderComp              |-> ZeroRbcHeaderComp24,
      reversalInitiationTime     |-> [i \in 1 .. 8 |-> 0],
      marketSegmentId            |-> [i \in 1 .. 4 |-> 0],
      packageId                  |-> [i \in 1 .. 4 |-> 0],
      tesExecId                  |-> [i \in 1 .. 4 |-> 0],
      relatedMarketSegmentId     |-> [i \in 1 .. 4 |-> 0],
      trdType                    |-> [i \in 1 .. 2 |-> 0],
      trdRptStatus               |-> [i \in 1 .. 1 |-> 0],
      reversalCancellationReason |-> [i \in 1 .. 1 |-> 0],
      tradeReportId              |-> [i \in 1 .. 20 |-> 0],
      reversalReasonText         |-> [i \in 1 .. 132 |-> 0],
      pad3                       |-> [i \in 1 .. 3 |-> 0],
      sideAllocGrpBcComp         |-> << >> ]

(* Tes Reversal Broadcast at zero, then each field in turn at the values it is checked at *)
CheckedTesReversalBroadcast ==
    { ZeroTesReversalBroadcast }
        \cup { [ZeroTesReversalBroadcast EXCEPT !.pad2 = one] : one \in Sample(2) }
        \cup { [ZeroTesReversalBroadcast EXCEPT !.rbcHeaderComp = one] : one \in CheckedRbcHeaderComp24 }
        \cup { [ZeroTesReversalBroadcast EXCEPT !.reversalInitiationTime = one] : one \in Sample(8) }
        \cup { [ZeroTesReversalBroadcast EXCEPT !.marketSegmentId = one] : one \in Sample(4) }
        \cup { [ZeroTesReversalBroadcast EXCEPT !.packageId = one] : one \in Sample(4) }
        \cup { [ZeroTesReversalBroadcast EXCEPT !.tesExecId = one] : one \in Sample(4) }
        \cup { [ZeroTesReversalBroadcast EXCEPT !.relatedMarketSegmentId = one] : one \in Sample(4) }
        \cup { [ZeroTesReversalBroadcast EXCEPT !.trdType = one] : one \in Sample(2) }
        \cup { [ZeroTesReversalBroadcast EXCEPT !.trdRptStatus = one] : one \in Sample(1) }
        \cup { [ZeroTesReversalBroadcast EXCEPT !.reversalCancellationReason = one] : one \in Sample(1) }
        \cup { [ZeroTesReversalBroadcast EXCEPT !.tradeReportId = one] : one \in Sample(20) }
        \cup { [ZeroTesReversalBroadcast EXCEPT !.reversalReasonText = one] : one \in Sample(132) }
        \cup { [ZeroTesReversalBroadcast EXCEPT !.pad3 = one] : one \in Sample(3) }
        \cup { [ZeroTesReversalBroadcast EXCEPT !.sideAllocGrpBcComp = one] : one \in SampleLists(OneSideAllocGrpBcComp2) }

(***************************************************************************)
(* Rbc Header Comp: 32 bytes                                               *)
(***************************************************************************)

RbcHeaderComp25 ==
    [ sendingTime    : Sample(8),
      applSeqNum     : Sample(8),
      applSubId      : Sample(4),
      partitionId    : Sample(2),
      applResendFlag : Sample(1),
      applId         : Sample(1),
      lastFragment   : Sample(1),
      pad7           : Sample(7) ]

EncodeRbcHeaderComp25(message) ==
    message.sendingTime
        \o message.applSeqNum
        \o message.applSubId
        \o message.partitionId
        \o message.applResendFlag
        \o message.applId
        \o message.lastFragment
        \o message.pad7

DecodeRbcHeaderComp25(bytes) ==
    LET sendingTime == ReadBytes(bytes, 8) IN IF ~sendingTime.ok THEN Fail ELSE
    LET applSeqNum == ReadBytes(sendingTime.rest, 8) IN IF ~applSeqNum.ok THEN Fail ELSE
    LET applSubId == ReadBytes(applSeqNum.rest, 4) IN IF ~applSubId.ok THEN Fail ELSE
    LET partitionId == ReadBytes(applSubId.rest, 2) IN IF ~partitionId.ok THEN Fail ELSE
    LET applResendFlag == ReadBytes(partitionId.rest, 1) IN IF ~applResendFlag.ok THEN Fail ELSE
    LET applId == ReadBytes(applResendFlag.rest, 1) IN IF ~applId.ok THEN Fail ELSE
    LET lastFragment == ReadBytes(applId.rest, 1) IN IF ~lastFragment.ok THEN Fail ELSE
    LET pad7 == ReadBytes(lastFragment.rest, 7) IN IF ~pad7.ok THEN Fail ELSE
    Ok([ sendingTime    |-> sendingTime.value,
         applSeqNum     |-> applSeqNum.value,
         applSubId      |-> applSubId.value,
         partitionId    |-> partitionId.value,
         applResendFlag |-> applResendFlag.value,
         applId         |-> applId.value,
         lastFragment   |-> lastFragment.value,
         pad7           |-> pad7.value ], pad7.rest)

ZeroRbcHeaderComp25 ==
    [ sendingTime    |-> [i \in 1 .. 8 |-> 0],
      applSeqNum     |-> [i \in 1 .. 8 |-> 0],
      applSubId      |-> [i \in 1 .. 4 |-> 0],
      partitionId    |-> [i \in 1 .. 2 |-> 0],
      applResendFlag |-> [i \in 1 .. 1 |-> 0],
      applId         |-> [i \in 1 .. 1 |-> 0],
      lastFragment   |-> [i \in 1 .. 1 |-> 0],
      pad7           |-> [i \in 1 .. 7 |-> 0] ]

(* Rbc Header Comp at zero, then each field in turn at the values it is checked at *)
CheckedRbcHeaderComp25 ==
    { ZeroRbcHeaderComp25 }
        \cup { [ZeroRbcHeaderComp25 EXCEPT !.sendingTime = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderComp25 EXCEPT !.applSeqNum = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderComp25 EXCEPT !.applSubId = one] : one \in Sample(4) }
        \cup { [ZeroRbcHeaderComp25 EXCEPT !.partitionId = one] : one \in Sample(2) }
        \cup { [ZeroRbcHeaderComp25 EXCEPT !.applResendFlag = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp25 EXCEPT !.applId = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp25 EXCEPT !.lastFragment = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp25 EXCEPT !.pad7 = one] : one \in Sample(7) }

(***************************************************************************)
(* Srqs Related Trade Id Grp Comp: 8 bytes                                 *)
(***************************************************************************)

SrqsRelatedTradeIdGrpComp ==
    [ srqsRelatedTradeId : Sample(4),
      pad4               : Sample(4) ]

EncodeSrqsRelatedTradeIdGrpComp(message) ==
    message.srqsRelatedTradeId
        \o message.pad4

DecodeSrqsRelatedTradeIdGrpComp(bytes) ==
    LET srqsRelatedTradeId == ReadBytes(bytes, 4) IN IF ~srqsRelatedTradeId.ok THEN Fail ELSE
    LET pad4 == ReadBytes(srqsRelatedTradeId.rest, 4) IN IF ~pad4.ok THEN Fail ELSE
    Ok([ srqsRelatedTradeId |-> srqsRelatedTradeId.value,
         pad4               |-> pad4.value ], pad4.rest)

ZeroSrqsRelatedTradeIdGrpComp ==
    [ srqsRelatedTradeId |-> [i \in 1 .. 4 |-> 0],
      pad4               |-> [i \in 1 .. 4 |-> 0] ]

(* Srqs Related Trade Id Grp Comp at zero, then each field in turn at the values it is checked at *)
CheckedSrqsRelatedTradeIdGrpComp ==
    { ZeroSrqsRelatedTradeIdGrpComp }
        \cup { [ZeroSrqsRelatedTradeIdGrpComp EXCEPT !.srqsRelatedTradeId = one] : one \in Sample(4) }
        \cup { [ZeroSrqsRelatedTradeIdGrpComp EXCEPT !.pad4 = one] : one \in Sample(4) }

(* A run of Srqs Related Trade Id Grp Comp, written one after another *)
RECURSIVE EncodeSrqsRelatedTradeIdGrpCompList(_)
EncodeSrqsRelatedTradeIdGrpCompList(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeSrqsRelatedTradeIdGrpComp(Head(messages)) \o EncodeSrqsRelatedTradeIdGrpCompList(Tail(messages))

(* As many Srqs Related Trade Id Grp Comp as the field that counts them says *)
RECURSIVE ReadSrqsRelatedTradeIdGrpCompList(_, _)
ReadSrqsRelatedTradeIdGrpCompList(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeSrqsRelatedTradeIdGrpComp(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadSrqsRelatedTradeIdGrpCompList(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Srqs Related Trade Id Grp Comp of each kind, for the lists that carry them *)
OneSrqsRelatedTradeIdGrpComp == { ZeroSrqsRelatedTradeIdGrpComp }

(***************************************************************************)
(* Tes Trade Broadcast                                                     *)
(***************************************************************************)

TesTradeBroadcast ==
    [ pad2                                        : Sample(2),
      rbcHeaderComp                               : RbcHeaderComp25,
      securityId                                  : Sample(8),
      lastPx                                      : Sample(8),
      lastQty                                     : Sample(8),
      clearingTradePrice                          : Sample(8),
      clearingTradeQty                            : Sample(8),
      transactTime                                : Sample(8),
      relatedSecurityId                           : Sample(8),
      compressionId                               : Sample(8),
      rootPartyIdClientId                         : Sample(8),
      executingTrader                             : Sample(8),
      rootPartyIdInvestmentDecisionMaker          : Sample(8),
      basketTrdMatchId                            : Sample(8),
      sideLastPx                                  : Sample(8),
      sideLastQty                                 : Sample(8),
      packageId                                   : Sample(4),
      marketSegmentId                             : Sample(4),
      tradeId                                     : Sample(4),
      tradeDate                                   : Sample(4),
      sideTradeId                                 : Sample(4),
      rootPartyIdSessionId                        : Sample(4),
      origTradeId                                 : Sample(4),
      rootPartyIdExecutingUnit                    : Sample(4),
      rootPartyIdExecutingTrader                  : Sample(4),
      rootPartyIdClearingUnit                     : Sample(4),
      strategyLinkId                              : Sample(4),
      relatedSymbol                               : Sample(4),
      totNumTradeReports                          : Sample(4),
      negotiationId                               : Sample(4),
      pad3v1                                      : Sample(3),
      basketProfileId                             : Sample(4),
      trdType                                     : Sample(2),
      productComplex                              : Sample(1),
      relatedProductComplex                       : Sample(1),
      side                                        : Sample(1),
      tradingCapacity                             : Sample(1),
      tradeReportType                             : Sample(1),
      transferReason                              : Sample(1),
      tradePublishIndicator                       : Sample(1),
      multiLegReportingType                       : Sample(1),
      positionEffect                              : Sample(1),
      multilegPriceModel                          : Sample(1),
      orderAttributeLiquidityProvision            : Sample(1),
      orderAttributeRiskReduction                 : Sample(1),
      executingTraderQualifier                    : Sample(1),
      rootPartyIdInvestmentDecisionMakerQualifier : Sample(1),
      orderOrigination                            : Sample(1),
      reversalIndicator                           : Sample(1),
      account                                     : Sample(2),
      rootPartyIdPositionAccount                  : Sample(32),
      custOrderHandlingInst                       : Sample(1),
      freeText1                                   : Sample(12),
      freeText2                                   : Sample(12),
      freeText3                                   : Sample(12),
      rootPartyExecutingFirm                      : Sample(5),
      rootPartyExecutingTrader                    : Sample(6),
      rootPartyClearingFirm                       : Sample(5),
      rootPartyClearingOrganization               : Sample(4),
      rootPartyIdBeneficiary                      : Sample(9),
      rootPartyIdTakeUpTradingFirm                : Sample(5),
      rootPartyIdOrderOriginationFirm             : Sample(7),
      rootPartyIdExecutionVenue                   : Sample(4),
      regulatoryTradeId                           : Sample(52),
      basketPartyContraFirm                       : Sample(5),
      basketSideTradeReportId                     : Sample(20),
      pad5                                        : Sample(5),
      srqsRelatedTradeIdGrpComp                   : SampleLists(OneSrqsRelatedTradeIdGrpComp) ]

EncodeTesTradeBroadcast(message) ==
    message.pad2
        \o EncodeRbcHeaderComp25(message.rbcHeaderComp)
        \o message.securityId
        \o message.lastPx
        \o message.lastQty
        \o message.clearingTradePrice
        \o message.clearingTradeQty
        \o message.transactTime
        \o message.relatedSecurityId
        \o message.compressionId
        \o message.rootPartyIdClientId
        \o message.executingTrader
        \o message.rootPartyIdInvestmentDecisionMaker
        \o message.basketTrdMatchId
        \o message.sideLastPx
        \o message.sideLastQty
        \o message.packageId
        \o message.marketSegmentId
        \o message.tradeId
        \o message.tradeDate
        \o message.sideTradeId
        \o message.rootPartyIdSessionId
        \o message.origTradeId
        \o message.rootPartyIdExecutingUnit
        \o message.rootPartyIdExecutingTrader
        \o message.rootPartyIdClearingUnit
        \o message.strategyLinkId
        \o message.relatedSymbol
        \o message.totNumTradeReports
        \o message.negotiationId
        \o EncodeUIntBE(Len(message.srqsRelatedTradeIdGrpComp), 1)
        \o message.pad3v1
        \o message.basketProfileId
        \o message.trdType
        \o message.productComplex
        \o message.relatedProductComplex
        \o message.side
        \o message.tradingCapacity
        \o message.tradeReportType
        \o message.transferReason
        \o message.tradePublishIndicator
        \o message.multiLegReportingType
        \o message.positionEffect
        \o message.multilegPriceModel
        \o message.orderAttributeLiquidityProvision
        \o message.orderAttributeRiskReduction
        \o message.executingTraderQualifier
        \o message.rootPartyIdInvestmentDecisionMakerQualifier
        \o message.orderOrigination
        \o message.reversalIndicator
        \o message.account
        \o message.rootPartyIdPositionAccount
        \o message.custOrderHandlingInst
        \o message.freeText1
        \o message.freeText2
        \o message.freeText3
        \o message.rootPartyExecutingFirm
        \o message.rootPartyExecutingTrader
        \o message.rootPartyClearingFirm
        \o message.rootPartyClearingOrganization
        \o message.rootPartyIdBeneficiary
        \o message.rootPartyIdTakeUpTradingFirm
        \o message.rootPartyIdOrderOriginationFirm
        \o message.rootPartyIdExecutionVenue
        \o message.regulatoryTradeId
        \o message.basketPartyContraFirm
        \o message.basketSideTradeReportId
        \o message.pad5
        \o EncodeSrqsRelatedTradeIdGrpCompList(message.srqsRelatedTradeIdGrpComp)

DecodeTesTradeBroadcast(bytes) ==
    LET pad2 == ReadBytes(bytes, 2) IN IF ~pad2.ok THEN Fail ELSE
    LET rbcHeaderComp == DecodeRbcHeaderComp25(pad2.rest) IN IF ~rbcHeaderComp.ok THEN Fail ELSE
    LET securityId == ReadBytes(rbcHeaderComp.rest, 8) IN IF ~securityId.ok THEN Fail ELSE
    LET lastPx == ReadBytes(securityId.rest, 8) IN IF ~lastPx.ok THEN Fail ELSE
    LET lastQty == ReadBytes(lastPx.rest, 8) IN IF ~lastQty.ok THEN Fail ELSE
    LET clearingTradePrice == ReadBytes(lastQty.rest, 8) IN IF ~clearingTradePrice.ok THEN Fail ELSE
    LET clearingTradeQty == ReadBytes(clearingTradePrice.rest, 8) IN IF ~clearingTradeQty.ok THEN Fail ELSE
    LET transactTime == ReadBytes(clearingTradeQty.rest, 8) IN IF ~transactTime.ok THEN Fail ELSE
    LET relatedSecurityId == ReadBytes(transactTime.rest, 8) IN IF ~relatedSecurityId.ok THEN Fail ELSE
    LET compressionId == ReadBytes(relatedSecurityId.rest, 8) IN IF ~compressionId.ok THEN Fail ELSE
    LET rootPartyIdClientId == ReadBytes(compressionId.rest, 8) IN IF ~rootPartyIdClientId.ok THEN Fail ELSE
    LET executingTrader == ReadBytes(rootPartyIdClientId.rest, 8) IN IF ~executingTrader.ok THEN Fail ELSE
    LET rootPartyIdInvestmentDecisionMaker == ReadBytes(executingTrader.rest, 8) IN IF ~rootPartyIdInvestmentDecisionMaker.ok THEN Fail ELSE
    LET basketTrdMatchId == ReadBytes(rootPartyIdInvestmentDecisionMaker.rest, 8) IN IF ~basketTrdMatchId.ok THEN Fail ELSE
    LET sideLastPx == ReadBytes(basketTrdMatchId.rest, 8) IN IF ~sideLastPx.ok THEN Fail ELSE
    LET sideLastQty == ReadBytes(sideLastPx.rest, 8) IN IF ~sideLastQty.ok THEN Fail ELSE
    LET packageId == ReadBytes(sideLastQty.rest, 4) IN IF ~packageId.ok THEN Fail ELSE
    LET marketSegmentId == ReadBytes(packageId.rest, 4) IN IF ~marketSegmentId.ok THEN Fail ELSE
    LET tradeId == ReadBytes(marketSegmentId.rest, 4) IN IF ~tradeId.ok THEN Fail ELSE
    LET tradeDate == ReadBytes(tradeId.rest, 4) IN IF ~tradeDate.ok THEN Fail ELSE
    LET sideTradeId == ReadBytes(tradeDate.rest, 4) IN IF ~sideTradeId.ok THEN Fail ELSE
    LET rootPartyIdSessionId == ReadBytes(sideTradeId.rest, 4) IN IF ~rootPartyIdSessionId.ok THEN Fail ELSE
    LET origTradeId == ReadBytes(rootPartyIdSessionId.rest, 4) IN IF ~origTradeId.ok THEN Fail ELSE
    LET rootPartyIdExecutingUnit == ReadBytes(origTradeId.rest, 4) IN IF ~rootPartyIdExecutingUnit.ok THEN Fail ELSE
    LET rootPartyIdExecutingTrader == ReadBytes(rootPartyIdExecutingUnit.rest, 4) IN IF ~rootPartyIdExecutingTrader.ok THEN Fail ELSE
    LET rootPartyIdClearingUnit == ReadBytes(rootPartyIdExecutingTrader.rest, 4) IN IF ~rootPartyIdClearingUnit.ok THEN Fail ELSE
    LET strategyLinkId == ReadBytes(rootPartyIdClearingUnit.rest, 4) IN IF ~strategyLinkId.ok THEN Fail ELSE
    LET relatedSymbol == ReadBytes(strategyLinkId.rest, 4) IN IF ~relatedSymbol.ok THEN Fail ELSE
    LET totNumTradeReports == ReadBytes(relatedSymbol.rest, 4) IN IF ~totNumTradeReports.ok THEN Fail ELSE
    LET negotiationId == ReadBytes(totNumTradeReports.rest, 4) IN IF ~negotiationId.ok THEN Fail ELSE
    LET noSrqsRelatedTradeIDs == ReadUIntBE(negotiationId.rest, 1) IN IF ~noSrqsRelatedTradeIDs.ok THEN Fail ELSE
    LET pad3v1 == ReadBytes(noSrqsRelatedTradeIDs.rest, 3) IN IF ~pad3v1.ok THEN Fail ELSE
    LET basketProfileId == ReadBytes(pad3v1.rest, 4) IN IF ~basketProfileId.ok THEN Fail ELSE
    LET trdType == ReadBytes(basketProfileId.rest, 2) IN IF ~trdType.ok THEN Fail ELSE
    LET productComplex == ReadBytes(trdType.rest, 1) IN IF ~productComplex.ok THEN Fail ELSE
    LET relatedProductComplex == ReadBytes(productComplex.rest, 1) IN IF ~relatedProductComplex.ok THEN Fail ELSE
    LET side == ReadBytes(relatedProductComplex.rest, 1) IN IF ~side.ok THEN Fail ELSE
    LET tradingCapacity == ReadBytes(side.rest, 1) IN IF ~tradingCapacity.ok THEN Fail ELSE
    LET tradeReportType == ReadBytes(tradingCapacity.rest, 1) IN IF ~tradeReportType.ok THEN Fail ELSE
    LET transferReason == ReadBytes(tradeReportType.rest, 1) IN IF ~transferReason.ok THEN Fail ELSE
    LET tradePublishIndicator == ReadBytes(transferReason.rest, 1) IN IF ~tradePublishIndicator.ok THEN Fail ELSE
    LET multiLegReportingType == ReadBytes(tradePublishIndicator.rest, 1) IN IF ~multiLegReportingType.ok THEN Fail ELSE
    LET positionEffect == ReadBytes(multiLegReportingType.rest, 1) IN IF ~positionEffect.ok THEN Fail ELSE
    LET multilegPriceModel == ReadBytes(positionEffect.rest, 1) IN IF ~multilegPriceModel.ok THEN Fail ELSE
    LET orderAttributeLiquidityProvision == ReadBytes(multilegPriceModel.rest, 1) IN IF ~orderAttributeLiquidityProvision.ok THEN Fail ELSE
    LET orderAttributeRiskReduction == ReadBytes(orderAttributeLiquidityProvision.rest, 1) IN IF ~orderAttributeRiskReduction.ok THEN Fail ELSE
    LET executingTraderQualifier == ReadBytes(orderAttributeRiskReduction.rest, 1) IN IF ~executingTraderQualifier.ok THEN Fail ELSE
    LET rootPartyIdInvestmentDecisionMakerQualifier == ReadBytes(executingTraderQualifier.rest, 1) IN IF ~rootPartyIdInvestmentDecisionMakerQualifier.ok THEN Fail ELSE
    LET orderOrigination == ReadBytes(rootPartyIdInvestmentDecisionMakerQualifier.rest, 1) IN IF ~orderOrigination.ok THEN Fail ELSE
    LET reversalIndicator == ReadBytes(orderOrigination.rest, 1) IN IF ~reversalIndicator.ok THEN Fail ELSE
    LET account == ReadBytes(reversalIndicator.rest, 2) IN IF ~account.ok THEN Fail ELSE
    LET rootPartyIdPositionAccount == ReadBytes(account.rest, 32) IN IF ~rootPartyIdPositionAccount.ok THEN Fail ELSE
    LET custOrderHandlingInst == ReadBytes(rootPartyIdPositionAccount.rest, 1) IN IF ~custOrderHandlingInst.ok THEN Fail ELSE
    LET freeText1 == ReadBytes(custOrderHandlingInst.rest, 12) IN IF ~freeText1.ok THEN Fail ELSE
    LET freeText2 == ReadBytes(freeText1.rest, 12) IN IF ~freeText2.ok THEN Fail ELSE
    LET freeText3 == ReadBytes(freeText2.rest, 12) IN IF ~freeText3.ok THEN Fail ELSE
    LET rootPartyExecutingFirm == ReadBytes(freeText3.rest, 5) IN IF ~rootPartyExecutingFirm.ok THEN Fail ELSE
    LET rootPartyExecutingTrader == ReadBytes(rootPartyExecutingFirm.rest, 6) IN IF ~rootPartyExecutingTrader.ok THEN Fail ELSE
    LET rootPartyClearingFirm == ReadBytes(rootPartyExecutingTrader.rest, 5) IN IF ~rootPartyClearingFirm.ok THEN Fail ELSE
    LET rootPartyClearingOrganization == ReadBytes(rootPartyClearingFirm.rest, 4) IN IF ~rootPartyClearingOrganization.ok THEN Fail ELSE
    LET rootPartyIdBeneficiary == ReadBytes(rootPartyClearingOrganization.rest, 9) IN IF ~rootPartyIdBeneficiary.ok THEN Fail ELSE
    LET rootPartyIdTakeUpTradingFirm == ReadBytes(rootPartyIdBeneficiary.rest, 5) IN IF ~rootPartyIdTakeUpTradingFirm.ok THEN Fail ELSE
    LET rootPartyIdOrderOriginationFirm == ReadBytes(rootPartyIdTakeUpTradingFirm.rest, 7) IN IF ~rootPartyIdOrderOriginationFirm.ok THEN Fail ELSE
    LET rootPartyIdExecutionVenue == ReadBytes(rootPartyIdOrderOriginationFirm.rest, 4) IN IF ~rootPartyIdExecutionVenue.ok THEN Fail ELSE
    LET regulatoryTradeId == ReadBytes(rootPartyIdExecutionVenue.rest, 52) IN IF ~regulatoryTradeId.ok THEN Fail ELSE
    LET basketPartyContraFirm == ReadBytes(regulatoryTradeId.rest, 5) IN IF ~basketPartyContraFirm.ok THEN Fail ELSE
    LET basketSideTradeReportId == ReadBytes(basketPartyContraFirm.rest, 20) IN IF ~basketSideTradeReportId.ok THEN Fail ELSE
    LET pad5 == ReadBytes(basketSideTradeReportId.rest, 5) IN IF ~pad5.ok THEN Fail ELSE
    LET srqsRelatedTradeIdGrpComp == ReadSrqsRelatedTradeIdGrpCompList(pad5.rest, noSrqsRelatedTradeIDs.value) IN IF ~srqsRelatedTradeIdGrpComp.ok THEN Fail ELSE
    Ok([ pad2                                        |-> pad2.value,
         rbcHeaderComp                               |-> rbcHeaderComp.value,
         securityId                                  |-> securityId.value,
         lastPx                                      |-> lastPx.value,
         lastQty                                     |-> lastQty.value,
         clearingTradePrice                          |-> clearingTradePrice.value,
         clearingTradeQty                            |-> clearingTradeQty.value,
         transactTime                                |-> transactTime.value,
         relatedSecurityId                           |-> relatedSecurityId.value,
         compressionId                               |-> compressionId.value,
         rootPartyIdClientId                         |-> rootPartyIdClientId.value,
         executingTrader                             |-> executingTrader.value,
         rootPartyIdInvestmentDecisionMaker          |-> rootPartyIdInvestmentDecisionMaker.value,
         basketTrdMatchId                            |-> basketTrdMatchId.value,
         sideLastPx                                  |-> sideLastPx.value,
         sideLastQty                                 |-> sideLastQty.value,
         packageId                                   |-> packageId.value,
         marketSegmentId                             |-> marketSegmentId.value,
         tradeId                                     |-> tradeId.value,
         tradeDate                                   |-> tradeDate.value,
         sideTradeId                                 |-> sideTradeId.value,
         rootPartyIdSessionId                        |-> rootPartyIdSessionId.value,
         origTradeId                                 |-> origTradeId.value,
         rootPartyIdExecutingUnit                    |-> rootPartyIdExecutingUnit.value,
         rootPartyIdExecutingTrader                  |-> rootPartyIdExecutingTrader.value,
         rootPartyIdClearingUnit                     |-> rootPartyIdClearingUnit.value,
         strategyLinkId                              |-> strategyLinkId.value,
         relatedSymbol                               |-> relatedSymbol.value,
         totNumTradeReports                          |-> totNumTradeReports.value,
         negotiationId                               |-> negotiationId.value,
         pad3v1                                      |-> pad3v1.value,
         basketProfileId                             |-> basketProfileId.value,
         trdType                                     |-> trdType.value,
         productComplex                              |-> productComplex.value,
         relatedProductComplex                       |-> relatedProductComplex.value,
         side                                        |-> side.value,
         tradingCapacity                             |-> tradingCapacity.value,
         tradeReportType                             |-> tradeReportType.value,
         transferReason                              |-> transferReason.value,
         tradePublishIndicator                       |-> tradePublishIndicator.value,
         multiLegReportingType                       |-> multiLegReportingType.value,
         positionEffect                              |-> positionEffect.value,
         multilegPriceModel                          |-> multilegPriceModel.value,
         orderAttributeLiquidityProvision            |-> orderAttributeLiquidityProvision.value,
         orderAttributeRiskReduction                 |-> orderAttributeRiskReduction.value,
         executingTraderQualifier                    |-> executingTraderQualifier.value,
         rootPartyIdInvestmentDecisionMakerQualifier |-> rootPartyIdInvestmentDecisionMakerQualifier.value,
         orderOrigination                            |-> orderOrigination.value,
         reversalIndicator                           |-> reversalIndicator.value,
         account                                     |-> account.value,
         rootPartyIdPositionAccount                  |-> rootPartyIdPositionAccount.value,
         custOrderHandlingInst                       |-> custOrderHandlingInst.value,
         freeText1                                   |-> freeText1.value,
         freeText2                                   |-> freeText2.value,
         freeText3                                   |-> freeText3.value,
         rootPartyExecutingFirm                      |-> rootPartyExecutingFirm.value,
         rootPartyExecutingTrader                    |-> rootPartyExecutingTrader.value,
         rootPartyClearingFirm                       |-> rootPartyClearingFirm.value,
         rootPartyClearingOrganization               |-> rootPartyClearingOrganization.value,
         rootPartyIdBeneficiary                      |-> rootPartyIdBeneficiary.value,
         rootPartyIdTakeUpTradingFirm                |-> rootPartyIdTakeUpTradingFirm.value,
         rootPartyIdOrderOriginationFirm             |-> rootPartyIdOrderOriginationFirm.value,
         rootPartyIdExecutionVenue                   |-> rootPartyIdExecutionVenue.value,
         regulatoryTradeId                           |-> regulatoryTradeId.value,
         basketPartyContraFirm                       |-> basketPartyContraFirm.value,
         basketSideTradeReportId                     |-> basketSideTradeReportId.value,
         pad5                                        |-> pad5.value,
         srqsRelatedTradeIdGrpComp                   |-> srqsRelatedTradeIdGrpComp.value ], srqsRelatedTradeIdGrpComp.rest)

ZeroTesTradeBroadcast ==
    [ pad2                                        |-> [i \in 1 .. 2 |-> 0],
      rbcHeaderComp                               |-> ZeroRbcHeaderComp25,
      securityId                                  |-> [i \in 1 .. 8 |-> 0],
      lastPx                                      |-> [i \in 1 .. 8 |-> 0],
      lastQty                                     |-> [i \in 1 .. 8 |-> 0],
      clearingTradePrice                          |-> [i \in 1 .. 8 |-> 0],
      clearingTradeQty                            |-> [i \in 1 .. 8 |-> 0],
      transactTime                                |-> [i \in 1 .. 8 |-> 0],
      relatedSecurityId                           |-> [i \in 1 .. 8 |-> 0],
      compressionId                               |-> [i \in 1 .. 8 |-> 0],
      rootPartyIdClientId                         |-> [i \in 1 .. 8 |-> 0],
      executingTrader                             |-> [i \in 1 .. 8 |-> 0],
      rootPartyIdInvestmentDecisionMaker          |-> [i \in 1 .. 8 |-> 0],
      basketTrdMatchId                            |-> [i \in 1 .. 8 |-> 0],
      sideLastPx                                  |-> [i \in 1 .. 8 |-> 0],
      sideLastQty                                 |-> [i \in 1 .. 8 |-> 0],
      packageId                                   |-> [i \in 1 .. 4 |-> 0],
      marketSegmentId                             |-> [i \in 1 .. 4 |-> 0],
      tradeId                                     |-> [i \in 1 .. 4 |-> 0],
      tradeDate                                   |-> [i \in 1 .. 4 |-> 0],
      sideTradeId                                 |-> [i \in 1 .. 4 |-> 0],
      rootPartyIdSessionId                        |-> [i \in 1 .. 4 |-> 0],
      origTradeId                                 |-> [i \in 1 .. 4 |-> 0],
      rootPartyIdExecutingUnit                    |-> [i \in 1 .. 4 |-> 0],
      rootPartyIdExecutingTrader                  |-> [i \in 1 .. 4 |-> 0],
      rootPartyIdClearingUnit                     |-> [i \in 1 .. 4 |-> 0],
      strategyLinkId                              |-> [i \in 1 .. 4 |-> 0],
      relatedSymbol                               |-> [i \in 1 .. 4 |-> 0],
      totNumTradeReports                          |-> [i \in 1 .. 4 |-> 0],
      negotiationId                               |-> [i \in 1 .. 4 |-> 0],
      pad3v1                                      |-> [i \in 1 .. 3 |-> 0],
      basketProfileId                             |-> [i \in 1 .. 4 |-> 0],
      trdType                                     |-> [i \in 1 .. 2 |-> 0],
      productComplex                              |-> [i \in 1 .. 1 |-> 0],
      relatedProductComplex                       |-> [i \in 1 .. 1 |-> 0],
      side                                        |-> [i \in 1 .. 1 |-> 0],
      tradingCapacity                             |-> [i \in 1 .. 1 |-> 0],
      tradeReportType                             |-> [i \in 1 .. 1 |-> 0],
      transferReason                              |-> [i \in 1 .. 1 |-> 0],
      tradePublishIndicator                       |-> [i \in 1 .. 1 |-> 0],
      multiLegReportingType                       |-> [i \in 1 .. 1 |-> 0],
      positionEffect                              |-> [i \in 1 .. 1 |-> 0],
      multilegPriceModel                          |-> [i \in 1 .. 1 |-> 0],
      orderAttributeLiquidityProvision            |-> [i \in 1 .. 1 |-> 0],
      orderAttributeRiskReduction                 |-> [i \in 1 .. 1 |-> 0],
      executingTraderQualifier                    |-> [i \in 1 .. 1 |-> 0],
      rootPartyIdInvestmentDecisionMakerQualifier |-> [i \in 1 .. 1 |-> 0],
      orderOrigination                            |-> [i \in 1 .. 1 |-> 0],
      reversalIndicator                           |-> [i \in 1 .. 1 |-> 0],
      account                                     |-> [i \in 1 .. 2 |-> 0],
      rootPartyIdPositionAccount                  |-> [i \in 1 .. 32 |-> 0],
      custOrderHandlingInst                       |-> [i \in 1 .. 1 |-> 0],
      freeText1                                   |-> [i \in 1 .. 12 |-> 0],
      freeText2                                   |-> [i \in 1 .. 12 |-> 0],
      freeText3                                   |-> [i \in 1 .. 12 |-> 0],
      rootPartyExecutingFirm                      |-> [i \in 1 .. 5 |-> 0],
      rootPartyExecutingTrader                    |-> [i \in 1 .. 6 |-> 0],
      rootPartyClearingFirm                       |-> [i \in 1 .. 5 |-> 0],
      rootPartyClearingOrganization               |-> [i \in 1 .. 4 |-> 0],
      rootPartyIdBeneficiary                      |-> [i \in 1 .. 9 |-> 0],
      rootPartyIdTakeUpTradingFirm                |-> [i \in 1 .. 5 |-> 0],
      rootPartyIdOrderOriginationFirm             |-> [i \in 1 .. 7 |-> 0],
      rootPartyIdExecutionVenue                   |-> [i \in 1 .. 4 |-> 0],
      regulatoryTradeId                           |-> [i \in 1 .. 52 |-> 0],
      basketPartyContraFirm                       |-> [i \in 1 .. 5 |-> 0],
      basketSideTradeReportId                     |-> [i \in 1 .. 20 |-> 0],
      pad5                                        |-> [i \in 1 .. 5 |-> 0],
      srqsRelatedTradeIdGrpComp                   |-> << >> ]

(* Tes Trade Broadcast at zero, then each field in turn at the values it is checked at *)
CheckedTesTradeBroadcast ==
    { ZeroTesTradeBroadcast }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.pad2 = one] : one \in Sample(2) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.rbcHeaderComp = one] : one \in CheckedRbcHeaderComp25 }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.securityId = one] : one \in Sample(8) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.lastPx = one] : one \in Sample(8) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.lastQty = one] : one \in Sample(8) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.clearingTradePrice = one] : one \in Sample(8) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.clearingTradeQty = one] : one \in Sample(8) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.transactTime = one] : one \in Sample(8) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.relatedSecurityId = one] : one \in Sample(8) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.compressionId = one] : one \in Sample(8) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.rootPartyIdClientId = one] : one \in Sample(8) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.executingTrader = one] : one \in Sample(8) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.rootPartyIdInvestmentDecisionMaker = one] : one \in Sample(8) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.basketTrdMatchId = one] : one \in Sample(8) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.sideLastPx = one] : one \in Sample(8) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.sideLastQty = one] : one \in Sample(8) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.packageId = one] : one \in Sample(4) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.marketSegmentId = one] : one \in Sample(4) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.tradeId = one] : one \in Sample(4) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.tradeDate = one] : one \in Sample(4) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.sideTradeId = one] : one \in Sample(4) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.rootPartyIdSessionId = one] : one \in Sample(4) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.origTradeId = one] : one \in Sample(4) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.rootPartyIdExecutingUnit = one] : one \in Sample(4) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.rootPartyIdExecutingTrader = one] : one \in Sample(4) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.rootPartyIdClearingUnit = one] : one \in Sample(4) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.strategyLinkId = one] : one \in Sample(4) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.relatedSymbol = one] : one \in Sample(4) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.totNumTradeReports = one] : one \in Sample(4) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.negotiationId = one] : one \in Sample(4) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.pad3v1 = one] : one \in Sample(3) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.basketProfileId = one] : one \in Sample(4) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.trdType = one] : one \in Sample(2) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.productComplex = one] : one \in Sample(1) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.relatedProductComplex = one] : one \in Sample(1) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.side = one] : one \in Sample(1) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.tradingCapacity = one] : one \in Sample(1) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.tradeReportType = one] : one \in Sample(1) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.transferReason = one] : one \in Sample(1) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.tradePublishIndicator = one] : one \in Sample(1) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.multiLegReportingType = one] : one \in Sample(1) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.positionEffect = one] : one \in Sample(1) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.multilegPriceModel = one] : one \in Sample(1) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.orderAttributeLiquidityProvision = one] : one \in Sample(1) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.orderAttributeRiskReduction = one] : one \in Sample(1) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.executingTraderQualifier = one] : one \in Sample(1) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.rootPartyIdInvestmentDecisionMakerQualifier = one] : one \in Sample(1) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.orderOrigination = one] : one \in Sample(1) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.reversalIndicator = one] : one \in Sample(1) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.account = one] : one \in Sample(2) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.rootPartyIdPositionAccount = one] : one \in Sample(32) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.custOrderHandlingInst = one] : one \in Sample(1) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.freeText1 = one] : one \in Sample(12) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.freeText2 = one] : one \in Sample(12) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.freeText3 = one] : one \in Sample(12) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.rootPartyExecutingFirm = one] : one \in Sample(5) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.rootPartyExecutingTrader = one] : one \in Sample(6) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.rootPartyClearingFirm = one] : one \in Sample(5) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.rootPartyClearingOrganization = one] : one \in Sample(4) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.rootPartyIdBeneficiary = one] : one \in Sample(9) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.rootPartyIdTakeUpTradingFirm = one] : one \in Sample(5) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.rootPartyIdOrderOriginationFirm = one] : one \in Sample(7) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.rootPartyIdExecutionVenue = one] : one \in Sample(4) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.regulatoryTradeId = one] : one \in Sample(52) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.basketPartyContraFirm = one] : one \in Sample(5) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.basketSideTradeReportId = one] : one \in Sample(20) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.pad5 = one] : one \in Sample(5) }
        \cup { [ZeroTesTradeBroadcast EXCEPT !.srqsRelatedTradeIdGrpComp = one] : one \in SampleLists(OneSrqsRelatedTradeIdGrpComp) }

(***************************************************************************)
(* Rbc Header Comp: 32 bytes                                               *)
(***************************************************************************)

RbcHeaderComp26 ==
    [ sendingTime    : Sample(8),
      applSeqNum     : Sample(8),
      applSubId      : Sample(4),
      partitionId    : Sample(2),
      applResendFlag : Sample(1),
      applId         : Sample(1),
      lastFragment   : Sample(1),
      pad7           : Sample(7) ]

EncodeRbcHeaderComp26(message) ==
    message.sendingTime
        \o message.applSeqNum
        \o message.applSubId
        \o message.partitionId
        \o message.applResendFlag
        \o message.applId
        \o message.lastFragment
        \o message.pad7

DecodeRbcHeaderComp26(bytes) ==
    LET sendingTime == ReadBytes(bytes, 8) IN IF ~sendingTime.ok THEN Fail ELSE
    LET applSeqNum == ReadBytes(sendingTime.rest, 8) IN IF ~applSeqNum.ok THEN Fail ELSE
    LET applSubId == ReadBytes(applSeqNum.rest, 4) IN IF ~applSubId.ok THEN Fail ELSE
    LET partitionId == ReadBytes(applSubId.rest, 2) IN IF ~partitionId.ok THEN Fail ELSE
    LET applResendFlag == ReadBytes(partitionId.rest, 1) IN IF ~applResendFlag.ok THEN Fail ELSE
    LET applId == ReadBytes(applResendFlag.rest, 1) IN IF ~applId.ok THEN Fail ELSE
    LET lastFragment == ReadBytes(applId.rest, 1) IN IF ~lastFragment.ok THEN Fail ELSE
    LET pad7 == ReadBytes(lastFragment.rest, 7) IN IF ~pad7.ok THEN Fail ELSE
    Ok([ sendingTime    |-> sendingTime.value,
         applSeqNum     |-> applSeqNum.value,
         applSubId      |-> applSubId.value,
         partitionId    |-> partitionId.value,
         applResendFlag |-> applResendFlag.value,
         applId         |-> applId.value,
         lastFragment   |-> lastFragment.value,
         pad7           |-> pad7.value ], pad7.rest)

ZeroRbcHeaderComp26 ==
    [ sendingTime    |-> [i \in 1 .. 8 |-> 0],
      applSeqNum     |-> [i \in 1 .. 8 |-> 0],
      applSubId      |-> [i \in 1 .. 4 |-> 0],
      partitionId    |-> [i \in 1 .. 2 |-> 0],
      applResendFlag |-> [i \in 1 .. 1 |-> 0],
      applId         |-> [i \in 1 .. 1 |-> 0],
      lastFragment   |-> [i \in 1 .. 1 |-> 0],
      pad7           |-> [i \in 1 .. 7 |-> 0] ]

(* Rbc Header Comp at zero, then each field in turn at the values it is checked at *)
CheckedRbcHeaderComp26 ==
    { ZeroRbcHeaderComp26 }
        \cup { [ZeroRbcHeaderComp26 EXCEPT !.sendingTime = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderComp26 EXCEPT !.applSeqNum = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderComp26 EXCEPT !.applSubId = one] : one \in Sample(4) }
        \cup { [ZeroRbcHeaderComp26 EXCEPT !.partitionId = one] : one \in Sample(2) }
        \cup { [ZeroRbcHeaderComp26 EXCEPT !.applResendFlag = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp26 EXCEPT !.applId = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp26 EXCEPT !.lastFragment = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp26 EXCEPT !.pad7 = one] : one \in Sample(7) }

(***************************************************************************)
(* Tes Trading Session Status Broadcast: 42 bytes                          *)
(***************************************************************************)

TesTradingSessionStatusBroadcast ==
    [ pad2          : Sample(2),
      rbcHeaderComp : RbcHeaderComp26,
      tradeDate     : Sample(4),
      tradSesEvent  : Sample(1),
      pad3          : Sample(3) ]

EncodeTesTradingSessionStatusBroadcast(message) ==
    message.pad2
        \o EncodeRbcHeaderComp26(message.rbcHeaderComp)
        \o message.tradeDate
        \o message.tradSesEvent
        \o message.pad3

DecodeTesTradingSessionStatusBroadcast(bytes) ==
    LET pad2 == ReadBytes(bytes, 2) IN IF ~pad2.ok THEN Fail ELSE
    LET rbcHeaderComp == DecodeRbcHeaderComp26(pad2.rest) IN IF ~rbcHeaderComp.ok THEN Fail ELSE
    LET tradeDate == ReadBytes(rbcHeaderComp.rest, 4) IN IF ~tradeDate.ok THEN Fail ELSE
    LET tradSesEvent == ReadBytes(tradeDate.rest, 1) IN IF ~tradSesEvent.ok THEN Fail ELSE
    LET pad3 == ReadBytes(tradSesEvent.rest, 3) IN IF ~pad3.ok THEN Fail ELSE
    Ok([ pad2          |-> pad2.value,
         rbcHeaderComp |-> rbcHeaderComp.value,
         tradeDate     |-> tradeDate.value,
         tradSesEvent  |-> tradSesEvent.value,
         pad3          |-> pad3.value ], pad3.rest)

ZeroTesTradingSessionStatusBroadcast ==
    [ pad2          |-> [i \in 1 .. 2 |-> 0],
      rbcHeaderComp |-> ZeroRbcHeaderComp26,
      tradeDate     |-> [i \in 1 .. 4 |-> 0],
      tradSesEvent  |-> [i \in 1 .. 1 |-> 0],
      pad3          |-> [i \in 1 .. 3 |-> 0] ]

(* Tes Trading Session Status Broadcast at zero, then each field in turn at the values it is checked at *)
CheckedTesTradingSessionStatusBroadcast ==
    { ZeroTesTradingSessionStatusBroadcast }
        \cup { [ZeroTesTradingSessionStatusBroadcast EXCEPT !.pad2 = one] : one \in Sample(2) }
        \cup { [ZeroTesTradingSessionStatusBroadcast EXCEPT !.rbcHeaderComp = one] : one \in CheckedRbcHeaderComp26 }
        \cup { [ZeroTesTradingSessionStatusBroadcast EXCEPT !.tradeDate = one] : one \in Sample(4) }
        \cup { [ZeroTesTradingSessionStatusBroadcast EXCEPT !.tradSesEvent = one] : one \in Sample(1) }
        \cup { [ZeroTesTradingSessionStatusBroadcast EXCEPT !.pad3 = one] : one \in Sample(3) }

(***************************************************************************)
(* Rbc Header Comp: 32 bytes                                               *)
(***************************************************************************)

RbcHeaderComp27 ==
    [ sendingTime    : Sample(8),
      applSeqNum     : Sample(8),
      applSubId      : Sample(4),
      partitionId    : Sample(2),
      applResendFlag : Sample(1),
      applId         : Sample(1),
      lastFragment   : Sample(1),
      pad7           : Sample(7) ]

EncodeRbcHeaderComp27(message) ==
    message.sendingTime
        \o message.applSeqNum
        \o message.applSubId
        \o message.partitionId
        \o message.applResendFlag
        \o message.applId
        \o message.lastFragment
        \o message.pad7

DecodeRbcHeaderComp27(bytes) ==
    LET sendingTime == ReadBytes(bytes, 8) IN IF ~sendingTime.ok THEN Fail ELSE
    LET applSeqNum == ReadBytes(sendingTime.rest, 8) IN IF ~applSeqNum.ok THEN Fail ELSE
    LET applSubId == ReadBytes(applSeqNum.rest, 4) IN IF ~applSubId.ok THEN Fail ELSE
    LET partitionId == ReadBytes(applSubId.rest, 2) IN IF ~partitionId.ok THEN Fail ELSE
    LET applResendFlag == ReadBytes(partitionId.rest, 1) IN IF ~applResendFlag.ok THEN Fail ELSE
    LET applId == ReadBytes(applResendFlag.rest, 1) IN IF ~applId.ok THEN Fail ELSE
    LET lastFragment == ReadBytes(applId.rest, 1) IN IF ~lastFragment.ok THEN Fail ELSE
    LET pad7 == ReadBytes(lastFragment.rest, 7) IN IF ~pad7.ok THEN Fail ELSE
    Ok([ sendingTime    |-> sendingTime.value,
         applSeqNum     |-> applSeqNum.value,
         applSubId      |-> applSubId.value,
         partitionId    |-> partitionId.value,
         applResendFlag |-> applResendFlag.value,
         applId         |-> applId.value,
         lastFragment   |-> lastFragment.value,
         pad7           |-> pad7.value ], pad7.rest)

ZeroRbcHeaderComp27 ==
    [ sendingTime    |-> [i \in 1 .. 8 |-> 0],
      applSeqNum     |-> [i \in 1 .. 8 |-> 0],
      applSubId      |-> [i \in 1 .. 4 |-> 0],
      partitionId    |-> [i \in 1 .. 2 |-> 0],
      applResendFlag |-> [i \in 1 .. 1 |-> 0],
      applId         |-> [i \in 1 .. 1 |-> 0],
      lastFragment   |-> [i \in 1 .. 1 |-> 0],
      pad7           |-> [i \in 1 .. 7 |-> 0] ]

(* Rbc Header Comp at zero, then each field in turn at the values it is checked at *)
CheckedRbcHeaderComp27 ==
    { ZeroRbcHeaderComp27 }
        \cup { [ZeroRbcHeaderComp27 EXCEPT !.sendingTime = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderComp27 EXCEPT !.applSeqNum = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderComp27 EXCEPT !.applSubId = one] : one \in Sample(4) }
        \cup { [ZeroRbcHeaderComp27 EXCEPT !.partitionId = one] : one \in Sample(2) }
        \cup { [ZeroRbcHeaderComp27 EXCEPT !.applResendFlag = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp27 EXCEPT !.applId = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp27 EXCEPT !.lastFragment = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp27 EXCEPT !.pad7 = one] : one \in Sample(7) }

(***************************************************************************)
(* Side Alloc Ext Grp Comp: 176 bytes                                      *)
(***************************************************************************)

SideAllocExtGrpComp ==
    [ allocQty                                : Sample(8),
      partyIdClientId                         : Sample(8),
      partyIdInvestmentDecisionMaker          : Sample(8),
      executingTrader                         : Sample(8),
      individualAllocId                       : Sample(4),
      partyExecutingFirm                      : Sample(5),
      partyExecutingTrader                    : Sample(6),
      pad1                                    : Sample(1),
      tesEnrichmentRuleId                     : Sample(4),
      side                                    : Sample(1),
      tradeAllocStatus                        : Sample(1),
      tradingCapacity                         : Sample(1),
      positionEffect                          : Sample(1),
      orderAttributeLiquidityProvision        : Sample(1),
      executingTraderQualifier                : Sample(1),
      partyIdInvestmentDecisionMakerQualifier : Sample(1),
      orderAttributeRiskReduction             : Sample(1),
      orderOrigination                        : Sample(1),
      account                                 : Sample(2),
      partyIdPositionAccount                  : Sample(32),
      partyIdTakeUpTradingFirm                : Sample(5),
      freeText1                               : Sample(12),
      freeText2                               : Sample(12),
      freeText3                               : Sample(12),
      partyIdOrderOriginationFirm             : Sample(7),
      partyIdBeneficiary                      : Sample(9),
      partyIdLocationId                       : Sample(2),
      custOrderHandlingInst                   : Sample(1),
      complianceText                          : Sample(20),
      pad1v1                                  : Sample(1) ]

EncodeSideAllocExtGrpComp(message) ==
    message.allocQty
        \o message.partyIdClientId
        \o message.partyIdInvestmentDecisionMaker
        \o message.executingTrader
        \o message.individualAllocId
        \o message.partyExecutingFirm
        \o message.partyExecutingTrader
        \o message.pad1
        \o message.tesEnrichmentRuleId
        \o message.side
        \o message.tradeAllocStatus
        \o message.tradingCapacity
        \o message.positionEffect
        \o message.orderAttributeLiquidityProvision
        \o message.executingTraderQualifier
        \o message.partyIdInvestmentDecisionMakerQualifier
        \o message.orderAttributeRiskReduction
        \o message.orderOrigination
        \o message.account
        \o message.partyIdPositionAccount
        \o message.partyIdTakeUpTradingFirm
        \o message.freeText1
        \o message.freeText2
        \o message.freeText3
        \o message.partyIdOrderOriginationFirm
        \o message.partyIdBeneficiary
        \o message.partyIdLocationId
        \o message.custOrderHandlingInst
        \o message.complianceText
        \o message.pad1v1

DecodeSideAllocExtGrpComp(bytes) ==
    LET allocQty == ReadBytes(bytes, 8) IN IF ~allocQty.ok THEN Fail ELSE
    LET partyIdClientId == ReadBytes(allocQty.rest, 8) IN IF ~partyIdClientId.ok THEN Fail ELSE
    LET partyIdInvestmentDecisionMaker == ReadBytes(partyIdClientId.rest, 8) IN IF ~partyIdInvestmentDecisionMaker.ok THEN Fail ELSE
    LET executingTrader == ReadBytes(partyIdInvestmentDecisionMaker.rest, 8) IN IF ~executingTrader.ok THEN Fail ELSE
    LET individualAllocId == ReadBytes(executingTrader.rest, 4) IN IF ~individualAllocId.ok THEN Fail ELSE
    LET partyExecutingFirm == ReadBytes(individualAllocId.rest, 5) IN IF ~partyExecutingFirm.ok THEN Fail ELSE
    LET partyExecutingTrader == ReadBytes(partyExecutingFirm.rest, 6) IN IF ~partyExecutingTrader.ok THEN Fail ELSE
    LET pad1 == ReadBytes(partyExecutingTrader.rest, 1) IN IF ~pad1.ok THEN Fail ELSE
    LET tesEnrichmentRuleId == ReadBytes(pad1.rest, 4) IN IF ~tesEnrichmentRuleId.ok THEN Fail ELSE
    LET side == ReadBytes(tesEnrichmentRuleId.rest, 1) IN IF ~side.ok THEN Fail ELSE
    LET tradeAllocStatus == ReadBytes(side.rest, 1) IN IF ~tradeAllocStatus.ok THEN Fail ELSE
    LET tradingCapacity == ReadBytes(tradeAllocStatus.rest, 1) IN IF ~tradingCapacity.ok THEN Fail ELSE
    LET positionEffect == ReadBytes(tradingCapacity.rest, 1) IN IF ~positionEffect.ok THEN Fail ELSE
    LET orderAttributeLiquidityProvision == ReadBytes(positionEffect.rest, 1) IN IF ~orderAttributeLiquidityProvision.ok THEN Fail ELSE
    LET executingTraderQualifier == ReadBytes(orderAttributeLiquidityProvision.rest, 1) IN IF ~executingTraderQualifier.ok THEN Fail ELSE
    LET partyIdInvestmentDecisionMakerQualifier == ReadBytes(executingTraderQualifier.rest, 1) IN IF ~partyIdInvestmentDecisionMakerQualifier.ok THEN Fail ELSE
    LET orderAttributeRiskReduction == ReadBytes(partyIdInvestmentDecisionMakerQualifier.rest, 1) IN IF ~orderAttributeRiskReduction.ok THEN Fail ELSE
    LET orderOrigination == ReadBytes(orderAttributeRiskReduction.rest, 1) IN IF ~orderOrigination.ok THEN Fail ELSE
    LET account == ReadBytes(orderOrigination.rest, 2) IN IF ~account.ok THEN Fail ELSE
    LET partyIdPositionAccount == ReadBytes(account.rest, 32) IN IF ~partyIdPositionAccount.ok THEN Fail ELSE
    LET partyIdTakeUpTradingFirm == ReadBytes(partyIdPositionAccount.rest, 5) IN IF ~partyIdTakeUpTradingFirm.ok THEN Fail ELSE
    LET freeText1 == ReadBytes(partyIdTakeUpTradingFirm.rest, 12) IN IF ~freeText1.ok THEN Fail ELSE
    LET freeText2 == ReadBytes(freeText1.rest, 12) IN IF ~freeText2.ok THEN Fail ELSE
    LET freeText3 == ReadBytes(freeText2.rest, 12) IN IF ~freeText3.ok THEN Fail ELSE
    LET partyIdOrderOriginationFirm == ReadBytes(freeText3.rest, 7) IN IF ~partyIdOrderOriginationFirm.ok THEN Fail ELSE
    LET partyIdBeneficiary == ReadBytes(partyIdOrderOriginationFirm.rest, 9) IN IF ~partyIdBeneficiary.ok THEN Fail ELSE
    LET partyIdLocationId == ReadBytes(partyIdBeneficiary.rest, 2) IN IF ~partyIdLocationId.ok THEN Fail ELSE
    LET custOrderHandlingInst == ReadBytes(partyIdLocationId.rest, 1) IN IF ~custOrderHandlingInst.ok THEN Fail ELSE
    LET complianceText == ReadBytes(custOrderHandlingInst.rest, 20) IN IF ~complianceText.ok THEN Fail ELSE
    LET pad1v1 == ReadBytes(complianceText.rest, 1) IN IF ~pad1v1.ok THEN Fail ELSE
    Ok([ allocQty                                |-> allocQty.value,
         partyIdClientId                         |-> partyIdClientId.value,
         partyIdInvestmentDecisionMaker          |-> partyIdInvestmentDecisionMaker.value,
         executingTrader                         |-> executingTrader.value,
         individualAllocId                       |-> individualAllocId.value,
         partyExecutingFirm                      |-> partyExecutingFirm.value,
         partyExecutingTrader                    |-> partyExecutingTrader.value,
         pad1                                    |-> pad1.value,
         tesEnrichmentRuleId                     |-> tesEnrichmentRuleId.value,
         side                                    |-> side.value,
         tradeAllocStatus                        |-> tradeAllocStatus.value,
         tradingCapacity                         |-> tradingCapacity.value,
         positionEffect                          |-> positionEffect.value,
         orderAttributeLiquidityProvision        |-> orderAttributeLiquidityProvision.value,
         executingTraderQualifier                |-> executingTraderQualifier.value,
         partyIdInvestmentDecisionMakerQualifier |-> partyIdInvestmentDecisionMakerQualifier.value,
         orderAttributeRiskReduction             |-> orderAttributeRiskReduction.value,
         orderOrigination                        |-> orderOrigination.value,
         account                                 |-> account.value,
         partyIdPositionAccount                  |-> partyIdPositionAccount.value,
         partyIdTakeUpTradingFirm                |-> partyIdTakeUpTradingFirm.value,
         freeText1                               |-> freeText1.value,
         freeText2                               |-> freeText2.value,
         freeText3                               |-> freeText3.value,
         partyIdOrderOriginationFirm             |-> partyIdOrderOriginationFirm.value,
         partyIdBeneficiary                      |-> partyIdBeneficiary.value,
         partyIdLocationId                       |-> partyIdLocationId.value,
         custOrderHandlingInst                   |-> custOrderHandlingInst.value,
         complianceText                          |-> complianceText.value,
         pad1v1                                  |-> pad1v1.value ], pad1v1.rest)

ZeroSideAllocExtGrpComp ==
    [ allocQty                                |-> [i \in 1 .. 8 |-> 0],
      partyIdClientId                         |-> [i \in 1 .. 8 |-> 0],
      partyIdInvestmentDecisionMaker          |-> [i \in 1 .. 8 |-> 0],
      executingTrader                         |-> [i \in 1 .. 8 |-> 0],
      individualAllocId                       |-> [i \in 1 .. 4 |-> 0],
      partyExecutingFirm                      |-> [i \in 1 .. 5 |-> 0],
      partyExecutingTrader                    |-> [i \in 1 .. 6 |-> 0],
      pad1                                    |-> [i \in 1 .. 1 |-> 0],
      tesEnrichmentRuleId                     |-> [i \in 1 .. 4 |-> 0],
      side                                    |-> [i \in 1 .. 1 |-> 0],
      tradeAllocStatus                        |-> [i \in 1 .. 1 |-> 0],
      tradingCapacity                         |-> [i \in 1 .. 1 |-> 0],
      positionEffect                          |-> [i \in 1 .. 1 |-> 0],
      orderAttributeLiquidityProvision        |-> [i \in 1 .. 1 |-> 0],
      executingTraderQualifier                |-> [i \in 1 .. 1 |-> 0],
      partyIdInvestmentDecisionMakerQualifier |-> [i \in 1 .. 1 |-> 0],
      orderAttributeRiskReduction             |-> [i \in 1 .. 1 |-> 0],
      orderOrigination                        |-> [i \in 1 .. 1 |-> 0],
      account                                 |-> [i \in 1 .. 2 |-> 0],
      partyIdPositionAccount                  |-> [i \in 1 .. 32 |-> 0],
      partyIdTakeUpTradingFirm                |-> [i \in 1 .. 5 |-> 0],
      freeText1                               |-> [i \in 1 .. 12 |-> 0],
      freeText2                               |-> [i \in 1 .. 12 |-> 0],
      freeText3                               |-> [i \in 1 .. 12 |-> 0],
      partyIdOrderOriginationFirm             |-> [i \in 1 .. 7 |-> 0],
      partyIdBeneficiary                      |-> [i \in 1 .. 9 |-> 0],
      partyIdLocationId                       |-> [i \in 1 .. 2 |-> 0],
      custOrderHandlingInst                   |-> [i \in 1 .. 1 |-> 0],
      complianceText                          |-> [i \in 1 .. 20 |-> 0],
      pad1v1                                  |-> [i \in 1 .. 1 |-> 0] ]

(* Side Alloc Ext Grp Comp at zero, then each field in turn at the values it is checked at *)
CheckedSideAllocExtGrpComp ==
    { ZeroSideAllocExtGrpComp }
        \cup { [ZeroSideAllocExtGrpComp EXCEPT !.allocQty = one] : one \in Sample(8) }
        \cup { [ZeroSideAllocExtGrpComp EXCEPT !.partyIdClientId = one] : one \in Sample(8) }
        \cup { [ZeroSideAllocExtGrpComp EXCEPT !.partyIdInvestmentDecisionMaker = one] : one \in Sample(8) }
        \cup { [ZeroSideAllocExtGrpComp EXCEPT !.executingTrader = one] : one \in Sample(8) }
        \cup { [ZeroSideAllocExtGrpComp EXCEPT !.individualAllocId = one] : one \in Sample(4) }
        \cup { [ZeroSideAllocExtGrpComp EXCEPT !.partyExecutingFirm = one] : one \in Sample(5) }
        \cup { [ZeroSideAllocExtGrpComp EXCEPT !.partyExecutingTrader = one] : one \in Sample(6) }
        \cup { [ZeroSideAllocExtGrpComp EXCEPT !.pad1 = one] : one \in Sample(1) }
        \cup { [ZeroSideAllocExtGrpComp EXCEPT !.tesEnrichmentRuleId = one] : one \in Sample(4) }
        \cup { [ZeroSideAllocExtGrpComp EXCEPT !.side = one] : one \in Sample(1) }
        \cup { [ZeroSideAllocExtGrpComp EXCEPT !.tradeAllocStatus = one] : one \in Sample(1) }
        \cup { [ZeroSideAllocExtGrpComp EXCEPT !.tradingCapacity = one] : one \in Sample(1) }
        \cup { [ZeroSideAllocExtGrpComp EXCEPT !.positionEffect = one] : one \in Sample(1) }
        \cup { [ZeroSideAllocExtGrpComp EXCEPT !.orderAttributeLiquidityProvision = one] : one \in Sample(1) }
        \cup { [ZeroSideAllocExtGrpComp EXCEPT !.executingTraderQualifier = one] : one \in Sample(1) }
        \cup { [ZeroSideAllocExtGrpComp EXCEPT !.partyIdInvestmentDecisionMakerQualifier = one] : one \in Sample(1) }
        \cup { [ZeroSideAllocExtGrpComp EXCEPT !.orderAttributeRiskReduction = one] : one \in Sample(1) }
        \cup { [ZeroSideAllocExtGrpComp EXCEPT !.orderOrigination = one] : one \in Sample(1) }
        \cup { [ZeroSideAllocExtGrpComp EXCEPT !.account = one] : one \in Sample(2) }
        \cup { [ZeroSideAllocExtGrpComp EXCEPT !.partyIdPositionAccount = one] : one \in Sample(32) }
        \cup { [ZeroSideAllocExtGrpComp EXCEPT !.partyIdTakeUpTradingFirm = one] : one \in Sample(5) }
        \cup { [ZeroSideAllocExtGrpComp EXCEPT !.freeText1 = one] : one \in Sample(12) }
        \cup { [ZeroSideAllocExtGrpComp EXCEPT !.freeText2 = one] : one \in Sample(12) }
        \cup { [ZeroSideAllocExtGrpComp EXCEPT !.freeText3 = one] : one \in Sample(12) }
        \cup { [ZeroSideAllocExtGrpComp EXCEPT !.partyIdOrderOriginationFirm = one] : one \in Sample(7) }
        \cup { [ZeroSideAllocExtGrpComp EXCEPT !.partyIdBeneficiary = one] : one \in Sample(9) }
        \cup { [ZeroSideAllocExtGrpComp EXCEPT !.partyIdLocationId = one] : one \in Sample(2) }
        \cup { [ZeroSideAllocExtGrpComp EXCEPT !.custOrderHandlingInst = one] : one \in Sample(1) }
        \cup { [ZeroSideAllocExtGrpComp EXCEPT !.complianceText = one] : one \in Sample(20) }
        \cup { [ZeroSideAllocExtGrpComp EXCEPT !.pad1v1 = one] : one \in Sample(1) }

(* A run of Side Alloc Ext Grp Comp, written one after another *)
RECURSIVE EncodeSideAllocExtGrpCompList(_)
EncodeSideAllocExtGrpCompList(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeSideAllocExtGrpComp(Head(messages)) \o EncodeSideAllocExtGrpCompList(Tail(messages))

(* As many Side Alloc Ext Grp Comp as the field that counts them says *)
RECURSIVE ReadSideAllocExtGrpCompList(_, _)
ReadSideAllocExtGrpCompList(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeSideAllocExtGrpComp(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadSideAllocExtGrpCompList(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Side Alloc Ext Grp Comp of each kind, for the lists that carry them *)
OneSideAllocExtGrpComp == { ZeroSideAllocExtGrpComp }

(***************************************************************************)
(* Trd Instrmnt Leg Grp Comp: 24 bytes                                     *)
(***************************************************************************)

TrdInstrmntLegGrpComp3 ==
    [ legSecurityId : Sample(8),
      legPrice      : Sample(8),
      legQty        : Sample(8) ]

EncodeTrdInstrmntLegGrpComp3(message) ==
    message.legSecurityId
        \o message.legPrice
        \o message.legQty

DecodeTrdInstrmntLegGrpComp3(bytes) ==
    LET legSecurityId == ReadBytes(bytes, 8) IN IF ~legSecurityId.ok THEN Fail ELSE
    LET legPrice == ReadBytes(legSecurityId.rest, 8) IN IF ~legPrice.ok THEN Fail ELSE
    LET legQty == ReadBytes(legPrice.rest, 8) IN IF ~legQty.ok THEN Fail ELSE
    Ok([ legSecurityId |-> legSecurityId.value,
         legPrice      |-> legPrice.value,
         legQty        |-> legQty.value ], legQty.rest)

ZeroTrdInstrmntLegGrpComp3 ==
    [ legSecurityId |-> [i \in 1 .. 8 |-> 0],
      legPrice      |-> [i \in 1 .. 8 |-> 0],
      legQty        |-> [i \in 1 .. 8 |-> 0] ]

(* Trd Instrmnt Leg Grp Comp at zero, then each field in turn at the values it is checked at *)
CheckedTrdInstrmntLegGrpComp3 ==
    { ZeroTrdInstrmntLegGrpComp3 }
        \cup { [ZeroTrdInstrmntLegGrpComp3 EXCEPT !.legSecurityId = one] : one \in Sample(8) }
        \cup { [ZeroTrdInstrmntLegGrpComp3 EXCEPT !.legPrice = one] : one \in Sample(8) }
        \cup { [ZeroTrdInstrmntLegGrpComp3 EXCEPT !.legQty = one] : one \in Sample(8) }

(* A run of Trd Instrmnt Leg Grp Comp, written one after another *)
RECURSIVE EncodeTrdInstrmntLegGrpComp3List(_)
EncodeTrdInstrmntLegGrpComp3List(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeTrdInstrmntLegGrpComp3(Head(messages)) \o EncodeTrdInstrmntLegGrpComp3List(Tail(messages))

(* As many Trd Instrmnt Leg Grp Comp as the field that counts them says *)
RECURSIVE ReadTrdInstrmntLegGrpComp3List(_, _)
ReadTrdInstrmntLegGrpComp3List(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeTrdInstrmntLegGrpComp3(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadTrdInstrmntLegGrpComp3List(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Trd Instrmnt Leg Grp Comp of each kind, for the lists that carry them *)
OneTrdInstrmntLegGrpComp3 == { ZeroTrdInstrmntLegGrpComp3 }

(***************************************************************************)
(* Instrument Event Grp Comp: 8 bytes                                      *)
(***************************************************************************)

InstrumentEventGrpComp3 ==
    [ eventDate : Sample(4),
      eventType : Sample(1),
      pad3      : Sample(3) ]

EncodeInstrumentEventGrpComp3(message) ==
    message.eventDate
        \o message.eventType
        \o message.pad3

DecodeInstrumentEventGrpComp3(bytes) ==
    LET eventDate == ReadBytes(bytes, 4) IN IF ~eventDate.ok THEN Fail ELSE
    LET eventType == ReadBytes(eventDate.rest, 1) IN IF ~eventType.ok THEN Fail ELSE
    LET pad3 == ReadBytes(eventType.rest, 3) IN IF ~pad3.ok THEN Fail ELSE
    Ok([ eventDate |-> eventDate.value,
         eventType |-> eventType.value,
         pad3      |-> pad3.value ], pad3.rest)

ZeroInstrumentEventGrpComp3 ==
    [ eventDate |-> [i \in 1 .. 4 |-> 0],
      eventType |-> [i \in 1 .. 1 |-> 0],
      pad3      |-> [i \in 1 .. 3 |-> 0] ]

(* Instrument Event Grp Comp at zero, then each field in turn at the values it is checked at *)
CheckedInstrumentEventGrpComp3 ==
    { ZeroInstrumentEventGrpComp3 }
        \cup { [ZeroInstrumentEventGrpComp3 EXCEPT !.eventDate = one] : one \in Sample(4) }
        \cup { [ZeroInstrumentEventGrpComp3 EXCEPT !.eventType = one] : one \in Sample(1) }
        \cup { [ZeroInstrumentEventGrpComp3 EXCEPT !.pad3 = one] : one \in Sample(3) }

(* A run of Instrument Event Grp Comp, written one after another *)
RECURSIVE EncodeInstrumentEventGrpComp3List(_)
EncodeInstrumentEventGrpComp3List(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeInstrumentEventGrpComp3(Head(messages)) \o EncodeInstrumentEventGrpComp3List(Tail(messages))

(* As many Instrument Event Grp Comp as the field that counts them says *)
RECURSIVE ReadInstrumentEventGrpComp3List(_, _)
ReadInstrumentEventGrpComp3List(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeInstrumentEventGrpComp3(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadInstrumentEventGrpComp3List(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Instrument Event Grp Comp of each kind, for the lists that carry them *)
OneInstrumentEventGrpComp3 == { ZeroInstrumentEventGrpComp3 }

(***************************************************************************)
(* Instrument Attribute Grp Comp: 40 bytes                                 *)
(***************************************************************************)

InstrumentAttributeGrpComp3 ==
    [ instrAttribType  : Sample(1),
      instrAttribValue : Sample(32),
      pad7             : Sample(7) ]

EncodeInstrumentAttributeGrpComp3(message) ==
    message.instrAttribType
        \o message.instrAttribValue
        \o message.pad7

DecodeInstrumentAttributeGrpComp3(bytes) ==
    LET instrAttribType == ReadBytes(bytes, 1) IN IF ~instrAttribType.ok THEN Fail ELSE
    LET instrAttribValue == ReadBytes(instrAttribType.rest, 32) IN IF ~instrAttribValue.ok THEN Fail ELSE
    LET pad7 == ReadBytes(instrAttribValue.rest, 7) IN IF ~pad7.ok THEN Fail ELSE
    Ok([ instrAttribType  |-> instrAttribType.value,
         instrAttribValue |-> instrAttribValue.value,
         pad7             |-> pad7.value ], pad7.rest)

ZeroInstrumentAttributeGrpComp3 ==
    [ instrAttribType  |-> [i \in 1 .. 1 |-> 0],
      instrAttribValue |-> [i \in 1 .. 32 |-> 0],
      pad7             |-> [i \in 1 .. 7 |-> 0] ]

(* Instrument Attribute Grp Comp at zero, then each field in turn at the values it is checked at *)
CheckedInstrumentAttributeGrpComp3 ==
    { ZeroInstrumentAttributeGrpComp3 }
        \cup { [ZeroInstrumentAttributeGrpComp3 EXCEPT !.instrAttribType = one] : one \in Sample(1) }
        \cup { [ZeroInstrumentAttributeGrpComp3 EXCEPT !.instrAttribValue = one] : one \in Sample(32) }
        \cup { [ZeroInstrumentAttributeGrpComp3 EXCEPT !.pad7 = one] : one \in Sample(7) }

(* A run of Instrument Attribute Grp Comp, written one after another *)
RECURSIVE EncodeInstrumentAttributeGrpComp3List(_)
EncodeInstrumentAttributeGrpComp3List(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeInstrumentAttributeGrpComp3(Head(messages)) \o EncodeInstrumentAttributeGrpComp3List(Tail(messages))

(* As many Instrument Attribute Grp Comp as the field that counts them says *)
RECURSIVE ReadInstrumentAttributeGrpComp3List(_, _)
ReadInstrumentAttributeGrpComp3List(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeInstrumentAttributeGrpComp3(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadInstrumentAttributeGrpComp3List(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Instrument Attribute Grp Comp of each kind, for the lists that carry them *)
OneInstrumentAttributeGrpComp3 == { ZeroInstrumentAttributeGrpComp3 }

(***************************************************************************)
(* Underlying Stip Grp Comp: 40 bytes                                      *)
(***************************************************************************)

UnderlyingStipGrpComp3 ==
    [ underlyingStipValue : Sample(32),
      underlyingStipType  : Sample(7),
      pad1                : Sample(1) ]

EncodeUnderlyingStipGrpComp3(message) ==
    message.underlyingStipValue
        \o message.underlyingStipType
        \o message.pad1

DecodeUnderlyingStipGrpComp3(bytes) ==
    LET underlyingStipValue == ReadBytes(bytes, 32) IN IF ~underlyingStipValue.ok THEN Fail ELSE
    LET underlyingStipType == ReadBytes(underlyingStipValue.rest, 7) IN IF ~underlyingStipType.ok THEN Fail ELSE
    LET pad1 == ReadBytes(underlyingStipType.rest, 1) IN IF ~pad1.ok THEN Fail ELSE
    Ok([ underlyingStipValue |-> underlyingStipValue.value,
         underlyingStipType  |-> underlyingStipType.value,
         pad1                |-> pad1.value ], pad1.rest)

ZeroUnderlyingStipGrpComp3 ==
    [ underlyingStipValue |-> [i \in 1 .. 32 |-> 0],
      underlyingStipType  |-> [i \in 1 .. 7 |-> 0],
      pad1                |-> [i \in 1 .. 1 |-> 0] ]

(* Underlying Stip Grp Comp at zero, then each field in turn at the values it is checked at *)
CheckedUnderlyingStipGrpComp3 ==
    { ZeroUnderlyingStipGrpComp3 }
        \cup { [ZeroUnderlyingStipGrpComp3 EXCEPT !.underlyingStipValue = one] : one \in Sample(32) }
        \cup { [ZeroUnderlyingStipGrpComp3 EXCEPT !.underlyingStipType = one] : one \in Sample(7) }
        \cup { [ZeroUnderlyingStipGrpComp3 EXCEPT !.pad1 = one] : one \in Sample(1) }

(* A run of Underlying Stip Grp Comp, written one after another *)
RECURSIVE EncodeUnderlyingStipGrpComp3List(_)
EncodeUnderlyingStipGrpComp3List(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeUnderlyingStipGrpComp3(Head(messages)) \o EncodeUnderlyingStipGrpComp3List(Tail(messages))

(* As many Underlying Stip Grp Comp as the field that counts them says *)
RECURSIVE ReadUnderlyingStipGrpComp3List(_, _)
ReadUnderlyingStipGrpComp3List(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeUnderlyingStipGrpComp3(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadUnderlyingStipGrpComp3List(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Underlying Stip Grp Comp of each kind, for the lists that carry them *)
OneUnderlyingStipGrpComp3 == { ZeroUnderlyingStipGrpComp3 }

(***************************************************************************)
(* Tes Upload Broadcast                                                    *)
(***************************************************************************)

TesUploadBroadcast ==
    [ pad2                       : Sample(2),
      rbcHeaderComp              : RbcHeaderComp27,
      securityId                 : Sample(8),
      lastPx                     : Sample(8),
      transBkdTime               : Sample(8),
      transactTime               : Sample(8),
      underlyingPx               : Sample(8),
      relatedClosePrice          : Sample(8),
      relatedTradeQuantity       : Sample(8),
      underlyingQty              : Sample(8),
      compressionId              : Sample(8),
      marketSegmentId            : Sample(4),
      packageId                  : Sample(4),
      tesExecId                  : Sample(4),
      underlyingSettlementDate   : Sample(4),
      underlyingMaturityDate     : Sample(4),
      relatedTradeId             : Sample(4),
      relatedMarketSegmentId     : Sample(4),
      trdType                    : Sample(2),
      productComplex             : Sample(1),
      tradeReportType            : Sample(1),
      trdRptStatus               : Sample(1),
      tradePublishIndicator      : Sample(1),
      tradePlatform              : Sample(1),
      hedgeType                  : Sample(1),
      partyIdSettlementLocation  : Sample(1),
      messageEventSource         : Sample(1),
      tradeReportId              : Sample(20),
      rootPartyExecutingFirm     : Sample(5),
      rootPartyExecutingTrader   : Sample(6),
      underlyingSecurityId       : Sample(12),
      underlyingSecurityDesc     : Sample(30),
      underlyingCurrency         : Sample(3),
      underlyingIssuer           : Sample(30),
      pad3                       : Sample(3),
      sideAllocExtGrpComp        : SampleLists(OneSideAllocExtGrpComp),
      trdInstrmntLegGrpComp      : SampleLists(OneTrdInstrmntLegGrpComp3),
      instrumentEventGrpComp     : SampleLists(OneInstrumentEventGrpComp3),
      instrumentAttributeGrpComp : SampleLists(OneInstrumentAttributeGrpComp3),
      underlyingStipGrpComp      : SampleLists(OneUnderlyingStipGrpComp3) ]

EncodeTesUploadBroadcast(message) ==
    message.pad2
        \o EncodeRbcHeaderComp27(message.rbcHeaderComp)
        \o message.securityId
        \o message.lastPx
        \o message.transBkdTime
        \o message.transactTime
        \o message.underlyingPx
        \o message.relatedClosePrice
        \o message.relatedTradeQuantity
        \o message.underlyingQty
        \o message.compressionId
        \o message.marketSegmentId
        \o message.packageId
        \o message.tesExecId
        \o message.underlyingSettlementDate
        \o message.underlyingMaturityDate
        \o message.relatedTradeId
        \o message.relatedMarketSegmentId
        \o message.trdType
        \o message.productComplex
        \o message.tradeReportType
        \o message.trdRptStatus
        \o message.tradePublishIndicator
        \o message.tradePlatform
        \o EncodeUIntBE(Len(message.sideAllocExtGrpComp), 1)
        \o EncodeUIntBE(Len(message.trdInstrmntLegGrpComp), 1)
        \o EncodeUIntBE(Len(message.instrumentEventGrpComp), 1)
        \o EncodeUIntBE(Len(message.instrumentAttributeGrpComp), 1)
        \o EncodeUIntBE(Len(message.underlyingStipGrpComp), 1)
        \o message.hedgeType
        \o message.partyIdSettlementLocation
        \o message.messageEventSource
        \o message.tradeReportId
        \o message.rootPartyExecutingFirm
        \o message.rootPartyExecutingTrader
        \o message.underlyingSecurityId
        \o message.underlyingSecurityDesc
        \o message.underlyingCurrency
        \o message.underlyingIssuer
        \o message.pad3
        \o EncodeSideAllocExtGrpCompList(message.sideAllocExtGrpComp)
        \o EncodeTrdInstrmntLegGrpComp3List(message.trdInstrmntLegGrpComp)
        \o EncodeInstrumentEventGrpComp3List(message.instrumentEventGrpComp)
        \o EncodeInstrumentAttributeGrpComp3List(message.instrumentAttributeGrpComp)
        \o EncodeUnderlyingStipGrpComp3List(message.underlyingStipGrpComp)

DecodeTesUploadBroadcast(bytes) ==
    LET pad2 == ReadBytes(bytes, 2) IN IF ~pad2.ok THEN Fail ELSE
    LET rbcHeaderComp == DecodeRbcHeaderComp27(pad2.rest) IN IF ~rbcHeaderComp.ok THEN Fail ELSE
    LET securityId == ReadBytes(rbcHeaderComp.rest, 8) IN IF ~securityId.ok THEN Fail ELSE
    LET lastPx == ReadBytes(securityId.rest, 8) IN IF ~lastPx.ok THEN Fail ELSE
    LET transBkdTime == ReadBytes(lastPx.rest, 8) IN IF ~transBkdTime.ok THEN Fail ELSE
    LET transactTime == ReadBytes(transBkdTime.rest, 8) IN IF ~transactTime.ok THEN Fail ELSE
    LET underlyingPx == ReadBytes(transactTime.rest, 8) IN IF ~underlyingPx.ok THEN Fail ELSE
    LET relatedClosePrice == ReadBytes(underlyingPx.rest, 8) IN IF ~relatedClosePrice.ok THEN Fail ELSE
    LET relatedTradeQuantity == ReadBytes(relatedClosePrice.rest, 8) IN IF ~relatedTradeQuantity.ok THEN Fail ELSE
    LET underlyingQty == ReadBytes(relatedTradeQuantity.rest, 8) IN IF ~underlyingQty.ok THEN Fail ELSE
    LET compressionId == ReadBytes(underlyingQty.rest, 8) IN IF ~compressionId.ok THEN Fail ELSE
    LET marketSegmentId == ReadBytes(compressionId.rest, 4) IN IF ~marketSegmentId.ok THEN Fail ELSE
    LET packageId == ReadBytes(marketSegmentId.rest, 4) IN IF ~packageId.ok THEN Fail ELSE
    LET tesExecId == ReadBytes(packageId.rest, 4) IN IF ~tesExecId.ok THEN Fail ELSE
    LET underlyingSettlementDate == ReadBytes(tesExecId.rest, 4) IN IF ~underlyingSettlementDate.ok THEN Fail ELSE
    LET underlyingMaturityDate == ReadBytes(underlyingSettlementDate.rest, 4) IN IF ~underlyingMaturityDate.ok THEN Fail ELSE
    LET relatedTradeId == ReadBytes(underlyingMaturityDate.rest, 4) IN IF ~relatedTradeId.ok THEN Fail ELSE
    LET relatedMarketSegmentId == ReadBytes(relatedTradeId.rest, 4) IN IF ~relatedMarketSegmentId.ok THEN Fail ELSE
    LET trdType == ReadBytes(relatedMarketSegmentId.rest, 2) IN IF ~trdType.ok THEN Fail ELSE
    LET productComplex == ReadBytes(trdType.rest, 1) IN IF ~productComplex.ok THEN Fail ELSE
    LET tradeReportType == ReadBytes(productComplex.rest, 1) IN IF ~tradeReportType.ok THEN Fail ELSE
    LET trdRptStatus == ReadBytes(tradeReportType.rest, 1) IN IF ~trdRptStatus.ok THEN Fail ELSE
    LET tradePublishIndicator == ReadBytes(trdRptStatus.rest, 1) IN IF ~tradePublishIndicator.ok THEN Fail ELSE
    LET tradePlatform == ReadBytes(tradePublishIndicator.rest, 1) IN IF ~tradePlatform.ok THEN Fail ELSE
    LET noSideAllocs == ReadUIntBE(tradePlatform.rest, 1) IN IF ~noSideAllocs.ok THEN Fail ELSE
    LET noLegs == ReadUIntBE(noSideAllocs.rest, 1) IN IF ~noLegs.ok THEN Fail ELSE
    LET noEvents == ReadUIntBE(noLegs.rest, 1) IN IF ~noEvents.ok THEN Fail ELSE
    LET noInstrAttrib == ReadUIntBE(noEvents.rest, 1) IN IF ~noInstrAttrib.ok THEN Fail ELSE
    LET noUnderlyingStips == ReadUIntBE(noInstrAttrib.rest, 1) IN IF ~noUnderlyingStips.ok THEN Fail ELSE
    LET hedgeType == ReadBytes(noUnderlyingStips.rest, 1) IN IF ~hedgeType.ok THEN Fail ELSE
    LET partyIdSettlementLocation == ReadBytes(hedgeType.rest, 1) IN IF ~partyIdSettlementLocation.ok THEN Fail ELSE
    LET messageEventSource == ReadBytes(partyIdSettlementLocation.rest, 1) IN IF ~messageEventSource.ok THEN Fail ELSE
    LET tradeReportId == ReadBytes(messageEventSource.rest, 20) IN IF ~tradeReportId.ok THEN Fail ELSE
    LET rootPartyExecutingFirm == ReadBytes(tradeReportId.rest, 5) IN IF ~rootPartyExecutingFirm.ok THEN Fail ELSE
    LET rootPartyExecutingTrader == ReadBytes(rootPartyExecutingFirm.rest, 6) IN IF ~rootPartyExecutingTrader.ok THEN Fail ELSE
    LET underlyingSecurityId == ReadBytes(rootPartyExecutingTrader.rest, 12) IN IF ~underlyingSecurityId.ok THEN Fail ELSE
    LET underlyingSecurityDesc == ReadBytes(underlyingSecurityId.rest, 30) IN IF ~underlyingSecurityDesc.ok THEN Fail ELSE
    LET underlyingCurrency == ReadBytes(underlyingSecurityDesc.rest, 3) IN IF ~underlyingCurrency.ok THEN Fail ELSE
    LET underlyingIssuer == ReadBytes(underlyingCurrency.rest, 30) IN IF ~underlyingIssuer.ok THEN Fail ELSE
    LET pad3 == ReadBytes(underlyingIssuer.rest, 3) IN IF ~pad3.ok THEN Fail ELSE
    LET sideAllocExtGrpComp == ReadSideAllocExtGrpCompList(pad3.rest, noSideAllocs.value) IN IF ~sideAllocExtGrpComp.ok THEN Fail ELSE
    LET trdInstrmntLegGrpComp == ReadTrdInstrmntLegGrpComp3List(sideAllocExtGrpComp.rest, noLegs.value) IN IF ~trdInstrmntLegGrpComp.ok THEN Fail ELSE
    LET instrumentEventGrpComp == ReadInstrumentEventGrpComp3List(trdInstrmntLegGrpComp.rest, noEvents.value) IN IF ~instrumentEventGrpComp.ok THEN Fail ELSE
    LET instrumentAttributeGrpComp == ReadInstrumentAttributeGrpComp3List(instrumentEventGrpComp.rest, noInstrAttrib.value) IN IF ~instrumentAttributeGrpComp.ok THEN Fail ELSE
    LET underlyingStipGrpComp == ReadUnderlyingStipGrpComp3List(instrumentAttributeGrpComp.rest, noUnderlyingStips.value) IN IF ~underlyingStipGrpComp.ok THEN Fail ELSE
    Ok([ pad2                       |-> pad2.value,
         rbcHeaderComp              |-> rbcHeaderComp.value,
         securityId                 |-> securityId.value,
         lastPx                     |-> lastPx.value,
         transBkdTime               |-> transBkdTime.value,
         transactTime               |-> transactTime.value,
         underlyingPx               |-> underlyingPx.value,
         relatedClosePrice          |-> relatedClosePrice.value,
         relatedTradeQuantity       |-> relatedTradeQuantity.value,
         underlyingQty              |-> underlyingQty.value,
         compressionId              |-> compressionId.value,
         marketSegmentId            |-> marketSegmentId.value,
         packageId                  |-> packageId.value,
         tesExecId                  |-> tesExecId.value,
         underlyingSettlementDate   |-> underlyingSettlementDate.value,
         underlyingMaturityDate     |-> underlyingMaturityDate.value,
         relatedTradeId             |-> relatedTradeId.value,
         relatedMarketSegmentId     |-> relatedMarketSegmentId.value,
         trdType                    |-> trdType.value,
         productComplex             |-> productComplex.value,
         tradeReportType            |-> tradeReportType.value,
         trdRptStatus               |-> trdRptStatus.value,
         tradePublishIndicator      |-> tradePublishIndicator.value,
         tradePlatform              |-> tradePlatform.value,
         hedgeType                  |-> hedgeType.value,
         partyIdSettlementLocation  |-> partyIdSettlementLocation.value,
         messageEventSource         |-> messageEventSource.value,
         tradeReportId              |-> tradeReportId.value,
         rootPartyExecutingFirm     |-> rootPartyExecutingFirm.value,
         rootPartyExecutingTrader   |-> rootPartyExecutingTrader.value,
         underlyingSecurityId       |-> underlyingSecurityId.value,
         underlyingSecurityDesc     |-> underlyingSecurityDesc.value,
         underlyingCurrency         |-> underlyingCurrency.value,
         underlyingIssuer           |-> underlyingIssuer.value,
         pad3                       |-> pad3.value,
         sideAllocExtGrpComp        |-> sideAllocExtGrpComp.value,
         trdInstrmntLegGrpComp      |-> trdInstrmntLegGrpComp.value,
         instrumentEventGrpComp     |-> instrumentEventGrpComp.value,
         instrumentAttributeGrpComp |-> instrumentAttributeGrpComp.value,
         underlyingStipGrpComp      |-> underlyingStipGrpComp.value ], underlyingStipGrpComp.rest)

ZeroTesUploadBroadcast ==
    [ pad2                       |-> [i \in 1 .. 2 |-> 0],
      rbcHeaderComp              |-> ZeroRbcHeaderComp27,
      securityId                 |-> [i \in 1 .. 8 |-> 0],
      lastPx                     |-> [i \in 1 .. 8 |-> 0],
