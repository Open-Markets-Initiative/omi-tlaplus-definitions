        \cup { [ZeroTesApproveBroadcast EXCEPT !.transactTime = one] : one \in Sample(8) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.underlyingPx = one] : one \in Sample(8) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.transBkdTime = one] : one \in Sample(8) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.relatedClosePrice = one] : one \in Sample(8) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.relatedTradeQuantity = one] : one \in Sample(8) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.underlyingQty = one] : one \in Sample(8) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.compressionId = one] : one \in Sample(8) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.marketSegmentId = one] : one \in Sample(4) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.packageId = one] : one \in Sample(4) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.tesExecId = one] : one \in Sample(4) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.allocId = one] : one \in Sample(4) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.underlyingSettlementDate = one] : one \in Sample(4) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.underlyingMaturityDate = one] : one \in Sample(4) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.relatedTradeId = one] : one \in Sample(4) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.relatedMarketSegmentId = one] : one \in Sample(4) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.negotiationId = one] : one \in Sample(4) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.tesEnrichmentRuleId = one] : one \in Sample(4) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.autoApprovalRuleId = one] : one \in Sample(4) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.trdType = one] : one \in Sample(2) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.side = one] : one \in Sample(1) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.tradePublishIndicator = one] : one \in Sample(1) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.productComplex = one] : one \in Sample(1) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.tradeReportType = one] : one \in Sample(1) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.trdRptStatus = one] : one \in Sample(1) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.tradingCapacity = one] : one \in Sample(1) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.partyIdSettlementLocation = one] : one \in Sample(1) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.tradeAllocStatus = one] : one \in Sample(1) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.hedgeType = one] : one \in Sample(1) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.messageEventSource = one] : one \in Sample(1) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.tradeReportId = one] : one \in Sample(20) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.partyExecutingFirm = one] : one \in Sample(5) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.partyExecutingTrader = one] : one \in Sample(6) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.partyIdEnteringFirm = one] : one \in Sample(1) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.partyEnteringTrader = one] : one \in Sample(6) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.positionEffect = one] : one \in Sample(1) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.rootPartyExecutingFirm = one] : one \in Sample(5) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.rootPartyExecutingTrader = one] : one \in Sample(6) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.freeText1 = one] : one \in Sample(12) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.freeText2 = one] : one \in Sample(12) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.freeText3 = one] : one \in Sample(12) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.partyIdTakeUpTradingFirm = one] : one \in Sample(5) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.account = one] : one \in Sample(2) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.partyIdPositionAccount = one] : one \in Sample(32) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.partyIdOrderOriginationFirm = one] : one \in Sample(7) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.partyIdBeneficiary = one] : one \in Sample(9) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.partyIdLocationId = one] : one \in Sample(2) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.custOrderHandlingInst = one] : one \in Sample(1) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.complianceText = one] : one \in Sample(20) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.underlyingSecurityId = one] : one \in Sample(12) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.underlyingSecurityDesc = one] : one \in Sample(30) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.underlyingCurrency = one] : one \in Sample(3) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.underlyingIssuer = one] : one \in Sample(30) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.pad3 = one] : one \in Sample(3) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.trdInstrmntLegGrpComp = one] : one \in SampleLists(OneTrdInstrmntLegGrpComp) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.instrumentEventGrpComp = one] : one \in SampleLists(OneInstrumentEventGrpComp) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.instrumentAttributeGrpComp = one] : one \in SampleLists(OneInstrumentAttributeGrpComp) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.underlyingStipGrpComp = one] : one \in SampleLists(OneUnderlyingStipGrpComp) }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.varText = one] : one \in SampleBytes }
        \cup { [ZeroTesApproveBroadcast EXCEPT !.alignmentPadding = one] : one \in SampleBytes }

(***************************************************************************)
(* Rbc Header Comp: 32 bytes                                               *)
(***************************************************************************)

RbcHeaderComp20 ==
    [ sendingTime    : Sample(8),
      applSeqNum     : Sample(8),
      applSubId      : Sample(4),
      partitionId    : Sample(2),
      applResendFlag : Sample(1),
      applId         : Sample(1),
      lastFragment   : Sample(1),
      pad7           : Sample(7) ]

EncodeRbcHeaderComp20(message) ==
    message.sendingTime
        \o message.applSeqNum
        \o message.applSubId
        \o message.partitionId
        \o message.applResendFlag
        \o message.applId
        \o message.lastFragment
        \o message.pad7

DecodeRbcHeaderComp20(bytes) ==
    LET sendingTime == ReadBytes(bytes, 8) IN IF ~sendingTime.ok THEN Fail ELSE
    LET applSeqNum == ReadBytes(sendingTime.rest, 8) IN IF ~applSeqNum.ok THEN Fail ELSE
    LET applSubId == ReadBytes(applSeqNum.rest, 4) IN IF ~applSubId.ok THEN Fail ELSE
    LET partitionId == ReadBytes(applSubId.rest, 2) IN IF ~partitionId.ok THEN Fail ELSE
    LET applResendFlag == ReadBytes(partitionId.rest, 1) IN IF ~applResendFlag.ok THEN Fail ELSE
    LET applId == ReadBytes(applResendFlag.rest, 1) IN IF ~applId.ok THEN Fail ELSE
    LET lastFragment == ReadBytes(applId.rest, 1) IN IF ~lastFragment.ok THEN Fail ELSE
    LET pad7 == ReadBytes(lastFragment.rest, 7) IN IF ~pad7.ok THEN Fail ELSE
    Ok([ sendingTime    |-> sendingTime.value,
         applSeqNum     |-> applSeqNum.value,
         applSubId      |-> applSubId.value,
         partitionId    |-> partitionId.value,
         applResendFlag |-> applResendFlag.value,
         applId         |-> applId.value,
         lastFragment   |-> lastFragment.value,
         pad7           |-> pad7.value ], pad7.rest)

ZeroRbcHeaderComp20 ==
    [ sendingTime    |-> [i \in 1 .. 8 |-> 0],
      applSeqNum     |-> [i \in 1 .. 8 |-> 0],
      applSubId      |-> [i \in 1 .. 4 |-> 0],
      partitionId    |-> [i \in 1 .. 2 |-> 0],
      applResendFlag |-> [i \in 1 .. 1 |-> 0],
      applId         |-> [i \in 1 .. 1 |-> 0],
      lastFragment   |-> [i \in 1 .. 1 |-> 0],
      pad7           |-> [i \in 1 .. 7 |-> 0] ]

(* Rbc Header Comp at zero, then each field in turn at the values it is checked at *)
CheckedRbcHeaderComp20 ==
    { ZeroRbcHeaderComp20 }
        \cup { [ZeroRbcHeaderComp20 EXCEPT !.sendingTime = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderComp20 EXCEPT !.applSeqNum = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderComp20 EXCEPT !.applSubId = one] : one \in Sample(4) }
        \cup { [ZeroRbcHeaderComp20 EXCEPT !.partitionId = one] : one \in Sample(2) }
        \cup { [ZeroRbcHeaderComp20 EXCEPT !.applResendFlag = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp20 EXCEPT !.applId = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp20 EXCEPT !.lastFragment = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp20 EXCEPT !.pad7 = one] : one \in Sample(7) }

(***************************************************************************)
(* Side Alloc Grp Bc Comp: 40 bytes                                        *)
(***************************************************************************)

SideAllocGrpBcComp ==
    [ allocQty             : Sample(8),
      reversalApprovalTime : Sample(8),
      individualAllocId    : Sample(4),
      tesEnrichmentRuleId  : Sample(4),
      partyExecutingFirm   : Sample(5),
      partyExecutingTrader : Sample(6),
      side                 : Sample(1),
      tradeAllocStatus     : Sample(1),
      pad3                 : Sample(3) ]

EncodeSideAllocGrpBcComp(message) ==
    message.allocQty
        \o message.reversalApprovalTime
        \o message.individualAllocId
        \o message.tesEnrichmentRuleId
        \o message.partyExecutingFirm
        \o message.partyExecutingTrader
        \o message.side
        \o message.tradeAllocStatus
        \o message.pad3

DecodeSideAllocGrpBcComp(bytes) ==
    LET allocQty == ReadBytes(bytes, 8) IN IF ~allocQty.ok THEN Fail ELSE
    LET reversalApprovalTime == ReadBytes(allocQty.rest, 8) IN IF ~reversalApprovalTime.ok THEN Fail ELSE
    LET individualAllocId == ReadBytes(reversalApprovalTime.rest, 4) IN IF ~individualAllocId.ok THEN Fail ELSE
    LET tesEnrichmentRuleId == ReadBytes(individualAllocId.rest, 4) IN IF ~tesEnrichmentRuleId.ok THEN Fail ELSE
    LET partyExecutingFirm == ReadBytes(tesEnrichmentRuleId.rest, 5) IN IF ~partyExecutingFirm.ok THEN Fail ELSE
    LET partyExecutingTrader == ReadBytes(partyExecutingFirm.rest, 6) IN IF ~partyExecutingTrader.ok THEN Fail ELSE
    LET side == ReadBytes(partyExecutingTrader.rest, 1) IN IF ~side.ok THEN Fail ELSE
    LET tradeAllocStatus == ReadBytes(side.rest, 1) IN IF ~tradeAllocStatus.ok THEN Fail ELSE
    LET pad3 == ReadBytes(tradeAllocStatus.rest, 3) IN IF ~pad3.ok THEN Fail ELSE
    Ok([ allocQty             |-> allocQty.value,
         reversalApprovalTime |-> reversalApprovalTime.value,
         individualAllocId    |-> individualAllocId.value,
         tesEnrichmentRuleId  |-> tesEnrichmentRuleId.value,
         partyExecutingFirm   |-> partyExecutingFirm.value,
         partyExecutingTrader |-> partyExecutingTrader.value,
         side                 |-> side.value,
         tradeAllocStatus     |-> tradeAllocStatus.value,
         pad3                 |-> pad3.value ], pad3.rest)

ZeroSideAllocGrpBcComp ==
    [ allocQty             |-> [i \in 1 .. 8 |-> 0],
      reversalApprovalTime |-> [i \in 1 .. 8 |-> 0],
      individualAllocId    |-> [i \in 1 .. 4 |-> 0],
      tesEnrichmentRuleId  |-> [i \in 1 .. 4 |-> 0],
      partyExecutingFirm   |-> [i \in 1 .. 5 |-> 0],
      partyExecutingTrader |-> [i \in 1 .. 6 |-> 0],
      side                 |-> [i \in 1 .. 1 |-> 0],
      tradeAllocStatus     |-> [i \in 1 .. 1 |-> 0],
      pad3                 |-> [i \in 1 .. 3 |-> 0] ]

(* Side Alloc Grp Bc Comp at zero, then each field in turn at the values it is checked at *)
CheckedSideAllocGrpBcComp ==
    { ZeroSideAllocGrpBcComp }
        \cup { [ZeroSideAllocGrpBcComp EXCEPT !.allocQty = one] : one \in Sample(8) }
        \cup { [ZeroSideAllocGrpBcComp EXCEPT !.reversalApprovalTime = one] : one \in Sample(8) }
        \cup { [ZeroSideAllocGrpBcComp EXCEPT !.individualAllocId = one] : one \in Sample(4) }
        \cup { [ZeroSideAllocGrpBcComp EXCEPT !.tesEnrichmentRuleId = one] : one \in Sample(4) }
        \cup { [ZeroSideAllocGrpBcComp EXCEPT !.partyExecutingFirm = one] : one \in Sample(5) }
        \cup { [ZeroSideAllocGrpBcComp EXCEPT !.partyExecutingTrader = one] : one \in Sample(6) }
        \cup { [ZeroSideAllocGrpBcComp EXCEPT !.side = one] : one \in Sample(1) }
        \cup { [ZeroSideAllocGrpBcComp EXCEPT !.tradeAllocStatus = one] : one \in Sample(1) }
        \cup { [ZeroSideAllocGrpBcComp EXCEPT !.pad3 = one] : one \in Sample(3) }

(* A run of Side Alloc Grp Bc Comp, written one after another *)
RECURSIVE EncodeSideAllocGrpBcCompList(_)
EncodeSideAllocGrpBcCompList(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeSideAllocGrpBcComp(Head(messages)) \o EncodeSideAllocGrpBcCompList(Tail(messages))

(* As many Side Alloc Grp Bc Comp as the field that counts them says *)
RECURSIVE ReadSideAllocGrpBcCompList(_, _)
ReadSideAllocGrpBcCompList(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeSideAllocGrpBcComp(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadSideAllocGrpBcCompList(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Side Alloc Grp Bc Comp of each kind, for the lists that carry them *)
OneSideAllocGrpBcComp == { ZeroSideAllocGrpBcComp }

(***************************************************************************)
(* Trd Instrmnt Leg Grp Comp: 24 bytes                                     *)
(***************************************************************************)

TrdInstrmntLegGrpComp2 ==
    [ legSecurityId : Sample(8),
      legPrice      : Sample(8),
      legQty        : Sample(8) ]

EncodeTrdInstrmntLegGrpComp2(message) ==
    message.legSecurityId
        \o message.legPrice
        \o message.legQty

DecodeTrdInstrmntLegGrpComp2(bytes) ==
    LET legSecurityId == ReadBytes(bytes, 8) IN IF ~legSecurityId.ok THEN Fail ELSE
    LET legPrice == ReadBytes(legSecurityId.rest, 8) IN IF ~legPrice.ok THEN Fail ELSE
    LET legQty == ReadBytes(legPrice.rest, 8) IN IF ~legQty.ok THEN Fail ELSE
    Ok([ legSecurityId |-> legSecurityId.value,
         legPrice      |-> legPrice.value,
         legQty        |-> legQty.value ], legQty.rest)

ZeroTrdInstrmntLegGrpComp2 ==
    [ legSecurityId |-> [i \in 1 .. 8 |-> 0],
      legPrice      |-> [i \in 1 .. 8 |-> 0],
      legQty        |-> [i \in 1 .. 8 |-> 0] ]

(* Trd Instrmnt Leg Grp Comp at zero, then each field in turn at the values it is checked at *)
CheckedTrdInstrmntLegGrpComp2 ==
    { ZeroTrdInstrmntLegGrpComp2 }
        \cup { [ZeroTrdInstrmntLegGrpComp2 EXCEPT !.legSecurityId = one] : one \in Sample(8) }
        \cup { [ZeroTrdInstrmntLegGrpComp2 EXCEPT !.legPrice = one] : one \in Sample(8) }
        \cup { [ZeroTrdInstrmntLegGrpComp2 EXCEPT !.legQty = one] : one \in Sample(8) }

(* A run of Trd Instrmnt Leg Grp Comp, written one after another *)
RECURSIVE EncodeTrdInstrmntLegGrpComp2List(_)
EncodeTrdInstrmntLegGrpComp2List(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeTrdInstrmntLegGrpComp2(Head(messages)) \o EncodeTrdInstrmntLegGrpComp2List(Tail(messages))

(* As many Trd Instrmnt Leg Grp Comp as the field that counts them says *)
RECURSIVE ReadTrdInstrmntLegGrpComp2List(_, _)
ReadTrdInstrmntLegGrpComp2List(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeTrdInstrmntLegGrpComp2(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadTrdInstrmntLegGrpComp2List(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Trd Instrmnt Leg Grp Comp of each kind, for the lists that carry them *)
OneTrdInstrmntLegGrpComp2 == { ZeroTrdInstrmntLegGrpComp2 }

(***************************************************************************)
(* Instrument Event Grp Comp: 8 bytes                                      *)
(***************************************************************************)

InstrumentEventGrpComp2 ==
    [ eventDate : Sample(4),
      eventType : Sample(1),
      pad3      : Sample(3) ]

EncodeInstrumentEventGrpComp2(message) ==
    message.eventDate
        \o message.eventType
        \o message.pad3

DecodeInstrumentEventGrpComp2(bytes) ==
    LET eventDate == ReadBytes(bytes, 4) IN IF ~eventDate.ok THEN Fail ELSE
    LET eventType == ReadBytes(eventDate.rest, 1) IN IF ~eventType.ok THEN Fail ELSE
    LET pad3 == ReadBytes(eventType.rest, 3) IN IF ~pad3.ok THEN Fail ELSE
    Ok([ eventDate |-> eventDate.value,
         eventType |-> eventType.value,
         pad3      |-> pad3.value ], pad3.rest)

ZeroInstrumentEventGrpComp2 ==
    [ eventDate |-> [i \in 1 .. 4 |-> 0],
      eventType |-> [i \in 1 .. 1 |-> 0],
      pad3      |-> [i \in 1 .. 3 |-> 0] ]

(* Instrument Event Grp Comp at zero, then each field in turn at the values it is checked at *)
CheckedInstrumentEventGrpComp2 ==
    { ZeroInstrumentEventGrpComp2 }
        \cup { [ZeroInstrumentEventGrpComp2 EXCEPT !.eventDate = one] : one \in Sample(4) }
        \cup { [ZeroInstrumentEventGrpComp2 EXCEPT !.eventType = one] : one \in Sample(1) }
        \cup { [ZeroInstrumentEventGrpComp2 EXCEPT !.pad3 = one] : one \in Sample(3) }

(* A run of Instrument Event Grp Comp, written one after another *)
RECURSIVE EncodeInstrumentEventGrpComp2List(_)
EncodeInstrumentEventGrpComp2List(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeInstrumentEventGrpComp2(Head(messages)) \o EncodeInstrumentEventGrpComp2List(Tail(messages))

(* As many Instrument Event Grp Comp as the field that counts them says *)
RECURSIVE ReadInstrumentEventGrpComp2List(_, _)
ReadInstrumentEventGrpComp2List(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeInstrumentEventGrpComp2(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadInstrumentEventGrpComp2List(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Instrument Event Grp Comp of each kind, for the lists that carry them *)
OneInstrumentEventGrpComp2 == { ZeroInstrumentEventGrpComp2 }

(***************************************************************************)
(* Instrument Attribute Grp Comp: 40 bytes                                 *)
(***************************************************************************)

InstrumentAttributeGrpComp2 ==
    [ instrAttribType  : Sample(1),
      instrAttribValue : Sample(32),
      pad7             : Sample(7) ]

EncodeInstrumentAttributeGrpComp2(message) ==
    message.instrAttribType
        \o message.instrAttribValue
        \o message.pad7

DecodeInstrumentAttributeGrpComp2(bytes) ==
    LET instrAttribType == ReadBytes(bytes, 1) IN IF ~instrAttribType.ok THEN Fail ELSE
    LET instrAttribValue == ReadBytes(instrAttribType.rest, 32) IN IF ~instrAttribValue.ok THEN Fail ELSE
    LET pad7 == ReadBytes(instrAttribValue.rest, 7) IN IF ~pad7.ok THEN Fail ELSE
    Ok([ instrAttribType  |-> instrAttribType.value,
         instrAttribValue |-> instrAttribValue.value,
         pad7             |-> pad7.value ], pad7.rest)

ZeroInstrumentAttributeGrpComp2 ==
    [ instrAttribType  |-> [i \in 1 .. 1 |-> 0],
      instrAttribValue |-> [i \in 1 .. 32 |-> 0],
      pad7             |-> [i \in 1 .. 7 |-> 0] ]

(* Instrument Attribute Grp Comp at zero, then each field in turn at the values it is checked at *)
CheckedInstrumentAttributeGrpComp2 ==
    { ZeroInstrumentAttributeGrpComp2 }
        \cup { [ZeroInstrumentAttributeGrpComp2 EXCEPT !.instrAttribType = one] : one \in Sample(1) }
        \cup { [ZeroInstrumentAttributeGrpComp2 EXCEPT !.instrAttribValue = one] : one \in Sample(32) }
        \cup { [ZeroInstrumentAttributeGrpComp2 EXCEPT !.pad7 = one] : one \in Sample(7) }

(* A run of Instrument Attribute Grp Comp, written one after another *)
RECURSIVE EncodeInstrumentAttributeGrpComp2List(_)
EncodeInstrumentAttributeGrpComp2List(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeInstrumentAttributeGrpComp2(Head(messages)) \o EncodeInstrumentAttributeGrpComp2List(Tail(messages))

(* As many Instrument Attribute Grp Comp as the field that counts them says *)
RECURSIVE ReadInstrumentAttributeGrpComp2List(_, _)
ReadInstrumentAttributeGrpComp2List(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeInstrumentAttributeGrpComp2(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadInstrumentAttributeGrpComp2List(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Instrument Attribute Grp Comp of each kind, for the lists that carry them *)
OneInstrumentAttributeGrpComp2 == { ZeroInstrumentAttributeGrpComp2 }

(***************************************************************************)
(* Underlying Stip Grp Comp: 40 bytes                                      *)
(***************************************************************************)

UnderlyingStipGrpComp2 ==
    [ underlyingStipValue : Sample(32),
      underlyingStipType  : Sample(7),
      pad1                : Sample(1) ]

EncodeUnderlyingStipGrpComp2(message) ==
    message.underlyingStipValue
        \o message.underlyingStipType
        \o message.pad1

DecodeUnderlyingStipGrpComp2(bytes) ==
    LET underlyingStipValue == ReadBytes(bytes, 32) IN IF ~underlyingStipValue.ok THEN Fail ELSE
    LET underlyingStipType == ReadBytes(underlyingStipValue.rest, 7) IN IF ~underlyingStipType.ok THEN Fail ELSE
    LET pad1 == ReadBytes(underlyingStipType.rest, 1) IN IF ~pad1.ok THEN Fail ELSE
    Ok([ underlyingStipValue |-> underlyingStipValue.value,
         underlyingStipType  |-> underlyingStipType.value,
         pad1                |-> pad1.value ], pad1.rest)

ZeroUnderlyingStipGrpComp2 ==
    [ underlyingStipValue |-> [i \in 1 .. 32 |-> 0],
      underlyingStipType  |-> [i \in 1 .. 7 |-> 0],
      pad1                |-> [i \in 1 .. 1 |-> 0] ]

(* Underlying Stip Grp Comp at zero, then each field in turn at the values it is checked at *)
CheckedUnderlyingStipGrpComp2 ==
    { ZeroUnderlyingStipGrpComp2 }
        \cup { [ZeroUnderlyingStipGrpComp2 EXCEPT !.underlyingStipValue = one] : one \in Sample(32) }
        \cup { [ZeroUnderlyingStipGrpComp2 EXCEPT !.underlyingStipType = one] : one \in Sample(7) }
        \cup { [ZeroUnderlyingStipGrpComp2 EXCEPT !.pad1 = one] : one \in Sample(1) }

(* A run of Underlying Stip Grp Comp, written one after another *)
RECURSIVE EncodeUnderlyingStipGrpComp2List(_)
EncodeUnderlyingStipGrpComp2List(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeUnderlyingStipGrpComp2(Head(messages)) \o EncodeUnderlyingStipGrpComp2List(Tail(messages))

(* As many Underlying Stip Grp Comp as the field that counts them says *)
RECURSIVE ReadUnderlyingStipGrpComp2List(_, _)
ReadUnderlyingStipGrpComp2List(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeUnderlyingStipGrpComp2(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadUnderlyingStipGrpComp2List(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Underlying Stip Grp Comp of each kind, for the lists that carry them *)
OneUnderlyingStipGrpComp2 == { ZeroUnderlyingStipGrpComp2 }

(***************************************************************************)
(* Tes Broadcast                                                           *)
(***************************************************************************)

TesBroadcast ==
    [ pad2                       : Sample(2),
      rbcHeaderComp              : RbcHeaderComp20,
      securityId                 : Sample(8),
      lastPx                     : Sample(8),
      transactTime               : Sample(8),
      underlyingPx               : Sample(8),
      transBkdTime               : Sample(8),
      relatedClosePrice          : Sample(8),
      relatedTradeQuantity       : Sample(8),
      underlyingQty              : Sample(8),
      compressionId              : Sample(8),
      marketSegmentId            : Sample(4),
      packageId                  : Sample(4),
      tesExecId                  : Sample(4),
      underlyingSettlementDate   : Sample(4),
      underlyingMaturityDate     : Sample(4),
      relatedTradeId             : Sample(4),
      relatedMarketSegmentId     : Sample(4),
      autoApprovalRuleId         : Sample(4),
      trdType                    : Sample(2),
      tradeReportType            : Sample(1),
      trdRptStatus               : Sample(1),
      productComplex             : Sample(1),
      tradePublishIndicator      : Sample(1),
      partyIdSettlementLocation  : Sample(1),
      hedgeType                  : Sample(1),
      swapClearer                : Sample(1),
      messageEventSource         : Sample(1),
      tradeReportText            : Sample(20),
      tradeReportId              : Sample(20),
      rootPartyExecutingFirm     : Sample(5),
      rootPartyExecutingTrader   : Sample(6),
      underlyingSecurityId       : Sample(12),
      underlyingSecurityDesc     : Sample(30),
      underlyingCurrency         : Sample(3),
      underlyingIssuer           : Sample(30),
      pad1                       : Sample(1),
      sideAllocGrpBcComp         : SampleLists(OneSideAllocGrpBcComp),
      trdInstrmntLegGrpComp      : SampleLists(OneTrdInstrmntLegGrpComp2),
      instrumentEventGrpComp     : SampleLists(OneInstrumentEventGrpComp2),
      instrumentAttributeGrpComp : SampleLists(OneInstrumentAttributeGrpComp2),
      underlyingStipGrpComp      : SampleLists(OneUnderlyingStipGrpComp2),
      varText                    : SampleBytes,
      alignmentPadding           : SampleBytes ]

EncodeTesBroadcast(message) ==
    message.pad2
        \o EncodeRbcHeaderComp20(message.rbcHeaderComp)
        \o message.securityId
        \o message.lastPx
        \o message.transactTime
        \o message.underlyingPx
        \o message.transBkdTime
        \o message.relatedClosePrice
        \o message.relatedTradeQuantity
        \o message.underlyingQty
        \o message.compressionId
        \o message.marketSegmentId
        \o message.packageId
        \o message.tesExecId
        \o message.underlyingSettlementDate
        \o message.underlyingMaturityDate
        \o message.relatedTradeId
        \o message.relatedMarketSegmentId
        \o message.autoApprovalRuleId
        \o message.trdType
        \o EncodeUIntLE(Len(message.varText), 2)
        \o message.tradeReportType
        \o message.trdRptStatus
        \o message.productComplex
        \o message.tradePublishIndicator
        \o EncodeUIntBE(Len(message.instrumentEventGrpComp), 1)
        \o EncodeUIntBE(Len(message.instrumentAttributeGrpComp), 1)
        \o EncodeUIntBE(Len(message.underlyingStipGrpComp), 1)
        \o EncodeUIntBE(Len(message.sideAllocGrpBcComp), 1)
        \o EncodeUIntBE(Len(message.trdInstrmntLegGrpComp), 1)
        \o message.partyIdSettlementLocation
        \o message.hedgeType
        \o message.swapClearer
        \o message.messageEventSource
        \o message.tradeReportText
        \o message.tradeReportId
        \o message.rootPartyExecutingFirm
        \o message.rootPartyExecutingTrader
        \o message.underlyingSecurityId
        \o message.underlyingSecurityDesc
        \o message.underlyingCurrency
        \o message.underlyingIssuer
        \o message.pad1
        \o EncodeSideAllocGrpBcCompList(message.sideAllocGrpBcComp)
        \o EncodeTrdInstrmntLegGrpComp2List(message.trdInstrmntLegGrpComp)
        \o EncodeInstrumentEventGrpComp2List(message.instrumentEventGrpComp)
        \o EncodeInstrumentAttributeGrpComp2List(message.instrumentAttributeGrpComp)
        \o EncodeUnderlyingStipGrpComp2List(message.underlyingStipGrpComp)
        \o message.varText
        \o message.alignmentPadding

DecodeTesBroadcast(bytes) ==
    LET pad2 == ReadBytes(bytes, 2) IN IF ~pad2.ok THEN Fail ELSE
    LET rbcHeaderComp == DecodeRbcHeaderComp20(pad2.rest) IN IF ~rbcHeaderComp.ok THEN Fail ELSE
    LET securityId == ReadBytes(rbcHeaderComp.rest, 8) IN IF ~securityId.ok THEN Fail ELSE
    LET lastPx == ReadBytes(securityId.rest, 8) IN IF ~lastPx.ok THEN Fail ELSE
    LET transactTime == ReadBytes(lastPx.rest, 8) IN IF ~transactTime.ok THEN Fail ELSE
    LET underlyingPx == ReadBytes(transactTime.rest, 8) IN IF ~underlyingPx.ok THEN Fail ELSE
    LET transBkdTime == ReadBytes(underlyingPx.rest, 8) IN IF ~transBkdTime.ok THEN Fail ELSE
    LET relatedClosePrice == ReadBytes(transBkdTime.rest, 8) IN IF ~relatedClosePrice.ok THEN Fail ELSE
    LET relatedTradeQuantity == ReadBytes(relatedClosePrice.rest, 8) IN IF ~relatedTradeQuantity.ok THEN Fail ELSE
    LET underlyingQty == ReadBytes(relatedTradeQuantity.rest, 8) IN IF ~underlyingQty.ok THEN Fail ELSE
    LET compressionId == ReadBytes(underlyingQty.rest, 8) IN IF ~compressionId.ok THEN Fail ELSE
    LET marketSegmentId == ReadBytes(compressionId.rest, 4) IN IF ~marketSegmentId.ok THEN Fail ELSE
    LET packageId == ReadBytes(marketSegmentId.rest, 4) IN IF ~packageId.ok THEN Fail ELSE
    LET tesExecId == ReadBytes(packageId.rest, 4) IN IF ~tesExecId.ok THEN Fail ELSE
    LET underlyingSettlementDate == ReadBytes(tesExecId.rest, 4) IN IF ~underlyingSettlementDate.ok THEN Fail ELSE
    LET underlyingMaturityDate == ReadBytes(underlyingSettlementDate.rest, 4) IN IF ~underlyingMaturityDate.ok THEN Fail ELSE
    LET relatedTradeId == ReadBytes(underlyingMaturityDate.rest, 4) IN IF ~relatedTradeId.ok THEN Fail ELSE
    LET relatedMarketSegmentId == ReadBytes(relatedTradeId.rest, 4) IN IF ~relatedMarketSegmentId.ok THEN Fail ELSE
    LET autoApprovalRuleId == ReadBytes(relatedMarketSegmentId.rest, 4) IN IF ~autoApprovalRuleId.ok THEN Fail ELSE
    LET trdType == ReadBytes(autoApprovalRuleId.rest, 2) IN IF ~trdType.ok THEN Fail ELSE
    LET varTextLen == ReadUIntLE(trdType.rest, 2) IN IF ~varTextLen.ok THEN Fail ELSE
    LET tradeReportType == ReadBytes(varTextLen.rest, 1) IN IF ~tradeReportType.ok THEN Fail ELSE
    LET trdRptStatus == ReadBytes(tradeReportType.rest, 1) IN IF ~trdRptStatus.ok THEN Fail ELSE
    LET productComplex == ReadBytes(trdRptStatus.rest, 1) IN IF ~productComplex.ok THEN Fail ELSE
    LET tradePublishIndicator == ReadBytes(productComplex.rest, 1) IN IF ~tradePublishIndicator.ok THEN Fail ELSE
    LET noEvents == ReadUIntBE(tradePublishIndicator.rest, 1) IN IF ~noEvents.ok THEN Fail ELSE
    LET noInstrAttrib == ReadUIntBE(noEvents.rest, 1) IN IF ~noInstrAttrib.ok THEN Fail ELSE
    LET noUnderlyingStips == ReadUIntBE(noInstrAttrib.rest, 1) IN IF ~noUnderlyingStips.ok THEN Fail ELSE
    LET noSideAllocs == ReadUIntBE(noUnderlyingStips.rest, 1) IN IF ~noSideAllocs.ok THEN Fail ELSE
    LET noLegs == ReadUIntBE(noSideAllocs.rest, 1) IN IF ~noLegs.ok THEN Fail ELSE
    LET partyIdSettlementLocation == ReadBytes(noLegs.rest, 1) IN IF ~partyIdSettlementLocation.ok THEN Fail ELSE
    LET hedgeType == ReadBytes(partyIdSettlementLocation.rest, 1) IN IF ~hedgeType.ok THEN Fail ELSE
    LET swapClearer == ReadBytes(hedgeType.rest, 1) IN IF ~swapClearer.ok THEN Fail ELSE
    LET messageEventSource == ReadBytes(swapClearer.rest, 1) IN IF ~messageEventSource.ok THEN Fail ELSE
    LET tradeReportText == ReadBytes(messageEventSource.rest, 20) IN IF ~tradeReportText.ok THEN Fail ELSE
    LET tradeReportId == ReadBytes(tradeReportText.rest, 20) IN IF ~tradeReportId.ok THEN Fail ELSE
    LET rootPartyExecutingFirm == ReadBytes(tradeReportId.rest, 5) IN IF ~rootPartyExecutingFirm.ok THEN Fail ELSE
    LET rootPartyExecutingTrader == ReadBytes(rootPartyExecutingFirm.rest, 6) IN IF ~rootPartyExecutingTrader.ok THEN Fail ELSE
    LET underlyingSecurityId == ReadBytes(rootPartyExecutingTrader.rest, 12) IN IF ~underlyingSecurityId.ok THEN Fail ELSE
    LET underlyingSecurityDesc == ReadBytes(underlyingSecurityId.rest, 30) IN IF ~underlyingSecurityDesc.ok THEN Fail ELSE
    LET underlyingCurrency == ReadBytes(underlyingSecurityDesc.rest, 3) IN IF ~underlyingCurrency.ok THEN Fail ELSE
    LET underlyingIssuer == ReadBytes(underlyingCurrency.rest, 30) IN IF ~underlyingIssuer.ok THEN Fail ELSE
    LET pad1 == ReadBytes(underlyingIssuer.rest, 1) IN IF ~pad1.ok THEN Fail ELSE
    LET sideAllocGrpBcComp == ReadSideAllocGrpBcCompList(pad1.rest, noSideAllocs.value) IN IF ~sideAllocGrpBcComp.ok THEN Fail ELSE
    LET trdInstrmntLegGrpComp == ReadTrdInstrmntLegGrpComp2List(sideAllocGrpBcComp.rest, noLegs.value) IN IF ~trdInstrmntLegGrpComp.ok THEN Fail ELSE
    LET instrumentEventGrpComp == ReadInstrumentEventGrpComp2List(trdInstrmntLegGrpComp.rest, noEvents.value) IN IF ~instrumentEventGrpComp.ok THEN Fail ELSE
    LET instrumentAttributeGrpComp == ReadInstrumentAttributeGrpComp2List(instrumentEventGrpComp.rest, noInstrAttrib.value) IN IF ~instrumentAttributeGrpComp.ok THEN Fail ELSE
    LET underlyingStipGrpComp == ReadUnderlyingStipGrpComp2List(instrumentAttributeGrpComp.rest, noUnderlyingStips.value) IN IF ~underlyingStipGrpComp.ok THEN Fail ELSE
    LET varText == ReadBytes(underlyingStipGrpComp.rest, varTextLen.value) IN IF ~varText.ok THEN Fail ELSE
    LET alignmentPadding == Ok(varText.rest, << >>) IN IF ~alignmentPadding.ok THEN Fail ELSE
    Ok([ pad2                       |-> pad2.value,
         rbcHeaderComp              |-> rbcHeaderComp.value,
         securityId                 |-> securityId.value,
         lastPx                     |-> lastPx.value,
         transactTime               |-> transactTime.value,
         underlyingPx               |-> underlyingPx.value,
         transBkdTime               |-> transBkdTime.value,
         relatedClosePrice          |-> relatedClosePrice.value,
         relatedTradeQuantity       |-> relatedTradeQuantity.value,
         underlyingQty              |-> underlyingQty.value,
         compressionId              |-> compressionId.value,
         marketSegmentId            |-> marketSegmentId.value,
         packageId                  |-> packageId.value,
         tesExecId                  |-> tesExecId.value,
         underlyingSettlementDate   |-> underlyingSettlementDate.value,
         underlyingMaturityDate     |-> underlyingMaturityDate.value,
         relatedTradeId             |-> relatedTradeId.value,
         relatedMarketSegmentId     |-> relatedMarketSegmentId.value,
         autoApprovalRuleId         |-> autoApprovalRuleId.value,
         trdType                    |-> trdType.value,
         tradeReportType            |-> tradeReportType.value,
         trdRptStatus               |-> trdRptStatus.value,
         productComplex             |-> productComplex.value,
         tradePublishIndicator      |-> tradePublishIndicator.value,
         partyIdSettlementLocation  |-> partyIdSettlementLocation.value,
         hedgeType                  |-> hedgeType.value,
         swapClearer                |-> swapClearer.value,
         messageEventSource         |-> messageEventSource.value,
         tradeReportText            |-> tradeReportText.value,
         tradeReportId              |-> tradeReportId.value,
         rootPartyExecutingFirm     |-> rootPartyExecutingFirm.value,
         rootPartyExecutingTrader   |-> rootPartyExecutingTrader.value,
         underlyingSecurityId       |-> underlyingSecurityId.value,
         underlyingSecurityDesc     |-> underlyingSecurityDesc.value,
         underlyingCurrency         |-> underlyingCurrency.value,
         underlyingIssuer           |-> underlyingIssuer.value,
         pad1                       |-> pad1.value,
         sideAllocGrpBcComp         |-> sideAllocGrpBcComp.value,
         trdInstrmntLegGrpComp      |-> trdInstrmntLegGrpComp.value,
         instrumentEventGrpComp     |-> instrumentEventGrpComp.value,
         instrumentAttributeGrpComp |-> instrumentAttributeGrpComp.value,
         underlyingStipGrpComp      |-> underlyingStipGrpComp.value,
         varText                    |-> varText.value,
         alignmentPadding           |-> alignmentPadding.value ], alignmentPadding.rest)

ZeroTesBroadcast ==
    [ pad2                       |-> [i \in 1 .. 2 |-> 0],
      rbcHeaderComp              |-> ZeroRbcHeaderComp20,
      securityId                 |-> [i \in 1 .. 8 |-> 0],
      lastPx                     |-> [i \in 1 .. 8 |-> 0],
      transactTime               |-> [i \in 1 .. 8 |-> 0],
      underlyingPx               |-> [i \in 1 .. 8 |-> 0],
      transBkdTime               |-> [i \in 1 .. 8 |-> 0],
      relatedClosePrice          |-> [i \in 1 .. 8 |-> 0],
      relatedTradeQuantity       |-> [i \in 1 .. 8 |-> 0],
      underlyingQty              |-> [i \in 1 .. 8 |-> 0],
      compressionId              |-> [i \in 1 .. 8 |-> 0],
      marketSegmentId            |-> [i \in 1 .. 4 |-> 0],
      packageId                  |-> [i \in 1 .. 4 |-> 0],
      tesExecId                  |-> [i \in 1 .. 4 |-> 0],
      underlyingSettlementDate   |-> [i \in 1 .. 4 |-> 0],
      underlyingMaturityDate     |-> [i \in 1 .. 4 |-> 0],
      relatedTradeId             |-> [i \in 1 .. 4 |-> 0],
      relatedMarketSegmentId     |-> [i \in 1 .. 4 |-> 0],
      autoApprovalRuleId         |-> [i \in 1 .. 4 |-> 0],
      trdType                    |-> [i \in 1 .. 2 |-> 0],
      tradeReportType            |-> [i \in 1 .. 1 |-> 0],
      trdRptStatus               |-> [i \in 1 .. 1 |-> 0],
      productComplex             |-> [i \in 1 .. 1 |-> 0],
      tradePublishIndicator      |-> [i \in 1 .. 1 |-> 0],
      partyIdSettlementLocation  |-> [i \in 1 .. 1 |-> 0],
      hedgeType                  |-> [i \in 1 .. 1 |-> 0],
      swapClearer                |-> [i \in 1 .. 1 |-> 0],
      messageEventSource         |-> [i \in 1 .. 1 |-> 0],
      tradeReportText            |-> [i \in 1 .. 20 |-> 0],
      tradeReportId              |-> [i \in 1 .. 20 |-> 0],
      rootPartyExecutingFirm     |-> [i \in 1 .. 5 |-> 0],
      rootPartyExecutingTrader   |-> [i \in 1 .. 6 |-> 0],
      underlyingSecurityId       |-> [i \in 1 .. 12 |-> 0],
      underlyingSecurityDesc     |-> [i \in 1 .. 30 |-> 0],
      underlyingCurrency         |-> [i \in 1 .. 3 |-> 0],
      underlyingIssuer           |-> [i \in 1 .. 30 |-> 0],
      pad1                       |-> [i \in 1 .. 1 |-> 0],
      sideAllocGrpBcComp         |-> << >>,
      trdInstrmntLegGrpComp      |-> << >>,
      instrumentEventGrpComp     |-> << >>,
      instrumentAttributeGrpComp |-> << >>,
      underlyingStipGrpComp      |-> << >>,
      varText                    |-> << >>,
      alignmentPadding           |-> << >> ]

(* Tes Broadcast at zero, then each field in turn at the values it is checked at *)
CheckedTesBroadcast ==
    { ZeroTesBroadcast }
        \cup { [ZeroTesBroadcast EXCEPT !.pad2 = one] : one \in Sample(2) }
        \cup { [ZeroTesBroadcast EXCEPT !.rbcHeaderComp = one] : one \in CheckedRbcHeaderComp20 }
        \cup { [ZeroTesBroadcast EXCEPT !.securityId = one] : one \in Sample(8) }
        \cup { [ZeroTesBroadcast EXCEPT !.lastPx = one] : one \in Sample(8) }
        \cup { [ZeroTesBroadcast EXCEPT !.transactTime = one] : one \in Sample(8) }
        \cup { [ZeroTesBroadcast EXCEPT !.underlyingPx = one] : one \in Sample(8) }
        \cup { [ZeroTesBroadcast EXCEPT !.transBkdTime = one] : one \in Sample(8) }
        \cup { [ZeroTesBroadcast EXCEPT !.relatedClosePrice = one] : one \in Sample(8) }
        \cup { [ZeroTesBroadcast EXCEPT !.relatedTradeQuantity = one] : one \in Sample(8) }
        \cup { [ZeroTesBroadcast EXCEPT !.underlyingQty = one] : one \in Sample(8) }
        \cup { [ZeroTesBroadcast EXCEPT !.compressionId = one] : one \in Sample(8) }
        \cup { [ZeroTesBroadcast EXCEPT !.marketSegmentId = one] : one \in Sample(4) }
        \cup { [ZeroTesBroadcast EXCEPT !.packageId = one] : one \in Sample(4) }
        \cup { [ZeroTesBroadcast EXCEPT !.tesExecId = one] : one \in Sample(4) }
        \cup { [ZeroTesBroadcast EXCEPT !.underlyingSettlementDate = one] : one \in Sample(4) }
        \cup { [ZeroTesBroadcast EXCEPT !.underlyingMaturityDate = one] : one \in Sample(4) }
        \cup { [ZeroTesBroadcast EXCEPT !.relatedTradeId = one] : one \in Sample(4) }
        \cup { [ZeroTesBroadcast EXCEPT !.relatedMarketSegmentId = one] : one \in Sample(4) }
        \cup { [ZeroTesBroadcast EXCEPT !.autoApprovalRuleId = one] : one \in Sample(4) }
        \cup { [ZeroTesBroadcast EXCEPT !.trdType = one] : one \in Sample(2) }
        \cup { [ZeroTesBroadcast EXCEPT !.tradeReportType = one] : one \in Sample(1) }
        \cup { [ZeroTesBroadcast EXCEPT !.trdRptStatus = one] : one \in Sample(1) }
        \cup { [ZeroTesBroadcast EXCEPT !.productComplex = one] : one \in Sample(1) }
        \cup { [ZeroTesBroadcast EXCEPT !.tradePublishIndicator = one] : one \in Sample(1) }
        \cup { [ZeroTesBroadcast EXCEPT !.partyIdSettlementLocation = one] : one \in Sample(1) }
        \cup { [ZeroTesBroadcast EXCEPT !.hedgeType = one] : one \in Sample(1) }
        \cup { [ZeroTesBroadcast EXCEPT !.swapClearer = one] : one \in Sample(1) }
        \cup { [ZeroTesBroadcast EXCEPT !.messageEventSource = one] : one \in Sample(1) }
        \cup { [ZeroTesBroadcast EXCEPT !.tradeReportText = one] : one \in Sample(20) }
        \cup { [ZeroTesBroadcast EXCEPT !.tradeReportId = one] : one \in Sample(20) }
        \cup { [ZeroTesBroadcast EXCEPT !.rootPartyExecutingFirm = one] : one \in Sample(5) }
        \cup { [ZeroTesBroadcast EXCEPT !.rootPartyExecutingTrader = one] : one \in Sample(6) }
        \cup { [ZeroTesBroadcast EXCEPT !.underlyingSecurityId = one] : one \in Sample(12) }
        \cup { [ZeroTesBroadcast EXCEPT !.underlyingSecurityDesc = one] : one \in Sample(30) }
        \cup { [ZeroTesBroadcast EXCEPT !.underlyingCurrency = one] : one \in Sample(3) }
        \cup { [ZeroTesBroadcast EXCEPT !.underlyingIssuer = one] : one \in Sample(30) }
        \cup { [ZeroTesBroadcast EXCEPT !.pad1 = one] : one \in Sample(1) }
        \cup { [ZeroTesBroadcast EXCEPT !.sideAllocGrpBcComp = one] : one \in SampleLists(OneSideAllocGrpBcComp) }
        \cup { [ZeroTesBroadcast EXCEPT !.trdInstrmntLegGrpComp = one] : one \in SampleLists(OneTrdInstrmntLegGrpComp2) }
        \cup { [ZeroTesBroadcast EXCEPT !.instrumentEventGrpComp = one] : one \in SampleLists(OneInstrumentEventGrpComp2) }
        \cup { [ZeroTesBroadcast EXCEPT !.instrumentAttributeGrpComp = one] : one \in SampleLists(OneInstrumentAttributeGrpComp2) }
        \cup { [ZeroTesBroadcast EXCEPT !.underlyingStipGrpComp = one] : one \in SampleLists(OneUnderlyingStipGrpComp2) }
        \cup { [ZeroTesBroadcast EXCEPT !.varText = one] : one \in SampleBytes }
        \cup { [ZeroTesBroadcast EXCEPT !.alignmentPadding = one] : one \in SampleBytes }

(***************************************************************************)
(* Rbc Header Comp: 32 bytes                                               *)
(***************************************************************************)

RbcHeaderComp21 ==
    [ sendingTime    : Sample(8),
      applSeqNum     : Sample(8),
      applSubId      : Sample(4),
      partitionId    : Sample(2),
      applResendFlag : Sample(1),
      applId         : Sample(1),
      lastFragment   : Sample(1),
      pad7           : Sample(7) ]

EncodeRbcHeaderComp21(message) ==
    message.sendingTime
        \o message.applSeqNum
        \o message.applSubId
        \o message.partitionId
        \o message.applResendFlag
        \o message.applId
        \o message.lastFragment
        \o message.pad7

DecodeRbcHeaderComp21(bytes) ==
    LET sendingTime == ReadBytes(bytes, 8) IN IF ~sendingTime.ok THEN Fail ELSE
    LET applSeqNum == ReadBytes(sendingTime.rest, 8) IN IF ~applSeqNum.ok THEN Fail ELSE
    LET applSubId == ReadBytes(applSeqNum.rest, 4) IN IF ~applSubId.ok THEN Fail ELSE
    LET partitionId == ReadBytes(applSubId.rest, 2) IN IF ~partitionId.ok THEN Fail ELSE
    LET applResendFlag == ReadBytes(partitionId.rest, 1) IN IF ~applResendFlag.ok THEN Fail ELSE
    LET applId == ReadBytes(applResendFlag.rest, 1) IN IF ~applId.ok THEN Fail ELSE
    LET lastFragment == ReadBytes(applId.rest, 1) IN IF ~lastFragment.ok THEN Fail ELSE
    LET pad7 == ReadBytes(lastFragment.rest, 7) IN IF ~pad7.ok THEN Fail ELSE
    Ok([ sendingTime    |-> sendingTime.value,
         applSeqNum     |-> applSeqNum.value,
         applSubId      |-> applSubId.value,
         partitionId    |-> partitionId.value,
         applResendFlag |-> applResendFlag.value,
         applId         |-> applId.value,
         lastFragment   |-> lastFragment.value,
         pad7           |-> pad7.value ], pad7.rest)

ZeroRbcHeaderComp21 ==
    [ sendingTime    |-> [i \in 1 .. 8 |-> 0],
      applSeqNum     |-> [i \in 1 .. 8 |-> 0],
      applSubId      |-> [i \in 1 .. 4 |-> 0],
      partitionId    |-> [i \in 1 .. 2 |-> 0],
      applResendFlag |-> [i \in 1 .. 1 |-> 0],
      applId         |-> [i \in 1 .. 1 |-> 0],
      lastFragment   |-> [i \in 1 .. 1 |-> 0],
      pad7           |-> [i \in 1 .. 7 |-> 0] ]

(* Rbc Header Comp at zero, then each field in turn at the values it is checked at *)
CheckedRbcHeaderComp21 ==
    { ZeroRbcHeaderComp21 }
        \cup { [ZeroRbcHeaderComp21 EXCEPT !.sendingTime = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderComp21 EXCEPT !.applSeqNum = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderComp21 EXCEPT !.applSubId = one] : one \in Sample(4) }
        \cup { [ZeroRbcHeaderComp21 EXCEPT !.partitionId = one] : one \in Sample(2) }
        \cup { [ZeroRbcHeaderComp21 EXCEPT !.applResendFlag = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp21 EXCEPT !.applId = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp21 EXCEPT !.lastFragment = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp21 EXCEPT !.pad7 = one] : one \in Sample(7) }

(***************************************************************************)
(* Tes Compression Run Status Broadcast: 50 bytes                          *)
(***************************************************************************)

TesCompressionRunStatusBroadcast ==
    [ pad2                  : Sample(2),
      rbcHeaderComp         : RbcHeaderComp21,
      compressionId         : Sample(8),
      marketSegmentId       : Sample(4),
      compressionAction     : Sample(1),
      compressionStatus     : Sample(1),
      tradePublishIndicator : Sample(1),
      pad1                  : Sample(1) ]

EncodeTesCompressionRunStatusBroadcast(message) ==
    message.pad2
        \o EncodeRbcHeaderComp21(message.rbcHeaderComp)
        \o message.compressionId
        \o message.marketSegmentId
        \o message.compressionAction
        \o message.compressionStatus
        \o message.tradePublishIndicator
        \o message.pad1

DecodeTesCompressionRunStatusBroadcast(bytes) ==
    LET pad2 == ReadBytes(bytes, 2) IN IF ~pad2.ok THEN Fail ELSE
    LET rbcHeaderComp == DecodeRbcHeaderComp21(pad2.rest) IN IF ~rbcHeaderComp.ok THEN Fail ELSE
    LET compressionId == ReadBytes(rbcHeaderComp.rest, 8) IN IF ~compressionId.ok THEN Fail ELSE
    LET marketSegmentId == ReadBytes(compressionId.rest, 4) IN IF ~marketSegmentId.ok THEN Fail ELSE
    LET compressionAction == ReadBytes(marketSegmentId.rest, 1) IN IF ~compressionAction.ok THEN Fail ELSE
    LET compressionStatus == ReadBytes(compressionAction.rest, 1) IN IF ~compressionStatus.ok THEN Fail ELSE
    LET tradePublishIndicator == ReadBytes(compressionStatus.rest, 1) IN IF ~tradePublishIndicator.ok THEN Fail ELSE
    LET pad1 == ReadBytes(tradePublishIndicator.rest, 1) IN IF ~pad1.ok THEN Fail ELSE
    Ok([ pad2                  |-> pad2.value,
         rbcHeaderComp         |-> rbcHeaderComp.value,
         compressionId         |-> compressionId.value,
         marketSegmentId       |-> marketSegmentId.value,
         compressionAction     |-> compressionAction.value,
         compressionStatus     |-> compressionStatus.value,
         tradePublishIndicator |-> tradePublishIndicator.value,
         pad1                  |-> pad1.value ], pad1.rest)

ZeroTesCompressionRunStatusBroadcast ==
    [ pad2                  |-> [i \in 1 .. 2 |-> 0],
      rbcHeaderComp         |-> ZeroRbcHeaderComp21,
      compressionId         |-> [i \in 1 .. 8 |-> 0],
      marketSegmentId       |-> [i \in 1 .. 4 |-> 0],
      compressionAction     |-> [i \in 1 .. 1 |-> 0],
      compressionStatus     |-> [i \in 1 .. 1 |-> 0],
      tradePublishIndicator |-> [i \in 1 .. 1 |-> 0],
      pad1                  |-> [i \in 1 .. 1 |-> 0] ]

(* Tes Compression Run Status Broadcast at zero, then each field in turn at the values it is checked at *)
CheckedTesCompressionRunStatusBroadcast ==
    { ZeroTesCompressionRunStatusBroadcast }
        \cup { [ZeroTesCompressionRunStatusBroadcast EXCEPT !.pad2 = one] : one \in Sample(2) }
        \cup { [ZeroTesCompressionRunStatusBroadcast EXCEPT !.rbcHeaderComp = one] : one \in CheckedRbcHeaderComp21 }
        \cup { [ZeroTesCompressionRunStatusBroadcast EXCEPT !.compressionId = one] : one \in Sample(8) }
        \cup { [ZeroTesCompressionRunStatusBroadcast EXCEPT !.marketSegmentId = one] : one \in Sample(4) }
        \cup { [ZeroTesCompressionRunStatusBroadcast EXCEPT !.compressionAction = one] : one \in Sample(1) }
        \cup { [ZeroTesCompressionRunStatusBroadcast EXCEPT !.compressionStatus = one] : one \in Sample(1) }
        \cup { [ZeroTesCompressionRunStatusBroadcast EXCEPT !.tradePublishIndicator = one] : one \in Sample(1) }
        \cup { [ZeroTesCompressionRunStatusBroadcast EXCEPT !.pad1 = one] : one \in Sample(1) }

(***************************************************************************)
(* Response Header Comp: 24 bytes                                          *)
(***************************************************************************)

ResponseHeaderComp13 ==
    [ requestTime : Sample(8),
      sendingTime : Sample(8),
      msgSeqNum   : Sample(4),
      pad4        : Sample(4) ]

EncodeResponseHeaderComp13(message) ==
    message.requestTime
        \o message.sendingTime
        \o message.msgSeqNum
        \o message.pad4

DecodeResponseHeaderComp13(bytes) ==
    LET requestTime == ReadBytes(bytes, 8) IN IF ~requestTime.ok THEN Fail ELSE
    LET sendingTime == ReadBytes(requestTime.rest, 8) IN IF ~sendingTime.ok THEN Fail ELSE
    LET msgSeqNum == ReadBytes(sendingTime.rest, 4) IN IF ~msgSeqNum.ok THEN Fail ELSE
    LET pad4 == ReadBytes(msgSeqNum.rest, 4) IN IF ~pad4.ok THEN Fail ELSE
    Ok([ requestTime |-> requestTime.value,
         sendingTime |-> sendingTime.value,
         msgSeqNum   |-> msgSeqNum.value,
         pad4        |-> pad4.value ], pad4.rest)

ZeroResponseHeaderComp13 ==
    [ requestTime |-> [i \in 1 .. 8 |-> 0],
      sendingTime |-> [i \in 1 .. 8 |-> 0],
      msgSeqNum   |-> [i \in 1 .. 4 |-> 0],
      pad4        |-> [i \in 1 .. 4 |-> 0] ]

(* Response Header Comp at zero, then each field in turn at the values it is checked at *)
CheckedResponseHeaderComp13 ==
    { ZeroResponseHeaderComp13 }
        \cup { [ZeroResponseHeaderComp13 EXCEPT !.requestTime = one] : one \in Sample(8) }
        \cup { [ZeroResponseHeaderComp13 EXCEPT !.sendingTime = one] : one \in Sample(8) }
        \cup { [ZeroResponseHeaderComp13 EXCEPT !.msgSeqNum = one] : one \in Sample(4) }
        \cup { [ZeroResponseHeaderComp13 EXCEPT !.pad4 = one] : one \in Sample(4) }

(***************************************************************************)
