      t7EntryServiceRtmTradeDate : Sample(4),
      partitionId                : Sample(2),
      matchingEngineStatus       : Sample(1),
      tradeManagerStatus         : Sample(1),
      applSeqStatus              : Sample(1),
      t7EntryServiceStatus       : Sample(1),
      t7EntryServiceRtmStatus    : Sample(1),
      pad5                       : Sample(5) ]

