      refApplLastSeqNum     |-> [i \in 1 .. 8 |-> 0],
      applTotalMessageCount |-> [i \in 1 .. 2 |-> 0],
      pad6                  |-> [i \in 1 .. 6 |-> 0] ]

(* Retransmit Response at zero, then each field in turn at the values it is checked at *)
CheckedRetransmitResponse ==
    { ZeroRetransmitResponse }
        \cup { [ZeroRetransmitResponse EXCEPT !.pad2 = one] : one \in Sample(2) }
        \cup { [ZeroRetransmitResponse EXCEPT !.responseHeaderComp = one] : one \in CheckedResponseHeaderComp8 }
        \cup { [ZeroRetransmitResponse EXCEPT !.applEndSeqNum = one] : one \in Sample(8) }
        \cup { [ZeroRetransmitResponse EXCEPT !.refApplLastSeqNum = one] : one \in Sample(8) }
        \cup { [ZeroRetransmitResponse EXCEPT !.applTotalMessageCount = one] : one \in Sample(2) }
        \cup { [ZeroRetransmitResponse EXCEPT !.pad6 = one] : one \in Sample(6) }

(***************************************************************************)
(* Rbc Header Comp: 32 bytes                                               *)
(***************************************************************************)

RbcHeaderComp9 ==
    [ sendingTime    : Sample(8),
      applSeqNum     : Sample(8),
      applSubId      : Sample(4),
      partitionId    : Sample(2),
      applResendFlag : Sample(1),
      applId         : Sample(1),
      lastFragment   : Sample(1),
      pad7           : Sample(7) ]

EncodeRbcHeaderComp9(message) ==
    message.sendingTime
        \o message.applSeqNum
        \o message.applSubId
        \o message.partitionId
        \o message.applResendFlag
        \o message.applId
        \o message.lastFragment
        \o message.pad7

DecodeRbcHeaderComp9(bytes) ==
    LET sendingTime == ReadBytes(bytes, 8) IN IF ~sendingTime.ok THEN Fail ELSE
    LET applSeqNum == ReadBytes(sendingTime.rest, 8) IN IF ~applSeqNum.ok THEN Fail ELSE
    LET applSubId == ReadBytes(applSeqNum.rest, 4) IN IF ~applSubId.ok THEN Fail ELSE
    LET partitionId == ReadBytes(applSubId.rest, 2) IN IF ~partitionId.ok THEN Fail ELSE
    LET applResendFlag == ReadBytes(partitionId.rest, 1) IN IF ~applResendFlag.ok THEN Fail ELSE
    LET applId == ReadBytes(applResendFlag.rest, 1) IN IF ~applId.ok THEN Fail ELSE
    LET lastFragment == ReadBytes(applId.rest, 1) IN IF ~lastFragment.ok THEN Fail ELSE
    LET pad7 == ReadBytes(lastFragment.rest, 7) IN IF ~pad7.ok THEN Fail ELSE
    Ok([ sendingTime    |-> sendingTime.value,
         applSeqNum     |-> applSeqNum.value,
         applSubId      |-> applSubId.value,
         partitionId    |-> partitionId.value,
         applResendFlag |-> applResendFlag.value,
         applId         |-> applId.value,
         lastFragment   |-> lastFragment.value,
         pad7           |-> pad7.value ], pad7.rest)

ZeroRbcHeaderComp9 ==
    [ sendingTime    |-> [i \in 1 .. 8 |-> 0],
      applSeqNum     |-> [i \in 1 .. 8 |-> 0],
      applSubId      |-> [i \in 1 .. 4 |-> 0],
      partitionId    |-> [i \in 1 .. 2 |-> 0],
      applResendFlag |-> [i \in 1 .. 1 |-> 0],
      applId         |-> [i \in 1 .. 1 |-> 0],
      lastFragment   |-> [i \in 1 .. 1 |-> 0],
      pad7           |-> [i \in 1 .. 7 |-> 0] ]

(* Rbc Header Comp at zero, then each field in turn at the values it is checked at *)
CheckedRbcHeaderComp9 ==
    { ZeroRbcHeaderComp9 }
        \cup { [ZeroRbcHeaderComp9 EXCEPT !.sendingTime = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderComp9 EXCEPT !.applSeqNum = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderComp9 EXCEPT !.applSubId = one] : one \in Sample(4) }
        \cup { [ZeroRbcHeaderComp9 EXCEPT !.partitionId = one] : one \in Sample(2) }
        \cup { [ZeroRbcHeaderComp9 EXCEPT !.applResendFlag = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp9 EXCEPT !.applId = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp9 EXCEPT !.lastFragment = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp9 EXCEPT !.pad7 = one] : one \in Sample(7) }

(***************************************************************************)
(* Risk Notification Broadcast: 82 bytes                                   *)
(***************************************************************************)

RiskNotificationBroadcast ==
    [ pad2                             : Sample(2),
      rbcHeaderComp                    : RbcHeaderComp9,
      transactTime                     : Sample(8),
      tradeDate                        : Sample(4),
      partyDetailIdExecutingUnit       : Sample(4),
      requestingPartyIdExecutingSystem : Sample(4),
      marketId                         : Sample(2),
      listUpdateAction                 : Sample(1),
      riskLimitAction                  : Sample(1),
      requestingPartyEnteringFirm      : Sample(9),
      requestingPartyClearingFirm      : Sample(9),
      pad6                             : Sample(6) ]

EncodeRiskNotificationBroadcast(message) ==
    message.pad2
        \o EncodeRbcHeaderComp9(message.rbcHeaderComp)
        \o message.transactTime
        \o message.tradeDate
        \o message.partyDetailIdExecutingUnit
        \o message.requestingPartyIdExecutingSystem
        \o message.marketId
        \o message.listUpdateAction
        \o message.riskLimitAction
        \o message.requestingPartyEnteringFirm
        \o message.requestingPartyClearingFirm
        \o message.pad6

DecodeRiskNotificationBroadcast(bytes) ==
    LET pad2 == ReadBytes(bytes, 2) IN IF ~pad2.ok THEN Fail ELSE
    LET rbcHeaderComp == DecodeRbcHeaderComp9(pad2.rest) IN IF ~rbcHeaderComp.ok THEN Fail ELSE
    LET transactTime == ReadBytes(rbcHeaderComp.rest, 8) IN IF ~transactTime.ok THEN Fail ELSE
    LET tradeDate == ReadBytes(transactTime.rest, 4) IN IF ~tradeDate.ok THEN Fail ELSE
    LET partyDetailIdExecutingUnit == ReadBytes(tradeDate.rest, 4) IN IF ~partyDetailIdExecutingUnit.ok THEN Fail ELSE
    LET requestingPartyIdExecutingSystem == ReadBytes(partyDetailIdExecutingUnit.rest, 4) IN IF ~requestingPartyIdExecutingSystem.ok THEN Fail ELSE
    LET marketId == ReadBytes(requestingPartyIdExecutingSystem.rest, 2) IN IF ~marketId.ok THEN Fail ELSE
    LET listUpdateAction == ReadBytes(marketId.rest, 1) IN IF ~listUpdateAction.ok THEN Fail ELSE
    LET riskLimitAction == ReadBytes(listUpdateAction.rest, 1) IN IF ~riskLimitAction.ok THEN Fail ELSE
    LET requestingPartyEnteringFirm == ReadBytes(riskLimitAction.rest, 9) IN IF ~requestingPartyEnteringFirm.ok THEN Fail ELSE
    LET requestingPartyClearingFirm == ReadBytes(requestingPartyEnteringFirm.rest, 9) IN IF ~requestingPartyClearingFirm.ok THEN Fail ELSE
    LET pad6 == ReadBytes(requestingPartyClearingFirm.rest, 6) IN IF ~pad6.ok THEN Fail ELSE
    Ok([ pad2                             |-> pad2.value,
         rbcHeaderComp                    |-> rbcHeaderComp.value,
         transactTime                     |-> transactTime.value,
         tradeDate                        |-> tradeDate.value,
         partyDetailIdExecutingUnit       |-> partyDetailIdExecutingUnit.value,
         requestingPartyIdExecutingSystem |-> requestingPartyIdExecutingSystem.value,
         marketId                         |-> marketId.value,
         listUpdateAction                 |-> listUpdateAction.value,
         riskLimitAction                  |-> riskLimitAction.value,
         requestingPartyEnteringFirm      |-> requestingPartyEnteringFirm.value,
         requestingPartyClearingFirm      |-> requestingPartyClearingFirm.value,
         pad6                             |-> pad6.value ], pad6.rest)

ZeroRiskNotificationBroadcast ==
    [ pad2                             |-> [i \in 1 .. 2 |-> 0],
      rbcHeaderComp                    |-> ZeroRbcHeaderComp9,
      transactTime                     |-> [i \in 1 .. 8 |-> 0],
      tradeDate                        |-> [i \in 1 .. 4 |-> 0],
      partyDetailIdExecutingUnit       |-> [i \in 1 .. 4 |-> 0],
      requestingPartyIdExecutingSystem |-> [i \in 1 .. 4 |-> 0],
      marketId                         |-> [i \in 1 .. 2 |-> 0],
      listUpdateAction                 |-> [i \in 1 .. 1 |-> 0],
      riskLimitAction                  |-> [i \in 1 .. 1 |-> 0],
      requestingPartyEnteringFirm      |-> [i \in 1 .. 9 |-> 0],
      requestingPartyClearingFirm      |-> [i \in 1 .. 9 |-> 0],
      pad6                             |-> [i \in 1 .. 6 |-> 0] ]

(* Risk Notification Broadcast at zero, then each field in turn at the values it is checked at *)
CheckedRiskNotificationBroadcast ==
    { ZeroRiskNotificationBroadcast }
        \cup { [ZeroRiskNotificationBroadcast EXCEPT !.pad2 = one] : one \in Sample(2) }
        \cup { [ZeroRiskNotificationBroadcast EXCEPT !.rbcHeaderComp = one] : one \in CheckedRbcHeaderComp9 }
        \cup { [ZeroRiskNotificationBroadcast EXCEPT !.transactTime = one] : one \in Sample(8) }
        \cup { [ZeroRiskNotificationBroadcast EXCEPT !.tradeDate = one] : one \in Sample(4) }
        \cup { [ZeroRiskNotificationBroadcast EXCEPT !.partyDetailIdExecutingUnit = one] : one \in Sample(4) }
        \cup { [ZeroRiskNotificationBroadcast EXCEPT !.requestingPartyIdExecutingSystem = one] : one \in Sample(4) }
        \cup { [ZeroRiskNotificationBroadcast EXCEPT !.marketId = one] : one \in Sample(2) }
        \cup { [ZeroRiskNotificationBroadcast EXCEPT !.listUpdateAction = one] : one \in Sample(1) }
        \cup { [ZeroRiskNotificationBroadcast EXCEPT !.riskLimitAction = one] : one \in Sample(1) }
        \cup { [ZeroRiskNotificationBroadcast EXCEPT !.requestingPartyEnteringFirm = one] : one \in Sample(9) }
        \cup { [ZeroRiskNotificationBroadcast EXCEPT !.requestingPartyClearingFirm = one] : one \in Sample(9) }
        \cup { [ZeroRiskNotificationBroadcast EXCEPT !.pad6 = one] : one \in Sample(6) }

(***************************************************************************)
(* Rbc Header Comp: 32 bytes                                               *)
(***************************************************************************)

RbcHeaderComp10 ==
    [ sendingTime    : Sample(8),
      applSeqNum     : Sample(8),
      applSubId      : Sample(4),
      partitionId    : Sample(2),
      applResendFlag : Sample(1),
      applId         : Sample(1),
      lastFragment   : Sample(1),
      pad7           : Sample(7) ]

EncodeRbcHeaderComp10(message) ==
    message.sendingTime
        \o message.applSeqNum
        \o message.applSubId
        \o message.partitionId
        \o message.applResendFlag
        \o message.applId
        \o message.lastFragment
        \o message.pad7

DecodeRbcHeaderComp10(bytes) ==
    LET sendingTime == ReadBytes(bytes, 8) IN IF ~sendingTime.ok THEN Fail ELSE
    LET applSeqNum == ReadBytes(sendingTime.rest, 8) IN IF ~applSeqNum.ok THEN Fail ELSE
    LET applSubId == ReadBytes(applSeqNum.rest, 4) IN IF ~applSubId.ok THEN Fail ELSE
    LET partitionId == ReadBytes(applSubId.rest, 2) IN IF ~partitionId.ok THEN Fail ELSE
    LET applResendFlag == ReadBytes(partitionId.rest, 1) IN IF ~applResendFlag.ok THEN Fail ELSE
    LET applId == ReadBytes(applResendFlag.rest, 1) IN IF ~applId.ok THEN Fail ELSE
    LET lastFragment == ReadBytes(applId.rest, 1) IN IF ~lastFragment.ok THEN Fail ELSE
    LET pad7 == ReadBytes(lastFragment.rest, 7) IN IF ~pad7.ok THEN Fail ELSE
    Ok([ sendingTime    |-> sendingTime.value,
         applSeqNum     |-> applSeqNum.value,
         applSubId      |-> applSubId.value,
         partitionId    |-> partitionId.value,
         applResendFlag |-> applResendFlag.value,
         applId         |-> applId.value,
         lastFragment   |-> lastFragment.value,
         pad7           |-> pad7.value ], pad7.rest)

ZeroRbcHeaderComp10 ==
    [ sendingTime    |-> [i \in 1 .. 8 |-> 0],
      applSeqNum     |-> [i \in 1 .. 8 |-> 0],
      applSubId      |-> [i \in 1 .. 4 |-> 0],
      partitionId    |-> [i \in 1 .. 2 |-> 0],
      applResendFlag |-> [i \in 1 .. 1 |-> 0],
      applId         |-> [i \in 1 .. 1 |-> 0],
      lastFragment   |-> [i \in 1 .. 1 |-> 0],
      pad7           |-> [i \in 1 .. 7 |-> 0] ]

(* Rbc Header Comp at zero, then each field in turn at the values it is checked at *)
CheckedRbcHeaderComp10 ==
    { ZeroRbcHeaderComp10 }
        \cup { [ZeroRbcHeaderComp10 EXCEPT !.sendingTime = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderComp10 EXCEPT !.applSeqNum = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderComp10 EXCEPT !.applSubId = one] : one \in Sample(4) }
        \cup { [ZeroRbcHeaderComp10 EXCEPT !.partitionId = one] : one \in Sample(2) }
        \cup { [ZeroRbcHeaderComp10 EXCEPT !.applResendFlag = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp10 EXCEPT !.applId = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp10 EXCEPT !.lastFragment = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp10 EXCEPT !.pad7 = one] : one \in Sample(7) }

(***************************************************************************)
(* Order Book Item Grp Comp: 48 bytes                                      *)
(***************************************************************************)

OrderBookItemGrpComp ==
    [ securityId    : Sample(8),
      bestBidPx     : Sample(8),
      bestBidSize   : Sample(8),
      bestOfferPx   : Sample(8),
      bestOfferSize : Sample(8),
      mdBookType    : Sample(1),
      mdSubBookType : Sample(1),
      pad6          : Sample(6) ]

EncodeOrderBookItemGrpComp(message) ==
    message.securityId
        \o message.bestBidPx
        \o message.bestBidSize
        \o message.bestOfferPx
        \o message.bestOfferSize
        \o message.mdBookType
        \o message.mdSubBookType
        \o message.pad6

DecodeOrderBookItemGrpComp(bytes) ==
    LET securityId == ReadBytes(bytes, 8) IN IF ~securityId.ok THEN Fail ELSE
    LET bestBidPx == ReadBytes(securityId.rest, 8) IN IF ~bestBidPx.ok THEN Fail ELSE
    LET bestBidSize == ReadBytes(bestBidPx.rest, 8) IN IF ~bestBidSize.ok THEN Fail ELSE
    LET bestOfferPx == ReadBytes(bestBidSize.rest, 8) IN IF ~bestOfferPx.ok THEN Fail ELSE
    LET bestOfferSize == ReadBytes(bestOfferPx.rest, 8) IN IF ~bestOfferSize.ok THEN Fail ELSE
    LET mdBookType == ReadBytes(bestOfferSize.rest, 1) IN IF ~mdBookType.ok THEN Fail ELSE
    LET mdSubBookType == ReadBytes(mdBookType.rest, 1) IN IF ~mdSubBookType.ok THEN Fail ELSE
    LET pad6 == ReadBytes(mdSubBookType.rest, 6) IN IF ~pad6.ok THEN Fail ELSE
    Ok([ securityId    |-> securityId.value,
         bestBidPx     |-> bestBidPx.value,
         bestBidSize   |-> bestBidSize.value,
         bestOfferPx   |-> bestOfferPx.value,
         bestOfferSize |-> bestOfferSize.value,
         mdBookType    |-> mdBookType.value,
         mdSubBookType |-> mdSubBookType.value,
         pad6          |-> pad6.value ], pad6.rest)

ZeroOrderBookItemGrpComp ==
    [ securityId    |-> [i \in 1 .. 8 |-> 0],
      bestBidPx     |-> [i \in 1 .. 8 |-> 0],
      bestBidSize   |-> [i \in 1 .. 8 |-> 0],
      bestOfferPx   |-> [i \in 1 .. 8 |-> 0],
      bestOfferSize |-> [i \in 1 .. 8 |-> 0],
      mdBookType    |-> [i \in 1 .. 1 |-> 0],
      mdSubBookType |-> [i \in 1 .. 1 |-> 0],
      pad6          |-> [i \in 1 .. 6 |-> 0] ]

(* Order Book Item Grp Comp at zero, then each field in turn at the values it is checked at *)
CheckedOrderBookItemGrpComp ==
    { ZeroOrderBookItemGrpComp }
        \cup { [ZeroOrderBookItemGrpComp EXCEPT !.securityId = one] : one \in Sample(8) }
        \cup { [ZeroOrderBookItemGrpComp EXCEPT !.bestBidPx = one] : one \in Sample(8) }
        \cup { [ZeroOrderBookItemGrpComp EXCEPT !.bestBidSize = one] : one \in Sample(8) }
        \cup { [ZeroOrderBookItemGrpComp EXCEPT !.bestOfferPx = one] : one \in Sample(8) }
        \cup { [ZeroOrderBookItemGrpComp EXCEPT !.bestOfferSize = one] : one \in Sample(8) }
        \cup { [ZeroOrderBookItemGrpComp EXCEPT !.mdBookType = one] : one \in Sample(1) }
        \cup { [ZeroOrderBookItemGrpComp EXCEPT !.mdSubBookType = one] : one \in Sample(1) }
        \cup { [ZeroOrderBookItemGrpComp EXCEPT !.pad6 = one] : one \in Sample(6) }

(* A run of Order Book Item Grp Comp, written one after another *)
RECURSIVE EncodeOrderBookItemGrpCompList(_)
EncodeOrderBookItemGrpCompList(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeOrderBookItemGrpComp(Head(messages)) \o EncodeOrderBookItemGrpCompList(Tail(messages))

(* As many Order Book Item Grp Comp as the field that counts them says *)
RECURSIVE ReadOrderBookItemGrpCompList(_, _)
ReadOrderBookItemGrpCompList(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeOrderBookItemGrpComp(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadOrderBookItemGrpCompList(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Order Book Item Grp Comp of each kind, for the lists that carry them *)
OneOrderBookItemGrpComp == { ZeroOrderBookItemGrpComp }

(***************************************************************************)
(* Srqs Create Deal Notification                                           *)
(***************************************************************************)

SrqsCreateDealNotification ==
    [ pad2                               : Sample(2),
      rbcHeaderComp                      : RbcHeaderComp10,
      transactTime                       : Sample(8),
      lastPx                             : Sample(8),
      lastQty                            : Sample(8),
      quoteId                            : Sample(8),
      securityId                         : Sample(8),
      expireTime                         : Sample(8),
      underlyingPx                       : Sample(8),
      underlyingDeltaPercentage          : Sample(8),
      underlyingEffectiveDeltaPercentage : Sample(8),
      underlyingQty                      : Sample(8),
      underlyingPriceStipValue           : Sample(8),
      negotiationId                      : Sample(4),
      tradeId                            : Sample(4),
      origTradeId                        : Sample(4),
      targetPartyIdExecutingTrader       : Sample(4),
      trdRptStatus                       : Sample(1),
      tradeReportType                    : Sample(1),
      messageEventSource                 : Sample(1),
      side                               : Sample(1),
      tradingCapacity                    : Sample(1),
      tradePublishIndicator              : Sample(1),
      hedgingInstruction                 : Sample(1),
      rootPartyExecutingFirm             : Sample(5),
      rootPartyExecutingTrader           : Sample(6),
      rootPartyEnteringTrader            : Sample(6),
      targetPartyExecutingFirm           : Sample(5),
      targetPartyExecutingTrader         : Sample(6),
      firmTradeId                        : Sample(20),
      firmNegotiationId                  : Sample(20),
      freeText1                          : Sample(12),
      freeText2                          : Sample(12),
      freeText3                          : Sample(12),
      freeText5                          : Sample(132),
      positionEffect                     : Sample(1),
      account                            : Sample(2),
      partyIdBeneficiary                 : Sample(9),
      custOrderHandlingInst              : Sample(1),
      partyIdOrderOriginationFirm        : Sample(7),
      partyIdPositionAccount             : Sample(32),
      partyIdLocationId                  : Sample(2),
      complianceText                     : Sample(20),
      partyIdTakeUpTradingFirm           : Sample(5),
      pad5                               : Sample(5),
      orderBookItemGrpComp               : SampleLists(OneOrderBookItemGrpComp) ]

EncodeSrqsCreateDealNotification(message) ==
    message.pad2
        \o EncodeRbcHeaderComp10(message.rbcHeaderComp)
        \o message.transactTime
        \o message.lastPx
        \o message.lastQty
        \o message.quoteId
        \o message.securityId
        \o message.expireTime
        \o message.underlyingPx
        \o message.underlyingDeltaPercentage
        \o message.underlyingEffectiveDeltaPercentage
        \o message.underlyingQty
        \o message.underlyingPriceStipValue
        \o message.negotiationId
        \o message.tradeId
        \o message.origTradeId
        \o message.targetPartyIdExecutingTrader
        \o message.trdRptStatus
        \o message.tradeReportType
        \o message.messageEventSource
        \o message.side
        \o EncodeUIntBE(Len(message.orderBookItemGrpComp), 1)
        \o message.tradingCapacity
        \o message.tradePublishIndicator
        \o message.hedgingInstruction
        \o message.rootPartyExecutingFirm
        \o message.rootPartyExecutingTrader
        \o message.rootPartyEnteringTrader
        \o message.targetPartyExecutingFirm
        \o message.targetPartyExecutingTrader
        \o message.firmTradeId
        \o message.firmNegotiationId
        \o message.freeText1
        \o message.freeText2
        \o message.freeText3
        \o message.freeText5
        \o message.positionEffect
        \o message.account
        \o message.partyIdBeneficiary
        \o message.custOrderHandlingInst
        \o message.partyIdOrderOriginationFirm
        \o message.partyIdPositionAccount
        \o message.partyIdLocationId
        \o message.complianceText
        \o message.partyIdTakeUpTradingFirm
        \o message.pad5
        \o EncodeOrderBookItemGrpCompList(message.orderBookItemGrpComp)

DecodeSrqsCreateDealNotification(bytes) ==
    LET pad2 == ReadBytes(bytes, 2) IN IF ~pad2.ok THEN Fail ELSE
    LET rbcHeaderComp == DecodeRbcHeaderComp10(pad2.rest) IN IF ~rbcHeaderComp.ok THEN Fail ELSE
    LET transactTime == ReadBytes(rbcHeaderComp.rest, 8) IN IF ~transactTime.ok THEN Fail ELSE
    LET lastPx == ReadBytes(transactTime.rest, 8) IN IF ~lastPx.ok THEN Fail ELSE
    LET lastQty == ReadBytes(lastPx.rest, 8) IN IF ~lastQty.ok THEN Fail ELSE
    LET quoteId == ReadBytes(lastQty.rest, 8) IN IF ~quoteId.ok THEN Fail ELSE
    LET securityId == ReadBytes(quoteId.rest, 8) IN IF ~securityId.ok THEN Fail ELSE
    LET expireTime == ReadBytes(securityId.rest, 8) IN IF ~expireTime.ok THEN Fail ELSE
    LET underlyingPx == ReadBytes(expireTime.rest, 8) IN IF ~underlyingPx.ok THEN Fail ELSE
    LET underlyingDeltaPercentage == ReadBytes(underlyingPx.rest, 8) IN IF ~underlyingDeltaPercentage.ok THEN Fail ELSE
    LET underlyingEffectiveDeltaPercentage == ReadBytes(underlyingDeltaPercentage.rest, 8) IN IF ~underlyingEffectiveDeltaPercentage.ok THEN Fail ELSE
    LET underlyingQty == ReadBytes(underlyingEffectiveDeltaPercentage.rest, 8) IN IF ~underlyingQty.ok THEN Fail ELSE
    LET underlyingPriceStipValue == ReadBytes(underlyingQty.rest, 8) IN IF ~underlyingPriceStipValue.ok THEN Fail ELSE
    LET negotiationId == ReadBytes(underlyingPriceStipValue.rest, 4) IN IF ~negotiationId.ok THEN Fail ELSE
    LET tradeId == ReadBytes(negotiationId.rest, 4) IN IF ~tradeId.ok THEN Fail ELSE
    LET origTradeId == ReadBytes(tradeId.rest, 4) IN IF ~origTradeId.ok THEN Fail ELSE
    LET targetPartyIdExecutingTrader == ReadBytes(origTradeId.rest, 4) IN IF ~targetPartyIdExecutingTrader.ok THEN Fail ELSE
    LET trdRptStatus == ReadBytes(targetPartyIdExecutingTrader.rest, 1) IN IF ~trdRptStatus.ok THEN Fail ELSE
    LET tradeReportType == ReadBytes(trdRptStatus.rest, 1) IN IF ~tradeReportType.ok THEN Fail ELSE
    LET messageEventSource == ReadBytes(tradeReportType.rest, 1) IN IF ~messageEventSource.ok THEN Fail ELSE
    LET side == ReadBytes(messageEventSource.rest, 1) IN IF ~side.ok THEN Fail ELSE
    LET noOrderBookItems == ReadUIntBE(side.rest, 1) IN IF ~noOrderBookItems.ok THEN Fail ELSE
    LET tradingCapacity == ReadBytes(noOrderBookItems.rest, 1) IN IF ~tradingCapacity.ok THEN Fail ELSE
    LET tradePublishIndicator == ReadBytes(tradingCapacity.rest, 1) IN IF ~tradePublishIndicator.ok THEN Fail ELSE
    LET hedgingInstruction == ReadBytes(tradePublishIndicator.rest, 1) IN IF ~hedgingInstruction.ok THEN Fail ELSE
    LET rootPartyExecutingFirm == ReadBytes(hedgingInstruction.rest, 5) IN IF ~rootPartyExecutingFirm.ok THEN Fail ELSE
    LET rootPartyExecutingTrader == ReadBytes(rootPartyExecutingFirm.rest, 6) IN IF ~rootPartyExecutingTrader.ok THEN Fail ELSE
    LET rootPartyEnteringTrader == ReadBytes(rootPartyExecutingTrader.rest, 6) IN IF ~rootPartyEnteringTrader.ok THEN Fail ELSE
    LET targetPartyExecutingFirm == ReadBytes(rootPartyEnteringTrader.rest, 5) IN IF ~targetPartyExecutingFirm.ok THEN Fail ELSE
    LET targetPartyExecutingTrader == ReadBytes(targetPartyExecutingFirm.rest, 6) IN IF ~targetPartyExecutingTrader.ok THEN Fail ELSE
    LET firmTradeId == ReadBytes(targetPartyExecutingTrader.rest, 20) IN IF ~firmTradeId.ok THEN Fail ELSE
    LET firmNegotiationId == ReadBytes(firmTradeId.rest, 20) IN IF ~firmNegotiationId.ok THEN Fail ELSE
    LET freeText1 == ReadBytes(firmNegotiationId.rest, 12) IN IF ~freeText1.ok THEN Fail ELSE
    LET freeText2 == ReadBytes(freeText1.rest, 12) IN IF ~freeText2.ok THEN Fail ELSE
    LET freeText3 == ReadBytes(freeText2.rest, 12) IN IF ~freeText3.ok THEN Fail ELSE
    LET freeText5 == ReadBytes(freeText3.rest, 132) IN IF ~freeText5.ok THEN Fail ELSE
    LET positionEffect == ReadBytes(freeText5.rest, 1) IN IF ~positionEffect.ok THEN Fail ELSE
    LET account == ReadBytes(positionEffect.rest, 2) IN IF ~account.ok THEN Fail ELSE
    LET partyIdBeneficiary == ReadBytes(account.rest, 9) IN IF ~partyIdBeneficiary.ok THEN Fail ELSE
    LET custOrderHandlingInst == ReadBytes(partyIdBeneficiary.rest, 1) IN IF ~custOrderHandlingInst.ok THEN Fail ELSE
    LET partyIdOrderOriginationFirm == ReadBytes(custOrderHandlingInst.rest, 7) IN IF ~partyIdOrderOriginationFirm.ok THEN Fail ELSE
    LET partyIdPositionAccount == ReadBytes(partyIdOrderOriginationFirm.rest, 32) IN IF ~partyIdPositionAccount.ok THEN Fail ELSE
    LET partyIdLocationId == ReadBytes(partyIdPositionAccount.rest, 2) IN IF ~partyIdLocationId.ok THEN Fail ELSE
    LET complianceText == ReadBytes(partyIdLocationId.rest, 20) IN IF ~complianceText.ok THEN Fail ELSE
    LET partyIdTakeUpTradingFirm == ReadBytes(complianceText.rest, 5) IN IF ~partyIdTakeUpTradingFirm.ok THEN Fail ELSE
    LET pad5 == ReadBytes(partyIdTakeUpTradingFirm.rest, 5) IN IF ~pad5.ok THEN Fail ELSE
    LET orderBookItemGrpComp == ReadOrderBookItemGrpCompList(pad5.rest, noOrderBookItems.value) IN IF ~orderBookItemGrpComp.ok THEN Fail ELSE
    Ok([ pad2                               |-> pad2.value,
         rbcHeaderComp                      |-> rbcHeaderComp.value,
         transactTime                       |-> transactTime.value,
         lastPx                             |-> lastPx.value,
         lastQty                            |-> lastQty.value,
         quoteId                            |-> quoteId.value,
         securityId                         |-> securityId.value,
         expireTime                         |-> expireTime.value,
         underlyingPx                       |-> underlyingPx.value,
         underlyingDeltaPercentage          |-> underlyingDeltaPercentage.value,
         underlyingEffectiveDeltaPercentage |-> underlyingEffectiveDeltaPercentage.value,
         underlyingQty                      |-> underlyingQty.value,
         underlyingPriceStipValue           |-> underlyingPriceStipValue.value,
         negotiationId                      |-> negotiationId.value,
         tradeId                            |-> tradeId.value,
         origTradeId                        |-> origTradeId.value,
         targetPartyIdExecutingTrader       |-> targetPartyIdExecutingTrader.value,
         trdRptStatus                       |-> trdRptStatus.value,
         tradeReportType                    |-> tradeReportType.value,
         messageEventSource                 |-> messageEventSource.value,
         side                               |-> side.value,
         tradingCapacity                    |-> tradingCapacity.value,
         tradePublishIndicator              |-> tradePublishIndicator.value,
         hedgingInstruction                 |-> hedgingInstruction.value,
         rootPartyExecutingFirm             |-> rootPartyExecutingFirm.value,
         rootPartyExecutingTrader           |-> rootPartyExecutingTrader.value,
         rootPartyEnteringTrader            |-> rootPartyEnteringTrader.value,
         targetPartyExecutingFirm           |-> targetPartyExecutingFirm.value,
         targetPartyExecutingTrader         |-> targetPartyExecutingTrader.value,
         firmTradeId                        |-> firmTradeId.value,
         firmNegotiationId                  |-> firmNegotiationId.value,
         freeText1                          |-> freeText1.value,
         freeText2                          |-> freeText2.value,
         freeText3                          |-> freeText3.value,
         freeText5                          |-> freeText5.value,
         positionEffect                     |-> positionEffect.value,
         account                            |-> account.value,
         partyIdBeneficiary                 |-> partyIdBeneficiary.value,
         custOrderHandlingInst              |-> custOrderHandlingInst.value,
         partyIdOrderOriginationFirm        |-> partyIdOrderOriginationFirm.value,
         partyIdPositionAccount             |-> partyIdPositionAccount.value,
         partyIdLocationId                  |-> partyIdLocationId.value,
         complianceText                     |-> complianceText.value,
         partyIdTakeUpTradingFirm           |-> partyIdTakeUpTradingFirm.value,
         pad5                               |-> pad5.value,
         orderBookItemGrpComp               |-> orderBookItemGrpComp.value ], orderBookItemGrpComp.rest)

ZeroSrqsCreateDealNotification ==
    [ pad2                               |-> [i \in 1 .. 2 |-> 0],
      rbcHeaderComp                      |-> ZeroRbcHeaderComp10,
      transactTime                       |-> [i \in 1 .. 8 |-> 0],
      lastPx                             |-> [i \in 1 .. 8 |-> 0],
      lastQty                            |-> [i \in 1 .. 8 |-> 0],
      quoteId                            |-> [i \in 1 .. 8 |-> 0],
      securityId                         |-> [i \in 1 .. 8 |-> 0],
      expireTime                         |-> [i \in 1 .. 8 |-> 0],
      underlyingPx                       |-> [i \in 1 .. 8 |-> 0],
      underlyingDeltaPercentage          |-> [i \in 1 .. 8 |-> 0],
      underlyingEffectiveDeltaPercentage |-> [i \in 1 .. 8 |-> 0],
      underlyingQty                      |-> [i \in 1 .. 8 |-> 0],
      underlyingPriceStipValue           |-> [i \in 1 .. 8 |-> 0],
      negotiationId                      |-> [i \in 1 .. 4 |-> 0],
      tradeId                            |-> [i \in 1 .. 4 |-> 0],
      origTradeId                        |-> [i \in 1 .. 4 |-> 0],
      targetPartyIdExecutingTrader       |-> [i \in 1 .. 4 |-> 0],
      trdRptStatus                       |-> [i \in 1 .. 1 |-> 0],
      tradeReportType                    |-> [i \in 1 .. 1 |-> 0],
      messageEventSource                 |-> [i \in 1 .. 1 |-> 0],
      side                               |-> [i \in 1 .. 1 |-> 0],
      tradingCapacity                    |-> [i \in 1 .. 1 |-> 0],
      tradePublishIndicator              |-> [i \in 1 .. 1 |-> 0],
      hedgingInstruction                 |-> [i \in 1 .. 1 |-> 0],
      rootPartyExecutingFirm             |-> [i \in 1 .. 5 |-> 0],
      rootPartyExecutingTrader           |-> [i \in 1 .. 6 |-> 0],
      rootPartyEnteringTrader            |-> [i \in 1 .. 6 |-> 0],
      targetPartyExecutingFirm           |-> [i \in 1 .. 5 |-> 0],
      targetPartyExecutingTrader         |-> [i \in 1 .. 6 |-> 0],
      firmTradeId                        |-> [i \in 1 .. 20 |-> 0],
      firmNegotiationId                  |-> [i \in 1 .. 20 |-> 0],
      freeText1                          |-> [i \in 1 .. 12 |-> 0],
      freeText2                          |-> [i \in 1 .. 12 |-> 0],
      freeText3                          |-> [i \in 1 .. 12 |-> 0],
      freeText5                          |-> [i \in 1 .. 132 |-> 0],
      positionEffect                     |-> [i \in 1 .. 1 |-> 0],
      account                            |-> [i \in 1 .. 2 |-> 0],
      partyIdBeneficiary                 |-> [i \in 1 .. 9 |-> 0],
      custOrderHandlingInst              |-> [i \in 1 .. 1 |-> 0],
      partyIdOrderOriginationFirm        |-> [i \in 1 .. 7 |-> 0],
      partyIdPositionAccount             |-> [i \in 1 .. 32 |-> 0],
      partyIdLocationId                  |-> [i \in 1 .. 2 |-> 0],
      complianceText                     |-> [i \in 1 .. 20 |-> 0],
      partyIdTakeUpTradingFirm           |-> [i \in 1 .. 5 |-> 0],
      pad5                               |-> [i \in 1 .. 5 |-> 0],
      orderBookItemGrpComp               |-> << >> ]

(* Srqs Create Deal Notification at zero, then each field in turn at the values it is checked at *)
CheckedSrqsCreateDealNotification ==
    { ZeroSrqsCreateDealNotification }
        \cup { [ZeroSrqsCreateDealNotification EXCEPT !.pad2 = one] : one \in Sample(2) }
        \cup { [ZeroSrqsCreateDealNotification EXCEPT !.rbcHeaderComp = one] : one \in CheckedRbcHeaderComp10 }
        \cup { [ZeroSrqsCreateDealNotification EXCEPT !.transactTime = one] : one \in Sample(8) }
        \cup { [ZeroSrqsCreateDealNotification EXCEPT !.lastPx = one] : one \in Sample(8) }
        \cup { [ZeroSrqsCreateDealNotification EXCEPT !.lastQty = one] : one \in Sample(8) }
        \cup { [ZeroSrqsCreateDealNotification EXCEPT !.quoteId = one] : one \in Sample(8) }
        \cup { [ZeroSrqsCreateDealNotification EXCEPT !.securityId = one] : one \in Sample(8) }
        \cup { [ZeroSrqsCreateDealNotification EXCEPT !.expireTime = one] : one \in Sample(8) }
        \cup { [ZeroSrqsCreateDealNotification EXCEPT !.underlyingPx = one] : one \in Sample(8) }
        \cup { [ZeroSrqsCreateDealNotification EXCEPT !.underlyingDeltaPercentage = one] : one \in Sample(8) }
        \cup { [ZeroSrqsCreateDealNotification EXCEPT !.underlyingEffectiveDeltaPercentage = one] : one \in Sample(8) }
        \cup { [ZeroSrqsCreateDealNotification EXCEPT !.underlyingQty = one] : one \in Sample(8) }
        \cup { [ZeroSrqsCreateDealNotification EXCEPT !.underlyingPriceStipValue = one] : one \in Sample(8) }
        \cup { [ZeroSrqsCreateDealNotification EXCEPT !.negotiationId = one] : one \in Sample(4) }
        \cup { [ZeroSrqsCreateDealNotification EXCEPT !.tradeId = one] : one \in Sample(4) }
        \cup { [ZeroSrqsCreateDealNotification EXCEPT !.origTradeId = one] : one \in Sample(4) }
        \cup { [ZeroSrqsCreateDealNotification EXCEPT !.targetPartyIdExecutingTrader = one] : one \in Sample(4) }
        \cup { [ZeroSrqsCreateDealNotification EXCEPT !.trdRptStatus = one] : one \in Sample(1) }
        \cup { [ZeroSrqsCreateDealNotification EXCEPT !.tradeReportType = one] : one \in Sample(1) }
        \cup { [ZeroSrqsCreateDealNotification EXCEPT !.messageEventSource = one] : one \in Sample(1) }
        \cup { [ZeroSrqsCreateDealNotification EXCEPT !.side = one] : one \in Sample(1) }
        \cup { [ZeroSrqsCreateDealNotification EXCEPT !.tradingCapacity = one] : one \in Sample(1) }
        \cup { [ZeroSrqsCreateDealNotification EXCEPT !.tradePublishIndicator = one] : one \in Sample(1) }
        \cup { [ZeroSrqsCreateDealNotification EXCEPT !.hedgingInstruction = one] : one \in Sample(1) }
        \cup { [ZeroSrqsCreateDealNotification EXCEPT !.rootPartyExecutingFirm = one] : one \in Sample(5) }
        \cup { [ZeroSrqsCreateDealNotification EXCEPT !.rootPartyExecutingTrader = one] : one \in Sample(6) }
        \cup { [ZeroSrqsCreateDealNotification EXCEPT !.rootPartyEnteringTrader = one] : one \in Sample(6) }
        \cup { [ZeroSrqsCreateDealNotification EXCEPT !.targetPartyExecutingFirm = one] : one \in Sample(5) }
        \cup { [ZeroSrqsCreateDealNotification EXCEPT !.targetPartyExecutingTrader = one] : one \in Sample(6) }
        \cup { [ZeroSrqsCreateDealNotification EXCEPT !.firmTradeId = one] : one \in Sample(20) }
        \cup { [ZeroSrqsCreateDealNotification EXCEPT !.firmNegotiationId = one] : one \in Sample(20) }
        \cup { [ZeroSrqsCreateDealNotification EXCEPT !.freeText1 = one] : one \in Sample(12) }
        \cup { [ZeroSrqsCreateDealNotification EXCEPT !.freeText2 = one] : one \in Sample(12) }
        \cup { [ZeroSrqsCreateDealNotification EXCEPT !.freeText3 = one] : one \in Sample(12) }
        \cup { [ZeroSrqsCreateDealNotification EXCEPT !.freeText5 = one] : one \in Sample(132) }
        \cup { [ZeroSrqsCreateDealNotification EXCEPT !.positionEffect = one] : one \in Sample(1) }
        \cup { [ZeroSrqsCreateDealNotification EXCEPT !.account = one] : one \in Sample(2) }
        \cup { [ZeroSrqsCreateDealNotification EXCEPT !.partyIdBeneficiary = one] : one \in Sample(9) }
        \cup { [ZeroSrqsCreateDealNotification EXCEPT !.custOrderHandlingInst = one] : one \in Sample(1) }
        \cup { [ZeroSrqsCreateDealNotification EXCEPT !.partyIdOrderOriginationFirm = one] : one \in Sample(7) }
        \cup { [ZeroSrqsCreateDealNotification EXCEPT !.partyIdPositionAccount = one] : one \in Sample(32) }
        \cup { [ZeroSrqsCreateDealNotification EXCEPT !.partyIdLocationId = one] : one \in Sample(2) }
        \cup { [ZeroSrqsCreateDealNotification EXCEPT !.complianceText = one] : one \in Sample(20) }
        \cup { [ZeroSrqsCreateDealNotification EXCEPT !.partyIdTakeUpTradingFirm = one] : one \in Sample(5) }
        \cup { [ZeroSrqsCreateDealNotification EXCEPT !.pad5 = one] : one \in Sample(5) }
        \cup { [ZeroSrqsCreateDealNotification EXCEPT !.orderBookItemGrpComp = one] : one \in SampleLists(OneOrderBookItemGrpComp) }

(***************************************************************************)
(* Rbc Header Comp: 32 bytes                                               *)
(***************************************************************************)

RbcHeaderComp11 ==
    [ sendingTime    : Sample(8),
      applSeqNum     : Sample(8),
      applSubId      : Sample(4),
      partitionId    : Sample(2),
      applResendFlag : Sample(1),
      applId         : Sample(1),
      lastFragment   : Sample(1),
      pad7           : Sample(7) ]

EncodeRbcHeaderComp11(message) ==
    message.sendingTime
        \o message.applSeqNum
        \o message.applSubId
        \o message.partitionId
        \o message.applResendFlag
        \o message.applId
        \o message.lastFragment
        \o message.pad7

DecodeRbcHeaderComp11(bytes) ==
    LET sendingTime == ReadBytes(bytes, 8) IN IF ~sendingTime.ok THEN Fail ELSE
    LET applSeqNum == ReadBytes(sendingTime.rest, 8) IN IF ~applSeqNum.ok THEN Fail ELSE
    LET applSubId == ReadBytes(applSeqNum.rest, 4) IN IF ~applSubId.ok THEN Fail ELSE
    LET partitionId == ReadBytes(applSubId.rest, 2) IN IF ~partitionId.ok THEN Fail ELSE
    LET applResendFlag == ReadBytes(partitionId.rest, 1) IN IF ~applResendFlag.ok THEN Fail ELSE
    LET applId == ReadBytes(applResendFlag.rest, 1) IN IF ~applId.ok THEN Fail ELSE
    LET lastFragment == ReadBytes(applId.rest, 1) IN IF ~lastFragment.ok THEN Fail ELSE
    LET pad7 == ReadBytes(lastFragment.rest, 7) IN IF ~pad7.ok THEN Fail ELSE
    Ok([ sendingTime    |-> sendingTime.value,
         applSeqNum     |-> applSeqNum.value,
         applSubId      |-> applSubId.value,
         partitionId    |-> partitionId.value,
         applResendFlag |-> applResendFlag.value,
         applId         |-> applId.value,
         lastFragment   |-> lastFragment.value,
         pad7           |-> pad7.value ], pad7.rest)

ZeroRbcHeaderComp11 ==
    [ sendingTime    |-> [i \in 1 .. 8 |-> 0],
      applSeqNum     |-> [i \in 1 .. 8 |-> 0],
      applSubId      |-> [i \in 1 .. 4 |-> 0],
      partitionId    |-> [i \in 1 .. 2 |-> 0],
      applResendFlag |-> [i \in 1 .. 1 |-> 0],
      applId         |-> [i \in 1 .. 1 |-> 0],
      lastFragment   |-> [i \in 1 .. 1 |-> 0],
      pad7           |-> [i \in 1 .. 7 |-> 0] ]

(* Rbc Header Comp at zero, then each field in turn at the values it is checked at *)
CheckedRbcHeaderComp11 ==
    { ZeroRbcHeaderComp11 }
        \cup { [ZeroRbcHeaderComp11 EXCEPT !.sendingTime = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderComp11 EXCEPT !.applSeqNum = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderComp11 EXCEPT !.applSubId = one] : one \in Sample(4) }
        \cup { [ZeroRbcHeaderComp11 EXCEPT !.partitionId = one] : one \in Sample(2) }
        \cup { [ZeroRbcHeaderComp11 EXCEPT !.applResendFlag = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp11 EXCEPT !.applId = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp11 EXCEPT !.lastFragment = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp11 EXCEPT !.pad7 = one] : one \in Sample(7) }

(***************************************************************************)
(* Srqs Deal Notification: 418 bytes                                       *)
(***************************************************************************)

SrqsDealNotification ==
    [ pad2                         : Sample(2),
      rbcHeaderComp                : RbcHeaderComp11,
      transactTime                 : Sample(8),
      underlyingPriceStipValue     : Sample(8),
      underlyingPx                 : Sample(8),
      lastPx                       : Sample(8),
      lastQty                      : Sample(8),
      negotiationId                : Sample(4),
      tradeId                      : Sample(4),
      targetPartyIdExecutingTrader : Sample(4),
      requestingPartySubIdType     : Sample(2),
      trdRptStatus                 : Sample(1),
      tradeRequestResult           : Sample(1),
      messageEventSource           : Sample(1),
      tradingCapacity              : Sample(1),
      rootPartyExecutingFirm       : Sample(5),
      rootPartyExecutingTrader     : Sample(6),
      rootPartyEnteringTrader      : Sample(6),
      targetPartyExecutingFirm     : Sample(5),
      targetPartyExecutingTrader   : Sample(6),
      targetPartyEnteringTrader    : Sample(6),
      firmTradeId                  : Sample(20),
      firmNegotiationId            : Sample(20),
      freeText1                    : Sample(12),
      freeText2                    : Sample(12),
      freeText3                    : Sample(12),
      freeText5                    : Sample(132),
      positionEffect               : Sample(1),
      account                      : Sample(2),
      partyIdBeneficiary           : Sample(9),
      custOrderHandlingInst        : Sample(1),
      partyIdOrderOriginationFirm  : Sample(7),
      partyIdPositionAccount       : Sample(32),
      partyIdLocationId            : Sample(2),
      complianceText               : Sample(20),
      partyIdTakeUpTradingFirm     : Sample(5),
      pad5                         : Sample(5) ]

EncodeSrqsDealNotification(message) ==
    message.pad2
        \o EncodeRbcHeaderComp11(message.rbcHeaderComp)
        \o message.transactTime
        \o message.underlyingPriceStipValue
        \o message.underlyingPx
        \o message.lastPx
        \o message.lastQty
        \o message.negotiationId
        \o message.tradeId
        \o message.targetPartyIdExecutingTrader
        \o message.requestingPartySubIdType
        \o message.trdRptStatus
        \o message.tradeRequestResult
        \o message.messageEventSource
        \o message.tradingCapacity
        \o message.rootPartyExecutingFirm
        \o message.rootPartyExecutingTrader
        \o message.rootPartyEnteringTrader
        \o message.targetPartyExecutingFirm
        \o message.targetPartyExecutingTrader
        \o message.targetPartyEnteringTrader
        \o message.firmTradeId
        \o message.firmNegotiationId
        \o message.freeText1
        \o message.freeText2
        \o message.freeText3
        \o message.freeText5
        \o message.positionEffect
        \o message.account
        \o message.partyIdBeneficiary
        \o message.custOrderHandlingInst
        \o message.partyIdOrderOriginationFirm
        \o message.partyIdPositionAccount
        \o message.partyIdLocationId
        \o message.complianceText
        \o message.partyIdTakeUpTradingFirm
        \o message.pad5

DecodeSrqsDealNotification(bytes) ==
    LET pad2 == ReadBytes(bytes, 2) IN IF ~pad2.ok THEN Fail ELSE
    LET rbcHeaderComp == DecodeRbcHeaderComp11(pad2.rest) IN IF ~rbcHeaderComp.ok THEN Fail ELSE
    LET transactTime == ReadBytes(rbcHeaderComp.rest, 8) IN IF ~transactTime.ok THEN Fail ELSE
    LET underlyingPriceStipValue == ReadBytes(transactTime.rest, 8) IN IF ~underlyingPriceStipValue.ok THEN Fail ELSE
    LET underlyingPx == ReadBytes(underlyingPriceStipValue.rest, 8) IN IF ~underlyingPx.ok THEN Fail ELSE
    LET lastPx == ReadBytes(underlyingPx.rest, 8) IN IF ~lastPx.ok THEN Fail ELSE
    LET lastQty == ReadBytes(lastPx.rest, 8) IN IF ~lastQty.ok THEN Fail ELSE
    LET negotiationId == ReadBytes(lastQty.rest, 4) IN IF ~negotiationId.ok THEN Fail ELSE
    LET tradeId == ReadBytes(negotiationId.rest, 4) IN IF ~tradeId.ok THEN Fail ELSE
    LET targetPartyIdExecutingTrader == ReadBytes(tradeId.rest, 4) IN IF ~targetPartyIdExecutingTrader.ok THEN Fail ELSE
    LET requestingPartySubIdType == ReadBytes(targetPartyIdExecutingTrader.rest, 2) IN IF ~requestingPartySubIdType.ok THEN Fail ELSE
    LET trdRptStatus == ReadBytes(requestingPartySubIdType.rest, 1) IN IF ~trdRptStatus.ok THEN Fail ELSE
    LET tradeRequestResult == ReadBytes(trdRptStatus.rest, 1) IN IF ~tradeRequestResult.ok THEN Fail ELSE
    LET messageEventSource == ReadBytes(tradeRequestResult.rest, 1) IN IF ~messageEventSource.ok THEN Fail ELSE
    LET tradingCapacity == ReadBytes(messageEventSource.rest, 1) IN IF ~tradingCapacity.ok THEN Fail ELSE
    LET rootPartyExecutingFirm == ReadBytes(tradingCapacity.rest, 5) IN IF ~rootPartyExecutingFirm.ok THEN Fail ELSE
    LET rootPartyExecutingTrader == ReadBytes(rootPartyExecutingFirm.rest, 6) IN IF ~rootPartyExecutingTrader.ok THEN Fail ELSE
    LET rootPartyEnteringTrader == ReadBytes(rootPartyExecutingTrader.rest, 6) IN IF ~rootPartyEnteringTrader.ok THEN Fail ELSE
    LET targetPartyExecutingFirm == ReadBytes(rootPartyEnteringTrader.rest, 5) IN IF ~targetPartyExecutingFirm.ok THEN Fail ELSE
    LET targetPartyExecutingTrader == ReadBytes(targetPartyExecutingFirm.rest, 6) IN IF ~targetPartyExecutingTrader.ok THEN Fail ELSE
    LET targetPartyEnteringTrader == ReadBytes(targetPartyExecutingTrader.rest, 6) IN IF ~targetPartyEnteringTrader.ok THEN Fail ELSE
    LET firmTradeId == ReadBytes(targetPartyEnteringTrader.rest, 20) IN IF ~firmTradeId.ok THEN Fail ELSE
    LET firmNegotiationId == ReadBytes(firmTradeId.rest, 20) IN IF ~firmNegotiationId.ok THEN Fail ELSE
    LET freeText1 == ReadBytes(firmNegotiationId.rest, 12) IN IF ~freeText1.ok THEN Fail ELSE
    LET freeText2 == ReadBytes(freeText1.rest, 12) IN IF ~freeText2.ok THEN Fail ELSE
    LET freeText3 == ReadBytes(freeText2.rest, 12) IN IF ~freeText3.ok THEN Fail ELSE
    LET freeText5 == ReadBytes(freeText3.rest, 132) IN IF ~freeText5.ok THEN Fail ELSE
    LET positionEffect == ReadBytes(freeText5.rest, 1) IN IF ~positionEffect.ok THEN Fail ELSE
    LET account == ReadBytes(positionEffect.rest, 2) IN IF ~account.ok THEN Fail ELSE
    LET partyIdBeneficiary == ReadBytes(account.rest, 9) IN IF ~partyIdBeneficiary.ok THEN Fail ELSE
    LET custOrderHandlingInst == ReadBytes(partyIdBeneficiary.rest, 1) IN IF ~custOrderHandlingInst.ok THEN Fail ELSE
    LET partyIdOrderOriginationFirm == ReadBytes(custOrderHandlingInst.rest, 7) IN IF ~partyIdOrderOriginationFirm.ok THEN Fail ELSE
    LET partyIdPositionAccount == ReadBytes(partyIdOrderOriginationFirm.rest, 32) IN IF ~partyIdPositionAccount.ok THEN Fail ELSE
    LET partyIdLocationId == ReadBytes(partyIdPositionAccount.rest, 2) IN IF ~partyIdLocationId.ok THEN Fail ELSE
    LET complianceText == ReadBytes(partyIdLocationId.rest, 20) IN IF ~complianceText.ok THEN Fail ELSE
    LET partyIdTakeUpTradingFirm == ReadBytes(complianceText.rest, 5) IN IF ~partyIdTakeUpTradingFirm.ok THEN Fail ELSE
    LET pad5 == ReadBytes(partyIdTakeUpTradingFirm.rest, 5) IN IF ~pad5.ok THEN Fail ELSE
    Ok([ pad2                         |-> pad2.value,
         rbcHeaderComp                |-> rbcHeaderComp.value,
         transactTime                 |-> transactTime.value,
         underlyingPriceStipValue     |-> underlyingPriceStipValue.value,
         underlyingPx                 |-> underlyingPx.value,
         lastPx                       |-> lastPx.value,
         lastQty                      |-> lastQty.value,
         negotiationId                |-> negotiationId.value,
         tradeId                      |-> tradeId.value,
         targetPartyIdExecutingTrader |-> targetPartyIdExecutingTrader.value,
         requestingPartySubIdType     |-> requestingPartySubIdType.value,
         trdRptStatus                 |-> trdRptStatus.value,
         tradeRequestResult           |-> tradeRequestResult.value,
         messageEventSource           |-> messageEventSource.value,
         tradingCapacity              |-> tradingCapacity.value,
         rootPartyExecutingFirm       |-> rootPartyExecutingFirm.value,
         rootPartyExecutingTrader     |-> rootPartyExecutingTrader.value,
         rootPartyEnteringTrader      |-> rootPartyEnteringTrader.value,
         targetPartyExecutingFirm     |-> targetPartyExecutingFirm.value,
         targetPartyExecutingTrader   |-> targetPartyExecutingTrader.value,
         targetPartyEnteringTrader    |-> targetPartyEnteringTrader.value,
         firmTradeId                  |-> firmTradeId.value,
         firmNegotiationId            |-> firmNegotiationId.value,
         freeText1                    |-> freeText1.value,
         freeText2                    |-> freeText2.value,
         freeText3                    |-> freeText3.value,
         freeText5                    |-> freeText5.value,
         positionEffect               |-> positionEffect.value,
         account                      |-> account.value,
         partyIdBeneficiary           |-> partyIdBeneficiary.value,
         custOrderHandlingInst        |-> custOrderHandlingInst.value,
         partyIdOrderOriginationFirm  |-> partyIdOrderOriginationFirm.value,
         partyIdPositionAccount       |-> partyIdPositionAccount.value,
         partyIdLocationId            |-> partyIdLocationId.value,
         complianceText               |-> complianceText.value,
         partyIdTakeUpTradingFirm     |-> partyIdTakeUpTradingFirm.value,
         pad5                         |-> pad5.value ], pad5.rest)

ZeroSrqsDealNotification ==
    [ pad2                         |-> [i \in 1 .. 2 |-> 0],
      rbcHeaderComp                |-> ZeroRbcHeaderComp11,
      transactTime                 |-> [i \in 1 .. 8 |-> 0],
      underlyingPriceStipValue     |-> [i \in 1 .. 8 |-> 0],
      underlyingPx                 |-> [i \in 1 .. 8 |-> 0],
      lastPx                       |-> [i \in 1 .. 8 |-> 0],
      lastQty                      |-> [i \in 1 .. 8 |-> 0],
      negotiationId                |-> [i \in 1 .. 4 |-> 0],
      tradeId                      |-> [i \in 1 .. 4 |-> 0],
      targetPartyIdExecutingTrader |-> [i \in 1 .. 4 |-> 0],
      requestingPartySubIdType     |-> [i \in 1 .. 2 |-> 0],
      trdRptStatus                 |-> [i \in 1 .. 1 |-> 0],
      tradeRequestResult           |-> [i \in 1 .. 1 |-> 0],
      messageEventSource           |-> [i \in 1 .. 1 |-> 0],
      tradingCapacity              |-> [i \in 1 .. 1 |-> 0],
      rootPartyExecutingFirm       |-> [i \in 1 .. 5 |-> 0],
      rootPartyExecutingTrader     |-> [i \in 1 .. 6 |-> 0],
      rootPartyEnteringTrader      |-> [i \in 1 .. 6 |-> 0],
      targetPartyExecutingFirm     |-> [i \in 1 .. 5 |-> 0],
      targetPartyExecutingTrader   |-> [i \in 1 .. 6 |-> 0],
      targetPartyEnteringTrader    |-> [i \in 1 .. 6 |-> 0],
      firmTradeId                  |-> [i \in 1 .. 20 |-> 0],
      firmNegotiationId            |-> [i \in 1 .. 20 |-> 0],
      freeText1                    |-> [i \in 1 .. 12 |-> 0],
      freeText2                    |-> [i \in 1 .. 12 |-> 0],
      freeText3                    |-> [i \in 1 .. 12 |-> 0],
      freeText5                    |-> [i \in 1 .. 132 |-> 0],
      positionEffect               |-> [i \in 1 .. 1 |-> 0],
      account                      |-> [i \in 1 .. 2 |-> 0],
      partyIdBeneficiary           |-> [i \in 1 .. 9 |-> 0],
      custOrderHandlingInst        |-> [i \in 1 .. 1 |-> 0],
      partyIdOrderOriginationFirm  |-> [i \in 1 .. 7 |-> 0],
      partyIdPositionAccount       |-> [i \in 1 .. 32 |-> 0],
      partyIdLocationId            |-> [i \in 1 .. 2 |-> 0],
      complianceText               |-> [i \in 1 .. 20 |-> 0],
      partyIdTakeUpTradingFirm     |-> [i \in 1 .. 5 |-> 0],
      pad5                         |-> [i \in 1 .. 5 |-> 0] ]

(* Srqs Deal Notification at zero, then each field in turn at the values it is checked at *)
CheckedSrqsDealNotification ==
    { ZeroSrqsDealNotification }
        \cup { [ZeroSrqsDealNotification EXCEPT !.pad2 = one] : one \in Sample(2) }
        \cup { [ZeroSrqsDealNotification EXCEPT !.rbcHeaderComp = one] : one \in CheckedRbcHeaderComp11 }
        \cup { [ZeroSrqsDealNotification EXCEPT !.transactTime = one] : one \in Sample(8) }
        \cup { [ZeroSrqsDealNotification EXCEPT !.underlyingPriceStipValue = one] : one \in Sample(8) }
        \cup { [ZeroSrqsDealNotification EXCEPT !.underlyingPx = one] : one \in Sample(8) }
        \cup { [ZeroSrqsDealNotification EXCEPT !.lastPx = one] : one \in Sample(8) }
        \cup { [ZeroSrqsDealNotification EXCEPT !.lastQty = one] : one \in Sample(8) }
        \cup { [ZeroSrqsDealNotification EXCEPT !.negotiationId = one] : one \in Sample(4) }
        \cup { [ZeroSrqsDealNotification EXCEPT !.tradeId = one] : one \in Sample(4) }
        \cup { [ZeroSrqsDealNotification EXCEPT !.targetPartyIdExecutingTrader = one] : one \in Sample(4) }
        \cup { [ZeroSrqsDealNotification EXCEPT !.requestingPartySubIdType = one] : one \in Sample(2) }
        \cup { [ZeroSrqsDealNotification EXCEPT !.trdRptStatus = one] : one \in Sample(1) }
        \cup { [ZeroSrqsDealNotification EXCEPT !.tradeRequestResult = one] : one \in Sample(1) }
        \cup { [ZeroSrqsDealNotification EXCEPT !.messageEventSource = one] : one \in Sample(1) }
        \cup { [ZeroSrqsDealNotification EXCEPT !.tradingCapacity = one] : one \in Sample(1) }
        \cup { [ZeroSrqsDealNotification EXCEPT !.rootPartyExecutingFirm = one] : one \in Sample(5) }
        \cup { [ZeroSrqsDealNotification EXCEPT !.rootPartyExecutingTrader = one] : one \in Sample(6) }
        \cup { [ZeroSrqsDealNotification EXCEPT !.rootPartyEnteringTrader = one] : one \in Sample(6) }
        \cup { [ZeroSrqsDealNotification EXCEPT !.targetPartyExecutingFirm = one] : one \in Sample(5) }
        \cup { [ZeroSrqsDealNotification EXCEPT !.targetPartyExecutingTrader = one] : one \in Sample(6) }
        \cup { [ZeroSrqsDealNotification EXCEPT !.targetPartyEnteringTrader = one] : one \in Sample(6) }
        \cup { [ZeroSrqsDealNotification EXCEPT !.firmTradeId = one] : one \in Sample(20) }
        \cup { [ZeroSrqsDealNotification EXCEPT !.firmNegotiationId = one] : one \in Sample(20) }
        \cup { [ZeroSrqsDealNotification EXCEPT !.freeText1 = one] : one \in Sample(12) }
        \cup { [ZeroSrqsDealNotification EXCEPT !.freeText2 = one] : one \in Sample(12) }
        \cup { [ZeroSrqsDealNotification EXCEPT !.freeText3 = one] : one \in Sample(12) }
        \cup { [ZeroSrqsDealNotification EXCEPT !.freeText5 = one] : one \in Sample(132) }
        \cup { [ZeroSrqsDealNotification EXCEPT !.positionEffect = one] : one \in Sample(1) }
        \cup { [ZeroSrqsDealNotification EXCEPT !.account = one] : one \in Sample(2) }
        \cup { [ZeroSrqsDealNotification EXCEPT !.partyIdBeneficiary = one] : one \in Sample(9) }
        \cup { [ZeroSrqsDealNotification EXCEPT !.custOrderHandlingInst = one] : one \in Sample(1) }
        \cup { [ZeroSrqsDealNotification EXCEPT !.partyIdOrderOriginationFirm = one] : one \in Sample(7) }
        \cup { [ZeroSrqsDealNotification EXCEPT !.partyIdPositionAccount = one] : one \in Sample(32) }
        \cup { [ZeroSrqsDealNotification EXCEPT !.partyIdLocationId = one] : one \in Sample(2) }
        \cup { [ZeroSrqsDealNotification EXCEPT !.complianceText = one] : one \in Sample(20) }
        \cup { [ZeroSrqsDealNotification EXCEPT !.partyIdTakeUpTradingFirm = one] : one \in Sample(5) }
        \cup { [ZeroSrqsDealNotification EXCEPT !.pad5 = one] : one \in Sample(5) }

(***************************************************************************)
(* Response Header Comp: 24 bytes                                          *)
(***************************************************************************)

ResponseHeaderComp9 ==
    [ requestTime : Sample(8),
      sendingTime : Sample(8),
      msgSeqNum   : Sample(4),
      pad4        : Sample(4) ]

EncodeResponseHeaderComp9(message) ==
    message.requestTime
        \o message.sendingTime
        \o message.msgSeqNum
        \o message.pad4

DecodeResponseHeaderComp9(bytes) ==
    LET requestTime == ReadBytes(bytes, 8) IN IF ~requestTime.ok THEN Fail ELSE
    LET sendingTime == ReadBytes(requestTime.rest, 8) IN IF ~sendingTime.ok THEN Fail ELSE
    LET msgSeqNum == ReadBytes(sendingTime.rest, 4) IN IF ~msgSeqNum.ok THEN Fail ELSE
    LET pad4 == ReadBytes(msgSeqNum.rest, 4) IN IF ~pad4.ok THEN Fail ELSE
    Ok([ requestTime |-> requestTime.value,
         sendingTime |-> sendingTime.value,
         msgSeqNum   |-> msgSeqNum.value,
         pad4        |-> pad4.value ], pad4.rest)

ZeroResponseHeaderComp9 ==
    [ requestTime |-> [i \in 1 .. 8 |-> 0],
      sendingTime |-> [i \in 1 .. 8 |-> 0],
      msgSeqNum   |-> [i \in 1 .. 4 |-> 0],
      pad4        |-> [i \in 1 .. 4 |-> 0] ]

(* Response Header Comp at zero, then each field in turn at the values it is checked at *)
CheckedResponseHeaderComp9 ==
    { ZeroResponseHeaderComp9 }
        \cup { [ZeroResponseHeaderComp9 EXCEPT !.requestTime = one] : one \in Sample(8) }
        \cup { [ZeroResponseHeaderComp9 EXCEPT !.sendingTime = one] : one \in Sample(8) }
        \cup { [ZeroResponseHeaderComp9 EXCEPT !.msgSeqNum = one] : one \in Sample(4) }
        \cup { [ZeroResponseHeaderComp9 EXCEPT !.pad4 = one] : one \in Sample(4) }

(***************************************************************************)
(* Srqs Deal Response: 98 bytes                                            *)
(***************************************************************************)

SrqsDealResponse ==
    [ pad2               : Sample(2),
      responseHeaderComp : ResponseHeaderComp9,
      securityId         : Sample(8),
      quoteId            : Sample(8),
      negotiationId      : Sample(4),
      tradeId            : Sample(4),
      secondaryTradeId   : Sample(4),
      firmTradeId        : Sample(20),
      firmNegotiationId  : Sample(20),
      pad4               : Sample(4) ]

EncodeSrqsDealResponse(message) ==
    message.pad2
        \o EncodeResponseHeaderComp9(message.responseHeaderComp)
        \o message.securityId
        \o message.quoteId
        \o message.negotiationId
        \o message.tradeId
        \o message.secondaryTradeId
        \o message.firmTradeId
        \o message.firmNegotiationId
        \o message.pad4

DecodeSrqsDealResponse(bytes) ==
    LET pad2 == ReadBytes(bytes, 2) IN IF ~pad2.ok THEN Fail ELSE
    LET responseHeaderComp == DecodeResponseHeaderComp9(pad2.rest) IN IF ~responseHeaderComp.ok THEN Fail ELSE
    LET securityId == ReadBytes(responseHeaderComp.rest, 8) IN IF ~securityId.ok THEN Fail ELSE
    LET quoteId == ReadBytes(securityId.rest, 8) IN IF ~quoteId.ok THEN Fail ELSE
    LET negotiationId == ReadBytes(quoteId.rest, 4) IN IF ~negotiationId.ok THEN Fail ELSE
    LET tradeId == ReadBytes(negotiationId.rest, 4) IN IF ~tradeId.ok THEN Fail ELSE
    LET secondaryTradeId == ReadBytes(tradeId.rest, 4) IN IF ~secondaryTradeId.ok THEN Fail ELSE
    LET firmTradeId == ReadBytes(secondaryTradeId.rest, 20) IN IF ~firmTradeId.ok THEN Fail ELSE
    LET firmNegotiationId == ReadBytes(firmTradeId.rest, 20) IN IF ~firmNegotiationId.ok THEN Fail ELSE
    LET pad4 == ReadBytes(firmNegotiationId.rest, 4) IN IF ~pad4.ok THEN Fail ELSE
    Ok([ pad2               |-> pad2.value,
         responseHeaderComp |-> responseHeaderComp.value,
         securityId         |-> securityId.value,
         quoteId            |-> quoteId.value,
         negotiationId      |-> negotiationId.value,
         tradeId            |-> tradeId.value,
         secondaryTradeId   |-> secondaryTradeId.value,
         firmTradeId        |-> firmTradeId.value,
         firmNegotiationId  |-> firmNegotiationId.value,
         pad4               |-> pad4.value ], pad4.rest)

ZeroSrqsDealResponse ==
    [ pad2               |-> [i \in 1 .. 2 |-> 0],
      responseHeaderComp |-> ZeroResponseHeaderComp9,
      securityId         |-> [i \in 1 .. 8 |-> 0],
      quoteId            |-> [i \in 1 .. 8 |-> 0],
      negotiationId      |-> [i \in 1 .. 4 |-> 0],
      tradeId            |-> [i \in 1 .. 4 |-> 0],
      secondaryTradeId   |-> [i \in 1 .. 4 |-> 0],
      firmTradeId        |-> [i \in 1 .. 20 |-> 0],
      firmNegotiationId  |-> [i \in 1 .. 20 |-> 0],
      pad4               |-> [i \in 1 .. 4 |-> 0] ]

(* Srqs Deal Response at zero, then each field in turn at the values it is checked at *)
CheckedSrqsDealResponse ==
    { ZeroSrqsDealResponse }
        \cup { [ZeroSrqsDealResponse EXCEPT !.pad2 = one] : one \in Sample(2) }
        \cup { [ZeroSrqsDealResponse EXCEPT !.responseHeaderComp = one] : one \in CheckedResponseHeaderComp9 }
        \cup { [ZeroSrqsDealResponse EXCEPT !.securityId = one] : one \in Sample(8) }
        \cup { [ZeroSrqsDealResponse EXCEPT !.quoteId = one] : one \in Sample(8) }
        \cup { [ZeroSrqsDealResponse EXCEPT !.negotiationId = one] : one \in Sample(4) }
        \cup { [ZeroSrqsDealResponse EXCEPT !.tradeId = one] : one \in Sample(4) }
        \cup { [ZeroSrqsDealResponse EXCEPT !.secondaryTradeId = one] : one \in Sample(4) }
        \cup { [ZeroSrqsDealResponse EXCEPT !.firmTradeId = one] : one \in Sample(20) }
        \cup { [ZeroSrqsDealResponse EXCEPT !.firmNegotiationId = one] : one \in Sample(20) }
        \cup { [ZeroSrqsDealResponse EXCEPT !.pad4 = one] : one \in Sample(4) }

(***************************************************************************)
(* Response Header Comp: 24 bytes                                          *)
(***************************************************************************)

ResponseHeaderComp10 ==
    [ requestTime : Sample(8),
      sendingTime : Sample(8),
      msgSeqNum   : Sample(4),
      pad4        : Sample(4) ]

EncodeResponseHeaderComp10(message) ==
    message.requestTime
        \o message.sendingTime
        \o message.msgSeqNum
        \o message.pad4

DecodeResponseHeaderComp10(bytes) ==
    LET requestTime == ReadBytes(bytes, 8) IN IF ~requestTime.ok THEN Fail ELSE
    LET sendingTime == ReadBytes(requestTime.rest, 8) IN IF ~sendingTime.ok THEN Fail ELSE
    LET msgSeqNum == ReadBytes(sendingTime.rest, 4) IN IF ~msgSeqNum.ok THEN Fail ELSE
    LET pad4 == ReadBytes(msgSeqNum.rest, 4) IN IF ~pad4.ok THEN Fail ELSE
    Ok([ requestTime |-> requestTime.value,
         sendingTime |-> sendingTime.value,
         msgSeqNum   |-> msgSeqNum.value,
         pad4        |-> pad4.value ], pad4.rest)

ZeroResponseHeaderComp10 ==
    [ requestTime |-> [i \in 1 .. 8 |-> 0],
      sendingTime |-> [i \in 1 .. 8 |-> 0],
      msgSeqNum   |-> [i \in 1 .. 4 |-> 0],
      pad4        |-> [i \in 1 .. 4 |-> 0] ]

(* Response Header Comp at zero, then each field in turn at the values it is checked at *)
CheckedResponseHeaderComp10 ==
    { ZeroResponseHeaderComp10 }
        \cup { [ZeroResponseHeaderComp10 EXCEPT !.requestTime = one] : one \in Sample(8) }
        \cup { [ZeroResponseHeaderComp10 EXCEPT !.sendingTime = one] : one \in Sample(8) }
        \cup { [ZeroResponseHeaderComp10 EXCEPT !.msgSeqNum = one] : one \in Sample(4) }
        \cup { [ZeroResponseHeaderComp10 EXCEPT !.pad4 = one] : one \in Sample(4) }

(***************************************************************************)
(* Smart Party Detail Grp Comp: 16 bytes                                   *)
(***************************************************************************)

SmartPartyDetailGrpComp ==
    [ partyDetailExecutingUnit   : Sample(5),
      partyDetailExecutingTrader : Sample(6),
      pad5                       : Sample(5) ]

EncodeSmartPartyDetailGrpComp(message) ==
    message.partyDetailExecutingUnit
        \o message.partyDetailExecutingTrader
        \o message.pad5

DecodeSmartPartyDetailGrpComp(bytes) ==
    LET partyDetailExecutingUnit == ReadBytes(bytes, 5) IN IF ~partyDetailExecutingUnit.ok THEN Fail ELSE
    LET partyDetailExecutingTrader == ReadBytes(partyDetailExecutingUnit.rest, 6) IN IF ~partyDetailExecutingTrader.ok THEN Fail ELSE
    LET pad5 == ReadBytes(partyDetailExecutingTrader.rest, 5) IN IF ~pad5.ok THEN Fail ELSE
    Ok([ partyDetailExecutingUnit   |-> partyDetailExecutingUnit.value,
         partyDetailExecutingTrader |-> partyDetailExecutingTrader.value,
         pad5                       |-> pad5.value ], pad5.rest)

ZeroSmartPartyDetailGrpComp ==
    [ partyDetailExecutingUnit   |-> [i \in 1 .. 5 |-> 0],
      partyDetailExecutingTrader |-> [i \in 1 .. 6 |-> 0],
      pad5                       |-> [i \in 1 .. 5 |-> 0] ]

(* Smart Party Detail Grp Comp at zero, then each field in turn at the values it is checked at *)
CheckedSmartPartyDetailGrpComp ==
    { ZeroSmartPartyDetailGrpComp }
        \cup { [ZeroSmartPartyDetailGrpComp EXCEPT !.partyDetailExecutingUnit = one] : one \in Sample(5) }
        \cup { [ZeroSmartPartyDetailGrpComp EXCEPT !.partyDetailExecutingTrader = one] : one \in Sample(6) }
        \cup { [ZeroSmartPartyDetailGrpComp EXCEPT !.pad5 = one] : one \in Sample(5) }

(* A run of Smart Party Detail Grp Comp, written one after another *)
RECURSIVE EncodeSmartPartyDetailGrpCompList(_)
EncodeSmartPartyDetailGrpCompList(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeSmartPartyDetailGrpComp(Head(messages)) \o EncodeSmartPartyDetailGrpCompList(Tail(messages))

(* As many Smart Party Detail Grp Comp as the field that counts them says *)
RECURSIVE ReadSmartPartyDetailGrpCompList(_, _)
ReadSmartPartyDetailGrpCompList(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeSmartPartyDetailGrpComp(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadSmartPartyDetailGrpCompList(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Smart Party Detail Grp Comp of each kind, for the lists that carry them *)
OneSmartPartyDetailGrpComp == { ZeroSmartPartyDetailGrpComp }

(***************************************************************************)
(* Srqs Inquire Smart Respondent Response                                  *)
(***************************************************************************)

SrqsInquireSmartRespondentResponse ==
    [ pad2                    : Sample(2),
      responseHeaderComp      : ResponseHeaderComp10,
      marketSegmentId         : Sample(4),
      pad2v2                  : Sample(2),
      smartPartyDetailGrpComp : SampleLists(OneSmartPartyDetailGrpComp) ]

EncodeSrqsInquireSmartRespondentResponse(message) ==
    message.pad2
        \o EncodeResponseHeaderComp10(message.responseHeaderComp)
        \o message.marketSegmentId
        \o EncodeUIntLE(Len(message.smartPartyDetailGrpComp), 2)
        \o message.pad2v2
        \o EncodeSmartPartyDetailGrpCompList(message.smartPartyDetailGrpComp)

DecodeSrqsInquireSmartRespondentResponse(bytes) ==
    LET pad2 == ReadBytes(bytes, 2) IN IF ~pad2.ok THEN Fail ELSE
    LET responseHeaderComp == DecodeResponseHeaderComp10(pad2.rest) IN IF ~responseHeaderComp.ok THEN Fail ELSE
    LET marketSegmentId == ReadBytes(responseHeaderComp.rest, 4) IN IF ~marketSegmentId.ok THEN Fail ELSE
    LET noPartyDetails == ReadUIntLE(marketSegmentId.rest, 2) IN IF ~noPartyDetails.ok THEN Fail ELSE
    LET pad2v2 == ReadBytes(noPartyDetails.rest, 2) IN IF ~pad2v2.ok THEN Fail ELSE
    LET smartPartyDetailGrpComp == ReadSmartPartyDetailGrpCompList(pad2v2.rest, noPartyDetails.value) IN IF ~smartPartyDetailGrpComp.ok THEN Fail ELSE
    Ok([ pad2                    |-> pad2.value,
         responseHeaderComp      |-> responseHeaderComp.value,
         marketSegmentId         |-> marketSegmentId.value,
         pad2v2                  |-> pad2v2.value,
         smartPartyDetailGrpComp |-> smartPartyDetailGrpComp.value ], smartPartyDetailGrpComp.rest)

ZeroSrqsInquireSmartRespondentResponse ==
    [ pad2                    |-> [i \in 1 .. 2 |-> 0],
      responseHeaderComp      |-> ZeroResponseHeaderComp10,
      marketSegmentId         |-> [i \in 1 .. 4 |-> 0],
      pad2v2                  |-> [i \in 1 .. 2 |-> 0],
      smartPartyDetailGrpComp |-> << >> ]

(* Srqs Inquire Smart Respondent Response at zero, then each field in turn at the values it is checked at *)
CheckedSrqsInquireSmartRespondentResponse ==
    { ZeroSrqsInquireSmartRespondentResponse }
        \cup { [ZeroSrqsInquireSmartRespondentResponse EXCEPT !.pad2 = one] : one \in Sample(2) }
        \cup { [ZeroSrqsInquireSmartRespondentResponse EXCEPT !.responseHeaderComp = one] : one \in CheckedResponseHeaderComp10 }
        \cup { [ZeroSrqsInquireSmartRespondentResponse EXCEPT !.marketSegmentId = one] : one \in Sample(4) }
        \cup { [ZeroSrqsInquireSmartRespondentResponse EXCEPT !.pad2v2 = one] : one \in Sample(2) }
        \cup { [ZeroSrqsInquireSmartRespondentResponse EXCEPT !.smartPartyDetailGrpComp = one] : one \in SampleLists(OneSmartPartyDetailGrpComp) }

(***************************************************************************)
(* Rbc Header Comp: 32 bytes                                               *)
(***************************************************************************)

RbcHeaderComp12 ==
    [ sendingTime    : Sample(8),
      applSeqNum     : Sample(8),
      applSubId      : Sample(4),
      partitionId    : Sample(2),
      applResendFlag : Sample(1),
      applId         : Sample(1),
      lastFragment   : Sample(1),
      pad7           : Sample(7) ]

EncodeRbcHeaderComp12(message) ==
    message.sendingTime
        \o message.applSeqNum
        \o message.applSubId
        \o message.partitionId
        \o message.applResendFlag
        \o message.applId
        \o message.lastFragment
        \o message.pad7

DecodeRbcHeaderComp12(bytes) ==
    LET sendingTime == ReadBytes(bytes, 8) IN IF ~sendingTime.ok THEN Fail ELSE
    LET applSeqNum == ReadBytes(sendingTime.rest, 8) IN IF ~applSeqNum.ok THEN Fail ELSE
    LET applSubId == ReadBytes(applSeqNum.rest, 4) IN IF ~applSubId.ok THEN Fail ELSE
    LET partitionId == ReadBytes(applSubId.rest, 2) IN IF ~partitionId.ok THEN Fail ELSE
    LET applResendFlag == ReadBytes(partitionId.rest, 1) IN IF ~applResendFlag.ok THEN Fail ELSE
    LET applId == ReadBytes(applResendFlag.rest, 1) IN IF ~applId.ok THEN Fail ELSE
    LET lastFragment == ReadBytes(applId.rest, 1) IN IF ~lastFragment.ok THEN Fail ELSE
    LET pad7 == ReadBytes(lastFragment.rest, 7) IN IF ~pad7.ok THEN Fail ELSE
    Ok([ sendingTime    |-> sendingTime.value,
         applSeqNum     |-> applSeqNum.value,
         applSubId      |-> applSubId.value,
         partitionId    |-> partitionId.value,
         applResendFlag |-> applResendFlag.value,
         applId         |-> applId.value,
         lastFragment   |-> lastFragment.value,
         pad7           |-> pad7.value ], pad7.rest)

ZeroRbcHeaderComp12 ==
    [ sendingTime    |-> [i \in 1 .. 8 |-> 0],
      applSeqNum     |-> [i \in 1 .. 8 |-> 0],
      applSubId      |-> [i \in 1 .. 4 |-> 0],
      partitionId    |-> [i \in 1 .. 2 |-> 0],
      applResendFlag |-> [i \in 1 .. 1 |-> 0],
      applId         |-> [i \in 1 .. 1 |-> 0],
      lastFragment   |-> [i \in 1 .. 1 |-> 0],
      pad7           |-> [i \in 1 .. 7 |-> 0] ]

(* Rbc Header Comp at zero, then each field in turn at the values it is checked at *)
CheckedRbcHeaderComp12 ==
    { ZeroRbcHeaderComp12 }
        \cup { [ZeroRbcHeaderComp12 EXCEPT !.sendingTime = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderComp12 EXCEPT !.applSeqNum = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderComp12 EXCEPT !.applSubId = one] : one \in Sample(4) }
        \cup { [ZeroRbcHeaderComp12 EXCEPT !.partitionId = one] : one \in Sample(2) }
        \cup { [ZeroRbcHeaderComp12 EXCEPT !.applResendFlag = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp12 EXCEPT !.applId = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp12 EXCEPT !.lastFragment = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp12 EXCEPT !.pad7 = one] : one \in Sample(7) }

(***************************************************************************)
(* Srqs Negotiation Notification: 450 bytes                                *)
(***************************************************************************)

SrqsNegotiationNotification ==
    [ pad2                        : Sample(2),
      rbcHeaderComp               : RbcHeaderComp12,
      transactTime                : Sample(8),
      quoteRefPrice               : Sample(8),
      underlyingDeltaPercentage   : Sample(8),
      bidPx                       : Sample(8),
      offerPx                     : Sample(8),
      lastPx                      : Sample(8),
      leavesQty                   : Sample(8),
      lastQty                     : Sample(8),
      effectiveTime               : Sample(8),
      lastUpdateTime              : Sample(8),
      tradeToQuoteRatio           : Sample(8),
      negotiationId               : Sample(4),
      numberOfRespondents         : Sample(4),
      tradeToQuoteRatioPosition   : Sample(2),
      quoteType                   : Sample(1),
      quoteSubType                : Sample(1),
      quoteStatus                 : Sample(1),
      quoteInstruction            : Sample(1),
      side                        : Sample(1),
      partyExecutingFirm          : Sample(5),
      partyExecutingTrader        : Sample(6),
      partyEnteringTrader         : Sample(6),
      targetPartyExecutingFirm    : Sample(5),
      targetPartyExecutingTrader  : Sample(6),
      firmNegotiationId           : Sample(20),
      freeText5                   : Sample(132),
      partyOrderOriginationTrader : Sample(132),
      pad1                        : Sample(1) ]

EncodeSrqsNegotiationNotification(message) ==
    message.pad2
        \o EncodeRbcHeaderComp12(message.rbcHeaderComp)
        \o message.transactTime
        \o message.quoteRefPrice
        \o message.underlyingDeltaPercentage
        \o message.bidPx
        \o message.offerPx
        \o message.lastPx
        \o message.leavesQty
        \o message.lastQty
        \o message.effectiveTime
        \o message.lastUpdateTime
        \o message.tradeToQuoteRatio
        \o message.negotiationId
        \o message.numberOfRespondents
        \o message.tradeToQuoteRatioPosition
        \o message.quoteType
        \o message.quoteSubType
        \o message.quoteStatus
        \o message.quoteInstruction
        \o message.side
        \o message.partyExecutingFirm
        \o message.partyExecutingTrader
        \o message.partyEnteringTrader
        \o message.targetPartyExecutingFirm
        \o message.targetPartyExecutingTrader
        \o message.firmNegotiationId
        \o message.freeText5
        \o message.partyOrderOriginationTrader
        \o message.pad1

DecodeSrqsNegotiationNotification(bytes) ==
    LET pad2 == ReadBytes(bytes, 2) IN IF ~pad2.ok THEN Fail ELSE
    LET rbcHeaderComp == DecodeRbcHeaderComp12(pad2.rest) IN IF ~rbcHeaderComp.ok THEN Fail ELSE
    LET transactTime == ReadBytes(rbcHeaderComp.rest, 8) IN IF ~transactTime.ok THEN Fail ELSE
    LET quoteRefPrice == ReadBytes(transactTime.rest, 8) IN IF ~quoteRefPrice.ok THEN Fail ELSE
    LET underlyingDeltaPercentage == ReadBytes(quoteRefPrice.rest, 8) IN IF ~underlyingDeltaPercentage.ok THEN Fail ELSE
    LET bidPx == ReadBytes(underlyingDeltaPercentage.rest, 8) IN IF ~bidPx.ok THEN Fail ELSE
    LET offerPx == ReadBytes(bidPx.rest, 8) IN IF ~offerPx.ok THEN Fail ELSE
    LET lastPx == ReadBytes(offerPx.rest, 8) IN IF ~lastPx.ok THEN Fail ELSE
    LET leavesQty == ReadBytes(lastPx.rest, 8) IN IF ~leavesQty.ok THEN Fail ELSE
    LET lastQty == ReadBytes(leavesQty.rest, 8) IN IF ~lastQty.ok THEN Fail ELSE
    LET effectiveTime == ReadBytes(lastQty.rest, 8) IN IF ~effectiveTime.ok THEN Fail ELSE
    LET lastUpdateTime == ReadBytes(effectiveTime.rest, 8) IN IF ~lastUpdateTime.ok THEN Fail ELSE
    LET tradeToQuoteRatio == ReadBytes(lastUpdateTime.rest, 8) IN IF ~tradeToQuoteRatio.ok THEN Fail ELSE
    LET negotiationId == ReadBytes(tradeToQuoteRatio.rest, 4) IN IF ~negotiationId.ok THEN Fail ELSE
    LET numberOfRespondents == ReadBytes(negotiationId.rest, 4) IN IF ~numberOfRespondents.ok THEN Fail ELSE
    LET tradeToQuoteRatioPosition == ReadBytes(numberOfRespondents.rest, 2) IN IF ~tradeToQuoteRatioPosition.ok THEN Fail ELSE
    LET quoteType == ReadBytes(tradeToQuoteRatioPosition.rest, 1) IN IF ~quoteType.ok THEN Fail ELSE
    LET quoteSubType == ReadBytes(quoteType.rest, 1) IN IF ~quoteSubType.ok THEN Fail ELSE
    LET quoteStatus == ReadBytes(quoteSubType.rest, 1) IN IF ~quoteStatus.ok THEN Fail ELSE
    LET quoteInstruction == ReadBytes(quoteStatus.rest, 1) IN IF ~quoteInstruction.ok THEN Fail ELSE
    LET side == ReadBytes(quoteInstruction.rest, 1) IN IF ~side.ok THEN Fail ELSE
    LET partyExecutingFirm == ReadBytes(side.rest, 5) IN IF ~partyExecutingFirm.ok THEN Fail ELSE
    LET partyExecutingTrader == ReadBytes(partyExecutingFirm.rest, 6) IN IF ~partyExecutingTrader.ok THEN Fail ELSE
    LET partyEnteringTrader == ReadBytes(partyExecutingTrader.rest, 6) IN IF ~partyEnteringTrader.ok THEN Fail ELSE
    LET targetPartyExecutingFirm == ReadBytes(partyEnteringTrader.rest, 5) IN IF ~targetPartyExecutingFirm.ok THEN Fail ELSE
    LET targetPartyExecutingTrader == ReadBytes(targetPartyExecutingFirm.rest, 6) IN IF ~targetPartyExecutingTrader.ok THEN Fail ELSE
    LET firmNegotiationId == ReadBytes(targetPartyExecutingTrader.rest, 20) IN IF ~firmNegotiationId.ok THEN Fail ELSE
    LET freeText5 == ReadBytes(firmNegotiationId.rest, 132) IN IF ~freeText5.ok THEN Fail ELSE
    LET partyOrderOriginationTrader == ReadBytes(freeText5.rest, 132) IN IF ~partyOrderOriginationTrader.ok THEN Fail ELSE
    LET pad1 == ReadBytes(partyOrderOriginationTrader.rest, 1) IN IF ~pad1.ok THEN Fail ELSE
    Ok([ pad2                        |-> pad2.value,
         rbcHeaderComp               |-> rbcHeaderComp.value,
         transactTime                |-> transactTime.value,
         quoteRefPrice               |-> quoteRefPrice.value,
         underlyingDeltaPercentage   |-> underlyingDeltaPercentage.value,
         bidPx                       |-> bidPx.value,
         offerPx                     |-> offerPx.value,
         lastPx                      |-> lastPx.value,
         leavesQty                   |-> leavesQty.value,
         lastQty                     |-> lastQty.value,
         effectiveTime               |-> effectiveTime.value,
         lastUpdateTime              |-> lastUpdateTime.value,
         tradeToQuoteRatio           |-> tradeToQuoteRatio.value,
         negotiationId               |-> negotiationId.value,
         numberOfRespondents         |-> numberOfRespondents.value,
         tradeToQuoteRatioPosition   |-> tradeToQuoteRatioPosition.value,
         quoteType                   |-> quoteType.value,
         quoteSubType                |-> quoteSubType.value,
         quoteStatus                 |-> quoteStatus.value,
         quoteInstruction            |-> quoteInstruction.value,
         side                        |-> side.value,
         partyExecutingFirm          |-> partyExecutingFirm.value,
         partyExecutingTrader        |-> partyExecutingTrader.value,
         partyEnteringTrader         |-> partyEnteringTrader.value,
         targetPartyExecutingFirm    |-> targetPartyExecutingFirm.value,
         targetPartyExecutingTrader  |-> targetPartyExecutingTrader.value,
         firmNegotiationId           |-> firmNegotiationId.value,
         freeText5                   |-> freeText5.value,
         partyOrderOriginationTrader |-> partyOrderOriginationTrader.value,
         pad1                        |-> pad1.value ], pad1.rest)

ZeroSrqsNegotiationNotification ==
    [ pad2                        |-> [i \in 1 .. 2 |-> 0],
      rbcHeaderComp               |-> ZeroRbcHeaderComp12,
      transactTime                |-> [i \in 1 .. 8 |-> 0],
      quoteRefPrice               |-> [i \in 1 .. 8 |-> 0],
      underlyingDeltaPercentage   |-> [i \in 1 .. 8 |-> 0],
      bidPx                       |-> [i \in 1 .. 8 |-> 0],
      offerPx                     |-> [i \in 1 .. 8 |-> 0],
      lastPx                      |-> [i \in 1 .. 8 |-> 0],
      leavesQty                   |-> [i \in 1 .. 8 |-> 0],
      lastQty                     |-> [i \in 1 .. 8 |-> 0],
      effectiveTime               |-> [i \in 1 .. 8 |-> 0],
      lastUpdateTime              |-> [i \in 1 .. 8 |-> 0],
      tradeToQuoteRatio           |-> [i \in 1 .. 8 |-> 0],
      negotiationId               |-> [i \in 1 .. 4 |-> 0],
      numberOfRespondents         |-> [i \in 1 .. 4 |-> 0],
      tradeToQuoteRatioPosition   |-> [i \in 1 .. 2 |-> 0],
      quoteType                   |-> [i \in 1 .. 1 |-> 0],
      quoteSubType                |-> [i \in 1 .. 1 |-> 0],
      quoteStatus                 |-> [i \in 1 .. 1 |-> 0],
      quoteInstruction            |-> [i \in 1 .. 1 |-> 0],
      side                        |-> [i \in 1 .. 1 |-> 0],
      partyExecutingFirm          |-> [i \in 1 .. 5 |-> 0],
      partyExecutingTrader        |-> [i \in 1 .. 6 |-> 0],
      partyEnteringTrader         |-> [i \in 1 .. 6 |-> 0],
      targetPartyExecutingFirm    |-> [i \in 1 .. 5 |-> 0],
      targetPartyExecutingTrader  |-> [i \in 1 .. 6 |-> 0],
      firmNegotiationId           |-> [i \in 1 .. 20 |-> 0],
      freeText5                   |-> [i \in 1 .. 132 |-> 0],
      partyOrderOriginationTrader |-> [i \in 1 .. 132 |-> 0],
      pad1                        |-> [i \in 1 .. 1 |-> 0] ]

(* Srqs Negotiation Notification at zero, then each field in turn at the values it is checked at *)
CheckedSrqsNegotiationNotification ==
    { ZeroSrqsNegotiationNotification }
        \cup { [ZeroSrqsNegotiationNotification EXCEPT !.pad2 = one] : one \in Sample(2) }
        \cup { [ZeroSrqsNegotiationNotification EXCEPT !.rbcHeaderComp = one] : one \in CheckedRbcHeaderComp12 }
        \cup { [ZeroSrqsNegotiationNotification EXCEPT !.transactTime = one] : one \in Sample(8) }
        \cup { [ZeroSrqsNegotiationNotification EXCEPT !.quoteRefPrice = one] : one \in Sample(8) }
        \cup { [ZeroSrqsNegotiationNotification EXCEPT !.underlyingDeltaPercentage = one] : one \in Sample(8) }
        \cup { [ZeroSrqsNegotiationNotification EXCEPT !.bidPx = one] : one \in Sample(8) }
        \cup { [ZeroSrqsNegotiationNotification EXCEPT !.offerPx = one] : one \in Sample(8) }
        \cup { [ZeroSrqsNegotiationNotification EXCEPT !.lastPx = one] : one \in Sample(8) }
        \cup { [ZeroSrqsNegotiationNotification EXCEPT !.leavesQty = one] : one \in Sample(8) }
        \cup { [ZeroSrqsNegotiationNotification EXCEPT !.lastQty = one] : one \in Sample(8) }
        \cup { [ZeroSrqsNegotiationNotification EXCEPT !.effectiveTime = one] : one \in Sample(8) }
        \cup { [ZeroSrqsNegotiationNotification EXCEPT !.lastUpdateTime = one] : one \in Sample(8) }
        \cup { [ZeroSrqsNegotiationNotification EXCEPT !.tradeToQuoteRatio = one] : one \in Sample(8) }
        \cup { [ZeroSrqsNegotiationNotification EXCEPT !.negotiationId = one] : one \in Sample(4) }
        \cup { [ZeroSrqsNegotiationNotification EXCEPT !.numberOfRespondents = one] : one \in Sample(4) }
        \cup { [ZeroSrqsNegotiationNotification EXCEPT !.tradeToQuoteRatioPosition = one] : one \in Sample(2) }
        \cup { [ZeroSrqsNegotiationNotification EXCEPT !.quoteType = one] : one \in Sample(1) }
        \cup { [ZeroSrqsNegotiationNotification EXCEPT !.quoteSubType = one] : one \in Sample(1) }
        \cup { [ZeroSrqsNegotiationNotification EXCEPT !.quoteStatus = one] : one \in Sample(1) }
        \cup { [ZeroSrqsNegotiationNotification EXCEPT !.quoteInstruction = one] : one \in Sample(1) }
        \cup { [ZeroSrqsNegotiationNotification EXCEPT !.side = one] : one \in Sample(1) }
        \cup { [ZeroSrqsNegotiationNotification EXCEPT !.partyExecutingFirm = one] : one \in Sample(5) }
        \cup { [ZeroSrqsNegotiationNotification EXCEPT !.partyExecutingTrader = one] : one \in Sample(6) }
        \cup { [ZeroSrqsNegotiationNotification EXCEPT !.partyEnteringTrader = one] : one \in Sample(6) }
        \cup { [ZeroSrqsNegotiationNotification EXCEPT !.targetPartyExecutingFirm = one] : one \in Sample(5) }
        \cup { [ZeroSrqsNegotiationNotification EXCEPT !.targetPartyExecutingTrader = one] : one \in Sample(6) }
        \cup { [ZeroSrqsNegotiationNotification EXCEPT !.firmNegotiationId = one] : one \in Sample(20) }
        \cup { [ZeroSrqsNegotiationNotification EXCEPT !.freeText5 = one] : one \in Sample(132) }
        \cup { [ZeroSrqsNegotiationNotification EXCEPT !.partyOrderOriginationTrader = one] : one \in Sample(132) }
        \cup { [ZeroSrqsNegotiationNotification EXCEPT !.pad1 = one] : one \in Sample(1) }

(***************************************************************************)
(* Rbc Header Comp: 32 bytes                                               *)
(***************************************************************************)

RbcHeaderComp13 ==
    [ sendingTime    : Sample(8),
      applSeqNum     : Sample(8),
      applSubId      : Sample(4),
      partitionId    : Sample(2),
      applResendFlag : Sample(1),
      applId         : Sample(1),
      lastFragment   : Sample(1),
      pad7           : Sample(7) ]

EncodeRbcHeaderComp13(message) ==
    message.sendingTime
        \o message.applSeqNum
        \o message.applSubId
        \o message.partitionId
        \o message.applResendFlag
        \o message.applId
        \o message.lastFragment
        \o message.pad7

DecodeRbcHeaderComp13(bytes) ==
    LET sendingTime == ReadBytes(bytes, 8) IN IF ~sendingTime.ok THEN Fail ELSE
    LET applSeqNum == ReadBytes(sendingTime.rest, 8) IN IF ~applSeqNum.ok THEN Fail ELSE
    LET applSubId == ReadBytes(applSeqNum.rest, 4) IN IF ~applSubId.ok THEN Fail ELSE
    LET partitionId == ReadBytes(applSubId.rest, 2) IN IF ~partitionId.ok THEN Fail ELSE
    LET applResendFlag == ReadBytes(partitionId.rest, 1) IN IF ~applResendFlag.ok THEN Fail ELSE
    LET applId == ReadBytes(applResendFlag.rest, 1) IN IF ~applId.ok THEN Fail ELSE
    LET lastFragment == ReadBytes(applId.rest, 1) IN IF ~lastFragment.ok THEN Fail ELSE
    LET pad7 == ReadBytes(lastFragment.rest, 7) IN IF ~pad7.ok THEN Fail ELSE
    Ok([ sendingTime    |-> sendingTime.value,
         applSeqNum     |-> applSeqNum.value,
         applSubId      |-> applSubId.value,
         partitionId    |-> partitionId.value,
         applResendFlag |-> applResendFlag.value,
         applId         |-> applId.value,
         lastFragment   |-> lastFragment.value,
         pad7           |-> pad7.value ], pad7.rest)

ZeroRbcHeaderComp13 ==
    [ sendingTime    |-> [i \in 1 .. 8 |-> 0],
      applSeqNum     |-> [i \in 1 .. 8 |-> 0],
      applSubId      |-> [i \in 1 .. 4 |-> 0],
      partitionId    |-> [i \in 1 .. 2 |-> 0],
      applResendFlag |-> [i \in 1 .. 1 |-> 0],
      applId         |-> [i \in 1 .. 1 |-> 0],
      lastFragment   |-> [i \in 1 .. 1 |-> 0],
      pad7           |-> [i \in 1 .. 7 |-> 0] ]

(* Rbc Header Comp at zero, then each field in turn at the values it is checked at *)
CheckedRbcHeaderComp13 ==
    { ZeroRbcHeaderComp13 }
        \cup { [ZeroRbcHeaderComp13 EXCEPT !.sendingTime = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderComp13 EXCEPT !.applSeqNum = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderComp13 EXCEPT !.applSubId = one] : one \in Sample(4) }
        \cup { [ZeroRbcHeaderComp13 EXCEPT !.partitionId = one] : one \in Sample(2) }
        \cup { [ZeroRbcHeaderComp13 EXCEPT !.applResendFlag = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp13 EXCEPT !.applId = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp13 EXCEPT !.lastFragment = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp13 EXCEPT !.pad7 = one] : one \in Sample(7) }

(***************************************************************************)
(* Target Parties Comp: 32 bytes                                           *)
(***************************************************************************)

TargetPartiesComp ==
    [ targetPartyIdExecutingTrader               : Sample(4),
      sideDisclosureInstruction                  : Sample(1),
      priceDisclosureInstruction                 : Sample(1),
      leavesQtyDisclosureInstruction             : Sample(1),
      lastPxDisclosureInstruction                : Sample(1),
      lastQtyDisclosureInstruction               : Sample(1),
      freeText5DisclosureInstruction             : Sample(1),
      partyOrderOriginationDisclosureInstruction : Sample(1),
      quoteInstruction                           : Sample(1),
      targetPartyExecutingFirm                   : Sample(5),
      targetPartyExecutingTrader                 : Sample(6),
      partyDetailStatus                          : Sample(1),
      partyDetailStatusInformation               : Sample(1),
      pad7                                       : Sample(7) ]

EncodeTargetPartiesComp(message) ==
    message.targetPartyIdExecutingTrader
        \o message.sideDisclosureInstruction
        \o message.priceDisclosureInstruction
        \o message.leavesQtyDisclosureInstruction
        \o message.lastPxDisclosureInstruction
        \o message.lastQtyDisclosureInstruction
        \o message.freeText5DisclosureInstruction
        \o message.partyOrderOriginationDisclosureInstruction
        \o message.quoteInstruction
        \o message.targetPartyExecutingFirm
        \o message.targetPartyExecutingTrader
        \o message.partyDetailStatus
        \o message.partyDetailStatusInformation
        \o message.pad7

DecodeTargetPartiesComp(bytes) ==
    LET targetPartyIdExecutingTrader == ReadBytes(bytes, 4) IN IF ~targetPartyIdExecutingTrader.ok THEN Fail ELSE
    LET sideDisclosureInstruction == ReadBytes(targetPartyIdExecutingTrader.rest, 1) IN IF ~sideDisclosureInstruction.ok THEN Fail ELSE
    LET priceDisclosureInstruction == ReadBytes(sideDisclosureInstruction.rest, 1) IN IF ~priceDisclosureInstruction.ok THEN Fail ELSE
    LET leavesQtyDisclosureInstruction == ReadBytes(priceDisclosureInstruction.rest, 1) IN IF ~leavesQtyDisclosureInstruction.ok THEN Fail ELSE
    LET lastPxDisclosureInstruction == ReadBytes(leavesQtyDisclosureInstruction.rest, 1) IN IF ~lastPxDisclosureInstruction.ok THEN Fail ELSE
    LET lastQtyDisclosureInstruction == ReadBytes(lastPxDisclosureInstruction.rest, 1) IN IF ~lastQtyDisclosureInstruction.ok THEN Fail ELSE
    LET freeText5DisclosureInstruction == ReadBytes(lastQtyDisclosureInstruction.rest, 1) IN IF ~freeText5DisclosureInstruction.ok THEN Fail ELSE
    LET partyOrderOriginationDisclosureInstruction == ReadBytes(freeText5DisclosureInstruction.rest, 1) IN IF ~partyOrderOriginationDisclosureInstruction.ok THEN Fail ELSE
    LET quoteInstruction == ReadBytes(partyOrderOriginationDisclosureInstruction.rest, 1) IN IF ~quoteInstruction.ok THEN Fail ELSE
    LET targetPartyExecutingFirm == ReadBytes(quoteInstruction.rest, 5) IN IF ~targetPartyExecutingFirm.ok THEN Fail ELSE
    LET targetPartyExecutingTrader == ReadBytes(targetPartyExecutingFirm.rest, 6) IN IF ~targetPartyExecutingTrader.ok THEN Fail ELSE
    LET partyDetailStatus == ReadBytes(targetPartyExecutingTrader.rest, 1) IN IF ~partyDetailStatus.ok THEN Fail ELSE
    LET partyDetailStatusInformation == ReadBytes(partyDetailStatus.rest, 1) IN IF ~partyDetailStatusInformation.ok THEN Fail ELSE
    LET pad7 == ReadBytes(partyDetailStatusInformation.rest, 7) IN IF ~pad7.ok THEN Fail ELSE
    Ok([ targetPartyIdExecutingTrader               |-> targetPartyIdExecutingTrader.value,
         sideDisclosureInstruction                  |-> sideDisclosureInstruction.value,
         priceDisclosureInstruction                 |-> priceDisclosureInstruction.value,
         leavesQtyDisclosureInstruction             |-> leavesQtyDisclosureInstruction.value,
         lastPxDisclosureInstruction                |-> lastPxDisclosureInstruction.value,
         lastQtyDisclosureInstruction               |-> lastQtyDisclosureInstruction.value,
         freeText5DisclosureInstruction             |-> freeText5DisclosureInstruction.value,
         partyOrderOriginationDisclosureInstruction |-> partyOrderOriginationDisclosureInstruction.value,
         quoteInstruction                           |-> quoteInstruction.value,
         targetPartyExecutingFirm                   |-> targetPartyExecutingFirm.value,
         targetPartyExecutingTrader                 |-> targetPartyExecutingTrader.value,
         partyDetailStatus                          |-> partyDetailStatus.value,
         partyDetailStatusInformation               |-> partyDetailStatusInformation.value,
         pad7                                       |-> pad7.value ], pad7.rest)

ZeroTargetPartiesComp ==
    [ targetPartyIdExecutingTrader               |-> [i \in 1 .. 4 |-> 0],
      sideDisclosureInstruction                  |-> [i \in 1 .. 1 |-> 0],
      priceDisclosureInstruction                 |-> [i \in 1 .. 1 |-> 0],
      leavesQtyDisclosureInstruction             |-> [i \in 1 .. 1 |-> 0],
      lastPxDisclosureInstruction                |-> [i \in 1 .. 1 |-> 0],
      lastQtyDisclosureInstruction               |-> [i \in 1 .. 1 |-> 0],
      freeText5DisclosureInstruction             |-> [i \in 1 .. 1 |-> 0],
      partyOrderOriginationDisclosureInstruction |-> [i \in 1 .. 1 |-> 0],
      quoteInstruction                           |-> [i \in 1 .. 1 |-> 0],
      targetPartyExecutingFirm                   |-> [i \in 1 .. 5 |-> 0],
      targetPartyExecutingTrader                 |-> [i \in 1 .. 6 |-> 0],
      partyDetailStatus                          |-> [i \in 1 .. 1 |-> 0],
      partyDetailStatusInformation               |-> [i \in 1 .. 1 |-> 0],
      pad7                                       |-> [i \in 1 .. 7 |-> 0] ]

(* Target Parties Comp at zero, then each field in turn at the values it is checked at *)
CheckedTargetPartiesComp ==
    { ZeroTargetPartiesComp }
        \cup { [ZeroTargetPartiesComp EXCEPT !.targetPartyIdExecutingTrader = one] : one \in Sample(4) }
        \cup { [ZeroTargetPartiesComp EXCEPT !.sideDisclosureInstruction = one] : one \in Sample(1) }
        \cup { [ZeroTargetPartiesComp EXCEPT !.priceDisclosureInstruction = one] : one \in Sample(1) }
        \cup { [ZeroTargetPartiesComp EXCEPT !.leavesQtyDisclosureInstruction = one] : one \in Sample(1) }
        \cup { [ZeroTargetPartiesComp EXCEPT !.lastPxDisclosureInstruction = one] : one \in Sample(1) }
        \cup { [ZeroTargetPartiesComp EXCEPT !.lastQtyDisclosureInstruction = one] : one \in Sample(1) }
        \cup { [ZeroTargetPartiesComp EXCEPT !.freeText5DisclosureInstruction = one] : one \in Sample(1) }
        \cup { [ZeroTargetPartiesComp EXCEPT !.partyOrderOriginationDisclosureInstruction = one] : one \in Sample(1) }
        \cup { [ZeroTargetPartiesComp EXCEPT !.quoteInstruction = one] : one \in Sample(1) }
        \cup { [ZeroTargetPartiesComp EXCEPT !.targetPartyExecutingFirm = one] : one \in Sample(5) }
        \cup { [ZeroTargetPartiesComp EXCEPT !.targetPartyExecutingTrader = one] : one \in Sample(6) }
        \cup { [ZeroTargetPartiesComp EXCEPT !.partyDetailStatus = one] : one \in Sample(1) }
        \cup { [ZeroTargetPartiesComp EXCEPT !.partyDetailStatusInformation = one] : one \in Sample(1) }
        \cup { [ZeroTargetPartiesComp EXCEPT !.pad7 = one] : one \in Sample(7) }

(* A run of Target Parties Comp, written one after another *)
RECURSIVE EncodeTargetPartiesCompList(_)
EncodeTargetPartiesCompList(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeTargetPartiesComp(Head(messages)) \o EncodeTargetPartiesCompList(Tail(messages))

(* As many Target Parties Comp as the field that counts them says *)
RECURSIVE ReadTargetPartiesCompList(_, _)
ReadTargetPartiesCompList(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeTargetPartiesComp(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadTargetPartiesCompList(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Target Parties Comp of each kind, for the lists that carry them *)
OneTargetPartiesComp == { ZeroTargetPartiesComp }

(***************************************************************************)
(* Srqs Negotiation Requester Notification                                 *)
(***************************************************************************)

SrqsNegotiationRequesterNotification ==
    [ pad2                              : Sample(2),
      rbcHeaderComp                     : RbcHeaderComp13,
      transactTime                      : Sample(8),
      trdRegTsExecutionTime             : Sample(8),
      quoteRefPrice                     : Sample(8),
      underlyingDeltaPercentage         : Sample(8),
      bidPx                             : Sample(8),
      offerPx                           : Sample(8),
      orderQty                          : Sample(8),
      lastPx                            : Sample(8),
      leavesQty                         : Sample(8),
      lastQty                           : Sample(8),
      effectiveTime                     : Sample(8),
      lastUpdateTime                    : Sample(8),
      negotiationId                     : Sample(4),
      numberOfRespondents               : Sample(4),
      quoteType                         : Sample(1),
      quoteSubType                      : Sample(1),
      quoteStatus                       : Sample(1),
      numberOfRespDisclosureInstruction : Sample(1),
      side                              : Sample(1),
      showLastDealOnClosure             : Sample(1),
      partyExecutingFirm                : Sample(5),
      partyExecutingTrader              : Sample(6),
      partyEnteringTrader               : Sample(6),
      firmNegotiationId                 : Sample(20),
      freeText5                         : Sample(132),
      partyOrderOriginationTrader       : Sample(132),
      pad4                              : Sample(4),
      targetPartiesComp                 : SampleLists(OneTargetPartiesComp) ]

EncodeSrqsNegotiationRequesterNotification(message) ==
    message.pad2
        \o EncodeRbcHeaderComp13(message.rbcHeaderComp)
        \o message.transactTime
        \o message.trdRegTsExecutionTime
        \o message.quoteRefPrice
        \o message.underlyingDeltaPercentage
        \o message.bidPx
        \o message.offerPx
        \o message.orderQty
        \o message.lastPx
        \o message.leavesQty
        \o message.lastQty
        \o message.effectiveTime
        \o message.lastUpdateTime
        \o message.negotiationId
        \o message.numberOfRespondents
        \o message.quoteType
        \o message.quoteSubType
        \o message.quoteStatus
        \o EncodeUIntBE(Len(message.targetPartiesComp), 1)
        \o message.numberOfRespDisclosureInstruction
        \o message.side
        \o message.showLastDealOnClosure
        \o message.partyExecutingFirm
        \o message.partyExecutingTrader
        \o message.partyEnteringTrader
        \o message.firmNegotiationId
        \o message.freeText5
        \o message.partyOrderOriginationTrader
        \o message.pad4
        \o EncodeTargetPartiesCompList(message.targetPartiesComp)

DecodeSrqsNegotiationRequesterNotification(bytes) ==
    LET pad2 == ReadBytes(bytes, 2) IN IF ~pad2.ok THEN Fail ELSE
    LET rbcHeaderComp == DecodeRbcHeaderComp13(pad2.rest) IN IF ~rbcHeaderComp.ok THEN Fail ELSE
    LET transactTime == ReadBytes(rbcHeaderComp.rest, 8) IN IF ~transactTime.ok THEN Fail ELSE
    LET trdRegTsExecutionTime == ReadBytes(transactTime.rest, 8) IN IF ~trdRegTsExecutionTime.ok THEN Fail ELSE
    LET quoteRefPrice == ReadBytes(trdRegTsExecutionTime.rest, 8) IN IF ~quoteRefPrice.ok THEN Fail ELSE
    LET underlyingDeltaPercentage == ReadBytes(quoteRefPrice.rest, 8) IN IF ~underlyingDeltaPercentage.ok THEN Fail ELSE
    LET bidPx == ReadBytes(underlyingDeltaPercentage.rest, 8) IN IF ~bidPx.ok THEN Fail ELSE
    LET offerPx == ReadBytes(bidPx.rest, 8) IN IF ~offerPx.ok THEN Fail ELSE
    LET orderQty == ReadBytes(offerPx.rest, 8) IN IF ~orderQty.ok THEN Fail ELSE
    LET lastPx == ReadBytes(orderQty.rest, 8) IN IF ~lastPx.ok THEN Fail ELSE
    LET leavesQty == ReadBytes(lastPx.rest, 8) IN IF ~leavesQty.ok THEN Fail ELSE
    LET lastQty == ReadBytes(leavesQty.rest, 8) IN IF ~lastQty.ok THEN Fail ELSE
    LET effectiveTime == ReadBytes(lastQty.rest, 8) IN IF ~effectiveTime.ok THEN Fail ELSE
    LET lastUpdateTime == ReadBytes(effectiveTime.rest, 8) IN IF ~lastUpdateTime.ok THEN Fail ELSE
    LET negotiationId == ReadBytes(lastUpdateTime.rest, 4) IN IF ~negotiationId.ok THEN Fail ELSE
    LET numberOfRespondents == ReadBytes(negotiationId.rest, 4) IN IF ~numberOfRespondents.ok THEN Fail ELSE
    LET quoteType == ReadBytes(numberOfRespondents.rest, 1) IN IF ~quoteType.ok THEN Fail ELSE
    LET quoteSubType == ReadBytes(quoteType.rest, 1) IN IF ~quoteSubType.ok THEN Fail ELSE
    LET quoteStatus == ReadBytes(quoteSubType.rest, 1) IN IF ~quoteStatus.ok THEN Fail ELSE
    LET noTargetPartyIDs == ReadUIntBE(quoteStatus.rest, 1) IN IF ~noTargetPartyIDs.ok THEN Fail ELSE
    LET numberOfRespDisclosureInstruction == ReadBytes(noTargetPartyIDs.rest, 1) IN IF ~numberOfRespDisclosureInstruction.ok THEN Fail ELSE
    LET side == ReadBytes(numberOfRespDisclosureInstruction.rest, 1) IN IF ~side.ok THEN Fail ELSE
    LET showLastDealOnClosure == ReadBytes(side.rest, 1) IN IF ~showLastDealOnClosure.ok THEN Fail ELSE
    LET partyExecutingFirm == ReadBytes(showLastDealOnClosure.rest, 5) IN IF ~partyExecutingFirm.ok THEN Fail ELSE
    LET partyExecutingTrader == ReadBytes(partyExecutingFirm.rest, 6) IN IF ~partyExecutingTrader.ok THEN Fail ELSE
    LET partyEnteringTrader == ReadBytes(partyExecutingTrader.rest, 6) IN IF ~partyEnteringTrader.ok THEN Fail ELSE
    LET firmNegotiationId == ReadBytes(partyEnteringTrader.rest, 20) IN IF ~firmNegotiationId.ok THEN Fail ELSE
    LET freeText5 == ReadBytes(firmNegotiationId.rest, 132) IN IF ~freeText5.ok THEN Fail ELSE
    LET partyOrderOriginationTrader == ReadBytes(freeText5.rest, 132) IN IF ~partyOrderOriginationTrader.ok THEN Fail ELSE
    LET pad4 == ReadBytes(partyOrderOriginationTrader.rest, 4) IN IF ~pad4.ok THEN Fail ELSE
    LET targetPartiesComp == ReadTargetPartiesCompList(pad4.rest, noTargetPartyIDs.value) IN IF ~targetPartiesComp.ok THEN Fail ELSE
    Ok([ pad2                              |-> pad2.value,
         rbcHeaderComp                     |-> rbcHeaderComp.value,
         transactTime                      |-> transactTime.value,
         trdRegTsExecutionTime             |-> trdRegTsExecutionTime.value,
         quoteRefPrice                     |-> quoteRefPrice.value,
         underlyingDeltaPercentage         |-> underlyingDeltaPercentage.value,
         bidPx                             |-> bidPx.value,
         offerPx                           |-> offerPx.value,
         orderQty                          |-> orderQty.value,
         lastPx                            |-> lastPx.value,
         leavesQty                         |-> leavesQty.value,
         lastQty                           |-> lastQty.value,
         effectiveTime                     |-> effectiveTime.value,
         lastUpdateTime                    |-> lastUpdateTime.value,
         negotiationId                     |-> negotiationId.value,
         numberOfRespondents               |-> numberOfRespondents.value,
         quoteType                         |-> quoteType.value,
         quoteSubType                      |-> quoteSubType.value,
         quoteStatus                       |-> quoteStatus.value,
         numberOfRespDisclosureInstruction |-> numberOfRespDisclosureInstruction.value,
         side                              |-> side.value,
         showLastDealOnClosure             |-> showLastDealOnClosure.value,
         partyExecutingFirm                |-> partyExecutingFirm.value,
         partyExecutingTrader              |-> partyExecutingTrader.value,
         partyEnteringTrader               |-> partyEnteringTrader.value,
         firmNegotiationId                 |-> firmNegotiationId.value,
         freeText5                         |-> freeText5.value,
         partyOrderOriginationTrader       |-> partyOrderOriginationTrader.value,
         pad4                              |-> pad4.value,
         targetPartiesComp                 |-> targetPartiesComp.value ], targetPartiesComp.rest)

ZeroSrqsNegotiationRequesterNotification ==
    [ pad2                              |-> [i \in 1 .. 2 |-> 0],
      rbcHeaderComp                     |-> ZeroRbcHeaderComp13,
      transactTime                      |-> [i \in 1 .. 8 |-> 0],
      trdRegTsExecutionTime             |-> [i \in 1 .. 8 |-> 0],
      quoteRefPrice                     |-> [i \in 1 .. 8 |-> 0],
      underlyingDeltaPercentage         |-> [i \in 1 .. 8 |-> 0],
      bidPx                             |-> [i \in 1 .. 8 |-> 0],
      offerPx                           |-> [i \in 1 .. 8 |-> 0],
      orderQty                          |-> [i \in 1 .. 8 |-> 0],
      lastPx                            |-> [i \in 1 .. 8 |-> 0],
      leavesQty                         |-> [i \in 1 .. 8 |-> 0],
      lastQty                           |-> [i \in 1 .. 8 |-> 0],
      effectiveTime                     |-> [i \in 1 .. 8 |-> 0],
      lastUpdateTime                    |-> [i \in 1 .. 8 |-> 0],
      negotiationId                     |-> [i \in 1 .. 4 |-> 0],
      numberOfRespondents               |-> [i \in 1 .. 4 |-> 0],
      quoteType                         |-> [i \in 1 .. 1 |-> 0],
      quoteSubType                      |-> [i \in 1 .. 1 |-> 0],
      quoteStatus                       |-> [i \in 1 .. 1 |-> 0],
      numberOfRespDisclosureInstruction |-> [i \in 1 .. 1 |-> 0],
      side                              |-> [i \in 1 .. 1 |-> 0],
      showLastDealOnClosure             |-> [i \in 1 .. 1 |-> 0],
      partyExecutingFirm                |-> [i \in 1 .. 5 |-> 0],
      partyExecutingTrader              |-> [i \in 1 .. 6 |-> 0],
      partyEnteringTrader               |-> [i \in 1 .. 6 |-> 0],
      firmNegotiationId                 |-> [i \in 1 .. 20 |-> 0],
      freeText5                         |-> [i \in 1 .. 132 |-> 0],
      partyOrderOriginationTrader       |-> [i \in 1 .. 132 |-> 0],
      pad4                              |-> [i \in 1 .. 4 |-> 0],
      targetPartiesComp                 |-> << >> ]

(* Srqs Negotiation Requester Notification at zero, then each field in turn at the values it is checked at *)
CheckedSrqsNegotiationRequesterNotification ==
    { ZeroSrqsNegotiationRequesterNotification }
        \cup { [ZeroSrqsNegotiationRequesterNotification EXCEPT !.pad2 = one] : one \in Sample(2) }
        \cup { [ZeroSrqsNegotiationRequesterNotification EXCEPT !.rbcHeaderComp = one] : one \in CheckedRbcHeaderComp13 }
        \cup { [ZeroSrqsNegotiationRequesterNotification EXCEPT !.transactTime = one] : one \in Sample(8) }
        \cup { [ZeroSrqsNegotiationRequesterNotification EXCEPT !.trdRegTsExecutionTime = one] : one \in Sample(8) }
        \cup { [ZeroSrqsNegotiationRequesterNotification EXCEPT !.quoteRefPrice = one] : one \in Sample(8) }
        \cup { [ZeroSrqsNegotiationRequesterNotification EXCEPT !.underlyingDeltaPercentage = one] : one \in Sample(8) }
        \cup { [ZeroSrqsNegotiationRequesterNotification EXCEPT !.bidPx = one] : one \in Sample(8) }
        \cup { [ZeroSrqsNegotiationRequesterNotification EXCEPT !.offerPx = one] : one \in Sample(8) }
        \cup { [ZeroSrqsNegotiationRequesterNotification EXCEPT !.orderQty = one] : one \in Sample(8) }
        \cup { [ZeroSrqsNegotiationRequesterNotification EXCEPT !.lastPx = one] : one \in Sample(8) }
        \cup { [ZeroSrqsNegotiationRequesterNotification EXCEPT !.leavesQty = one] : one \in Sample(8) }
        \cup { [ZeroSrqsNegotiationRequesterNotification EXCEPT !.lastQty = one] : one \in Sample(8) }
        \cup { [ZeroSrqsNegotiationRequesterNotification EXCEPT !.effectiveTime = one] : one \in Sample(8) }
        \cup { [ZeroSrqsNegotiationRequesterNotification EXCEPT !.lastUpdateTime = one] : one \in Sample(8) }
        \cup { [ZeroSrqsNegotiationRequesterNotification EXCEPT !.negotiationId = one] : one \in Sample(4) }
        \cup { [ZeroSrqsNegotiationRequesterNotification EXCEPT !.numberOfRespondents = one] : one \in Sample(4) }
        \cup { [ZeroSrqsNegotiationRequesterNotification EXCEPT !.quoteType = one] : one \in Sample(1) }
        \cup { [ZeroSrqsNegotiationRequesterNotification EXCEPT !.quoteSubType = one] : one \in Sample(1) }
        \cup { [ZeroSrqsNegotiationRequesterNotification EXCEPT !.quoteStatus = one] : one \in Sample(1) }
        \cup { [ZeroSrqsNegotiationRequesterNotification EXCEPT !.numberOfRespDisclosureInstruction = one] : one \in Sample(1) }
        \cup { [ZeroSrqsNegotiationRequesterNotification EXCEPT !.side = one] : one \in Sample(1) }
        \cup { [ZeroSrqsNegotiationRequesterNotification EXCEPT !.showLastDealOnClosure = one] : one \in Sample(1) }
        \cup { [ZeroSrqsNegotiationRequesterNotification EXCEPT !.partyExecutingFirm = one] : one \in Sample(5) }
        \cup { [ZeroSrqsNegotiationRequesterNotification EXCEPT !.partyExecutingTrader = one] : one \in Sample(6) }
        \cup { [ZeroSrqsNegotiationRequesterNotification EXCEPT !.partyEnteringTrader = one] : one \in Sample(6) }
        \cup { [ZeroSrqsNegotiationRequesterNotification EXCEPT !.firmNegotiationId = one] : one \in Sample(20) }
        \cup { [ZeroSrqsNegotiationRequesterNotification EXCEPT !.freeText5 = one] : one \in Sample(132) }
        \cup { [ZeroSrqsNegotiationRequesterNotification EXCEPT !.partyOrderOriginationTrader = one] : one \in Sample(132) }
        \cup { [ZeroSrqsNegotiationRequesterNotification EXCEPT !.pad4 = one] : one \in Sample(4) }
        \cup { [ZeroSrqsNegotiationRequesterNotification EXCEPT !.targetPartiesComp = one] : one \in SampleLists(OneTargetPartiesComp) }

(***************************************************************************)
(* Rbc Header Comp: 32 bytes                                               *)
(***************************************************************************)

RbcHeaderComp14 ==
    [ sendingTime    : Sample(8),
      applSeqNum     : Sample(8),
      applSubId      : Sample(4),
      partitionId    : Sample(2),
      applResendFlag : Sample(1),
      applId         : Sample(1),
      lastFragment   : Sample(1),
      pad7           : Sample(7) ]

EncodeRbcHeaderComp14(message) ==
    message.sendingTime
        \o message.applSeqNum
        \o message.applSubId
        \o message.partitionId
        \o message.applResendFlag
        \o message.applId
        \o message.lastFragment
        \o message.pad7

DecodeRbcHeaderComp14(bytes) ==
    LET sendingTime == ReadBytes(bytes, 8) IN IF ~sendingTime.ok THEN Fail ELSE
    LET applSeqNum == ReadBytes(sendingTime.rest, 8) IN IF ~applSeqNum.ok THEN Fail ELSE
    LET applSubId == ReadBytes(applSeqNum.rest, 4) IN IF ~applSubId.ok THEN Fail ELSE
    LET partitionId == ReadBytes(applSubId.rest, 2) IN IF ~partitionId.ok THEN Fail ELSE
    LET applResendFlag == ReadBytes(partitionId.rest, 1) IN IF ~applResendFlag.ok THEN Fail ELSE
    LET applId == ReadBytes(applResendFlag.rest, 1) IN IF ~applId.ok THEN Fail ELSE
    LET lastFragment == ReadBytes(applId.rest, 1) IN IF ~lastFragment.ok THEN Fail ELSE
    LET pad7 == ReadBytes(lastFragment.rest, 7) IN IF ~pad7.ok THEN Fail ELSE
    Ok([ sendingTime    |-> sendingTime.value,
         applSeqNum     |-> applSeqNum.value,
         applSubId      |-> applSubId.value,
         partitionId    |-> partitionId.value,
         applResendFlag |-> applResendFlag.value,
         applId         |-> applId.value,
         lastFragment   |-> lastFragment.value,
         pad7           |-> pad7.value ], pad7.rest)

ZeroRbcHeaderComp14 ==
    [ sendingTime    |-> [i \in 1 .. 8 |-> 0],
      applSeqNum     |-> [i \in 1 .. 8 |-> 0],
      applSubId      |-> [i \in 1 .. 4 |-> 0],
      partitionId    |-> [i \in 1 .. 2 |-> 0],
      applResendFlag |-> [i \in 1 .. 1 |-> 0],
      applId         |-> [i \in 1 .. 1 |-> 0],
      lastFragment   |-> [i \in 1 .. 1 |-> 0],
      pad7           |-> [i \in 1 .. 7 |-> 0] ]

(* Rbc Header Comp at zero, then each field in turn at the values it is checked at *)
CheckedRbcHeaderComp14 ==
    { ZeroRbcHeaderComp14 }
        \cup { [ZeroRbcHeaderComp14 EXCEPT !.sendingTime = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderComp14 EXCEPT !.applSeqNum = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderComp14 EXCEPT !.applSubId = one] : one \in Sample(4) }
        \cup { [ZeroRbcHeaderComp14 EXCEPT !.partitionId = one] : one \in Sample(2) }
        \cup { [ZeroRbcHeaderComp14 EXCEPT !.applResendFlag = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp14 EXCEPT !.applId = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp14 EXCEPT !.lastFragment = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp14 EXCEPT !.pad7 = one] : one \in Sample(7) }

(***************************************************************************)
(* Srqs Negotiation Status Notification: 82 bytes                          *)
(***************************************************************************)

SrqsNegotiationStatusNotification ==
    [ pad2              : Sample(2),
      rbcHeaderComp     : RbcHeaderComp14,
      transactTime      : Sample(8),
      effectiveTime     : Sample(8),
      negotiationId     : Sample(4),
      quoteStatus       : Sample(1),
      firmNegotiationId : Sample(20),
      pad7              : Sample(7) ]

EncodeSrqsNegotiationStatusNotification(message) ==
    message.pad2
        \o EncodeRbcHeaderComp14(message.rbcHeaderComp)
        \o message.transactTime
        \o message.effectiveTime
        \o message.negotiationId
        \o message.quoteStatus
        \o message.firmNegotiationId
        \o message.pad7

DecodeSrqsNegotiationStatusNotification(bytes) ==
    LET pad2 == ReadBytes(bytes, 2) IN IF ~pad2.ok THEN Fail ELSE
    LET rbcHeaderComp == DecodeRbcHeaderComp14(pad2.rest) IN IF ~rbcHeaderComp.ok THEN Fail ELSE
    LET transactTime == ReadBytes(rbcHeaderComp.rest, 8) IN IF ~transactTime.ok THEN Fail ELSE
    LET effectiveTime == ReadBytes(transactTime.rest, 8) IN IF ~effectiveTime.ok THEN Fail ELSE
    LET negotiationId == ReadBytes(effectiveTime.rest, 4) IN IF ~negotiationId.ok THEN Fail ELSE
    LET quoteStatus == ReadBytes(negotiationId.rest, 1) IN IF ~quoteStatus.ok THEN Fail ELSE
    LET firmNegotiationId == ReadBytes(quoteStatus.rest, 20) IN IF ~firmNegotiationId.ok THEN Fail ELSE
    LET pad7 == ReadBytes(firmNegotiationId.rest, 7) IN IF ~pad7.ok THEN Fail ELSE
    Ok([ pad2              |-> pad2.value,
         rbcHeaderComp     |-> rbcHeaderComp.value,
         transactTime      |-> transactTime.value,
         effectiveTime     |-> effectiveTime.value,
         negotiationId     |-> negotiationId.value,
         quoteStatus       |-> quoteStatus.value,
         firmNegotiationId |-> firmNegotiationId.value,
         pad7              |-> pad7.value ], pad7.rest)

ZeroSrqsNegotiationStatusNotification ==
    [ pad2              |-> [i \in 1 .. 2 |-> 0],
      rbcHeaderComp     |-> ZeroRbcHeaderComp14,
      transactTime      |-> [i \in 1 .. 8 |-> 0],
      effectiveTime     |-> [i \in 1 .. 8 |-> 0],
      negotiationId     |-> [i \in 1 .. 4 |-> 0],
      quoteStatus       |-> [i \in 1 .. 1 |-> 0],
      firmNegotiationId |-> [i \in 1 .. 20 |-> 0],
      pad7              |-> [i \in 1 .. 7 |-> 0] ]

(* Srqs Negotiation Status Notification at zero, then each field in turn at the values it is checked at *)
CheckedSrqsNegotiationStatusNotification ==
    { ZeroSrqsNegotiationStatusNotification }
        \cup { [ZeroSrqsNegotiationStatusNotification EXCEPT !.pad2 = one] : one \in Sample(2) }
        \cup { [ZeroSrqsNegotiationStatusNotification EXCEPT !.rbcHeaderComp = one] : one \in CheckedRbcHeaderComp14 }
        \cup { [ZeroSrqsNegotiationStatusNotification EXCEPT !.transactTime = one] : one \in Sample(8) }
        \cup { [ZeroSrqsNegotiationStatusNotification EXCEPT !.effectiveTime = one] : one \in Sample(8) }
        \cup { [ZeroSrqsNegotiationStatusNotification EXCEPT !.negotiationId = one] : one \in Sample(4) }
        \cup { [ZeroSrqsNegotiationStatusNotification EXCEPT !.quoteStatus = one] : one \in Sample(1) }
        \cup { [ZeroSrqsNegotiationStatusNotification EXCEPT !.firmNegotiationId = one] : one \in Sample(20) }
        \cup { [ZeroSrqsNegotiationStatusNotification EXCEPT !.pad7 = one] : one \in Sample(7) }

(***************************************************************************)
(* Rbc Header Comp: 32 bytes                                               *)
(***************************************************************************)

RbcHeaderComp15 ==
    [ sendingTime    : Sample(8),
      applSeqNum     : Sample(8),
      applSubId      : Sample(4),
      partitionId    : Sample(2),
      applResendFlag : Sample(1),
      applId         : Sample(1),
      lastFragment   : Sample(1),
      pad7           : Sample(7) ]

EncodeRbcHeaderComp15(message) ==
    message.sendingTime
        \o message.applSeqNum
        \o message.applSubId
        \o message.partitionId
        \o message.applResendFlag
        \o message.applId
        \o message.lastFragment
        \o message.pad7

DecodeRbcHeaderComp15(bytes) ==
    LET sendingTime == ReadBytes(bytes, 8) IN IF ~sendingTime.ok THEN Fail ELSE
    LET applSeqNum == ReadBytes(sendingTime.rest, 8) IN IF ~applSeqNum.ok THEN Fail ELSE
    LET applSubId == ReadBytes(applSeqNum.rest, 4) IN IF ~applSubId.ok THEN Fail ELSE
    LET partitionId == ReadBytes(applSubId.rest, 2) IN IF ~partitionId.ok THEN Fail ELSE
    LET applResendFlag == ReadBytes(partitionId.rest, 1) IN IF ~applResendFlag.ok THEN Fail ELSE
    LET applId == ReadBytes(applResendFlag.rest, 1) IN IF ~applId.ok THEN Fail ELSE
    LET lastFragment == ReadBytes(applId.rest, 1) IN IF ~lastFragment.ok THEN Fail ELSE
    LET pad7 == ReadBytes(lastFragment.rest, 7) IN IF ~pad7.ok THEN Fail ELSE
    Ok([ sendingTime    |-> sendingTime.value,
         applSeqNum     |-> applSeqNum.value,
         applSubId      |-> applSubId.value,
         partitionId    |-> partitionId.value,
         applResendFlag |-> applResendFlag.value,
         applId         |-> applId.value,
         lastFragment   |-> lastFragment.value,
         pad7           |-> pad7.value ], pad7.rest)

ZeroRbcHeaderComp15 ==
    [ sendingTime    |-> [i \in 1 .. 8 |-> 0],
      applSeqNum     |-> [i \in 1 .. 8 |-> 0],
      applSubId      |-> [i \in 1 .. 4 |-> 0],
      partitionId    |-> [i \in 1 .. 2 |-> 0],
      applResendFlag |-> [i \in 1 .. 1 |-> 0],
      applId         |-> [i \in 1 .. 1 |-> 0],
      lastFragment   |-> [i \in 1 .. 1 |-> 0],
      pad7           |-> [i \in 1 .. 7 |-> 0] ]

(* Rbc Header Comp at zero, then each field in turn at the values it is checked at *)
CheckedRbcHeaderComp15 ==
    { ZeroRbcHeaderComp15 }
        \cup { [ZeroRbcHeaderComp15 EXCEPT !.sendingTime = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderComp15 EXCEPT !.applSeqNum = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderComp15 EXCEPT !.applSubId = one] : one \in Sample(4) }
        \cup { [ZeroRbcHeaderComp15 EXCEPT !.partitionId = one] : one \in Sample(2) }
        \cup { [ZeroRbcHeaderComp15 EXCEPT !.applResendFlag = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp15 EXCEPT !.applId = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp15 EXCEPT !.lastFragment = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp15 EXCEPT !.pad7 = one] : one \in Sample(7) }

(***************************************************************************)
(* Quot Req Legs Grp Comp: 24 bytes                                        *)
(***************************************************************************)

QuotReqLegsGrpComp ==
    [ legSecurityId   : Sample(8),
      legRatioQty     : Sample(4),
      legSymbol       : Sample(4),
      legSecurityType : Sample(1),
      legSide         : Sample(1),
      pad6            : Sample(6) ]

EncodeQuotReqLegsGrpComp(message) ==
    message.legSecurityId
        \o message.legRatioQty
        \o message.legSymbol
        \o message.legSecurityType
        \o message.legSide
        \o message.pad6

DecodeQuotReqLegsGrpComp(bytes) ==
    LET legSecurityId == ReadBytes(bytes, 8) IN IF ~legSecurityId.ok THEN Fail ELSE
    LET legRatioQty == ReadBytes(legSecurityId.rest, 4) IN IF ~legRatioQty.ok THEN Fail ELSE
    LET legSymbol == ReadBytes(legRatioQty.rest, 4) IN IF ~legSymbol.ok THEN Fail ELSE
    LET legSecurityType == ReadBytes(legSymbol.rest, 1) IN IF ~legSecurityType.ok THEN Fail ELSE
    LET legSide == ReadBytes(legSecurityType.rest, 1) IN IF ~legSide.ok THEN Fail ELSE
    LET pad6 == ReadBytes(legSide.rest, 6) IN IF ~pad6.ok THEN Fail ELSE
    Ok([ legSecurityId   |-> legSecurityId.value,
         legRatioQty     |-> legRatioQty.value,
         legSymbol       |-> legSymbol.value,
         legSecurityType |-> legSecurityType.value,
         legSide         |-> legSide.value,
         pad6            |-> pad6.value ], pad6.rest)

ZeroQuotReqLegsGrpComp ==
    [ legSecurityId   |-> [i \in 1 .. 8 |-> 0],
      legRatioQty     |-> [i \in 1 .. 4 |-> 0],
      legSymbol       |-> [i \in 1 .. 4 |-> 0],
      legSecurityType |-> [i \in 1 .. 1 |-> 0],
      legSide         |-> [i \in 1 .. 1 |-> 0],
      pad6            |-> [i \in 1 .. 6 |-> 0] ]

(* Quot Req Legs Grp Comp at zero, then each field in turn at the values it is checked at *)
CheckedQuotReqLegsGrpComp ==
    { ZeroQuotReqLegsGrpComp }
        \cup { [ZeroQuotReqLegsGrpComp EXCEPT !.legSecurityId = one] : one \in Sample(8) }
        \cup { [ZeroQuotReqLegsGrpComp EXCEPT !.legRatioQty = one] : one \in Sample(4) }
        \cup { [ZeroQuotReqLegsGrpComp EXCEPT !.legSymbol = one] : one \in Sample(4) }
        \cup { [ZeroQuotReqLegsGrpComp EXCEPT !.legSecurityType = one] : one \in Sample(1) }
        \cup { [ZeroQuotReqLegsGrpComp EXCEPT !.legSide = one] : one \in Sample(1) }
        \cup { [ZeroQuotReqLegsGrpComp EXCEPT !.pad6 = one] : one \in Sample(6) }

(* A run of Quot Req Legs Grp Comp, written one after another *)
RECURSIVE EncodeQuotReqLegsGrpCompList(_)
EncodeQuotReqLegsGrpCompList(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeQuotReqLegsGrpComp(Head(messages)) \o EncodeQuotReqLegsGrpCompList(Tail(messages))

(* As many Quot Req Legs Grp Comp as the field that counts them says *)
RECURSIVE ReadQuotReqLegsGrpCompList(_, _)
ReadQuotReqLegsGrpCompList(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeQuotReqLegsGrpComp(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadQuotReqLegsGrpCompList(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Quot Req Legs Grp Comp of each kind, for the lists that carry them *)
OneQuotReqLegsGrpComp == { ZeroQuotReqLegsGrpComp }

(***************************************************************************)
(* Srqs Open Negotiation Notification                                      *)
(***************************************************************************)

SrqsOpenNegotiationNotification ==
    [ pad2                        : Sample(2),
      rbcHeaderComp               : RbcHeaderComp15,
      transactTime                : Sample(8),
      negotiationStartTime        : Sample(8),
      securityId                  : Sample(8),
      bidPx                       : Sample(8),
      offerPx                     : Sample(8),
      leavesQty                   : Sample(8),
      lastQty                     : Sample(8),
      lastPx                      : Sample(8),
      quoteRefPrice               : Sample(8),
      underlyingDeltaPercentage   : Sample(8),
      expireTime                  : Sample(8),
      tradeToRequestRatio         : Sample(8),
      tradeToQuoteRatio           : Sample(8),
      negotiationId               : Sample(4),
      marketSegmentId             : Sample(4),
      securitySubType             : Sample(4),
      numberOfRespondents         : Sample(4),
      tradeToQuoteRatioPosition   : Sample(2),
      quoteType                   : Sample(1),
      quoteSubType                : Sample(1),
      quoteStatus                 : Sample(1),
      side                        : Sample(1),
      productComplex              : Sample(1),
      respondentType              : Sample(1),
      partyExecutingFirm          : Sample(5),
      partyExecutingTrader        : Sample(6),
      partyEnteringTrader         : Sample(6),
      targetPartyExecutingFirm    : Sample(5),
      targetPartyExecutingTrader  : Sample(6),
      firmNegotiationId           : Sample(20),
      freeText5                   : Sample(132),
      partyOrderOriginationTrader : Sample(132),
      pad7                        : Sample(7),
      quotReqLegsGrpComp          : SampleLists(OneQuotReqLegsGrpComp) ]

EncodeSrqsOpenNegotiationNotification(message) ==
    message.pad2
        \o EncodeRbcHeaderComp15(message.rbcHeaderComp)
        \o message.transactTime
        \o message.negotiationStartTime
        \o message.securityId
        \o message.bidPx
        \o message.offerPx
        \o message.leavesQty
        \o message.lastQty
        \o message.lastPx
        \o message.quoteRefPrice
        \o message.underlyingDeltaPercentage
        \o message.expireTime
        \o message.tradeToRequestRatio
        \o message.tradeToQuoteRatio
        \o message.negotiationId
        \o message.marketSegmentId
        \o message.securitySubType
        \o message.numberOfRespondents
        \o message.tradeToQuoteRatioPosition
        \o message.quoteType
        \o message.quoteSubType
        \o message.quoteStatus
        \o EncodeUIntBE(Len(message.quotReqLegsGrpComp), 1)
        \o message.side
        \o message.productComplex
        \o message.respondentType
        \o message.partyExecutingFirm
        \o message.partyExecutingTrader
        \o message.partyEnteringTrader
        \o message.targetPartyExecutingFirm
        \o message.targetPartyExecutingTrader
        \o message.firmNegotiationId
        \o message.freeText5
        \o message.partyOrderOriginationTrader
        \o message.pad7
        \o EncodeQuotReqLegsGrpCompList(message.quotReqLegsGrpComp)

DecodeSrqsOpenNegotiationNotification(bytes) ==
    LET pad2 == ReadBytes(bytes, 2) IN IF ~pad2.ok THEN Fail ELSE
    LET rbcHeaderComp == DecodeRbcHeaderComp15(pad2.rest) IN IF ~rbcHeaderComp.ok THEN Fail ELSE
    LET transactTime == ReadBytes(rbcHeaderComp.rest, 8) IN IF ~transactTime.ok THEN Fail ELSE
    LET negotiationStartTime == ReadBytes(transactTime.rest, 8) IN IF ~negotiationStartTime.ok THEN Fail ELSE
    LET securityId == ReadBytes(negotiationStartTime.rest, 8) IN IF ~securityId.ok THEN Fail ELSE
    LET bidPx == ReadBytes(securityId.rest, 8) IN IF ~bidPx.ok THEN Fail ELSE
    LET offerPx == ReadBytes(bidPx.rest, 8) IN IF ~offerPx.ok THEN Fail ELSE
    LET leavesQty == ReadBytes(offerPx.rest, 8) IN IF ~leavesQty.ok THEN Fail ELSE
    LET lastQty == ReadBytes(leavesQty.rest, 8) IN IF ~lastQty.ok THEN Fail ELSE
    LET lastPx == ReadBytes(lastQty.rest, 8) IN IF ~lastPx.ok THEN Fail ELSE
    LET quoteRefPrice == ReadBytes(lastPx.rest, 8) IN IF ~quoteRefPrice.ok THEN Fail ELSE
    LET underlyingDeltaPercentage == ReadBytes(quoteRefPrice.rest, 8) IN IF ~underlyingDeltaPercentage.ok THEN Fail ELSE
    LET expireTime == ReadBytes(underlyingDeltaPercentage.rest, 8) IN IF ~expireTime.ok THEN Fail ELSE
    LET tradeToRequestRatio == ReadBytes(expireTime.rest, 8) IN IF ~tradeToRequestRatio.ok THEN Fail ELSE
    LET tradeToQuoteRatio == ReadBytes(tradeToRequestRatio.rest, 8) IN IF ~tradeToQuoteRatio.ok THEN Fail ELSE
    LET negotiationId == ReadBytes(tradeToQuoteRatio.rest, 4) IN IF ~negotiationId.ok THEN Fail ELSE
    LET marketSegmentId == ReadBytes(negotiationId.rest, 4) IN IF ~marketSegmentId.ok THEN Fail ELSE
    LET securitySubType == ReadBytes(marketSegmentId.rest, 4) IN IF ~securitySubType.ok THEN Fail ELSE
    LET numberOfRespondents == ReadBytes(securitySubType.rest, 4) IN IF ~numberOfRespondents.ok THEN Fail ELSE
    LET tradeToQuoteRatioPosition == ReadBytes(numberOfRespondents.rest, 2) IN IF ~tradeToQuoteRatioPosition.ok THEN Fail ELSE
    LET quoteType == ReadBytes(tradeToQuoteRatioPosition.rest, 1) IN IF ~quoteType.ok THEN Fail ELSE
    LET quoteSubType == ReadBytes(quoteType.rest, 1) IN IF ~quoteSubType.ok THEN Fail ELSE
    LET quoteStatus == ReadBytes(quoteSubType.rest, 1) IN IF ~quoteStatus.ok THEN Fail ELSE
    LET noLegs == ReadUIntBE(quoteStatus.rest, 1) IN IF ~noLegs.ok THEN Fail ELSE
    LET side == ReadBytes(noLegs.rest, 1) IN IF ~side.ok THEN Fail ELSE
    LET productComplex == ReadBytes(side.rest, 1) IN IF ~productComplex.ok THEN Fail ELSE
    LET respondentType == ReadBytes(productComplex.rest, 1) IN IF ~respondentType.ok THEN Fail ELSE
    LET partyExecutingFirm == ReadBytes(respondentType.rest, 5) IN IF ~partyExecutingFirm.ok THEN Fail ELSE
    LET partyExecutingTrader == ReadBytes(partyExecutingFirm.rest, 6) IN IF ~partyExecutingTrader.ok THEN Fail ELSE
    LET partyEnteringTrader == ReadBytes(partyExecutingTrader.rest, 6) IN IF ~partyEnteringTrader.ok THEN Fail ELSE
    LET targetPartyExecutingFirm == ReadBytes(partyEnteringTrader.rest, 5) IN IF ~targetPartyExecutingFirm.ok THEN Fail ELSE
    LET targetPartyExecutingTrader == ReadBytes(targetPartyExecutingFirm.rest, 6) IN IF ~targetPartyExecutingTrader.ok THEN Fail ELSE
    LET firmNegotiationId == ReadBytes(targetPartyExecutingTrader.rest, 20) IN IF ~firmNegotiationId.ok THEN Fail ELSE
    LET freeText5 == ReadBytes(firmNegotiationId.rest, 132) IN IF ~freeText5.ok THEN Fail ELSE
    LET partyOrderOriginationTrader == ReadBytes(freeText5.rest, 132) IN IF ~partyOrderOriginationTrader.ok THEN Fail ELSE
    LET pad7 == ReadBytes(partyOrderOriginationTrader.rest, 7) IN IF ~pad7.ok THEN Fail ELSE
    LET quotReqLegsGrpComp == ReadQuotReqLegsGrpCompList(pad7.rest, noLegs.value) IN IF ~quotReqLegsGrpComp.ok THEN Fail ELSE
    Ok([ pad2                        |-> pad2.value,
         rbcHeaderComp               |-> rbcHeaderComp.value,
         transactTime                |-> transactTime.value,
         negotiationStartTime        |-> negotiationStartTime.value,
         securityId                  |-> securityId.value,
         bidPx                       |-> bidPx.value,
         offerPx                     |-> offerPx.value,
         leavesQty                   |-> leavesQty.value,
         lastQty                     |-> lastQty.value,
         lastPx                      |-> lastPx.value,
         quoteRefPrice               |-> quoteRefPrice.value,
         underlyingDeltaPercentage   |-> underlyingDeltaPercentage.value,
         expireTime                  |-> expireTime.value,
         tradeToRequestRatio         |-> tradeToRequestRatio.value,
         tradeToQuoteRatio           |-> tradeToQuoteRatio.value,
         negotiationId               |-> negotiationId.value,
         marketSegmentId             |-> marketSegmentId.value,
         securitySubType             |-> securitySubType.value,
         numberOfRespondents         |-> numberOfRespondents.value,
         tradeToQuoteRatioPosition   |-> tradeToQuoteRatioPosition.value,
         quoteType                   |-> quoteType.value,
         quoteSubType                |-> quoteSubType.value,
         quoteStatus                 |-> quoteStatus.value,
         side                        |-> side.value,
         productComplex              |-> productComplex.value,
         respondentType              |-> respondentType.value,
         partyExecutingFirm          |-> partyExecutingFirm.value,
         partyExecutingTrader        |-> partyExecutingTrader.value,
         partyEnteringTrader         |-> partyEnteringTrader.value,
         targetPartyExecutingFirm    |-> targetPartyExecutingFirm.value,
         targetPartyExecutingTrader  |-> targetPartyExecutingTrader.value,
         firmNegotiationId           |-> firmNegotiationId.value,
         freeText5                   |-> freeText5.value,
         partyOrderOriginationTrader |-> partyOrderOriginationTrader.value,
         pad7                        |-> pad7.value,
         quotReqLegsGrpComp          |-> quotReqLegsGrpComp.value ], quotReqLegsGrpComp.rest)

ZeroSrqsOpenNegotiationNotification ==
    [ pad2                        |-> [i \in 1 .. 2 |-> 0],
      rbcHeaderComp               |-> ZeroRbcHeaderComp15,
      transactTime                |-> [i \in 1 .. 8 |-> 0],
      negotiationStartTime        |-> [i \in 1 .. 8 |-> 0],
      securityId                  |-> [i \in 1 .. 8 |-> 0],
      bidPx                       |-> [i \in 1 .. 8 |-> 0],
      offerPx                     |-> [i \in 1 .. 8 |-> 0],
      leavesQty                   |-> [i \in 1 .. 8 |-> 0],
      lastQty                     |-> [i \in 1 .. 8 |-> 0],
      lastPx                      |-> [i \in 1 .. 8 |-> 0],
      quoteRefPrice               |-> [i \in 1 .. 8 |-> 0],
      underlyingDeltaPercentage   |-> [i \in 1 .. 8 |-> 0],
      expireTime                  |-> [i \in 1 .. 8 |-> 0],
      tradeToRequestRatio         |-> [i \in 1 .. 8 |-> 0],
      tradeToQuoteRatio           |-> [i \in 1 .. 8 |-> 0],
      negotiationId               |-> [i \in 1 .. 4 |-> 0],
      marketSegmentId             |-> [i \in 1 .. 4 |-> 0],
      securitySubType             |-> [i \in 1 .. 4 |-> 0],
      numberOfRespondents         |-> [i \in 1 .. 4 |-> 0],
      tradeToQuoteRatioPosition   |-> [i \in 1 .. 2 |-> 0],
      quoteType                   |-> [i \in 1 .. 1 |-> 0],
      quoteSubType                |-> [i \in 1 .. 1 |-> 0],
      quoteStatus                 |-> [i \in 1 .. 1 |-> 0],
      side                        |-> [i \in 1 .. 1 |-> 0],
      productComplex              |-> [i \in 1 .. 1 |-> 0],
      respondentType              |-> [i \in 1 .. 1 |-> 0],
      partyExecutingFirm          |-> [i \in 1 .. 5 |-> 0],
      partyExecutingTrader        |-> [i \in 1 .. 6 |-> 0],
      partyEnteringTrader         |-> [i \in 1 .. 6 |-> 0],
      targetPartyExecutingFirm    |-> [i \in 1 .. 5 |-> 0],
      targetPartyExecutingTrader  |-> [i \in 1 .. 6 |-> 0],
      firmNegotiationId           |-> [i \in 1 .. 20 |-> 0],
      freeText5                   |-> [i \in 1 .. 132 |-> 0],
      partyOrderOriginationTrader |-> [i \in 1 .. 132 |-> 0],
      pad7                        |-> [i \in 1 .. 7 |-> 0],
      quotReqLegsGrpComp          |-> << >> ]

(* Srqs Open Negotiation Notification at zero, then each field in turn at the values it is checked at *)
CheckedSrqsOpenNegotiationNotification ==
    { ZeroSrqsOpenNegotiationNotification }
        \cup { [ZeroSrqsOpenNegotiationNotification EXCEPT !.pad2 = one] : one \in Sample(2) }
        \cup { [ZeroSrqsOpenNegotiationNotification EXCEPT !.rbcHeaderComp = one] : one \in CheckedRbcHeaderComp15 }
        \cup { [ZeroSrqsOpenNegotiationNotification EXCEPT !.transactTime = one] : one \in Sample(8) }
        \cup { [ZeroSrqsOpenNegotiationNotification EXCEPT !.negotiationStartTime = one] : one \in Sample(8) }
        \cup { [ZeroSrqsOpenNegotiationNotification EXCEPT !.securityId = one] : one \in Sample(8) }
        \cup { [ZeroSrqsOpenNegotiationNotification EXCEPT !.bidPx = one] : one \in Sample(8) }
        \cup { [ZeroSrqsOpenNegotiationNotification EXCEPT !.offerPx = one] : one \in Sample(8) }
        \cup { [ZeroSrqsOpenNegotiationNotification EXCEPT !.leavesQty = one] : one \in Sample(8) }
        \cup { [ZeroSrqsOpenNegotiationNotification EXCEPT !.lastQty = one] : one \in Sample(8) }
        \cup { [ZeroSrqsOpenNegotiationNotification EXCEPT !.lastPx = one] : one \in Sample(8) }
        \cup { [ZeroSrqsOpenNegotiationNotification EXCEPT !.quoteRefPrice = one] : one \in Sample(8) }
        \cup { [ZeroSrqsOpenNegotiationNotification EXCEPT !.underlyingDeltaPercentage = one] : one \in Sample(8) }
        \cup { [ZeroSrqsOpenNegotiationNotification EXCEPT !.expireTime = one] : one \in Sample(8) }
        \cup { [ZeroSrqsOpenNegotiationNotification EXCEPT !.tradeToRequestRatio = one] : one \in Sample(8) }
        \cup { [ZeroSrqsOpenNegotiationNotification EXCEPT !.tradeToQuoteRatio = one] : one \in Sample(8) }
        \cup { [ZeroSrqsOpenNegotiationNotification EXCEPT !.negotiationId = one] : one \in Sample(4) }
        \cup { [ZeroSrqsOpenNegotiationNotification EXCEPT !.marketSegmentId = one] : one \in Sample(4) }
        \cup { [ZeroSrqsOpenNegotiationNotification EXCEPT !.securitySubType = one] : one \in Sample(4) }
        \cup { [ZeroSrqsOpenNegotiationNotification EXCEPT !.numberOfRespondents = one] : one \in Sample(4) }
        \cup { [ZeroSrqsOpenNegotiationNotification EXCEPT !.tradeToQuoteRatioPosition = one] : one \in Sample(2) }
        \cup { [ZeroSrqsOpenNegotiationNotification EXCEPT !.quoteType = one] : one \in Sample(1) }
        \cup { [ZeroSrqsOpenNegotiationNotification EXCEPT !.quoteSubType = one] : one \in Sample(1) }
        \cup { [ZeroSrqsOpenNegotiationNotification EXCEPT !.quoteStatus = one] : one \in Sample(1) }
        \cup { [ZeroSrqsOpenNegotiationNotification EXCEPT !.side = one] : one \in Sample(1) }
        \cup { [ZeroSrqsOpenNegotiationNotification EXCEPT !.productComplex = one] : one \in Sample(1) }
        \cup { [ZeroSrqsOpenNegotiationNotification EXCEPT !.respondentType = one] : one \in Sample(1) }
        \cup { [ZeroSrqsOpenNegotiationNotification EXCEPT !.partyExecutingFirm = one] : one \in Sample(5) }
        \cup { [ZeroSrqsOpenNegotiationNotification EXCEPT !.partyExecutingTrader = one] : one \in Sample(6) }
        \cup { [ZeroSrqsOpenNegotiationNotification EXCEPT !.partyEnteringTrader = one] : one \in Sample(6) }
        \cup { [ZeroSrqsOpenNegotiationNotification EXCEPT !.targetPartyExecutingFirm = one] : one \in Sample(5) }
        \cup { [ZeroSrqsOpenNegotiationNotification EXCEPT !.targetPartyExecutingTrader = one] : one \in Sample(6) }
        \cup { [ZeroSrqsOpenNegotiationNotification EXCEPT !.firmNegotiationId = one] : one \in Sample(20) }
        \cup { [ZeroSrqsOpenNegotiationNotification EXCEPT !.freeText5 = one] : one \in Sample(132) }
        \cup { [ZeroSrqsOpenNegotiationNotification EXCEPT !.partyOrderOriginationTrader = one] : one \in Sample(132) }
        \cup { [ZeroSrqsOpenNegotiationNotification EXCEPT !.pad7 = one] : one \in Sample(7) }
        \cup { [ZeroSrqsOpenNegotiationNotification EXCEPT !.quotReqLegsGrpComp = one] : one \in SampleLists(OneQuotReqLegsGrpComp) }

(***************************************************************************)
(* Rbc Header Comp: 32 bytes                                               *)
(***************************************************************************)

RbcHeaderComp16 ==
    [ sendingTime    : Sample(8),
      applSeqNum     : Sample(8),
      applSubId      : Sample(4),
      partitionId    : Sample(2),
      applResendFlag : Sample(1),
      applId         : Sample(1),
      lastFragment   : Sample(1),
      pad7           : Sample(7) ]

EncodeRbcHeaderComp16(message) ==
    message.sendingTime
        \o message.applSeqNum
        \o message.applSubId
        \o message.partitionId
        \o message.applResendFlag
        \o message.applId
        \o message.lastFragment
        \o message.pad7

DecodeRbcHeaderComp16(bytes) ==
    LET sendingTime == ReadBytes(bytes, 8) IN IF ~sendingTime.ok THEN Fail ELSE
    LET applSeqNum == ReadBytes(sendingTime.rest, 8) IN IF ~applSeqNum.ok THEN Fail ELSE
    LET applSubId == ReadBytes(applSeqNum.rest, 4) IN IF ~applSubId.ok THEN Fail ELSE
    LET partitionId == ReadBytes(applSubId.rest, 2) IN IF ~partitionId.ok THEN Fail ELSE
    LET applResendFlag == ReadBytes(partitionId.rest, 1) IN IF ~applResendFlag.ok THEN Fail ELSE
    LET applId == ReadBytes(applResendFlag.rest, 1) IN IF ~applId.ok THEN Fail ELSE
    LET lastFragment == ReadBytes(applId.rest, 1) IN IF ~lastFragment.ok THEN Fail ELSE
    LET pad7 == ReadBytes(lastFragment.rest, 7) IN IF ~pad7.ok THEN Fail ELSE
    Ok([ sendingTime    |-> sendingTime.value,
         applSeqNum     |-> applSeqNum.value,
         applSubId      |-> applSubId.value,
         partitionId    |-> partitionId.value,
         applResendFlag |-> applResendFlag.value,
         applId         |-> applId.value,
         lastFragment   |-> lastFragment.value,
         pad7           |-> pad7.value ], pad7.rest)

ZeroRbcHeaderComp16 ==
    [ sendingTime    |-> [i \in 1 .. 8 |-> 0],
      applSeqNum     |-> [i \in 1 .. 8 |-> 0],
      applSubId      |-> [i \in 1 .. 4 |-> 0],
      partitionId    |-> [i \in 1 .. 2 |-> 0],
      applResendFlag |-> [i \in 1 .. 1 |-> 0],
      applId         |-> [i \in 1 .. 1 |-> 0],
      lastFragment   |-> [i \in 1 .. 1 |-> 0],
      pad7           |-> [i \in 1 .. 7 |-> 0] ]

(* Rbc Header Comp at zero, then each field in turn at the values it is checked at *)
CheckedRbcHeaderComp16 ==
    { ZeroRbcHeaderComp16 }
        \cup { [ZeroRbcHeaderComp16 EXCEPT !.sendingTime = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderComp16 EXCEPT !.applSeqNum = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderComp16 EXCEPT !.applSubId = one] : one \in Sample(4) }
        \cup { [ZeroRbcHeaderComp16 EXCEPT !.partitionId = one] : one \in Sample(2) }
        \cup { [ZeroRbcHeaderComp16 EXCEPT !.applResendFlag = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp16 EXCEPT !.applId = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp16 EXCEPT !.lastFragment = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp16 EXCEPT !.pad7 = one] : one \in Sample(7) }

(***************************************************************************)
(* Quot Req Legs Grp Comp: 24 bytes                                        *)
(***************************************************************************)

QuotReqLegsGrpComp2 ==
    [ legSecurityId   : Sample(8),
      legRatioQty     : Sample(4),
      legSymbol       : Sample(4),
      legSecurityType : Sample(1),
      legSide         : Sample(1),
      pad6            : Sample(6) ]

EncodeQuotReqLegsGrpComp2(message) ==
    message.legSecurityId
        \o message.legRatioQty
        \o message.legSymbol
        \o message.legSecurityType
        \o message.legSide
        \o message.pad6

DecodeQuotReqLegsGrpComp2(bytes) ==
    LET legSecurityId == ReadBytes(bytes, 8) IN IF ~legSecurityId.ok THEN Fail ELSE
    LET legRatioQty == ReadBytes(legSecurityId.rest, 4) IN IF ~legRatioQty.ok THEN Fail ELSE
    LET legSymbol == ReadBytes(legRatioQty.rest, 4) IN IF ~legSymbol.ok THEN Fail ELSE
    LET legSecurityType == ReadBytes(legSymbol.rest, 1) IN IF ~legSecurityType.ok THEN Fail ELSE
    LET legSide == ReadBytes(legSecurityType.rest, 1) IN IF ~legSide.ok THEN Fail ELSE
    LET pad6 == ReadBytes(legSide.rest, 6) IN IF ~pad6.ok THEN Fail ELSE
    Ok([ legSecurityId   |-> legSecurityId.value,
         legRatioQty     |-> legRatioQty.value,
         legSymbol       |-> legSymbol.value,
         legSecurityType |-> legSecurityType.value,
         legSide         |-> legSide.value,
         pad6            |-> pad6.value ], pad6.rest)

ZeroQuotReqLegsGrpComp2 ==
    [ legSecurityId   |-> [i \in 1 .. 8 |-> 0],
      legRatioQty     |-> [i \in 1 .. 4 |-> 0],
      legSymbol       |-> [i \in 1 .. 4 |-> 0],
      legSecurityType |-> [i \in 1 .. 1 |-> 0],
      legSide         |-> [i \in 1 .. 1 |-> 0],
      pad6            |-> [i \in 1 .. 6 |-> 0] ]

(* Quot Req Legs Grp Comp at zero, then each field in turn at the values it is checked at *)
CheckedQuotReqLegsGrpComp2 ==
    { ZeroQuotReqLegsGrpComp2 }
        \cup { [ZeroQuotReqLegsGrpComp2 EXCEPT !.legSecurityId = one] : one \in Sample(8) }
        \cup { [ZeroQuotReqLegsGrpComp2 EXCEPT !.legRatioQty = one] : one \in Sample(4) }
        \cup { [ZeroQuotReqLegsGrpComp2 EXCEPT !.legSymbol = one] : one \in Sample(4) }
        \cup { [ZeroQuotReqLegsGrpComp2 EXCEPT !.legSecurityType = one] : one \in Sample(1) }
        \cup { [ZeroQuotReqLegsGrpComp2 EXCEPT !.legSide = one] : one \in Sample(1) }
        \cup { [ZeroQuotReqLegsGrpComp2 EXCEPT !.pad6 = one] : one \in Sample(6) }

(* A run of Quot Req Legs Grp Comp, written one after another *)
RECURSIVE EncodeQuotReqLegsGrpComp2List(_)
EncodeQuotReqLegsGrpComp2List(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeQuotReqLegsGrpComp2(Head(messages)) \o EncodeQuotReqLegsGrpComp2List(Tail(messages))

(* As many Quot Req Legs Grp Comp as the field that counts them says *)
RECURSIVE ReadQuotReqLegsGrpComp2List(_, _)
ReadQuotReqLegsGrpComp2List(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeQuotReqLegsGrpComp2(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadQuotReqLegsGrpComp2List(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Quot Req Legs Grp Comp of each kind, for the lists that carry them *)
OneQuotReqLegsGrpComp2 == { ZeroQuotReqLegsGrpComp2 }

(***************************************************************************)
(* Target Parties Comp: 32 bytes                                           *)
(***************************************************************************)

TargetPartiesComp2 ==
    [ targetPartyIdExecutingTrader               : Sample(4),
      sideDisclosureInstruction                  : Sample(1),
      priceDisclosureInstruction                 : Sample(1),
      leavesQtyDisclosureInstruction             : Sample(1),
      lastPxDisclosureInstruction                : Sample(1),
      lastQtyDisclosureInstruction               : Sample(1),
      freeText5DisclosureInstruction             : Sample(1),
      partyOrderOriginationDisclosureInstruction : Sample(1),
      quoteInstruction                           : Sample(1),
      targetPartyExecutingFirm                   : Sample(5),
      targetPartyExecutingTrader                 : Sample(6),
      partyDetailStatus                          : Sample(1),
      partyDetailStatusInformation               : Sample(1),
      pad7                                       : Sample(7) ]

EncodeTargetPartiesComp2(message) ==
    message.targetPartyIdExecutingTrader
        \o message.sideDisclosureInstruction
        \o message.priceDisclosureInstruction
        \o message.leavesQtyDisclosureInstruction
        \o message.lastPxDisclosureInstruction
        \o message.lastQtyDisclosureInstruction
        \o message.freeText5DisclosureInstruction
        \o message.partyOrderOriginationDisclosureInstruction
        \o message.quoteInstruction
        \o message.targetPartyExecutingFirm
        \o message.targetPartyExecutingTrader
        \o message.partyDetailStatus
        \o message.partyDetailStatusInformation
        \o message.pad7

DecodeTargetPartiesComp2(bytes) ==
    LET targetPartyIdExecutingTrader == ReadBytes(bytes, 4) IN IF ~targetPartyIdExecutingTrader.ok THEN Fail ELSE
    LET sideDisclosureInstruction == ReadBytes(targetPartyIdExecutingTrader.rest, 1) IN IF ~sideDisclosureInstruction.ok THEN Fail ELSE
    LET priceDisclosureInstruction == ReadBytes(sideDisclosureInstruction.rest, 1) IN IF ~priceDisclosureInstruction.ok THEN Fail ELSE
    LET leavesQtyDisclosureInstruction == ReadBytes(priceDisclosureInstruction.rest, 1) IN IF ~leavesQtyDisclosureInstruction.ok THEN Fail ELSE
    LET lastPxDisclosureInstruction == ReadBytes(leavesQtyDisclosureInstruction.rest, 1) IN IF ~lastPxDisclosureInstruction.ok THEN Fail ELSE
    LET lastQtyDisclosureInstruction == ReadBytes(lastPxDisclosureInstruction.rest, 1) IN IF ~lastQtyDisclosureInstruction.ok THEN Fail ELSE
    LET freeText5DisclosureInstruction == ReadBytes(lastQtyDisclosureInstruction.rest, 1) IN IF ~freeText5DisclosureInstruction.ok THEN Fail ELSE
    LET partyOrderOriginationDisclosureInstruction == ReadBytes(freeText5DisclosureInstruction.rest, 1) IN IF ~partyOrderOriginationDisclosureInstruction.ok THEN Fail ELSE
    LET quoteInstruction == ReadBytes(partyOrderOriginationDisclosureInstruction.rest, 1) IN IF ~quoteInstruction.ok THEN Fail ELSE
    LET targetPartyExecutingFirm == ReadBytes(quoteInstruction.rest, 5) IN IF ~targetPartyExecutingFirm.ok THEN Fail ELSE
    LET targetPartyExecutingTrader == ReadBytes(targetPartyExecutingFirm.rest, 6) IN IF ~targetPartyExecutingTrader.ok THEN Fail ELSE
    LET partyDetailStatus == ReadBytes(targetPartyExecutingTrader.rest, 1) IN IF ~partyDetailStatus.ok THEN Fail ELSE
    LET partyDetailStatusInformation == ReadBytes(partyDetailStatus.rest, 1) IN IF ~partyDetailStatusInformation.ok THEN Fail ELSE
    LET pad7 == ReadBytes(partyDetailStatusInformation.rest, 7) IN IF ~pad7.ok THEN Fail ELSE
    Ok([ targetPartyIdExecutingTrader               |-> targetPartyIdExecutingTrader.value,
         sideDisclosureInstruction                  |-> sideDisclosureInstruction.value,
         priceDisclosureInstruction                 |-> priceDisclosureInstruction.value,
         leavesQtyDisclosureInstruction             |-> leavesQtyDisclosureInstruction.value,
         lastPxDisclosureInstruction                |-> lastPxDisclosureInstruction.value,
         lastQtyDisclosureInstruction               |-> lastQtyDisclosureInstruction.value,
         freeText5DisclosureInstruction             |-> freeText5DisclosureInstruction.value,
         partyOrderOriginationDisclosureInstruction |-> partyOrderOriginationDisclosureInstruction.value,
         quoteInstruction                           |-> quoteInstruction.value,
         targetPartyExecutingFirm                   |-> targetPartyExecutingFirm.value,
         targetPartyExecutingTrader                 |-> targetPartyExecutingTrader.value,
         partyDetailStatus                          |-> partyDetailStatus.value,
         partyDetailStatusInformation               |-> partyDetailStatusInformation.value,
         pad7                                       |-> pad7.value ], pad7.rest)

ZeroTargetPartiesComp2 ==
    [ targetPartyIdExecutingTrader               |-> [i \in 1 .. 4 |-> 0],
      sideDisclosureInstruction                  |-> [i \in 1 .. 1 |-> 0],
      priceDisclosureInstruction                 |-> [i \in 1 .. 1 |-> 0],
      leavesQtyDisclosureInstruction             |-> [i \in 1 .. 1 |-> 0],
      lastPxDisclosureInstruction                |-> [i \in 1 .. 1 |-> 0],
      lastQtyDisclosureInstruction               |-> [i \in 1 .. 1 |-> 0],
      freeText5DisclosureInstruction             |-> [i \in 1 .. 1 |-> 0],
      partyOrderOriginationDisclosureInstruction |-> [i \in 1 .. 1 |-> 0],
      quoteInstruction                           |-> [i \in 1 .. 1 |-> 0],
      targetPartyExecutingFirm                   |-> [i \in 1 .. 5 |-> 0],
      targetPartyExecutingTrader                 |-> [i \in 1 .. 6 |-> 0],
      partyDetailStatus                          |-> [i \in 1 .. 1 |-> 0],
      partyDetailStatusInformation               |-> [i \in 1 .. 1 |-> 0],
      pad7                                       |-> [i \in 1 .. 7 |-> 0] ]

(* Target Parties Comp at zero, then each field in turn at the values it is checked at *)
CheckedTargetPartiesComp2 ==
    { ZeroTargetPartiesComp2 }
        \cup { [ZeroTargetPartiesComp2 EXCEPT !.targetPartyIdExecutingTrader = one] : one \in Sample(4) }
        \cup { [ZeroTargetPartiesComp2 EXCEPT !.sideDisclosureInstruction = one] : one \in Sample(1) }
        \cup { [ZeroTargetPartiesComp2 EXCEPT !.priceDisclosureInstruction = one] : one \in Sample(1) }
        \cup { [ZeroTargetPartiesComp2 EXCEPT !.leavesQtyDisclosureInstruction = one] : one \in Sample(1) }
        \cup { [ZeroTargetPartiesComp2 EXCEPT !.lastPxDisclosureInstruction = one] : one \in Sample(1) }
        \cup { [ZeroTargetPartiesComp2 EXCEPT !.lastQtyDisclosureInstruction = one] : one \in Sample(1) }
        \cup { [ZeroTargetPartiesComp2 EXCEPT !.freeText5DisclosureInstruction = one] : one \in Sample(1) }
        \cup { [ZeroTargetPartiesComp2 EXCEPT !.partyOrderOriginationDisclosureInstruction = one] : one \in Sample(1) }
        \cup { [ZeroTargetPartiesComp2 EXCEPT !.quoteInstruction = one] : one \in Sample(1) }
        \cup { [ZeroTargetPartiesComp2 EXCEPT !.targetPartyExecutingFirm = one] : one \in Sample(5) }
        \cup { [ZeroTargetPartiesComp2 EXCEPT !.targetPartyExecutingTrader = one] : one \in Sample(6) }
        \cup { [ZeroTargetPartiesComp2 EXCEPT !.partyDetailStatus = one] : one \in Sample(1) }
        \cup { [ZeroTargetPartiesComp2 EXCEPT !.partyDetailStatusInformation = one] : one \in Sample(1) }
        \cup { [ZeroTargetPartiesComp2 EXCEPT !.pad7 = one] : one \in Sample(7) }

(* A run of Target Parties Comp, written one after another *)
RECURSIVE EncodeTargetPartiesComp2List(_)
EncodeTargetPartiesComp2List(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeTargetPartiesComp2(Head(messages)) \o EncodeTargetPartiesComp2List(Tail(messages))

(* As many Target Parties Comp as the field that counts them says *)
RECURSIVE ReadTargetPartiesComp2List(_, _)
ReadTargetPartiesComp2List(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeTargetPartiesComp2(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadTargetPartiesComp2List(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Target Parties Comp of each kind, for the lists that carry them *)
OneTargetPartiesComp2 == { ZeroTargetPartiesComp2 }

(***************************************************************************)
(* Srqs Open Negotiation Requester Notification                            *)
(***************************************************************************)

SrqsOpenNegotiationRequesterNotification ==
    [ pad2                              : Sample(2),
      rbcHeaderComp                     : RbcHeaderComp16,
      transactTime                      : Sample(8),
      securityId                        : Sample(8),
      bidPx                             : Sample(8),
      offerPx                           : Sample(8),
      orderQty                          : Sample(8),
      lastPx                            : Sample(8),
      lastQty                           : Sample(8),
      quoteRefPrice                     : Sample(8),
      underlyingDeltaPercentage         : Sample(8),
      expireTime                        : Sample(8),
      tradeToRequestRatio               : Sample(8),
      negotiationId                     : Sample(4),
      marketSegmentId                   : Sample(4),
      securitySubType                   : Sample(4),
      numberOfRespondents               : Sample(4),
      quoteType                         : Sample(1),
      quoteSubType                      : Sample(1),
      quoteStatus                       : Sample(1),
      side                              : Sample(1),
      productComplex                    : Sample(1),
      numberOfRespDisclosureInstruction : Sample(1),
      respondentType                    : Sample(1),
      showLastDealOnClosure             : Sample(1),
      partyExecutingFirm                : Sample(5),
      partyExecutingTrader              : Sample(6),
      partyEnteringTrader               : Sample(6),
      firmNegotiationId                 : Sample(20),
      freeText5                         : Sample(132),
      partyOrderOriginationTrader       : Sample(132),
      pad1                              : Sample(1),
      quotReqLegsGrpComp                : SampleLists(OneQuotReqLegsGrpComp2),
      targetPartiesComp                 : SampleLists(OneTargetPartiesComp2) ]

EncodeSrqsOpenNegotiationRequesterNotification(message) ==
    message.pad2
        \o EncodeRbcHeaderComp16(message.rbcHeaderComp)
        \o message.transactTime
        \o message.securityId
        \o message.bidPx
        \o message.offerPx
        \o message.orderQty
        \o message.lastPx
        \o message.lastQty
        \o message.quoteRefPrice
        \o message.underlyingDeltaPercentage
        \o message.expireTime
        \o message.tradeToRequestRatio
        \o message.negotiationId
        \o message.marketSegmentId
        \o message.securitySubType
        \o message.numberOfRespondents
        \o message.quoteType
        \o message.quoteSubType
        \o message.quoteStatus
        \o EncodeUIntBE(Len(message.quotReqLegsGrpComp), 1)
        \o EncodeUIntBE(Len(message.targetPartiesComp), 1)
        \o message.side
        \o message.productComplex
        \o message.numberOfRespDisclosureInstruction
        \o message.respondentType
        \o message.showLastDealOnClosure
        \o message.partyExecutingFirm
        \o message.partyExecutingTrader
        \o message.partyEnteringTrader
        \o message.firmNegotiationId
        \o message.freeText5
        \o message.partyOrderOriginationTrader
        \o message.pad1
        \o EncodeQuotReqLegsGrpComp2List(message.quotReqLegsGrpComp)
        \o EncodeTargetPartiesComp2List(message.targetPartiesComp)

DecodeSrqsOpenNegotiationRequesterNotification(bytes) ==
    LET pad2 == ReadBytes(bytes, 2) IN IF ~pad2.ok THEN Fail ELSE
    LET rbcHeaderComp == DecodeRbcHeaderComp16(pad2.rest) IN IF ~rbcHeaderComp.ok THEN Fail ELSE
    LET transactTime == ReadBytes(rbcHeaderComp.rest, 8) IN IF ~transactTime.ok THEN Fail ELSE
    LET securityId == ReadBytes(transactTime.rest, 8) IN IF ~securityId.ok THEN Fail ELSE
    LET bidPx == ReadBytes(securityId.rest, 8) IN IF ~bidPx.ok THEN Fail ELSE
    LET offerPx == ReadBytes(bidPx.rest, 8) IN IF ~offerPx.ok THEN Fail ELSE
    LET orderQty == ReadBytes(offerPx.rest, 8) IN IF ~orderQty.ok THEN Fail ELSE
    LET lastPx == ReadBytes(orderQty.rest, 8) IN IF ~lastPx.ok THEN Fail ELSE
    LET lastQty == ReadBytes(lastPx.rest, 8) IN IF ~lastQty.ok THEN Fail ELSE
    LET quoteRefPrice == ReadBytes(lastQty.rest, 8) IN IF ~quoteRefPrice.ok THEN Fail ELSE
    LET underlyingDeltaPercentage == ReadBytes(quoteRefPrice.rest, 8) IN IF ~underlyingDeltaPercentage.ok THEN Fail ELSE
    LET expireTime == ReadBytes(underlyingDeltaPercentage.rest, 8) IN IF ~expireTime.ok THEN Fail ELSE
    LET tradeToRequestRatio == ReadBytes(expireTime.rest, 8) IN IF ~tradeToRequestRatio.ok THEN Fail ELSE
    LET negotiationId == ReadBytes(tradeToRequestRatio.rest, 4) IN IF ~negotiationId.ok THEN Fail ELSE
    LET marketSegmentId == ReadBytes(negotiationId.rest, 4) IN IF ~marketSegmentId.ok THEN Fail ELSE
    LET securitySubType == ReadBytes(marketSegmentId.rest, 4) IN IF ~securitySubType.ok THEN Fail ELSE
    LET numberOfRespondents == ReadBytes(securitySubType.rest, 4) IN IF ~numberOfRespondents.ok THEN Fail ELSE
    LET quoteType == ReadBytes(numberOfRespondents.rest, 1) IN IF ~quoteType.ok THEN Fail ELSE
    LET quoteSubType == ReadBytes(quoteType.rest, 1) IN IF ~quoteSubType.ok THEN Fail ELSE
    LET quoteStatus == ReadBytes(quoteSubType.rest, 1) IN IF ~quoteStatus.ok THEN Fail ELSE
    LET noLegs == ReadUIntBE(quoteStatus.rest, 1) IN IF ~noLegs.ok THEN Fail ELSE
    LET noTargetPartyIDs == ReadUIntBE(noLegs.rest, 1) IN IF ~noTargetPartyIDs.ok THEN Fail ELSE
    LET side == ReadBytes(noTargetPartyIDs.rest, 1) IN IF ~side.ok THEN Fail ELSE
    LET productComplex == ReadBytes(side.rest, 1) IN IF ~productComplex.ok THEN Fail ELSE
    LET numberOfRespDisclosureInstruction == ReadBytes(productComplex.rest, 1) IN IF ~numberOfRespDisclosureInstruction.ok THEN Fail ELSE
    LET respondentType == ReadBytes(numberOfRespDisclosureInstruction.rest, 1) IN IF ~respondentType.ok THEN Fail ELSE
    LET showLastDealOnClosure == ReadBytes(respondentType.rest, 1) IN IF ~showLastDealOnClosure.ok THEN Fail ELSE
    LET partyExecutingFirm == ReadBytes(showLastDealOnClosure.rest, 5) IN IF ~partyExecutingFirm.ok THEN Fail ELSE
    LET partyExecutingTrader == ReadBytes(partyExecutingFirm.rest, 6) IN IF ~partyExecutingTrader.ok THEN Fail ELSE
    LET partyEnteringTrader == ReadBytes(partyExecutingTrader.rest, 6) IN IF ~partyEnteringTrader.ok THEN Fail ELSE
    LET firmNegotiationId == ReadBytes(partyEnteringTrader.rest, 20) IN IF ~firmNegotiationId.ok THEN Fail ELSE
    LET freeText5 == ReadBytes(firmNegotiationId.rest, 132) IN IF ~freeText5.ok THEN Fail ELSE
    LET partyOrderOriginationTrader == ReadBytes(freeText5.rest, 132) IN IF ~partyOrderOriginationTrader.ok THEN Fail ELSE
    LET pad1 == ReadBytes(partyOrderOriginationTrader.rest, 1) IN IF ~pad1.ok THEN Fail ELSE
    LET quotReqLegsGrpComp == ReadQuotReqLegsGrpComp2List(pad1.rest, noLegs.value) IN IF ~quotReqLegsGrpComp.ok THEN Fail ELSE
    LET targetPartiesComp == ReadTargetPartiesComp2List(quotReqLegsGrpComp.rest, noTargetPartyIDs.value) IN IF ~targetPartiesComp.ok THEN Fail ELSE
    Ok([ pad2                              |-> pad2.value,
         rbcHeaderComp                     |-> rbcHeaderComp.value,
         transactTime                      |-> transactTime.value,
         securityId                        |-> securityId.value,
         bidPx                             |-> bidPx.value,
         offerPx                           |-> offerPx.value,
         orderQty                          |-> orderQty.value,
         lastPx                            |-> lastPx.value,
         lastQty                           |-> lastQty.value,
         quoteRefPrice                     |-> quoteRefPrice.value,
         underlyingDeltaPercentage         |-> underlyingDeltaPercentage.value,
         expireTime                        |-> expireTime.value,
         tradeToRequestRatio               |-> tradeToRequestRatio.value,
         negotiationId                     |-> negotiationId.value,
         marketSegmentId                   |-> marketSegmentId.value,
         securitySubType                   |-> securitySubType.value,
         numberOfRespondents               |-> numberOfRespondents.value,
         quoteType                         |-> quoteType.value,
         quoteSubType                      |-> quoteSubType.value,
         quoteStatus                       |-> quoteStatus.value,
         side                              |-> side.value,
         productComplex                    |-> productComplex.value,
         numberOfRespDisclosureInstruction |-> numberOfRespDisclosureInstruction.value,
         respondentType                    |-> respondentType.value,
         showLastDealOnClosure             |-> showLastDealOnClosure.value,
         partyExecutingFirm                |-> partyExecutingFirm.value,
         partyExecutingTrader              |-> partyExecutingTrader.value,
         partyEnteringTrader               |-> partyEnteringTrader.value,
         firmNegotiationId                 |-> firmNegotiationId.value,
         freeText5                         |-> freeText5.value,
         partyOrderOriginationTrader       |-> partyOrderOriginationTrader.value,
         pad1                              |-> pad1.value,
         quotReqLegsGrpComp                |-> quotReqLegsGrpComp.value,
         targetPartiesComp                 |-> targetPartiesComp.value ], targetPartiesComp.rest)

ZeroSrqsOpenNegotiationRequesterNotification ==
    [ pad2                              |-> [i \in 1 .. 2 |-> 0],
      rbcHeaderComp                     |-> ZeroRbcHeaderComp16,
      transactTime                      |-> [i \in 1 .. 8 |-> 0],
      securityId                        |-> [i \in 1 .. 8 |-> 0],
      bidPx                             |-> [i \in 1 .. 8 |-> 0],
      offerPx                           |-> [i \in 1 .. 8 |-> 0],
      orderQty                          |-> [i \in 1 .. 8 |-> 0],
      lastPx                            |-> [i \in 1 .. 8 |-> 0],
      lastQty                           |-> [i \in 1 .. 8 |-> 0],
      quoteRefPrice                     |-> [i \in 1 .. 8 |-> 0],
      underlyingDeltaPercentage         |-> [i \in 1 .. 8 |-> 0],
      expireTime                        |-> [i \in 1 .. 8 |-> 0],
      tradeToRequestRatio               |-> [i \in 1 .. 8 |-> 0],
      negotiationId                     |-> [i \in 1 .. 4 |-> 0],
      marketSegmentId                   |-> [i \in 1 .. 4 |-> 0],
      securitySubType                   |-> [i \in 1 .. 4 |-> 0],
      numberOfRespondents               |-> [i \in 1 .. 4 |-> 0],
      quoteType                         |-> [i \in 1 .. 1 |-> 0],
      quoteSubType                      |-> [i \in 1 .. 1 |-> 0],
      quoteStatus                       |-> [i \in 1 .. 1 |-> 0],
      side                              |-> [i \in 1 .. 1 |-> 0],
      productComplex                    |-> [i \in 1 .. 1 |-> 0],
      numberOfRespDisclosureInstruction |-> [i \in 1 .. 1 |-> 0],
      respondentType                    |-> [i \in 1 .. 1 |-> 0],
      showLastDealOnClosure             |-> [i \in 1 .. 1 |-> 0],
      partyExecutingFirm                |-> [i \in 1 .. 5 |-> 0],
      partyExecutingTrader              |-> [i \in 1 .. 6 |-> 0],
      partyEnteringTrader               |-> [i \in 1 .. 6 |-> 0],
      firmNegotiationId                 |-> [i \in 1 .. 20 |-> 0],
      freeText5                         |-> [i \in 1 .. 132 |-> 0],
      partyOrderOriginationTrader       |-> [i \in 1 .. 132 |-> 0],
      pad1                              |-> [i \in 1 .. 1 |-> 0],
      quotReqLegsGrpComp                |-> << >>,
      targetPartiesComp                 |-> << >> ]

(* Srqs Open Negotiation Requester Notification at zero, then each field in turn at the values it is checked at *)
CheckedSrqsOpenNegotiationRequesterNotification ==
    { ZeroSrqsOpenNegotiationRequesterNotification }
        \cup { [ZeroSrqsOpenNegotiationRequesterNotification EXCEPT !.pad2 = one] : one \in Sample(2) }
        \cup { [ZeroSrqsOpenNegotiationRequesterNotification EXCEPT !.rbcHeaderComp = one] : one \in CheckedRbcHeaderComp16 }
        \cup { [ZeroSrqsOpenNegotiationRequesterNotification EXCEPT !.transactTime = one] : one \in Sample(8) }
        \cup { [ZeroSrqsOpenNegotiationRequesterNotification EXCEPT !.securityId = one] : one \in Sample(8) }
        \cup { [ZeroSrqsOpenNegotiationRequesterNotification EXCEPT !.bidPx = one] : one \in Sample(8) }
        \cup { [ZeroSrqsOpenNegotiationRequesterNotification EXCEPT !.offerPx = one] : one \in Sample(8) }
        \cup { [ZeroSrqsOpenNegotiationRequesterNotification EXCEPT !.orderQty = one] : one \in Sample(8) }
        \cup { [ZeroSrqsOpenNegotiationRequesterNotification EXCEPT !.lastPx = one] : one \in Sample(8) }
        \cup { [ZeroSrqsOpenNegotiationRequesterNotification EXCEPT !.lastQty = one] : one \in Sample(8) }
        \cup { [ZeroSrqsOpenNegotiationRequesterNotification EXCEPT !.quoteRefPrice = one] : one \in Sample(8) }
        \cup { [ZeroSrqsOpenNegotiationRequesterNotification EXCEPT !.underlyingDeltaPercentage = one] : one \in Sample(8) }
        \cup { [ZeroSrqsOpenNegotiationRequesterNotification EXCEPT !.expireTime = one] : one \in Sample(8) }
        \cup { [ZeroSrqsOpenNegotiationRequesterNotification EXCEPT !.tradeToRequestRatio = one] : one \in Sample(8) }
        \cup { [ZeroSrqsOpenNegotiationRequesterNotification EXCEPT !.negotiationId = one] : one \in Sample(4) }
        \cup { [ZeroSrqsOpenNegotiationRequesterNotification EXCEPT !.marketSegmentId = one] : one \in Sample(4) }
        \cup { [ZeroSrqsOpenNegotiationRequesterNotification EXCEPT !.securitySubType = one] : one \in Sample(4) }
        \cup { [ZeroSrqsOpenNegotiationRequesterNotification EXCEPT !.numberOfRespondents = one] : one \in Sample(4) }
        \cup { [ZeroSrqsOpenNegotiationRequesterNotification EXCEPT !.quoteType = one] : one \in Sample(1) }
        \cup { [ZeroSrqsOpenNegotiationRequesterNotification EXCEPT !.quoteSubType = one] : one \in Sample(1) }
        \cup { [ZeroSrqsOpenNegotiationRequesterNotification EXCEPT !.quoteStatus = one] : one \in Sample(1) }
        \cup { [ZeroSrqsOpenNegotiationRequesterNotification EXCEPT !.side = one] : one \in Sample(1) }
        \cup { [ZeroSrqsOpenNegotiationRequesterNotification EXCEPT !.productComplex = one] : one \in Sample(1) }
        \cup { [ZeroSrqsOpenNegotiationRequesterNotification EXCEPT !.numberOfRespDisclosureInstruction = one] : one \in Sample(1) }
        \cup { [ZeroSrqsOpenNegotiationRequesterNotification EXCEPT !.respondentType = one] : one \in Sample(1) }
        \cup { [ZeroSrqsOpenNegotiationRequesterNotification EXCEPT !.showLastDealOnClosure = one] : one \in Sample(1) }
        \cup { [ZeroSrqsOpenNegotiationRequesterNotification EXCEPT !.partyExecutingFirm = one] : one \in Sample(5) }
        \cup { [ZeroSrqsOpenNegotiationRequesterNotification EXCEPT !.partyExecutingTrader = one] : one \in Sample(6) }
        \cup { [ZeroSrqsOpenNegotiationRequesterNotification EXCEPT !.partyEnteringTrader = one] : one \in Sample(6) }
        \cup { [ZeroSrqsOpenNegotiationRequesterNotification EXCEPT !.firmNegotiationId = one] : one \in Sample(20) }
        \cup { [ZeroSrqsOpenNegotiationRequesterNotification EXCEPT !.freeText5 = one] : one \in Sample(132) }
        \cup { [ZeroSrqsOpenNegotiationRequesterNotification EXCEPT !.partyOrderOriginationTrader = one] : one \in Sample(132) }
        \cup { [ZeroSrqsOpenNegotiationRequesterNotification EXCEPT !.pad1 = one] : one \in Sample(1) }
        \cup { [ZeroSrqsOpenNegotiationRequesterNotification EXCEPT !.quotReqLegsGrpComp = one] : one \in SampleLists(OneQuotReqLegsGrpComp2) }
        \cup { [ZeroSrqsOpenNegotiationRequesterNotification EXCEPT !.targetPartiesComp = one] : one \in SampleLists(OneTargetPartiesComp2) }

(***************************************************************************)
(* Rbc Header Comp: 32 bytes                                               *)
(***************************************************************************)

RbcHeaderComp17 ==
    [ sendingTime    : Sample(8),
      applSeqNum     : Sample(8),
      applSubId      : Sample(4),
      partitionId    : Sample(2),
      applResendFlag : Sample(1),
      applId         : Sample(1),
      lastFragment   : Sample(1),
      pad7           : Sample(7) ]

EncodeRbcHeaderComp17(message) ==
    message.sendingTime
        \o message.applSeqNum
        \o message.applSubId
        \o message.partitionId
        \o message.applResendFlag
        \o message.applId
        \o message.lastFragment
        \o message.pad7

DecodeRbcHeaderComp17(bytes) ==
    LET sendingTime == ReadBytes(bytes, 8) IN IF ~sendingTime.ok THEN Fail ELSE
    LET applSeqNum == ReadBytes(sendingTime.rest, 8) IN IF ~applSeqNum.ok THEN Fail ELSE
    LET applSubId == ReadBytes(applSeqNum.rest, 4) IN IF ~applSubId.ok THEN Fail ELSE
    LET partitionId == ReadBytes(applSubId.rest, 2) IN IF ~partitionId.ok THEN Fail ELSE
    LET applResendFlag == ReadBytes(partitionId.rest, 1) IN IF ~applResendFlag.ok THEN Fail ELSE
    LET applId == ReadBytes(applResendFlag.rest, 1) IN IF ~applId.ok THEN Fail ELSE
    LET lastFragment == ReadBytes(applId.rest, 1) IN IF ~lastFragment.ok THEN Fail ELSE
    LET pad7 == ReadBytes(lastFragment.rest, 7) IN IF ~pad7.ok THEN Fail ELSE
    Ok([ sendingTime    |-> sendingTime.value,
         applSeqNum     |-> applSeqNum.value,
         applSubId      |-> applSubId.value,
         partitionId    |-> partitionId.value,
         applResendFlag |-> applResendFlag.value,
         applId         |-> applId.value,
         lastFragment   |-> lastFragment.value,
         pad7           |-> pad7.value ], pad7.rest)

ZeroRbcHeaderComp17 ==
    [ sendingTime    |-> [i \in 1 .. 8 |-> 0],
      applSeqNum     |-> [i \in 1 .. 8 |-> 0],
      applSubId      |-> [i \in 1 .. 4 |-> 0],
      partitionId    |-> [i \in 1 .. 2 |-> 0],
      applResendFlag |-> [i \in 1 .. 1 |-> 0],
      applId         |-> [i \in 1 .. 1 |-> 0],
      lastFragment   |-> [i \in 1 .. 1 |-> 0],
      pad7           |-> [i \in 1 .. 7 |-> 0] ]

(* Rbc Header Comp at zero, then each field in turn at the values it is checked at *)
CheckedRbcHeaderComp17 ==
    { ZeroRbcHeaderComp17 }
        \cup { [ZeroRbcHeaderComp17 EXCEPT !.sendingTime = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderComp17 EXCEPT !.applSeqNum = one] : one \in Sample(8) }
        \cup { [ZeroRbcHeaderComp17 EXCEPT !.applSubId = one] : one \in Sample(4) }
        \cup { [ZeroRbcHeaderComp17 EXCEPT !.partitionId = one] : one \in Sample(2) }
        \cup { [ZeroRbcHeaderComp17 EXCEPT !.applResendFlag = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp17 EXCEPT !.applId = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp17 EXCEPT !.lastFragment = one] : one \in Sample(1) }
        \cup { [ZeroRbcHeaderComp17 EXCEPT !.pad7 = one] : one \in Sample(7) }

(***************************************************************************)
(* Srqs Quote Notification: 402 bytes                                      *)
(***************************************************************************)

SrqsQuoteNotification ==
    [ pad2                        : Sample(2),
      rbcHeaderComp               : RbcHeaderComp17,
      transactTime                : Sample(8),
      quoteId                     : Sample(8),
      secondaryQuoteId            : Sample(8),
      bidPx                       : Sample(8),
      bidSize                     : Sample(8),
      offerPx                     : Sample(8),
      offerSize                   : Sample(8),
      underlyingDeltaPercentage   : Sample(8),
      quoteRefPrice               : Sample(8),
      negotiationId               : Sample(4),
      quotingStatus               : Sample(1),
      tradingCapacity             : Sample(1),
      pad2v2                      : Sample(2),
      partyIdExecutingTrader      : Sample(4),
      partyExecutingFirm          : Sample(5),
      partyExecutingTrader        : Sample(6),
      partyEnteringTrader         : Sample(6),
      quoteReqId                  : Sample(20),
      freeText1                   : Sample(12),
      freeText2                   : Sample(12),
      freeText3                   : Sample(12),
      freeText5                   : Sample(132),
      positionEffect              : Sample(1),
      account                     : Sample(2),
      partyIdBeneficiary          : Sample(9),
      custOrderHandlingInst       : Sample(1),
      partyIdOrderOriginationFirm : Sample(7),
      partyIdPositionAccount      : Sample(32),
      partyIdLocationId           : Sample(2),
      complianceText              : Sample(20),
      partyIdTakeUpTradingFirm    : Sample(5) ]

EncodeSrqsQuoteNotification(message) ==
    message.pad2
        \o EncodeRbcHeaderComp17(message.rbcHeaderComp)
        \o message.transactTime
        \o message.quoteId
        \o message.secondaryQuoteId
        \o message.bidPx
        \o message.bidSize
        \o message.offerPx
        \o message.offerSize
        \o message.underlyingDeltaPercentage
        \o message.quoteRefPrice
        \o message.negotiationId
        \o message.quotingStatus
        \o message.tradingCapacity
        \o message.pad2v2
        \o message.partyIdExecutingTrader
        \o message.partyExecutingFirm
        \o message.partyExecutingTrader
        \o message.partyEnteringTrader
        \o message.quoteReqId
        \o message.freeText1
        \o message.freeText2
        \o message.freeText3
        \o message.freeText5
        \o message.positionEffect
        \o message.account
        \o message.partyIdBeneficiary
        \o message.custOrderHandlingInst
        \o message.partyIdOrderOriginationFirm
        \o message.partyIdPositionAccount
        \o message.partyIdLocationId
        \o message.complianceText
        \o message.partyIdTakeUpTradingFirm

DecodeSrqsQuoteNotification(bytes) ==
    LET pad2 == ReadBytes(bytes, 2) IN IF ~pad2.ok THEN Fail ELSE
    LET rbcHeaderComp == DecodeRbcHeaderComp17(pad2.rest) IN IF ~rbcHeaderComp.ok THEN Fail ELSE
    LET transactTime == ReadBytes(rbcHeaderComp.rest, 8) IN IF ~transactTime.ok THEN Fail ELSE
    LET quoteId == ReadBytes(transactTime.rest, 8) IN IF ~quoteId.ok THEN Fail ELSE
    LET secondaryQuoteId == ReadBytes(quoteId.rest, 8) IN IF ~secondaryQuoteId.ok THEN Fail ELSE
    LET bidPx == ReadBytes(secondaryQuoteId.rest, 8) IN IF ~bidPx.ok THEN Fail ELSE
    LET bidSize == ReadBytes(bidPx.rest, 8) IN IF ~bidSize.ok THEN Fail ELSE
    LET offerPx == ReadBytes(bidSize.rest, 8) IN IF ~offerPx.ok THEN Fail ELSE
    LET offerSize == ReadBytes(offerPx.rest, 8) IN IF ~offerSize.ok THEN Fail ELSE
    LET underlyingDeltaPercentage == ReadBytes(offerSize.rest, 8) IN IF ~underlyingDeltaPercentage.ok THEN Fail ELSE
    LET quoteRefPrice == ReadBytes(underlyingDeltaPercentage.rest, 8) IN IF ~quoteRefPrice.ok THEN Fail ELSE
    LET negotiationId == ReadBytes(quoteRefPrice.rest, 4) IN IF ~negotiationId.ok THEN Fail ELSE
    LET quotingStatus == ReadBytes(negotiationId.rest, 1) IN IF ~quotingStatus.ok THEN Fail ELSE
    LET tradingCapacity == ReadBytes(quotingStatus.rest, 1) IN IF ~tradingCapacity.ok THEN Fail ELSE
    LET pad2v2 == ReadBytes(tradingCapacity.rest, 2) IN IF ~pad2v2.ok THEN Fail ELSE
    LET partyIdExecutingTrader == ReadBytes(pad2v2.rest, 4) IN IF ~partyIdExecutingTrader.ok THEN Fail ELSE
    LET partyExecutingFirm == ReadBytes(partyIdExecutingTrader.rest, 5) IN IF ~partyExecutingFirm.ok THEN Fail ELSE
    LET partyExecutingTrader == ReadBytes(partyExecutingFirm.rest, 6) IN IF ~partyExecutingTrader.ok THEN Fail ELSE
    LET partyEnteringTrader == ReadBytes(partyExecutingTrader.rest, 6) IN IF ~partyEnteringTrader.ok THEN Fail ELSE
    LET quoteReqId == ReadBytes(partyEnteringTrader.rest, 20) IN IF ~quoteReqId.ok THEN Fail ELSE
    LET freeText1 == ReadBytes(quoteReqId.rest, 12) IN IF ~freeText1.ok THEN Fail ELSE
    LET freeText2 == ReadBytes(freeText1.rest, 12) IN IF ~freeText2.ok THEN Fail ELSE
    LET freeText3 == ReadBytes(freeText2.rest, 12) IN IF ~freeText3.ok THEN Fail ELSE
    LET freeText5 == ReadBytes(freeText3.rest, 132) IN IF ~freeText5.ok THEN Fail ELSE
    LET positionEffect == ReadBytes(freeText5.rest, 1) IN IF ~positionEffect.ok THEN Fail ELSE
    LET account == ReadBytes(positionEffect.rest, 2) IN IF ~account.ok THEN Fail ELSE
    LET partyIdBeneficiary == ReadBytes(account.rest, 9) IN IF ~partyIdBeneficiary.ok THEN Fail ELSE
    LET custOrderHandlingInst == ReadBytes(partyIdBeneficiary.rest, 1) IN IF ~custOrderHandlingInst.ok THEN Fail ELSE
    LET partyIdOrderOriginationFirm == ReadBytes(custOrderHandlingInst.rest, 7) IN IF ~partyIdOrderOriginationFirm.ok THEN Fail ELSE
    LET partyIdPositionAccount == ReadBytes(partyIdOrderOriginationFirm.rest, 32) IN IF ~partyIdPositionAccount.ok THEN Fail ELSE
    LET partyIdLocationId == ReadBytes(partyIdPositionAccount.rest, 2) IN IF ~partyIdLocationId.ok THEN Fail ELSE
    LET complianceText == ReadBytes(partyIdLocationId.rest, 20) IN IF ~complianceText.ok THEN Fail ELSE
    LET partyIdTakeUpTradingFirm == ReadBytes(complianceText.rest, 5) IN IF ~partyIdTakeUpTradingFirm.ok THEN Fail ELSE
    Ok([ pad2                        |-> pad2.value,
         rbcHeaderComp               |-> rbcHeaderComp.value,
         transactTime                |-> transactTime.value,
         quoteId                     |-> quoteId.value,
         secondaryQuoteId            |-> secondaryQuoteId.value,
         bidPx                       |-> bidPx.value,
         bidSize                     |-> bidSize.value,
         offerPx                     |-> offerPx.value,
         offerSize                   |-> offerSize.value,
         underlyingDeltaPercentage   |-> underlyingDeltaPercentage.value,
         quoteRefPrice               |-> quoteRefPrice.value,
         negotiationId               |-> negotiationId.value,
         quotingStatus               |-> quotingStatus.value,
         tradingCapacity             |-> tradingCapacity.value,
         pad2v2                      |-> pad2v2.value,
         partyIdExecutingTrader      |-> partyIdExecutingTrader.value,
         partyExecutingFirm          |-> partyExecutingFirm.value,
         partyExecutingTrader        |-> partyExecutingTrader.value,
         partyEnteringTrader         |-> partyEnteringTrader.value,
         quoteReqId                  |-> quoteReqId.value,
         freeText1                   |-> freeText1.value,
         freeText2                   |-> freeText2.value,
         freeText3                   |-> freeText3.value,
         freeText5                   |-> freeText5.value,
         positionEffect              |-> positionEffect.value,
         account                     |-> account.value,
         partyIdBeneficiary          |-> partyIdBeneficiary.value,
         custOrderHandlingInst       |-> custOrderHandlingInst.value,
         partyIdOrderOriginationFirm |-> partyIdOrderOriginationFirm.value,
         partyIdPositionAccount      |-> partyIdPositionAccount.value,
         partyIdLocationId           |-> partyIdLocationId.value,
         complianceText              |-> complianceText.value,
         partyIdTakeUpTradingFirm    |-> partyIdTakeUpTradingFirm.value ], partyIdTakeUpTradingFirm.rest)

ZeroSrqsQuoteNotification ==
    [ pad2                        |-> [i \in 1 .. 2 |-> 0],
      rbcHeaderComp               |-> ZeroRbcHeaderComp17,
      transactTime                |-> [i \in 1 .. 8 |-> 0],
      quoteId                     |-> [i \in 1 .. 8 |-> 0],
      secondaryQuoteId            |-> [i \in 1 .. 8 |-> 0],
      bidPx                       |-> [i \in 1 .. 8 |-> 0],
      bidSize                     |-> [i \in 1 .. 8 |-> 0],
      offerPx                     |-> [i \in 1 .. 8 |-> 0],
      offerSize                   |-> [i \in 1 .. 8 |-> 0],
      underlyingDeltaPercentage   |-> [i \in 1 .. 8 |-> 0],
      quoteRefPrice               |-> [i \in 1 .. 8 |-> 0],
      negotiationId               |-> [i \in 1 .. 4 |-> 0],
      quotingStatus               |-> [i \in 1 .. 1 |-> 0],
      tradingCapacity             |-> [i \in 1 .. 1 |-> 0],
      pad2v2                      |-> [i \in 1 .. 2 |-> 0],
      partyIdExecutingTrader      |-> [i \in 1 .. 4 |-> 0],
      partyExecutingFirm          |-> [i \in 1 .. 5 |-> 0],
      partyExecutingTrader        |-> [i \in 1 .. 6 |-> 0],
      partyEnteringTrader         |-> [i \in 1 .. 6 |-> 0],
      quoteReqId                  |-> [i \in 1 .. 20 |-> 0],
      freeText1                   |-> [i \in 1 .. 12 |-> 0],
      freeText2                   |-> [i \in 1 .. 12 |-> 0],
      freeText3                   |-> [i \in 1 .. 12 |-> 0],
      freeText5                   |-> [i \in 1 .. 132 |-> 0],
      positionEffect              |-> [i \in 1 .. 1 |-> 0],
      account                     |-> [i \in 1 .. 2 |-> 0],
      partyIdBeneficiary          |-> [i \in 1 .. 9 |-> 0],
      custOrderHandlingInst       |-> [i \in 1 .. 1 |-> 0],
      partyIdOrderOriginationFirm |-> [i \in 1 .. 7 |-> 0],
      partyIdPositionAccount      |-> [i \in 1 .. 32 |-> 0],
      partyIdLocationId           |-> [i \in 1 .. 2 |-> 0],
      complianceText              |-> [i \in 1 .. 20 |-> 0],
      partyIdTakeUpTradingFirm    |-> [i \in 1 .. 5 |-> 0] ]

(* Srqs Quote Notification at zero, then each field in turn at the values it is checked at *)
CheckedSrqsQuoteNotification ==
    { ZeroSrqsQuoteNotification }
        \cup { [ZeroSrqsQuoteNotification EXCEPT !.pad2 = one] : one \in Sample(2) }
        \cup { [ZeroSrqsQuoteNotification EXCEPT !.rbcHeaderComp = one] : one \in CheckedRbcHeaderComp17 }
        \cup { [ZeroSrqsQuoteNotification EXCEPT !.transactTime = one] : one \in Sample(8) }
        \cup { [ZeroSrqsQuoteNotification EXCEPT !.quoteId = one] : one \in Sample(8) }
        \cup { [ZeroSrqsQuoteNotification EXCEPT !.secondaryQuoteId = one] : one \in Sample(8) }
        \cup { [ZeroSrqsQuoteNotification EXCEPT !.bidPx = one] : one \in Sample(8) }
        \cup { [ZeroSrqsQuoteNotification EXCEPT !.bidSize = one] : one \in Sample(8) }
        \cup { [ZeroSrqsQuoteNotification EXCEPT !.offerPx = one] : one \in Sample(8) }
        \cup { [ZeroSrqsQuoteNotification EXCEPT !.offerSize = one] : one \in Sample(8) }
        \cup { [ZeroSrqsQuoteNotification EXCEPT !.underlyingDeltaPercentage = one] : one \in Sample(8) }
        \cup { [ZeroSrqsQuoteNotification EXCEPT !.quoteRefPrice = one] : one \in Sample(8) }
        \cup { [ZeroSrqsQuoteNotification EXCEPT !.negotiationId = one] : one \in Sample(4) }
        \cup { [ZeroSrqsQuoteNotification EXCEPT !.quotingStatus = one] : one \in Sample(1) }
        \cup { [ZeroSrqsQuoteNotification EXCEPT !.tradingCapacity = one] : one \in Sample(1) }
        \cup { [ZeroSrqsQuoteNotification EXCEPT !.pad2v2 = one] : one \in Sample(2) }
        \cup { [ZeroSrqsQuoteNotification EXCEPT !.partyIdExecutingTrader = one] : one \in Sample(4) }
        \cup { [ZeroSrqsQuoteNotification EXCEPT !.partyExecutingFirm = one] : one \in Sample(5) }
        \cup { [ZeroSrqsQuoteNotification EXCEPT !.partyExecutingTrader = one] : one \in Sample(6) }
        \cup { [ZeroSrqsQuoteNotification EXCEPT !.partyEnteringTrader = one] : one \in Sample(6) }
        \cup { [ZeroSrqsQuoteNotification EXCEPT !.quoteReqId = one] : one \in Sample(20) }
        \cup { [ZeroSrqsQuoteNotification EXCEPT !.freeText1 = one] : one \in Sample(12) }
        \cup { [ZeroSrqsQuoteNotification EXCEPT !.freeText2 = one] : one \in Sample(12) }
        \cup { [ZeroSrqsQuoteNotification EXCEPT !.freeText3 = one] : one \in Sample(12) }
        \cup { [ZeroSrqsQuoteNotification EXCEPT !.freeText5 = one] : one \in Sample(132) }
        \cup { [ZeroSrqsQuoteNotification EXCEPT !.positionEffect = one] : one \in Sample(1) }
        \cup { [ZeroSrqsQuoteNotification EXCEPT !.account = one] : one \in Sample(2) }
        \cup { [ZeroSrqsQuoteNotification EXCEPT !.partyIdBeneficiary = one] : one \in Sample(9) }
        \cup { [ZeroSrqsQuoteNotification EXCEPT !.custOrderHandlingInst = one] : one \in Sample(1) }
        \cup { [ZeroSrqsQuoteNotification EXCEPT !.partyIdOrderOriginationFirm = one] : one \in Sample(7) }
        \cup { [ZeroSrqsQuoteNotification EXCEPT !.partyIdPositionAccount = one] : one \in Sample(32) }
        \cup { [ZeroSrqsQuoteNotification EXCEPT !.partyIdLocationId = one] : one \in Sample(2) }
        \cup { [ZeroSrqsQuoteNotification EXCEPT !.complianceText = one] : one \in Sample(20) }
        \cup { [ZeroSrqsQuoteNotification EXCEPT !.partyIdTakeUpTradingFirm = one] : one \in Sample(5) }

(***************************************************************************)
(* Response Header Comp: 24 bytes                                          *)
(***************************************************************************)

ResponseHeaderComp11 ==
    [ requestTime : Sample(8),
      sendingTime : Sample(8),
      msgSeqNum   : Sample(4),
      pad4        : Sample(4) ]

EncodeResponseHeaderComp11(message) ==
    message.requestTime
        \o message.sendingTime
        \o message.msgSeqNum
        \o message.pad4

DecodeResponseHeaderComp11(bytes) ==
    LET requestTime == ReadBytes(bytes, 8) IN IF ~requestTime.ok THEN Fail ELSE
    LET sendingTime == ReadBytes(requestTime.rest, 8) IN IF ~sendingTime.ok THEN Fail ELSE
    LET msgSeqNum == ReadBytes(sendingTime.rest, 4) IN IF ~msgSeqNum.ok THEN Fail ELSE
    LET pad4 == ReadBytes(msgSeqNum.rest, 4) IN IF ~pad4.ok THEN Fail ELSE
    Ok([ requestTime |-> requestTime.value,
         sendingTime |-> sendingTime.value,
         msgSeqNum   |-> msgSeqNum.value,
         pad4        |-> pad4.value ], pad4.rest)

ZeroResponseHeaderComp11 ==
    [ requestTime |-> [i \in 1 .. 8 |-> 0],
      sendingTime |-> [i \in 1 .. 8 |-> 0],
      msgSeqNum   |-> [i \in 1 .. 4 |-> 0],
      pad4        |-> [i \in 1 .. 4 |-> 0] ]

(* Response Header Comp at zero, then each field in turn at the values it is checked at *)
CheckedResponseHeaderComp11 ==
    { ZeroResponseHeaderComp11 }
        \cup { [ZeroResponseHeaderComp11 EXCEPT !.requestTime = one] : one \in Sample(8) }
        \cup { [ZeroResponseHeaderComp11 EXCEPT !.sendingTime = one] : one \in Sample(8) }
        \cup { [ZeroResponseHeaderComp11 EXCEPT !.msgSeqNum = one] : one \in Sample(4) }
        \cup { [ZeroResponseHeaderComp11 EXCEPT !.pad4 = one] : one \in Sample(4) }

(***************************************************************************)
(* Srqs Quote Response: 58 bytes                                           *)
(***************************************************************************)

SrqsQuoteResponse ==
    [ pad2               : Sample(2),
      responseHeaderComp : ResponseHeaderComp11,
      quoteId            : Sample(8),
      negotiationId      : Sample(4),
      quoteReqId         : Sample(20) ]

EncodeSrqsQuoteResponse(message) ==
    message.pad2
        \o EncodeResponseHeaderComp11(message.responseHeaderComp)
        \o message.quoteId
        \o message.negotiationId
        \o message.quoteReqId

DecodeSrqsQuoteResponse(bytes) ==
    LET pad2 == ReadBytes(bytes, 2) IN IF ~pad2.ok THEN Fail ELSE
    LET responseHeaderComp == DecodeResponseHeaderComp11(pad2.rest) IN IF ~responseHeaderComp.ok THEN Fail ELSE
    LET quoteId == ReadBytes(responseHeaderComp.rest, 8) IN IF ~quoteId.ok THEN Fail ELSE
    LET negotiationId == ReadBytes(quoteId.rest, 4) IN IF ~negotiationId.ok THEN Fail ELSE
    LET quoteReqId == ReadBytes(negotiationId.rest, 20) IN IF ~quoteReqId.ok THEN Fail ELSE
    Ok([ pad2               |-> pad2.value,
         responseHeaderComp |-> responseHeaderComp.value,
         quoteId            |-> quoteId.value,
         negotiationId      |-> negotiationId.value,
         quoteReqId         |-> quoteReqId.value ], quoteReqId.rest)

ZeroSrqsQuoteResponse ==
    [ pad2               |-> [i \in 1 .. 2 |-> 0],
      responseHeaderComp |-> ZeroResponseHeaderComp11,
      quoteId            |-> [i \in 1 .. 8 |-> 0],
      negotiationId      |-> [i \in 1 .. 4 |-> 0],
      quoteReqId         |-> [i \in 1 .. 20 |-> 0] ]

(* Srqs Quote Response at zero, then each field in turn at the values it is checked at *)
CheckedSrqsQuoteResponse ==
    { ZeroSrqsQuoteResponse }
        \cup { [ZeroSrqsQuoteResponse EXCEPT !.pad2 = one] : one \in Sample(2) }
        \cup { [ZeroSrqsQuoteResponse EXCEPT !.responseHeaderComp = one] : one \in CheckedResponseHeaderComp11 }
        \cup { [ZeroSrqsQuoteResponse EXCEPT !.quoteId = one] : one \in Sample(8) }
        \cup { [ZeroSrqsQuoteResponse EXCEPT !.negotiationId = one] : one \in Sample(4) }
        \cup { [ZeroSrqsQuoteResponse EXCEPT !.quoteReqId = one] : one \in Sample(20) }

(***************************************************************************)
(* Rbc Header Comp: 32 bytes                                               *)
(***************************************************************************)

RbcHeaderComp18 ==
    [ sendingTime    : Sample(8),
      applSeqNum     : Sample(8),
      applSubId      : Sample(4),
      partitionId    : Sample(2),
      applResendFlag : Sample(1),
      applId         : Sample(1),
      lastFragment   : Sample(1),
      pad7           : Sample(7) ]

EncodeRbcHeaderComp18(message) ==
    message.sendingTime
        \o message.applSeqNum
        \o message.applSubId
        \o message.partitionId
        \o message.applResendFlag
        \o message.applId
        \o message.lastFragment
        \o message.pad7

DecodeRbcHeaderComp18(bytes) ==
    LET sendingTime == ReadBytes(bytes, 8) IN IF ~sendingTime.ok THEN Fail ELSE
    LET applSeqNum == ReadBytes(sendingTime.rest, 8) IN IF ~applSeqNum.ok THEN Fail ELSE
    LET applSubId == ReadBytes(applSeqNum.rest, 4) IN IF ~applSubId.ok THEN Fail ELSE
    LET partitionId == ReadBytes(applSubId.rest, 2) IN IF ~partitionId.ok THEN Fail ELSE
    LET applResendFlag == ReadBytes(partitionId.rest, 1) IN IF ~applResendFlag.ok THEN Fail ELSE
    LET applId == ReadBytes(applResendFlag.rest, 1) IN IF ~applId.ok THEN Fail ELSE
    LET lastFragment == ReadBytes(applId.rest, 1) IN IF ~lastFragment.ok THEN Fail ELSE
    LET pad7 == ReadBytes(lastFragment.rest, 7) IN IF ~pad7.ok THEN Fail ELSE
    Ok([ sendingTime    |-> sendingTime.value,
         applSeqNum     |-> applSeqNum.value,
         applSubId      |-> applSubId.value,
         partitionId    |-> partitionId.value,
         applResendFlag |-> applResendFlag.value,
         applId         |-> applId.value,
         lastFragment   |-> lastFragment.value,
         pad7           |-> pad7.value ], pad7.rest)

ZeroRbcHeaderComp18 ==
    [ sendingTime    |-> [i \in 1 .. 8 |-> 0],
      applSeqNum     |-> [i \in 1 .. 8 |-> 0],
      applSubId      |-> [i \in 1 .. 4 |-> 0],
      partitionId    |-> [i \in 1 .. 2 |-> 0],
      applResendFlag |-> [i \in 1 .. 1 |-> 0],
      applId         |-> [i \in 1 .. 1 |-> 0],
      lastFragment   |-> [i \in 1 .. 1 |-> 0],
      pad7           |-> [i \in 1 .. 7 |-> 0] ]

(* Rbc Header Comp at zero, then each field in turn at the values it is checked at *)
