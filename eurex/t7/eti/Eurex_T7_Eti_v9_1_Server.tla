        \cup { [ZeroServiceAvailabilityBroadcast EXCEPT !.t7EntryServiceRtmStatus = one] : one \in Sample(1) }
        \cup { [ZeroServiceAvailabilityBroadcast EXCEPT !.pad5 = one] : one \in Sample(5) }

