(* Tes Compression Run Status Response at zero, then each field in turn at the values it is checked at *)
CheckedTesCompressionRunStatusResponse ==
    { ZeroTesCompressionRunStatusResponse }
        \cup { [ZeroTesCompressionRunStatusResponse EXCEPT !.pad2 = one] : one \in Sample(2) }
        \cup { [ZeroTesCompressionRunStatusResponse EXCEPT !.responseHeaderComp = one] : one \in CheckedResponseHeaderComp13 }
        \cup { [ZeroTesCompressionRunStatusResponse EXCEPT !.compressionId = one] : one \in Sample(8) }
        \cup { [ZeroTesCompressionRunStatusResponse EXCEPT !.marketSegmentId = one] : one \in Sample(4) }
        \cup { [ZeroTesCompressionRunStatusResponse EXCEPT !.compressionAction = one] : one \in Sample(1) }
        \cup { [ZeroTesCompressionRunStatusResponse EXCEPT !.compressionStatus = one] : one \in Sample(1) }
        \cup { [ZeroTesCompressionRunStatusResponse EXCEPT !.tradePublishIndicator = one] : one \in Sample(1) }
        \cup { [ZeroTesCompressionRunStatusResponse EXCEPT !.pad1 = one] : one \in Sample(1) }

