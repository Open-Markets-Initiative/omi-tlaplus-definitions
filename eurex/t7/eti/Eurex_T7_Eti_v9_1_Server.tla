      instrumentEventGrpComp     |-> << >>,
      instrumentAttributeGrpComp |-> << >>,
      underlyingStipGrpComp      |-> << >> ]

(* Tes Upload Broadcast at zero, then each field in turn at the values it is checked at *)
CheckedTesUploadBroadcast ==
    { ZeroTesUploadBroadcast }
        \cup { [ZeroTesUploadBroadcast EXCEPT !.pad2 = one] : one \in Sample(2) }
        \cup { [ZeroTesUploadBroadcast EXCEPT !.rbcHeaderComp = one] : one \in CheckedRbcHeaderComp27 }
        \cup { [ZeroTesUploadBroadcast EXCEPT !.securityId = one] : one \in Sample(8) }
        \cup { [ZeroTesUploadBroadcast EXCEPT !.lastPx = one] : one \in Sample(8) }
        \cup { [ZeroTesUploadBroadcast EXCEPT !.transBkdTime = one] : one \in Sample(8) }
        \cup { [ZeroTesUploadBroadcast EXCEPT !.transactTime = one] : one \in Sample(8) }
        \cup { [ZeroTesUploadBroadcast EXCEPT !.underlyingPx = one] : one \in Sample(8) }
        \cup { [ZeroTesUploadBroadcast EXCEPT !.relatedClosePrice = one] : one \in Sample(8) }
        \cup { [ZeroTesUploadBroadcast EXCEPT !.relatedTradeQuantity = one] : one \in Sample(8) }
        \cup { [ZeroTesUploadBroadcast EXCEPT !.underlyingQty = one] : one \in Sample(8) }
        \cup { [ZeroTesUploadBroadcast EXCEPT !.compressionId = one] : one \in Sample(8) }
        \cup { [ZeroTesUploadBroadcast EXCEPT !.marketSegmentId = one] : one \in Sample(4) }
        \cup { [ZeroTesUploadBroadcast EXCEPT !.packageId = one] : one \in Sample(4) }
        \cup { [ZeroTesUploadBroadcast EXCEPT !.tesExecId = one] : one \in Sample(4) }
