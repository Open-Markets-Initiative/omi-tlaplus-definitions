ServiceAvailabilityBroadcast ==
    [ pad2                       : Sample(2),
      nrbcHeaderComp             : NrbcHeaderComp,
      matchingEngineTradeDate    : Sample(4),
      tradeManagerTradeDate      : Sample(4),
      applSeqTradeDate           : Sample(4),
