Captures == { AddComplexInstrumentCapture, AddFlexibleInstrumentCapture, AuctionBboCapture, AuctionClearingPriceCapture, CrossRequestCapture, ExecutionSummaryCapture, FullOrderExecutionCapture, HeartbeatCapture, InstrumentStateChangeCapture, InstrumentSummaryCapture, MassInstrumentStateChangeCapture, OrderAddCapture, OrderDeleteCapture, OrderMassDeleteCapture, OrderModifyCapture, OrderModifySamePrioCapture, PartialOrderExecutionCapture, ProductStateChangeCapture, ProductSummaryCapture, QuoteRequestCapture, SnapshotOrderCapture, TesTradeReportCapture, TopOfBookCapture, TradeReportCapture, TradeReversalCapture }

(* Every recorded packet reads, reads whole, and writes back unchanged *)
CapturesRoundTrip ==
    \A bytes \in Captures :
        LET read == DecodePacket(bytes)
        IN  /\ read.ok
            /\ read.rest = << >>
            /\ EncodePacket(read.value) = bytes

(* Every recorded packet is bytes *)
CapturesAreBytes == \A bytes \in Captures : \A i \in 1 .. Len(bytes) : bytes[i] \in Byte

