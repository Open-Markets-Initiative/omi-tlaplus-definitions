        \cup { [tag |-> BoxSignOffMessageCode, body |-> one] : one \in CheckedBoxSignOffMessage }
        \cup { [tag |-> SecureBoxRegistrationReMessageCode, body |-> one] : one \in CheckedSecureBoxRegistrationReMessage }
        \cup { [tag |-> SecureBoxRegistrationReMessageCode2, body |-> one] : one \in CheckedSecureBoxRegistrationReMessage }

(***************************************************************************)
(* Server Message, framed by Message Length                                *)
(***************************************************************************)

ServerMessage ==
    [ logTime              : Sample(4),
      alphaChar            : Sample(2),
      traderId             : Sample(4),
      errorCode            : Sample(2),
      headerTimestamp      : Sample(8),
      timeStamp1           : Sample(8),
      timeStamp2           : Sample(8),
      serverMessagePayload : ServerMessagePayload ]

EncodeServerMessageBody(message) ==
    EncodeServerMessagePayload(message.serverMessagePayload)

(* Message Length counts the bytes it frames, so it is written from them *)
EncodeServerMessage(message) ==
    LET body == EncodeServerMessageBody(message)
    IN  EncodeUIntBE(message.serverMessagePayload.tag, 2) \o message.logTime \o message.alphaChar \o message.traderId \o message.errorCode \o message.headerTimestamp \o message.timeStamp1 \o message.timeStamp2 \o EncodeUIntBE(Len(body) + 40, 2) \o body

DecodeServerMessage(bytes) ==
    LET transactionCode == ReadUIntBE(bytes, 2) IN IF ~transactionCode.ok THEN Fail ELSE
    LET logTime == ReadBytes(transactionCode.rest, 4) IN IF ~logTime.ok THEN Fail ELSE
    LET alphaChar == ReadBytes(logTime.rest, 2) IN IF ~alphaChar.ok THEN Fail ELSE
    LET traderId == ReadBytes(alphaChar.rest, 4) IN IF ~traderId.ok THEN Fail ELSE
    LET errorCode == ReadBytes(traderId.rest, 2) IN IF ~errorCode.ok THEN Fail ELSE
    LET headerTimestamp == ReadBytes(errorCode.rest, 8) IN IF ~headerTimestamp.ok THEN Fail ELSE
    LET timeStamp1 == ReadBytes(headerTimestamp.rest, 8) IN IF ~timeStamp1.ok THEN Fail ELSE
    LET timeStamp2 == ReadBytes(timeStamp1.rest, 8) IN IF ~timeStamp2.ok THEN Fail ELSE
    LET length == ReadUIntBE(timeStamp2.rest, 2) IN IF ~length.ok THEN Fail ELSE
    LET size == length.value - 40 IN
    IF size < 0 \/ Len(length.rest) < size THEN Fail ELSE
    LET framed == SubSeq(length.rest, 1, size)
        beyond == SubSeq(length.rest, size + 1, Len(length.rest))
    IN
    LET serverMessagePayload == DecodeServerMessagePayload(transactionCode.value, framed) IN IF ~serverMessagePayload.ok THEN Fail ELSE
    IF serverMessagePayload.rest # << >> THEN Fail ELSE
    Ok([ logTime              |-> logTime.value,
         alphaChar            |-> alphaChar.value,
         traderId             |-> traderId.value,
         errorCode            |-> errorCode.value,
         headerTimestamp      |-> headerTimestamp.value,
         timeStamp1           |-> timeStamp1.value,
         timeStamp2           |-> timeStamp2.value,
         serverMessagePayload |-> serverMessagePayload.value ], beyond)

ZeroServerMessage ==
    [ logTime              |-> [i \in 1 .. 4 |-> 0],
      alphaChar            |-> [i \in 1 .. 2 |-> 0],
      traderId             |-> [i \in 1 .. 4 |-> 0],
      errorCode            |-> [i \in 1 .. 2 |-> 0],
      headerTimestamp      |-> [i \in 1 .. 8 |-> 0],
      timeStamp1           |-> [i \in 1 .. 8 |-> 0],
      timeStamp2           |-> [i \in 1 .. 8 |-> 0],
      serverMessagePayload |-> ZeroServerMessagePayload ]

(* Server Message at zero, then each field in turn at the values it is checked at *)
CheckedServerMessage ==
    { ZeroServerMessage }
        \cup { [ZeroServerMessage EXCEPT !.logTime = one] : one \in Sample(4) }
        \cup { [ZeroServerMessage EXCEPT !.alphaChar = one] : one \in Sample(2) }
        \cup { [ZeroServerMessage EXCEPT !.traderId = one] : one \in Sample(4) }
        \cup { [ZeroServerMessage EXCEPT !.errorCode = one] : one \in Sample(2) }
        \cup { [ZeroServerMessage EXCEPT !.headerTimestamp = one] : one \in Sample(8) }
        \cup { [ZeroServerMessage EXCEPT !.timeStamp1 = one] : one \in Sample(8) }
        \cup { [ZeroServerMessage EXCEPT !.timeStamp2 = one] : one \in Sample(8) }
        \cup { [ZeroServerMessage EXCEPT !.serverMessagePayload = one] : one \in CheckedServerMessagePayload }

(* A run of Server Message, written one after another *)
RECURSIVE EncodeServerMessageList(_)
EncodeServerMessageList(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeServerMessage(Head(messages)) \o EncodeServerMessageList(Tail(messages))

(* As many Server Message as the bytes hold, which is what its payload rule states. *)
(* Each one takes bytes off the reader, so the run ends where the data does. *)
RECURSIVE ReadServerMessageAll(_)
ReadServerMessageAll(bytes) ==
    IF bytes = << >>
    THEN Ok(<< >>, << >>)
    ELSE LET one == DecodeServerMessage(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadServerMessageAll(one.rest)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Server Message of each kind, for the lists that carry them *)
OneServerMessage ==
    { [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> SystemInformationOutMessageCode, body |-> ZeroSystemInformationOutMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> PartialSystemInformationMessageCode, body |-> ZeroPartialSystemInformationMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> OpenOrderReportMessageCode, body |-> ZeroOpenOrderReportMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> SpreadOrderLogReportMessageCode, body |-> ZeroSpreadOrderLogReportMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> SpreadTradeReportMessageCode, body |-> ZeroSpreadTradeReportMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> BoardLotOutMessageCode, body |-> ZeroBoardLotOutMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> NegOrderToBlMessageCode, body |-> ZeroNegOrderToBlMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> OrderModOutMessageCode, body |-> ZeroOrderModOutMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> OrderModRejectMessageCode, body |-> ZeroOrderModRejectMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> OrderCancelOutMessageCode, body |-> ZeroOrderCancelOutMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> OrderCancelRejectMessageCode, body |-> ZeroOrderCancelRejectMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> OrderConfirmationMessageCode, body |-> ZeroOrderConfirmationMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> OrderModConfirmationMessageCode, body |-> ZeroOrderModConfirmationMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> OrderCancelConfirmationMessageCode, body |-> ZeroOrderCancelConfirmationMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> CancelNegOrderMessageCode, body |-> ZeroCancelNegOrderMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> FreezeToControlMessageCode, body |-> ZeroFreezeToControlMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> OrderErrorMessageCode, body |-> ZeroOrderErrorMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> BatchOrderCancelMessageCode, body |-> ZeroBatchOrderCancelMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> SpBoardLotOutMessageCode, body |-> ZeroSpBoardLotOutMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> TwolBoardLotOutMessageCode, body |-> ZeroTwolBoardLotOutMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> ThrlBoardLotOutMessageCode, body |-> ZeroThrlBoardLotOutMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> SpOrderCancelOutMessageCode, body |-> ZeroSpOrderCancelOutMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> SpOrderModOutMessageCode, body |-> ZeroSpOrderModOutMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> SpOrderConfirmationMessageCode, body |-> ZeroSpOrderConfirmationMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> TwolOrderConfirmationMessageCode, body |-> ZeroTwolOrderConfirmationMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> ThrlOrderConfirmationMessageCode, body |-> ZeroThrlOrderConfirmationMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> SpOrderCxlRejOutMessageCode, body |-> ZeroSpOrderCxlRejOutMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> SpOrderCxlConfirmationMessageCode, body |-> ZeroSpOrderCxlConfirmationMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> TwolOrderCxlConfirmatiMessageCode, body |-> ZeroTwolOrderCxlConfirmatiMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> ThrlOrderCxlConfirmatiMessageCode, body |-> ZeroThrlOrderCxlConfirmatiMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> SpOrderModRejOutMessageCode, body |-> ZeroSpOrderModRejOutMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> SpOrderModConOutMessageCode, body |-> ZeroSpOrderModConOutMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> TwolOrderErrorMessageCode, body |-> ZeroTwolOrderErrorMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> ThrlOrderErrorMessageCode, body |-> ZeroThrlOrderErrorMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> OnStopNotificationMessageCode, body |-> ZeroOnStopNotificationMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> TradeConfirmationMessageCode, body |-> ZeroTradeConfirmationMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> TradeCancelConfirmMessageCode, body |-> ZeroTradeCancelConfirmMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> TradeCancelRejectMessageCode, body |-> ZeroTradeCancelRejectMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> TradeModifyRejectMessageCode, body |-> ZeroTradeModifyRejectMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> TradeErrorMessageCode, body |-> ZeroTradeErrorMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> TradeCancelOutMessageCode, body |-> ZeroTradeCancelOutMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> TradeModifyConfirmMessageCode, body |-> ZeroTradeModifyConfirmMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> SignOnRequestOutMessageCode, body |-> ZeroSignOnRequestOutMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> SignOffTraderOutMessageCode, body |-> ZeroSignOffTraderOutMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> ErrorResponseOutMessageCode, body |-> ZeroErrorResponseOutMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> GrResponseMessageCode, body |-> ZeroGrResponseMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> GiveupAppConfirmTmMessageCode, body |-> ZeroGiveupAppConfirmTmMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> GiveupRejConfirmTmMessageCode, body |-> ZeroGiveupRejConfirmTmMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> UserAddrUnlockConfirmOutMessageCode, body |-> ZeroUserAddrUnlockConfirmOutMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> UserAddrUnlockApproveOutMessageCode, body |-> ZeroUserAddrUnlockApproveOutMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> UserAddrUnlockRejectOMessageCode, body |-> ZeroUserAddrUnlockRejectOMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> BranchOrdValLimitUpdaMessageCode, body |-> ZeroBranchOrdValLimitUpdaMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> UserOrderLimitUpdateOutMessageCode, body |-> ZeroUserOrderLimitUpdateOutMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> DealerLimitUpdateOutMessageCode, body |-> ZeroDealerLimitUpdateOutMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> ResetUserPasswordOutMessageCode, body |-> ZeroResetUserPasswordOutMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> ColUserStatusChangeOutMessageCode, body |-> ZeroColUserStatusChangeOutMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> SpdOrdLimitUpdateOutMessageCode, body |-> ZeroSpdOrdLimitUpdateOutMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> UpdateLocaldbHeaderMessageCode, body |-> ZeroUpdateLocaldbHeaderMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> UpdateLocaldbTrailerMessageCode, body |-> ZeroUpdateLocaldbTrailerMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> BcastAssetMstrChgMessageCode, body |-> ZeroBcastAssetMstrChgMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> BoxSignOnRequestOutMessageCode, body |-> ZeroBoxSignOnRequestOutMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> BoxSignOffMessageCode, body |-> ZeroBoxSignOffMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> SecureBoxRegistrationReMessageCode, body |-> ZeroSecureBoxRegistrationReMessage]],
      [ZeroServerMessage EXCEPT !.serverMessagePayload = [tag |-> SecureBoxRegistrationReMessageCode2, body |-> ZeroSecureBoxRegistrationReMessage]] }

(***************************************************************************)
(* Server Packet                                                           *)
(***************************************************************************)

ServerPacket ==
    [ serverMessage : SampleLists(OneServerMessage) ]

EncodeServerPacket(message) ==
    EncodeServerMessageList(message.serverMessage)

DecodeServerPacket(bytes) ==
    LET serverMessage == ReadServerMessageAll(bytes) IN IF ~serverMessage.ok THEN Fail ELSE
    Ok([ serverMessage |-> serverMessage.value ], serverMessage.rest)

ZeroServerPacket ==
    [ serverMessage |-> << >> ]

(* Server Packet at zero, then each field in turn at the values it is checked at *)
CheckedServerPacket ==
    { ZeroServerPacket }
        \cup { [ZeroServerPacket EXCEPT !.serverMessage = one] : one \in SampleLists(OneServerMessage) }

(***************************************************************************)
(* What TLC checks                                                         *)
(***************************************************************************)

(* An integer a rule depends on writes its width and reads back what was written *)
RoundTripUIntLE ==
    \A width \in 1 .. 3 :
        \A value \in {0, 1, 255, 256, 65535} :
            (value < 256 ^ width) =>
                /\ Len(EncodeUIntLE(value, width)) = width
                /\ DecodeUIntLE(EncodeUIntLE(value, width)) = value
                /\ Len(EncodeUIntBE(value, width)) = width
                /\ DecodeUIntBE(EncodeUIntBE(value, width)) = value
                /\ \A i \in 1 .. width : EncodeUIntLE(value, width)[i] \in Byte
                /\ \A i \in 1 .. width : EncodeUIntBE(value, width)[i] \in Byte

(* Every St Market Status decodes back to what was encoded, and leaves nothing over *)
RoundTripStMarketStatus ==
    \A message \in CheckedStMarketStatus :
        LET read == DecodeStMarketStatus(EncodeStMarketStatus(message))
        IN  /\ read.ok
            /\ read.value = message
            /\ read.rest = << >>

(* Every St Ex Market Status decodes back to what was encoded, and leaves nothing over *)
RoundTripStExMarketStatus ==
    \A message \in CheckedStExMarketStatus :
        LET read == DecodeStExMarketStatus(EncodeStExMarketStatus(message))
