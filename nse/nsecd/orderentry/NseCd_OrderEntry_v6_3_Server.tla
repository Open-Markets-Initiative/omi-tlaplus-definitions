        \cup { [ZeroContractDesc42 EXCEPT !.instrumentName = one] : one \in Sample(6) }
        \cup { [ZeroContractDesc42 EXCEPT !.symbol = one] : one \in Sample(10) }
        \cup { [ZeroContractDesc42 EXCEPT !.expiryDate = one] : one \in Sample(4) }
        \cup { [ZeroContractDesc42 EXCEPT !.strikePrice = one] : one \in Sample(4) }
