ServerMessagePayload ==
    [ tag : {SystemInformationOutMessageCode}, body : SystemInformationOutMessage ]
        \cup [ tag : {PartialSystemInformationMessageCode}, body : PartialSystemInformationMessage ]
        \cup [ tag : {OpenOrderReportMessageCode}, body : OpenOrderReportMessage ]
        \cup [ tag : {SpreadOrderLogReportMessageCode}, body : SpreadOrderLogReportMessage ]
        \cup [ tag : {SpreadTradeReportMessageCode}, body : SpreadTradeReportMessage ]
        \cup [ tag : {BoardLotOutMessageCode}, body : BoardLotOutMessage ]
        \cup [ tag : {NegOrderToBlMessageCode}, body : NegOrderToBlMessage ]
        \cup [ tag : {OrderModOutMessageCode}, body : OrderModOutMessage ]
        \cup [ tag : {OrderModRejectMessageCode}, body : OrderModRejectMessage ]
        \cup [ tag : {OrderCancelOutMessageCode}, body : OrderCancelOutMessage ]
        \cup [ tag : {OrderCancelRejectMessageCode}, body : OrderCancelRejectMessage ]
        \cup [ tag : {OrderConfirmationMessageCode}, body : OrderConfirmationMessage ]
        \cup [ tag : {OrderModConfirmationMessageCode}, body : OrderModConfirmationMessage ]
        \cup [ tag : {OrderCancelConfirmationMessageCode}, body : OrderCancelConfirmationMessage ]
        \cup [ tag : {CancelNegOrderMessageCode}, body : CancelNegOrderMessage ]
        \cup [ tag : {FreezeToControlMessageCode}, body : FreezeToControlMessage ]
        \cup [ tag : {OrderErrorMessageCode}, body : OrderErrorMessage ]
        \cup [ tag : {BatchOrderCancelMessageCode}, body : BatchOrderCancelMessage ]
        \cup [ tag : {SpBoardLotOutMessageCode}, body : SpBoardLotOutMessage ]
        \cup [ tag : {TwolBoardLotOutMessageCode}, body : TwolBoardLotOutMessage ]
        \cup [ tag : {ThrlBoardLotOutMessageCode}, body : ThrlBoardLotOutMessage ]
        \cup [ tag : {SpOrderCancelOutMessageCode}, body : SpOrderCancelOutMessage ]
        \cup [ tag : {SpOrderModOutMessageCode}, body : SpOrderModOutMessage ]
        \cup [ tag : {SpOrderConfirmationMessageCode}, body : SpOrderConfirmationMessage ]
        \cup [ tag : {TwolOrderConfirmationMessageCode}, body : TwolOrderConfirmationMessage ]
        \cup [ tag : {ThrlOrderConfirmationMessageCode}, body : ThrlOrderConfirmationMessage ]
        \cup [ tag : {SpOrderCxlRejOutMessageCode}, body : SpOrderCxlRejOutMessage ]
        \cup [ tag : {SpOrderCxlConfirmationMessageCode}, body : SpOrderCxlConfirmationMessage ]
        \cup [ tag : {TwolOrderCxlConfirmatiMessageCode}, body : TwolOrderCxlConfirmatiMessage ]
        \cup [ tag : {ThrlOrderCxlConfirmatiMessageCode}, body : ThrlOrderCxlConfirmatiMessage ]
        \cup [ tag : {SpOrderModRejOutMessageCode}, body : SpOrderModRejOutMessage ]
        \cup [ tag : {SpOrderModConOutMessageCode}, body : SpOrderModConOutMessage ]
        \cup [ tag : {TwolOrderErrorMessageCode}, body : TwolOrderErrorMessage ]
        \cup [ tag : {ThrlOrderErrorMessageCode}, body : ThrlOrderErrorMessage ]
        \cup [ tag : {OnStopNotificationMessageCode}, body : OnStopNotificationMessage ]
        \cup [ tag : {TradeConfirmationMessageCode}, body : TradeConfirmationMessage ]
        \cup [ tag : {TradeCancelConfirmMessageCode}, body : TradeCancelConfirmMessage ]
        \cup [ tag : {TradeCancelRejectMessageCode}, body : TradeCancelRejectMessage ]
        \cup [ tag : {TradeModifyRejectMessageCode}, body : TradeModifyRejectMessage ]
        \cup [ tag : {TradeErrorMessageCode}, body : TradeErrorMessage ]
        \cup [ tag : {TradeCancelOutMessageCode}, body : TradeCancelOutMessage ]
        \cup [ tag : {TradeModifyConfirmMessageCode}, body : TradeModifyConfirmMessage ]
        \cup [ tag : {SignOnRequestOutMessageCode}, body : SignOnRequestOutMessage ]
        \cup [ tag : {SignOffTraderOutMessageCode}, body : SignOffTraderOutMessage ]
        \cup [ tag : {ErrorResponseOutMessageCode}, body : ErrorResponseOutMessage ]
        \cup [ tag : {GrResponseMessageCode}, body : GrResponseMessage ]
        \cup [ tag : {GiveupAppConfirmTmMessageCode}, body : GiveupAppConfirmTmMessage ]
        \cup [ tag : {GiveupRejConfirmTmMessageCode}, body : GiveupRejConfirmTmMessage ]
        \cup [ tag : {UserAddrUnlockConfirmOutMessageCode}, body : UserAddrUnlockConfirmOutMessage ]
        \cup [ tag : {UserAddrUnlockApproveOutMessageCode}, body : UserAddrUnlockApproveOutMessage ]
        \cup [ tag : {UserAddrUnlockRejectOMessageCode}, body : UserAddrUnlockRejectOMessage ]
        \cup [ tag : {BranchOrdValLimitUpdaMessageCode}, body : BranchOrdValLimitUpdaMessage ]
        \cup [ tag : {UserOrderLimitUpdateOutMessageCode}, body : UserOrderLimitUpdateOutMessage ]
        \cup [ tag : {DealerLimitUpdateOutMessageCode}, body : DealerLimitUpdateOutMessage ]
        \cup [ tag : {ResetUserPasswordOutMessageCode}, body : ResetUserPasswordOutMessage ]
        \cup [ tag : {ColUserStatusChangeOutMessageCode}, body : ColUserStatusChangeOutMessage ]
        \cup [ tag : {SpdOrdLimitUpdateOutMessageCode}, body : SpdOrdLimitUpdateOutMessage ]
        \cup [ tag : {UpdateLocaldbHeaderMessageCode}, body : UpdateLocaldbHeaderMessage ]
        \cup [ tag : {UpdateLocaldbTrailerMessageCode}, body : UpdateLocaldbTrailerMessage ]
        \cup [ tag : {BcastAssetMstrChgMessageCode}, body : BcastAssetMstrChgMessage ]
        \cup [ tag : {BoxSignOnRequestOutMessageCode}, body : BoxSignOnRequestOutMessage ]
