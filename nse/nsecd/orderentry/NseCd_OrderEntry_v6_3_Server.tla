(* Order Mod Confirmation Message at zero, then each field in turn at the values it is checked at *)
CheckedOrderModConfirmationMessage ==
    { ZeroOrderModConfirmationMessage }
        \cup { [ZeroOrderModConfirmationMessage EXCEPT !.participantType = one] : one \in Sample(1) }
        \cup { [ZeroOrderModConfirmationMessage EXCEPT !.reserved1 = one] : one \in Sample(1) }
        \cup { [ZeroOrderModConfirmationMessage EXCEPT !.competitorPeriod = one] : one \in Sample(2) }
        \cup { [ZeroOrderModConfirmationMessage EXCEPT !.solicitorPeriod = one] : one \in Sample(2) }
        \cup { [ZeroOrderModConfirmationMessage EXCEPT !.modifiedCancelledBy = one] : one \in Sample(1) }
        \cup { [ZeroOrderModConfirmationMessage EXCEPT !.secondReserved1 = one] : one \in Sample(1) }
        \cup { [ZeroOrderModConfirmationMessage EXCEPT !.reasonCode = one] : one \in Sample(2) }
        \cup { [ZeroOrderModConfirmationMessage EXCEPT !.reserved4 = one] : one \in Sample(4) }
        \cup { [ZeroOrderModConfirmationMessage EXCEPT !.tokenNo = one] : one \in Sample(4) }
        \cup { [ZeroOrderModConfirmationMessage EXCEPT !.contractDesc = one] : one \in CheckedContractDesc8 }
        \cup { [ZeroOrderModConfirmationMessage EXCEPT !.counterPartyBrokerId = one] : one \in Sample(5) }
        \cup { [ZeroOrderModConfirmationMessage EXCEPT !.thirdReserved1 = one] : one \in Sample(1) }
