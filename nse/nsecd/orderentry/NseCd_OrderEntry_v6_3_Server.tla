(***************************************************************************)
(* Asset Details: 26 bytes                                                 *)
(***************************************************************************)

AssetDetails ==
    [ assetName           : Sample(10),
      precision           : Sample(1),
      reserved1           : Sample(1),
      volatility          : Sample(4),
      token               : Sample(4),
      multiplier          : Sample(4),
      foreignInterestRate : Sample(2) ]

EncodeAssetDetails(message) ==
    message.assetName
        \o message.precision
        \o message.reserved1
        \o message.volatility
        \o message.token
        \o message.multiplier
        \o message.foreignInterestRate

DecodeAssetDetails(bytes) ==
    LET assetName == ReadBytes(bytes, 10) IN IF ~assetName.ok THEN Fail ELSE
    LET precision == ReadBytes(assetName.rest, 1) IN IF ~precision.ok THEN Fail ELSE
    LET reserved1 == ReadBytes(precision.rest, 1) IN IF ~reserved1.ok THEN Fail ELSE
    LET volatility == ReadBytes(reserved1.rest, 4) IN IF ~volatility.ok THEN Fail ELSE
    LET token == ReadBytes(volatility.rest, 4) IN IF ~token.ok THEN Fail ELSE
    LET multiplier == ReadBytes(token.rest, 4) IN IF ~multiplier.ok THEN Fail ELSE
    LET foreignInterestRate == ReadBytes(multiplier.rest, 2) IN IF ~foreignInterestRate.ok THEN Fail ELSE
    Ok([ assetName           |-> assetName.value,
         precision           |-> precision.value,
         reserved1           |-> reserved1.value,
         volatility          |-> volatility.value,
         token               |-> token.value,
         multiplier          |-> multiplier.value,
         foreignInterestRate |-> foreignInterestRate.value ], foreignInterestRate.rest)

ZeroAssetDetails ==
    [ assetName           |-> [i \in 1 .. 10 |-> 0],
      precision           |-> [i \in 1 .. 1 |-> 0],
      reserved1           |-> [i \in 1 .. 1 |-> 0],
      volatility          |-> [i \in 1 .. 4 |-> 0],
      token               |-> [i \in 1 .. 4 |-> 0],
      multiplier          |-> [i \in 1 .. 4 |-> 0],
      foreignInterestRate |-> [i \in 1 .. 2 |-> 0] ]

(* Asset Details at zero, then each field in turn at the values it is checked at *)
CheckedAssetDetails ==
    { ZeroAssetDetails }
        \cup { [ZeroAssetDetails EXCEPT !.assetName = one] : one \in Sample(10) }
        \cup { [ZeroAssetDetails EXCEPT !.precision = one] : one \in Sample(1) }
        \cup { [ZeroAssetDetails EXCEPT !.reserved1 = one] : one \in Sample(1) }
        \cup { [ZeroAssetDetails EXCEPT !.volatility = one] : one \in Sample(4) }
        \cup { [ZeroAssetDetails EXCEPT !.token = one] : one \in Sample(4) }
        \cup { [ZeroAssetDetails EXCEPT !.multiplier = one] : one \in Sample(4) }
        \cup { [ZeroAssetDetails EXCEPT !.foreignInterestRate = one] : one \in Sample(2) }

(***************************************************************************)
(* Bcast Asset Mstr Chg Message: 392 bytes                                 *)
(***************************************************************************)

BcastAssetMstrChgMessage ==
    [ noOfRecords  : Sample(2),
      assetDetails : AssetDetails,
      reserved364  : Sample(364) ]

EncodeBcastAssetMstrChgMessage(message) ==
    message.noOfRecords
        \o EncodeAssetDetails(message.assetDetails)
        \o message.reserved364

DecodeBcastAssetMstrChgMessage(bytes) ==
    LET noOfRecords == ReadBytes(bytes, 2) IN IF ~noOfRecords.ok THEN Fail ELSE
    LET assetDetails == DecodeAssetDetails(noOfRecords.rest) IN IF ~assetDetails.ok THEN Fail ELSE
    LET reserved364 == ReadBytes(assetDetails.rest, 364) IN IF ~reserved364.ok THEN Fail ELSE
    Ok([ noOfRecords  |-> noOfRecords.value,
         assetDetails |-> assetDetails.value,
         reserved364  |-> reserved364.value ], reserved364.rest)

ZeroBcastAssetMstrChgMessage ==
    [ noOfRecords  |-> [i \in 1 .. 2 |-> 0],
      assetDetails |-> ZeroAssetDetails,
      reserved364  |-> [i \in 1 .. 364 |-> 0] ]

(* Bcast Asset Mstr Chg Message at zero, then each field in turn at the values it is checked at *)
CheckedBcastAssetMstrChgMessage ==
    { ZeroBcastAssetMstrChgMessage }
        \cup { [ZeroBcastAssetMstrChgMessage EXCEPT !.noOfRecords = one] : one \in Sample(2) }
        \cup { [ZeroBcastAssetMstrChgMessage EXCEPT !.assetDetails = one] : one \in CheckedAssetDetails }
        \cup { [ZeroBcastAssetMstrChgMessage EXCEPT !.reserved364 = one] : one \in Sample(364) }

