(* Sp Order Confirmation Message at zero, then each field in turn at the values it is checked at *)
CheckedSpOrderConfirmationMessage ==
    { ZeroSpOrderConfirmationMessage }
        \cup { [ZeroSpOrderConfirmationMessage EXCEPT !.participantType1 = one] : one \in Sample(1) }
        \cup { [ZeroSpOrderConfirmationMessage EXCEPT !.filler1 = one] : one \in Sample(1) }
        \cup { [ZeroSpOrderConfirmationMessage EXCEPT !.competitorPeriod1 = one] : one \in Sample(2) }
        \cup { [ZeroSpOrderConfirmationMessage EXCEPT !.solicitorPeriod1 = one] : one \in Sample(2) }
        \cup { [ZeroSpOrderConfirmationMessage EXCEPT !.modCxlBy1 = one] : one \in Sample(1) }
        \cup { [ZeroSpOrderConfirmationMessage EXCEPT !.filler9 = one] : one \in Sample(1) }
        \cup { [ZeroSpOrderConfirmationMessage EXCEPT !.reasonCode1 = one] : one \in Sample(2) }
        \cup { [ZeroSpOrderConfirmationMessage EXCEPT !.startAlpha1 = one] : one \in Sample(2) }
        \cup { [ZeroSpOrderConfirmationMessage EXCEPT !.endAlpha1 = one] : one \in Sample(2) }
        \cup { [ZeroSpOrderConfirmationMessage EXCEPT !.token1 = one] : one \in Sample(4) }
        \cup { [ZeroSpOrderConfirmationMessage EXCEPT !.contractDesc = one] : one \in CheckedContractDesc29 }
        \cup { [ZeroSpOrderConfirmationMessage EXCEPT !.opBrokerId1 = one] : one \in Sample(5) }
        \cup { [ZeroSpOrderConfirmationMessage EXCEPT !.fillerx1 = one] : one \in Sample(1) }
        \cup { [ZeroSpOrderConfirmationMessage EXCEPT !.fillerOptions1 = one] : one \in Sample(3) }
        \cup { [ZeroSpOrderConfirmationMessage EXCEPT !.fillery1 = one] : one \in Sample(1) }
        \cup { [ZeroSpOrderConfirmationMessage EXCEPT !.orderType1 = one] : one \in Sample(2) }
        \cup { [ZeroSpOrderConfirmationMessage EXCEPT !.orderNumber1 = one] : one \in Sample(8) }
        \cup { [ZeroSpOrderConfirmationMessage EXCEPT !.accountNumber1 = one] : one \in Sample(10) }
