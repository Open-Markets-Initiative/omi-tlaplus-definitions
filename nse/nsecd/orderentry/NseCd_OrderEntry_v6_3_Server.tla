        \cup { [ZeroBranchLimits2 EXCEPT !.branchSellValueLimit = one] : one \in Sample(8) }
        \cup { [ZeroBranchLimits2 EXCEPT !.reserved16 = one] : one \in Sample(16) }

(***************************************************************************)
(* Branch Ord Val Limit Upda Message: 96 bytes                             *)
(***************************************************************************)

BranchOrdValLimitUpdaMessage ==
    [ brokerId      : Sample(5),
      reserved25    : Sample(25),
      branchId      : Sample(2),
      branchLimits1 : BranchLimits1,
      branchLimits2 : BranchLimits2 ]

EncodeBranchOrdValLimitUpdaMessage(message) ==
    message.brokerId
        \o message.reserved25
        \o message.branchId
        \o EncodeBranchLimits1(message.branchLimits1)
        \o EncodeBranchLimits2(message.branchLimits2)

DecodeBranchOrdValLimitUpdaMessage(bytes) ==
    LET brokerId == ReadBytes(bytes, 5) IN IF ~brokerId.ok THEN Fail ELSE
    LET reserved25 == ReadBytes(brokerId.rest, 25) IN IF ~reserved25.ok THEN Fail ELSE
    LET branchId == ReadBytes(reserved25.rest, 2) IN IF ~branchId.ok THEN Fail ELSE
    LET branchLimits1 == DecodeBranchLimits1(branchId.rest) IN IF ~branchLimits1.ok THEN Fail ELSE
    LET branchLimits2 == DecodeBranchLimits2(branchLimits1.rest) IN IF ~branchLimits2.ok THEN Fail ELSE
    Ok([ brokerId      |-> brokerId.value,
         reserved25    |-> reserved25.value,
         branchId      |-> branchId.value,
         branchLimits1 |-> branchLimits1.value,
         branchLimits2 |-> branchLimits2.value ], branchLimits2.rest)

ZeroBranchOrdValLimitUpdaMessage ==
    [ brokerId      |-> [i \in 1 .. 5 |-> 0],
      reserved25    |-> [i \in 1 .. 25 |-> 0],
      branchId      |-> [i \in 1 .. 2 |-> 0],
      branchLimits1 |-> ZeroBranchLimits1,
      branchLimits2 |-> ZeroBranchLimits2 ]

(* Branch Ord Val Limit Upda Message at zero, then each field in turn at the values it is checked at *)
CheckedBranchOrdValLimitUpdaMessage ==
    { ZeroBranchOrdValLimitUpdaMessage }
        \cup { [ZeroBranchOrdValLimitUpdaMessage EXCEPT !.brokerId = one] : one \in Sample(5) }
        \cup { [ZeroBranchOrdValLimitUpdaMessage EXCEPT !.reserved25 = one] : one \in Sample(25) }
        \cup { [ZeroBranchOrdValLimitUpdaMessage EXCEPT !.branchId = one] : one \in Sample(2) }
        \cup { [ZeroBranchOrdValLimitUpdaMessage EXCEPT !.branchLimits1 = one] : one \in CheckedBranchLimits1 }
        \cup { [ZeroBranchOrdValLimitUpdaMessage EXCEPT !.branchLimits2 = one] : one \in CheckedBranchLimits2 }

(***************************************************************************)
(* Instrument User: 64 bytes                                               *)
(***************************************************************************)

InstrumentUser ==
    [ branchBuyValueLimit         : Sample(8),
      branchSellValueLimit        : Sample(8),
      branchUsedBuyValueLimit     : Sample(8),
      branchUsedSellValueLimit    : Sample(8),
      userOrderBuyValueLimit      : Sample(8),
      userOrderSellValueLimit     : Sample(8),
      userOrderUsedBuyValueLimit  : Sample(8),
      userOrderUsedSellValueLimit : Sample(8) ]

EncodeInstrumentUser(message) ==
    message.branchBuyValueLimit
        \o message.branchSellValueLimit
        \o message.branchUsedBuyValueLimit
        \o message.branchUsedSellValueLimit
        \o message.userOrderBuyValueLimit
        \o message.userOrderSellValueLimit
        \o message.userOrderUsedBuyValueLimit
        \o message.userOrderUsedSellValueLimit

DecodeInstrumentUser(bytes) ==
    LET branchBuyValueLimit == ReadBytes(bytes, 8) IN IF ~branchBuyValueLimit.ok THEN Fail ELSE
    LET branchSellValueLimit == ReadBytes(branchBuyValueLimit.rest, 8) IN IF ~branchSellValueLimit.ok THEN Fail ELSE
    LET branchUsedBuyValueLimit == ReadBytes(branchSellValueLimit.rest, 8) IN IF ~branchUsedBuyValueLimit.ok THEN Fail ELSE
    LET branchUsedSellValueLimit == ReadBytes(branchUsedBuyValueLimit.rest, 8) IN IF ~branchUsedSellValueLimit.ok THEN Fail ELSE
    LET userOrderBuyValueLimit == ReadBytes(branchUsedSellValueLimit.rest, 8) IN IF ~userOrderBuyValueLimit.ok THEN Fail ELSE
    LET userOrderSellValueLimit == ReadBytes(userOrderBuyValueLimit.rest, 8) IN IF ~userOrderSellValueLimit.ok THEN Fail ELSE
    LET userOrderUsedBuyValueLimit == ReadBytes(userOrderSellValueLimit.rest, 8) IN IF ~userOrderUsedBuyValueLimit.ok THEN Fail ELSE
    LET userOrderUsedSellValueLimit == ReadBytes(userOrderUsedBuyValueLimit.rest, 8) IN IF ~userOrderUsedSellValueLimit.ok THEN Fail ELSE
    Ok([ branchBuyValueLimit         |-> branchBuyValueLimit.value,
         branchSellValueLimit        |-> branchSellValueLimit.value,
         branchUsedBuyValueLimit     |-> branchUsedBuyValueLimit.value,
         branchUsedSellValueLimit    |-> branchUsedSellValueLimit.value,
         userOrderBuyValueLimit      |-> userOrderBuyValueLimit.value,
         userOrderSellValueLimit     |-> userOrderSellValueLimit.value,
         userOrderUsedBuyValueLimit  |-> userOrderUsedBuyValueLimit.value,
         userOrderUsedSellValueLimit |-> userOrderUsedSellValueLimit.value ], userOrderUsedSellValueLimit.rest)

ZeroInstrumentUser ==
    [ branchBuyValueLimit         |-> [i \in 1 .. 8 |-> 0],
      branchSellValueLimit        |-> [i \in 1 .. 8 |-> 0],
      branchUsedBuyValueLimit     |-> [i \in 1 .. 8 |-> 0],
      branchUsedSellValueLimit    |-> [i \in 1 .. 8 |-> 0],
      userOrderBuyValueLimit      |-> [i \in 1 .. 8 |-> 0],
      userOrderSellValueLimit     |-> [i \in 1 .. 8 |-> 0],
      userOrderUsedBuyValueLimit  |-> [i \in 1 .. 8 |-> 0],
      userOrderUsedSellValueLimit |-> [i \in 1 .. 8 |-> 0] ]

(* Instrument User at zero, then each field in turn at the values it is checked at *)
CheckedInstrumentUser ==
    { ZeroInstrumentUser }
        \cup { [ZeroInstrumentUser EXCEPT !.branchBuyValueLimit = one] : one \in Sample(8) }
        \cup { [ZeroInstrumentUser EXCEPT !.branchSellValueLimit = one] : one \in Sample(8) }
        \cup { [ZeroInstrumentUser EXCEPT !.branchUsedBuyValueLimit = one] : one \in Sample(8) }
        \cup { [ZeroInstrumentUser EXCEPT !.branchUsedSellValueLimit = one] : one \in Sample(8) }
        \cup { [ZeroInstrumentUser EXCEPT !.userOrderBuyValueLimit = one] : one \in Sample(8) }
        \cup { [ZeroInstrumentUser EXCEPT !.userOrderSellValueLimit = one] : one \in Sample(8) }
        \cup { [ZeroInstrumentUser EXCEPT !.userOrderUsedBuyValueLimit = one] : one \in Sample(8) }
        \cup { [ZeroInstrumentUser EXCEPT !.userOrderUsedSellValueLimit = one] : one \in Sample(8) }

(***************************************************************************)
(* User Order Limit Update Out Message: 166 bytes                          *)
(***************************************************************************)

UserOrderLimitUpdateOutMessage ==
    [ brokerId       : Sample(5),
      branchId       : Sample(2),
      userName       : Sample(25),
      userId         : Sample(4),
      userType       : Sample(2),
      instrumentUser : InstrumentUser,
      reserved64     : Sample(64) ]

EncodeUserOrderLimitUpdateOutMessage(message) ==
    message.brokerId
        \o message.branchId
        \o message.userName
        \o message.userId
        \o message.userType
        \o EncodeInstrumentUser(message.instrumentUser)
        \o message.reserved64

DecodeUserOrderLimitUpdateOutMessage(bytes) ==
    LET brokerId == ReadBytes(bytes, 5) IN IF ~brokerId.ok THEN Fail ELSE
    LET branchId == ReadBytes(brokerId.rest, 2) IN IF ~branchId.ok THEN Fail ELSE
    LET userName == ReadBytes(branchId.rest, 25) IN IF ~userName.ok THEN Fail ELSE
    LET userId == ReadBytes(userName.rest, 4) IN IF ~userId.ok THEN Fail ELSE
    LET userType == ReadBytes(userId.rest, 2) IN IF ~userType.ok THEN Fail ELSE
    LET instrumentUser == DecodeInstrumentUser(userType.rest) IN IF ~instrumentUser.ok THEN Fail ELSE
    LET reserved64 == ReadBytes(instrumentUser.rest, 64) IN IF ~reserved64.ok THEN Fail ELSE
    Ok([ brokerId       |-> brokerId.value,
         branchId       |-> branchId.value,
         userName       |-> userName.value,
         userId         |-> userId.value,
         userType       |-> userType.value,
         instrumentUser |-> instrumentUser.value,
         reserved64     |-> reserved64.value ], reserved64.rest)

ZeroUserOrderLimitUpdateOutMessage ==
    [ brokerId       |-> [i \in 1 .. 5 |-> 0],
      branchId       |-> [i \in 1 .. 2 |-> 0],
      userName       |-> [i \in 1 .. 25 |-> 0],
      userId         |-> [i \in 1 .. 4 |-> 0],
      userType       |-> [i \in 1 .. 2 |-> 0],
      instrumentUser |-> ZeroInstrumentUser,
      reserved64     |-> [i \in 1 .. 64 |-> 0] ]

(* User Order Limit Update Out Message at zero, then each field in turn at the values it is checked at *)
CheckedUserOrderLimitUpdateOutMessage ==
    { ZeroUserOrderLimitUpdateOutMessage }
        \cup { [ZeroUserOrderLimitUpdateOutMessage EXCEPT !.brokerId = one] : one \in Sample(5) }
        \cup { [ZeroUserOrderLimitUpdateOutMessage EXCEPT !.branchId = one] : one \in Sample(2) }
        \cup { [ZeroUserOrderLimitUpdateOutMessage EXCEPT !.userName = one] : one \in Sample(25) }
        \cup { [ZeroUserOrderLimitUpdateOutMessage EXCEPT !.userId = one] : one \in Sample(4) }
        \cup { [ZeroUserOrderLimitUpdateOutMessage EXCEPT !.userType = one] : one \in Sample(2) }
        \cup { [ZeroUserOrderLimitUpdateOutMessage EXCEPT !.instrumentUser = one] : one \in CheckedInstrumentUser }
        \cup { [ZeroUserOrderLimitUpdateOutMessage EXCEPT !.reserved64 = one] : one \in Sample(64) }

