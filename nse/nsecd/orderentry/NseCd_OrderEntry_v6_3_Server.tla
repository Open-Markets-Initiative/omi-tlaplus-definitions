(***************************************************************************)
(* Partial System Information Message: 66 bytes                            *)
(***************************************************************************)

PartialSystemInformationMessage ==
    [ stMarketStatus                  : StMarketStatus2,
      stExMarketStatus                : StExMarketStatus2,
      stPlMarketStatus                : StPlMarketStatus2,
      updatePortfolio                 : Sample(1),
      cFiller                         : Sample(1),
      marketIndex                     : Sample(4),
      defaultSettlementPeriodNormal   : Sample(2),
      defaultSettlementPeriodSpot     : Sample(2),
      defaultSettlementPeriodAuction  : Sample(2),
      competitorPeriod                : Sample(2),
      solicitorPeriod                 : Sample(2),
      warningPercent                  : Sample(2),
      volumeFreezePercent             : Sample(2),
      snapQuoteTime                   : Sample(2),
      reserved2                       : Sample(2),
      boardLotQuantity                : Sample(4),
      tickSize                        : Sample(4),
      maximumGtcDays                  : Sample(2),
      stStockEligibleIndicators       : Sample(2),
      disclosedQuantityPercentAllowed : Sample(2),
      riskFreeInterestRate            : Sample(4) ]

EncodePartialSystemInformationMessage(message) ==
    EncodeStMarketStatus2(message.stMarketStatus)
        \o EncodeStExMarketStatus2(message.stExMarketStatus)
        \o EncodeStPlMarketStatus2(message.stPlMarketStatus)
        \o message.updatePortfolio
        \o message.cFiller
        \o message.marketIndex
        \o message.defaultSettlementPeriodNormal
        \o message.defaultSettlementPeriodSpot
        \o message.defaultSettlementPeriodAuction
        \o message.competitorPeriod
        \o message.solicitorPeriod
        \o message.warningPercent
        \o message.volumeFreezePercent
        \o message.snapQuoteTime
        \o message.reserved2
        \o message.boardLotQuantity
        \o message.tickSize
        \o message.maximumGtcDays
        \o message.stStockEligibleIndicators
        \o message.disclosedQuantityPercentAllowed
        \o message.riskFreeInterestRate

DecodePartialSystemInformationMessage(bytes) ==
    LET stMarketStatus == DecodeStMarketStatus2(bytes) IN IF ~stMarketStatus.ok THEN Fail ELSE
    LET stExMarketStatus == DecodeStExMarketStatus2(stMarketStatus.rest) IN IF ~stExMarketStatus.ok THEN Fail ELSE
    LET stPlMarketStatus == DecodeStPlMarketStatus2(stExMarketStatus.rest) IN IF ~stPlMarketStatus.ok THEN Fail ELSE
    LET updatePortfolio == ReadBytes(stPlMarketStatus.rest, 1) IN IF ~updatePortfolio.ok THEN Fail ELSE
    LET cFiller == ReadBytes(updatePortfolio.rest, 1) IN IF ~cFiller.ok THEN Fail ELSE
    LET marketIndex == ReadBytes(cFiller.rest, 4) IN IF ~marketIndex.ok THEN Fail ELSE
    LET defaultSettlementPeriodNormal == ReadBytes(marketIndex.rest, 2) IN IF ~defaultSettlementPeriodNormal.ok THEN Fail ELSE
    LET defaultSettlementPeriodSpot == ReadBytes(defaultSettlementPeriodNormal.rest, 2) IN IF ~defaultSettlementPeriodSpot.ok THEN Fail ELSE
    LET defaultSettlementPeriodAuction == ReadBytes(defaultSettlementPeriodSpot.rest, 2) IN IF ~defaultSettlementPeriodAuction.ok THEN Fail ELSE
    LET competitorPeriod == ReadBytes(defaultSettlementPeriodAuction.rest, 2) IN IF ~competitorPeriod.ok THEN Fail ELSE
    LET solicitorPeriod == ReadBytes(competitorPeriod.rest, 2) IN IF ~solicitorPeriod.ok THEN Fail ELSE
    LET warningPercent == ReadBytes(solicitorPeriod.rest, 2) IN IF ~warningPercent.ok THEN Fail ELSE
    LET volumeFreezePercent == ReadBytes(warningPercent.rest, 2) IN IF ~volumeFreezePercent.ok THEN Fail ELSE
    LET snapQuoteTime == ReadBytes(volumeFreezePercent.rest, 2) IN IF ~snapQuoteTime.ok THEN Fail ELSE
    LET reserved2 == ReadBytes(snapQuoteTime.rest, 2) IN IF ~reserved2.ok THEN Fail ELSE
    LET boardLotQuantity == ReadBytes(reserved2.rest, 4) IN IF ~boardLotQuantity.ok THEN Fail ELSE
    LET tickSize == ReadBytes(boardLotQuantity.rest, 4) IN IF ~tickSize.ok THEN Fail ELSE
    LET maximumGtcDays == ReadBytes(tickSize.rest, 2) IN IF ~maximumGtcDays.ok THEN Fail ELSE
    LET stStockEligibleIndicators == ReadBytes(maximumGtcDays.rest, 2) IN IF ~stStockEligibleIndicators.ok THEN Fail ELSE
    LET disclosedQuantityPercentAllowed == ReadBytes(stStockEligibleIndicators.rest, 2) IN IF ~disclosedQuantityPercentAllowed.ok THEN Fail ELSE
    LET riskFreeInterestRate == ReadBytes(disclosedQuantityPercentAllowed.rest, 4) IN IF ~riskFreeInterestRate.ok THEN Fail ELSE
    Ok([ stMarketStatus                  |-> stMarketStatus.value,
         stExMarketStatus                |-> stExMarketStatus.value,
         stPlMarketStatus                |-> stPlMarketStatus.value,
         updatePortfolio                 |-> updatePortfolio.value,
         cFiller                         |-> cFiller.value,
         marketIndex                     |-> marketIndex.value,
         defaultSettlementPeriodNormal   |-> defaultSettlementPeriodNormal.value,
         defaultSettlementPeriodSpot     |-> defaultSettlementPeriodSpot.value,
         defaultSettlementPeriodAuction  |-> defaultSettlementPeriodAuction.value,
         competitorPeriod                |-> competitorPeriod.value,
         solicitorPeriod                 |-> solicitorPeriod.value,
         warningPercent                  |-> warningPercent.value,
         volumeFreezePercent             |-> volumeFreezePercent.value,
         snapQuoteTime                   |-> snapQuoteTime.value,
         reserved2                       |-> reserved2.value,
         boardLotQuantity                |-> boardLotQuantity.value,
         tickSize                        |-> tickSize.value,
         maximumGtcDays                  |-> maximumGtcDays.value,
         stStockEligibleIndicators       |-> stStockEligibleIndicators.value,
         disclosedQuantityPercentAllowed |-> disclosedQuantityPercentAllowed.value,
         riskFreeInterestRate            |-> riskFreeInterestRate.value ], riskFreeInterestRate.rest)

ZeroPartialSystemInformationMessage ==
    [ stMarketStatus                  |-> ZeroStMarketStatus2,
      stExMarketStatus                |-> ZeroStExMarketStatus2,
      stPlMarketStatus                |-> ZeroStPlMarketStatus2,
      updatePortfolio                 |-> [i \in 1 .. 1 |-> 0],
      cFiller                         |-> [i \in 1 .. 1 |-> 0],
      marketIndex                     |-> [i \in 1 .. 4 |-> 0],
      defaultSettlementPeriodNormal   |-> [i \in 1 .. 2 |-> 0],
      defaultSettlementPeriodSpot     |-> [i \in 1 .. 2 |-> 0],
      defaultSettlementPeriodAuction  |-> [i \in 1 .. 2 |-> 0],
      competitorPeriod                |-> [i \in 1 .. 2 |-> 0],
      solicitorPeriod                 |-> [i \in 1 .. 2 |-> 0],
      warningPercent                  |-> [i \in 1 .. 2 |-> 0],
      volumeFreezePercent             |-> [i \in 1 .. 2 |-> 0],
      snapQuoteTime                   |-> [i \in 1 .. 2 |-> 0],
      reserved2                       |-> [i \in 1 .. 2 |-> 0],
      boardLotQuantity                |-> [i \in 1 .. 4 |-> 0],
      tickSize                        |-> [i \in 1 .. 4 |-> 0],
      maximumGtcDays                  |-> [i \in 1 .. 2 |-> 0],
      stStockEligibleIndicators       |-> [i \in 1 .. 2 |-> 0],
      disclosedQuantityPercentAllowed |-> [i \in 1 .. 2 |-> 0],
      riskFreeInterestRate            |-> [i \in 1 .. 4 |-> 0] ]

(* Partial System Information Message at zero, then each field in turn at the values it is checked at *)
CheckedPartialSystemInformationMessage ==
    { ZeroPartialSystemInformationMessage }
        \cup { [ZeroPartialSystemInformationMessage EXCEPT !.stMarketStatus = one] : one \in CheckedStMarketStatus2 }
        \cup { [ZeroPartialSystemInformationMessage EXCEPT !.stExMarketStatus = one] : one \in CheckedStExMarketStatus2 }
        \cup { [ZeroPartialSystemInformationMessage EXCEPT !.stPlMarketStatus = one] : one \in CheckedStPlMarketStatus2 }
        \cup { [ZeroPartialSystemInformationMessage EXCEPT !.updatePortfolio = one] : one \in Sample(1) }
        \cup { [ZeroPartialSystemInformationMessage EXCEPT !.cFiller = one] : one \in Sample(1) }
        \cup { [ZeroPartialSystemInformationMessage EXCEPT !.marketIndex = one] : one \in Sample(4) }
        \cup { [ZeroPartialSystemInformationMessage EXCEPT !.defaultSettlementPeriodNormal = one] : one \in Sample(2) }
        \cup { [ZeroPartialSystemInformationMessage EXCEPT !.defaultSettlementPeriodSpot = one] : one \in Sample(2) }
        \cup { [ZeroPartialSystemInformationMessage EXCEPT !.defaultSettlementPeriodAuction = one] : one \in Sample(2) }
        \cup { [ZeroPartialSystemInformationMessage EXCEPT !.competitorPeriod = one] : one \in Sample(2) }
        \cup { [ZeroPartialSystemInformationMessage EXCEPT !.solicitorPeriod = one] : one \in Sample(2) }
        \cup { [ZeroPartialSystemInformationMessage EXCEPT !.warningPercent = one] : one \in Sample(2) }
        \cup { [ZeroPartialSystemInformationMessage EXCEPT !.volumeFreezePercent = one] : one \in Sample(2) }
        \cup { [ZeroPartialSystemInformationMessage EXCEPT !.snapQuoteTime = one] : one \in Sample(2) }
        \cup { [ZeroPartialSystemInformationMessage EXCEPT !.reserved2 = one] : one \in Sample(2) }
        \cup { [ZeroPartialSystemInformationMessage EXCEPT !.boardLotQuantity = one] : one \in Sample(4) }
        \cup { [ZeroPartialSystemInformationMessage EXCEPT !.tickSize = one] : one \in Sample(4) }
        \cup { [ZeroPartialSystemInformationMessage EXCEPT !.maximumGtcDays = one] : one \in Sample(2) }
        \cup { [ZeroPartialSystemInformationMessage EXCEPT !.stStockEligibleIndicators = one] : one \in Sample(2) }
        \cup { [ZeroPartialSystemInformationMessage EXCEPT !.disclosedQuantityPercentAllowed = one] : one \in Sample(2) }
        \cup { [ZeroPartialSystemInformationMessage EXCEPT !.riskFreeInterestRate = one] : one \in Sample(4) }

(***************************************************************************)
(* Open Order Report Message: 68 bytes                                     *)
(***************************************************************************)

OpenOrderReportMessage ==
    [ messageType  : Sample(1),
      reportDate   : Sample(4),
      userType     : Sample(2),
      brokerId     : Sample(5),
      firmName     : Sample(25),
      traderNumber : Sample(4),
      traderName   : Sample(26),
      reserved1    : Sample(1) ]

EncodeOpenOrderReportMessage(message) ==
    message.messageType
        \o message.reportDate
        \o message.userType
        \o message.brokerId
        \o message.firmName
        \o message.traderNumber
        \o message.traderName
        \o message.reserved1

DecodeOpenOrderReportMessage(bytes) ==
    LET messageType == ReadBytes(bytes, 1) IN IF ~messageType.ok THEN Fail ELSE
    LET reportDate == ReadBytes(messageType.rest, 4) IN IF ~reportDate.ok THEN Fail ELSE
    LET userType == ReadBytes(reportDate.rest, 2) IN IF ~userType.ok THEN Fail ELSE
    LET brokerId == ReadBytes(userType.rest, 5) IN IF ~brokerId.ok THEN Fail ELSE
    LET firmName == ReadBytes(brokerId.rest, 25) IN IF ~firmName.ok THEN Fail ELSE
    LET traderNumber == ReadBytes(firmName.rest, 4) IN IF ~traderNumber.ok THEN Fail ELSE
    LET traderName == ReadBytes(traderNumber.rest, 26) IN IF ~traderName.ok THEN Fail ELSE
    LET reserved1 == ReadBytes(traderName.rest, 1) IN IF ~reserved1.ok THEN Fail ELSE
    Ok([ messageType  |-> messageType.value,
         reportDate   |-> reportDate.value,
         userType     |-> userType.value,
         brokerId     |-> brokerId.value,
         firmName     |-> firmName.value,
         traderNumber |-> traderNumber.value,
         traderName   |-> traderName.value,
         reserved1    |-> reserved1.value ], reserved1.rest)

ZeroOpenOrderReportMessage ==
    [ messageType  |-> [i \in 1 .. 1 |-> 0],
      reportDate   |-> [i \in 1 .. 4 |-> 0],
      userType     |-> [i \in 1 .. 2 |-> 0],
      brokerId     |-> [i \in 1 .. 5 |-> 0],
      firmName     |-> [i \in 1 .. 25 |-> 0],
      traderNumber |-> [i \in 1 .. 4 |-> 0],
      traderName   |-> [i \in 1 .. 26 |-> 0],
      reserved1    |-> [i \in 1 .. 1 |-> 0] ]

(* Open Order Report Message at zero, then each field in turn at the values it is checked at *)
CheckedOpenOrderReportMessage ==
    { ZeroOpenOrderReportMessage }
        \cup { [ZeroOpenOrderReportMessage EXCEPT !.messageType = one] : one \in Sample(1) }
        \cup { [ZeroOpenOrderReportMessage EXCEPT !.reportDate = one] : one \in Sample(4) }
        \cup { [ZeroOpenOrderReportMessage EXCEPT !.userType = one] : one \in Sample(2) }
        \cup { [ZeroOpenOrderReportMessage EXCEPT !.brokerId = one] : one \in Sample(5) }
        \cup { [ZeroOpenOrderReportMessage EXCEPT !.firmName = one] : one \in Sample(25) }
        \cup { [ZeroOpenOrderReportMessage EXCEPT !.traderNumber = one] : one \in Sample(4) }
        \cup { [ZeroOpenOrderReportMessage EXCEPT !.traderName = one] : one \in Sample(26) }
        \cup { [ZeroOpenOrderReportMessage EXCEPT !.reserved1 = one] : one \in Sample(1) }

