      oddlot  |-> [i \in 1 .. 2 |-> 0],
      spot    |-> [i \in 1 .. 2 |-> 0],
      auction |-> [i \in 1 .. 2 |-> 0] ]

(* St Pl Market Status at zero, then each field in turn at the values it is checked at *)
CheckedStPlMarketStatus ==
    { ZeroStPlMarketStatus }
        \cup { [ZeroStPlMarketStatus EXCEPT !.normal = one] : one \in Sample(2) }
        \cup { [ZeroStPlMarketStatus EXCEPT !.oddlot = one] : one \in Sample(2) }
        \cup { [ZeroStPlMarketStatus EXCEPT !.spot = one] : one \in Sample(2) }
        \cup { [ZeroStPlMarketStatus EXCEPT !.auction = one] : one \in Sample(2) }

(***************************************************************************)
(* System Information Out Message: 66 bytes                                *)
(***************************************************************************)

SystemInformationOutMessage ==
    [ stMarketStatus                  : StMarketStatus,
      stExMarketStatus                : StExMarketStatus,
      stPlMarketStatus                : StPlMarketStatus,
      updatePortfolio                 : Sample(1),
      cFiller                         : Sample(1),
      marketIndex                     : Sample(4),
      defaultSettlementPeriodNormal   : Sample(2),
      defaultSettlementPeriodSpot     : Sample(2),
      defaultSettlementPeriodAuction  : Sample(2),
      competitorPeriod                : Sample(2),
      solicitorPeriod                 : Sample(2),
      warningPercent                  : Sample(2),
      volumeFreezePercent             : Sample(2),
      snapQuoteTime                   : Sample(2),
      reserved2                       : Sample(2),
      boardLotQuantity                : Sample(4),
      tickSize                        : Sample(4),
      maximumGtcDays                  : Sample(2),
      stStockEligibleIndicators       : Sample(2),
      disclosedQuantityPercentAllowed : Sample(2),
      riskFreeInterestRate            : Sample(4) ]

EncodeSystemInformationOutMessage(message) ==
    EncodeStMarketStatus(message.stMarketStatus)
        \o EncodeStExMarketStatus(message.stExMarketStatus)
        \o EncodeStPlMarketStatus(message.stPlMarketStatus)
        \o message.updatePortfolio
        \o message.cFiller
        \o message.marketIndex
        \o message.defaultSettlementPeriodNormal
        \o message.defaultSettlementPeriodSpot
        \o message.defaultSettlementPeriodAuction
        \o message.competitorPeriod
        \o message.solicitorPeriod
        \o message.warningPercent
        \o message.volumeFreezePercent
        \o message.snapQuoteTime
        \o message.reserved2
        \o message.boardLotQuantity
        \o message.tickSize
        \o message.maximumGtcDays
        \o message.stStockEligibleIndicators
        \o message.disclosedQuantityPercentAllowed
        \o message.riskFreeInterestRate

DecodeSystemInformationOutMessage(bytes) ==
    LET stMarketStatus == DecodeStMarketStatus(bytes) IN IF ~stMarketStatus.ok THEN Fail ELSE
    LET stExMarketStatus == DecodeStExMarketStatus(stMarketStatus.rest) IN IF ~stExMarketStatus.ok THEN Fail ELSE
    LET stPlMarketStatus == DecodeStPlMarketStatus(stExMarketStatus.rest) IN IF ~stPlMarketStatus.ok THEN Fail ELSE
    LET updatePortfolio == ReadBytes(stPlMarketStatus.rest, 1) IN IF ~updatePortfolio.ok THEN Fail ELSE
    LET cFiller == ReadBytes(updatePortfolio.rest, 1) IN IF ~cFiller.ok THEN Fail ELSE
    LET marketIndex == ReadBytes(cFiller.rest, 4) IN IF ~marketIndex.ok THEN Fail ELSE
    LET defaultSettlementPeriodNormal == ReadBytes(marketIndex.rest, 2) IN IF ~defaultSettlementPeriodNormal.ok THEN Fail ELSE
    LET defaultSettlementPeriodSpot == ReadBytes(defaultSettlementPeriodNormal.rest, 2) IN IF ~defaultSettlementPeriodSpot.ok THEN Fail ELSE
    LET defaultSettlementPeriodAuction == ReadBytes(defaultSettlementPeriodSpot.rest, 2) IN IF ~defaultSettlementPeriodAuction.ok THEN Fail ELSE
    LET competitorPeriod == ReadBytes(defaultSettlementPeriodAuction.rest, 2) IN IF ~competitorPeriod.ok THEN Fail ELSE
    LET solicitorPeriod == ReadBytes(competitorPeriod.rest, 2) IN IF ~solicitorPeriod.ok THEN Fail ELSE
    LET warningPercent == ReadBytes(solicitorPeriod.rest, 2) IN IF ~warningPercent.ok THEN Fail ELSE
    LET volumeFreezePercent == ReadBytes(warningPercent.rest, 2) IN IF ~volumeFreezePercent.ok THEN Fail ELSE
    LET snapQuoteTime == ReadBytes(volumeFreezePercent.rest, 2) IN IF ~snapQuoteTime.ok THEN Fail ELSE
    LET reserved2 == ReadBytes(snapQuoteTime.rest, 2) IN IF ~reserved2.ok THEN Fail ELSE
    LET boardLotQuantity == ReadBytes(reserved2.rest, 4) IN IF ~boardLotQuantity.ok THEN Fail ELSE
    LET tickSize == ReadBytes(boardLotQuantity.rest, 4) IN IF ~tickSize.ok THEN Fail ELSE
    LET maximumGtcDays == ReadBytes(tickSize.rest, 2) IN IF ~maximumGtcDays.ok THEN Fail ELSE
    LET stStockEligibleIndicators == ReadBytes(maximumGtcDays.rest, 2) IN IF ~stStockEligibleIndicators.ok THEN Fail ELSE
    LET disclosedQuantityPercentAllowed == ReadBytes(stStockEligibleIndicators.rest, 2) IN IF ~disclosedQuantityPercentAllowed.ok THEN Fail ELSE
    LET riskFreeInterestRate == ReadBytes(disclosedQuantityPercentAllowed.rest, 4) IN IF ~riskFreeInterestRate.ok THEN Fail ELSE
    Ok([ stMarketStatus                  |-> stMarketStatus.value,
         stExMarketStatus                |-> stExMarketStatus.value,
         stPlMarketStatus                |-> stPlMarketStatus.value,
         updatePortfolio                 |-> updatePortfolio.value,
         cFiller                         |-> cFiller.value,
         marketIndex                     |-> marketIndex.value,
         defaultSettlementPeriodNormal   |-> defaultSettlementPeriodNormal.value,
         defaultSettlementPeriodSpot     |-> defaultSettlementPeriodSpot.value,
         defaultSettlementPeriodAuction  |-> defaultSettlementPeriodAuction.value,
         competitorPeriod                |-> competitorPeriod.value,
         solicitorPeriod                 |-> solicitorPeriod.value,
         warningPercent                  |-> warningPercent.value,
         volumeFreezePercent             |-> volumeFreezePercent.value,
         snapQuoteTime                   |-> snapQuoteTime.value,
         reserved2                       |-> reserved2.value,
         boardLotQuantity                |-> boardLotQuantity.value,
         tickSize                        |-> tickSize.value,
         maximumGtcDays                  |-> maximumGtcDays.value,
         stStockEligibleIndicators       |-> stStockEligibleIndicators.value,
         disclosedQuantityPercentAllowed |-> disclosedQuantityPercentAllowed.value,
         riskFreeInterestRate            |-> riskFreeInterestRate.value ], riskFreeInterestRate.rest)

ZeroSystemInformationOutMessage ==
    [ stMarketStatus                  |-> ZeroStMarketStatus,
      stExMarketStatus                |-> ZeroStExMarketStatus,
      stPlMarketStatus                |-> ZeroStPlMarketStatus,
      updatePortfolio                 |-> [i \in 1 .. 1 |-> 0],
      cFiller                         |-> [i \in 1 .. 1 |-> 0],
      marketIndex                     |-> [i \in 1 .. 4 |-> 0],
      defaultSettlementPeriodNormal   |-> [i \in 1 .. 2 |-> 0],
      defaultSettlementPeriodSpot     |-> [i \in 1 .. 2 |-> 0],
      defaultSettlementPeriodAuction  |-> [i \in 1 .. 2 |-> 0],
      competitorPeriod                |-> [i \in 1 .. 2 |-> 0],
      solicitorPeriod                 |-> [i \in 1 .. 2 |-> 0],
      warningPercent                  |-> [i \in 1 .. 2 |-> 0],
      volumeFreezePercent             |-> [i \in 1 .. 2 |-> 0],
      snapQuoteTime                   |-> [i \in 1 .. 2 |-> 0],
      reserved2                       |-> [i \in 1 .. 2 |-> 0],
      boardLotQuantity                |-> [i \in 1 .. 4 |-> 0],
      tickSize                        |-> [i \in 1 .. 4 |-> 0],
      maximumGtcDays                  |-> [i \in 1 .. 2 |-> 0],
      stStockEligibleIndicators       |-> [i \in 1 .. 2 |-> 0],
      disclosedQuantityPercentAllowed |-> [i \in 1 .. 2 |-> 0],
      riskFreeInterestRate            |-> [i \in 1 .. 4 |-> 0] ]

(* System Information Out Message at zero, then each field in turn at the values it is checked at *)
CheckedSystemInformationOutMessage ==
    { ZeroSystemInformationOutMessage }
        \cup { [ZeroSystemInformationOutMessage EXCEPT !.stMarketStatus = one] : one \in CheckedStMarketStatus }
        \cup { [ZeroSystemInformationOutMessage EXCEPT !.stExMarketStatus = one] : one \in CheckedStExMarketStatus }
        \cup { [ZeroSystemInformationOutMessage EXCEPT !.stPlMarketStatus = one] : one \in CheckedStPlMarketStatus }
        \cup { [ZeroSystemInformationOutMessage EXCEPT !.updatePortfolio = one] : one \in Sample(1) }
        \cup { [ZeroSystemInformationOutMessage EXCEPT !.cFiller = one] : one \in Sample(1) }
        \cup { [ZeroSystemInformationOutMessage EXCEPT !.marketIndex = one] : one \in Sample(4) }
        \cup { [ZeroSystemInformationOutMessage EXCEPT !.defaultSettlementPeriodNormal = one] : one \in Sample(2) }
        \cup { [ZeroSystemInformationOutMessage EXCEPT !.defaultSettlementPeriodSpot = one] : one \in Sample(2) }
        \cup { [ZeroSystemInformationOutMessage EXCEPT !.defaultSettlementPeriodAuction = one] : one \in Sample(2) }
        \cup { [ZeroSystemInformationOutMessage EXCEPT !.competitorPeriod = one] : one \in Sample(2) }
        \cup { [ZeroSystemInformationOutMessage EXCEPT !.solicitorPeriod = one] : one \in Sample(2) }
        \cup { [ZeroSystemInformationOutMessage EXCEPT !.warningPercent = one] : one \in Sample(2) }
        \cup { [ZeroSystemInformationOutMessage EXCEPT !.volumeFreezePercent = one] : one \in Sample(2) }
        \cup { [ZeroSystemInformationOutMessage EXCEPT !.snapQuoteTime = one] : one \in Sample(2) }
        \cup { [ZeroSystemInformationOutMessage EXCEPT !.reserved2 = one] : one \in Sample(2) }
        \cup { [ZeroSystemInformationOutMessage EXCEPT !.boardLotQuantity = one] : one \in Sample(4) }
        \cup { [ZeroSystemInformationOutMessage EXCEPT !.tickSize = one] : one \in Sample(4) }
        \cup { [ZeroSystemInformationOutMessage EXCEPT !.maximumGtcDays = one] : one \in Sample(2) }
        \cup { [ZeroSystemInformationOutMessage EXCEPT !.stStockEligibleIndicators = one] : one \in Sample(2) }
        \cup { [ZeroSystemInformationOutMessage EXCEPT !.disclosedQuantityPercentAllowed = one] : one \in Sample(2) }
        \cup { [ZeroSystemInformationOutMessage EXCEPT !.riskFreeInterestRate = one] : one \in Sample(4) }

(***************************************************************************)
(* St Market Status: 8 bytes                                               *)
(***************************************************************************)

StMarketStatus2 ==
    [ normal  : Sample(2),
      oddlot  : Sample(2),
      spot    : Sample(2),
      auction : Sample(2) ]

EncodeStMarketStatus2(message) ==
    message.normal
        \o message.oddlot
        \o message.spot
        \o message.auction

DecodeStMarketStatus2(bytes) ==
    LET normal == ReadBytes(bytes, 2) IN IF ~normal.ok THEN Fail ELSE
    LET oddlot == ReadBytes(normal.rest, 2) IN IF ~oddlot.ok THEN Fail ELSE
    LET spot == ReadBytes(oddlot.rest, 2) IN IF ~spot.ok THEN Fail ELSE
    LET auction == ReadBytes(spot.rest, 2) IN IF ~auction.ok THEN Fail ELSE
    Ok([ normal  |-> normal.value,
         oddlot  |-> oddlot.value,
         spot    |-> spot.value,
         auction |-> auction.value ], auction.rest)

ZeroStMarketStatus2 ==
    [ normal  |-> [i \in 1 .. 2 |-> 0],
      oddlot  |-> [i \in 1 .. 2 |-> 0],
      spot    |-> [i \in 1 .. 2 |-> 0],
      auction |-> [i \in 1 .. 2 |-> 0] ]

(* St Market Status at zero, then each field in turn at the values it is checked at *)
CheckedStMarketStatus2 ==
    { ZeroStMarketStatus2 }
        \cup { [ZeroStMarketStatus2 EXCEPT !.normal = one] : one \in Sample(2) }
        \cup { [ZeroStMarketStatus2 EXCEPT !.oddlot = one] : one \in Sample(2) }
        \cup { [ZeroStMarketStatus2 EXCEPT !.spot = one] : one \in Sample(2) }
        \cup { [ZeroStMarketStatus2 EXCEPT !.auction = one] : one \in Sample(2) }

