        \cup { [ZeroCancelNegOrderMessage EXCEPT !.triggerPrice = one] : one \in Sample(4) }
        \cup { [ZeroCancelNegOrderMessage EXCEPT !.goodTillDate = one] : one \in Sample(4) }
        \cup { [ZeroCancelNegOrderMessage EXCEPT !.entryDateTime = one] : one \in Sample(4) }
        \cup { [ZeroCancelNegOrderMessage EXCEPT !.minimumFillAonVolume = one] : one \in Sample(4) }
        \cup { [ZeroCancelNegOrderMessage EXCEPT !.lastModified = one] : one \in Sample(4) }
        \cup { [ZeroCancelNegOrderMessage EXCEPT !.stOrderFlags = one] : one \in Sample(2) }
