        \cup { [ZeroMsSpdLegInfoLeg313 EXCEPT !.token2 = one] : one \in Sample(4) }
        \cup { [ZeroMsSpdLegInfoLeg313 EXCEPT !.contractDesc = one] : one \in CheckedContractDesc52 }
        \cup { [ZeroMsSpdLegInfoLeg313 EXCEPT !.opBrokerId2 = one] : one \in Sample(5) }
