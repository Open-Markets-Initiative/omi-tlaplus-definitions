        \cup { [ZeroOrderModRejectMessage EXCEPT !.lastModified = one] : one \in Sample(4) }
        \cup { [ZeroOrderModRejectMessage EXCEPT !.stOrderFlags = one] : one \in Sample(2) }
        \cup { [ZeroOrderModRejectMessage EXCEPT !.branchId = one] : one \in Sample(2) }
        \cup { [ZeroOrderModRejectMessage EXCEPT !.traderId = one] : one \in Sample(4) }
        \cup { [ZeroOrderModRejectMessage EXCEPT !.brokerId = one] : one \in Sample(5) }
        \cup { [ZeroOrderModRejectMessage EXCEPT !.cOrdFiller = one] : one \in Sample(24) }
        \cup { [ZeroOrderModRejectMessage EXCEPT !.openClose = one] : one \in Sample(1) }
        \cup { [ZeroOrderModRejectMessage EXCEPT !.settlor = one] : one \in Sample(12) }
