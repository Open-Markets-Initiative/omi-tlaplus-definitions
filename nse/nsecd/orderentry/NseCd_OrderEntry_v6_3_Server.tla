        \cup { [ZeroCancelNegOrderMessage EXCEPT !.participantType = one] : one \in Sample(1) }
        \cup { [ZeroCancelNegOrderMessage EXCEPT !.reserved1 = one] : one \in Sample(1) }
        \cup { [ZeroCancelNegOrderMessage EXCEPT !.competitorPeriod = one] : one \in Sample(2) }
