(***************************************************************************)
(* Error Response Out Message: 142 bytes                                   *)
(***************************************************************************)

ErrorResponseOutMessage ==
    [ key          : Sample(14),
      errorMessage : Sample(128) ]

EncodeErrorResponseOutMessage(message) ==
    message.key
        \o message.errorMessage

DecodeErrorResponseOutMessage(bytes) ==
    LET key == ReadBytes(bytes, 14) IN IF ~key.ok THEN Fail ELSE
    LET errorMessage == ReadBytes(key.rest, 128) IN IF ~errorMessage.ok THEN Fail ELSE
    Ok([ key          |-> key.value,
         errorMessage |-> errorMessage.value ], errorMessage.rest)

ZeroErrorResponseOutMessage ==
    [ key          |-> [i \in 1 .. 14 |-> 0],
      errorMessage |-> [i \in 1 .. 128 |-> 0] ]

(* Error Response Out Message at zero, then each field in turn at the values it is checked at *)
CheckedErrorResponseOutMessage ==
    { ZeroErrorResponseOutMessage }
        \cup { [ZeroErrorResponseOutMessage EXCEPT !.key = one] : one \in Sample(14) }
        \cup { [ZeroErrorResponseOutMessage EXCEPT !.errorMessage = one] : one \in Sample(128) }

(***************************************************************************)
(* Gr Response Message: 84 bytes                                           *)
(***************************************************************************)

GrResponseMessage ==
    [ boxId            : Sample(2),
      brokerId         : Sample(5),
      filler           : Sample(1),
      ipAddress        : Sample(16),
      port             : Sample(4),
      sessionKey       : Sample(8),
      cryptographicKey : Sample(32),
      cryptographicIv  : Sample(16) ]

EncodeGrResponseMessage(message) ==
    message.boxId
        \o message.brokerId
        \o message.filler
        \o message.ipAddress
        \o message.port
        \o message.sessionKey
        \o message.cryptographicKey
        \o message.cryptographicIv

DecodeGrResponseMessage(bytes) ==
    LET boxId == ReadBytes(bytes, 2) IN IF ~boxId.ok THEN Fail ELSE
    LET brokerId == ReadBytes(boxId.rest, 5) IN IF ~brokerId.ok THEN Fail ELSE
    LET filler == ReadBytes(brokerId.rest, 1) IN IF ~filler.ok THEN Fail ELSE
    LET ipAddress == ReadBytes(filler.rest, 16) IN IF ~ipAddress.ok THEN Fail ELSE
    LET port == ReadBytes(ipAddress.rest, 4) IN IF ~port.ok THEN Fail ELSE
    LET sessionKey == ReadBytes(port.rest, 8) IN IF ~sessionKey.ok THEN Fail ELSE
    LET cryptographicKey == ReadBytes(sessionKey.rest, 32) IN IF ~cryptographicKey.ok THEN Fail ELSE
    LET cryptographicIv == ReadBytes(cryptographicKey.rest, 16) IN IF ~cryptographicIv.ok THEN Fail ELSE
    Ok([ boxId            |-> boxId.value,
         brokerId         |-> brokerId.value,
         filler           |-> filler.value,
         ipAddress        |-> ipAddress.value,
         port             |-> port.value,
         sessionKey       |-> sessionKey.value,
         cryptographicKey |-> cryptographicKey.value,
         cryptographicIv  |-> cryptographicIv.value ], cryptographicIv.rest)

ZeroGrResponseMessage ==
    [ boxId            |-> [i \in 1 .. 2 |-> 0],
      brokerId         |-> [i \in 1 .. 5 |-> 0],
      filler           |-> [i \in 1 .. 1 |-> 0],
      ipAddress        |-> [i \in 1 .. 16 |-> 0],
      port             |-> [i \in 1 .. 4 |-> 0],
      sessionKey       |-> [i \in 1 .. 8 |-> 0],
      cryptographicKey |-> [i \in 1 .. 32 |-> 0],
      cryptographicIv  |-> [i \in 1 .. 16 |-> 0] ]

(* Gr Response Message at zero, then each field in turn at the values it is checked at *)
CheckedGrResponseMessage ==
    { ZeroGrResponseMessage }
        \cup { [ZeroGrResponseMessage EXCEPT !.boxId = one] : one \in Sample(2) }
        \cup { [ZeroGrResponseMessage EXCEPT !.brokerId = one] : one \in Sample(5) }
        \cup { [ZeroGrResponseMessage EXCEPT !.filler = one] : one \in Sample(1) }
        \cup { [ZeroGrResponseMessage EXCEPT !.ipAddress = one] : one \in Sample(16) }
        \cup { [ZeroGrResponseMessage EXCEPT !.port = one] : one \in Sample(4) }
        \cup { [ZeroGrResponseMessage EXCEPT !.sessionKey = one] : one \in Sample(8) }
        \cup { [ZeroGrResponseMessage EXCEPT !.cryptographicKey = one] : one \in Sample(32) }
        \cup { [ZeroGrResponseMessage EXCEPT !.cryptographicIv = one] : one \in Sample(16) }

(***************************************************************************)
(* Giveup: 79 bytes                                                        *)
(***************************************************************************)

Giveup ==
    [ orderNumber          : Sample(8),
      fillNumber           : Sample(4),
      instrumentName       : Sample(6),
      symbol               : Sample(10),
      expiryDate           : Sample(4),
      strikePrice          : Sample(4),
      optionType           : Sample(2),
      caLevel              : Sample(2),
      fillVolume           : Sample(4),
      fillPrice            : Sample(4),
      brokerId             : Sample(5),
      filler               : Sample(1),
      buySell              : Sample(2),
      bookTypeShort2       : Sample(2),
      lastModifiedDateTime : Sample(4),
      initiatedByControl   : Sample(1),
      openClose            : Sample(1),
      reserved1            : Sample(1),
      participant          : Sample(12),
      giveupFlag           : Sample(1),
      deleted              : Sample(1) ]

EncodeGiveup(message) ==
    message.orderNumber
        \o message.fillNumber
        \o message.instrumentName
        \o message.symbol
        \o message.expiryDate
        \o message.strikePrice
        \o message.optionType
        \o message.caLevel
        \o message.fillVolume
        \o message.fillPrice
        \o message.brokerId
        \o message.filler
        \o message.buySell
        \o message.bookTypeShort2
        \o message.lastModifiedDateTime
        \o message.initiatedByControl
        \o message.openClose
        \o message.reserved1
        \o message.participant
        \o message.giveupFlag
        \o message.deleted

DecodeGiveup(bytes) ==
    LET orderNumber == ReadBytes(bytes, 8) IN IF ~orderNumber.ok THEN Fail ELSE
    LET fillNumber == ReadBytes(orderNumber.rest, 4) IN IF ~fillNumber.ok THEN Fail ELSE
    LET instrumentName == ReadBytes(fillNumber.rest, 6) IN IF ~instrumentName.ok THEN Fail ELSE
    LET symbol == ReadBytes(instrumentName.rest, 10) IN IF ~symbol.ok THEN Fail ELSE
    LET expiryDate == ReadBytes(symbol.rest, 4) IN IF ~expiryDate.ok THEN Fail ELSE
    LET strikePrice == ReadBytes(expiryDate.rest, 4) IN IF ~strikePrice.ok THEN Fail ELSE
    LET optionType == ReadBytes(strikePrice.rest, 2) IN IF ~optionType.ok THEN Fail ELSE
    LET caLevel == ReadBytes(optionType.rest, 2) IN IF ~caLevel.ok THEN Fail ELSE
    LET fillVolume == ReadBytes(caLevel.rest, 4) IN IF ~fillVolume.ok THEN Fail ELSE
    LET fillPrice == ReadBytes(fillVolume.rest, 4) IN IF ~fillPrice.ok THEN Fail ELSE
    LET brokerId == ReadBytes(fillPrice.rest, 5) IN IF ~brokerId.ok THEN Fail ELSE
    LET filler == ReadBytes(brokerId.rest, 1) IN IF ~filler.ok THEN Fail ELSE
    LET buySell == ReadBytes(filler.rest, 2) IN IF ~buySell.ok THEN Fail ELSE
    LET bookTypeShort2 == ReadBytes(buySell.rest, 2) IN IF ~bookTypeShort2.ok THEN Fail ELSE
    LET lastModifiedDateTime == ReadBytes(bookTypeShort2.rest, 4) IN IF ~lastModifiedDateTime.ok THEN Fail ELSE
    LET initiatedByControl == ReadBytes(lastModifiedDateTime.rest, 1) IN IF ~initiatedByControl.ok THEN Fail ELSE
    LET openClose == ReadBytes(initiatedByControl.rest, 1) IN IF ~openClose.ok THEN Fail ELSE
    LET reserved1 == ReadBytes(openClose.rest, 1) IN IF ~reserved1.ok THEN Fail ELSE
    LET participant == ReadBytes(reserved1.rest, 12) IN IF ~participant.ok THEN Fail ELSE
    LET giveupFlag == ReadBytes(participant.rest, 1) IN IF ~giveupFlag.ok THEN Fail ELSE
    LET deleted == ReadBytes(giveupFlag.rest, 1) IN IF ~deleted.ok THEN Fail ELSE
    Ok([ orderNumber          |-> orderNumber.value,
         fillNumber           |-> fillNumber.value,
         instrumentName       |-> instrumentName.value,
         symbol               |-> symbol.value,
         expiryDate           |-> expiryDate.value,
         strikePrice          |-> strikePrice.value,
         optionType           |-> optionType.value,
         caLevel              |-> caLevel.value,
         fillVolume           |-> fillVolume.value,
         fillPrice            |-> fillPrice.value,
         brokerId             |-> brokerId.value,
         filler               |-> filler.value,
         buySell              |-> buySell.value,
         bookTypeShort2       |-> bookTypeShort2.value,
         lastModifiedDateTime |-> lastModifiedDateTime.value,
         initiatedByControl   |-> initiatedByControl.value,
         openClose            |-> openClose.value,
         reserved1            |-> reserved1.value,
         participant          |-> participant.value,
         giveupFlag           |-> giveupFlag.value,
         deleted              |-> deleted.value ], deleted.rest)

ZeroGiveup ==
    [ orderNumber          |-> [i \in 1 .. 8 |-> 0],
      fillNumber           |-> [i \in 1 .. 4 |-> 0],
      instrumentName       |-> [i \in 1 .. 6 |-> 0],
      symbol               |-> [i \in 1 .. 10 |-> 0],
      expiryDate           |-> [i \in 1 .. 4 |-> 0],
      strikePrice          |-> [i \in 1 .. 4 |-> 0],
      optionType           |-> [i \in 1 .. 2 |-> 0],
      caLevel              |-> [i \in 1 .. 2 |-> 0],
      fillVolume           |-> [i \in 1 .. 4 |-> 0],
      fillPrice            |-> [i \in 1 .. 4 |-> 0],
      brokerId             |-> [i \in 1 .. 5 |-> 0],
      filler               |-> [i \in 1 .. 1 |-> 0],
      buySell              |-> [i \in 1 .. 2 |-> 0],
      bookTypeShort2       |-> [i \in 1 .. 2 |-> 0],
      lastModifiedDateTime |-> [i \in 1 .. 4 |-> 0],
      initiatedByControl   |-> [i \in 1 .. 1 |-> 0],
      openClose            |-> [i \in 1 .. 1 |-> 0],
      reserved1            |-> [i \in 1 .. 1 |-> 0],
      participant          |-> [i \in 1 .. 12 |-> 0],
      giveupFlag           |-> [i \in 1 .. 1 |-> 0],
      deleted              |-> [i \in 1 .. 1 |-> 0] ]

(* Giveup at zero, then each field in turn at the values it is checked at *)
CheckedGiveup ==
    { ZeroGiveup }
        \cup { [ZeroGiveup EXCEPT !.orderNumber = one] : one \in Sample(8) }
        \cup { [ZeroGiveup EXCEPT !.fillNumber = one] : one \in Sample(4) }
        \cup { [ZeroGiveup EXCEPT !.instrumentName = one] : one \in Sample(6) }
        \cup { [ZeroGiveup EXCEPT !.symbol = one] : one \in Sample(10) }
        \cup { [ZeroGiveup EXCEPT !.expiryDate = one] : one \in Sample(4) }
        \cup { [ZeroGiveup EXCEPT !.strikePrice = one] : one \in Sample(4) }
        \cup { [ZeroGiveup EXCEPT !.optionType = one] : one \in Sample(2) }
        \cup { [ZeroGiveup EXCEPT !.caLevel = one] : one \in Sample(2) }
        \cup { [ZeroGiveup EXCEPT !.fillVolume = one] : one \in Sample(4) }
        \cup { [ZeroGiveup EXCEPT !.fillPrice = one] : one \in Sample(4) }
        \cup { [ZeroGiveup EXCEPT !.brokerId = one] : one \in Sample(5) }
        \cup { [ZeroGiveup EXCEPT !.filler = one] : one \in Sample(1) }
        \cup { [ZeroGiveup EXCEPT !.buySell = one] : one \in Sample(2) }
        \cup { [ZeroGiveup EXCEPT !.bookTypeShort2 = one] : one \in Sample(2) }
        \cup { [ZeroGiveup EXCEPT !.lastModifiedDateTime = one] : one \in Sample(4) }
        \cup { [ZeroGiveup EXCEPT !.initiatedByControl = one] : one \in Sample(1) }
        \cup { [ZeroGiveup EXCEPT !.openClose = one] : one \in Sample(1) }
        \cup { [ZeroGiveup EXCEPT !.reserved1 = one] : one \in Sample(1) }
        \cup { [ZeroGiveup EXCEPT !.participant = one] : one \in Sample(12) }
        \cup { [ZeroGiveup EXCEPT !.giveupFlag = one] : one \in Sample(1) }
        \cup { [ZeroGiveup EXCEPT !.deleted = one] : one \in Sample(1) }

(***************************************************************************)
(* Giveup App Confirm Tm Message: 82 bytes                                 *)
(***************************************************************************)

GiveupAppConfirmTmMessage ==
    [ reasonCode : Sample(2),
      giveup     : Giveup,
      reserved1  : Sample(1) ]

EncodeGiveupAppConfirmTmMessage(message) ==
    message.reasonCode
        \o EncodeGiveup(message.giveup)
        \o message.reserved1

DecodeGiveupAppConfirmTmMessage(bytes) ==
    LET reasonCode == ReadBytes(bytes, 2) IN IF ~reasonCode.ok THEN Fail ELSE
    LET giveup == DecodeGiveup(reasonCode.rest) IN IF ~giveup.ok THEN Fail ELSE
    LET reserved1 == ReadBytes(giveup.rest, 1) IN IF ~reserved1.ok THEN Fail ELSE
    Ok([ reasonCode |-> reasonCode.value,
         giveup     |-> giveup.value,
         reserved1  |-> reserved1.value ], reserved1.rest)

ZeroGiveupAppConfirmTmMessage ==
    [ reasonCode |-> [i \in 1 .. 2 |-> 0],
      giveup     |-> ZeroGiveup,
      reserved1  |-> [i \in 1 .. 1 |-> 0] ]

(* Giveup App Confirm Tm Message at zero, then each field in turn at the values it is checked at *)
CheckedGiveupAppConfirmTmMessage ==
    { ZeroGiveupAppConfirmTmMessage }
        \cup { [ZeroGiveupAppConfirmTmMessage EXCEPT !.reasonCode = one] : one \in Sample(2) }
        \cup { [ZeroGiveupAppConfirmTmMessage EXCEPT !.giveup = one] : one \in CheckedGiveup }
        \cup { [ZeroGiveupAppConfirmTmMessage EXCEPT !.reserved1 = one] : one \in Sample(1) }

