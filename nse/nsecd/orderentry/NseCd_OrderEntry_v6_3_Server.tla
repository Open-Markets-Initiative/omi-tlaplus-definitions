        \cup { [ZeroOrderModRejectMessage EXCEPT !.counterPartyBrokerId = one] : one \in Sample(5) }
        \cup { [ZeroOrderModRejectMessage EXCEPT !.thirdReserved1 = one] : one \in Sample(1) }
