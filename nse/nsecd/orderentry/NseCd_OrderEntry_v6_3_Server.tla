      reserved52               |-> [i \in 1 .. 52 |-> 0] ]

(* Board Lot Out Message at zero, then each field in turn at the values it is checked at *)
CheckedBoardLotOutMessage ==
    { ZeroBoardLotOutMessage }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.participantType = one] : one \in Sample(1) }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.reserved1 = one] : one \in Sample(1) }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.competitorPeriod = one] : one \in Sample(2) }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.solicitorPeriod = one] : one \in Sample(2) }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.modifiedCancelledBy = one] : one \in Sample(1) }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.secondReserved1 = one] : one \in Sample(1) }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.reasonCode = one] : one \in Sample(2) }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.reserved4 = one] : one \in Sample(4) }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.tokenNo = one] : one \in Sample(4) }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.contractDesc = one] : one \in CheckedContractDesc }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.counterPartyBrokerId = one] : one \in Sample(5) }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.thirdReserved1 = one] : one \in Sample(1) }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.reserved2 = one] : one \in Sample(2) }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.closeoutFlag = one] : one \in Sample(1) }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.fourthReserved1 = one] : one \in Sample(1) }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.orderType = one] : one \in Sample(2) }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.orderNumber = one] : one \in Sample(8) }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.accountNumber = one] : one \in Sample(10) }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.bookTypeShort2 = one] : one \in Sample(2) }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.buySellIndicator = one] : one \in Sample(2) }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.disclosedVolume = one] : one \in Sample(4) }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.disclosedVolumeRemaining = one] : one \in Sample(4) }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.totalVolumeRemaining = one] : one \in Sample(4) }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.volume = one] : one \in Sample(4) }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.volumeFilledToday = one] : one \in Sample(4) }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.price = one] : one \in Sample(4) }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.triggerPrice = one] : one \in Sample(4) }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.goodTillDate = one] : one \in Sample(4) }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.entryDateTime = one] : one \in Sample(4) }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.minimumFillAonVolume = one] : one \in Sample(4) }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.lastModified = one] : one \in Sample(4) }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.stOrderFlags = one] : one \in Sample(2) }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.branchId = one] : one \in Sample(2) }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.traderId = one] : one \in Sample(4) }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.brokerId = one] : one \in Sample(5) }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.cOrdFiller = one] : one \in Sample(24) }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.openClose = one] : one \in Sample(1) }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.settlor = one] : one \in Sample(12) }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.proClientIndicator = one] : one \in Sample(2) }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.settlementPeriod = one] : one \in Sample(2) }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.additionalOrderFlags = one] : one \in Sample(1) }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.fifthReserved1 = one] : one \in Sample(1) }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.reference = one] : one \in Sample(4) }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.nnfField = one] : one \in Sample(8) }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.mktReplay = one] : one \in Sample(8) }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.pan = one] : one \in Sample(10) }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.algoId = one] : one \in Sample(4) }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.secondReserved2 = one] : one \in Sample(2) }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.lastActivityReference = one] : one \in Sample(8) }
        \cup { [ZeroBoardLotOutMessage EXCEPT !.reserved52 = one] : one \in Sample(52) }

(***************************************************************************)
(* Contract Desc: 28 bytes                                                 *)
(***************************************************************************)

ContractDesc2 ==
    [ instrumentName : Sample(6),
      symbol         : Sample(10),
      expiryDate     : Sample(4),
      strikePrice    : Sample(4),
      optionType     : Sample(2),
      caLevel        : Sample(2) ]

EncodeContractDesc2(message) ==
    message.instrumentName
        \o message.symbol
        \o message.expiryDate
        \o message.strikePrice
        \o message.optionType
        \o message.caLevel

DecodeContractDesc2(bytes) ==
    LET instrumentName == ReadBytes(bytes, 6) IN IF ~instrumentName.ok THEN Fail ELSE
    LET symbol == ReadBytes(instrumentName.rest, 10) IN IF ~symbol.ok THEN Fail ELSE
    LET expiryDate == ReadBytes(symbol.rest, 4) IN IF ~expiryDate.ok THEN Fail ELSE
    LET strikePrice == ReadBytes(expiryDate.rest, 4) IN IF ~strikePrice.ok THEN Fail ELSE
    LET optionType == ReadBytes(strikePrice.rest, 2) IN IF ~optionType.ok THEN Fail ELSE
    LET caLevel == ReadBytes(optionType.rest, 2) IN IF ~caLevel.ok THEN Fail ELSE
    Ok([ instrumentName |-> instrumentName.value,
         symbol         |-> symbol.value,
         expiryDate     |-> expiryDate.value,
         strikePrice    |-> strikePrice.value,
         optionType     |-> optionType.value,
         caLevel        |-> caLevel.value ], caLevel.rest)

ZeroContractDesc2 ==
    [ instrumentName |-> [i \in 1 .. 6 |-> 0],
      symbol         |-> [i \in 1 .. 10 |-> 0],
      expiryDate     |-> [i \in 1 .. 4 |-> 0],
      strikePrice    |-> [i \in 1 .. 4 |-> 0],
      optionType     |-> [i \in 1 .. 2 |-> 0],
      caLevel        |-> [i \in 1 .. 2 |-> 0] ]

(* Contract Desc at zero, then each field in turn at the values it is checked at *)
CheckedContractDesc2 ==
    { ZeroContractDesc2 }
        \cup { [ZeroContractDesc2 EXCEPT !.instrumentName = one] : one \in Sample(6) }
        \cup { [ZeroContractDesc2 EXCEPT !.symbol = one] : one \in Sample(10) }
        \cup { [ZeroContractDesc2 EXCEPT !.expiryDate = one] : one \in Sample(4) }
        \cup { [ZeroContractDesc2 EXCEPT !.strikePrice = one] : one \in Sample(4) }
        \cup { [ZeroContractDesc2 EXCEPT !.optionType = one] : one \in Sample(2) }
        \cup { [ZeroContractDesc2 EXCEPT !.caLevel = one] : one \in Sample(2) }

(***************************************************************************)
(* Neg Order To Bl Message: 276 bytes                                      *)
(***************************************************************************)

NegOrderToBlMessage ==
    [ participantType          : Sample(1),
      reserved1                : Sample(1),
      competitorPeriod         : Sample(2),
      solicitorPeriod          : Sample(2),
      modifiedCancelledBy      : Sample(1),
      secondReserved1          : Sample(1),
      reasonCode               : Sample(2),
      reserved4                : Sample(4),
      tokenNo                  : Sample(4),
      contractDesc             : ContractDesc2,
      counterPartyBrokerId     : Sample(5),
      thirdReserved1           : Sample(1),
      reserved2                : Sample(2),
      closeoutFlag             : Sample(1),
      fourthReserved1          : Sample(1),
      orderType                : Sample(2),
      orderNumber              : Sample(8),
      accountNumber            : Sample(10),
      bookTypeShort2           : Sample(2),
      buySellIndicator         : Sample(2),
      disclosedVolume          : Sample(4),
      disclosedVolumeRemaining : Sample(4),
      totalVolumeRemaining     : Sample(4),
      volume                   : Sample(4),
      volumeFilledToday        : Sample(4),
      price                    : Sample(4),
      triggerPrice             : Sample(4),
      goodTillDate             : Sample(4),
      entryDateTime            : Sample(4),
      minimumFillAonVolume     : Sample(4),
      lastModified             : Sample(4),
      stOrderFlags             : Sample(2),
      branchId                 : Sample(2),
      traderId                 : Sample(4),
      brokerId                 : Sample(5),
      cOrdFiller               : Sample(24),
      openClose                : Sample(1),
      settlor                  : Sample(12),
      proClientIndicator       : Sample(2),
      settlementPeriod         : Sample(2),
      additionalOrderFlags     : Sample(1),
      fifthReserved1           : Sample(1),
      reference                : Sample(4),
      nnfField                 : Sample(8),
      mktReplay                : Sample(8),
      pan                      : Sample(10),
      algoId                   : Sample(4),
      secondReserved2          : Sample(2),
      lastActivityReference    : Sample(8),
      reserved52               : Sample(52) ]

EncodeNegOrderToBlMessage(message) ==
    message.participantType
        \o message.reserved1
        \o message.competitorPeriod
        \o message.solicitorPeriod
        \o message.modifiedCancelledBy
        \o message.secondReserved1
        \o message.reasonCode
        \o message.reserved4
        \o message.tokenNo
        \o EncodeContractDesc2(message.contractDesc)
        \o message.counterPartyBrokerId
        \o message.thirdReserved1
        \o message.reserved2
        \o message.closeoutFlag
        \o message.fourthReserved1
        \o message.orderType
        \o message.orderNumber
        \o message.accountNumber
        \o message.bookTypeShort2
        \o message.buySellIndicator
        \o message.disclosedVolume
        \o message.disclosedVolumeRemaining
        \o message.totalVolumeRemaining
        \o message.volume
        \o message.volumeFilledToday
        \o message.price
        \o message.triggerPrice
        \o message.goodTillDate
        \o message.entryDateTime
        \o message.minimumFillAonVolume
        \o message.lastModified
        \o message.stOrderFlags
        \o message.branchId
        \o message.traderId
        \o message.brokerId
        \o message.cOrdFiller
        \o message.openClose
        \o message.settlor
        \o message.proClientIndicator
        \o message.settlementPeriod
        \o message.additionalOrderFlags
        \o message.fifthReserved1
        \o message.reference
        \o message.nnfField
        \o message.mktReplay
        \o message.pan
        \o message.algoId
        \o message.secondReserved2
        \o message.lastActivityReference
        \o message.reserved52

DecodeNegOrderToBlMessage(bytes) ==
    LET participantType == ReadBytes(bytes, 1) IN IF ~participantType.ok THEN Fail ELSE
    LET reserved1 == ReadBytes(participantType.rest, 1) IN IF ~reserved1.ok THEN Fail ELSE
    LET competitorPeriod == ReadBytes(reserved1.rest, 2) IN IF ~competitorPeriod.ok THEN Fail ELSE
    LET solicitorPeriod == ReadBytes(competitorPeriod.rest, 2) IN IF ~solicitorPeriod.ok THEN Fail ELSE
    LET modifiedCancelledBy == ReadBytes(solicitorPeriod.rest, 1) IN IF ~modifiedCancelledBy.ok THEN Fail ELSE
    LET secondReserved1 == ReadBytes(modifiedCancelledBy.rest, 1) IN IF ~secondReserved1.ok THEN Fail ELSE
    LET reasonCode == ReadBytes(secondReserved1.rest, 2) IN IF ~reasonCode.ok THEN Fail ELSE
    LET reserved4 == ReadBytes(reasonCode.rest, 4) IN IF ~reserved4.ok THEN Fail ELSE
    LET tokenNo == ReadBytes(reserved4.rest, 4) IN IF ~tokenNo.ok THEN Fail ELSE
    LET contractDesc == DecodeContractDesc2(tokenNo.rest) IN IF ~contractDesc.ok THEN Fail ELSE
    LET counterPartyBrokerId == ReadBytes(contractDesc.rest, 5) IN IF ~counterPartyBrokerId.ok THEN Fail ELSE
    LET thirdReserved1 == ReadBytes(counterPartyBrokerId.rest, 1) IN IF ~thirdReserved1.ok THEN Fail ELSE
    LET reserved2 == ReadBytes(thirdReserved1.rest, 2) IN IF ~reserved2.ok THEN Fail ELSE
    LET closeoutFlag == ReadBytes(reserved2.rest, 1) IN IF ~closeoutFlag.ok THEN Fail ELSE
    LET fourthReserved1 == ReadBytes(closeoutFlag.rest, 1) IN IF ~fourthReserved1.ok THEN Fail ELSE
    LET orderType == ReadBytes(fourthReserved1.rest, 2) IN IF ~orderType.ok THEN Fail ELSE
    LET orderNumber == ReadBytes(orderType.rest, 8) IN IF ~orderNumber.ok THEN Fail ELSE
    LET accountNumber == ReadBytes(orderNumber.rest, 10) IN IF ~accountNumber.ok THEN Fail ELSE
    LET bookTypeShort2 == ReadBytes(accountNumber.rest, 2) IN IF ~bookTypeShort2.ok THEN Fail ELSE
    LET buySellIndicator == ReadBytes(bookTypeShort2.rest, 2) IN IF ~buySellIndicator.ok THEN Fail ELSE
    LET disclosedVolume == ReadBytes(buySellIndicator.rest, 4) IN IF ~disclosedVolume.ok THEN Fail ELSE
    LET disclosedVolumeRemaining == ReadBytes(disclosedVolume.rest, 4) IN IF ~disclosedVolumeRemaining.ok THEN Fail ELSE
    LET totalVolumeRemaining == ReadBytes(disclosedVolumeRemaining.rest, 4) IN IF ~totalVolumeRemaining.ok THEN Fail ELSE
    LET volume == ReadBytes(totalVolumeRemaining.rest, 4) IN IF ~volume.ok THEN Fail ELSE
    LET volumeFilledToday == ReadBytes(volume.rest, 4) IN IF ~volumeFilledToday.ok THEN Fail ELSE
    LET price == ReadBytes(volumeFilledToday.rest, 4) IN IF ~price.ok THEN Fail ELSE
    LET triggerPrice == ReadBytes(price.rest, 4) IN IF ~triggerPrice.ok THEN Fail ELSE
    LET goodTillDate == ReadBytes(triggerPrice.rest, 4) IN IF ~goodTillDate.ok THEN Fail ELSE
    LET entryDateTime == ReadBytes(goodTillDate.rest, 4) IN IF ~entryDateTime.ok THEN Fail ELSE
    LET minimumFillAonVolume == ReadBytes(entryDateTime.rest, 4) IN IF ~minimumFillAonVolume.ok THEN Fail ELSE
    LET lastModified == ReadBytes(minimumFillAonVolume.rest, 4) IN IF ~lastModified.ok THEN Fail ELSE
    LET stOrderFlags == ReadBytes(lastModified.rest, 2) IN IF ~stOrderFlags.ok THEN Fail ELSE
    LET branchId == ReadBytes(stOrderFlags.rest, 2) IN IF ~branchId.ok THEN Fail ELSE
    LET traderId == ReadBytes(branchId.rest, 4) IN IF ~traderId.ok THEN Fail ELSE
    LET brokerId == ReadBytes(traderId.rest, 5) IN IF ~brokerId.ok THEN Fail ELSE
    LET cOrdFiller == ReadBytes(brokerId.rest, 24) IN IF ~cOrdFiller.ok THEN Fail ELSE
    LET openClose == ReadBytes(cOrdFiller.rest, 1) IN IF ~openClose.ok THEN Fail ELSE
    LET settlor == ReadBytes(openClose.rest, 12) IN IF ~settlor.ok THEN Fail ELSE
    LET proClientIndicator == ReadBytes(settlor.rest, 2) IN IF ~proClientIndicator.ok THEN Fail ELSE
    LET settlementPeriod == ReadBytes(proClientIndicator.rest, 2) IN IF ~settlementPeriod.ok THEN Fail ELSE
    LET additionalOrderFlags == ReadBytes(settlementPeriod.rest, 1) IN IF ~additionalOrderFlags.ok THEN Fail ELSE
    LET fifthReserved1 == ReadBytes(additionalOrderFlags.rest, 1) IN IF ~fifthReserved1.ok THEN Fail ELSE
    LET reference == ReadBytes(fifthReserved1.rest, 4) IN IF ~reference.ok THEN Fail ELSE
    LET nnfField == ReadBytes(reference.rest, 8) IN IF ~nnfField.ok THEN Fail ELSE
    LET mktReplay == ReadBytes(nnfField.rest, 8) IN IF ~mktReplay.ok THEN Fail ELSE
    LET pan == ReadBytes(mktReplay.rest, 10) IN IF ~pan.ok THEN Fail ELSE
    LET algoId == ReadBytes(pan.rest, 4) IN IF ~algoId.ok THEN Fail ELSE
    LET secondReserved2 == ReadBytes(algoId.rest, 2) IN IF ~secondReserved2.ok THEN Fail ELSE
    LET lastActivityReference == ReadBytes(secondReserved2.rest, 8) IN IF ~lastActivityReference.ok THEN Fail ELSE
    LET reserved52 == ReadBytes(lastActivityReference.rest, 52) IN IF ~reserved52.ok THEN Fail ELSE
    Ok([ participantType          |-> participantType.value,
         reserved1                |-> reserved1.value,
         competitorPeriod         |-> competitorPeriod.value,
         solicitorPeriod          |-> solicitorPeriod.value,
         modifiedCancelledBy      |-> modifiedCancelledBy.value,
         secondReserved1          |-> secondReserved1.value,
         reasonCode               |-> reasonCode.value,
         reserved4                |-> reserved4.value,
         tokenNo                  |-> tokenNo.value,
         contractDesc             |-> contractDesc.value,
         counterPartyBrokerId     |-> counterPartyBrokerId.value,
         thirdReserved1           |-> thirdReserved1.value,
         reserved2                |-> reserved2.value,
         closeoutFlag             |-> closeoutFlag.value,
         fourthReserved1          |-> fourthReserved1.value,
         orderType                |-> orderType.value,
         orderNumber              |-> orderNumber.value,
         accountNumber            |-> accountNumber.value,
         bookTypeShort2           |-> bookTypeShort2.value,
         buySellIndicator         |-> buySellIndicator.value,
         disclosedVolume          |-> disclosedVolume.value,
         disclosedVolumeRemaining |-> disclosedVolumeRemaining.value,
         totalVolumeRemaining     |-> totalVolumeRemaining.value,
         volume                   |-> volume.value,
         volumeFilledToday        |-> volumeFilledToday.value,
         price                    |-> price.value,
         triggerPrice             |-> triggerPrice.value,
         goodTillDate             |-> goodTillDate.value,
         entryDateTime            |-> entryDateTime.value,
         minimumFillAonVolume     |-> minimumFillAonVolume.value,
         lastModified             |-> lastModified.value,
         stOrderFlags             |-> stOrderFlags.value,
         branchId                 |-> branchId.value,
         traderId                 |-> traderId.value,
         brokerId                 |-> brokerId.value,
         cOrdFiller               |-> cOrdFiller.value,
         openClose                |-> openClose.value,
         settlor                  |-> settlor.value,
         proClientIndicator       |-> proClientIndicator.value,
         settlementPeriod         |-> settlementPeriod.value,
         additionalOrderFlags     |-> additionalOrderFlags.value,
         fifthReserved1           |-> fifthReserved1.value,
         reference                |-> reference.value,
         nnfField                 |-> nnfField.value,
         mktReplay                |-> mktReplay.value,
         pan                      |-> pan.value,
         algoId                   |-> algoId.value,
         secondReserved2          |-> secondReserved2.value,
         lastActivityReference    |-> lastActivityReference.value,
         reserved52               |-> reserved52.value ], reserved52.rest)

ZeroNegOrderToBlMessage ==
    [ participantType          |-> [i \in 1 .. 1 |-> 0],
      reserved1                |-> [i \in 1 .. 1 |-> 0],
      competitorPeriod         |-> [i \in 1 .. 2 |-> 0],
      solicitorPeriod          |-> [i \in 1 .. 2 |-> 0],
      modifiedCancelledBy      |-> [i \in 1 .. 1 |-> 0],
      secondReserved1          |-> [i \in 1 .. 1 |-> 0],
      reasonCode               |-> [i \in 1 .. 2 |-> 0],
      reserved4                |-> [i \in 1 .. 4 |-> 0],
      tokenNo                  |-> [i \in 1 .. 4 |-> 0],
      contractDesc             |-> ZeroContractDesc2,
      counterPartyBrokerId     |-> [i \in 1 .. 5 |-> 0],
      thirdReserved1           |-> [i \in 1 .. 1 |-> 0],
      reserved2                |-> [i \in 1 .. 2 |-> 0],
      closeoutFlag             |-> [i \in 1 .. 1 |-> 0],
      fourthReserved1          |-> [i \in 1 .. 1 |-> 0],
      orderType                |-> [i \in 1 .. 2 |-> 0],
      orderNumber              |-> [i \in 1 .. 8 |-> 0],
      accountNumber            |-> [i \in 1 .. 10 |-> 0],
      bookTypeShort2           |-> [i \in 1 .. 2 |-> 0],
      buySellIndicator         |-> [i \in 1 .. 2 |-> 0],
      disclosedVolume          |-> [i \in 1 .. 4 |-> 0],
      disclosedVolumeRemaining |-> [i \in 1 .. 4 |-> 0],
      totalVolumeRemaining     |-> [i \in 1 .. 4 |-> 0],
      volume                   |-> [i \in 1 .. 4 |-> 0],
      volumeFilledToday        |-> [i \in 1 .. 4 |-> 0],
      price                    |-> [i \in 1 .. 4 |-> 0],
      triggerPrice             |-> [i \in 1 .. 4 |-> 0],
      goodTillDate             |-> [i \in 1 .. 4 |-> 0],
      entryDateTime            |-> [i \in 1 .. 4 |-> 0],
      minimumFillAonVolume     |-> [i \in 1 .. 4 |-> 0],
      lastModified             |-> [i \in 1 .. 4 |-> 0],
      stOrderFlags             |-> [i \in 1 .. 2 |-> 0],
      branchId                 |-> [i \in 1 .. 2 |-> 0],
      traderId                 |-> [i \in 1 .. 4 |-> 0],
      brokerId                 |-> [i \in 1 .. 5 |-> 0],
      cOrdFiller               |-> [i \in 1 .. 24 |-> 0],
      openClose                |-> [i \in 1 .. 1 |-> 0],
      settlor                  |-> [i \in 1 .. 12 |-> 0],
      proClientIndicator       |-> [i \in 1 .. 2 |-> 0],
      settlementPeriod         |-> [i \in 1 .. 2 |-> 0],
      additionalOrderFlags     |-> [i \in 1 .. 1 |-> 0],
      fifthReserved1           |-> [i \in 1 .. 1 |-> 0],
      reference                |-> [i \in 1 .. 4 |-> 0],
      nnfField                 |-> [i \in 1 .. 8 |-> 0],
      mktReplay                |-> [i \in 1 .. 8 |-> 0],
      pan                      |-> [i \in 1 .. 10 |-> 0],
      algoId                   |-> [i \in 1 .. 4 |-> 0],
      secondReserved2          |-> [i \in 1 .. 2 |-> 0],
      lastActivityReference    |-> [i \in 1 .. 8 |-> 0],
      reserved52               |-> [i \in 1 .. 52 |-> 0] ]

(* Neg Order To Bl Message at zero, then each field in turn at the values it is checked at *)
CheckedNegOrderToBlMessage ==
    { ZeroNegOrderToBlMessage }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.participantType = one] : one \in Sample(1) }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.reserved1 = one] : one \in Sample(1) }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.competitorPeriod = one] : one \in Sample(2) }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.solicitorPeriod = one] : one \in Sample(2) }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.modifiedCancelledBy = one] : one \in Sample(1) }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.secondReserved1 = one] : one \in Sample(1) }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.reasonCode = one] : one \in Sample(2) }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.reserved4 = one] : one \in Sample(4) }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.tokenNo = one] : one \in Sample(4) }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.contractDesc = one] : one \in CheckedContractDesc2 }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.counterPartyBrokerId = one] : one \in Sample(5) }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.thirdReserved1 = one] : one \in Sample(1) }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.reserved2 = one] : one \in Sample(2) }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.closeoutFlag = one] : one \in Sample(1) }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.fourthReserved1 = one] : one \in Sample(1) }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.orderType = one] : one \in Sample(2) }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.orderNumber = one] : one \in Sample(8) }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.accountNumber = one] : one \in Sample(10) }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.bookTypeShort2 = one] : one \in Sample(2) }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.buySellIndicator = one] : one \in Sample(2) }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.disclosedVolume = one] : one \in Sample(4) }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.disclosedVolumeRemaining = one] : one \in Sample(4) }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.totalVolumeRemaining = one] : one \in Sample(4) }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.volume = one] : one \in Sample(4) }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.volumeFilledToday = one] : one \in Sample(4) }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.price = one] : one \in Sample(4) }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.triggerPrice = one] : one \in Sample(4) }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.goodTillDate = one] : one \in Sample(4) }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.entryDateTime = one] : one \in Sample(4) }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.minimumFillAonVolume = one] : one \in Sample(4) }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.lastModified = one] : one \in Sample(4) }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.stOrderFlags = one] : one \in Sample(2) }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.branchId = one] : one \in Sample(2) }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.traderId = one] : one \in Sample(4) }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.brokerId = one] : one \in Sample(5) }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.cOrdFiller = one] : one \in Sample(24) }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.openClose = one] : one \in Sample(1) }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.settlor = one] : one \in Sample(12) }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.proClientIndicator = one] : one \in Sample(2) }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.settlementPeriod = one] : one \in Sample(2) }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.additionalOrderFlags = one] : one \in Sample(1) }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.fifthReserved1 = one] : one \in Sample(1) }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.reference = one] : one \in Sample(4) }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.nnfField = one] : one \in Sample(8) }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.mktReplay = one] : one \in Sample(8) }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.pan = one] : one \in Sample(10) }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.algoId = one] : one \in Sample(4) }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.secondReserved2 = one] : one \in Sample(2) }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.lastActivityReference = one] : one \in Sample(8) }
        \cup { [ZeroNegOrderToBlMessage EXCEPT !.reserved52 = one] : one \in Sample(52) }

(***************************************************************************)
(* Contract Desc: 28 bytes                                                 *)
(***************************************************************************)

ContractDesc3 ==
    [ instrumentName : Sample(6),
      symbol         : Sample(10),
      expiryDate     : Sample(4),
      strikePrice    : Sample(4),
      optionType     : Sample(2),
      caLevel        : Sample(2) ]

EncodeContractDesc3(message) ==
    message.instrumentName
        \o message.symbol
        \o message.expiryDate
        \o message.strikePrice
        \o message.optionType
        \o message.caLevel

DecodeContractDesc3(bytes) ==
    LET instrumentName == ReadBytes(bytes, 6) IN IF ~instrumentName.ok THEN Fail ELSE
    LET symbol == ReadBytes(instrumentName.rest, 10) IN IF ~symbol.ok THEN Fail ELSE
    LET expiryDate == ReadBytes(symbol.rest, 4) IN IF ~expiryDate.ok THEN Fail ELSE
    LET strikePrice == ReadBytes(expiryDate.rest, 4) IN IF ~strikePrice.ok THEN Fail ELSE
    LET optionType == ReadBytes(strikePrice.rest, 2) IN IF ~optionType.ok THEN Fail ELSE
    LET caLevel == ReadBytes(optionType.rest, 2) IN IF ~caLevel.ok THEN Fail ELSE
    Ok([ instrumentName |-> instrumentName.value,
         symbol         |-> symbol.value,
         expiryDate     |-> expiryDate.value,
         strikePrice    |-> strikePrice.value,
         optionType     |-> optionType.value,
         caLevel        |-> caLevel.value ], caLevel.rest)

ZeroContractDesc3 ==
    [ instrumentName |-> [i \in 1 .. 6 |-> 0],
      symbol         |-> [i \in 1 .. 10 |-> 0],
      expiryDate     |-> [i \in 1 .. 4 |-> 0],
      strikePrice    |-> [i \in 1 .. 4 |-> 0],
      optionType     |-> [i \in 1 .. 2 |-> 0],
      caLevel        |-> [i \in 1 .. 2 |-> 0] ]

(* Contract Desc at zero, then each field in turn at the values it is checked at *)
CheckedContractDesc3 ==
    { ZeroContractDesc3 }
        \cup { [ZeroContractDesc3 EXCEPT !.instrumentName = one] : one \in Sample(6) }
        \cup { [ZeroContractDesc3 EXCEPT !.symbol = one] : one \in Sample(10) }
        \cup { [ZeroContractDesc3 EXCEPT !.expiryDate = one] : one \in Sample(4) }
        \cup { [ZeroContractDesc3 EXCEPT !.strikePrice = one] : one \in Sample(4) }
        \cup { [ZeroContractDesc3 EXCEPT !.optionType = one] : one \in Sample(2) }
        \cup { [ZeroContractDesc3 EXCEPT !.caLevel = one] : one \in Sample(2) }

(***************************************************************************)
(* Order Mod Out Message: 276 bytes                                        *)
(***************************************************************************)

OrderModOutMessage ==
    [ participantType          : Sample(1),
      reserved1                : Sample(1),
      competitorPeriod         : Sample(2),
      solicitorPeriod          : Sample(2),
      modifiedCancelledBy      : Sample(1),
      secondReserved1          : Sample(1),
      reasonCode               : Sample(2),
      reserved4                : Sample(4),
      tokenNo                  : Sample(4),
      contractDesc             : ContractDesc3,
      counterPartyBrokerId     : Sample(5),
      thirdReserved1           : Sample(1),
      reserved2                : Sample(2),
      closeoutFlag             : Sample(1),
      fourthReserved1          : Sample(1),
      orderType                : Sample(2),
      orderNumber              : Sample(8),
      accountNumber            : Sample(10),
      bookTypeShort2           : Sample(2),
      buySellIndicator         : Sample(2),
      disclosedVolume          : Sample(4),
      disclosedVolumeRemaining : Sample(4),
      totalVolumeRemaining     : Sample(4),
      volume                   : Sample(4),
      volumeFilledToday        : Sample(4),
      price                    : Sample(4),
      triggerPrice             : Sample(4),
      goodTillDate             : Sample(4),
      entryDateTime            : Sample(4),
      minimumFillAonVolume     : Sample(4),
      lastModified             : Sample(4),
      stOrderFlags             : Sample(2),
      branchId                 : Sample(2),
      traderId                 : Sample(4),
      brokerId                 : Sample(5),
      cOrdFiller               : Sample(24),
      openClose                : Sample(1),
      settlor                  : Sample(12),
      proClientIndicator       : Sample(2),
      settlementPeriod         : Sample(2),
      additionalOrderFlags     : Sample(1),
      fifthReserved1           : Sample(1),
      reference                : Sample(4),
      nnfField                 : Sample(8),
      mktReplay                : Sample(8),
      pan                      : Sample(10),
      algoId                   : Sample(4),
      secondReserved2          : Sample(2),
      lastActivityReference    : Sample(8),
      reserved52               : Sample(52) ]

EncodeOrderModOutMessage(message) ==
    message.participantType
        \o message.reserved1
        \o message.competitorPeriod
        \o message.solicitorPeriod
        \o message.modifiedCancelledBy
        \o message.secondReserved1
        \o message.reasonCode
        \o message.reserved4
        \o message.tokenNo
        \o EncodeContractDesc3(message.contractDesc)
        \o message.counterPartyBrokerId
        \o message.thirdReserved1
        \o message.reserved2
        \o message.closeoutFlag
        \o message.fourthReserved1
        \o message.orderType
        \o message.orderNumber
        \o message.accountNumber
        \o message.bookTypeShort2
        \o message.buySellIndicator
        \o message.disclosedVolume
        \o message.disclosedVolumeRemaining
        \o message.totalVolumeRemaining
        \o message.volume
        \o message.volumeFilledToday
        \o message.price
        \o message.triggerPrice
        \o message.goodTillDate
        \o message.entryDateTime
        \o message.minimumFillAonVolume
        \o message.lastModified
        \o message.stOrderFlags
        \o message.branchId
        \o message.traderId
        \o message.brokerId
        \o message.cOrdFiller
        \o message.openClose
        \o message.settlor
        \o message.proClientIndicator
        \o message.settlementPeriod
        \o message.additionalOrderFlags
        \o message.fifthReserved1
        \o message.reference
        \o message.nnfField
        \o message.mktReplay
        \o message.pan
        \o message.algoId
        \o message.secondReserved2
        \o message.lastActivityReference
        \o message.reserved52

DecodeOrderModOutMessage(bytes) ==
    LET participantType == ReadBytes(bytes, 1) IN IF ~participantType.ok THEN Fail ELSE
    LET reserved1 == ReadBytes(participantType.rest, 1) IN IF ~reserved1.ok THEN Fail ELSE
    LET competitorPeriod == ReadBytes(reserved1.rest, 2) IN IF ~competitorPeriod.ok THEN Fail ELSE
    LET solicitorPeriod == ReadBytes(competitorPeriod.rest, 2) IN IF ~solicitorPeriod.ok THEN Fail ELSE
    LET modifiedCancelledBy == ReadBytes(solicitorPeriod.rest, 1) IN IF ~modifiedCancelledBy.ok THEN Fail ELSE
    LET secondReserved1 == ReadBytes(modifiedCancelledBy.rest, 1) IN IF ~secondReserved1.ok THEN Fail ELSE
    LET reasonCode == ReadBytes(secondReserved1.rest, 2) IN IF ~reasonCode.ok THEN Fail ELSE
    LET reserved4 == ReadBytes(reasonCode.rest, 4) IN IF ~reserved4.ok THEN Fail ELSE
    LET tokenNo == ReadBytes(reserved4.rest, 4) IN IF ~tokenNo.ok THEN Fail ELSE
    LET contractDesc == DecodeContractDesc3(tokenNo.rest) IN IF ~contractDesc.ok THEN Fail ELSE
    LET counterPartyBrokerId == ReadBytes(contractDesc.rest, 5) IN IF ~counterPartyBrokerId.ok THEN Fail ELSE
    LET thirdReserved1 == ReadBytes(counterPartyBrokerId.rest, 1) IN IF ~thirdReserved1.ok THEN Fail ELSE
    LET reserved2 == ReadBytes(thirdReserved1.rest, 2) IN IF ~reserved2.ok THEN Fail ELSE
    LET closeoutFlag == ReadBytes(reserved2.rest, 1) IN IF ~closeoutFlag.ok THEN Fail ELSE
    LET fourthReserved1 == ReadBytes(closeoutFlag.rest, 1) IN IF ~fourthReserved1.ok THEN Fail ELSE
    LET orderType == ReadBytes(fourthReserved1.rest, 2) IN IF ~orderType.ok THEN Fail ELSE
    LET orderNumber == ReadBytes(orderType.rest, 8) IN IF ~orderNumber.ok THEN Fail ELSE
    LET accountNumber == ReadBytes(orderNumber.rest, 10) IN IF ~accountNumber.ok THEN Fail ELSE
    LET bookTypeShort2 == ReadBytes(accountNumber.rest, 2) IN IF ~bookTypeShort2.ok THEN Fail ELSE
    LET buySellIndicator == ReadBytes(bookTypeShort2.rest, 2) IN IF ~buySellIndicator.ok THEN Fail ELSE
    LET disclosedVolume == ReadBytes(buySellIndicator.rest, 4) IN IF ~disclosedVolume.ok THEN Fail ELSE
    LET disclosedVolumeRemaining == ReadBytes(disclosedVolume.rest, 4) IN IF ~disclosedVolumeRemaining.ok THEN Fail ELSE
    LET totalVolumeRemaining == ReadBytes(disclosedVolumeRemaining.rest, 4) IN IF ~totalVolumeRemaining.ok THEN Fail ELSE
    LET volume == ReadBytes(totalVolumeRemaining.rest, 4) IN IF ~volume.ok THEN Fail ELSE
    LET volumeFilledToday == ReadBytes(volume.rest, 4) IN IF ~volumeFilledToday.ok THEN Fail ELSE
    LET price == ReadBytes(volumeFilledToday.rest, 4) IN IF ~price.ok THEN Fail ELSE
    LET triggerPrice == ReadBytes(price.rest, 4) IN IF ~triggerPrice.ok THEN Fail ELSE
    LET goodTillDate == ReadBytes(triggerPrice.rest, 4) IN IF ~goodTillDate.ok THEN Fail ELSE
    LET entryDateTime == ReadBytes(goodTillDate.rest, 4) IN IF ~entryDateTime.ok THEN Fail ELSE
    LET minimumFillAonVolume == ReadBytes(entryDateTime.rest, 4) IN IF ~minimumFillAonVolume.ok THEN Fail ELSE
    LET lastModified == ReadBytes(minimumFillAonVolume.rest, 4) IN IF ~lastModified.ok THEN Fail ELSE
    LET stOrderFlags == ReadBytes(lastModified.rest, 2) IN IF ~stOrderFlags.ok THEN Fail ELSE
    LET branchId == ReadBytes(stOrderFlags.rest, 2) IN IF ~branchId.ok THEN Fail ELSE
    LET traderId == ReadBytes(branchId.rest, 4) IN IF ~traderId.ok THEN Fail ELSE
    LET brokerId == ReadBytes(traderId.rest, 5) IN IF ~brokerId.ok THEN Fail ELSE
    LET cOrdFiller == ReadBytes(brokerId.rest, 24) IN IF ~cOrdFiller.ok THEN Fail ELSE
    LET openClose == ReadBytes(cOrdFiller.rest, 1) IN IF ~openClose.ok THEN Fail ELSE
    LET settlor == ReadBytes(openClose.rest, 12) IN IF ~settlor.ok THEN Fail ELSE
    LET proClientIndicator == ReadBytes(settlor.rest, 2) IN IF ~proClientIndicator.ok THEN Fail ELSE
    LET settlementPeriod == ReadBytes(proClientIndicator.rest, 2) IN IF ~settlementPeriod.ok THEN Fail ELSE
    LET additionalOrderFlags == ReadBytes(settlementPeriod.rest, 1) IN IF ~additionalOrderFlags.ok THEN Fail ELSE
    LET fifthReserved1 == ReadBytes(additionalOrderFlags.rest, 1) IN IF ~fifthReserved1.ok THEN Fail ELSE
    LET reference == ReadBytes(fifthReserved1.rest, 4) IN IF ~reference.ok THEN Fail ELSE
    LET nnfField == ReadBytes(reference.rest, 8) IN IF ~nnfField.ok THEN Fail ELSE
    LET mktReplay == ReadBytes(nnfField.rest, 8) IN IF ~mktReplay.ok THEN Fail ELSE
    LET pan == ReadBytes(mktReplay.rest, 10) IN IF ~pan.ok THEN Fail ELSE
    LET algoId == ReadBytes(pan.rest, 4) IN IF ~algoId.ok THEN Fail ELSE
    LET secondReserved2 == ReadBytes(algoId.rest, 2) IN IF ~secondReserved2.ok THEN Fail ELSE
    LET lastActivityReference == ReadBytes(secondReserved2.rest, 8) IN IF ~lastActivityReference.ok THEN Fail ELSE
    LET reserved52 == ReadBytes(lastActivityReference.rest, 52) IN IF ~reserved52.ok THEN Fail ELSE
    Ok([ participantType          |-> participantType.value,
         reserved1                |-> reserved1.value,
         competitorPeriod         |-> competitorPeriod.value,
         solicitorPeriod          |-> solicitorPeriod.value,
         modifiedCancelledBy      |-> modifiedCancelledBy.value,
         secondReserved1          |-> secondReserved1.value,
         reasonCode               |-> reasonCode.value,
         reserved4                |-> reserved4.value,
         tokenNo                  |-> tokenNo.value,
         contractDesc             |-> contractDesc.value,
         counterPartyBrokerId     |-> counterPartyBrokerId.value,
         thirdReserved1           |-> thirdReserved1.value,
         reserved2                |-> reserved2.value,
         closeoutFlag             |-> closeoutFlag.value,
         fourthReserved1          |-> fourthReserved1.value,
         orderType                |-> orderType.value,
         orderNumber              |-> orderNumber.value,
         accountNumber            |-> accountNumber.value,
         bookTypeShort2           |-> bookTypeShort2.value,
         buySellIndicator         |-> buySellIndicator.value,
         disclosedVolume          |-> disclosedVolume.value,
         disclosedVolumeRemaining |-> disclosedVolumeRemaining.value,
         totalVolumeRemaining     |-> totalVolumeRemaining.value,
         volume                   |-> volume.value,
         volumeFilledToday        |-> volumeFilledToday.value,
         price                    |-> price.value,
         triggerPrice             |-> triggerPrice.value,
         goodTillDate             |-> goodTillDate.value,
         entryDateTime            |-> entryDateTime.value,
         minimumFillAonVolume     |-> minimumFillAonVolume.value,
         lastModified             |-> lastModified.value,
         stOrderFlags             |-> stOrderFlags.value,
         branchId                 |-> branchId.value,
         traderId                 |-> traderId.value,
         brokerId                 |-> brokerId.value,
         cOrdFiller               |-> cOrdFiller.value,
         openClose                |-> openClose.value,
         settlor                  |-> settlor.value,
         proClientIndicator       |-> proClientIndicator.value,
         settlementPeriod         |-> settlementPeriod.value,
         additionalOrderFlags     |-> additionalOrderFlags.value,
         fifthReserved1           |-> fifthReserved1.value,
         reference                |-> reference.value,
         nnfField                 |-> nnfField.value,
         mktReplay                |-> mktReplay.value,
         pan                      |-> pan.value,
         algoId                   |-> algoId.value,
         secondReserved2          |-> secondReserved2.value,
         lastActivityReference    |-> lastActivityReference.value,
         reserved52               |-> reserved52.value ], reserved52.rest)

ZeroOrderModOutMessage ==
    [ participantType          |-> [i \in 1 .. 1 |-> 0],
      reserved1                |-> [i \in 1 .. 1 |-> 0],
      competitorPeriod         |-> [i \in 1 .. 2 |-> 0],
      solicitorPeriod          |-> [i \in 1 .. 2 |-> 0],
      modifiedCancelledBy      |-> [i \in 1 .. 1 |-> 0],
      secondReserved1          |-> [i \in 1 .. 1 |-> 0],
      reasonCode               |-> [i \in 1 .. 2 |-> 0],
      reserved4                |-> [i \in 1 .. 4 |-> 0],
      tokenNo                  |-> [i \in 1 .. 4 |-> 0],
      contractDesc             |-> ZeroContractDesc3,
      counterPartyBrokerId     |-> [i \in 1 .. 5 |-> 0],
      thirdReserved1           |-> [i \in 1 .. 1 |-> 0],
      reserved2                |-> [i \in 1 .. 2 |-> 0],
      closeoutFlag             |-> [i \in 1 .. 1 |-> 0],
      fourthReserved1          |-> [i \in 1 .. 1 |-> 0],
      orderType                |-> [i \in 1 .. 2 |-> 0],
      orderNumber              |-> [i \in 1 .. 8 |-> 0],
      accountNumber            |-> [i \in 1 .. 10 |-> 0],
      bookTypeShort2           |-> [i \in 1 .. 2 |-> 0],
      buySellIndicator         |-> [i \in 1 .. 2 |-> 0],
      disclosedVolume          |-> [i \in 1 .. 4 |-> 0],
      disclosedVolumeRemaining |-> [i \in 1 .. 4 |-> 0],
      totalVolumeRemaining     |-> [i \in 1 .. 4 |-> 0],
      volume                   |-> [i \in 1 .. 4 |-> 0],
      volumeFilledToday        |-> [i \in 1 .. 4 |-> 0],
      price                    |-> [i \in 1 .. 4 |-> 0],
      triggerPrice             |-> [i \in 1 .. 4 |-> 0],
      goodTillDate             |-> [i \in 1 .. 4 |-> 0],
      entryDateTime            |-> [i \in 1 .. 4 |-> 0],
      minimumFillAonVolume     |-> [i \in 1 .. 4 |-> 0],
      lastModified             |-> [i \in 1 .. 4 |-> 0],
      stOrderFlags             |-> [i \in 1 .. 2 |-> 0],
      branchId                 |-> [i \in 1 .. 2 |-> 0],
      traderId                 |-> [i \in 1 .. 4 |-> 0],
      brokerId                 |-> [i \in 1 .. 5 |-> 0],
      cOrdFiller               |-> [i \in 1 .. 24 |-> 0],
      openClose                |-> [i \in 1 .. 1 |-> 0],
      settlor                  |-> [i \in 1 .. 12 |-> 0],
      proClientIndicator       |-> [i \in 1 .. 2 |-> 0],
      settlementPeriod         |-> [i \in 1 .. 2 |-> 0],
      additionalOrderFlags     |-> [i \in 1 .. 1 |-> 0],
      fifthReserved1           |-> [i \in 1 .. 1 |-> 0],
      reference                |-> [i \in 1 .. 4 |-> 0],
      nnfField                 |-> [i \in 1 .. 8 |-> 0],
      mktReplay                |-> [i \in 1 .. 8 |-> 0],
      pan                      |-> [i \in 1 .. 10 |-> 0],
      algoId                   |-> [i \in 1 .. 4 |-> 0],
      secondReserved2          |-> [i \in 1 .. 2 |-> 0],
      lastActivityReference    |-> [i \in 1 .. 8 |-> 0],
      reserved52               |-> [i \in 1 .. 52 |-> 0] ]

(* Order Mod Out Message at zero, then each field in turn at the values it is checked at *)
CheckedOrderModOutMessage ==
    { ZeroOrderModOutMessage }
        \cup { [ZeroOrderModOutMessage EXCEPT !.participantType = one] : one \in Sample(1) }
        \cup { [ZeroOrderModOutMessage EXCEPT !.reserved1 = one] : one \in Sample(1) }
        \cup { [ZeroOrderModOutMessage EXCEPT !.competitorPeriod = one] : one \in Sample(2) }
        \cup { [ZeroOrderModOutMessage EXCEPT !.solicitorPeriod = one] : one \in Sample(2) }
        \cup { [ZeroOrderModOutMessage EXCEPT !.modifiedCancelledBy = one] : one \in Sample(1) }
        \cup { [ZeroOrderModOutMessage EXCEPT !.secondReserved1 = one] : one \in Sample(1) }
        \cup { [ZeroOrderModOutMessage EXCEPT !.reasonCode = one] : one \in Sample(2) }
        \cup { [ZeroOrderModOutMessage EXCEPT !.reserved4 = one] : one \in Sample(4) }
        \cup { [ZeroOrderModOutMessage EXCEPT !.tokenNo = one] : one \in Sample(4) }
        \cup { [ZeroOrderModOutMessage EXCEPT !.contractDesc = one] : one \in CheckedContractDesc3 }
        \cup { [ZeroOrderModOutMessage EXCEPT !.counterPartyBrokerId = one] : one \in Sample(5) }
        \cup { [ZeroOrderModOutMessage EXCEPT !.thirdReserved1 = one] : one \in Sample(1) }
        \cup { [ZeroOrderModOutMessage EXCEPT !.reserved2 = one] : one \in Sample(2) }
        \cup { [ZeroOrderModOutMessage EXCEPT !.closeoutFlag = one] : one \in Sample(1) }
        \cup { [ZeroOrderModOutMessage EXCEPT !.fourthReserved1 = one] : one \in Sample(1) }
        \cup { [ZeroOrderModOutMessage EXCEPT !.orderType = one] : one \in Sample(2) }
        \cup { [ZeroOrderModOutMessage EXCEPT !.orderNumber = one] : one \in Sample(8) }
        \cup { [ZeroOrderModOutMessage EXCEPT !.accountNumber = one] : one \in Sample(10) }
        \cup { [ZeroOrderModOutMessage EXCEPT !.bookTypeShort2 = one] : one \in Sample(2) }
        \cup { [ZeroOrderModOutMessage EXCEPT !.buySellIndicator = one] : one \in Sample(2) }
        \cup { [ZeroOrderModOutMessage EXCEPT !.disclosedVolume = one] : one \in Sample(4) }
        \cup { [ZeroOrderModOutMessage EXCEPT !.disclosedVolumeRemaining = one] : one \in Sample(4) }
        \cup { [ZeroOrderModOutMessage EXCEPT !.totalVolumeRemaining = one] : one \in Sample(4) }
        \cup { [ZeroOrderModOutMessage EXCEPT !.volume = one] : one \in Sample(4) }
        \cup { [ZeroOrderModOutMessage EXCEPT !.volumeFilledToday = one] : one \in Sample(4) }
        \cup { [ZeroOrderModOutMessage EXCEPT !.price = one] : one \in Sample(4) }
        \cup { [ZeroOrderModOutMessage EXCEPT !.triggerPrice = one] : one \in Sample(4) }
        \cup { [ZeroOrderModOutMessage EXCEPT !.goodTillDate = one] : one \in Sample(4) }
        \cup { [ZeroOrderModOutMessage EXCEPT !.entryDateTime = one] : one \in Sample(4) }
        \cup { [ZeroOrderModOutMessage EXCEPT !.minimumFillAonVolume = one] : one \in Sample(4) }
        \cup { [ZeroOrderModOutMessage EXCEPT !.lastModified = one] : one \in Sample(4) }
        \cup { [ZeroOrderModOutMessage EXCEPT !.stOrderFlags = one] : one \in Sample(2) }
        \cup { [ZeroOrderModOutMessage EXCEPT !.branchId = one] : one \in Sample(2) }
        \cup { [ZeroOrderModOutMessage EXCEPT !.traderId = one] : one \in Sample(4) }
        \cup { [ZeroOrderModOutMessage EXCEPT !.brokerId = one] : one \in Sample(5) }
        \cup { [ZeroOrderModOutMessage EXCEPT !.cOrdFiller = one] : one \in Sample(24) }
        \cup { [ZeroOrderModOutMessage EXCEPT !.openClose = one] : one \in Sample(1) }
        \cup { [ZeroOrderModOutMessage EXCEPT !.settlor = one] : one \in Sample(12) }
        \cup { [ZeroOrderModOutMessage EXCEPT !.proClientIndicator = one] : one \in Sample(2) }
        \cup { [ZeroOrderModOutMessage EXCEPT !.settlementPeriod = one] : one \in Sample(2) }
        \cup { [ZeroOrderModOutMessage EXCEPT !.additionalOrderFlags = one] : one \in Sample(1) }
        \cup { [ZeroOrderModOutMessage EXCEPT !.fifthReserved1 = one] : one \in Sample(1) }
        \cup { [ZeroOrderModOutMessage EXCEPT !.reference = one] : one \in Sample(4) }
        \cup { [ZeroOrderModOutMessage EXCEPT !.nnfField = one] : one \in Sample(8) }
        \cup { [ZeroOrderModOutMessage EXCEPT !.mktReplay = one] : one \in Sample(8) }
        \cup { [ZeroOrderModOutMessage EXCEPT !.pan = one] : one \in Sample(10) }
        \cup { [ZeroOrderModOutMessage EXCEPT !.algoId = one] : one \in Sample(4) }
        \cup { [ZeroOrderModOutMessage EXCEPT !.secondReserved2 = one] : one \in Sample(2) }
        \cup { [ZeroOrderModOutMessage EXCEPT !.lastActivityReference = one] : one \in Sample(8) }
        \cup { [ZeroOrderModOutMessage EXCEPT !.reserved52 = one] : one \in Sample(52) }

(***************************************************************************)
(* Contract Desc: 28 bytes                                                 *)
(***************************************************************************)

ContractDesc4 ==
    [ instrumentName : Sample(6),
      symbol         : Sample(10),
      expiryDate     : Sample(4),
      strikePrice    : Sample(4),
      optionType     : Sample(2),
      caLevel        : Sample(2) ]

EncodeContractDesc4(message) ==
    message.instrumentName
        \o message.symbol
        \o message.expiryDate
        \o message.strikePrice
        \o message.optionType
        \o message.caLevel

DecodeContractDesc4(bytes) ==
    LET instrumentName == ReadBytes(bytes, 6) IN IF ~instrumentName.ok THEN Fail ELSE
    LET symbol == ReadBytes(instrumentName.rest, 10) IN IF ~symbol.ok THEN Fail ELSE
    LET expiryDate == ReadBytes(symbol.rest, 4) IN IF ~expiryDate.ok THEN Fail ELSE
    LET strikePrice == ReadBytes(expiryDate.rest, 4) IN IF ~strikePrice.ok THEN Fail ELSE
    LET optionType == ReadBytes(strikePrice.rest, 2) IN IF ~optionType.ok THEN Fail ELSE
    LET caLevel == ReadBytes(optionType.rest, 2) IN IF ~caLevel.ok THEN Fail ELSE
    Ok([ instrumentName |-> instrumentName.value,
         symbol         |-> symbol.value,
         expiryDate     |-> expiryDate.value,
         strikePrice    |-> strikePrice.value,
         optionType     |-> optionType.value,
         caLevel        |-> caLevel.value ], caLevel.rest)

ZeroContractDesc4 ==
    [ instrumentName |-> [i \in 1 .. 6 |-> 0],
      symbol         |-> [i \in 1 .. 10 |-> 0],
      expiryDate     |-> [i \in 1 .. 4 |-> 0],
      strikePrice    |-> [i \in 1 .. 4 |-> 0],
      optionType     |-> [i \in 1 .. 2 |-> 0],
      caLevel        |-> [i \in 1 .. 2 |-> 0] ]

(* Contract Desc at zero, then each field in turn at the values it is checked at *)
CheckedContractDesc4 ==
    { ZeroContractDesc4 }
        \cup { [ZeroContractDesc4 EXCEPT !.instrumentName = one] : one \in Sample(6) }
        \cup { [ZeroContractDesc4 EXCEPT !.symbol = one] : one \in Sample(10) }
        \cup { [ZeroContractDesc4 EXCEPT !.expiryDate = one] : one \in Sample(4) }
        \cup { [ZeroContractDesc4 EXCEPT !.strikePrice = one] : one \in Sample(4) }
        \cup { [ZeroContractDesc4 EXCEPT !.optionType = one] : one \in Sample(2) }
        \cup { [ZeroContractDesc4 EXCEPT !.caLevel = one] : one \in Sample(2) }

(***************************************************************************)
(* Order Mod Reject Message: 276 bytes                                     *)
(***************************************************************************)

OrderModRejectMessage ==
    [ participantType          : Sample(1),
      reserved1                : Sample(1),
      competitorPeriod         : Sample(2),
      solicitorPeriod          : Sample(2),
      modifiedCancelledBy      : Sample(1),
      secondReserved1          : Sample(1),
      reasonCode               : Sample(2),
      reserved4                : Sample(4),
      tokenNo                  : Sample(4),
      contractDesc             : ContractDesc4,
      counterPartyBrokerId     : Sample(5),
      thirdReserved1           : Sample(1),
      reserved2                : Sample(2),
      closeoutFlag             : Sample(1),
      fourthReserved1          : Sample(1),
      orderType                : Sample(2),
      orderNumber              : Sample(8),
      accountNumber            : Sample(10),
      bookTypeShort2           : Sample(2),
      buySellIndicator         : Sample(2),
      disclosedVolume          : Sample(4),
      disclosedVolumeRemaining : Sample(4),
      totalVolumeRemaining     : Sample(4),
      volume                   : Sample(4),
      volumeFilledToday        : Sample(4),
      price                    : Sample(4),
      triggerPrice             : Sample(4),
      goodTillDate             : Sample(4),
      entryDateTime            : Sample(4),
      minimumFillAonVolume     : Sample(4),
      lastModified             : Sample(4),
      stOrderFlags             : Sample(2),
      branchId                 : Sample(2),
      traderId                 : Sample(4),
      brokerId                 : Sample(5),
      cOrdFiller               : Sample(24),
      openClose                : Sample(1),
      settlor                  : Sample(12),
      proClientIndicator       : Sample(2),
      settlementPeriod         : Sample(2),
      additionalOrderFlags     : Sample(1),
      fifthReserved1           : Sample(1),
      reference                : Sample(4),
      nnfField                 : Sample(8),
      mktReplay                : Sample(8),
      pan                      : Sample(10),
      algoId                   : Sample(4),
      secondReserved2          : Sample(2),
      lastActivityReference    : Sample(8),
      reserved52               : Sample(52) ]

EncodeOrderModRejectMessage(message) ==
    message.participantType
        \o message.reserved1
        \o message.competitorPeriod
        \o message.solicitorPeriod
        \o message.modifiedCancelledBy
        \o message.secondReserved1
        \o message.reasonCode
        \o message.reserved4
        \o message.tokenNo
        \o EncodeContractDesc4(message.contractDesc)
        \o message.counterPartyBrokerId
        \o message.thirdReserved1
        \o message.reserved2
        \o message.closeoutFlag
        \o message.fourthReserved1
        \o message.orderType
        \o message.orderNumber
        \o message.accountNumber
        \o message.bookTypeShort2
        \o message.buySellIndicator
        \o message.disclosedVolume
        \o message.disclosedVolumeRemaining
        \o message.totalVolumeRemaining
        \o message.volume
        \o message.volumeFilledToday
        \o message.price
        \o message.triggerPrice
        \o message.goodTillDate
        \o message.entryDateTime
        \o message.minimumFillAonVolume
        \o message.lastModified
        \o message.stOrderFlags
        \o message.branchId
        \o message.traderId
        \o message.brokerId
        \o message.cOrdFiller
        \o message.openClose
        \o message.settlor
        \o message.proClientIndicator
        \o message.settlementPeriod
        \o message.additionalOrderFlags
        \o message.fifthReserved1
        \o message.reference
        \o message.nnfField
        \o message.mktReplay
        \o message.pan
        \o message.algoId
        \o message.secondReserved2
        \o message.lastActivityReference
        \o message.reserved52

DecodeOrderModRejectMessage(bytes) ==
    LET participantType == ReadBytes(bytes, 1) IN IF ~participantType.ok THEN Fail ELSE
    LET reserved1 == ReadBytes(participantType.rest, 1) IN IF ~reserved1.ok THEN Fail ELSE
    LET competitorPeriod == ReadBytes(reserved1.rest, 2) IN IF ~competitorPeriod.ok THEN Fail ELSE
    LET solicitorPeriod == ReadBytes(competitorPeriod.rest, 2) IN IF ~solicitorPeriod.ok THEN Fail ELSE
    LET modifiedCancelledBy == ReadBytes(solicitorPeriod.rest, 1) IN IF ~modifiedCancelledBy.ok THEN Fail ELSE
    LET secondReserved1 == ReadBytes(modifiedCancelledBy.rest, 1) IN IF ~secondReserved1.ok THEN Fail ELSE
    LET reasonCode == ReadBytes(secondReserved1.rest, 2) IN IF ~reasonCode.ok THEN Fail ELSE
    LET reserved4 == ReadBytes(reasonCode.rest, 4) IN IF ~reserved4.ok THEN Fail ELSE
    LET tokenNo == ReadBytes(reserved4.rest, 4) IN IF ~tokenNo.ok THEN Fail ELSE
    LET contractDesc == DecodeContractDesc4(tokenNo.rest) IN IF ~contractDesc.ok THEN Fail ELSE
    LET counterPartyBrokerId == ReadBytes(contractDesc.rest, 5) IN IF ~counterPartyBrokerId.ok THEN Fail ELSE
    LET thirdReserved1 == ReadBytes(counterPartyBrokerId.rest, 1) IN IF ~thirdReserved1.ok THEN Fail ELSE
    LET reserved2 == ReadBytes(thirdReserved1.rest, 2) IN IF ~reserved2.ok THEN Fail ELSE
    LET closeoutFlag == ReadBytes(reserved2.rest, 1) IN IF ~closeoutFlag.ok THEN Fail ELSE
    LET fourthReserved1 == ReadBytes(closeoutFlag.rest, 1) IN IF ~fourthReserved1.ok THEN Fail ELSE
    LET orderType == ReadBytes(fourthReserved1.rest, 2) IN IF ~orderType.ok THEN Fail ELSE
    LET orderNumber == ReadBytes(orderType.rest, 8) IN IF ~orderNumber.ok THEN Fail ELSE
    LET accountNumber == ReadBytes(orderNumber.rest, 10) IN IF ~accountNumber.ok THEN Fail ELSE
    LET bookTypeShort2 == ReadBytes(accountNumber.rest, 2) IN IF ~bookTypeShort2.ok THEN Fail ELSE
    LET buySellIndicator == ReadBytes(bookTypeShort2.rest, 2) IN IF ~buySellIndicator.ok THEN Fail ELSE
    LET disclosedVolume == ReadBytes(buySellIndicator.rest, 4) IN IF ~disclosedVolume.ok THEN Fail ELSE
    LET disclosedVolumeRemaining == ReadBytes(disclosedVolume.rest, 4) IN IF ~disclosedVolumeRemaining.ok THEN Fail ELSE
    LET totalVolumeRemaining == ReadBytes(disclosedVolumeRemaining.rest, 4) IN IF ~totalVolumeRemaining.ok THEN Fail ELSE
    LET volume == ReadBytes(totalVolumeRemaining.rest, 4) IN IF ~volume.ok THEN Fail ELSE
    LET volumeFilledToday == ReadBytes(volume.rest, 4) IN IF ~volumeFilledToday.ok THEN Fail ELSE
    LET price == ReadBytes(volumeFilledToday.rest, 4) IN IF ~price.ok THEN Fail ELSE
    LET triggerPrice == ReadBytes(price.rest, 4) IN IF ~triggerPrice.ok THEN Fail ELSE
    LET goodTillDate == ReadBytes(triggerPrice.rest, 4) IN IF ~goodTillDate.ok THEN Fail ELSE
    LET entryDateTime == ReadBytes(goodTillDate.rest, 4) IN IF ~entryDateTime.ok THEN Fail ELSE
    LET minimumFillAonVolume == ReadBytes(entryDateTime.rest, 4) IN IF ~minimumFillAonVolume.ok THEN Fail ELSE
    LET lastModified == ReadBytes(minimumFillAonVolume.rest, 4) IN IF ~lastModified.ok THEN Fail ELSE
    LET stOrderFlags == ReadBytes(lastModified.rest, 2) IN IF ~stOrderFlags.ok THEN Fail ELSE
    LET branchId == ReadBytes(stOrderFlags.rest, 2) IN IF ~branchId.ok THEN Fail ELSE
    LET traderId == ReadBytes(branchId.rest, 4) IN IF ~traderId.ok THEN Fail ELSE
    LET brokerId == ReadBytes(traderId.rest, 5) IN IF ~brokerId.ok THEN Fail ELSE
    LET cOrdFiller == ReadBytes(brokerId.rest, 24) IN IF ~cOrdFiller.ok THEN Fail ELSE
    LET openClose == ReadBytes(cOrdFiller.rest, 1) IN IF ~openClose.ok THEN Fail ELSE
    LET settlor == ReadBytes(openClose.rest, 12) IN IF ~settlor.ok THEN Fail ELSE
    LET proClientIndicator == ReadBytes(settlor.rest, 2) IN IF ~proClientIndicator.ok THEN Fail ELSE
    LET settlementPeriod == ReadBytes(proClientIndicator.rest, 2) IN IF ~settlementPeriod.ok THEN Fail ELSE
    LET additionalOrderFlags == ReadBytes(settlementPeriod.rest, 1) IN IF ~additionalOrderFlags.ok THEN Fail ELSE
    LET fifthReserved1 == ReadBytes(additionalOrderFlags.rest, 1) IN IF ~fifthReserved1.ok THEN Fail ELSE
    LET reference == ReadBytes(fifthReserved1.rest, 4) IN IF ~reference.ok THEN Fail ELSE
    LET nnfField == ReadBytes(reference.rest, 8) IN IF ~nnfField.ok THEN Fail ELSE
    LET mktReplay == ReadBytes(nnfField.rest, 8) IN IF ~mktReplay.ok THEN Fail ELSE
    LET pan == ReadBytes(mktReplay.rest, 10) IN IF ~pan.ok THEN Fail ELSE
    LET algoId == ReadBytes(pan.rest, 4) IN IF ~algoId.ok THEN Fail ELSE
    LET secondReserved2 == ReadBytes(algoId.rest, 2) IN IF ~secondReserved2.ok THEN Fail ELSE
    LET lastActivityReference == ReadBytes(secondReserved2.rest, 8) IN IF ~lastActivityReference.ok THEN Fail ELSE
    LET reserved52 == ReadBytes(lastActivityReference.rest, 52) IN IF ~reserved52.ok THEN Fail ELSE
    Ok([ participantType          |-> participantType.value,
         reserved1                |-> reserved1.value,
         competitorPeriod         |-> competitorPeriod.value,
         solicitorPeriod          |-> solicitorPeriod.value,
         modifiedCancelledBy      |-> modifiedCancelledBy.value,
         secondReserved1          |-> secondReserved1.value,
         reasonCode               |-> reasonCode.value,
         reserved4                |-> reserved4.value,
         tokenNo                  |-> tokenNo.value,
         contractDesc             |-> contractDesc.value,
         counterPartyBrokerId     |-> counterPartyBrokerId.value,
         thirdReserved1           |-> thirdReserved1.value,
         reserved2                |-> reserved2.value,
         closeoutFlag             |-> closeoutFlag.value,
         fourthReserved1          |-> fourthReserved1.value,
         orderType                |-> orderType.value,
         orderNumber              |-> orderNumber.value,
         accountNumber            |-> accountNumber.value,
         bookTypeShort2           |-> bookTypeShort2.value,
         buySellIndicator         |-> buySellIndicator.value,
         disclosedVolume          |-> disclosedVolume.value,
         disclosedVolumeRemaining |-> disclosedVolumeRemaining.value,
         totalVolumeRemaining     |-> totalVolumeRemaining.value,
         volume                   |-> volume.value,
         volumeFilledToday        |-> volumeFilledToday.value,
         price                    |-> price.value,
         triggerPrice             |-> triggerPrice.value,
         goodTillDate             |-> goodTillDate.value,
         entryDateTime            |-> entryDateTime.value,
         minimumFillAonVolume     |-> minimumFillAonVolume.value,
         lastModified             |-> lastModified.value,
         stOrderFlags             |-> stOrderFlags.value,
         branchId                 |-> branchId.value,
         traderId                 |-> traderId.value,
         brokerId                 |-> brokerId.value,
         cOrdFiller               |-> cOrdFiller.value,
         openClose                |-> openClose.value,
         settlor                  |-> settlor.value,
         proClientIndicator       |-> proClientIndicator.value,
         settlementPeriod         |-> settlementPeriod.value,
         additionalOrderFlags     |-> additionalOrderFlags.value,
         fifthReserved1           |-> fifthReserved1.value,
         reference                |-> reference.value,
         nnfField                 |-> nnfField.value,
         mktReplay                |-> mktReplay.value,
         pan                      |-> pan.value,
         algoId                   |-> algoId.value,
         secondReserved2          |-> secondReserved2.value,
         lastActivityReference    |-> lastActivityReference.value,
         reserved52               |-> reserved52.value ], reserved52.rest)

ZeroOrderModRejectMessage ==
    [ participantType          |-> [i \in 1 .. 1 |-> 0],
      reserved1                |-> [i \in 1 .. 1 |-> 0],
      competitorPeriod         |-> [i \in 1 .. 2 |-> 0],
      solicitorPeriod          |-> [i \in 1 .. 2 |-> 0],
      modifiedCancelledBy      |-> [i \in 1 .. 1 |-> 0],
      secondReserved1          |-> [i \in 1 .. 1 |-> 0],
      reasonCode               |-> [i \in 1 .. 2 |-> 0],
      reserved4                |-> [i \in 1 .. 4 |-> 0],
      tokenNo                  |-> [i \in 1 .. 4 |-> 0],
      contractDesc             |-> ZeroContractDesc4,
      counterPartyBrokerId     |-> [i \in 1 .. 5 |-> 0],
      thirdReserved1           |-> [i \in 1 .. 1 |-> 0],
      reserved2                |-> [i \in 1 .. 2 |-> 0],
      closeoutFlag             |-> [i \in 1 .. 1 |-> 0],
      fourthReserved1          |-> [i \in 1 .. 1 |-> 0],
      orderType                |-> [i \in 1 .. 2 |-> 0],
      orderNumber              |-> [i \in 1 .. 8 |-> 0],
      accountNumber            |-> [i \in 1 .. 10 |-> 0],
      bookTypeShort2           |-> [i \in 1 .. 2 |-> 0],
      buySellIndicator         |-> [i \in 1 .. 2 |-> 0],
      disclosedVolume          |-> [i \in 1 .. 4 |-> 0],
      disclosedVolumeRemaining |-> [i \in 1 .. 4 |-> 0],
      totalVolumeRemaining     |-> [i \in 1 .. 4 |-> 0],
      volume                   |-> [i \in 1 .. 4 |-> 0],
      volumeFilledToday        |-> [i \in 1 .. 4 |-> 0],
      price                    |-> [i \in 1 .. 4 |-> 0],
      triggerPrice             |-> [i \in 1 .. 4 |-> 0],
      goodTillDate             |-> [i \in 1 .. 4 |-> 0],
      entryDateTime            |-> [i \in 1 .. 4 |-> 0],
      minimumFillAonVolume     |-> [i \in 1 .. 4 |-> 0],
      lastModified             |-> [i \in 1 .. 4 |-> 0],
      stOrderFlags             |-> [i \in 1 .. 2 |-> 0],
      branchId                 |-> [i \in 1 .. 2 |-> 0],
      traderId                 |-> [i \in 1 .. 4 |-> 0],
      brokerId                 |-> [i \in 1 .. 5 |-> 0],
      cOrdFiller               |-> [i \in 1 .. 24 |-> 0],
      openClose                |-> [i \in 1 .. 1 |-> 0],
      settlor                  |-> [i \in 1 .. 12 |-> 0],
      proClientIndicator       |-> [i \in 1 .. 2 |-> 0],
      settlementPeriod         |-> [i \in 1 .. 2 |-> 0],
      additionalOrderFlags     |-> [i \in 1 .. 1 |-> 0],
      fifthReserved1           |-> [i \in 1 .. 1 |-> 0],
      reference                |-> [i \in 1 .. 4 |-> 0],
      nnfField                 |-> [i \in 1 .. 8 |-> 0],
      mktReplay                |-> [i \in 1 .. 8 |-> 0],
      pan                      |-> [i \in 1 .. 10 |-> 0],
      algoId                   |-> [i \in 1 .. 4 |-> 0],
      secondReserved2          |-> [i \in 1 .. 2 |-> 0],
      lastActivityReference    |-> [i \in 1 .. 8 |-> 0],
      reserved52               |-> [i \in 1 .. 52 |-> 0] ]

(* Order Mod Reject Message at zero, then each field in turn at the values it is checked at *)
CheckedOrderModRejectMessage ==
