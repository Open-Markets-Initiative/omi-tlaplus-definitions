CheckedMsSpdLegInfoLeg26 ==
    { ZeroMsSpdLegInfoLeg26 }
        \cup { [ZeroMsSpdLegInfoLeg26 EXCEPT !.token2 = one] : one \in Sample(4) }
        \cup { [ZeroMsSpdLegInfoLeg26 EXCEPT !.contractDesc = one] : one \in CheckedContractDesc30 }
        \cup { [ZeroMsSpdLegInfoLeg26 EXCEPT !.opBrokerId2 = one] : one \in Sample(5) }
