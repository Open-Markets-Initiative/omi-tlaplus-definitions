(* Twol Order Error Message at zero, then each field in turn at the values it is checked at *)
CheckedTwolOrderErrorMessage ==
    { ZeroTwolOrderErrorMessage }
        \cup { [ZeroTwolOrderErrorMessage EXCEPT !.participantType1 = one] : one \in Sample(1) }
        \cup { [ZeroTwolOrderErrorMessage EXCEPT !.filler1 = one] : one \in Sample(1) }
        \cup { [ZeroTwolOrderErrorMessage EXCEPT !.competitorPeriod1 = one] : one \in Sample(2) }
        \cup { [ZeroTwolOrderErrorMessage EXCEPT !.solicitorPeriod1 = one] : one \in Sample(2) }
        \cup { [ZeroTwolOrderErrorMessage EXCEPT !.modCxlBy1 = one] : one \in Sample(1) }
        \cup { [ZeroTwolOrderErrorMessage EXCEPT !.filler9 = one] : one \in Sample(1) }
        \cup { [ZeroTwolOrderErrorMessage EXCEPT !.reasonCode1 = one] : one \in Sample(2) }
        \cup { [ZeroTwolOrderErrorMessage EXCEPT !.startAlpha1 = one] : one \in Sample(2) }
        \cup { [ZeroTwolOrderErrorMessage EXCEPT !.endAlpha1 = one] : one \in Sample(2) }
        \cup { [ZeroTwolOrderErrorMessage EXCEPT !.token1 = one] : one \in Sample(4) }
        \cup { [ZeroTwolOrderErrorMessage EXCEPT !.contractDesc = one] : one \in CheckedContractDesc56 }
        \cup { [ZeroTwolOrderErrorMessage EXCEPT !.opBrokerId1 = one] : one \in Sample(5) }
        \cup { [ZeroTwolOrderErrorMessage EXCEPT !.fillerx1 = one] : one \in Sample(1) }
        \cup { [ZeroTwolOrderErrorMessage EXCEPT !.fillerOptions1 = one] : one \in Sample(3) }
        \cup { [ZeroTwolOrderErrorMessage EXCEPT !.fillery1 = one] : one \in Sample(1) }
        \cup { [ZeroTwolOrderErrorMessage EXCEPT !.orderType1 = one] : one \in Sample(2) }
        \cup { [ZeroTwolOrderErrorMessage EXCEPT !.orderNumber1 = one] : one \in Sample(8) }
        \cup { [ZeroTwolOrderErrorMessage EXCEPT !.accountNumber1 = one] : one \in Sample(10) }
        \cup { [ZeroTwolOrderErrorMessage EXCEPT !.bookType1 = one] : one \in Sample(2) }
        \cup { [ZeroTwolOrderErrorMessage EXCEPT !.buySell1 = one] : one \in Sample(2) }
