        \cup { [ZeroSpOrderModRejOutMessage EXCEPT !.participantType1 = one] : one \in Sample(1) }
        \cup { [ZeroSpOrderModRejOutMessage EXCEPT !.filler1 = one] : one \in Sample(1) }
        \cup { [ZeroSpOrderModRejOutMessage EXCEPT !.competitorPeriod1 = one] : one \in Sample(2) }
