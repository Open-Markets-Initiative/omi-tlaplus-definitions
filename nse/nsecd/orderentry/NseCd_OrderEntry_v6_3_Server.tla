        \cup { [ZeroOrderModConfirmationMessage EXCEPT !.orderType = one] : one \in Sample(2) }
        \cup { [ZeroOrderModConfirmationMessage EXCEPT !.orderNumber = one] : one \in Sample(8) }
        \cup { [ZeroOrderModConfirmationMessage EXCEPT !.accountNumber = one] : one \in Sample(10) }
        \cup { [ZeroOrderModConfirmationMessage EXCEPT !.bookTypeShort2 = one] : one \in Sample(2) }
        \cup { [ZeroOrderModConfirmationMessage EXCEPT !.buySellIndicator = one] : one \in Sample(2) }
        \cup { [ZeroOrderModConfirmationMessage EXCEPT !.disclosedVolume = one] : one \in Sample(4) }
        \cup { [ZeroOrderModConfirmationMessage EXCEPT !.disclosedVolumeRemaining = one] : one \in Sample(4) }
        \cup { [ZeroOrderModConfirmationMessage EXCEPT !.totalVolumeRemaining = one] : one \in Sample(4) }
        \cup { [ZeroOrderModConfirmationMessage EXCEPT !.volume = one] : one \in Sample(4) }
        \cup { [ZeroOrderModConfirmationMessage EXCEPT !.volumeFilledToday = one] : one \in Sample(4) }
        \cup { [ZeroOrderModConfirmationMessage EXCEPT !.price = one] : one \in Sample(4) }
        \cup { [ZeroOrderModConfirmationMessage EXCEPT !.triggerPrice = one] : one \in Sample(4) }
        \cup { [ZeroOrderModConfirmationMessage EXCEPT !.goodTillDate = one] : one \in Sample(4) }
        \cup { [ZeroOrderModConfirmationMessage EXCEPT !.entryDateTime = one] : one \in Sample(4) }
        \cup { [ZeroOrderModConfirmationMessage EXCEPT !.minimumFillAonVolume = one] : one \in Sample(4) }
        \cup { [ZeroOrderModConfirmationMessage EXCEPT !.lastModified = one] : one \in Sample(4) }
        \cup { [ZeroOrderModConfirmationMessage EXCEPT !.stOrderFlags = one] : one \in Sample(2) }
        \cup { [ZeroOrderModConfirmationMessage EXCEPT !.branchId = one] : one \in Sample(2) }
        \cup { [ZeroOrderModConfirmationMessage EXCEPT !.traderId = one] : one \in Sample(4) }
        \cup { [ZeroOrderModConfirmationMessage EXCEPT !.brokerId = one] : one \in Sample(5) }
        \cup { [ZeroOrderModConfirmationMessage EXCEPT !.cOrdFiller = one] : one \in Sample(24) }
        \cup { [ZeroOrderModConfirmationMessage EXCEPT !.openClose = one] : one \in Sample(1) }
        \cup { [ZeroOrderModConfirmationMessage EXCEPT !.settlor = one] : one \in Sample(12) }
        \cup { [ZeroOrderModConfirmationMessage EXCEPT !.proClientIndicator = one] : one \in Sample(2) }
        \cup { [ZeroOrderModConfirmationMessage EXCEPT !.settlementPeriod = one] : one \in Sample(2) }
        \cup { [ZeroOrderModConfirmationMessage EXCEPT !.additionalOrderFlags = one] : one \in Sample(1) }
        \cup { [ZeroOrderModConfirmationMessage EXCEPT !.fifthReserved1 = one] : one \in Sample(1) }
        \cup { [ZeroOrderModConfirmationMessage EXCEPT !.reference = one] : one \in Sample(4) }
        \cup { [ZeroOrderModConfirmationMessage EXCEPT !.nnfField = one] : one \in Sample(8) }
        \cup { [ZeroOrderModConfirmationMessage EXCEPT !.mktReplay = one] : one \in Sample(8) }
