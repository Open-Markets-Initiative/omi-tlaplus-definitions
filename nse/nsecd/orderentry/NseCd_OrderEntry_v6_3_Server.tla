CheckedContractDesc32 ==
    { ZeroContractDesc32 }
        \cup { [ZeroContractDesc32 EXCEPT !.instrumentName = one] : one \in Sample(6) }
        \cup { [ZeroContractDesc32 EXCEPT !.symbol = one] : one \in Sample(10) }
        \cup { [ZeroContractDesc32 EXCEPT !.expiryDate = one] : one \in Sample(4) }
