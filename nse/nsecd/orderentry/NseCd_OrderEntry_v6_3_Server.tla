      [] message.tag = SecureBoxRegistrationReMessageCode -> EncodeSecureBoxRegistrationReMessage(message.body)
      [] message.tag = SecureBoxRegistrationReMessageCode2 -> EncodeSecureBoxRegistrationReMessage(message.body)

DecodeServerMessagePayload(tag, bytes) ==
    LET read ==
            CASE tag = SystemInformationOutMessageCode -> DecodeSystemInformationOutMessage(bytes)
              [] tag = PartialSystemInformationMessageCode -> DecodePartialSystemInformationMessage(bytes)
              [] tag = OpenOrderReportMessageCode -> DecodeOpenOrderReportMessage(bytes)
              [] tag = SpreadOrderLogReportMessageCode -> DecodeSpreadOrderLogReportMessage(bytes)
              [] tag = SpreadTradeReportMessageCode -> DecodeSpreadTradeReportMessage(bytes)
              [] tag = BoardLotOutMessageCode -> DecodeBoardLotOutMessage(bytes)
              [] tag = NegOrderToBlMessageCode -> DecodeNegOrderToBlMessage(bytes)
              [] tag = OrderModOutMessageCode -> DecodeOrderModOutMessage(bytes)
              [] tag = OrderModRejectMessageCode -> DecodeOrderModRejectMessage(bytes)
              [] tag = OrderCancelOutMessageCode -> DecodeOrderCancelOutMessage(bytes)
              [] tag = OrderCancelRejectMessageCode -> DecodeOrderCancelRejectMessage(bytes)
              [] tag = OrderConfirmationMessageCode -> DecodeOrderConfirmationMessage(bytes)
              [] tag = OrderModConfirmationMessageCode -> DecodeOrderModConfirmationMessage(bytes)
              [] tag = OrderCancelConfirmationMessageCode -> DecodeOrderCancelConfirmationMessage(bytes)
              [] tag = CancelNegOrderMessageCode -> DecodeCancelNegOrderMessage(bytes)
              [] tag = FreezeToControlMessageCode -> DecodeFreezeToControlMessage(bytes)
              [] tag = OrderErrorMessageCode -> DecodeOrderErrorMessage(bytes)
              [] tag = BatchOrderCancelMessageCode -> DecodeBatchOrderCancelMessage(bytes)
              [] tag = SpBoardLotOutMessageCode -> DecodeSpBoardLotOutMessage(bytes)
              [] tag = TwolBoardLotOutMessageCode -> DecodeTwolBoardLotOutMessage(bytes)
              [] tag = ThrlBoardLotOutMessageCode -> DecodeThrlBoardLotOutMessage(bytes)
              [] tag = SpOrderCancelOutMessageCode -> DecodeSpOrderCancelOutMessage(bytes)
              [] tag = SpOrderModOutMessageCode -> DecodeSpOrderModOutMessage(bytes)
              [] tag = SpOrderConfirmationMessageCode -> DecodeSpOrderConfirmationMessage(bytes)
              [] tag = TwolOrderConfirmationMessageCode -> DecodeTwolOrderConfirmationMessage(bytes)
              [] tag = ThrlOrderConfirmationMessageCode -> DecodeThrlOrderConfirmationMessage(bytes)
              [] tag = SpOrderCxlRejOutMessageCode -> DecodeSpOrderCxlRejOutMessage(bytes)
              [] tag = SpOrderCxlConfirmationMessageCode -> DecodeSpOrderCxlConfirmationMessage(bytes)
              [] tag = TwolOrderCxlConfirmatiMessageCode -> DecodeTwolOrderCxlConfirmatiMessage(bytes)
              [] tag = ThrlOrderCxlConfirmatiMessageCode -> DecodeThrlOrderCxlConfirmatiMessage(bytes)
              [] tag = SpOrderModRejOutMessageCode -> DecodeSpOrderModRejOutMessage(bytes)
              [] tag = SpOrderModConOutMessageCode -> DecodeSpOrderModConOutMessage(bytes)
              [] tag = TwolOrderErrorMessageCode -> DecodeTwolOrderErrorMessage(bytes)
              [] tag = ThrlOrderErrorMessageCode -> DecodeThrlOrderErrorMessage(bytes)
              [] tag = OnStopNotificationMessageCode -> DecodeOnStopNotificationMessage(bytes)
              [] tag = TradeConfirmationMessageCode -> DecodeTradeConfirmationMessage(bytes)
              [] tag = TradeCancelConfirmMessageCode -> DecodeTradeCancelConfirmMessage(bytes)
              [] tag = TradeCancelRejectMessageCode -> DecodeTradeCancelRejectMessage(bytes)
              [] tag = TradeModifyRejectMessageCode -> DecodeTradeModifyRejectMessage(bytes)
              [] tag = TradeErrorMessageCode -> DecodeTradeErrorMessage(bytes)
              [] tag = TradeCancelOutMessageCode -> DecodeTradeCancelOutMessage(bytes)
              [] tag = TradeModifyConfirmMessageCode -> DecodeTradeModifyConfirmMessage(bytes)
              [] tag = SignOnRequestOutMessageCode -> DecodeSignOnRequestOutMessage(bytes)
              [] tag = SignOffTraderOutMessageCode -> DecodeSignOffTraderOutMessage(bytes)
              [] tag = ErrorResponseOutMessageCode -> DecodeErrorResponseOutMessage(bytes)
              [] tag = GrResponseMessageCode -> DecodeGrResponseMessage(bytes)
              [] tag = GiveupAppConfirmTmMessageCode -> DecodeGiveupAppConfirmTmMessage(bytes)
              [] tag = GiveupRejConfirmTmMessageCode -> DecodeGiveupRejConfirmTmMessage(bytes)
              [] tag = UserAddrUnlockConfirmOutMessageCode -> DecodeUserAddrUnlockConfirmOutMessage(bytes)
              [] tag = UserAddrUnlockApproveOutMessageCode -> DecodeUserAddrUnlockApproveOutMessage(bytes)
              [] tag = UserAddrUnlockRejectOMessageCode -> DecodeUserAddrUnlockRejectOMessage(bytes)
              [] tag = BranchOrdValLimitUpdaMessageCode -> DecodeBranchOrdValLimitUpdaMessage(bytes)
              [] tag = UserOrderLimitUpdateOutMessageCode -> DecodeUserOrderLimitUpdateOutMessage(bytes)
              [] tag = DealerLimitUpdateOutMessageCode -> DecodeDealerLimitUpdateOutMessage(bytes)
              [] tag = ResetUserPasswordOutMessageCode -> DecodeResetUserPasswordOutMessage(bytes)
              [] tag = ColUserStatusChangeOutMessageCode -> DecodeColUserStatusChangeOutMessage(bytes)
              [] tag = SpdOrdLimitUpdateOutMessageCode -> DecodeSpdOrdLimitUpdateOutMessage(bytes)
              [] tag = UpdateLocaldbHeaderMessageCode -> DecodeUpdateLocaldbHeaderMessage(bytes)
              [] tag = UpdateLocaldbTrailerMessageCode -> DecodeUpdateLocaldbTrailerMessage(bytes)
              [] tag = BcastAssetMstrChgMessageCode -> DecodeBcastAssetMstrChgMessage(bytes)
              [] tag = BoxSignOnRequestOutMessageCode -> DecodeBoxSignOnRequestOutMessage(bytes)
              [] tag = BoxSignOffMessageCode -> DecodeBoxSignOffMessage(bytes)
              [] tag = SecureBoxRegistrationReMessageCode -> DecodeSecureBoxRegistrationReMessage(bytes)
              [] tag = SecureBoxRegistrationReMessageCode2 -> DecodeSecureBoxRegistrationReMessage(bytes)
              [] OTHER -> Fail
    IN  IF ~read.ok THEN Fail ELSE Ok([tag |-> tag, body |-> read.value], read.rest)

ZeroServerMessagePayload == [tag |-> SystemInformationOutMessageCode, body |-> ZeroSystemInformationOutMessage]

(* Each Server Message Payload in turn, at the values the message it names is checked at *)
CheckedServerMessagePayload ==
    { [tag |-> SystemInformationOutMessageCode, body |-> one] : one \in CheckedSystemInformationOutMessage }
        \cup { [tag |-> PartialSystemInformationMessageCode, body |-> one] : one \in CheckedPartialSystemInformationMessage }
        \cup { [tag |-> OpenOrderReportMessageCode, body |-> one] : one \in CheckedOpenOrderReportMessage }
        \cup { [tag |-> SpreadOrderLogReportMessageCode, body |-> one] : one \in CheckedSpreadOrderLogReportMessage }
        \cup { [tag |-> SpreadTradeReportMessageCode, body |-> one] : one \in CheckedSpreadTradeReportMessage }
        \cup { [tag |-> BoardLotOutMessageCode, body |-> one] : one \in CheckedBoardLotOutMessage }
        \cup { [tag |-> NegOrderToBlMessageCode, body |-> one] : one \in CheckedNegOrderToBlMessage }
        \cup { [tag |-> OrderModOutMessageCode, body |-> one] : one \in CheckedOrderModOutMessage }
        \cup { [tag |-> OrderModRejectMessageCode, body |-> one] : one \in CheckedOrderModRejectMessage }
        \cup { [tag |-> OrderCancelOutMessageCode, body |-> one] : one \in CheckedOrderCancelOutMessage }
        \cup { [tag |-> OrderCancelRejectMessageCode, body |-> one] : one \in CheckedOrderCancelRejectMessage }
        \cup { [tag |-> OrderConfirmationMessageCode, body |-> one] : one \in CheckedOrderConfirmationMessage }
        \cup { [tag |-> OrderModConfirmationMessageCode, body |-> one] : one \in CheckedOrderModConfirmationMessage }
        \cup { [tag |-> OrderCancelConfirmationMessageCode, body |-> one] : one \in CheckedOrderCancelConfirmationMessage }
        \cup { [tag |-> CancelNegOrderMessageCode, body |-> one] : one \in CheckedCancelNegOrderMessage }
        \cup { [tag |-> FreezeToControlMessageCode, body |-> one] : one \in CheckedFreezeToControlMessage }
        \cup { [tag |-> OrderErrorMessageCode, body |-> one] : one \in CheckedOrderErrorMessage }
        \cup { [tag |-> BatchOrderCancelMessageCode, body |-> one] : one \in CheckedBatchOrderCancelMessage }
        \cup { [tag |-> SpBoardLotOutMessageCode, body |-> one] : one \in CheckedSpBoardLotOutMessage }
        \cup { [tag |-> TwolBoardLotOutMessageCode, body |-> one] : one \in CheckedTwolBoardLotOutMessage }
        \cup { [tag |-> ThrlBoardLotOutMessageCode, body |-> one] : one \in CheckedThrlBoardLotOutMessage }
        \cup { [tag |-> SpOrderCancelOutMessageCode, body |-> one] : one \in CheckedSpOrderCancelOutMessage }
        \cup { [tag |-> SpOrderModOutMessageCode, body |-> one] : one \in CheckedSpOrderModOutMessage }
        \cup { [tag |-> SpOrderConfirmationMessageCode, body |-> one] : one \in CheckedSpOrderConfirmationMessage }
