        \cup { [ZeroOrderCancelOutMessage EXCEPT !.stOrderFlags = one] : one \in Sample(2) }
        \cup { [ZeroOrderCancelOutMessage EXCEPT !.branchId = one] : one \in Sample(2) }
        \cup { [ZeroOrderCancelOutMessage EXCEPT !.traderId = one] : one \in Sample(4) }
        \cup { [ZeroOrderCancelOutMessage EXCEPT !.brokerId = one] : one \in Sample(5) }
        \cup { [ZeroOrderCancelOutMessage EXCEPT !.cOrdFiller = one] : one \in Sample(24) }
