        \cup { [ZeroContractDesc68 EXCEPT !.expiryDate = one] : one \in Sample(4) }
        \cup { [ZeroContractDesc68 EXCEPT !.strikePrice = one] : one \in Sample(4) }
        \cup { [ZeroContractDesc68 EXCEPT !.optionType = one] : one \in Sample(2) }
        \cup { [ZeroContractDesc68 EXCEPT !.caLevel = one] : one \in Sample(2) }

