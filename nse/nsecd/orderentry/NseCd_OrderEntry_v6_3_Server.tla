        \cup { [ZeroSpreadOrderLogReportMessage EXCEPT !.reportDate = one] : one \in Sample(4) }
        \cup { [ZeroSpreadOrderLogReportMessage EXCEPT !.userType = one] : one \in Sample(2) }
        \cup { [ZeroSpreadOrderLogReportMessage EXCEPT !.brokerId = one] : one \in Sample(5) }
        \cup { [ZeroSpreadOrderLogReportMessage EXCEPT !.firmName = one] : one \in Sample(25) }
        \cup { [ZeroSpreadOrderLogReportMessage EXCEPT !.traderNumber = one] : one \in Sample(4) }
        \cup { [ZeroSpreadOrderLogReportMessage EXCEPT !.traderName = one] : one \in Sample(26) }
        \cup { [ZeroSpreadOrderLogReportMessage EXCEPT !.reserved1 = one] : one \in Sample(1) }

