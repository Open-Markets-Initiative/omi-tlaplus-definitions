        \cup { [ZeroCancelNegOrderMessage EXCEPT !.traderId = one] : one \in Sample(4) }
        \cup { [ZeroCancelNegOrderMessage EXCEPT !.brokerId = one] : one \in Sample(5) }
        \cup { [ZeroCancelNegOrderMessage EXCEPT !.cOrdFiller = one] : one \in Sample(24) }
