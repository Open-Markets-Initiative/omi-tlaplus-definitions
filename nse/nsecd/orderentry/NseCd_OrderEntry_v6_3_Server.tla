      secondReserved2        : Sample(2),
      lastActivityReference  : Sample(8),
      reserved52             : Sample(52),
      priceDiff              : Sample(4),
      msSpdLegInfoLeg2       : MsSpdLegInfoLeg28,
      msSpdLegInfoLeg3       : MsSpdLegInfoLeg38 ]

