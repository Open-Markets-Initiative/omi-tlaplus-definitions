      msSpdLegInfoLeg3       : MsSpdLegInfoLeg312 ]

EncodeThrlOrderCxlConfirmatiMessage(message) ==
    message.participantType1
        \o message.filler1
        \o message.competitorPeriod1
        \o message.solicitorPeriod1
        \o message.modCxlBy1
        \o message.filler9
        \o message.reasonCode1
        \o message.startAlpha1
        \o message.endAlpha1
        \o message.token1
        \o EncodeContractDesc47(message.contractDesc)
        \o message.opBrokerId1
