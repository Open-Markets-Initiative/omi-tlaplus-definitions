(* Order Cancel Out Message at zero, then each field in turn at the values it is checked at *)
CheckedOrderCancelOutMessage ==
    { ZeroOrderCancelOutMessage }
        \cup { [ZeroOrderCancelOutMessage EXCEPT !.participantType = one] : one \in Sample(1) }
        \cup { [ZeroOrderCancelOutMessage EXCEPT !.reserved1 = one] : one \in Sample(1) }
        \cup { [ZeroOrderCancelOutMessage EXCEPT !.competitorPeriod = one] : one \in Sample(2) }
        \cup { [ZeroOrderCancelOutMessage EXCEPT !.solicitorPeriod = one] : one \in Sample(2) }
        \cup { [ZeroOrderCancelOutMessage EXCEPT !.modifiedCancelledBy = one] : one \in Sample(1) }
        \cup { [ZeroOrderCancelOutMessage EXCEPT !.secondReserved1 = one] : one \in Sample(1) }
        \cup { [ZeroOrderCancelOutMessage EXCEPT !.reasonCode = one] : one \in Sample(2) }
        \cup { [ZeroOrderCancelOutMessage EXCEPT !.reserved4 = one] : one \in Sample(4) }
        \cup { [ZeroOrderCancelOutMessage EXCEPT !.tokenNo = one] : one \in Sample(4) }
        \cup { [ZeroOrderCancelOutMessage EXCEPT !.contractDesc = one] : one \in CheckedContractDesc5 }
        \cup { [ZeroOrderCancelOutMessage EXCEPT !.counterPartyBrokerId = one] : one \in Sample(5) }
        \cup { [ZeroOrderCancelOutMessage EXCEPT !.thirdReserved1 = one] : one \in Sample(1) }
