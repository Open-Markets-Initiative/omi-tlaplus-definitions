        \cup { [tag |-> SpOrderCxlRejOutMessageCode, body |-> one] : one \in CheckedSpOrderCxlRejOutMessage }
        \cup { [tag |-> SpOrderCxlConfirmationMessageCode, body |-> one] : one \in CheckedSpOrderCxlConfirmationMessage }
        \cup { [tag |-> TwolOrderCxlConfirmatiMessageCode, body |-> one] : one \in CheckedTwolOrderCxlConfirmatiMessage }
        \cup { [tag |-> ThrlOrderCxlConfirmatiMessageCode, body |-> one] : one \in CheckedThrlOrderCxlConfirmatiMessage }
        \cup { [tag |-> SpOrderModRejOutMessageCode, body |-> one] : one \in CheckedSpOrderModRejOutMessage }
        \cup { [tag |-> SpOrderModConOutMessageCode, body |-> one] : one \in CheckedSpOrderModConOutMessage }
        \cup { [tag |-> TwolOrderErrorMessageCode, body |-> one] : one \in CheckedTwolOrderErrorMessage }
