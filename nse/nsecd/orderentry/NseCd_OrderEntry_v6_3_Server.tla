        \cup [ tag : {SecureBoxRegistrationReMessageCode}, body : SecureBoxRegistrationReMessage ]
        \cup [ tag : {SecureBoxRegistrationReMessageCode2}, body : SecureBoxRegistrationReMessage ]

EncodeServerMessagePayload(message) ==
    CASE message.tag = SystemInformationOutMessageCode -> EncodeSystemInformationOutMessage(message.body)
      [] message.tag = PartialSystemInformationMessageCode -> EncodePartialSystemInformationMessage(message.body)
      [] message.tag = OpenOrderReportMessageCode -> EncodeOpenOrderReportMessage(message.body)
      [] message.tag = SpreadOrderLogReportMessageCode -> EncodeSpreadOrderLogReportMessage(message.body)
      [] message.tag = SpreadTradeReportMessageCode -> EncodeSpreadTradeReportMessage(message.body)
      [] message.tag = BoardLotOutMessageCode -> EncodeBoardLotOutMessage(message.body)
      [] message.tag = NegOrderToBlMessageCode -> EncodeNegOrderToBlMessage(message.body)
      [] message.tag = OrderModOutMessageCode -> EncodeOrderModOutMessage(message.body)
      [] message.tag = OrderModRejectMessageCode -> EncodeOrderModRejectMessage(message.body)
      [] message.tag = OrderCancelOutMessageCode -> EncodeOrderCancelOutMessage(message.body)
      [] message.tag = OrderCancelRejectMessageCode -> EncodeOrderCancelRejectMessage(message.body)
      [] message.tag = OrderConfirmationMessageCode -> EncodeOrderConfirmationMessage(message.body)
      [] message.tag = OrderModConfirmationMessageCode -> EncodeOrderModConfirmationMessage(message.body)
      [] message.tag = OrderCancelConfirmationMessageCode -> EncodeOrderCancelConfirmationMessage(message.body)
      [] message.tag = CancelNegOrderMessageCode -> EncodeCancelNegOrderMessage(message.body)
      [] message.tag = FreezeToControlMessageCode -> EncodeFreezeToControlMessage(message.body)
      [] message.tag = OrderErrorMessageCode -> EncodeOrderErrorMessage(message.body)
      [] message.tag = BatchOrderCancelMessageCode -> EncodeBatchOrderCancelMessage(message.body)
      [] message.tag = SpBoardLotOutMessageCode -> EncodeSpBoardLotOutMessage(message.body)
      [] message.tag = TwolBoardLotOutMessageCode -> EncodeTwolBoardLotOutMessage(message.body)
      [] message.tag = ThrlBoardLotOutMessageCode -> EncodeThrlBoardLotOutMessage(message.body)
      [] message.tag = SpOrderCancelOutMessageCode -> EncodeSpOrderCancelOutMessage(message.body)
      [] message.tag = SpOrderModOutMessageCode -> EncodeSpOrderModOutMessage(message.body)
      [] message.tag = SpOrderConfirmationMessageCode -> EncodeSpOrderConfirmationMessage(message.body)
      [] message.tag = TwolOrderConfirmationMessageCode -> EncodeTwolOrderConfirmationMessage(message.body)
      [] message.tag = ThrlOrderConfirmationMessageCode -> EncodeThrlOrderConfirmationMessage(message.body)
      [] message.tag = SpOrderCxlRejOutMessageCode -> EncodeSpOrderCxlRejOutMessage(message.body)
      [] message.tag = SpOrderCxlConfirmationMessageCode -> EncodeSpOrderCxlConfirmationMessage(message.body)
      [] message.tag = TwolOrderCxlConfirmatiMessageCode -> EncodeTwolOrderCxlConfirmatiMessage(message.body)
      [] message.tag = ThrlOrderCxlConfirmatiMessageCode -> EncodeThrlOrderCxlConfirmatiMessage(message.body)
      [] message.tag = SpOrderModRejOutMessageCode -> EncodeSpOrderModRejOutMessage(message.body)
      [] message.tag = SpOrderModConOutMessageCode -> EncodeSpOrderModConOutMessage(message.body)
      [] message.tag = TwolOrderErrorMessageCode -> EncodeTwolOrderErrorMessage(message.body)
      [] message.tag = ThrlOrderErrorMessageCode -> EncodeThrlOrderErrorMessage(message.body)
      [] message.tag = OnStopNotificationMessageCode -> EncodeOnStopNotificationMessage(message.body)
      [] message.tag = TradeConfirmationMessageCode -> EncodeTradeConfirmationMessage(message.body)
      [] message.tag = TradeCancelConfirmMessageCode -> EncodeTradeCancelConfirmMessage(message.body)
      [] message.tag = TradeCancelRejectMessageCode -> EncodeTradeCancelRejectMessage(message.body)
      [] message.tag = TradeModifyRejectMessageCode -> EncodeTradeModifyRejectMessage(message.body)
      [] message.tag = TradeErrorMessageCode -> EncodeTradeErrorMessage(message.body)
      [] message.tag = TradeCancelOutMessageCode -> EncodeTradeCancelOutMessage(message.body)
      [] message.tag = TradeModifyConfirmMessageCode -> EncodeTradeModifyConfirmMessage(message.body)
      [] message.tag = SignOnRequestOutMessageCode -> EncodeSignOnRequestOutMessage(message.body)
      [] message.tag = SignOffTraderOutMessageCode -> EncodeSignOffTraderOutMessage(message.body)
      [] message.tag = ErrorResponseOutMessageCode -> EncodeErrorResponseOutMessage(message.body)
      [] message.tag = GrResponseMessageCode -> EncodeGrResponseMessage(message.body)
      [] message.tag = GiveupAppConfirmTmMessageCode -> EncodeGiveupAppConfirmTmMessage(message.body)
      [] message.tag = GiveupRejConfirmTmMessageCode -> EncodeGiveupRejConfirmTmMessage(message.body)
      [] message.tag = UserAddrUnlockConfirmOutMessageCode -> EncodeUserAddrUnlockConfirmOutMessage(message.body)
      [] message.tag = UserAddrUnlockApproveOutMessageCode -> EncodeUserAddrUnlockApproveOutMessage(message.body)
      [] message.tag = UserAddrUnlockRejectOMessageCode -> EncodeUserAddrUnlockRejectOMessage(message.body)
      [] message.tag = BranchOrdValLimitUpdaMessageCode -> EncodeBranchOrdValLimitUpdaMessage(message.body)
      [] message.tag = UserOrderLimitUpdateOutMessageCode -> EncodeUserOrderLimitUpdateOutMessage(message.body)
      [] message.tag = DealerLimitUpdateOutMessageCode -> EncodeDealerLimitUpdateOutMessage(message.body)
