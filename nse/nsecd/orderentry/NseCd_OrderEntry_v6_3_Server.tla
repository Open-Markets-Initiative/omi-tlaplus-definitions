      lastActivityReference    |-> [i \in 1 .. 8 |-> 0],
      reserved52               |-> [i \in 1 .. 52 |-> 0] ]

(* Order Error Message at zero, then each field in turn at the values it is checked at *)
CheckedOrderErrorMessage ==
    { ZeroOrderErrorMessage }
        \cup { [ZeroOrderErrorMessage EXCEPT !.participantType = one] : one \in Sample(1) }
        \cup { [ZeroOrderErrorMessage EXCEPT !.reserved1 = one] : one \in Sample(1) }
        \cup { [ZeroOrderErrorMessage EXCEPT !.competitorPeriod = one] : one \in Sample(2) }
        \cup { [ZeroOrderErrorMessage EXCEPT !.solicitorPeriod = one] : one \in Sample(2) }
        \cup { [ZeroOrderErrorMessage EXCEPT !.modifiedCancelledBy = one] : one \in Sample(1) }
        \cup { [ZeroOrderErrorMessage EXCEPT !.secondReserved1 = one] : one \in Sample(1) }
        \cup { [ZeroOrderErrorMessage EXCEPT !.reasonCode = one] : one \in Sample(2) }
        \cup { [ZeroOrderErrorMessage EXCEPT !.reserved4 = one] : one \in Sample(4) }
        \cup { [ZeroOrderErrorMessage EXCEPT !.tokenNo = one] : one \in Sample(4) }
        \cup { [ZeroOrderErrorMessage EXCEPT !.contractDesc = one] : one \in CheckedContractDesc12 }
        \cup { [ZeroOrderErrorMessage EXCEPT !.counterPartyBrokerId = one] : one \in Sample(5) }
        \cup { [ZeroOrderErrorMessage EXCEPT !.thirdReserved1 = one] : one \in Sample(1) }
        \cup { [ZeroOrderErrorMessage EXCEPT !.reserved2 = one] : one \in Sample(2) }
        \cup { [ZeroOrderErrorMessage EXCEPT !.closeoutFlag = one] : one \in Sample(1) }
        \cup { [ZeroOrderErrorMessage EXCEPT !.fourthReserved1 = one] : one \in Sample(1) }
        \cup { [ZeroOrderErrorMessage EXCEPT !.orderType = one] : one \in Sample(2) }
        \cup { [ZeroOrderErrorMessage EXCEPT !.orderNumber = one] : one \in Sample(8) }
        \cup { [ZeroOrderErrorMessage EXCEPT !.accountNumber = one] : one \in Sample(10) }
        \cup { [ZeroOrderErrorMessage EXCEPT !.bookTypeShort2 = one] : one \in Sample(2) }
        \cup { [ZeroOrderErrorMessage EXCEPT !.buySellIndicator = one] : one \in Sample(2) }
        \cup { [ZeroOrderErrorMessage EXCEPT !.disclosedVolume = one] : one \in Sample(4) }
        \cup { [ZeroOrderErrorMessage EXCEPT !.disclosedVolumeRemaining = one] : one \in Sample(4) }
        \cup { [ZeroOrderErrorMessage EXCEPT !.totalVolumeRemaining = one] : one \in Sample(4) }
        \cup { [ZeroOrderErrorMessage EXCEPT !.volume = one] : one \in Sample(4) }
        \cup { [ZeroOrderErrorMessage EXCEPT !.volumeFilledToday = one] : one \in Sample(4) }
        \cup { [ZeroOrderErrorMessage EXCEPT !.price = one] : one \in Sample(4) }
        \cup { [ZeroOrderErrorMessage EXCEPT !.triggerPrice = one] : one \in Sample(4) }
        \cup { [ZeroOrderErrorMessage EXCEPT !.goodTillDate = one] : one \in Sample(4) }
        \cup { [ZeroOrderErrorMessage EXCEPT !.entryDateTime = one] : one \in Sample(4) }
        \cup { [ZeroOrderErrorMessage EXCEPT !.minimumFillAonVolume = one] : one \in Sample(4) }
        \cup { [ZeroOrderErrorMessage EXCEPT !.lastModified = one] : one \in Sample(4) }
        \cup { [ZeroOrderErrorMessage EXCEPT !.stOrderFlags = one] : one \in Sample(2) }
        \cup { [ZeroOrderErrorMessage EXCEPT !.branchId = one] : one \in Sample(2) }
        \cup { [ZeroOrderErrorMessage EXCEPT !.traderId = one] : one \in Sample(4) }
        \cup { [ZeroOrderErrorMessage EXCEPT !.brokerId = one] : one \in Sample(5) }
        \cup { [ZeroOrderErrorMessage EXCEPT !.cOrdFiller = one] : one \in Sample(24) }
        \cup { [ZeroOrderErrorMessage EXCEPT !.openClose = one] : one \in Sample(1) }
        \cup { [ZeroOrderErrorMessage EXCEPT !.settlor = one] : one \in Sample(12) }
        \cup { [ZeroOrderErrorMessage EXCEPT !.proClientIndicator = one] : one \in Sample(2) }
        \cup { [ZeroOrderErrorMessage EXCEPT !.settlementPeriod = one] : one \in Sample(2) }
        \cup { [ZeroOrderErrorMessage EXCEPT !.additionalOrderFlags = one] : one \in Sample(1) }
        \cup { [ZeroOrderErrorMessage EXCEPT !.fifthReserved1 = one] : one \in Sample(1) }
        \cup { [ZeroOrderErrorMessage EXCEPT !.reference = one] : one \in Sample(4) }
        \cup { [ZeroOrderErrorMessage EXCEPT !.nnfField = one] : one \in Sample(8) }
        \cup { [ZeroOrderErrorMessage EXCEPT !.mktReplay = one] : one \in Sample(8) }
        \cup { [ZeroOrderErrorMessage EXCEPT !.pan = one] : one \in Sample(10) }
        \cup { [ZeroOrderErrorMessage EXCEPT !.algoId = one] : one \in Sample(4) }
        \cup { [ZeroOrderErrorMessage EXCEPT !.secondReserved2 = one] : one \in Sample(2) }
