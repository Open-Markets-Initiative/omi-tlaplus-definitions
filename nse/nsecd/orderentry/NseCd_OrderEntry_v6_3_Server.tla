        \cup { [ZeroMsSpdLegInfoLeg213 EXCEPT !.minFillAon2 = one] : one \in Sample(4) }
        \cup { [ZeroMsSpdLegInfoLeg213 EXCEPT !.stOrderFlags = one] : one \in Sample(2) }
