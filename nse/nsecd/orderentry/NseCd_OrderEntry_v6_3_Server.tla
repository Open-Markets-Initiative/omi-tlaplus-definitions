         totalVolRemaining2     |-> totalVolRemaining2.value,
         volume2                |-> volume2.value,
         volumeFilledToday2     |-> volumeFilledToday2.value,
         price2                 |-> price2.value,
         triggerPrice2          |-> triggerPrice2.value,
         minFillAon2            |-> minFillAon2.value,
         stOrderFlags           |-> stOrderFlags.value,
         openClose2             |-> openClose2.value,
         additionalOrderFlags   |-> additionalOrderFlags.value,
         reserved1              |-> reserved1.value,
         fillerY                |-> fillerY.value ], fillerY.rest)

ZeroMsSpdLegInfoLeg311 ==
    [ token2                 |-> [i \in 1 .. 4 |-> 0],
      contractDesc           |-> ZeroContractDesc46,
      opBrokerId2            |-> [i \in 1 .. 5 |-> 0],
      fillerx2               |-> [i \in 1 .. 1 |-> 0],
      orderType2             |-> [i \in 1 .. 2 |-> 0],
      buySell2               |-> [i \in 1 .. 2 |-> 0],
      disclosedVol2          |-> [i \in 1 .. 4 |-> 0],
      disclosedVolRemaining2 |-> [i \in 1 .. 4 |-> 0],
      totalVolRemaining2     |-> [i \in 1 .. 4 |-> 0],
      volume2                |-> [i \in 1 .. 4 |-> 0],
      volumeFilledToday2     |-> [i \in 1 .. 4 |-> 0],
      price2                 |-> [i \in 1 .. 4 |-> 0],
      triggerPrice2          |-> [i \in 1 .. 4 |-> 0],
      minFillAon2            |-> [i \in 1 .. 4 |-> 0],
      stOrderFlags           |-> [i \in 1 .. 2 |-> 0],
      openClose2             |-> [i \in 1 .. 1 |-> 0],
      additionalOrderFlags   |-> [i \in 1 .. 1 |-> 0],
      reserved1              |-> [i \in 1 .. 1 |-> 0],
      fillerY                |-> [i \in 1 .. 1 |-> 0] ]

(* Ms Spd Leg Info Leg 3 at zero, then each field in turn at the values it is checked at *)
CheckedMsSpdLegInfoLeg311 ==
    { ZeroMsSpdLegInfoLeg311 }
        \cup { [ZeroMsSpdLegInfoLeg311 EXCEPT !.token2 = one] : one \in Sample(4) }
        \cup { [ZeroMsSpdLegInfoLeg311 EXCEPT !.contractDesc = one] : one \in CheckedContractDesc46 }
        \cup { [ZeroMsSpdLegInfoLeg311 EXCEPT !.opBrokerId2 = one] : one \in Sample(5) }
        \cup { [ZeroMsSpdLegInfoLeg311 EXCEPT !.fillerx2 = one] : one \in Sample(1) }
        \cup { [ZeroMsSpdLegInfoLeg311 EXCEPT !.orderType2 = one] : one \in Sample(2) }
        \cup { [ZeroMsSpdLegInfoLeg311 EXCEPT !.buySell2 = one] : one \in Sample(2) }
        \cup { [ZeroMsSpdLegInfoLeg311 EXCEPT !.disclosedVol2 = one] : one \in Sample(4) }
        \cup { [ZeroMsSpdLegInfoLeg311 EXCEPT !.disclosedVolRemaining2 = one] : one \in Sample(4) }
        \cup { [ZeroMsSpdLegInfoLeg311 EXCEPT !.totalVolRemaining2 = one] : one \in Sample(4) }
        \cup { [ZeroMsSpdLegInfoLeg311 EXCEPT !.volume2 = one] : one \in Sample(4) }
        \cup { [ZeroMsSpdLegInfoLeg311 EXCEPT !.volumeFilledToday2 = one] : one \in Sample(4) }
        \cup { [ZeroMsSpdLegInfoLeg311 EXCEPT !.price2 = one] : one \in Sample(4) }
        \cup { [ZeroMsSpdLegInfoLeg311 EXCEPT !.triggerPrice2 = one] : one \in Sample(4) }
        \cup { [ZeroMsSpdLegInfoLeg311 EXCEPT !.minFillAon2 = one] : one \in Sample(4) }
        \cup { [ZeroMsSpdLegInfoLeg311 EXCEPT !.stOrderFlags = one] : one \in Sample(2) }
        \cup { [ZeroMsSpdLegInfoLeg311 EXCEPT !.openClose2 = one] : one \in Sample(1) }
        \cup { [ZeroMsSpdLegInfoLeg311 EXCEPT !.additionalOrderFlags = one] : one \in Sample(1) }
        \cup { [ZeroMsSpdLegInfoLeg311 EXCEPT !.reserved1 = one] : one \in Sample(1) }
        \cup { [ZeroMsSpdLegInfoLeg311 EXCEPT !.fillerY = one] : one \in Sample(1) }

