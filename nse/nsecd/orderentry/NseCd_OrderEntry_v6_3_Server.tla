        \cup { [ZeroCancelNegOrderMessage EXCEPT !.disclosedVolume = one] : one \in Sample(4) }
        \cup { [ZeroCancelNegOrderMessage EXCEPT !.disclosedVolumeRemaining = one] : one \in Sample(4) }
