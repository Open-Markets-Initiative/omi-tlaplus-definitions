        \cup { [ZeroOrderModRejectMessage EXCEPT !.additionalOrderFlags = one] : one \in Sample(1) }
        \cup { [ZeroOrderModRejectMessage EXCEPT !.fifthReserved1 = one] : one \in Sample(1) }
        \cup { [ZeroOrderModRejectMessage EXCEPT !.reference = one] : one \in Sample(4) }
