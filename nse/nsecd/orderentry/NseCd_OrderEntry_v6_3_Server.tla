DecodeThrlOrderConfirmationMessage(bytes) ==
    LET participantType1 == ReadBytes(bytes, 1) IN IF ~participantType1.ok THEN Fail ELSE
    LET filler1 == ReadBytes(participantType1.rest, 1) IN IF ~filler1.ok THEN Fail ELSE
    LET competitorPeriod1 == ReadBytes(filler1.rest, 2) IN IF ~competitorPeriod1.ok THEN Fail ELSE
    LET solicitorPeriod1 == ReadBytes(competitorPeriod1.rest, 2) IN IF ~solicitorPeriod1.ok THEN Fail ELSE
    LET modCxlBy1 == ReadBytes(solicitorPeriod1.rest, 1) IN IF ~modCxlBy1.ok THEN Fail ELSE
    LET filler9 == ReadBytes(modCxlBy1.rest, 1) IN IF ~filler9.ok THEN Fail ELSE
    LET reasonCode1 == ReadBytes(filler9.rest, 2) IN IF ~reasonCode1.ok THEN Fail ELSE
    LET startAlpha1 == ReadBytes(reasonCode1.rest, 2) IN IF ~startAlpha1.ok THEN Fail ELSE
    LET endAlpha1 == ReadBytes(startAlpha1.rest, 2) IN IF ~endAlpha1.ok THEN Fail ELSE
    LET token1 == ReadBytes(endAlpha1.rest, 4) IN IF ~token1.ok THEN Fail ELSE
    LET contractDesc == DecodeContractDesc35(token1.rest) IN IF ~contractDesc.ok THEN Fail ELSE
    LET opBrokerId1 == ReadBytes(contractDesc.rest, 5) IN IF ~opBrokerId1.ok THEN Fail ELSE
    LET fillerx1 == ReadBytes(opBrokerId1.rest, 1) IN IF ~fillerx1.ok THEN Fail ELSE
    LET fillerOptions1 == ReadBytes(fillerx1.rest, 3) IN IF ~fillerOptions1.ok THEN Fail ELSE
    LET fillery1 == ReadBytes(fillerOptions1.rest, 1) IN IF ~fillery1.ok THEN Fail ELSE
    LET orderType1 == ReadBytes(fillery1.rest, 2) IN IF ~orderType1.ok THEN Fail ELSE
    LET orderNumber1 == ReadBytes(orderType1.rest, 8) IN IF ~orderNumber1.ok THEN Fail ELSE
    LET accountNumber1 == ReadBytes(orderNumber1.rest, 10) IN IF ~accountNumber1.ok THEN Fail ELSE
    LET bookType1 == ReadBytes(accountNumber1.rest, 2) IN IF ~bookType1.ok THEN Fail ELSE
    LET buySell1 == ReadBytes(bookType1.rest, 2) IN IF ~buySell1.ok THEN Fail ELSE
    LET disclosedVol1 == ReadBytes(buySell1.rest, 4) IN IF ~disclosedVol1.ok THEN Fail ELSE
    LET disclosedVolRemaining1 == ReadBytes(disclosedVol1.rest, 4) IN IF ~disclosedVolRemaining1.ok THEN Fail ELSE
    LET totalVolRemaining1 == ReadBytes(disclosedVolRemaining1.rest, 4) IN IF ~totalVolRemaining1.ok THEN Fail ELSE
    LET volume1 == ReadBytes(totalVolRemaining1.rest, 4) IN IF ~volume1.ok THEN Fail ELSE
    LET volumeFilledToday1 == ReadBytes(volume1.rest, 4) IN IF ~volumeFilledToday1.ok THEN Fail ELSE
    LET price1 == ReadBytes(volumeFilledToday1.rest, 4) IN IF ~price1.ok THEN Fail ELSE
    LET triggerPrice1 == ReadBytes(price1.rest, 4) IN IF ~triggerPrice1.ok THEN Fail ELSE
    LET goodTillDate1 == ReadBytes(triggerPrice1.rest, 4) IN IF ~goodTillDate1.ok THEN Fail ELSE
    LET entryDateTime1 == ReadBytes(goodTillDate1.rest, 4) IN IF ~entryDateTime1.ok THEN Fail ELSE
    LET minFillAon1 == ReadBytes(entryDateTime1.rest, 4) IN IF ~minFillAon1.ok THEN Fail ELSE
    LET lastModified1 == ReadBytes(minFillAon1.rest, 4) IN IF ~lastModified1.ok THEN Fail ELSE
    LET stOrderFlags == ReadBytes(lastModified1.rest, 2) IN IF ~stOrderFlags.ok THEN Fail ELSE
    LET branchId1 == ReadBytes(stOrderFlags.rest, 2) IN IF ~branchId1.ok THEN Fail ELSE
    LET traderId1 == ReadBytes(branchId1.rest, 4) IN IF ~traderId1.ok THEN Fail ELSE
    LET brokerId1 == ReadBytes(traderId1.rest, 5) IN IF ~brokerId1.ok THEN Fail ELSE
    LET cOrdFiller == ReadBytes(brokerId1.rest, 24) IN IF ~cOrdFiller.ok THEN Fail ELSE
    LET openClose1 == ReadBytes(cOrdFiller.rest, 1) IN IF ~openClose1.ok THEN Fail ELSE
    LET settlor1 == ReadBytes(openClose1.rest, 12) IN IF ~settlor1.ok THEN Fail ELSE
    LET proClient1 == ReadBytes(settlor1.rest, 2) IN IF ~proClient1.ok THEN Fail ELSE
    LET settlementPeriod1 == ReadBytes(proClient1.rest, 2) IN IF ~settlementPeriod1.ok THEN Fail ELSE
    LET additionalOrderFlags == ReadBytes(settlementPeriod1.rest, 1) IN IF ~additionalOrderFlags.ok THEN Fail ELSE
    LET reserved1 == ReadBytes(additionalOrderFlags.rest, 1) IN IF ~reserved1.ok THEN Fail ELSE
    LET reserved2 == ReadBytes(reserved1.rest, 2) IN IF ~reserved2.ok THEN Fail ELSE
    LET filler17 == ReadBytes(reserved2.rest, 1) IN IF ~filler17.ok THEN Fail ELSE
    LET filler18 == ReadBytes(filler17.rest, 1) IN IF ~filler18.ok THEN Fail ELSE
    LET nnfField == ReadBytes(filler18.rest, 8) IN IF ~nnfField.ok THEN Fail ELSE
    LET mktReplay == ReadBytes(nnfField.rest, 8) IN IF ~mktReplay.ok THEN Fail ELSE
    LET pan == ReadBytes(mktReplay.rest, 10) IN IF ~pan.ok THEN Fail ELSE
    LET algoId == ReadBytes(pan.rest, 4) IN IF ~algoId.ok THEN Fail ELSE
    LET secondReserved2 == ReadBytes(algoId.rest, 2) IN IF ~secondReserved2.ok THEN Fail ELSE
    LET lastActivityReference == ReadBytes(secondReserved2.rest, 8) IN IF ~lastActivityReference.ok THEN Fail ELSE
    LET reserved52 == ReadBytes(lastActivityReference.rest, 52) IN IF ~reserved52.ok THEN Fail ELSE
    LET priceDiff == ReadBytes(reserved52.rest, 4) IN IF ~priceDiff.ok THEN Fail ELSE
    LET msSpdLegInfoLeg2 == DecodeMsSpdLegInfoLeg28(priceDiff.rest) IN IF ~msSpdLegInfoLeg2.ok THEN Fail ELSE
    LET msSpdLegInfoLeg3 == DecodeMsSpdLegInfoLeg38(msSpdLegInfoLeg2.rest) IN IF ~msSpdLegInfoLeg3.ok THEN Fail ELSE
    Ok([ participantType1       |-> participantType1.value,
         filler1                |-> filler1.value,
         competitorPeriod1      |-> competitorPeriod1.value,
         solicitorPeriod1       |-> solicitorPeriod1.value,
         modCxlBy1              |-> modCxlBy1.value,
         filler9                |-> filler9.value,
         reasonCode1            |-> reasonCode1.value,
         startAlpha1            |-> startAlpha1.value,
         endAlpha1              |-> endAlpha1.value,
         token1                 |-> token1.value,
         contractDesc           |-> contractDesc.value,
         opBrokerId1            |-> opBrokerId1.value,
         fillerx1               |-> fillerx1.value,
         fillerOptions1         |-> fillerOptions1.value,
         fillery1               |-> fillery1.value,
         orderType1             |-> orderType1.value,
         orderNumber1           |-> orderNumber1.value,
         accountNumber1         |-> accountNumber1.value,
         bookType1              |-> bookType1.value,
         buySell1               |-> buySell1.value,
         disclosedVol1          |-> disclosedVol1.value,
         disclosedVolRemaining1 |-> disclosedVolRemaining1.value,
         totalVolRemaining1     |-> totalVolRemaining1.value,
         volume1                |-> volume1.value,
         volumeFilledToday1     |-> volumeFilledToday1.value,
         price1                 |-> price1.value,
         triggerPrice1          |-> triggerPrice1.value,
         goodTillDate1          |-> goodTillDate1.value,
         entryDateTime1         |-> entryDateTime1.value,
         minFillAon1            |-> minFillAon1.value,
         lastModified1          |-> lastModified1.value,
         stOrderFlags           |-> stOrderFlags.value,
         branchId1              |-> branchId1.value,
         traderId1              |-> traderId1.value,
         brokerId1              |-> brokerId1.value,
         cOrdFiller             |-> cOrdFiller.value,
         openClose1             |-> openClose1.value,
         settlor1               |-> settlor1.value,
         proClient1             |-> proClient1.value,
         settlementPeriod1      |-> settlementPeriod1.value,
         additionalOrderFlags   |-> additionalOrderFlags.value,
         reserved1              |-> reserved1.value,
         reserved2              |-> reserved2.value,
         filler17               |-> filler17.value,
         filler18               |-> filler18.value,
         nnfField               |-> nnfField.value,
         mktReplay              |-> mktReplay.value,
         pan                    |-> pan.value,
         algoId                 |-> algoId.value,
         secondReserved2        |-> secondReserved2.value,
         lastActivityReference  |-> lastActivityReference.value,
         reserved52             |-> reserved52.value,
         priceDiff              |-> priceDiff.value,
         msSpdLegInfoLeg2       |-> msSpdLegInfoLeg2.value,
         msSpdLegInfoLeg3       |-> msSpdLegInfoLeg3.value ], msSpdLegInfoLeg3.rest)

ZeroThrlOrderConfirmationMessage ==
    [ participantType1       |-> [i \in 1 .. 1 |-> 0],
      filler1                |-> [i \in 1 .. 1 |-> 0],
      competitorPeriod1      |-> [i \in 1 .. 2 |-> 0],
      solicitorPeriod1       |-> [i \in 1 .. 2 |-> 0],
      modCxlBy1              |-> [i \in 1 .. 1 |-> 0],
      filler9                |-> [i \in 1 .. 1 |-> 0],
      reasonCode1            |-> [i \in 1 .. 2 |-> 0],
      startAlpha1            |-> [i \in 1 .. 2 |-> 0],
      endAlpha1              |-> [i \in 1 .. 2 |-> 0],
      token1                 |-> [i \in 1 .. 4 |-> 0],
      contractDesc           |-> ZeroContractDesc35,
      opBrokerId1            |-> [i \in 1 .. 5 |-> 0],
      fillerx1               |-> [i \in 1 .. 1 |-> 0],
      fillerOptions1         |-> [i \in 1 .. 3 |-> 0],
      fillery1               |-> [i \in 1 .. 1 |-> 0],
      orderType1             |-> [i \in 1 .. 2 |-> 0],
      orderNumber1           |-> [i \in 1 .. 8 |-> 0],
      accountNumber1         |-> [i \in 1 .. 10 |-> 0],
      bookType1              |-> [i \in 1 .. 2 |-> 0],
      buySell1               |-> [i \in 1 .. 2 |-> 0],
      disclosedVol1          |-> [i \in 1 .. 4 |-> 0],
      disclosedVolRemaining1 |-> [i \in 1 .. 4 |-> 0],
      totalVolRemaining1     |-> [i \in 1 .. 4 |-> 0],
      volume1                |-> [i \in 1 .. 4 |-> 0],
      volumeFilledToday1     |-> [i \in 1 .. 4 |-> 0],
      price1                 |-> [i \in 1 .. 4 |-> 0],
      triggerPrice1          |-> [i \in 1 .. 4 |-> 0],
      goodTillDate1          |-> [i \in 1 .. 4 |-> 0],
      entryDateTime1         |-> [i \in 1 .. 4 |-> 0],
      minFillAon1            |-> [i \in 1 .. 4 |-> 0],
      lastModified1          |-> [i \in 1 .. 4 |-> 0],
      stOrderFlags           |-> [i \in 1 .. 2 |-> 0],
      branchId1              |-> [i \in 1 .. 2 |-> 0],
      traderId1              |-> [i \in 1 .. 4 |-> 0],
      brokerId1              |-> [i \in 1 .. 5 |-> 0],
      cOrdFiller             |-> [i \in 1 .. 24 |-> 0],
      openClose1             |-> [i \in 1 .. 1 |-> 0],
      settlor1               |-> [i \in 1 .. 12 |-> 0],
      proClient1             |-> [i \in 1 .. 2 |-> 0],
      settlementPeriod1      |-> [i \in 1 .. 2 |-> 0],
      additionalOrderFlags   |-> [i \in 1 .. 1 |-> 0],
      reserved1              |-> [i \in 1 .. 1 |-> 0],
      reserved2              |-> [i \in 1 .. 2 |-> 0],
      filler17               |-> [i \in 1 .. 1 |-> 0],
      filler18               |-> [i \in 1 .. 1 |-> 0],
      nnfField               |-> [i \in 1 .. 8 |-> 0],
      mktReplay              |-> [i \in 1 .. 8 |-> 0],
      pan                    |-> [i \in 1 .. 10 |-> 0],
      algoId                 |-> [i \in 1 .. 4 |-> 0],
      secondReserved2        |-> [i \in 1 .. 2 |-> 0],
      lastActivityReference  |-> [i \in 1 .. 8 |-> 0],
      reserved52             |-> [i \in 1 .. 52 |-> 0],
      priceDiff              |-> [i \in 1 .. 4 |-> 0],
      msSpdLegInfoLeg2       |-> ZeroMsSpdLegInfoLeg28,
      msSpdLegInfoLeg3       |-> ZeroMsSpdLegInfoLeg38 ]

(* Thrl Order Confirmation Message at zero, then each field in turn at the values it is checked at *)
CheckedThrlOrderConfirmationMessage ==
    { ZeroThrlOrderConfirmationMessage }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.participantType1 = one] : one \in Sample(1) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.filler1 = one] : one \in Sample(1) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.competitorPeriod1 = one] : one \in Sample(2) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.solicitorPeriod1 = one] : one \in Sample(2) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.modCxlBy1 = one] : one \in Sample(1) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.filler9 = one] : one \in Sample(1) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.reasonCode1 = one] : one \in Sample(2) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.startAlpha1 = one] : one \in Sample(2) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.endAlpha1 = one] : one \in Sample(2) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.token1 = one] : one \in Sample(4) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.contractDesc = one] : one \in CheckedContractDesc35 }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.opBrokerId1 = one] : one \in Sample(5) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.fillerx1 = one] : one \in Sample(1) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.fillerOptions1 = one] : one \in Sample(3) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.fillery1 = one] : one \in Sample(1) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.orderType1 = one] : one \in Sample(2) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.orderNumber1 = one] : one \in Sample(8) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.accountNumber1 = one] : one \in Sample(10) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.bookType1 = one] : one \in Sample(2) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.buySell1 = one] : one \in Sample(2) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.disclosedVol1 = one] : one \in Sample(4) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.disclosedVolRemaining1 = one] : one \in Sample(4) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.totalVolRemaining1 = one] : one \in Sample(4) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.volume1 = one] : one \in Sample(4) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.volumeFilledToday1 = one] : one \in Sample(4) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.price1 = one] : one \in Sample(4) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.triggerPrice1 = one] : one \in Sample(4) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.goodTillDate1 = one] : one \in Sample(4) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.entryDateTime1 = one] : one \in Sample(4) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.minFillAon1 = one] : one \in Sample(4) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.lastModified1 = one] : one \in Sample(4) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.stOrderFlags = one] : one \in Sample(2) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.branchId1 = one] : one \in Sample(2) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.traderId1 = one] : one \in Sample(4) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.brokerId1 = one] : one \in Sample(5) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.cOrdFiller = one] : one \in Sample(24) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.openClose1 = one] : one \in Sample(1) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.settlor1 = one] : one \in Sample(12) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.proClient1 = one] : one \in Sample(2) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.settlementPeriod1 = one] : one \in Sample(2) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.additionalOrderFlags = one] : one \in Sample(1) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.reserved1 = one] : one \in Sample(1) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.reserved2 = one] : one \in Sample(2) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.filler17 = one] : one \in Sample(1) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.filler18 = one] : one \in Sample(1) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.nnfField = one] : one \in Sample(8) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.mktReplay = one] : one \in Sample(8) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.pan = one] : one \in Sample(10) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.algoId = one] : one \in Sample(4) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.secondReserved2 = one] : one \in Sample(2) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.lastActivityReference = one] : one \in Sample(8) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.reserved52 = one] : one \in Sample(52) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.priceDiff = one] : one \in Sample(4) }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.msSpdLegInfoLeg2 = one] : one \in CheckedMsSpdLegInfoLeg28 }
        \cup { [ZeroThrlOrderConfirmationMessage EXCEPT !.msSpdLegInfoLeg3 = one] : one \in CheckedMsSpdLegInfoLeg38 }

(***************************************************************************)
(* Contract Desc: 28 bytes                                                 *)
(***************************************************************************)

ContractDesc38 ==
    [ instrumentName : Sample(6),
      symbol         : Sample(10),
      expiryDate     : Sample(4),
      strikePrice    : Sample(4),
      optionType     : Sample(2),
      caLevel        : Sample(2) ]

EncodeContractDesc38(message) ==
    message.instrumentName
        \o message.symbol
        \o message.expiryDate
        \o message.strikePrice
        \o message.optionType
        \o message.caLevel

DecodeContractDesc38(bytes) ==
    LET instrumentName == ReadBytes(bytes, 6) IN IF ~instrumentName.ok THEN Fail ELSE
    LET symbol == ReadBytes(instrumentName.rest, 10) IN IF ~symbol.ok THEN Fail ELSE
    LET expiryDate == ReadBytes(symbol.rest, 4) IN IF ~expiryDate.ok THEN Fail ELSE
    LET strikePrice == ReadBytes(expiryDate.rest, 4) IN IF ~strikePrice.ok THEN Fail ELSE
    LET optionType == ReadBytes(strikePrice.rest, 2) IN IF ~optionType.ok THEN Fail ELSE
    LET caLevel == ReadBytes(optionType.rest, 2) IN IF ~caLevel.ok THEN Fail ELSE
    Ok([ instrumentName |-> instrumentName.value,
         symbol         |-> symbol.value,
         expiryDate     |-> expiryDate.value,
         strikePrice    |-> strikePrice.value,
         optionType     |-> optionType.value,
         caLevel        |-> caLevel.value ], caLevel.rest)

ZeroContractDesc38 ==
    [ instrumentName |-> [i \in 1 .. 6 |-> 0],
      symbol         |-> [i \in 1 .. 10 |-> 0],
      expiryDate     |-> [i \in 1 .. 4 |-> 0],
      strikePrice    |-> [i \in 1 .. 4 |-> 0],
      optionType     |-> [i \in 1 .. 2 |-> 0],
      caLevel        |-> [i \in 1 .. 2 |-> 0] ]

(* Contract Desc at zero, then each field in turn at the values it is checked at *)
CheckedContractDesc38 ==
    { ZeroContractDesc38 }
        \cup { [ZeroContractDesc38 EXCEPT !.instrumentName = one] : one \in Sample(6) }
        \cup { [ZeroContractDesc38 EXCEPT !.symbol = one] : one \in Sample(10) }
        \cup { [ZeroContractDesc38 EXCEPT !.expiryDate = one] : one \in Sample(4) }
        \cup { [ZeroContractDesc38 EXCEPT !.strikePrice = one] : one \in Sample(4) }
        \cup { [ZeroContractDesc38 EXCEPT !.optionType = one] : one \in Sample(2) }
        \cup { [ZeroContractDesc38 EXCEPT !.caLevel = one] : one \in Sample(2) }

(***************************************************************************)
(* Contract Desc: 28 bytes                                                 *)
(***************************************************************************)

ContractDesc39 ==
    [ instrumentName : Sample(6),
      symbol         : Sample(10),
      expiryDate     : Sample(4),
      strikePrice    : Sample(4),
      optionType     : Sample(2),
      caLevel        : Sample(2) ]

EncodeContractDesc39(message) ==
    message.instrumentName
        \o message.symbol
        \o message.expiryDate
        \o message.strikePrice
        \o message.optionType
        \o message.caLevel

DecodeContractDesc39(bytes) ==
    LET instrumentName == ReadBytes(bytes, 6) IN IF ~instrumentName.ok THEN Fail ELSE
    LET symbol == ReadBytes(instrumentName.rest, 10) IN IF ~symbol.ok THEN Fail ELSE
    LET expiryDate == ReadBytes(symbol.rest, 4) IN IF ~expiryDate.ok THEN Fail ELSE
    LET strikePrice == ReadBytes(expiryDate.rest, 4) IN IF ~strikePrice.ok THEN Fail ELSE
    LET optionType == ReadBytes(strikePrice.rest, 2) IN IF ~optionType.ok THEN Fail ELSE
    LET caLevel == ReadBytes(optionType.rest, 2) IN IF ~caLevel.ok THEN Fail ELSE
    Ok([ instrumentName |-> instrumentName.value,
         symbol         |-> symbol.value,
         expiryDate     |-> expiryDate.value,
         strikePrice    |-> strikePrice.value,
         optionType     |-> optionType.value,
         caLevel        |-> caLevel.value ], caLevel.rest)

ZeroContractDesc39 ==
    [ instrumentName |-> [i \in 1 .. 6 |-> 0],
      symbol         |-> [i \in 1 .. 10 |-> 0],
      expiryDate     |-> [i \in 1 .. 4 |-> 0],
      strikePrice    |-> [i \in 1 .. 4 |-> 0],
      optionType     |-> [i \in 1 .. 2 |-> 0],
      caLevel        |-> [i \in 1 .. 2 |-> 0] ]

(* Contract Desc at zero, then each field in turn at the values it is checked at *)
CheckedContractDesc39 ==
    { ZeroContractDesc39 }
        \cup { [ZeroContractDesc39 EXCEPT !.instrumentName = one] : one \in Sample(6) }
        \cup { [ZeroContractDesc39 EXCEPT !.symbol = one] : one \in Sample(10) }
        \cup { [ZeroContractDesc39 EXCEPT !.expiryDate = one] : one \in Sample(4) }
        \cup { [ZeroContractDesc39 EXCEPT !.strikePrice = one] : one \in Sample(4) }
        \cup { [ZeroContractDesc39 EXCEPT !.optionType = one] : one \in Sample(2) }
        \cup { [ZeroContractDesc39 EXCEPT !.caLevel = one] : one \in Sample(2) }

(***************************************************************************)
(* Ms Spd Leg Info Leg 2: 80 bytes                                         *)
(***************************************************************************)

MsSpdLegInfoLeg29 ==
    [ token2                 : Sample(4),
      contractDesc           : ContractDesc39,
      opBrokerId2            : Sample(5),
      fillerx2               : Sample(1),
      orderType2             : Sample(2),
      buySell2               : Sample(2),
      disclosedVol2          : Sample(4),
      disclosedVolRemaining2 : Sample(4),
      totalVolRemaining2     : Sample(4),
      volume2                : Sample(4),
      volumeFilledToday2     : Sample(4),
      price2                 : Sample(4),
      triggerPrice2          : Sample(4),
      minFillAon2            : Sample(4),
      stOrderFlags           : Sample(2),
      openClose2             : Sample(1),
      additionalOrderFlags   : Sample(1),
      reserved1              : Sample(1),
      fillerY                : Sample(1) ]

EncodeMsSpdLegInfoLeg29(message) ==
    message.token2
        \o EncodeContractDesc39(message.contractDesc)
        \o message.opBrokerId2
        \o message.fillerx2
        \o message.orderType2
        \o message.buySell2
        \o message.disclosedVol2
        \o message.disclosedVolRemaining2
        \o message.totalVolRemaining2
        \o message.volume2
        \o message.volumeFilledToday2
        \o message.price2
        \o message.triggerPrice2
        \o message.minFillAon2
        \o message.stOrderFlags
        \o message.openClose2
        \o message.additionalOrderFlags
        \o message.reserved1
        \o message.fillerY

DecodeMsSpdLegInfoLeg29(bytes) ==
    LET token2 == ReadBytes(bytes, 4) IN IF ~token2.ok THEN Fail ELSE
    LET contractDesc == DecodeContractDesc39(token2.rest) IN IF ~contractDesc.ok THEN Fail ELSE
    LET opBrokerId2 == ReadBytes(contractDesc.rest, 5) IN IF ~opBrokerId2.ok THEN Fail ELSE
    LET fillerx2 == ReadBytes(opBrokerId2.rest, 1) IN IF ~fillerx2.ok THEN Fail ELSE
    LET orderType2 == ReadBytes(fillerx2.rest, 2) IN IF ~orderType2.ok THEN Fail ELSE
    LET buySell2 == ReadBytes(orderType2.rest, 2) IN IF ~buySell2.ok THEN Fail ELSE
    LET disclosedVol2 == ReadBytes(buySell2.rest, 4) IN IF ~disclosedVol2.ok THEN Fail ELSE
    LET disclosedVolRemaining2 == ReadBytes(disclosedVol2.rest, 4) IN IF ~disclosedVolRemaining2.ok THEN Fail ELSE
    LET totalVolRemaining2 == ReadBytes(disclosedVolRemaining2.rest, 4) IN IF ~totalVolRemaining2.ok THEN Fail ELSE
    LET volume2 == ReadBytes(totalVolRemaining2.rest, 4) IN IF ~volume2.ok THEN Fail ELSE
    LET volumeFilledToday2 == ReadBytes(volume2.rest, 4) IN IF ~volumeFilledToday2.ok THEN Fail ELSE
    LET price2 == ReadBytes(volumeFilledToday2.rest, 4) IN IF ~price2.ok THEN Fail ELSE
    LET triggerPrice2 == ReadBytes(price2.rest, 4) IN IF ~triggerPrice2.ok THEN Fail ELSE
    LET minFillAon2 == ReadBytes(triggerPrice2.rest, 4) IN IF ~minFillAon2.ok THEN Fail ELSE
    LET stOrderFlags == ReadBytes(minFillAon2.rest, 2) IN IF ~stOrderFlags.ok THEN Fail ELSE
    LET openClose2 == ReadBytes(stOrderFlags.rest, 1) IN IF ~openClose2.ok THEN Fail ELSE
    LET additionalOrderFlags == ReadBytes(openClose2.rest, 1) IN IF ~additionalOrderFlags.ok THEN Fail ELSE
    LET reserved1 == ReadBytes(additionalOrderFlags.rest, 1) IN IF ~reserved1.ok THEN Fail ELSE
    LET fillerY == ReadBytes(reserved1.rest, 1) IN IF ~fillerY.ok THEN Fail ELSE
    Ok([ token2                 |-> token2.value,
         contractDesc           |-> contractDesc.value,
         opBrokerId2            |-> opBrokerId2.value,
         fillerx2               |-> fillerx2.value,
         orderType2             |-> orderType2.value,
         buySell2               |-> buySell2.value,
         disclosedVol2          |-> disclosedVol2.value,
         disclosedVolRemaining2 |-> disclosedVolRemaining2.value,
         totalVolRemaining2     |-> totalVolRemaining2.value,
         volume2                |-> volume2.value,
         volumeFilledToday2     |-> volumeFilledToday2.value,
         price2                 |-> price2.value,
         triggerPrice2          |-> triggerPrice2.value,
         minFillAon2            |-> minFillAon2.value,
         stOrderFlags           |-> stOrderFlags.value,
         openClose2             |-> openClose2.value,
         additionalOrderFlags   |-> additionalOrderFlags.value,
         reserved1              |-> reserved1.value,
         fillerY                |-> fillerY.value ], fillerY.rest)

ZeroMsSpdLegInfoLeg29 ==
    [ token2                 |-> [i \in 1 .. 4 |-> 0],
      contractDesc           |-> ZeroContractDesc39,
      opBrokerId2            |-> [i \in 1 .. 5 |-> 0],
      fillerx2               |-> [i \in 1 .. 1 |-> 0],
      orderType2             |-> [i \in 1 .. 2 |-> 0],
      buySell2               |-> [i \in 1 .. 2 |-> 0],
      disclosedVol2          |-> [i \in 1 .. 4 |-> 0],
      disclosedVolRemaining2 |-> [i \in 1 .. 4 |-> 0],
      totalVolRemaining2     |-> [i \in 1 .. 4 |-> 0],
      volume2                |-> [i \in 1 .. 4 |-> 0],
      volumeFilledToday2     |-> [i \in 1 .. 4 |-> 0],
      price2                 |-> [i \in 1 .. 4 |-> 0],
      triggerPrice2          |-> [i \in 1 .. 4 |-> 0],
      minFillAon2            |-> [i \in 1 .. 4 |-> 0],
      stOrderFlags           |-> [i \in 1 .. 2 |-> 0],
      openClose2             |-> [i \in 1 .. 1 |-> 0],
      additionalOrderFlags   |-> [i \in 1 .. 1 |-> 0],
      reserved1              |-> [i \in 1 .. 1 |-> 0],
      fillerY                |-> [i \in 1 .. 1 |-> 0] ]

(* Ms Spd Leg Info Leg 2 at zero, then each field in turn at the values it is checked at *)
CheckedMsSpdLegInfoLeg29 ==
    { ZeroMsSpdLegInfoLeg29 }
        \cup { [ZeroMsSpdLegInfoLeg29 EXCEPT !.token2 = one] : one \in Sample(4) }
        \cup { [ZeroMsSpdLegInfoLeg29 EXCEPT !.contractDesc = one] : one \in CheckedContractDesc39 }
        \cup { [ZeroMsSpdLegInfoLeg29 EXCEPT !.opBrokerId2 = one] : one \in Sample(5) }
        \cup { [ZeroMsSpdLegInfoLeg29 EXCEPT !.fillerx2 = one] : one \in Sample(1) }
        \cup { [ZeroMsSpdLegInfoLeg29 EXCEPT !.orderType2 = one] : one \in Sample(2) }
        \cup { [ZeroMsSpdLegInfoLeg29 EXCEPT !.buySell2 = one] : one \in Sample(2) }
        \cup { [ZeroMsSpdLegInfoLeg29 EXCEPT !.disclosedVol2 = one] : one \in Sample(4) }
        \cup { [ZeroMsSpdLegInfoLeg29 EXCEPT !.disclosedVolRemaining2 = one] : one \in Sample(4) }
        \cup { [ZeroMsSpdLegInfoLeg29 EXCEPT !.totalVolRemaining2 = one] : one \in Sample(4) }
        \cup { [ZeroMsSpdLegInfoLeg29 EXCEPT !.volume2 = one] : one \in Sample(4) }
        \cup { [ZeroMsSpdLegInfoLeg29 EXCEPT !.volumeFilledToday2 = one] : one \in Sample(4) }
        \cup { [ZeroMsSpdLegInfoLeg29 EXCEPT !.price2 = one] : one \in Sample(4) }
        \cup { [ZeroMsSpdLegInfoLeg29 EXCEPT !.triggerPrice2 = one] : one \in Sample(4) }
        \cup { [ZeroMsSpdLegInfoLeg29 EXCEPT !.minFillAon2 = one] : one \in Sample(4) }
        \cup { [ZeroMsSpdLegInfoLeg29 EXCEPT !.stOrderFlags = one] : one \in Sample(2) }
        \cup { [ZeroMsSpdLegInfoLeg29 EXCEPT !.openClose2 = one] : one \in Sample(1) }
        \cup { [ZeroMsSpdLegInfoLeg29 EXCEPT !.additionalOrderFlags = one] : one \in Sample(1) }
        \cup { [ZeroMsSpdLegInfoLeg29 EXCEPT !.reserved1 = one] : one \in Sample(1) }
        \cup { [ZeroMsSpdLegInfoLeg29 EXCEPT !.fillerY = one] : one \in Sample(1) }

(***************************************************************************)
(* Contract Desc: 28 bytes                                                 *)
(***************************************************************************)

ContractDesc40 ==
    [ instrumentName : Sample(6),
      symbol         : Sample(10),
      expiryDate     : Sample(4),
      strikePrice    : Sample(4),
      optionType     : Sample(2),
      caLevel        : Sample(2) ]

EncodeContractDesc40(message) ==
    message.instrumentName
        \o message.symbol
        \o message.expiryDate
        \o message.strikePrice
        \o message.optionType
        \o message.caLevel

DecodeContractDesc40(bytes) ==
    LET instrumentName == ReadBytes(bytes, 6) IN IF ~instrumentName.ok THEN Fail ELSE
    LET symbol == ReadBytes(instrumentName.rest, 10) IN IF ~symbol.ok THEN Fail ELSE
    LET expiryDate == ReadBytes(symbol.rest, 4) IN IF ~expiryDate.ok THEN Fail ELSE
    LET strikePrice == ReadBytes(expiryDate.rest, 4) IN IF ~strikePrice.ok THEN Fail ELSE
    LET optionType == ReadBytes(strikePrice.rest, 2) IN IF ~optionType.ok THEN Fail ELSE
    LET caLevel == ReadBytes(optionType.rest, 2) IN IF ~caLevel.ok THEN Fail ELSE
    Ok([ instrumentName |-> instrumentName.value,
         symbol         |-> symbol.value,
         expiryDate     |-> expiryDate.value,
         strikePrice    |-> strikePrice.value,
         optionType     |-> optionType.value,
         caLevel        |-> caLevel.value ], caLevel.rest)

ZeroContractDesc40 ==
    [ instrumentName |-> [i \in 1 .. 6 |-> 0],
      symbol         |-> [i \in 1 .. 10 |-> 0],
      expiryDate     |-> [i \in 1 .. 4 |-> 0],
      strikePrice    |-> [i \in 1 .. 4 |-> 0],
      optionType     |-> [i \in 1 .. 2 |-> 0],
      caLevel        |-> [i \in 1 .. 2 |-> 0] ]

(* Contract Desc at zero, then each field in turn at the values it is checked at *)
CheckedContractDesc40 ==
    { ZeroContractDesc40 }
        \cup { [ZeroContractDesc40 EXCEPT !.instrumentName = one] : one \in Sample(6) }
        \cup { [ZeroContractDesc40 EXCEPT !.symbol = one] : one \in Sample(10) }
        \cup { [ZeroContractDesc40 EXCEPT !.expiryDate = one] : one \in Sample(4) }
        \cup { [ZeroContractDesc40 EXCEPT !.strikePrice = one] : one \in Sample(4) }
        \cup { [ZeroContractDesc40 EXCEPT !.optionType = one] : one \in Sample(2) }
        \cup { [ZeroContractDesc40 EXCEPT !.caLevel = one] : one \in Sample(2) }

(***************************************************************************)
(* Ms Spd Leg Info Leg 3: 80 bytes                                         *)
(***************************************************************************)

MsSpdLegInfoLeg39 ==
    [ token2                 : Sample(4),
      contractDesc           : ContractDesc40,
      opBrokerId2            : Sample(5),
      fillerx2               : Sample(1),
      orderType2             : Sample(2),
      buySell2               : Sample(2),
      disclosedVol2          : Sample(4),
      disclosedVolRemaining2 : Sample(4),
      totalVolRemaining2     : Sample(4),
      volume2                : Sample(4),
      volumeFilledToday2     : Sample(4),
      price2                 : Sample(4),
      triggerPrice2          : Sample(4),
      minFillAon2            : Sample(4),
      stOrderFlags           : Sample(2),
      openClose2             : Sample(1),
      additionalOrderFlags   : Sample(1),
      reserved1              : Sample(1),
      fillerY                : Sample(1) ]

EncodeMsSpdLegInfoLeg39(message) ==
    message.token2
        \o EncodeContractDesc40(message.contractDesc)
        \o message.opBrokerId2
        \o message.fillerx2
        \o message.orderType2
        \o message.buySell2
        \o message.disclosedVol2
        \o message.disclosedVolRemaining2
        \o message.totalVolRemaining2
        \o message.volume2
        \o message.volumeFilledToday2
        \o message.price2
        \o message.triggerPrice2
        \o message.minFillAon2
        \o message.stOrderFlags
        \o message.openClose2
        \o message.additionalOrderFlags
        \o message.reserved1
        \o message.fillerY

DecodeMsSpdLegInfoLeg39(bytes) ==
    LET token2 == ReadBytes(bytes, 4) IN IF ~token2.ok THEN Fail ELSE
    LET contractDesc == DecodeContractDesc40(token2.rest) IN IF ~contractDesc.ok THEN Fail ELSE
    LET opBrokerId2 == ReadBytes(contractDesc.rest, 5) IN IF ~opBrokerId2.ok THEN Fail ELSE
    LET fillerx2 == ReadBytes(opBrokerId2.rest, 1) IN IF ~fillerx2.ok THEN Fail ELSE
    LET orderType2 == ReadBytes(fillerx2.rest, 2) IN IF ~orderType2.ok THEN Fail ELSE
    LET buySell2 == ReadBytes(orderType2.rest, 2) IN IF ~buySell2.ok THEN Fail ELSE
    LET disclosedVol2 == ReadBytes(buySell2.rest, 4) IN IF ~disclosedVol2.ok THEN Fail ELSE
    LET disclosedVolRemaining2 == ReadBytes(disclosedVol2.rest, 4) IN IF ~disclosedVolRemaining2.ok THEN Fail ELSE
    LET totalVolRemaining2 == ReadBytes(disclosedVolRemaining2.rest, 4) IN IF ~totalVolRemaining2.ok THEN Fail ELSE
    LET volume2 == ReadBytes(totalVolRemaining2.rest, 4) IN IF ~volume2.ok THEN Fail ELSE
    LET volumeFilledToday2 == ReadBytes(volume2.rest, 4) IN IF ~volumeFilledToday2.ok THEN Fail ELSE
    LET price2 == ReadBytes(volumeFilledToday2.rest, 4) IN IF ~price2.ok THEN Fail ELSE
    LET triggerPrice2 == ReadBytes(price2.rest, 4) IN IF ~triggerPrice2.ok THEN Fail ELSE
    LET minFillAon2 == ReadBytes(triggerPrice2.rest, 4) IN IF ~minFillAon2.ok THEN Fail ELSE
    LET stOrderFlags == ReadBytes(minFillAon2.rest, 2) IN IF ~stOrderFlags.ok THEN Fail ELSE
    LET openClose2 == ReadBytes(stOrderFlags.rest, 1) IN IF ~openClose2.ok THEN Fail ELSE
    LET additionalOrderFlags == ReadBytes(openClose2.rest, 1) IN IF ~additionalOrderFlags.ok THEN Fail ELSE
    LET reserved1 == ReadBytes(additionalOrderFlags.rest, 1) IN IF ~reserved1.ok THEN Fail ELSE
    LET fillerY == ReadBytes(reserved1.rest, 1) IN IF ~fillerY.ok THEN Fail ELSE
    Ok([ token2                 |-> token2.value,
         contractDesc           |-> contractDesc.value,
         opBrokerId2            |-> opBrokerId2.value,
         fillerx2               |-> fillerx2.value,
         orderType2             |-> orderType2.value,
         buySell2               |-> buySell2.value,
         disclosedVol2          |-> disclosedVol2.value,
         disclosedVolRemaining2 |-> disclosedVolRemaining2.value,
         totalVolRemaining2     |-> totalVolRemaining2.value,
         volume2                |-> volume2.value,
         volumeFilledToday2     |-> volumeFilledToday2.value,
         price2                 |-> price2.value,
         triggerPrice2          |-> triggerPrice2.value,
         minFillAon2            |-> minFillAon2.value,
         stOrderFlags           |-> stOrderFlags.value,
         openClose2             |-> openClose2.value,
         additionalOrderFlags   |-> additionalOrderFlags.value,
         reserved1              |-> reserved1.value,
         fillerY                |-> fillerY.value ], fillerY.rest)

ZeroMsSpdLegInfoLeg39 ==
    [ token2                 |-> [i \in 1 .. 4 |-> 0],
      contractDesc           |-> ZeroContractDesc40,
      opBrokerId2            |-> [i \in 1 .. 5 |-> 0],
      fillerx2               |-> [i \in 1 .. 1 |-> 0],
      orderType2             |-> [i \in 1 .. 2 |-> 0],
      buySell2               |-> [i \in 1 .. 2 |-> 0],
      disclosedVol2          |-> [i \in 1 .. 4 |-> 0],
      disclosedVolRemaining2 |-> [i \in 1 .. 4 |-> 0],
      totalVolRemaining2     |-> [i \in 1 .. 4 |-> 0],
      volume2                |-> [i \in 1 .. 4 |-> 0],
      volumeFilledToday2     |-> [i \in 1 .. 4 |-> 0],
      price2                 |-> [i \in 1 .. 4 |-> 0],
      triggerPrice2          |-> [i \in 1 .. 4 |-> 0],
      minFillAon2            |-> [i \in 1 .. 4 |-> 0],
      stOrderFlags           |-> [i \in 1 .. 2 |-> 0],
      openClose2             |-> [i \in 1 .. 1 |-> 0],
      additionalOrderFlags   |-> [i \in 1 .. 1 |-> 0],
      reserved1              |-> [i \in 1 .. 1 |-> 0],
      fillerY                |-> [i \in 1 .. 1 |-> 0] ]

(* Ms Spd Leg Info Leg 3 at zero, then each field in turn at the values it is checked at *)
CheckedMsSpdLegInfoLeg39 ==
    { ZeroMsSpdLegInfoLeg39 }
        \cup { [ZeroMsSpdLegInfoLeg39 EXCEPT !.token2 = one] : one \in Sample(4) }
        \cup { [ZeroMsSpdLegInfoLeg39 EXCEPT !.contractDesc = one] : one \in CheckedContractDesc40 }
        \cup { [ZeroMsSpdLegInfoLeg39 EXCEPT !.opBrokerId2 = one] : one \in Sample(5) }
        \cup { [ZeroMsSpdLegInfoLeg39 EXCEPT !.fillerx2 = one] : one \in Sample(1) }
        \cup { [ZeroMsSpdLegInfoLeg39 EXCEPT !.orderType2 = one] : one \in Sample(2) }
        \cup { [ZeroMsSpdLegInfoLeg39 EXCEPT !.buySell2 = one] : one \in Sample(2) }
        \cup { [ZeroMsSpdLegInfoLeg39 EXCEPT !.disclosedVol2 = one] : one \in Sample(4) }
        \cup { [ZeroMsSpdLegInfoLeg39 EXCEPT !.disclosedVolRemaining2 = one] : one \in Sample(4) }
        \cup { [ZeroMsSpdLegInfoLeg39 EXCEPT !.totalVolRemaining2 = one] : one \in Sample(4) }
        \cup { [ZeroMsSpdLegInfoLeg39 EXCEPT !.volume2 = one] : one \in Sample(4) }
        \cup { [ZeroMsSpdLegInfoLeg39 EXCEPT !.volumeFilledToday2 = one] : one \in Sample(4) }
        \cup { [ZeroMsSpdLegInfoLeg39 EXCEPT !.price2 = one] : one \in Sample(4) }
        \cup { [ZeroMsSpdLegInfoLeg39 EXCEPT !.triggerPrice2 = one] : one \in Sample(4) }
        \cup { [ZeroMsSpdLegInfoLeg39 EXCEPT !.minFillAon2 = one] : one \in Sample(4) }
        \cup { [ZeroMsSpdLegInfoLeg39 EXCEPT !.stOrderFlags = one] : one \in Sample(2) }
        \cup { [ZeroMsSpdLegInfoLeg39 EXCEPT !.openClose2 = one] : one \in Sample(1) }
        \cup { [ZeroMsSpdLegInfoLeg39 EXCEPT !.additionalOrderFlags = one] : one \in Sample(1) }
        \cup { [ZeroMsSpdLegInfoLeg39 EXCEPT !.reserved1 = one] : one \in Sample(1) }
        \cup { [ZeroMsSpdLegInfoLeg39 EXCEPT !.fillerY = one] : one \in Sample(1) }

(***************************************************************************)
(* Sp Order Cxl Rej Out Message: 440 bytes                                 *)
(***************************************************************************)

SpOrderCxlRejOutMessage ==
    [ participantType1       : Sample(1),
      filler1                : Sample(1),
      competitorPeriod1      : Sample(2),
      solicitorPeriod1       : Sample(2),
      modCxlBy1              : Sample(1),
      filler9                : Sample(1),
      reasonCode1            : Sample(2),
      startAlpha1            : Sample(2),
      endAlpha1              : Sample(2),
      token1                 : Sample(4),
      contractDesc           : ContractDesc38,
      opBrokerId1            : Sample(5),
      fillerx1               : Sample(1),
      fillerOptions1         : Sample(3),
      fillery1               : Sample(1),
      orderType1             : Sample(2),
      orderNumber1           : Sample(8),
      accountNumber1         : Sample(10),
      bookType1              : Sample(2),
      buySell1               : Sample(2),
      disclosedVol1          : Sample(4),
      disclosedVolRemaining1 : Sample(4),
      totalVolRemaining1     : Sample(4),
      volume1                : Sample(4),
      volumeFilledToday1     : Sample(4),
      price1                 : Sample(4),
      triggerPrice1          : Sample(4),
      goodTillDate1          : Sample(4),
      entryDateTime1         : Sample(4),
      minFillAon1            : Sample(4),
      lastModified1          : Sample(4),
      stOrderFlags           : Sample(2),
      branchId1              : Sample(2),
      traderId1              : Sample(4),
      brokerId1              : Sample(5),
      cOrdFiller             : Sample(24),
      openClose1             : Sample(1),
      settlor1               : Sample(12),
      proClient1             : Sample(2),
      settlementPeriod1      : Sample(2),
      additionalOrderFlags   : Sample(1),
      reserved1              : Sample(1),
      reserved2              : Sample(2),
      filler17               : Sample(1),
      filler18               : Sample(1),
      nnfField               : Sample(8),
      mktReplay              : Sample(8),
      pan                    : Sample(10),
      algoId                 : Sample(4),
      secondReserved2        : Sample(2),
      lastActivityReference  : Sample(8),
      reserved52             : Sample(52),
      priceDiff              : Sample(4),
      msSpdLegInfoLeg2       : MsSpdLegInfoLeg29,
      msSpdLegInfoLeg3       : MsSpdLegInfoLeg39 ]

EncodeSpOrderCxlRejOutMessage(message) ==
    message.participantType1
        \o message.filler1
        \o message.competitorPeriod1
        \o message.solicitorPeriod1
        \o message.modCxlBy1
        \o message.filler9
        \o message.reasonCode1
        \o message.startAlpha1
        \o message.endAlpha1
        \o message.token1
        \o EncodeContractDesc38(message.contractDesc)
        \o message.opBrokerId1
        \o message.fillerx1
        \o message.fillerOptions1
        \o message.fillery1
        \o message.orderType1
        \o message.orderNumber1
        \o message.accountNumber1
        \o message.bookType1
        \o message.buySell1
        \o message.disclosedVol1
        \o message.disclosedVolRemaining1
        \o message.totalVolRemaining1
        \o message.volume1
        \o message.volumeFilledToday1
        \o message.price1
        \o message.triggerPrice1
        \o message.goodTillDate1
        \o message.entryDateTime1
        \o message.minFillAon1
        \o message.lastModified1
        \o message.stOrderFlags
        \o message.branchId1
        \o message.traderId1
        \o message.brokerId1
        \o message.cOrdFiller
        \o message.openClose1
        \o message.settlor1
        \o message.proClient1
        \o message.settlementPeriod1
        \o message.additionalOrderFlags
        \o message.reserved1
        \o message.reserved2
        \o message.filler17
        \o message.filler18
        \o message.nnfField
        \o message.mktReplay
        \o message.pan
        \o message.algoId
        \o message.secondReserved2
        \o message.lastActivityReference
        \o message.reserved52
        \o message.priceDiff
        \o EncodeMsSpdLegInfoLeg29(message.msSpdLegInfoLeg2)
        \o EncodeMsSpdLegInfoLeg39(message.msSpdLegInfoLeg3)

DecodeSpOrderCxlRejOutMessage(bytes) ==
    LET participantType1 == ReadBytes(bytes, 1) IN IF ~participantType1.ok THEN Fail ELSE
    LET filler1 == ReadBytes(participantType1.rest, 1) IN IF ~filler1.ok THEN Fail ELSE
    LET competitorPeriod1 == ReadBytes(filler1.rest, 2) IN IF ~competitorPeriod1.ok THEN Fail ELSE
    LET solicitorPeriod1 == ReadBytes(competitorPeriod1.rest, 2) IN IF ~solicitorPeriod1.ok THEN Fail ELSE
    LET modCxlBy1 == ReadBytes(solicitorPeriod1.rest, 1) IN IF ~modCxlBy1.ok THEN Fail ELSE
    LET filler9 == ReadBytes(modCxlBy1.rest, 1) IN IF ~filler9.ok THEN Fail ELSE
    LET reasonCode1 == ReadBytes(filler9.rest, 2) IN IF ~reasonCode1.ok THEN Fail ELSE
    LET startAlpha1 == ReadBytes(reasonCode1.rest, 2) IN IF ~startAlpha1.ok THEN Fail ELSE
    LET endAlpha1 == ReadBytes(startAlpha1.rest, 2) IN IF ~endAlpha1.ok THEN Fail ELSE
    LET token1 == ReadBytes(endAlpha1.rest, 4) IN IF ~token1.ok THEN Fail ELSE
    LET contractDesc == DecodeContractDesc38(token1.rest) IN IF ~contractDesc.ok THEN Fail ELSE
    LET opBrokerId1 == ReadBytes(contractDesc.rest, 5) IN IF ~opBrokerId1.ok THEN Fail ELSE
    LET fillerx1 == ReadBytes(opBrokerId1.rest, 1) IN IF ~fillerx1.ok THEN Fail ELSE
    LET fillerOptions1 == ReadBytes(fillerx1.rest, 3) IN IF ~fillerOptions1.ok THEN Fail ELSE
    LET fillery1 == ReadBytes(fillerOptions1.rest, 1) IN IF ~fillery1.ok THEN Fail ELSE
    LET orderType1 == ReadBytes(fillery1.rest, 2) IN IF ~orderType1.ok THEN Fail ELSE
    LET orderNumber1 == ReadBytes(orderType1.rest, 8) IN IF ~orderNumber1.ok THEN Fail ELSE
    LET accountNumber1 == ReadBytes(orderNumber1.rest, 10) IN IF ~accountNumber1.ok THEN Fail ELSE
    LET bookType1 == ReadBytes(accountNumber1.rest, 2) IN IF ~bookType1.ok THEN Fail ELSE
    LET buySell1 == ReadBytes(bookType1.rest, 2) IN IF ~buySell1.ok THEN Fail ELSE
    LET disclosedVol1 == ReadBytes(buySell1.rest, 4) IN IF ~disclosedVol1.ok THEN Fail ELSE
    LET disclosedVolRemaining1 == ReadBytes(disclosedVol1.rest, 4) IN IF ~disclosedVolRemaining1.ok THEN Fail ELSE
    LET totalVolRemaining1 == ReadBytes(disclosedVolRemaining1.rest, 4) IN IF ~totalVolRemaining1.ok THEN Fail ELSE
    LET volume1 == ReadBytes(totalVolRemaining1.rest, 4) IN IF ~volume1.ok THEN Fail ELSE
    LET volumeFilledToday1 == ReadBytes(volume1.rest, 4) IN IF ~volumeFilledToday1.ok THEN Fail ELSE
    LET price1 == ReadBytes(volumeFilledToday1.rest, 4) IN IF ~price1.ok THEN Fail ELSE
    LET triggerPrice1 == ReadBytes(price1.rest, 4) IN IF ~triggerPrice1.ok THEN Fail ELSE
    LET goodTillDate1 == ReadBytes(triggerPrice1.rest, 4) IN IF ~goodTillDate1.ok THEN Fail ELSE
    LET entryDateTime1 == ReadBytes(goodTillDate1.rest, 4) IN IF ~entryDateTime1.ok THEN Fail ELSE
    LET minFillAon1 == ReadBytes(entryDateTime1.rest, 4) IN IF ~minFillAon1.ok THEN Fail ELSE
    LET lastModified1 == ReadBytes(minFillAon1.rest, 4) IN IF ~lastModified1.ok THEN Fail ELSE
    LET stOrderFlags == ReadBytes(lastModified1.rest, 2) IN IF ~stOrderFlags.ok THEN Fail ELSE
    LET branchId1 == ReadBytes(stOrderFlags.rest, 2) IN IF ~branchId1.ok THEN Fail ELSE
    LET traderId1 == ReadBytes(branchId1.rest, 4) IN IF ~traderId1.ok THEN Fail ELSE
    LET brokerId1 == ReadBytes(traderId1.rest, 5) IN IF ~brokerId1.ok THEN Fail ELSE
    LET cOrdFiller == ReadBytes(brokerId1.rest, 24) IN IF ~cOrdFiller.ok THEN Fail ELSE
    LET openClose1 == ReadBytes(cOrdFiller.rest, 1) IN IF ~openClose1.ok THEN Fail ELSE
    LET settlor1 == ReadBytes(openClose1.rest, 12) IN IF ~settlor1.ok THEN Fail ELSE
    LET proClient1 == ReadBytes(settlor1.rest, 2) IN IF ~proClient1.ok THEN Fail ELSE
    LET settlementPeriod1 == ReadBytes(proClient1.rest, 2) IN IF ~settlementPeriod1.ok THEN Fail ELSE
    LET additionalOrderFlags == ReadBytes(settlementPeriod1.rest, 1) IN IF ~additionalOrderFlags.ok THEN Fail ELSE
    LET reserved1 == ReadBytes(additionalOrderFlags.rest, 1) IN IF ~reserved1.ok THEN Fail ELSE
    LET reserved2 == ReadBytes(reserved1.rest, 2) IN IF ~reserved2.ok THEN Fail ELSE
    LET filler17 == ReadBytes(reserved2.rest, 1) IN IF ~filler17.ok THEN Fail ELSE
    LET filler18 == ReadBytes(filler17.rest, 1) IN IF ~filler18.ok THEN Fail ELSE
    LET nnfField == ReadBytes(filler18.rest, 8) IN IF ~nnfField.ok THEN Fail ELSE
    LET mktReplay == ReadBytes(nnfField.rest, 8) IN IF ~mktReplay.ok THEN Fail ELSE
    LET pan == ReadBytes(mktReplay.rest, 10) IN IF ~pan.ok THEN Fail ELSE
    LET algoId == ReadBytes(pan.rest, 4) IN IF ~algoId.ok THEN Fail ELSE
    LET secondReserved2 == ReadBytes(algoId.rest, 2) IN IF ~secondReserved2.ok THEN Fail ELSE
    LET lastActivityReference == ReadBytes(secondReserved2.rest, 8) IN IF ~lastActivityReference.ok THEN Fail ELSE
    LET reserved52 == ReadBytes(lastActivityReference.rest, 52) IN IF ~reserved52.ok THEN Fail ELSE
    LET priceDiff == ReadBytes(reserved52.rest, 4) IN IF ~priceDiff.ok THEN Fail ELSE
    LET msSpdLegInfoLeg2 == DecodeMsSpdLegInfoLeg29(priceDiff.rest) IN IF ~msSpdLegInfoLeg2.ok THEN Fail ELSE
    LET msSpdLegInfoLeg3 == DecodeMsSpdLegInfoLeg39(msSpdLegInfoLeg2.rest) IN IF ~msSpdLegInfoLeg3.ok THEN Fail ELSE
    Ok([ participantType1       |-> participantType1.value,
         filler1                |-> filler1.value,
         competitorPeriod1      |-> competitorPeriod1.value,
         solicitorPeriod1       |-> solicitorPeriod1.value,
         modCxlBy1              |-> modCxlBy1.value,
         filler9                |-> filler9.value,
         reasonCode1            |-> reasonCode1.value,
         startAlpha1            |-> startAlpha1.value,
         endAlpha1              |-> endAlpha1.value,
         token1                 |-> token1.value,
