CheckedContractDesc56 ==
    { ZeroContractDesc56 }
        \cup { [ZeroContractDesc56 EXCEPT !.instrumentName = one] : one \in Sample(6) }
        \cup { [ZeroContractDesc56 EXCEPT !.symbol = one] : one \in Sample(10) }
        \cup { [ZeroContractDesc56 EXCEPT !.expiryDate = one] : one \in Sample(4) }
        \cup { [ZeroContractDesc56 EXCEPT !.strikePrice = one] : one \in Sample(4) }
        \cup { [ZeroContractDesc56 EXCEPT !.optionType = one] : one \in Sample(2) }
        \cup { [ZeroContractDesc56 EXCEPT !.caLevel = one] : one \in Sample(2) }

