        \cup { [ZeroMsSpdLegInfoLeg316 EXCEPT !.volume2 = one] : one \in Sample(4) }
        \cup { [ZeroMsSpdLegInfoLeg316 EXCEPT !.volumeFilledToday2 = one] : one \in Sample(4) }
        \cup { [ZeroMsSpdLegInfoLeg316 EXCEPT !.price2 = one] : one \in Sample(4) }
        \cup { [ZeroMsSpdLegInfoLeg316 EXCEPT !.triggerPrice2 = one] : one \in Sample(4) }
        \cup { [ZeroMsSpdLegInfoLeg316 EXCEPT !.minFillAon2 = one] : one \in Sample(4) }
        \cup { [ZeroMsSpdLegInfoLeg316 EXCEPT !.stOrderFlags = one] : one \in Sample(2) }
        \cup { [ZeroMsSpdLegInfoLeg316 EXCEPT !.openClose2 = one] : one \in Sample(1) }
        \cup { [ZeroMsSpdLegInfoLeg316 EXCEPT !.additionalOrderFlags = one] : one \in Sample(1) }
        \cup { [ZeroMsSpdLegInfoLeg316 EXCEPT !.reserved1 = one] : one \in Sample(1) }
        \cup { [ZeroMsSpdLegInfoLeg316 EXCEPT !.fillerY = one] : one \in Sample(1) }

(***************************************************************************)
(* Thrl Order Error Message: 440 bytes                                     *)
(***************************************************************************)

ThrlOrderErrorMessage ==
    [ participantType1       : Sample(1),
      filler1                : Sample(1),
      competitorPeriod1      : Sample(2),
      solicitorPeriod1       : Sample(2),
      modCxlBy1              : Sample(1),
      filler9                : Sample(1),
      reasonCode1            : Sample(2),
      startAlpha1            : Sample(2),
      endAlpha1              : Sample(2),
      token1                 : Sample(4),
      contractDesc           : ContractDesc59,
      opBrokerId1            : Sample(5),
      fillerx1               : Sample(1),
      fillerOptions1         : Sample(3),
      fillery1               : Sample(1),
      orderType1             : Sample(2),
      orderNumber1           : Sample(8),
      accountNumber1         : Sample(10),
      bookType1              : Sample(2),
      buySell1               : Sample(2),
      disclosedVol1          : Sample(4),
      disclosedVolRemaining1 : Sample(4),
      totalVolRemaining1     : Sample(4),
      volume1                : Sample(4),
      volumeFilledToday1     : Sample(4),
      price1                 : Sample(4),
      triggerPrice1          : Sample(4),
      goodTillDate1          : Sample(4),
      entryDateTime1         : Sample(4),
      minFillAon1            : Sample(4),
      lastModified1          : Sample(4),
      stOrderFlags           : Sample(2),
      branchId1              : Sample(2),
      traderId1              : Sample(4),
      brokerId1              : Sample(5),
      cOrdFiller             : Sample(24),
      openClose1             : Sample(1),
      settlor1               : Sample(12),
      proClient1             : Sample(2),
      settlementPeriod1      : Sample(2),
      additionalOrderFlags   : Sample(1),
      reserved1              : Sample(1),
      reserved2              : Sample(2),
      filler17               : Sample(1),
      filler18               : Sample(1),
      nnfField               : Sample(8),
      mktReplay              : Sample(8),
      pan                    : Sample(10),
      algoId                 : Sample(4),
      secondReserved2        : Sample(2),
      lastActivityReference  : Sample(8),
      reserved52             : Sample(52),
      priceDiff              : Sample(4),
      msSpdLegInfoLeg2       : MsSpdLegInfoLeg216,
      msSpdLegInfoLeg3       : MsSpdLegInfoLeg316 ]

EncodeThrlOrderErrorMessage(message) ==
    message.participantType1
        \o message.filler1
        \o message.competitorPeriod1
        \o message.solicitorPeriod1
        \o message.modCxlBy1
        \o message.filler9
        \o message.reasonCode1
        \o message.startAlpha1
        \o message.endAlpha1
        \o message.token1
        \o EncodeContractDesc59(message.contractDesc)
        \o message.opBrokerId1
        \o message.fillerx1
        \o message.fillerOptions1
        \o message.fillery1
        \o message.orderType1
        \o message.orderNumber1
        \o message.accountNumber1
        \o message.bookType1
        \o message.buySell1
        \o message.disclosedVol1
        \o message.disclosedVolRemaining1
        \o message.totalVolRemaining1
        \o message.volume1
        \o message.volumeFilledToday1
        \o message.price1
        \o message.triggerPrice1
        \o message.goodTillDate1
        \o message.entryDateTime1
        \o message.minFillAon1
        \o message.lastModified1
        \o message.stOrderFlags
        \o message.branchId1
        \o message.traderId1
        \o message.brokerId1
        \o message.cOrdFiller
        \o message.openClose1
        \o message.settlor1
        \o message.proClient1
        \o message.settlementPeriod1
        \o message.additionalOrderFlags
        \o message.reserved1
        \o message.reserved2
        \o message.filler17
        \o message.filler18
        \o message.nnfField
        \o message.mktReplay
        \o message.pan
        \o message.algoId
        \o message.secondReserved2
        \o message.lastActivityReference
        \o message.reserved52
        \o message.priceDiff
        \o EncodeMsSpdLegInfoLeg216(message.msSpdLegInfoLeg2)
        \o EncodeMsSpdLegInfoLeg316(message.msSpdLegInfoLeg3)

DecodeThrlOrderErrorMessage(bytes) ==
    LET participantType1 == ReadBytes(bytes, 1) IN IF ~participantType1.ok THEN Fail ELSE
    LET filler1 == ReadBytes(participantType1.rest, 1) IN IF ~filler1.ok THEN Fail ELSE
    LET competitorPeriod1 == ReadBytes(filler1.rest, 2) IN IF ~competitorPeriod1.ok THEN Fail ELSE
    LET solicitorPeriod1 == ReadBytes(competitorPeriod1.rest, 2) IN IF ~solicitorPeriod1.ok THEN Fail ELSE
    LET modCxlBy1 == ReadBytes(solicitorPeriod1.rest, 1) IN IF ~modCxlBy1.ok THEN Fail ELSE
    LET filler9 == ReadBytes(modCxlBy1.rest, 1) IN IF ~filler9.ok THEN Fail ELSE
    LET reasonCode1 == ReadBytes(filler9.rest, 2) IN IF ~reasonCode1.ok THEN Fail ELSE
    LET startAlpha1 == ReadBytes(reasonCode1.rest, 2) IN IF ~startAlpha1.ok THEN Fail ELSE
    LET endAlpha1 == ReadBytes(startAlpha1.rest, 2) IN IF ~endAlpha1.ok THEN Fail ELSE
    LET token1 == ReadBytes(endAlpha1.rest, 4) IN IF ~token1.ok THEN Fail ELSE
    LET contractDesc == DecodeContractDesc59(token1.rest) IN IF ~contractDesc.ok THEN Fail ELSE
    LET opBrokerId1 == ReadBytes(contractDesc.rest, 5) IN IF ~opBrokerId1.ok THEN Fail ELSE
    LET fillerx1 == ReadBytes(opBrokerId1.rest, 1) IN IF ~fillerx1.ok THEN Fail ELSE
    LET fillerOptions1 == ReadBytes(fillerx1.rest, 3) IN IF ~fillerOptions1.ok THEN Fail ELSE
    LET fillery1 == ReadBytes(fillerOptions1.rest, 1) IN IF ~fillery1.ok THEN Fail ELSE
    LET orderType1 == ReadBytes(fillery1.rest, 2) IN IF ~orderType1.ok THEN Fail ELSE
    LET orderNumber1 == ReadBytes(orderType1.rest, 8) IN IF ~orderNumber1.ok THEN Fail ELSE
    LET accountNumber1 == ReadBytes(orderNumber1.rest, 10) IN IF ~accountNumber1.ok THEN Fail ELSE
    LET bookType1 == ReadBytes(accountNumber1.rest, 2) IN IF ~bookType1.ok THEN Fail ELSE
    LET buySell1 == ReadBytes(bookType1.rest, 2) IN IF ~buySell1.ok THEN Fail ELSE
    LET disclosedVol1 == ReadBytes(buySell1.rest, 4) IN IF ~disclosedVol1.ok THEN Fail ELSE
    LET disclosedVolRemaining1 == ReadBytes(disclosedVol1.rest, 4) IN IF ~disclosedVolRemaining1.ok THEN Fail ELSE
    LET totalVolRemaining1 == ReadBytes(disclosedVolRemaining1.rest, 4) IN IF ~totalVolRemaining1.ok THEN Fail ELSE
    LET volume1 == ReadBytes(totalVolRemaining1.rest, 4) IN IF ~volume1.ok THEN Fail ELSE
    LET volumeFilledToday1 == ReadBytes(volume1.rest, 4) IN IF ~volumeFilledToday1.ok THEN Fail ELSE
    LET price1 == ReadBytes(volumeFilledToday1.rest, 4) IN IF ~price1.ok THEN Fail ELSE
    LET triggerPrice1 == ReadBytes(price1.rest, 4) IN IF ~triggerPrice1.ok THEN Fail ELSE
    LET goodTillDate1 == ReadBytes(triggerPrice1.rest, 4) IN IF ~goodTillDate1.ok THEN Fail ELSE
    LET entryDateTime1 == ReadBytes(goodTillDate1.rest, 4) IN IF ~entryDateTime1.ok THEN Fail ELSE
    LET minFillAon1 == ReadBytes(entryDateTime1.rest, 4) IN IF ~minFillAon1.ok THEN Fail ELSE
    LET lastModified1 == ReadBytes(minFillAon1.rest, 4) IN IF ~lastModified1.ok THEN Fail ELSE
    LET stOrderFlags == ReadBytes(lastModified1.rest, 2) IN IF ~stOrderFlags.ok THEN Fail ELSE
    LET branchId1 == ReadBytes(stOrderFlags.rest, 2) IN IF ~branchId1.ok THEN Fail ELSE
    LET traderId1 == ReadBytes(branchId1.rest, 4) IN IF ~traderId1.ok THEN Fail ELSE
    LET brokerId1 == ReadBytes(traderId1.rest, 5) IN IF ~brokerId1.ok THEN Fail ELSE
    LET cOrdFiller == ReadBytes(brokerId1.rest, 24) IN IF ~cOrdFiller.ok THEN Fail ELSE
    LET openClose1 == ReadBytes(cOrdFiller.rest, 1) IN IF ~openClose1.ok THEN Fail ELSE
    LET settlor1 == ReadBytes(openClose1.rest, 12) IN IF ~settlor1.ok THEN Fail ELSE
    LET proClient1 == ReadBytes(settlor1.rest, 2) IN IF ~proClient1.ok THEN Fail ELSE
    LET settlementPeriod1 == ReadBytes(proClient1.rest, 2) IN IF ~settlementPeriod1.ok THEN Fail ELSE
    LET additionalOrderFlags == ReadBytes(settlementPeriod1.rest, 1) IN IF ~additionalOrderFlags.ok THEN Fail ELSE
    LET reserved1 == ReadBytes(additionalOrderFlags.rest, 1) IN IF ~reserved1.ok THEN Fail ELSE
    LET reserved2 == ReadBytes(reserved1.rest, 2) IN IF ~reserved2.ok THEN Fail ELSE
    LET filler17 == ReadBytes(reserved2.rest, 1) IN IF ~filler17.ok THEN Fail ELSE
    LET filler18 == ReadBytes(filler17.rest, 1) IN IF ~filler18.ok THEN Fail ELSE
    LET nnfField == ReadBytes(filler18.rest, 8) IN IF ~nnfField.ok THEN Fail ELSE
    LET mktReplay == ReadBytes(nnfField.rest, 8) IN IF ~mktReplay.ok THEN Fail ELSE
    LET pan == ReadBytes(mktReplay.rest, 10) IN IF ~pan.ok THEN Fail ELSE
    LET algoId == ReadBytes(pan.rest, 4) IN IF ~algoId.ok THEN Fail ELSE
    LET secondReserved2 == ReadBytes(algoId.rest, 2) IN IF ~secondReserved2.ok THEN Fail ELSE
    LET lastActivityReference == ReadBytes(secondReserved2.rest, 8) IN IF ~lastActivityReference.ok THEN Fail ELSE
    LET reserved52 == ReadBytes(lastActivityReference.rest, 52) IN IF ~reserved52.ok THEN Fail ELSE
    LET priceDiff == ReadBytes(reserved52.rest, 4) IN IF ~priceDiff.ok THEN Fail ELSE
    LET msSpdLegInfoLeg2 == DecodeMsSpdLegInfoLeg216(priceDiff.rest) IN IF ~msSpdLegInfoLeg2.ok THEN Fail ELSE
    LET msSpdLegInfoLeg3 == DecodeMsSpdLegInfoLeg316(msSpdLegInfoLeg2.rest) IN IF ~msSpdLegInfoLeg3.ok THEN Fail ELSE
    Ok([ participantType1       |-> participantType1.value,
         filler1                |-> filler1.value,
         competitorPeriod1      |-> competitorPeriod1.value,
         solicitorPeriod1       |-> solicitorPeriod1.value,
         modCxlBy1              |-> modCxlBy1.value,
         filler9                |-> filler9.value,
         reasonCode1            |-> reasonCode1.value,
         startAlpha1            |-> startAlpha1.value,
         endAlpha1              |-> endAlpha1.value,
         token1                 |-> token1.value,
         contractDesc           |-> contractDesc.value,
         opBrokerId1            |-> opBrokerId1.value,
         fillerx1               |-> fillerx1.value,
         fillerOptions1         |-> fillerOptions1.value,
         fillery1               |-> fillery1.value,
         orderType1             |-> orderType1.value,
         orderNumber1           |-> orderNumber1.value,
         accountNumber1         |-> accountNumber1.value,
         bookType1              |-> bookType1.value,
         buySell1               |-> buySell1.value,
         disclosedVol1          |-> disclosedVol1.value,
         disclosedVolRemaining1 |-> disclosedVolRemaining1.value,
         totalVolRemaining1     |-> totalVolRemaining1.value,
         volume1                |-> volume1.value,
         volumeFilledToday1     |-> volumeFilledToday1.value,
         price1                 |-> price1.value,
         triggerPrice1          |-> triggerPrice1.value,
         goodTillDate1          |-> goodTillDate1.value,
         entryDateTime1         |-> entryDateTime1.value,
         minFillAon1            |-> minFillAon1.value,
         lastModified1          |-> lastModified1.value,
         stOrderFlags           |-> stOrderFlags.value,
         branchId1              |-> branchId1.value,
         traderId1              |-> traderId1.value,
         brokerId1              |-> brokerId1.value,
         cOrdFiller             |-> cOrdFiller.value,
         openClose1             |-> openClose1.value,
         settlor1               |-> settlor1.value,
         proClient1             |-> proClient1.value,
         settlementPeriod1      |-> settlementPeriod1.value,
         additionalOrderFlags   |-> additionalOrderFlags.value,
         reserved1              |-> reserved1.value,
         reserved2              |-> reserved2.value,
         filler17               |-> filler17.value,
         filler18               |-> filler18.value,
         nnfField               |-> nnfField.value,
         mktReplay              |-> mktReplay.value,
         pan                    |-> pan.value,
         algoId                 |-> algoId.value,
         secondReserved2        |-> secondReserved2.value,
         lastActivityReference  |-> lastActivityReference.value,
         reserved52             |-> reserved52.value,
         priceDiff              |-> priceDiff.value,
         msSpdLegInfoLeg2       |-> msSpdLegInfoLeg2.value,
         msSpdLegInfoLeg3       |-> msSpdLegInfoLeg3.value ], msSpdLegInfoLeg3.rest)

ZeroThrlOrderErrorMessage ==
    [ participantType1       |-> [i \in 1 .. 1 |-> 0],
      filler1                |-> [i \in 1 .. 1 |-> 0],
      competitorPeriod1      |-> [i \in 1 .. 2 |-> 0],
      solicitorPeriod1       |-> [i \in 1 .. 2 |-> 0],
      modCxlBy1              |-> [i \in 1 .. 1 |-> 0],
      filler9                |-> [i \in 1 .. 1 |-> 0],
      reasonCode1            |-> [i \in 1 .. 2 |-> 0],
      startAlpha1            |-> [i \in 1 .. 2 |-> 0],
      endAlpha1              |-> [i \in 1 .. 2 |-> 0],
      token1                 |-> [i \in 1 .. 4 |-> 0],
      contractDesc           |-> ZeroContractDesc59,
      opBrokerId1            |-> [i \in 1 .. 5 |-> 0],
      fillerx1               |-> [i \in 1 .. 1 |-> 0],
      fillerOptions1         |-> [i \in 1 .. 3 |-> 0],
      fillery1               |-> [i \in 1 .. 1 |-> 0],
      orderType1             |-> [i \in 1 .. 2 |-> 0],
      orderNumber1           |-> [i \in 1 .. 8 |-> 0],
      accountNumber1         |-> [i \in 1 .. 10 |-> 0],
      bookType1              |-> [i \in 1 .. 2 |-> 0],
      buySell1               |-> [i \in 1 .. 2 |-> 0],
      disclosedVol1          |-> [i \in 1 .. 4 |-> 0],
      disclosedVolRemaining1 |-> [i \in 1 .. 4 |-> 0],
      totalVolRemaining1     |-> [i \in 1 .. 4 |-> 0],
      volume1                |-> [i \in 1 .. 4 |-> 0],
      volumeFilledToday1     |-> [i \in 1 .. 4 |-> 0],
      price1                 |-> [i \in 1 .. 4 |-> 0],
      triggerPrice1          |-> [i \in 1 .. 4 |-> 0],
      goodTillDate1          |-> [i \in 1 .. 4 |-> 0],
      entryDateTime1         |-> [i \in 1 .. 4 |-> 0],
      minFillAon1            |-> [i \in 1 .. 4 |-> 0],
      lastModified1          |-> [i \in 1 .. 4 |-> 0],
      stOrderFlags           |-> [i \in 1 .. 2 |-> 0],
      branchId1              |-> [i \in 1 .. 2 |-> 0],
      traderId1              |-> [i \in 1 .. 4 |-> 0],
      brokerId1              |-> [i \in 1 .. 5 |-> 0],
      cOrdFiller             |-> [i \in 1 .. 24 |-> 0],
      openClose1             |-> [i \in 1 .. 1 |-> 0],
      settlor1               |-> [i \in 1 .. 12 |-> 0],
      proClient1             |-> [i \in 1 .. 2 |-> 0],
      settlementPeriod1      |-> [i \in 1 .. 2 |-> 0],
      additionalOrderFlags   |-> [i \in 1 .. 1 |-> 0],
      reserved1              |-> [i \in 1 .. 1 |-> 0],
      reserved2              |-> [i \in 1 .. 2 |-> 0],
      filler17               |-> [i \in 1 .. 1 |-> 0],
      filler18               |-> [i \in 1 .. 1 |-> 0],
      nnfField               |-> [i \in 1 .. 8 |-> 0],
      mktReplay              |-> [i \in 1 .. 8 |-> 0],
      pan                    |-> [i \in 1 .. 10 |-> 0],
      algoId                 |-> [i \in 1 .. 4 |-> 0],
      secondReserved2        |-> [i \in 1 .. 2 |-> 0],
      lastActivityReference  |-> [i \in 1 .. 8 |-> 0],
      reserved52             |-> [i \in 1 .. 52 |-> 0],
      priceDiff              |-> [i \in 1 .. 4 |-> 0],
      msSpdLegInfoLeg2       |-> ZeroMsSpdLegInfoLeg216,
      msSpdLegInfoLeg3       |-> ZeroMsSpdLegInfoLeg316 ]

(* Thrl Order Error Message at zero, then each field in turn at the values it is checked at *)
CheckedThrlOrderErrorMessage ==
    { ZeroThrlOrderErrorMessage }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.participantType1 = one] : one \in Sample(1) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.filler1 = one] : one \in Sample(1) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.competitorPeriod1 = one] : one \in Sample(2) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.solicitorPeriod1 = one] : one \in Sample(2) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.modCxlBy1 = one] : one \in Sample(1) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.filler9 = one] : one \in Sample(1) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.reasonCode1 = one] : one \in Sample(2) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.startAlpha1 = one] : one \in Sample(2) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.endAlpha1 = one] : one \in Sample(2) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.token1 = one] : one \in Sample(4) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.contractDesc = one] : one \in CheckedContractDesc59 }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.opBrokerId1 = one] : one \in Sample(5) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.fillerx1 = one] : one \in Sample(1) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.fillerOptions1 = one] : one \in Sample(3) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.fillery1 = one] : one \in Sample(1) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.orderType1 = one] : one \in Sample(2) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.orderNumber1 = one] : one \in Sample(8) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.accountNumber1 = one] : one \in Sample(10) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.bookType1 = one] : one \in Sample(2) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.buySell1 = one] : one \in Sample(2) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.disclosedVol1 = one] : one \in Sample(4) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.disclosedVolRemaining1 = one] : one \in Sample(4) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.totalVolRemaining1 = one] : one \in Sample(4) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.volume1 = one] : one \in Sample(4) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.volumeFilledToday1 = one] : one \in Sample(4) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.price1 = one] : one \in Sample(4) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.triggerPrice1 = one] : one \in Sample(4) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.goodTillDate1 = one] : one \in Sample(4) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.entryDateTime1 = one] : one \in Sample(4) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.minFillAon1 = one] : one \in Sample(4) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.lastModified1 = one] : one \in Sample(4) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.stOrderFlags = one] : one \in Sample(2) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.branchId1 = one] : one \in Sample(2) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.traderId1 = one] : one \in Sample(4) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.brokerId1 = one] : one \in Sample(5) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.cOrdFiller = one] : one \in Sample(24) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.openClose1 = one] : one \in Sample(1) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.settlor1 = one] : one \in Sample(12) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.proClient1 = one] : one \in Sample(2) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.settlementPeriod1 = one] : one \in Sample(2) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.additionalOrderFlags = one] : one \in Sample(1) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.reserved1 = one] : one \in Sample(1) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.reserved2 = one] : one \in Sample(2) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.filler17 = one] : one \in Sample(1) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.filler18 = one] : one \in Sample(1) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.nnfField = one] : one \in Sample(8) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.mktReplay = one] : one \in Sample(8) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.pan = one] : one \in Sample(10) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.algoId = one] : one \in Sample(4) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.secondReserved2 = one] : one \in Sample(2) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.lastActivityReference = one] : one \in Sample(8) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.reserved52 = one] : one \in Sample(52) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.priceDiff = one] : one \in Sample(4) }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.msSpdLegInfoLeg2 = one] : one \in CheckedMsSpdLegInfoLeg216 }
        \cup { [ZeroThrlOrderErrorMessage EXCEPT !.msSpdLegInfoLeg3 = one] : one \in CheckedMsSpdLegInfoLeg316 }

(***************************************************************************)
(* Contract Desc: 28 bytes                                                 *)
(***************************************************************************)

ContractDesc62 ==
    [ instrumentName : Sample(6),
      symbol         : Sample(10),
      expiryDate     : Sample(4),
      strikePrice    : Sample(4),
      optionType     : Sample(2),
      caLevel        : Sample(2) ]

EncodeContractDesc62(message) ==
    message.instrumentName
        \o message.symbol
        \o message.expiryDate
        \o message.strikePrice
        \o message.optionType
        \o message.caLevel

DecodeContractDesc62(bytes) ==
    LET instrumentName == ReadBytes(bytes, 6) IN IF ~instrumentName.ok THEN Fail ELSE
    LET symbol == ReadBytes(instrumentName.rest, 10) IN IF ~symbol.ok THEN Fail ELSE
    LET expiryDate == ReadBytes(symbol.rest, 4) IN IF ~expiryDate.ok THEN Fail ELSE
    LET strikePrice == ReadBytes(expiryDate.rest, 4) IN IF ~strikePrice.ok THEN Fail ELSE
    LET optionType == ReadBytes(strikePrice.rest, 2) IN IF ~optionType.ok THEN Fail ELSE
    LET caLevel == ReadBytes(optionType.rest, 2) IN IF ~caLevel.ok THEN Fail ELSE
    Ok([ instrumentName |-> instrumentName.value,
         symbol         |-> symbol.value,
         expiryDate     |-> expiryDate.value,
         strikePrice    |-> strikePrice.value,
         optionType     |-> optionType.value,
         caLevel        |-> caLevel.value ], caLevel.rest)

ZeroContractDesc62 ==
    [ instrumentName |-> [i \in 1 .. 6 |-> 0],
      symbol         |-> [i \in 1 .. 10 |-> 0],
      expiryDate     |-> [i \in 1 .. 4 |-> 0],
      strikePrice    |-> [i \in 1 .. 4 |-> 0],
      optionType     |-> [i \in 1 .. 2 |-> 0],
      caLevel        |-> [i \in 1 .. 2 |-> 0] ]

(* Contract Desc at zero, then each field in turn at the values it is checked at *)
CheckedContractDesc62 ==
    { ZeroContractDesc62 }
        \cup { [ZeroContractDesc62 EXCEPT !.instrumentName = one] : one \in Sample(6) }
        \cup { [ZeroContractDesc62 EXCEPT !.symbol = one] : one \in Sample(10) }
        \cup { [ZeroContractDesc62 EXCEPT !.expiryDate = one] : one \in Sample(4) }
        \cup { [ZeroContractDesc62 EXCEPT !.strikePrice = one] : one \in Sample(4) }
        \cup { [ZeroContractDesc62 EXCEPT !.optionType = one] : one \in Sample(2) }
        \cup { [ZeroContractDesc62 EXCEPT !.caLevel = one] : one \in Sample(2) }

(***************************************************************************)
(* On Stop Notification Message: 256 bytes                                 *)
(***************************************************************************)

OnStopNotificationMessage ==
    [ responseOrderNumber      : Sample(8),
      brokerId                 : Sample(5),
      reserved1                : Sample(1),
      traderNumber             : Sample(4),
      accountNumber            : Sample(10),
      buySellIndicator         : Sample(2),
      originalVolume           : Sample(4),
      disclosedVolume          : Sample(4),
      remainingVolume          : Sample(4),
      disclosedVolumeRemaining : Sample(4),
      price                    : Sample(4),
      stOrderFlags             : Sample(2),
      goodTillDate             : Sample(4),
      fillNumber               : Sample(4),
      fillQuantity             : Sample(4),
      fillPrice                : Sample(4),
      volumeFilledToday        : Sample(4),
      activityType             : Sample(2),
      activityTime             : Sample(4),
      counterTraderOrderNumber : Sample(8),
      counterBrokerId          : Sample(5),
      secondReserved1          : Sample(1),
      token                    : Sample(4),
      contractDesc             : ContractDesc62,
      openClose                : Sample(1),
      oldOpenClose             : Sample(1),
      bookTypeChar1            : Sample(1),
      thirdReserved1           : Sample(1),
      reserved4                : Sample(4),
      oldAccountNumber         : Sample(10),
      participant              : Sample(12),
      oldParticipant           : Sample(12),
      additionalOrderFlags     : Sample(1),
      fourthReserved1          : Sample(1),
      fifthReserved1           : Sample(1),
      sixthReserved1           : Sample(1),
      pan                      : Sample(10),
      oldPan                   : Sample(10),
      algoId                   : Sample(4),
      reserved2                : Sample(2),
      lastActivityReference    : Sample(8),
      reserved52               : Sample(52) ]

EncodeOnStopNotificationMessage(message) ==
    message.responseOrderNumber
        \o message.brokerId
        \o message.reserved1
        \o message.traderNumber
        \o message.accountNumber
        \o message.buySellIndicator
        \o message.originalVolume
        \o message.disclosedVolume
        \o message.remainingVolume
        \o message.disclosedVolumeRemaining
        \o message.price
        \o message.stOrderFlags
        \o message.goodTillDate
        \o message.fillNumber
        \o message.fillQuantity
        \o message.fillPrice
        \o message.volumeFilledToday
        \o message.activityType
        \o message.activityTime
        \o message.counterTraderOrderNumber
        \o message.counterBrokerId
        \o message.secondReserved1
        \o message.token
        \o EncodeContractDesc62(message.contractDesc)
        \o message.openClose
        \o message.oldOpenClose
        \o message.bookTypeChar1
        \o message.thirdReserved1
        \o message.reserved4
        \o message.oldAccountNumber
        \o message.participant
        \o message.oldParticipant
        \o message.additionalOrderFlags
        \o message.fourthReserved1
        \o message.fifthReserved1
        \o message.sixthReserved1
        \o message.pan
        \o message.oldPan
        \o message.algoId
        \o message.reserved2
        \o message.lastActivityReference
        \o message.reserved52

DecodeOnStopNotificationMessage(bytes) ==
    LET responseOrderNumber == ReadBytes(bytes, 8) IN IF ~responseOrderNumber.ok THEN Fail ELSE
    LET brokerId == ReadBytes(responseOrderNumber.rest, 5) IN IF ~brokerId.ok THEN Fail ELSE
    LET reserved1 == ReadBytes(brokerId.rest, 1) IN IF ~reserved1.ok THEN Fail ELSE
    LET traderNumber == ReadBytes(reserved1.rest, 4) IN IF ~traderNumber.ok THEN Fail ELSE
    LET accountNumber == ReadBytes(traderNumber.rest, 10) IN IF ~accountNumber.ok THEN Fail ELSE
    LET buySellIndicator == ReadBytes(accountNumber.rest, 2) IN IF ~buySellIndicator.ok THEN Fail ELSE
    LET originalVolume == ReadBytes(buySellIndicator.rest, 4) IN IF ~originalVolume.ok THEN Fail ELSE
    LET disclosedVolume == ReadBytes(originalVolume.rest, 4) IN IF ~disclosedVolume.ok THEN Fail ELSE
    LET remainingVolume == ReadBytes(disclosedVolume.rest, 4) IN IF ~remainingVolume.ok THEN Fail ELSE
    LET disclosedVolumeRemaining == ReadBytes(remainingVolume.rest, 4) IN IF ~disclosedVolumeRemaining.ok THEN Fail ELSE
    LET price == ReadBytes(disclosedVolumeRemaining.rest, 4) IN IF ~price.ok THEN Fail ELSE
    LET stOrderFlags == ReadBytes(price.rest, 2) IN IF ~stOrderFlags.ok THEN Fail ELSE
    LET goodTillDate == ReadBytes(stOrderFlags.rest, 4) IN IF ~goodTillDate.ok THEN Fail ELSE
    LET fillNumber == ReadBytes(goodTillDate.rest, 4) IN IF ~fillNumber.ok THEN Fail ELSE
    LET fillQuantity == ReadBytes(fillNumber.rest, 4) IN IF ~fillQuantity.ok THEN Fail ELSE
    LET fillPrice == ReadBytes(fillQuantity.rest, 4) IN IF ~fillPrice.ok THEN Fail ELSE
    LET volumeFilledToday == ReadBytes(fillPrice.rest, 4) IN IF ~volumeFilledToday.ok THEN Fail ELSE
    LET activityType == ReadBytes(volumeFilledToday.rest, 2) IN IF ~activityType.ok THEN Fail ELSE
    LET activityTime == ReadBytes(activityType.rest, 4) IN IF ~activityTime.ok THEN Fail ELSE
    LET counterTraderOrderNumber == ReadBytes(activityTime.rest, 8) IN IF ~counterTraderOrderNumber.ok THEN Fail ELSE
    LET counterBrokerId == ReadBytes(counterTraderOrderNumber.rest, 5) IN IF ~counterBrokerId.ok THEN Fail ELSE
    LET secondReserved1 == ReadBytes(counterBrokerId.rest, 1) IN IF ~secondReserved1.ok THEN Fail ELSE
    LET token == ReadBytes(secondReserved1.rest, 4) IN IF ~token.ok THEN Fail ELSE
    LET contractDesc == DecodeContractDesc62(token.rest) IN IF ~contractDesc.ok THEN Fail ELSE
    LET openClose == ReadBytes(contractDesc.rest, 1) IN IF ~openClose.ok THEN Fail ELSE
    LET oldOpenClose == ReadBytes(openClose.rest, 1) IN IF ~oldOpenClose.ok THEN Fail ELSE
    LET bookTypeChar1 == ReadBytes(oldOpenClose.rest, 1) IN IF ~bookTypeChar1.ok THEN Fail ELSE
    LET thirdReserved1 == ReadBytes(bookTypeChar1.rest, 1) IN IF ~thirdReserved1.ok THEN Fail ELSE
    LET reserved4 == ReadBytes(thirdReserved1.rest, 4) IN IF ~reserved4.ok THEN Fail ELSE
    LET oldAccountNumber == ReadBytes(reserved4.rest, 10) IN IF ~oldAccountNumber.ok THEN Fail ELSE
    LET participant == ReadBytes(oldAccountNumber.rest, 12) IN IF ~participant.ok THEN Fail ELSE
    LET oldParticipant == ReadBytes(participant.rest, 12) IN IF ~oldParticipant.ok THEN Fail ELSE
    LET additionalOrderFlags == ReadBytes(oldParticipant.rest, 1) IN IF ~additionalOrderFlags.ok THEN Fail ELSE
    LET fourthReserved1 == ReadBytes(additionalOrderFlags.rest, 1) IN IF ~fourthReserved1.ok THEN Fail ELSE
    LET fifthReserved1 == ReadBytes(fourthReserved1.rest, 1) IN IF ~fifthReserved1.ok THEN Fail ELSE
    LET sixthReserved1 == ReadBytes(fifthReserved1.rest, 1) IN IF ~sixthReserved1.ok THEN Fail ELSE
    LET pan == ReadBytes(sixthReserved1.rest, 10) IN IF ~pan.ok THEN Fail ELSE
    LET oldPan == ReadBytes(pan.rest, 10) IN IF ~oldPan.ok THEN Fail ELSE
    LET algoId == ReadBytes(oldPan.rest, 4) IN IF ~algoId.ok THEN Fail ELSE
    LET reserved2 == ReadBytes(algoId.rest, 2) IN IF ~reserved2.ok THEN Fail ELSE
    LET lastActivityReference == ReadBytes(reserved2.rest, 8) IN IF ~lastActivityReference.ok THEN Fail ELSE
    LET reserved52 == ReadBytes(lastActivityReference.rest, 52) IN IF ~reserved52.ok THEN Fail ELSE
    Ok([ responseOrderNumber      |-> responseOrderNumber.value,
         brokerId                 |-> brokerId.value,
         reserved1                |-> reserved1.value,
         traderNumber             |-> traderNumber.value,
         accountNumber            |-> accountNumber.value,
         buySellIndicator         |-> buySellIndicator.value,
         originalVolume           |-> originalVolume.value,
         disclosedVolume          |-> disclosedVolume.value,
         remainingVolume          |-> remainingVolume.value,
         disclosedVolumeRemaining |-> disclosedVolumeRemaining.value,
         price                    |-> price.value,
         stOrderFlags             |-> stOrderFlags.value,
         goodTillDate             |-> goodTillDate.value,
         fillNumber               |-> fillNumber.value,
         fillQuantity             |-> fillQuantity.value,
         fillPrice                |-> fillPrice.value,
         volumeFilledToday        |-> volumeFilledToday.value,
         activityType             |-> activityType.value,
         activityTime             |-> activityTime.value,
         counterTraderOrderNumber |-> counterTraderOrderNumber.value,
         counterBrokerId          |-> counterBrokerId.value,
         secondReserved1          |-> secondReserved1.value,
         token                    |-> token.value,
         contractDesc             |-> contractDesc.value,
         openClose                |-> openClose.value,
         oldOpenClose             |-> oldOpenClose.value,
         bookTypeChar1            |-> bookTypeChar1.value,
         thirdReserved1           |-> thirdReserved1.value,
         reserved4                |-> reserved4.value,
         oldAccountNumber         |-> oldAccountNumber.value,
         participant              |-> participant.value,
         oldParticipant           |-> oldParticipant.value,
         additionalOrderFlags     |-> additionalOrderFlags.value,
         fourthReserved1          |-> fourthReserved1.value,
         fifthReserved1           |-> fifthReserved1.value,
         sixthReserved1           |-> sixthReserved1.value,
         pan                      |-> pan.value,
         oldPan                   |-> oldPan.value,
         algoId                   |-> algoId.value,
         reserved2                |-> reserved2.value,
         lastActivityReference    |-> lastActivityReference.value,
         reserved52               |-> reserved52.value ], reserved52.rest)

ZeroOnStopNotificationMessage ==
    [ responseOrderNumber      |-> [i \in 1 .. 8 |-> 0],
      brokerId                 |-> [i \in 1 .. 5 |-> 0],
      reserved1                |-> [i \in 1 .. 1 |-> 0],
      traderNumber             |-> [i \in 1 .. 4 |-> 0],
      accountNumber            |-> [i \in 1 .. 10 |-> 0],
      buySellIndicator         |-> [i \in 1 .. 2 |-> 0],
      originalVolume           |-> [i \in 1 .. 4 |-> 0],
      disclosedVolume          |-> [i \in 1 .. 4 |-> 0],
      remainingVolume          |-> [i \in 1 .. 4 |-> 0],
      disclosedVolumeRemaining |-> [i \in 1 .. 4 |-> 0],
      price                    |-> [i \in 1 .. 4 |-> 0],
      stOrderFlags             |-> [i \in 1 .. 2 |-> 0],
      goodTillDate             |-> [i \in 1 .. 4 |-> 0],
      fillNumber               |-> [i \in 1 .. 4 |-> 0],
      fillQuantity             |-> [i \in 1 .. 4 |-> 0],
      fillPrice                |-> [i \in 1 .. 4 |-> 0],
      volumeFilledToday        |-> [i \in 1 .. 4 |-> 0],
      activityType             |-> [i \in 1 .. 2 |-> 0],
      activityTime             |-> [i \in 1 .. 4 |-> 0],
      counterTraderOrderNumber |-> [i \in 1 .. 8 |-> 0],
      counterBrokerId          |-> [i \in 1 .. 5 |-> 0],
      secondReserved1          |-> [i \in 1 .. 1 |-> 0],
      token                    |-> [i \in 1 .. 4 |-> 0],
      contractDesc             |-> ZeroContractDesc62,
      openClose                |-> [i \in 1 .. 1 |-> 0],
      oldOpenClose             |-> [i \in 1 .. 1 |-> 0],
      bookTypeChar1            |-> [i \in 1 .. 1 |-> 0],
      thirdReserved1           |-> [i \in 1 .. 1 |-> 0],
      reserved4                |-> [i \in 1 .. 4 |-> 0],
      oldAccountNumber         |-> [i \in 1 .. 10 |-> 0],
      participant              |-> [i \in 1 .. 12 |-> 0],
      oldParticipant           |-> [i \in 1 .. 12 |-> 0],
      additionalOrderFlags     |-> [i \in 1 .. 1 |-> 0],
      fourthReserved1          |-> [i \in 1 .. 1 |-> 0],
      fifthReserved1           |-> [i \in 1 .. 1 |-> 0],
      sixthReserved1           |-> [i \in 1 .. 1 |-> 0],
      pan                      |-> [i \in 1 .. 10 |-> 0],
      oldPan                   |-> [i \in 1 .. 10 |-> 0],
      algoId                   |-> [i \in 1 .. 4 |-> 0],
      reserved2                |-> [i \in 1 .. 2 |-> 0],
      lastActivityReference    |-> [i \in 1 .. 8 |-> 0],
      reserved52               |-> [i \in 1 .. 52 |-> 0] ]

(* On Stop Notification Message at zero, then each field in turn at the values it is checked at *)
CheckedOnStopNotificationMessage ==
    { ZeroOnStopNotificationMessage }
        \cup { [ZeroOnStopNotificationMessage EXCEPT !.responseOrderNumber = one] : one \in Sample(8) }
        \cup { [ZeroOnStopNotificationMessage EXCEPT !.brokerId = one] : one \in Sample(5) }
        \cup { [ZeroOnStopNotificationMessage EXCEPT !.reserved1 = one] : one \in Sample(1) }
        \cup { [ZeroOnStopNotificationMessage EXCEPT !.traderNumber = one] : one \in Sample(4) }
        \cup { [ZeroOnStopNotificationMessage EXCEPT !.accountNumber = one] : one \in Sample(10) }
        \cup { [ZeroOnStopNotificationMessage EXCEPT !.buySellIndicator = one] : one \in Sample(2) }
        \cup { [ZeroOnStopNotificationMessage EXCEPT !.originalVolume = one] : one \in Sample(4) }
        \cup { [ZeroOnStopNotificationMessage EXCEPT !.disclosedVolume = one] : one \in Sample(4) }
        \cup { [ZeroOnStopNotificationMessage EXCEPT !.remainingVolume = one] : one \in Sample(4) }
        \cup { [ZeroOnStopNotificationMessage EXCEPT !.disclosedVolumeRemaining = one] : one \in Sample(4) }
        \cup { [ZeroOnStopNotificationMessage EXCEPT !.price = one] : one \in Sample(4) }
        \cup { [ZeroOnStopNotificationMessage EXCEPT !.stOrderFlags = one] : one \in Sample(2) }
        \cup { [ZeroOnStopNotificationMessage EXCEPT !.goodTillDate = one] : one \in Sample(4) }
        \cup { [ZeroOnStopNotificationMessage EXCEPT !.fillNumber = one] : one \in Sample(4) }
        \cup { [ZeroOnStopNotificationMessage EXCEPT !.fillQuantity = one] : one \in Sample(4) }
        \cup { [ZeroOnStopNotificationMessage EXCEPT !.fillPrice = one] : one \in Sample(4) }
        \cup { [ZeroOnStopNotificationMessage EXCEPT !.volumeFilledToday = one] : one \in Sample(4) }
        \cup { [ZeroOnStopNotificationMessage EXCEPT !.activityType = one] : one \in Sample(2) }
        \cup { [ZeroOnStopNotificationMessage EXCEPT !.activityTime = one] : one \in Sample(4) }
        \cup { [ZeroOnStopNotificationMessage EXCEPT !.counterTraderOrderNumber = one] : one \in Sample(8) }
        \cup { [ZeroOnStopNotificationMessage EXCEPT !.counterBrokerId = one] : one \in Sample(5) }
        \cup { [ZeroOnStopNotificationMessage EXCEPT !.secondReserved1 = one] : one \in Sample(1) }
        \cup { [ZeroOnStopNotificationMessage EXCEPT !.token = one] : one \in Sample(4) }
        \cup { [ZeroOnStopNotificationMessage EXCEPT !.contractDesc = one] : one \in CheckedContractDesc62 }
        \cup { [ZeroOnStopNotificationMessage EXCEPT !.openClose = one] : one \in Sample(1) }
        \cup { [ZeroOnStopNotificationMessage EXCEPT !.oldOpenClose = one] : one \in Sample(1) }
        \cup { [ZeroOnStopNotificationMessage EXCEPT !.bookTypeChar1 = one] : one \in Sample(1) }
        \cup { [ZeroOnStopNotificationMessage EXCEPT !.thirdReserved1 = one] : one \in Sample(1) }
        \cup { [ZeroOnStopNotificationMessage EXCEPT !.reserved4 = one] : one \in Sample(4) }
        \cup { [ZeroOnStopNotificationMessage EXCEPT !.oldAccountNumber = one] : one \in Sample(10) }
        \cup { [ZeroOnStopNotificationMessage EXCEPT !.participant = one] : one \in Sample(12) }
        \cup { [ZeroOnStopNotificationMessage EXCEPT !.oldParticipant = one] : one \in Sample(12) }
        \cup { [ZeroOnStopNotificationMessage EXCEPT !.additionalOrderFlags = one] : one \in Sample(1) }
        \cup { [ZeroOnStopNotificationMessage EXCEPT !.fourthReserved1 = one] : one \in Sample(1) }
        \cup { [ZeroOnStopNotificationMessage EXCEPT !.fifthReserved1 = one] : one \in Sample(1) }
        \cup { [ZeroOnStopNotificationMessage EXCEPT !.sixthReserved1 = one] : one \in Sample(1) }
        \cup { [ZeroOnStopNotificationMessage EXCEPT !.pan = one] : one \in Sample(10) }
        \cup { [ZeroOnStopNotificationMessage EXCEPT !.oldPan = one] : one \in Sample(10) }
        \cup { [ZeroOnStopNotificationMessage EXCEPT !.algoId = one] : one \in Sample(4) }
        \cup { [ZeroOnStopNotificationMessage EXCEPT !.reserved2 = one] : one \in Sample(2) }
        \cup { [ZeroOnStopNotificationMessage EXCEPT !.lastActivityReference = one] : one \in Sample(8) }
        \cup { [ZeroOnStopNotificationMessage EXCEPT !.reserved52 = one] : one \in Sample(52) }

(***************************************************************************)
(* Contract Desc: 28 bytes                                                 *)
(***************************************************************************)

ContractDesc63 ==
    [ instrumentName : Sample(6),
      symbol         : Sample(10),
      expiryDate     : Sample(4),
      strikePrice    : Sample(4),
      optionType     : Sample(2),
      caLevel        : Sample(2) ]

EncodeContractDesc63(message) ==
    message.instrumentName
        \o message.symbol
        \o message.expiryDate
        \o message.strikePrice
        \o message.optionType
        \o message.caLevel

DecodeContractDesc63(bytes) ==
    LET instrumentName == ReadBytes(bytes, 6) IN IF ~instrumentName.ok THEN Fail ELSE
    LET symbol == ReadBytes(instrumentName.rest, 10) IN IF ~symbol.ok THEN Fail ELSE
    LET expiryDate == ReadBytes(symbol.rest, 4) IN IF ~expiryDate.ok THEN Fail ELSE
    LET strikePrice == ReadBytes(expiryDate.rest, 4) IN IF ~strikePrice.ok THEN Fail ELSE
    LET optionType == ReadBytes(strikePrice.rest, 2) IN IF ~optionType.ok THEN Fail ELSE
    LET caLevel == ReadBytes(optionType.rest, 2) IN IF ~caLevel.ok THEN Fail ELSE
    Ok([ instrumentName |-> instrumentName.value,
         symbol         |-> symbol.value,
         expiryDate     |-> expiryDate.value,
         strikePrice    |-> strikePrice.value,
         optionType     |-> optionType.value,
         caLevel        |-> caLevel.value ], caLevel.rest)

ZeroContractDesc63 ==
    [ instrumentName |-> [i \in 1 .. 6 |-> 0],
      symbol         |-> [i \in 1 .. 10 |-> 0],
      expiryDate     |-> [i \in 1 .. 4 |-> 0],
      strikePrice    |-> [i \in 1 .. 4 |-> 0],
      optionType     |-> [i \in 1 .. 2 |-> 0],
      caLevel        |-> [i \in 1 .. 2 |-> 0] ]

(* Contract Desc at zero, then each field in turn at the values it is checked at *)
CheckedContractDesc63 ==
    { ZeroContractDesc63 }
        \cup { [ZeroContractDesc63 EXCEPT !.instrumentName = one] : one \in Sample(6) }
        \cup { [ZeroContractDesc63 EXCEPT !.symbol = one] : one \in Sample(10) }
        \cup { [ZeroContractDesc63 EXCEPT !.expiryDate = one] : one \in Sample(4) }
        \cup { [ZeroContractDesc63 EXCEPT !.strikePrice = one] : one \in Sample(4) }
        \cup { [ZeroContractDesc63 EXCEPT !.optionType = one] : one \in Sample(2) }
        \cup { [ZeroContractDesc63 EXCEPT !.caLevel = one] : one \in Sample(2) }

(***************************************************************************)
(* Trade Confirmation Message: 256 bytes                                   *)
(***************************************************************************)

TradeConfirmationMessage ==
    [ responseOrderNumber      : Sample(8),
      brokerId                 : Sample(5),
      reserved1                : Sample(1),
      traderNumber             : Sample(4),
      accountNumber            : Sample(10),
      buySellIndicator         : Sample(2),
      originalVolume           : Sample(4),
      disclosedVolume          : Sample(4),
      remainingVolume          : Sample(4),
      disclosedVolumeRemaining : Sample(4),
      price                    : Sample(4),
      stOrderFlags             : Sample(2),
      goodTillDate             : Sample(4),
      fillNumber               : Sample(4),
      fillQuantity             : Sample(4),
      fillPrice                : Sample(4),
      volumeFilledToday        : Sample(4),
      activityType             : Sample(2),
      activityTime             : Sample(4),
      counterTraderOrderNumber : Sample(8),
      counterBrokerId          : Sample(5),
      secondReserved1          : Sample(1),
      token                    : Sample(4),
      contractDesc             : ContractDesc63,
      openClose                : Sample(1),
      oldOpenClose             : Sample(1),
      bookTypeChar1            : Sample(1),
      thirdReserved1           : Sample(1),
      reserved4                : Sample(4),
      oldAccountNumber         : Sample(10),
      participant              : Sample(12),
      oldParticipant           : Sample(12),
      additionalOrderFlags     : Sample(1),
      fourthReserved1          : Sample(1),
      fifthReserved1           : Sample(1),
      sixthReserved1           : Sample(1),
      pan                      : Sample(10),
      oldPan                   : Sample(10),
      algoId                   : Sample(4),
      reserved2                : Sample(2),
      lastActivityReference    : Sample(8),
      reserved52               : Sample(52) ]

EncodeTradeConfirmationMessage(message) ==
    message.responseOrderNumber
        \o message.brokerId
        \o message.reserved1
        \o message.traderNumber
        \o message.accountNumber
        \o message.buySellIndicator
        \o message.originalVolume
        \o message.disclosedVolume
        \o message.remainingVolume
        \o message.disclosedVolumeRemaining
        \o message.price
        \o message.stOrderFlags
        \o message.goodTillDate
        \o message.fillNumber
        \o message.fillQuantity
        \o message.fillPrice
        \o message.volumeFilledToday
        \o message.activityType
        \o message.activityTime
        \o message.counterTraderOrderNumber
        \o message.counterBrokerId
        \o message.secondReserved1
        \o message.token
        \o EncodeContractDesc63(message.contractDesc)
        \o message.openClose
        \o message.oldOpenClose
        \o message.bookTypeChar1
        \o message.thirdReserved1
        \o message.reserved4
        \o message.oldAccountNumber
        \o message.participant
        \o message.oldParticipant
        \o message.additionalOrderFlags
        \o message.fourthReserved1
        \o message.fifthReserved1
        \o message.sixthReserved1
        \o message.pan
        \o message.oldPan
        \o message.algoId
        \o message.reserved2
        \o message.lastActivityReference
        \o message.reserved52

DecodeTradeConfirmationMessage(bytes) ==
    LET responseOrderNumber == ReadBytes(bytes, 8) IN IF ~responseOrderNumber.ok THEN Fail ELSE
    LET brokerId == ReadBytes(responseOrderNumber.rest, 5) IN IF ~brokerId.ok THEN Fail ELSE
    LET reserved1 == ReadBytes(brokerId.rest, 1) IN IF ~reserved1.ok THEN Fail ELSE
    LET traderNumber == ReadBytes(reserved1.rest, 4) IN IF ~traderNumber.ok THEN Fail ELSE
    LET accountNumber == ReadBytes(traderNumber.rest, 10) IN IF ~accountNumber.ok THEN Fail ELSE
    LET buySellIndicator == ReadBytes(accountNumber.rest, 2) IN IF ~buySellIndicator.ok THEN Fail ELSE
    LET originalVolume == ReadBytes(buySellIndicator.rest, 4) IN IF ~originalVolume.ok THEN Fail ELSE
    LET disclosedVolume == ReadBytes(originalVolume.rest, 4) IN IF ~disclosedVolume.ok THEN Fail ELSE
    LET remainingVolume == ReadBytes(disclosedVolume.rest, 4) IN IF ~remainingVolume.ok THEN Fail ELSE
    LET disclosedVolumeRemaining == ReadBytes(remainingVolume.rest, 4) IN IF ~disclosedVolumeRemaining.ok THEN Fail ELSE
    LET price == ReadBytes(disclosedVolumeRemaining.rest, 4) IN IF ~price.ok THEN Fail ELSE
    LET stOrderFlags == ReadBytes(price.rest, 2) IN IF ~stOrderFlags.ok THEN Fail ELSE
    LET goodTillDate == ReadBytes(stOrderFlags.rest, 4) IN IF ~goodTillDate.ok THEN Fail ELSE
    LET fillNumber == ReadBytes(goodTillDate.rest, 4) IN IF ~fillNumber.ok THEN Fail ELSE
    LET fillQuantity == ReadBytes(fillNumber.rest, 4) IN IF ~fillQuantity.ok THEN Fail ELSE
    LET fillPrice == ReadBytes(fillQuantity.rest, 4) IN IF ~fillPrice.ok THEN Fail ELSE
    LET volumeFilledToday == ReadBytes(fillPrice.rest, 4) IN IF ~volumeFilledToday.ok THEN Fail ELSE
    LET activityType == ReadBytes(volumeFilledToday.rest, 2) IN IF ~activityType.ok THEN Fail ELSE
    LET activityTime == ReadBytes(activityType.rest, 4) IN IF ~activityTime.ok THEN Fail ELSE
    LET counterTraderOrderNumber == ReadBytes(activityTime.rest, 8) IN IF ~counterTraderOrderNumber.ok THEN Fail ELSE
    LET counterBrokerId == ReadBytes(counterTraderOrderNumber.rest, 5) IN IF ~counterBrokerId.ok THEN Fail ELSE
    LET secondReserved1 == ReadBytes(counterBrokerId.rest, 1) IN IF ~secondReserved1.ok THEN Fail ELSE
    LET token == ReadBytes(secondReserved1.rest, 4) IN IF ~token.ok THEN Fail ELSE
    LET contractDesc == DecodeContractDesc63(token.rest) IN IF ~contractDesc.ok THEN Fail ELSE
    LET openClose == ReadBytes(contractDesc.rest, 1) IN IF ~openClose.ok THEN Fail ELSE
    LET oldOpenClose == ReadBytes(openClose.rest, 1) IN IF ~oldOpenClose.ok THEN Fail ELSE
    LET bookTypeChar1 == ReadBytes(oldOpenClose.rest, 1) IN IF ~bookTypeChar1.ok THEN Fail ELSE
    LET thirdReserved1 == ReadBytes(bookTypeChar1.rest, 1) IN IF ~thirdReserved1.ok THEN Fail ELSE
    LET reserved4 == ReadBytes(thirdReserved1.rest, 4) IN IF ~reserved4.ok THEN Fail ELSE
    LET oldAccountNumber == ReadBytes(reserved4.rest, 10) IN IF ~oldAccountNumber.ok THEN Fail ELSE
    LET participant == ReadBytes(oldAccountNumber.rest, 12) IN IF ~participant.ok THEN Fail ELSE
    LET oldParticipant == ReadBytes(participant.rest, 12) IN IF ~oldParticipant.ok THEN Fail ELSE
    LET additionalOrderFlags == ReadBytes(oldParticipant.rest, 1) IN IF ~additionalOrderFlags.ok THEN Fail ELSE
    LET fourthReserved1 == ReadBytes(additionalOrderFlags.rest, 1) IN IF ~fourthReserved1.ok THEN Fail ELSE
    LET fifthReserved1 == ReadBytes(fourthReserved1.rest, 1) IN IF ~fifthReserved1.ok THEN Fail ELSE
    LET sixthReserved1 == ReadBytes(fifthReserved1.rest, 1) IN IF ~sixthReserved1.ok THEN Fail ELSE
    LET pan == ReadBytes(sixthReserved1.rest, 10) IN IF ~pan.ok THEN Fail ELSE
    LET oldPan == ReadBytes(pan.rest, 10) IN IF ~oldPan.ok THEN Fail ELSE
    LET algoId == ReadBytes(oldPan.rest, 4) IN IF ~algoId.ok THEN Fail ELSE
    LET reserved2 == ReadBytes(algoId.rest, 2) IN IF ~reserved2.ok THEN Fail ELSE
    LET lastActivityReference == ReadBytes(reserved2.rest, 8) IN IF ~lastActivityReference.ok THEN Fail ELSE
    LET reserved52 == ReadBytes(lastActivityReference.rest, 52) IN IF ~reserved52.ok THEN Fail ELSE
    Ok([ responseOrderNumber      |-> responseOrderNumber.value,
         brokerId                 |-> brokerId.value,
         reserved1                |-> reserved1.value,
         traderNumber             |-> traderNumber.value,
         accountNumber            |-> accountNumber.value,
         buySellIndicator         |-> buySellIndicator.value,
         originalVolume           |-> originalVolume.value,
         disclosedVolume          |-> disclosedVolume.value,
         remainingVolume          |-> remainingVolume.value,
         disclosedVolumeRemaining |-> disclosedVolumeRemaining.value,
         price                    |-> price.value,
