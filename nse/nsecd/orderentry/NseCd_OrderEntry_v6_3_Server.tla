(***************************************************************************)
(* Contract Desc: 28 bytes                                                 *)
(***************************************************************************)

ContractDesc6 ==
    [ instrumentName : Sample(6),
      symbol         : Sample(10),
      expiryDate     : Sample(4),
      strikePrice    : Sample(4),
      optionType     : Sample(2),
      caLevel        : Sample(2) ]

EncodeContractDesc6(message) ==
    message.instrumentName
        \o message.symbol
        \o message.expiryDate
        \o message.strikePrice
        \o message.optionType
        \o message.caLevel

DecodeContractDesc6(bytes) ==
    LET instrumentName == ReadBytes(bytes, 6) IN IF ~instrumentName.ok THEN Fail ELSE
    LET symbol == ReadBytes(instrumentName.rest, 10) IN IF ~symbol.ok THEN Fail ELSE
    LET expiryDate == ReadBytes(symbol.rest, 4) IN IF ~expiryDate.ok THEN Fail ELSE
    LET strikePrice == ReadBytes(expiryDate.rest, 4) IN IF ~strikePrice.ok THEN Fail ELSE
    LET optionType == ReadBytes(strikePrice.rest, 2) IN IF ~optionType.ok THEN Fail ELSE
    LET caLevel == ReadBytes(optionType.rest, 2) IN IF ~caLevel.ok THEN Fail ELSE
    Ok([ instrumentName |-> instrumentName.value,
         symbol         |-> symbol.value,
         expiryDate     |-> expiryDate.value,
         strikePrice    |-> strikePrice.value,
         optionType     |-> optionType.value,
         caLevel        |-> caLevel.value ], caLevel.rest)

ZeroContractDesc6 ==
    [ instrumentName |-> [i \in 1 .. 6 |-> 0],
      symbol         |-> [i \in 1 .. 10 |-> 0],
      expiryDate     |-> [i \in 1 .. 4 |-> 0],
      strikePrice    |-> [i \in 1 .. 4 |-> 0],
      optionType     |-> [i \in 1 .. 2 |-> 0],
      caLevel        |-> [i \in 1 .. 2 |-> 0] ]

(* Contract Desc at zero, then each field in turn at the values it is checked at *)
CheckedContractDesc6 ==
    { ZeroContractDesc6 }
        \cup { [ZeroContractDesc6 EXCEPT !.instrumentName = one] : one \in Sample(6) }
        \cup { [ZeroContractDesc6 EXCEPT !.symbol = one] : one \in Sample(10) }
        \cup { [ZeroContractDesc6 EXCEPT !.expiryDate = one] : one \in Sample(4) }
        \cup { [ZeroContractDesc6 EXCEPT !.strikePrice = one] : one \in Sample(4) }
        \cup { [ZeroContractDesc6 EXCEPT !.optionType = one] : one \in Sample(2) }
        \cup { [ZeroContractDesc6 EXCEPT !.caLevel = one] : one \in Sample(2) }

(***************************************************************************)
(* Order Cancel Reject Message: 276 bytes                                  *)
(***************************************************************************)

OrderCancelRejectMessage ==
    [ participantType          : Sample(1),
      reserved1                : Sample(1),
      competitorPeriod         : Sample(2),
      solicitorPeriod          : Sample(2),
      modifiedCancelledBy      : Sample(1),
      secondReserved1          : Sample(1),
      reasonCode               : Sample(2),
      reserved4                : Sample(4),
      tokenNo                  : Sample(4),
      contractDesc             : ContractDesc6,
      counterPartyBrokerId     : Sample(5),
      thirdReserved1           : Sample(1),
      reserved2                : Sample(2),
      closeoutFlag             : Sample(1),
      fourthReserved1          : Sample(1),
      orderType                : Sample(2),
      orderNumber              : Sample(8),
      accountNumber            : Sample(10),
      bookTypeShort2           : Sample(2),
      buySellIndicator         : Sample(2),
      disclosedVolume          : Sample(4),
      disclosedVolumeRemaining : Sample(4),
      totalVolumeRemaining     : Sample(4),
      volume                   : Sample(4),
      volumeFilledToday        : Sample(4),
      price                    : Sample(4),
      triggerPrice             : Sample(4),
      goodTillDate             : Sample(4),
      entryDateTime            : Sample(4),
      minimumFillAonVolume     : Sample(4),
      lastModified             : Sample(4),
      stOrderFlags             : Sample(2),
      branchId                 : Sample(2),
      traderId                 : Sample(4),
      brokerId                 : Sample(5),
      cOrdFiller               : Sample(24),
      openClose                : Sample(1),
      settlor                  : Sample(12),
      proClientIndicator       : Sample(2),
      settlementPeriod         : Sample(2),
      additionalOrderFlags     : Sample(1),
      fifthReserved1           : Sample(1),
      reference                : Sample(4),
      nnfField                 : Sample(8),
      mktReplay                : Sample(8),
      pan                      : Sample(10),
      algoId                   : Sample(4),
      secondReserved2          : Sample(2),
      lastActivityReference    : Sample(8),
      reserved52               : Sample(52) ]

EncodeOrderCancelRejectMessage(message) ==
    message.participantType
        \o message.reserved1
        \o message.competitorPeriod
        \o message.solicitorPeriod
        \o message.modifiedCancelledBy
        \o message.secondReserved1
        \o message.reasonCode
        \o message.reserved4
        \o message.tokenNo
        \o EncodeContractDesc6(message.contractDesc)
        \o message.counterPartyBrokerId
        \o message.thirdReserved1
        \o message.reserved2
        \o message.closeoutFlag
        \o message.fourthReserved1
        \o message.orderType
        \o message.orderNumber
        \o message.accountNumber
        \o message.bookTypeShort2
        \o message.buySellIndicator
        \o message.disclosedVolume
        \o message.disclosedVolumeRemaining
        \o message.totalVolumeRemaining
        \o message.volume
        \o message.volumeFilledToday
        \o message.price
        \o message.triggerPrice
        \o message.goodTillDate
        \o message.entryDateTime
        \o message.minimumFillAonVolume
        \o message.lastModified
        \o message.stOrderFlags
        \o message.branchId
        \o message.traderId
        \o message.brokerId
        \o message.cOrdFiller
        \o message.openClose
        \o message.settlor
        \o message.proClientIndicator
        \o message.settlementPeriod
        \o message.additionalOrderFlags
        \o message.fifthReserved1
        \o message.reference
        \o message.nnfField
        \o message.mktReplay
        \o message.pan
        \o message.algoId
        \o message.secondReserved2
        \o message.lastActivityReference
        \o message.reserved52

DecodeOrderCancelRejectMessage(bytes) ==
    LET participantType == ReadBytes(bytes, 1) IN IF ~participantType.ok THEN Fail ELSE
    LET reserved1 == ReadBytes(participantType.rest, 1) IN IF ~reserved1.ok THEN Fail ELSE
    LET competitorPeriod == ReadBytes(reserved1.rest, 2) IN IF ~competitorPeriod.ok THEN Fail ELSE
    LET solicitorPeriod == ReadBytes(competitorPeriod.rest, 2) IN IF ~solicitorPeriod.ok THEN Fail ELSE
    LET modifiedCancelledBy == ReadBytes(solicitorPeriod.rest, 1) IN IF ~modifiedCancelledBy.ok THEN Fail ELSE
    LET secondReserved1 == ReadBytes(modifiedCancelledBy.rest, 1) IN IF ~secondReserved1.ok THEN Fail ELSE
    LET reasonCode == ReadBytes(secondReserved1.rest, 2) IN IF ~reasonCode.ok THEN Fail ELSE
    LET reserved4 == ReadBytes(reasonCode.rest, 4) IN IF ~reserved4.ok THEN Fail ELSE
    LET tokenNo == ReadBytes(reserved4.rest, 4) IN IF ~tokenNo.ok THEN Fail ELSE
    LET contractDesc == DecodeContractDesc6(tokenNo.rest) IN IF ~contractDesc.ok THEN Fail ELSE
    LET counterPartyBrokerId == ReadBytes(contractDesc.rest, 5) IN IF ~counterPartyBrokerId.ok THEN Fail ELSE
    LET thirdReserved1 == ReadBytes(counterPartyBrokerId.rest, 1) IN IF ~thirdReserved1.ok THEN Fail ELSE
    LET reserved2 == ReadBytes(thirdReserved1.rest, 2) IN IF ~reserved2.ok THEN Fail ELSE
    LET closeoutFlag == ReadBytes(reserved2.rest, 1) IN IF ~closeoutFlag.ok THEN Fail ELSE
    LET fourthReserved1 == ReadBytes(closeoutFlag.rest, 1) IN IF ~fourthReserved1.ok THEN Fail ELSE
    LET orderType == ReadBytes(fourthReserved1.rest, 2) IN IF ~orderType.ok THEN Fail ELSE
    LET orderNumber == ReadBytes(orderType.rest, 8) IN IF ~orderNumber.ok THEN Fail ELSE
    LET accountNumber == ReadBytes(orderNumber.rest, 10) IN IF ~accountNumber.ok THEN Fail ELSE
    LET bookTypeShort2 == ReadBytes(accountNumber.rest, 2) IN IF ~bookTypeShort2.ok THEN Fail ELSE
    LET buySellIndicator == ReadBytes(bookTypeShort2.rest, 2) IN IF ~buySellIndicator.ok THEN Fail ELSE
    LET disclosedVolume == ReadBytes(buySellIndicator.rest, 4) IN IF ~disclosedVolume.ok THEN Fail ELSE
    LET disclosedVolumeRemaining == ReadBytes(disclosedVolume.rest, 4) IN IF ~disclosedVolumeRemaining.ok THEN Fail ELSE
    LET totalVolumeRemaining == ReadBytes(disclosedVolumeRemaining.rest, 4) IN IF ~totalVolumeRemaining.ok THEN Fail ELSE
    LET volume == ReadBytes(totalVolumeRemaining.rest, 4) IN IF ~volume.ok THEN Fail ELSE
    LET volumeFilledToday == ReadBytes(volume.rest, 4) IN IF ~volumeFilledToday.ok THEN Fail ELSE
    LET price == ReadBytes(volumeFilledToday.rest, 4) IN IF ~price.ok THEN Fail ELSE
    LET triggerPrice == ReadBytes(price.rest, 4) IN IF ~triggerPrice.ok THEN Fail ELSE
    LET goodTillDate == ReadBytes(triggerPrice.rest, 4) IN IF ~goodTillDate.ok THEN Fail ELSE
    LET entryDateTime == ReadBytes(goodTillDate.rest, 4) IN IF ~entryDateTime.ok THEN Fail ELSE
    LET minimumFillAonVolume == ReadBytes(entryDateTime.rest, 4) IN IF ~minimumFillAonVolume.ok THEN Fail ELSE
    LET lastModified == ReadBytes(minimumFillAonVolume.rest, 4) IN IF ~lastModified.ok THEN Fail ELSE
    LET stOrderFlags == ReadBytes(lastModified.rest, 2) IN IF ~stOrderFlags.ok THEN Fail ELSE
    LET branchId == ReadBytes(stOrderFlags.rest, 2) IN IF ~branchId.ok THEN Fail ELSE
    LET traderId == ReadBytes(branchId.rest, 4) IN IF ~traderId.ok THEN Fail ELSE
    LET brokerId == ReadBytes(traderId.rest, 5) IN IF ~brokerId.ok THEN Fail ELSE
    LET cOrdFiller == ReadBytes(brokerId.rest, 24) IN IF ~cOrdFiller.ok THEN Fail ELSE
    LET openClose == ReadBytes(cOrdFiller.rest, 1) IN IF ~openClose.ok THEN Fail ELSE
    LET settlor == ReadBytes(openClose.rest, 12) IN IF ~settlor.ok THEN Fail ELSE
    LET proClientIndicator == ReadBytes(settlor.rest, 2) IN IF ~proClientIndicator.ok THEN Fail ELSE
    LET settlementPeriod == ReadBytes(proClientIndicator.rest, 2) IN IF ~settlementPeriod.ok THEN Fail ELSE
    LET additionalOrderFlags == ReadBytes(settlementPeriod.rest, 1) IN IF ~additionalOrderFlags.ok THEN Fail ELSE
    LET fifthReserved1 == ReadBytes(additionalOrderFlags.rest, 1) IN IF ~fifthReserved1.ok THEN Fail ELSE
    LET reference == ReadBytes(fifthReserved1.rest, 4) IN IF ~reference.ok THEN Fail ELSE
    LET nnfField == ReadBytes(reference.rest, 8) IN IF ~nnfField.ok THEN Fail ELSE
    LET mktReplay == ReadBytes(nnfField.rest, 8) IN IF ~mktReplay.ok THEN Fail ELSE
    LET pan == ReadBytes(mktReplay.rest, 10) IN IF ~pan.ok THEN Fail ELSE
    LET algoId == ReadBytes(pan.rest, 4) IN IF ~algoId.ok THEN Fail ELSE
    LET secondReserved2 == ReadBytes(algoId.rest, 2) IN IF ~secondReserved2.ok THEN Fail ELSE
    LET lastActivityReference == ReadBytes(secondReserved2.rest, 8) IN IF ~lastActivityReference.ok THEN Fail ELSE
    LET reserved52 == ReadBytes(lastActivityReference.rest, 52) IN IF ~reserved52.ok THEN Fail ELSE
    Ok([ participantType          |-> participantType.value,
         reserved1                |-> reserved1.value,
         competitorPeriod         |-> competitorPeriod.value,
         solicitorPeriod          |-> solicitorPeriod.value,
         modifiedCancelledBy      |-> modifiedCancelledBy.value,
         secondReserved1          |-> secondReserved1.value,
         reasonCode               |-> reasonCode.value,
         reserved4                |-> reserved4.value,
         tokenNo                  |-> tokenNo.value,
         contractDesc             |-> contractDesc.value,
         counterPartyBrokerId     |-> counterPartyBrokerId.value,
         thirdReserved1           |-> thirdReserved1.value,
         reserved2                |-> reserved2.value,
         closeoutFlag             |-> closeoutFlag.value,
         fourthReserved1          |-> fourthReserved1.value,
         orderType                |-> orderType.value,
         orderNumber              |-> orderNumber.value,
         accountNumber            |-> accountNumber.value,
         bookTypeShort2           |-> bookTypeShort2.value,
         buySellIndicator         |-> buySellIndicator.value,
         disclosedVolume          |-> disclosedVolume.value,
         disclosedVolumeRemaining |-> disclosedVolumeRemaining.value,
         totalVolumeRemaining     |-> totalVolumeRemaining.value,
         volume                   |-> volume.value,
         volumeFilledToday        |-> volumeFilledToday.value,
         price                    |-> price.value,
         triggerPrice             |-> triggerPrice.value,
         goodTillDate             |-> goodTillDate.value,
         entryDateTime            |-> entryDateTime.value,
         minimumFillAonVolume     |-> minimumFillAonVolume.value,
         lastModified             |-> lastModified.value,
         stOrderFlags             |-> stOrderFlags.value,
         branchId                 |-> branchId.value,
         traderId                 |-> traderId.value,
         brokerId                 |-> brokerId.value,
         cOrdFiller               |-> cOrdFiller.value,
         openClose                |-> openClose.value,
         settlor                  |-> settlor.value,
         proClientIndicator       |-> proClientIndicator.value,
         settlementPeriod         |-> settlementPeriod.value,
         additionalOrderFlags     |-> additionalOrderFlags.value,
         fifthReserved1           |-> fifthReserved1.value,
         reference                |-> reference.value,
         nnfField                 |-> nnfField.value,
         mktReplay                |-> mktReplay.value,
         pan                      |-> pan.value,
         algoId                   |-> algoId.value,
         secondReserved2          |-> secondReserved2.value,
         lastActivityReference    |-> lastActivityReference.value,
         reserved52               |-> reserved52.value ], reserved52.rest)

ZeroOrderCancelRejectMessage ==
    [ participantType          |-> [i \in 1 .. 1 |-> 0],
      reserved1                |-> [i \in 1 .. 1 |-> 0],
      competitorPeriod         |-> [i \in 1 .. 2 |-> 0],
      solicitorPeriod          |-> [i \in 1 .. 2 |-> 0],
      modifiedCancelledBy      |-> [i \in 1 .. 1 |-> 0],
      secondReserved1          |-> [i \in 1 .. 1 |-> 0],
      reasonCode               |-> [i \in 1 .. 2 |-> 0],
      reserved4                |-> [i \in 1 .. 4 |-> 0],
      tokenNo                  |-> [i \in 1 .. 4 |-> 0],
      contractDesc             |-> ZeroContractDesc6,
      counterPartyBrokerId     |-> [i \in 1 .. 5 |-> 0],
      thirdReserved1           |-> [i \in 1 .. 1 |-> 0],
      reserved2                |-> [i \in 1 .. 2 |-> 0],
      closeoutFlag             |-> [i \in 1 .. 1 |-> 0],
      fourthReserved1          |-> [i \in 1 .. 1 |-> 0],
      orderType                |-> [i \in 1 .. 2 |-> 0],
      orderNumber              |-> [i \in 1 .. 8 |-> 0],
      accountNumber            |-> [i \in 1 .. 10 |-> 0],
      bookTypeShort2           |-> [i \in 1 .. 2 |-> 0],
      buySellIndicator         |-> [i \in 1 .. 2 |-> 0],
      disclosedVolume          |-> [i \in 1 .. 4 |-> 0],
      disclosedVolumeRemaining |-> [i \in 1 .. 4 |-> 0],
      totalVolumeRemaining     |-> [i \in 1 .. 4 |-> 0],
      volume                   |-> [i \in 1 .. 4 |-> 0],
      volumeFilledToday        |-> [i \in 1 .. 4 |-> 0],
      price                    |-> [i \in 1 .. 4 |-> 0],
      triggerPrice             |-> [i \in 1 .. 4 |-> 0],
      goodTillDate             |-> [i \in 1 .. 4 |-> 0],
      entryDateTime            |-> [i \in 1 .. 4 |-> 0],
      minimumFillAonVolume     |-> [i \in 1 .. 4 |-> 0],
      lastModified             |-> [i \in 1 .. 4 |-> 0],
      stOrderFlags             |-> [i \in 1 .. 2 |-> 0],
      branchId                 |-> [i \in 1 .. 2 |-> 0],
      traderId                 |-> [i \in 1 .. 4 |-> 0],
      brokerId                 |-> [i \in 1 .. 5 |-> 0],
      cOrdFiller               |-> [i \in 1 .. 24 |-> 0],
      openClose                |-> [i \in 1 .. 1 |-> 0],
      settlor                  |-> [i \in 1 .. 12 |-> 0],
      proClientIndicator       |-> [i \in 1 .. 2 |-> 0],
      settlementPeriod         |-> [i \in 1 .. 2 |-> 0],
      additionalOrderFlags     |-> [i \in 1 .. 1 |-> 0],
      fifthReserved1           |-> [i \in 1 .. 1 |-> 0],
      reference                |-> [i \in 1 .. 4 |-> 0],
      nnfField                 |-> [i \in 1 .. 8 |-> 0],
      mktReplay                |-> [i \in 1 .. 8 |-> 0],
      pan                      |-> [i \in 1 .. 10 |-> 0],
      algoId                   |-> [i \in 1 .. 4 |-> 0],
      secondReserved2          |-> [i \in 1 .. 2 |-> 0],
      lastActivityReference    |-> [i \in 1 .. 8 |-> 0],
      reserved52               |-> [i \in 1 .. 52 |-> 0] ]

(* Order Cancel Reject Message at zero, then each field in turn at the values it is checked at *)
CheckedOrderCancelRejectMessage ==
    { ZeroOrderCancelRejectMessage }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.participantType = one] : one \in Sample(1) }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.reserved1 = one] : one \in Sample(1) }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.competitorPeriod = one] : one \in Sample(2) }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.solicitorPeriod = one] : one \in Sample(2) }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.modifiedCancelledBy = one] : one \in Sample(1) }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.secondReserved1 = one] : one \in Sample(1) }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.reasonCode = one] : one \in Sample(2) }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.reserved4 = one] : one \in Sample(4) }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.tokenNo = one] : one \in Sample(4) }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.contractDesc = one] : one \in CheckedContractDesc6 }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.counterPartyBrokerId = one] : one \in Sample(5) }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.thirdReserved1 = one] : one \in Sample(1) }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.reserved2 = one] : one \in Sample(2) }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.closeoutFlag = one] : one \in Sample(1) }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.fourthReserved1 = one] : one \in Sample(1) }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.orderType = one] : one \in Sample(2) }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.orderNumber = one] : one \in Sample(8) }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.accountNumber = one] : one \in Sample(10) }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.bookTypeShort2 = one] : one \in Sample(2) }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.buySellIndicator = one] : one \in Sample(2) }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.disclosedVolume = one] : one \in Sample(4) }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.disclosedVolumeRemaining = one] : one \in Sample(4) }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.totalVolumeRemaining = one] : one \in Sample(4) }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.volume = one] : one \in Sample(4) }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.volumeFilledToday = one] : one \in Sample(4) }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.price = one] : one \in Sample(4) }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.triggerPrice = one] : one \in Sample(4) }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.goodTillDate = one] : one \in Sample(4) }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.entryDateTime = one] : one \in Sample(4) }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.minimumFillAonVolume = one] : one \in Sample(4) }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.lastModified = one] : one \in Sample(4) }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.stOrderFlags = one] : one \in Sample(2) }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.branchId = one] : one \in Sample(2) }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.traderId = one] : one \in Sample(4) }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.brokerId = one] : one \in Sample(5) }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.cOrdFiller = one] : one \in Sample(24) }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.openClose = one] : one \in Sample(1) }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.settlor = one] : one \in Sample(12) }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.proClientIndicator = one] : one \in Sample(2) }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.settlementPeriod = one] : one \in Sample(2) }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.additionalOrderFlags = one] : one \in Sample(1) }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.fifthReserved1 = one] : one \in Sample(1) }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.reference = one] : one \in Sample(4) }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.nnfField = one] : one \in Sample(8) }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.mktReplay = one] : one \in Sample(8) }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.pan = one] : one \in Sample(10) }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.algoId = one] : one \in Sample(4) }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.secondReserved2 = one] : one \in Sample(2) }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.lastActivityReference = one] : one \in Sample(8) }
        \cup { [ZeroOrderCancelRejectMessage EXCEPT !.reserved52 = one] : one \in Sample(52) }

(***************************************************************************)
(* Contract Desc: 28 bytes                                                 *)
(***************************************************************************)

ContractDesc7 ==
    [ instrumentName : Sample(6),
      symbol         : Sample(10),
      expiryDate     : Sample(4),
      strikePrice    : Sample(4),
      optionType     : Sample(2),
      caLevel        : Sample(2) ]

EncodeContractDesc7(message) ==
    message.instrumentName
        \o message.symbol
        \o message.expiryDate
        \o message.strikePrice
        \o message.optionType
        \o message.caLevel

DecodeContractDesc7(bytes) ==
    LET instrumentName == ReadBytes(bytes, 6) IN IF ~instrumentName.ok THEN Fail ELSE
    LET symbol == ReadBytes(instrumentName.rest, 10) IN IF ~symbol.ok THEN Fail ELSE
    LET expiryDate == ReadBytes(symbol.rest, 4) IN IF ~expiryDate.ok THEN Fail ELSE
    LET strikePrice == ReadBytes(expiryDate.rest, 4) IN IF ~strikePrice.ok THEN Fail ELSE
    LET optionType == ReadBytes(strikePrice.rest, 2) IN IF ~optionType.ok THEN Fail ELSE
    LET caLevel == ReadBytes(optionType.rest, 2) IN IF ~caLevel.ok THEN Fail ELSE
    Ok([ instrumentName |-> instrumentName.value,
         symbol         |-> symbol.value,
         expiryDate     |-> expiryDate.value,
         strikePrice    |-> strikePrice.value,
         optionType     |-> optionType.value,
         caLevel        |-> caLevel.value ], caLevel.rest)

ZeroContractDesc7 ==
    [ instrumentName |-> [i \in 1 .. 6 |-> 0],
      symbol         |-> [i \in 1 .. 10 |-> 0],
      expiryDate     |-> [i \in 1 .. 4 |-> 0],
      strikePrice    |-> [i \in 1 .. 4 |-> 0],
      optionType     |-> [i \in 1 .. 2 |-> 0],
      caLevel        |-> [i \in 1 .. 2 |-> 0] ]

(* Contract Desc at zero, then each field in turn at the values it is checked at *)
CheckedContractDesc7 ==
    { ZeroContractDesc7 }
        \cup { [ZeroContractDesc7 EXCEPT !.instrumentName = one] : one \in Sample(6) }
        \cup { [ZeroContractDesc7 EXCEPT !.symbol = one] : one \in Sample(10) }
        \cup { [ZeroContractDesc7 EXCEPT !.expiryDate = one] : one \in Sample(4) }
        \cup { [ZeroContractDesc7 EXCEPT !.strikePrice = one] : one \in Sample(4) }
        \cup { [ZeroContractDesc7 EXCEPT !.optionType = one] : one \in Sample(2) }
        \cup { [ZeroContractDesc7 EXCEPT !.caLevel = one] : one \in Sample(2) }

(***************************************************************************)
(* Order Confirmation Message: 276 bytes                                   *)
(***************************************************************************)

OrderConfirmationMessage ==
    [ participantType          : Sample(1),
      reserved1                : Sample(1),
      competitorPeriod         : Sample(2),
      solicitorPeriod          : Sample(2),
      modifiedCancelledBy      : Sample(1),
      secondReserved1          : Sample(1),
      reasonCode               : Sample(2),
      reserved4                : Sample(4),
      tokenNo                  : Sample(4),
      contractDesc             : ContractDesc7,
      counterPartyBrokerId     : Sample(5),
      thirdReserved1           : Sample(1),
      reserved2                : Sample(2),
      closeoutFlag             : Sample(1),
      fourthReserved1          : Sample(1),
      orderType                : Sample(2),
      orderNumber              : Sample(8),
      accountNumber            : Sample(10),
      bookTypeShort2           : Sample(2),
      buySellIndicator         : Sample(2),
      disclosedVolume          : Sample(4),
      disclosedVolumeRemaining : Sample(4),
      totalVolumeRemaining     : Sample(4),
      volume                   : Sample(4),
      volumeFilledToday        : Sample(4),
      price                    : Sample(4),
      triggerPrice             : Sample(4),
      goodTillDate             : Sample(4),
      entryDateTime            : Sample(4),
      minimumFillAonVolume     : Sample(4),
      lastModified             : Sample(4),
      stOrderFlags             : Sample(2),
      branchId                 : Sample(2),
      traderId                 : Sample(4),
      brokerId                 : Sample(5),
      cOrdFiller               : Sample(24),
      openClose                : Sample(1),
      settlor                  : Sample(12),
      proClientIndicator       : Sample(2),
      settlementPeriod         : Sample(2),
      additionalOrderFlags     : Sample(1),
      fifthReserved1           : Sample(1),
      reference                : Sample(4),
      nnfField                 : Sample(8),
      mktReplay                : Sample(8),
      pan                      : Sample(10),
      algoId                   : Sample(4),
      secondReserved2          : Sample(2),
      lastActivityReference    : Sample(8),
      reserved52               : Sample(52) ]

EncodeOrderConfirmationMessage(message) ==
    message.participantType
        \o message.reserved1
        \o message.competitorPeriod
        \o message.solicitorPeriod
        \o message.modifiedCancelledBy
        \o message.secondReserved1
        \o message.reasonCode
        \o message.reserved4
        \o message.tokenNo
        \o EncodeContractDesc7(message.contractDesc)
        \o message.counterPartyBrokerId
        \o message.thirdReserved1
        \o message.reserved2
        \o message.closeoutFlag
        \o message.fourthReserved1
        \o message.orderType
        \o message.orderNumber
        \o message.accountNumber
        \o message.bookTypeShort2
        \o message.buySellIndicator
        \o message.disclosedVolume
        \o message.disclosedVolumeRemaining
        \o message.totalVolumeRemaining
        \o message.volume
        \o message.volumeFilledToday
        \o message.price
        \o message.triggerPrice
        \o message.goodTillDate
        \o message.entryDateTime
        \o message.minimumFillAonVolume
        \o message.lastModified
        \o message.stOrderFlags
        \o message.branchId
        \o message.traderId
        \o message.brokerId
        \o message.cOrdFiller
        \o message.openClose
        \o message.settlor
        \o message.proClientIndicator
        \o message.settlementPeriod
        \o message.additionalOrderFlags
        \o message.fifthReserved1
        \o message.reference
        \o message.nnfField
        \o message.mktReplay
        \o message.pan
        \o message.algoId
        \o message.secondReserved2
        \o message.lastActivityReference
        \o message.reserved52

DecodeOrderConfirmationMessage(bytes) ==
    LET participantType == ReadBytes(bytes, 1) IN IF ~participantType.ok THEN Fail ELSE
    LET reserved1 == ReadBytes(participantType.rest, 1) IN IF ~reserved1.ok THEN Fail ELSE
    LET competitorPeriod == ReadBytes(reserved1.rest, 2) IN IF ~competitorPeriod.ok THEN Fail ELSE
    LET solicitorPeriod == ReadBytes(competitorPeriod.rest, 2) IN IF ~solicitorPeriod.ok THEN Fail ELSE
    LET modifiedCancelledBy == ReadBytes(solicitorPeriod.rest, 1) IN IF ~modifiedCancelledBy.ok THEN Fail ELSE
    LET secondReserved1 == ReadBytes(modifiedCancelledBy.rest, 1) IN IF ~secondReserved1.ok THEN Fail ELSE
    LET reasonCode == ReadBytes(secondReserved1.rest, 2) IN IF ~reasonCode.ok THEN Fail ELSE
    LET reserved4 == ReadBytes(reasonCode.rest, 4) IN IF ~reserved4.ok THEN Fail ELSE
    LET tokenNo == ReadBytes(reserved4.rest, 4) IN IF ~tokenNo.ok THEN Fail ELSE
    LET contractDesc == DecodeContractDesc7(tokenNo.rest) IN IF ~contractDesc.ok THEN Fail ELSE
    LET counterPartyBrokerId == ReadBytes(contractDesc.rest, 5) IN IF ~counterPartyBrokerId.ok THEN Fail ELSE
    LET thirdReserved1 == ReadBytes(counterPartyBrokerId.rest, 1) IN IF ~thirdReserved1.ok THEN Fail ELSE
    LET reserved2 == ReadBytes(thirdReserved1.rest, 2) IN IF ~reserved2.ok THEN Fail ELSE
    LET closeoutFlag == ReadBytes(reserved2.rest, 1) IN IF ~closeoutFlag.ok THEN Fail ELSE
    LET fourthReserved1 == ReadBytes(closeoutFlag.rest, 1) IN IF ~fourthReserved1.ok THEN Fail ELSE
    LET orderType == ReadBytes(fourthReserved1.rest, 2) IN IF ~orderType.ok THEN Fail ELSE
    LET orderNumber == ReadBytes(orderType.rest, 8) IN IF ~orderNumber.ok THEN Fail ELSE
    LET accountNumber == ReadBytes(orderNumber.rest, 10) IN IF ~accountNumber.ok THEN Fail ELSE
    LET bookTypeShort2 == ReadBytes(accountNumber.rest, 2) IN IF ~bookTypeShort2.ok THEN Fail ELSE
    LET buySellIndicator == ReadBytes(bookTypeShort2.rest, 2) IN IF ~buySellIndicator.ok THEN Fail ELSE
    LET disclosedVolume == ReadBytes(buySellIndicator.rest, 4) IN IF ~disclosedVolume.ok THEN Fail ELSE
    LET disclosedVolumeRemaining == ReadBytes(disclosedVolume.rest, 4) IN IF ~disclosedVolumeRemaining.ok THEN Fail ELSE
    LET totalVolumeRemaining == ReadBytes(disclosedVolumeRemaining.rest, 4) IN IF ~totalVolumeRemaining.ok THEN Fail ELSE
    LET volume == ReadBytes(totalVolumeRemaining.rest, 4) IN IF ~volume.ok THEN Fail ELSE
    LET volumeFilledToday == ReadBytes(volume.rest, 4) IN IF ~volumeFilledToday.ok THEN Fail ELSE
    LET price == ReadBytes(volumeFilledToday.rest, 4) IN IF ~price.ok THEN Fail ELSE
    LET triggerPrice == ReadBytes(price.rest, 4) IN IF ~triggerPrice.ok THEN Fail ELSE
    LET goodTillDate == ReadBytes(triggerPrice.rest, 4) IN IF ~goodTillDate.ok THEN Fail ELSE
    LET entryDateTime == ReadBytes(goodTillDate.rest, 4) IN IF ~entryDateTime.ok THEN Fail ELSE
    LET minimumFillAonVolume == ReadBytes(entryDateTime.rest, 4) IN IF ~minimumFillAonVolume.ok THEN Fail ELSE
    LET lastModified == ReadBytes(minimumFillAonVolume.rest, 4) IN IF ~lastModified.ok THEN Fail ELSE
    LET stOrderFlags == ReadBytes(lastModified.rest, 2) IN IF ~stOrderFlags.ok THEN Fail ELSE
    LET branchId == ReadBytes(stOrderFlags.rest, 2) IN IF ~branchId.ok THEN Fail ELSE
    LET traderId == ReadBytes(branchId.rest, 4) IN IF ~traderId.ok THEN Fail ELSE
    LET brokerId == ReadBytes(traderId.rest, 5) IN IF ~brokerId.ok THEN Fail ELSE
    LET cOrdFiller == ReadBytes(brokerId.rest, 24) IN IF ~cOrdFiller.ok THEN Fail ELSE
    LET openClose == ReadBytes(cOrdFiller.rest, 1) IN IF ~openClose.ok THEN Fail ELSE
    LET settlor == ReadBytes(openClose.rest, 12) IN IF ~settlor.ok THEN Fail ELSE
    LET proClientIndicator == ReadBytes(settlor.rest, 2) IN IF ~proClientIndicator.ok THEN Fail ELSE
    LET settlementPeriod == ReadBytes(proClientIndicator.rest, 2) IN IF ~settlementPeriod.ok THEN Fail ELSE
    LET additionalOrderFlags == ReadBytes(settlementPeriod.rest, 1) IN IF ~additionalOrderFlags.ok THEN Fail ELSE
    LET fifthReserved1 == ReadBytes(additionalOrderFlags.rest, 1) IN IF ~fifthReserved1.ok THEN Fail ELSE
    LET reference == ReadBytes(fifthReserved1.rest, 4) IN IF ~reference.ok THEN Fail ELSE
    LET nnfField == ReadBytes(reference.rest, 8) IN IF ~nnfField.ok THEN Fail ELSE
    LET mktReplay == ReadBytes(nnfField.rest, 8) IN IF ~mktReplay.ok THEN Fail ELSE
    LET pan == ReadBytes(mktReplay.rest, 10) IN IF ~pan.ok THEN Fail ELSE
    LET algoId == ReadBytes(pan.rest, 4) IN IF ~algoId.ok THEN Fail ELSE
    LET secondReserved2 == ReadBytes(algoId.rest, 2) IN IF ~secondReserved2.ok THEN Fail ELSE
    LET lastActivityReference == ReadBytes(secondReserved2.rest, 8) IN IF ~lastActivityReference.ok THEN Fail ELSE
    LET reserved52 == ReadBytes(lastActivityReference.rest, 52) IN IF ~reserved52.ok THEN Fail ELSE
    Ok([ participantType          |-> participantType.value,
         reserved1                |-> reserved1.value,
         competitorPeriod         |-> competitorPeriod.value,
         solicitorPeriod          |-> solicitorPeriod.value,
         modifiedCancelledBy      |-> modifiedCancelledBy.value,
         secondReserved1          |-> secondReserved1.value,
         reasonCode               |-> reasonCode.value,
         reserved4                |-> reserved4.value,
         tokenNo                  |-> tokenNo.value,
         contractDesc             |-> contractDesc.value,
         counterPartyBrokerId     |-> counterPartyBrokerId.value,
         thirdReserved1           |-> thirdReserved1.value,
         reserved2                |-> reserved2.value,
         closeoutFlag             |-> closeoutFlag.value,
         fourthReserved1          |-> fourthReserved1.value,
         orderType                |-> orderType.value,
         orderNumber              |-> orderNumber.value,
         accountNumber            |-> accountNumber.value,
         bookTypeShort2           |-> bookTypeShort2.value,
         buySellIndicator         |-> buySellIndicator.value,
         disclosedVolume          |-> disclosedVolume.value,
         disclosedVolumeRemaining |-> disclosedVolumeRemaining.value,
         totalVolumeRemaining     |-> totalVolumeRemaining.value,
         volume                   |-> volume.value,
         volumeFilledToday        |-> volumeFilledToday.value,
         price                    |-> price.value,
         triggerPrice             |-> triggerPrice.value,
         goodTillDate             |-> goodTillDate.value,
         entryDateTime            |-> entryDateTime.value,
         minimumFillAonVolume     |-> minimumFillAonVolume.value,
         lastModified             |-> lastModified.value,
         stOrderFlags             |-> stOrderFlags.value,
         branchId                 |-> branchId.value,
         traderId                 |-> traderId.value,
         brokerId                 |-> brokerId.value,
         cOrdFiller               |-> cOrdFiller.value,
         openClose                |-> openClose.value,
         settlor                  |-> settlor.value,
         proClientIndicator       |-> proClientIndicator.value,
         settlementPeriod         |-> settlementPeriod.value,
         additionalOrderFlags     |-> additionalOrderFlags.value,
         fifthReserved1           |-> fifthReserved1.value,
         reference                |-> reference.value,
         nnfField                 |-> nnfField.value,
         mktReplay                |-> mktReplay.value,
         pan                      |-> pan.value,
         algoId                   |-> algoId.value,
         secondReserved2          |-> secondReserved2.value,
         lastActivityReference    |-> lastActivityReference.value,
         reserved52               |-> reserved52.value ], reserved52.rest)

ZeroOrderConfirmationMessage ==
    [ participantType          |-> [i \in 1 .. 1 |-> 0],
      reserved1                |-> [i \in 1 .. 1 |-> 0],
      competitorPeriod         |-> [i \in 1 .. 2 |-> 0],
      solicitorPeriod          |-> [i \in 1 .. 2 |-> 0],
      modifiedCancelledBy      |-> [i \in 1 .. 1 |-> 0],
      secondReserved1          |-> [i \in 1 .. 1 |-> 0],
      reasonCode               |-> [i \in 1 .. 2 |-> 0],
      reserved4                |-> [i \in 1 .. 4 |-> 0],
      tokenNo                  |-> [i \in 1 .. 4 |-> 0],
      contractDesc             |-> ZeroContractDesc7,
      counterPartyBrokerId     |-> [i \in 1 .. 5 |-> 0],
      thirdReserved1           |-> [i \in 1 .. 1 |-> 0],
      reserved2                |-> [i \in 1 .. 2 |-> 0],
      closeoutFlag             |-> [i \in 1 .. 1 |-> 0],
      fourthReserved1          |-> [i \in 1 .. 1 |-> 0],
      orderType                |-> [i \in 1 .. 2 |-> 0],
      orderNumber              |-> [i \in 1 .. 8 |-> 0],
      accountNumber            |-> [i \in 1 .. 10 |-> 0],
      bookTypeShort2           |-> [i \in 1 .. 2 |-> 0],
      buySellIndicator         |-> [i \in 1 .. 2 |-> 0],
      disclosedVolume          |-> [i \in 1 .. 4 |-> 0],
      disclosedVolumeRemaining |-> [i \in 1 .. 4 |-> 0],
      totalVolumeRemaining     |-> [i \in 1 .. 4 |-> 0],
      volume                   |-> [i \in 1 .. 4 |-> 0],
      volumeFilledToday        |-> [i \in 1 .. 4 |-> 0],
      price                    |-> [i \in 1 .. 4 |-> 0],
      triggerPrice             |-> [i \in 1 .. 4 |-> 0],
      goodTillDate             |-> [i \in 1 .. 4 |-> 0],
      entryDateTime            |-> [i \in 1 .. 4 |-> 0],
      minimumFillAonVolume     |-> [i \in 1 .. 4 |-> 0],
      lastModified             |-> [i \in 1 .. 4 |-> 0],
      stOrderFlags             |-> [i \in 1 .. 2 |-> 0],
      branchId                 |-> [i \in 1 .. 2 |-> 0],
      traderId                 |-> [i \in 1 .. 4 |-> 0],
      brokerId                 |-> [i \in 1 .. 5 |-> 0],
      cOrdFiller               |-> [i \in 1 .. 24 |-> 0],
      openClose                |-> [i \in 1 .. 1 |-> 0],
      settlor                  |-> [i \in 1 .. 12 |-> 0],
      proClientIndicator       |-> [i \in 1 .. 2 |-> 0],
      settlementPeriod         |-> [i \in 1 .. 2 |-> 0],
      additionalOrderFlags     |-> [i \in 1 .. 1 |-> 0],
      fifthReserved1           |-> [i \in 1 .. 1 |-> 0],
      reference                |-> [i \in 1 .. 4 |-> 0],
      nnfField                 |-> [i \in 1 .. 8 |-> 0],
      mktReplay                |-> [i \in 1 .. 8 |-> 0],
      pan                      |-> [i \in 1 .. 10 |-> 0],
      algoId                   |-> [i \in 1 .. 4 |-> 0],
      secondReserved2          |-> [i \in 1 .. 2 |-> 0],
      lastActivityReference    |-> [i \in 1 .. 8 |-> 0],
      reserved52               |-> [i \in 1 .. 52 |-> 0] ]

(* Order Confirmation Message at zero, then each field in turn at the values it is checked at *)
CheckedOrderConfirmationMessage ==
    { ZeroOrderConfirmationMessage }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.participantType = one] : one \in Sample(1) }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.reserved1 = one] : one \in Sample(1) }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.competitorPeriod = one] : one \in Sample(2) }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.solicitorPeriod = one] : one \in Sample(2) }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.modifiedCancelledBy = one] : one \in Sample(1) }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.secondReserved1 = one] : one \in Sample(1) }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.reasonCode = one] : one \in Sample(2) }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.reserved4 = one] : one \in Sample(4) }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.tokenNo = one] : one \in Sample(4) }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.contractDesc = one] : one \in CheckedContractDesc7 }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.counterPartyBrokerId = one] : one \in Sample(5) }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.thirdReserved1 = one] : one \in Sample(1) }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.reserved2 = one] : one \in Sample(2) }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.closeoutFlag = one] : one \in Sample(1) }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.fourthReserved1 = one] : one \in Sample(1) }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.orderType = one] : one \in Sample(2) }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.orderNumber = one] : one \in Sample(8) }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.accountNumber = one] : one \in Sample(10) }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.bookTypeShort2 = one] : one \in Sample(2) }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.buySellIndicator = one] : one \in Sample(2) }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.disclosedVolume = one] : one \in Sample(4) }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.disclosedVolumeRemaining = one] : one \in Sample(4) }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.totalVolumeRemaining = one] : one \in Sample(4) }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.volume = one] : one \in Sample(4) }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.volumeFilledToday = one] : one \in Sample(4) }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.price = one] : one \in Sample(4) }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.triggerPrice = one] : one \in Sample(4) }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.goodTillDate = one] : one \in Sample(4) }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.entryDateTime = one] : one \in Sample(4) }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.minimumFillAonVolume = one] : one \in Sample(4) }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.lastModified = one] : one \in Sample(4) }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.stOrderFlags = one] : one \in Sample(2) }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.branchId = one] : one \in Sample(2) }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.traderId = one] : one \in Sample(4) }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.brokerId = one] : one \in Sample(5) }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.cOrdFiller = one] : one \in Sample(24) }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.openClose = one] : one \in Sample(1) }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.settlor = one] : one \in Sample(12) }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.proClientIndicator = one] : one \in Sample(2) }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.settlementPeriod = one] : one \in Sample(2) }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.additionalOrderFlags = one] : one \in Sample(1) }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.fifthReserved1 = one] : one \in Sample(1) }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.reference = one] : one \in Sample(4) }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.nnfField = one] : one \in Sample(8) }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.mktReplay = one] : one \in Sample(8) }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.pan = one] : one \in Sample(10) }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.algoId = one] : one \in Sample(4) }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.secondReserved2 = one] : one \in Sample(2) }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.lastActivityReference = one] : one \in Sample(8) }
        \cup { [ZeroOrderConfirmationMessage EXCEPT !.reserved52 = one] : one \in Sample(52) }

(***************************************************************************)
(* Contract Desc: 28 bytes                                                 *)
(***************************************************************************)

ContractDesc8 ==
    [ instrumentName : Sample(6),
      symbol         : Sample(10),
      expiryDate     : Sample(4),
      strikePrice    : Sample(4),
      optionType     : Sample(2),
      caLevel        : Sample(2) ]

EncodeContractDesc8(message) ==
    message.instrumentName
        \o message.symbol
        \o message.expiryDate
        \o message.strikePrice
        \o message.optionType
        \o message.caLevel

DecodeContractDesc8(bytes) ==
    LET instrumentName == ReadBytes(bytes, 6) IN IF ~instrumentName.ok THEN Fail ELSE
    LET symbol == ReadBytes(instrumentName.rest, 10) IN IF ~symbol.ok THEN Fail ELSE
    LET expiryDate == ReadBytes(symbol.rest, 4) IN IF ~expiryDate.ok THEN Fail ELSE
    LET strikePrice == ReadBytes(expiryDate.rest, 4) IN IF ~strikePrice.ok THEN Fail ELSE
    LET optionType == ReadBytes(strikePrice.rest, 2) IN IF ~optionType.ok THEN Fail ELSE
    LET caLevel == ReadBytes(optionType.rest, 2) IN IF ~caLevel.ok THEN Fail ELSE
    Ok([ instrumentName |-> instrumentName.value,
         symbol         |-> symbol.value,
         expiryDate     |-> expiryDate.value,
         strikePrice    |-> strikePrice.value,
         optionType     |-> optionType.value,
         caLevel        |-> caLevel.value ], caLevel.rest)

ZeroContractDesc8 ==
    [ instrumentName |-> [i \in 1 .. 6 |-> 0],
      symbol         |-> [i \in 1 .. 10 |-> 0],
      expiryDate     |-> [i \in 1 .. 4 |-> 0],
      strikePrice    |-> [i \in 1 .. 4 |-> 0],
      optionType     |-> [i \in 1 .. 2 |-> 0],
      caLevel        |-> [i \in 1 .. 2 |-> 0] ]

(* Contract Desc at zero, then each field in turn at the values it is checked at *)
CheckedContractDesc8 ==
    { ZeroContractDesc8 }
        \cup { [ZeroContractDesc8 EXCEPT !.instrumentName = one] : one \in Sample(6) }
        \cup { [ZeroContractDesc8 EXCEPT !.symbol = one] : one \in Sample(10) }
        \cup { [ZeroContractDesc8 EXCEPT !.expiryDate = one] : one \in Sample(4) }
        \cup { [ZeroContractDesc8 EXCEPT !.strikePrice = one] : one \in Sample(4) }
        \cup { [ZeroContractDesc8 EXCEPT !.optionType = one] : one \in Sample(2) }
        \cup { [ZeroContractDesc8 EXCEPT !.caLevel = one] : one \in Sample(2) }

(***************************************************************************)
(* Order Mod Confirmation Message: 276 bytes                               *)
(***************************************************************************)

OrderModConfirmationMessage ==
    [ participantType          : Sample(1),
      reserved1                : Sample(1),
      competitorPeriod         : Sample(2),
      solicitorPeriod          : Sample(2),
      modifiedCancelledBy      : Sample(1),
      secondReserved1          : Sample(1),
      reasonCode               : Sample(2),
      reserved4                : Sample(4),
      tokenNo                  : Sample(4),
      contractDesc             : ContractDesc8,
      counterPartyBrokerId     : Sample(5),
      thirdReserved1           : Sample(1),
      reserved2                : Sample(2),
      closeoutFlag             : Sample(1),
      fourthReserved1          : Sample(1),
      orderType                : Sample(2),
      orderNumber              : Sample(8),
      accountNumber            : Sample(10),
      bookTypeShort2           : Sample(2),
      buySellIndicator         : Sample(2),
      disclosedVolume          : Sample(4),
      disclosedVolumeRemaining : Sample(4),
      totalVolumeRemaining     : Sample(4),
      volume                   : Sample(4),
      volumeFilledToday        : Sample(4),
      price                    : Sample(4),
      triggerPrice             : Sample(4),
      goodTillDate             : Sample(4),
      entryDateTime            : Sample(4),
      minimumFillAonVolume     : Sample(4),
      lastModified             : Sample(4),
      stOrderFlags             : Sample(2),
      branchId                 : Sample(2),
      traderId                 : Sample(4),
      brokerId                 : Sample(5),
      cOrdFiller               : Sample(24),
      openClose                : Sample(1),
      settlor                  : Sample(12),
      proClientIndicator       : Sample(2),
      settlementPeriod         : Sample(2),
      additionalOrderFlags     : Sample(1),
      fifthReserved1           : Sample(1),
      reference                : Sample(4),
      nnfField                 : Sample(8),
      mktReplay                : Sample(8),
      pan                      : Sample(10),
      algoId                   : Sample(4),
      secondReserved2          : Sample(2),
      lastActivityReference    : Sample(8),
      reserved52               : Sample(52) ]

EncodeOrderModConfirmationMessage(message) ==
    message.participantType
        \o message.reserved1
        \o message.competitorPeriod
        \o message.solicitorPeriod
        \o message.modifiedCancelledBy
        \o message.secondReserved1
        \o message.reasonCode
        \o message.reserved4
        \o message.tokenNo
        \o EncodeContractDesc8(message.contractDesc)
        \o message.counterPartyBrokerId
        \o message.thirdReserved1
        \o message.reserved2
        \o message.closeoutFlag
        \o message.fourthReserved1
        \o message.orderType
        \o message.orderNumber
        \o message.accountNumber
        \o message.bookTypeShort2
        \o message.buySellIndicator
        \o message.disclosedVolume
        \o message.disclosedVolumeRemaining
        \o message.totalVolumeRemaining
        \o message.volume
        \o message.volumeFilledToday
        \o message.price
        \o message.triggerPrice
        \o message.goodTillDate
        \o message.entryDateTime
        \o message.minimumFillAonVolume
        \o message.lastModified
        \o message.stOrderFlags
        \o message.branchId
        \o message.traderId
        \o message.brokerId
        \o message.cOrdFiller
        \o message.openClose
        \o message.settlor
        \o message.proClientIndicator
        \o message.settlementPeriod
        \o message.additionalOrderFlags
        \o message.fifthReserved1
        \o message.reference
        \o message.nnfField
        \o message.mktReplay
        \o message.pan
        \o message.algoId
        \o message.secondReserved2
        \o message.lastActivityReference
        \o message.reserved52

DecodeOrderModConfirmationMessage(bytes) ==
    LET participantType == ReadBytes(bytes, 1) IN IF ~participantType.ok THEN Fail ELSE
    LET reserved1 == ReadBytes(participantType.rest, 1) IN IF ~reserved1.ok THEN Fail ELSE
    LET competitorPeriod == ReadBytes(reserved1.rest, 2) IN IF ~competitorPeriod.ok THEN Fail ELSE
    LET solicitorPeriod == ReadBytes(competitorPeriod.rest, 2) IN IF ~solicitorPeriod.ok THEN Fail ELSE
    LET modifiedCancelledBy == ReadBytes(solicitorPeriod.rest, 1) IN IF ~modifiedCancelledBy.ok THEN Fail ELSE
    LET secondReserved1 == ReadBytes(modifiedCancelledBy.rest, 1) IN IF ~secondReserved1.ok THEN Fail ELSE
    LET reasonCode == ReadBytes(secondReserved1.rest, 2) IN IF ~reasonCode.ok THEN Fail ELSE
    LET reserved4 == ReadBytes(reasonCode.rest, 4) IN IF ~reserved4.ok THEN Fail ELSE
    LET tokenNo == ReadBytes(reserved4.rest, 4) IN IF ~tokenNo.ok THEN Fail ELSE
    LET contractDesc == DecodeContractDesc8(tokenNo.rest) IN IF ~contractDesc.ok THEN Fail ELSE
    LET counterPartyBrokerId == ReadBytes(contractDesc.rest, 5) IN IF ~counterPartyBrokerId.ok THEN Fail ELSE
    LET thirdReserved1 == ReadBytes(counterPartyBrokerId.rest, 1) IN IF ~thirdReserved1.ok THEN Fail ELSE
    LET reserved2 == ReadBytes(thirdReserved1.rest, 2) IN IF ~reserved2.ok THEN Fail ELSE
    LET closeoutFlag == ReadBytes(reserved2.rest, 1) IN IF ~closeoutFlag.ok THEN Fail ELSE
    LET fourthReserved1 == ReadBytes(closeoutFlag.rest, 1) IN IF ~fourthReserved1.ok THEN Fail ELSE
    LET orderType == ReadBytes(fourthReserved1.rest, 2) IN IF ~orderType.ok THEN Fail ELSE
    LET orderNumber == ReadBytes(orderType.rest, 8) IN IF ~orderNumber.ok THEN Fail ELSE
    LET accountNumber == ReadBytes(orderNumber.rest, 10) IN IF ~accountNumber.ok THEN Fail ELSE
    LET bookTypeShort2 == ReadBytes(accountNumber.rest, 2) IN IF ~bookTypeShort2.ok THEN Fail ELSE
    LET buySellIndicator == ReadBytes(bookTypeShort2.rest, 2) IN IF ~buySellIndicator.ok THEN Fail ELSE
    LET disclosedVolume == ReadBytes(buySellIndicator.rest, 4) IN IF ~disclosedVolume.ok THEN Fail ELSE
    LET disclosedVolumeRemaining == ReadBytes(disclosedVolume.rest, 4) IN IF ~disclosedVolumeRemaining.ok THEN Fail ELSE
    LET totalVolumeRemaining == ReadBytes(disclosedVolumeRemaining.rest, 4) IN IF ~totalVolumeRemaining.ok THEN Fail ELSE
    LET volume == ReadBytes(totalVolumeRemaining.rest, 4) IN IF ~volume.ok THEN Fail ELSE
    LET volumeFilledToday == ReadBytes(volume.rest, 4) IN IF ~volumeFilledToday.ok THEN Fail ELSE
    LET price == ReadBytes(volumeFilledToday.rest, 4) IN IF ~price.ok THEN Fail ELSE
    LET triggerPrice == ReadBytes(price.rest, 4) IN IF ~triggerPrice.ok THEN Fail ELSE
    LET goodTillDate == ReadBytes(triggerPrice.rest, 4) IN IF ~goodTillDate.ok THEN Fail ELSE
    LET entryDateTime == ReadBytes(goodTillDate.rest, 4) IN IF ~entryDateTime.ok THEN Fail ELSE
    LET minimumFillAonVolume == ReadBytes(entryDateTime.rest, 4) IN IF ~minimumFillAonVolume.ok THEN Fail ELSE
    LET lastModified == ReadBytes(minimumFillAonVolume.rest, 4) IN IF ~lastModified.ok THEN Fail ELSE
    LET stOrderFlags == ReadBytes(lastModified.rest, 2) IN IF ~stOrderFlags.ok THEN Fail ELSE
    LET branchId == ReadBytes(stOrderFlags.rest, 2) IN IF ~branchId.ok THEN Fail ELSE
    LET traderId == ReadBytes(branchId.rest, 4) IN IF ~traderId.ok THEN Fail ELSE
    LET brokerId == ReadBytes(traderId.rest, 5) IN IF ~brokerId.ok THEN Fail ELSE
    LET cOrdFiller == ReadBytes(brokerId.rest, 24) IN IF ~cOrdFiller.ok THEN Fail ELSE
    LET openClose == ReadBytes(cOrdFiller.rest, 1) IN IF ~openClose.ok THEN Fail ELSE
    LET settlor == ReadBytes(openClose.rest, 12) IN IF ~settlor.ok THEN Fail ELSE
    LET proClientIndicator == ReadBytes(settlor.rest, 2) IN IF ~proClientIndicator.ok THEN Fail ELSE
    LET settlementPeriod == ReadBytes(proClientIndicator.rest, 2) IN IF ~settlementPeriod.ok THEN Fail ELSE
    LET additionalOrderFlags == ReadBytes(settlementPeriod.rest, 1) IN IF ~additionalOrderFlags.ok THEN Fail ELSE
    LET fifthReserved1 == ReadBytes(additionalOrderFlags.rest, 1) IN IF ~fifthReserved1.ok THEN Fail ELSE
    LET reference == ReadBytes(fifthReserved1.rest, 4) IN IF ~reference.ok THEN Fail ELSE
    LET nnfField == ReadBytes(reference.rest, 8) IN IF ~nnfField.ok THEN Fail ELSE
    LET mktReplay == ReadBytes(nnfField.rest, 8) IN IF ~mktReplay.ok THEN Fail ELSE
    LET pan == ReadBytes(mktReplay.rest, 10) IN IF ~pan.ok THEN Fail ELSE
    LET algoId == ReadBytes(pan.rest, 4) IN IF ~algoId.ok THEN Fail ELSE
    LET secondReserved2 == ReadBytes(algoId.rest, 2) IN IF ~secondReserved2.ok THEN Fail ELSE
    LET lastActivityReference == ReadBytes(secondReserved2.rest, 8) IN IF ~lastActivityReference.ok THEN Fail ELSE
    LET reserved52 == ReadBytes(lastActivityReference.rest, 52) IN IF ~reserved52.ok THEN Fail ELSE
    Ok([ participantType          |-> participantType.value,
         reserved1                |-> reserved1.value,
         competitorPeriod         |-> competitorPeriod.value,
         solicitorPeriod          |-> solicitorPeriod.value,
         modifiedCancelledBy      |-> modifiedCancelledBy.value,
         secondReserved1          |-> secondReserved1.value,
         reasonCode               |-> reasonCode.value,
         reserved4                |-> reserved4.value,
         tokenNo                  |-> tokenNo.value,
         contractDesc             |-> contractDesc.value,
         counterPartyBrokerId     |-> counterPartyBrokerId.value,
         thirdReserved1           |-> thirdReserved1.value,
         reserved2                |-> reserved2.value,
         closeoutFlag             |-> closeoutFlag.value,
         fourthReserved1          |-> fourthReserved1.value,
         orderType                |-> orderType.value,
         orderNumber              |-> orderNumber.value,
         accountNumber            |-> accountNumber.value,
         bookTypeShort2           |-> bookTypeShort2.value,
         buySellIndicator         |-> buySellIndicator.value,
         disclosedVolume          |-> disclosedVolume.value,
         disclosedVolumeRemaining |-> disclosedVolumeRemaining.value,
         totalVolumeRemaining     |-> totalVolumeRemaining.value,
         volume                   |-> volume.value,
         volumeFilledToday        |-> volumeFilledToday.value,
         price                    |-> price.value,
         triggerPrice             |-> triggerPrice.value,
         goodTillDate             |-> goodTillDate.value,
         entryDateTime            |-> entryDateTime.value,
         minimumFillAonVolume     |-> minimumFillAonVolume.value,
         lastModified             |-> lastModified.value,
         stOrderFlags             |-> stOrderFlags.value,
         branchId                 |-> branchId.value,
         traderId                 |-> traderId.value,
         brokerId                 |-> brokerId.value,
         cOrdFiller               |-> cOrdFiller.value,
         openClose                |-> openClose.value,
         settlor                  |-> settlor.value,
         proClientIndicator       |-> proClientIndicator.value,
         settlementPeriod         |-> settlementPeriod.value,
         additionalOrderFlags     |-> additionalOrderFlags.value,
         fifthReserved1           |-> fifthReserved1.value,
         reference                |-> reference.value,
         nnfField                 |-> nnfField.value,
         mktReplay                |-> mktReplay.value,
         pan                      |-> pan.value,
         algoId                   |-> algoId.value,
         secondReserved2          |-> secondReserved2.value,
         lastActivityReference    |-> lastActivityReference.value,
         reserved52               |-> reserved52.value ], reserved52.rest)

