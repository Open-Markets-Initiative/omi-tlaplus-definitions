      contractDesc             |-> ZeroContractDesc11,
      counterPartyBrokerId     |-> [i \in 1 .. 5 |-> 0],
      thirdReserved1           |-> [i \in 1 .. 1 |-> 0],
      reserved2                |-> [i \in 1 .. 2 |-> 0],
      closeoutFlag             |-> [i \in 1 .. 1 |-> 0],
      fourthReserved1          |-> [i \in 1 .. 1 |-> 0],
      orderType                |-> [i \in 1 .. 2 |-> 0],
      orderNumber              |-> [i \in 1 .. 8 |-> 0],
      accountNumber            |-> [i \in 1 .. 10 |-> 0],
      bookTypeShort2           |-> [i \in 1 .. 2 |-> 0],
      buySellIndicator         |-> [i \in 1 .. 2 |-> 0],
      disclosedVolume          |-> [i \in 1 .. 4 |-> 0],
      disclosedVolumeRemaining |-> [i \in 1 .. 4 |-> 0],
      totalVolumeRemaining     |-> [i \in 1 .. 4 |-> 0],
      volume                   |-> [i \in 1 .. 4 |-> 0],
      volumeFilledToday        |-> [i \in 1 .. 4 |-> 0],
      price                    |-> [i \in 1 .. 4 |-> 0],
      triggerPrice             |-> [i \in 1 .. 4 |-> 0],
      goodTillDate             |-> [i \in 1 .. 4 |-> 0],
      entryDateTime            |-> [i \in 1 .. 4 |-> 0],
      minimumFillAonVolume     |-> [i \in 1 .. 4 |-> 0],
      lastModified             |-> [i \in 1 .. 4 |-> 0],
      stOrderFlags             |-> [i \in 1 .. 2 |-> 0],
      branchId                 |-> [i \in 1 .. 2 |-> 0],
      traderId                 |-> [i \in 1 .. 4 |-> 0],
      brokerId                 |-> [i \in 1 .. 5 |-> 0],
      cOrdFiller               |-> [i \in 1 .. 24 |-> 0],
      openClose                |-> [i \in 1 .. 1 |-> 0],
      settlor                  |-> [i \in 1 .. 12 |-> 0],
      proClientIndicator       |-> [i \in 1 .. 2 |-> 0],
      settlementPeriod         |-> [i \in 1 .. 2 |-> 0],
      additionalOrderFlags     |-> [i \in 1 .. 1 |-> 0],
      fifthReserved1           |-> [i \in 1 .. 1 |-> 0],
      reference                |-> [i \in 1 .. 4 |-> 0],
      nnfField                 |-> [i \in 1 .. 8 |-> 0],
      mktReplay                |-> [i \in 1 .. 8 |-> 0],
      pan                      |-> [i \in 1 .. 10 |-> 0],
      algoId                   |-> [i \in 1 .. 4 |-> 0],
      secondReserved2          |-> [i \in 1 .. 2 |-> 0],
      lastActivityReference    |-> [i \in 1 .. 8 |-> 0],
      reserved52               |-> [i \in 1 .. 52 |-> 0] ]

(* Freeze To Control Message at zero, then each field in turn at the values it is checked at *)
CheckedFreezeToControlMessage ==
    { ZeroFreezeToControlMessage }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.participantType = one] : one \in Sample(1) }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.reserved1 = one] : one \in Sample(1) }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.competitorPeriod = one] : one \in Sample(2) }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.solicitorPeriod = one] : one \in Sample(2) }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.modifiedCancelledBy = one] : one \in Sample(1) }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.secondReserved1 = one] : one \in Sample(1) }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.reasonCode = one] : one \in Sample(2) }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.reserved4 = one] : one \in Sample(4) }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.tokenNo = one] : one \in Sample(4) }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.contractDesc = one] : one \in CheckedContractDesc11 }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.counterPartyBrokerId = one] : one \in Sample(5) }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.thirdReserved1 = one] : one \in Sample(1) }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.reserved2 = one] : one \in Sample(2) }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.closeoutFlag = one] : one \in Sample(1) }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.fourthReserved1 = one] : one \in Sample(1) }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.orderType = one] : one \in Sample(2) }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.orderNumber = one] : one \in Sample(8) }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.accountNumber = one] : one \in Sample(10) }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.bookTypeShort2 = one] : one \in Sample(2) }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.buySellIndicator = one] : one \in Sample(2) }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.disclosedVolume = one] : one \in Sample(4) }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.disclosedVolumeRemaining = one] : one \in Sample(4) }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.totalVolumeRemaining = one] : one \in Sample(4) }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.volume = one] : one \in Sample(4) }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.volumeFilledToday = one] : one \in Sample(4) }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.price = one] : one \in Sample(4) }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.triggerPrice = one] : one \in Sample(4) }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.goodTillDate = one] : one \in Sample(4) }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.entryDateTime = one] : one \in Sample(4) }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.minimumFillAonVolume = one] : one \in Sample(4) }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.lastModified = one] : one \in Sample(4) }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.stOrderFlags = one] : one \in Sample(2) }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.branchId = one] : one \in Sample(2) }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.traderId = one] : one \in Sample(4) }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.brokerId = one] : one \in Sample(5) }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.cOrdFiller = one] : one \in Sample(24) }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.openClose = one] : one \in Sample(1) }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.settlor = one] : one \in Sample(12) }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.proClientIndicator = one] : one \in Sample(2) }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.settlementPeriod = one] : one \in Sample(2) }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.additionalOrderFlags = one] : one \in Sample(1) }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.fifthReserved1 = one] : one \in Sample(1) }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.reference = one] : one \in Sample(4) }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.nnfField = one] : one \in Sample(8) }
