        \cup { [ZeroMsSpdLegInfoLeg26 EXCEPT !.stOrderFlags = one] : one \in Sample(2) }
        \cup { [ZeroMsSpdLegInfoLeg26 EXCEPT !.openClose2 = one] : one \in Sample(1) }
