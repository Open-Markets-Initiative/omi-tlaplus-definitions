      activityTime          |-> [i \in 1 .. 4 |-> 0],
      opOrderNumber         |-> [i \in 1 .. 8 |-> 0],
      opBrokerId            |-> [i \in 1 .. 5 |-> 0],
      secondReserved1       |-> [i \in 1 .. 1 |-> 0],
      token                 |-> [i \in 1 .. 4 |-> 0],
