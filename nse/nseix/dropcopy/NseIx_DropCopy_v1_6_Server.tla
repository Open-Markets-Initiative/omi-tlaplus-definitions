CheckedContractDesc21 ==
    { ZeroContractDesc21 }
        \cup { [ZeroContractDesc21 EXCEPT !.instrumentName = one] : one \in Sample(6) }
        \cup { [ZeroContractDesc21 EXCEPT !.symbol = one] : one \in Sample(10) }
        \cup { [ZeroContractDesc21 EXCEPT !.expiryDate = one] : one \in Sample(4) }
        \cup { [ZeroContractDesc21 EXCEPT !.strikePrice = one] : one \in Sample(4) }
        \cup { [ZeroContractDesc21 EXCEPT !.optionType = one] : one \in Sample(2) }
        \cup { [ZeroContractDesc21 EXCEPT !.caLevel = one] : one \in Sample(2) }

