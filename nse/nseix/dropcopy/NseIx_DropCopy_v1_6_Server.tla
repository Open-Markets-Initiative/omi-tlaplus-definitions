        \cup { [ZeroNltCxlRejectMessage EXCEPT !.orderNumber = one] : one \in Sample(8) }
        \cup { [ZeroNltCxlRejectMessage EXCEPT !.accountNumber = one] : one \in Sample(10) }
        \cup { [ZeroNltCxlRejectMessage EXCEPT !.bookType = one] : one \in Sample(2) }
        \cup { [ZeroNltCxlRejectMessage EXCEPT !.buySellIndicator = one] : one \in Sample(2) }
        \cup { [ZeroNltCxlRejectMessage EXCEPT !.disclosedVolume = one] : one \in Sample(4) }
        \cup { [ZeroNltCxlRejectMessage EXCEPT !.disclosedVolumeRemaining = one] : one \in Sample(4) }
        \cup { [ZeroNltCxlRejectMessage EXCEPT !.totalVolumeRemaining = one] : one \in Sample(4) }
