        \cup { [ZeroNltCxlRejectMessage EXCEPT !.settlementPeriod = one] : one \in Sample(2) }
        \cup { [ZeroNltCxlRejectMessage EXCEPT !.additionalOrderFlags = one] : one \in Sample(1) }
