        \cup { [ZeroSpreadCxlRejectMessage EXCEPT !.filler1 = one] : one \in Sample(1) }
        \cup { [ZeroSpreadCxlRejectMessage EXCEPT !.competitorPeriod1 = one] : one \in Sample(2) }
