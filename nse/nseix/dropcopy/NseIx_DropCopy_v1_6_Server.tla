    { ZeroThrlOrderCxlConfirmationMessage }
        \cup { [ZeroThrlOrderCxlConfirmationMessage EXCEPT !.participantType1 = one] : one \in Sample(1) }
        \cup { [ZeroThrlOrderCxlConfirmationMessage EXCEPT !.filler1 = one] : one \in Sample(1) }
