        \cup { [ZeroNltCxlConfirmationMessage EXCEPT !.reserved4 = one] : one \in Sample(4) }
        \cup { [ZeroNltCxlConfirmationMessage EXCEPT !.tokenNo = one] : one \in Sample(4) }
        \cup { [ZeroNltCxlConfirmationMessage EXCEPT !.contractDesc = one] : one \in CheckedContractDesc25 }
        \cup { [ZeroNltCxlConfirmationMessage EXCEPT !.counterPartyBrokerId = one] : one \in Sample(5) }
        \cup { [ZeroNltCxlConfirmationMessage EXCEPT !.thirdReserved1 = one] : one \in Sample(1) }
