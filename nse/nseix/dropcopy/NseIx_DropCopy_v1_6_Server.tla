CheckedNltModRejectMessage ==
    { ZeroNltModRejectMessage }
        \cup { [ZeroNltModRejectMessage EXCEPT !.participantType = one] : one \in Sample(1) }
        \cup { [ZeroNltModRejectMessage EXCEPT !.reserved1 = one] : one \in Sample(1) }
        \cup { [ZeroNltModRejectMessage EXCEPT !.competitorPeriod = one] : one \in Sample(2) }
