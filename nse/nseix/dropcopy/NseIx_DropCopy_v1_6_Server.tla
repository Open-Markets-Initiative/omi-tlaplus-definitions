              [] tag = SpNetOrderErrorMessageCode -> DecodeSpNetOrderErrorMessage(bytes)
              [] tag = SpreadCxlConfirmationMessageCode -> DecodeSpreadCxlConfirmationMessage(bytes)
              [] tag = SpreadModConfirmationMessageCode -> DecodeSpreadModConfirmationMessage(bytes)
              [] tag = SpreadModRejectMessageCode -> DecodeSpreadModRejectMessage(bytes)
              [] tag = SpreadCxlRejectMessageCode -> DecodeSpreadCxlRejectMessage(bytes)
              [] tag = BatchSpreadOrderCancelMessageCode -> DecodeBatchSpreadOrderCancelMessage(bytes)
              [] tag = TwolOrderConfirmationMessageCode -> DecodeTwolOrderConfirmationMessage(bytes)
              [] tag = ThrlOrderConfirmationMessageCode -> DecodeThrlOrderConfirmationMessage(bytes)
              [] tag = TwolOrderErrorMessageCode -> DecodeTwolOrderErrorMessage(bytes)
              [] tag = ThrlOrderErrorMessageCode -> DecodeThrlOrderErrorMessage(bytes)
              [] tag = TwolNetOrderErrorMessageCode -> DecodeTwolNetOrderErrorMessage(bytes)
              [] tag = ThrlNetOrderErrorMessageCode -> DecodeThrlNetOrderErrorMessage(bytes)
              [] tag = TwolOrderCxlConfirmationMessageCode -> DecodeTwolOrderCxlConfirmationMessage(bytes)
              [] tag = ThrlOrderCxlConfirmationMessageCode -> DecodeThrlOrderCxlConfirmationMessage(bytes)
              [] OTHER -> Fail
    IN  IF ~read.ok THEN Fail ELSE Ok([tag |-> tag, body |-> read.value], read.rest)

ZeroServerMessagePayload == [tag |-> SignOnOutMessageCode, body |-> ZeroSignOnOutMessage]

(* Each Server Message Payload in turn, at the values the message it names is checked at *)
CheckedServerMessagePayload ==
    { [tag |-> SignOnOutMessageCode, body |-> one] : one \in CheckedSignOnOutMessage }
        \cup { [tag |-> TradeConfirmationMessageCode, body |-> one] : one \in CheckedTradeConfirmationMessage }
        \cup { [tag |-> TradeModifyConfirmMessageCode, body |-> one] : one \in CheckedTradeModifyConfirmMessage }
        \cup { [tag |-> TradeModifyRejectMessageCode, body |-> one] : one \in CheckedTradeModifyRejectMessage }
        \cup { [tag |-> TradeCancelConfirmMessageCode, body |-> one] : one \in CheckedTradeCancelConfirmMessage }
        \cup { [tag |-> TradeCancelRejectMessageCode, body |-> one] : one \in CheckedTradeCancelRejectMessage }
        \cup { [tag |-> NltTradeConfirmationMessageCode, body |-> one] : one \in CheckedNltTradeConfirmationMessage }
        \cup { [tag |-> NltTrdModConfirmationMessageCode, body |-> one] : one \in CheckedNltTrdModConfirmationMessage }
        \cup { [tag |-> NltTrdModRejectMessageCode, body |-> one] : one \in CheckedNltTrdModRejectMessage }
        \cup { [tag |-> NltTrdCxlConfirmationMessageCode, body |-> one] : one \in CheckedNltTrdCxlConfirmationMessage }
        \cup { [tag |-> NltTrdCxlRejectMessageCode, body |-> one] : one \in CheckedNltTrdCxlRejectMessage }
        \cup { [tag |-> GiveupAppConfirmTmMessageCode, body |-> one] : one \in CheckedGiveupAppConfirmTmMessage }
        \cup { [tag |-> GiveupRejConfirmTmMessageCode, body |-> one] : one \in CheckedGiveupRejConfirmTmMessage }
        \cup { [tag |-> BoardLotOutMessageCode, body |-> one] : one \in CheckedBoardLotOutMessage }
        \cup { [tag |-> OrderModOutMessageCode, body |-> one] : one \in CheckedOrderModOutMessage }
        \cup { [tag |-> OrderModRejectMessageCode, body |-> one] : one \in CheckedOrderModRejectMessage }
        \cup { [tag |-> OrderCancelOutMessageCode, body |-> one] : one \in CheckedOrderCancelOutMessage }
        \cup { [tag |-> OrderCancelRejectMessageCode, body |-> one] : one \in CheckedOrderCancelRejectMessage }
        \cup { [tag |-> OrderConfirmationMessageCode, body |-> one] : one \in CheckedOrderConfirmationMessage }
        \cup { [tag |-> OrderModConfirmationMessageCode, body |-> one] : one \in CheckedOrderModConfirmationMessage }
        \cup { [tag |-> OrderCancelConfirmationMessageCode, body |-> one] : one \in CheckedOrderCancelConfirmationMessage }
        \cup { [tag |-> FreezeToControlMessageCode, body |-> one] : one \in CheckedFreezeToControlMessage }
        \cup { [tag |-> OrderErrorMessageCode, body |-> one] : one \in CheckedOrderErrorMessage }
        \cup { [tag |-> BatchOrderCancelMessageCode, body |-> one] : one \in CheckedBatchOrderCancelMessage }
        \cup { [tag |-> NetOrderErrorMessageCode, body |-> one] : one \in CheckedNetOrderErrorMessage }
        \cup { [tag |-> NltConfirmationMessageCode, body |-> one] : one \in CheckedNltConfirmationMessage }
        \cup { [tag |-> NltModConfirmationMessageCode, body |-> one] : one \in CheckedNltModConfirmationMessage }
        \cup { [tag |-> NltCxlConfirmationMessageCode, body |-> one] : one \in CheckedNltCxlConfirmationMessage }
        \cup { [tag |-> NltModRejectMessageCode, body |-> one] : one \in CheckedNltModRejectMessage }
        \cup { [tag |-> NltCxlRejectMessageCode, body |-> one] : one \in CheckedNltCxlRejectMessage }
        \cup { [tag |-> SpreadOrderConfirmationMessageCode, body |-> one] : one \in CheckedSpreadOrderConfirmationMessage }
        \cup { [tag |-> SpOrderErrorMessageCode, body |-> one] : one \in CheckedSpOrderErrorMessage }
        \cup { [tag |-> SpNetOrderErrorMessageCode, body |-> one] : one \in CheckedSpNetOrderErrorMessage }
        \cup { [tag |-> SpreadCxlConfirmationMessageCode, body |-> one] : one \in CheckedSpreadCxlConfirmationMessage }
        \cup { [tag |-> SpreadModConfirmationMessageCode, body |-> one] : one \in CheckedSpreadModConfirmationMessage }
        \cup { [tag |-> SpreadModRejectMessageCode, body |-> one] : one \in CheckedSpreadModRejectMessage }
        \cup { [tag |-> SpreadCxlRejectMessageCode, body |-> one] : one \in CheckedSpreadCxlRejectMessage }
        \cup { [tag |-> BatchSpreadOrderCancelMessageCode, body |-> one] : one \in CheckedBatchSpreadOrderCancelMessage }
        \cup { [tag |-> TwolOrderConfirmationMessageCode, body |-> one] : one \in CheckedTwolOrderConfirmationMessage }
        \cup { [tag |-> ThrlOrderConfirmationMessageCode, body |-> one] : one \in CheckedThrlOrderConfirmationMessage }
        \cup { [tag |-> TwolOrderErrorMessageCode, body |-> one] : one \in CheckedTwolOrderErrorMessage }
        \cup { [tag |-> ThrlOrderErrorMessageCode, body |-> one] : one \in CheckedThrlOrderErrorMessage }
        \cup { [tag |-> TwolNetOrderErrorMessageCode, body |-> one] : one \in CheckedTwolNetOrderErrorMessage }
        \cup { [tag |-> ThrlNetOrderErrorMessageCode, body |-> one] : one \in CheckedThrlNetOrderErrorMessage }
        \cup { [tag |-> TwolOrderCxlConfirmationMessageCode, body |-> one] : one \in CheckedTwolOrderCxlConfirmationMessage }
        \cup { [tag |-> ThrlOrderCxlConfirmationMessageCode, body |-> one] : one \in CheckedThrlOrderCxlConfirmationMessage }

(***************************************************************************)
(* Server Direct Packet, framed by Packet Length                           *)
(***************************************************************************)

ServerDirectPacket ==
    [ packetSequenceNumber : Sample(4),
      checksum             : Sample(16),
      logTime              : Sample(4),
      alphaChar            : Sample(2),
      traderId             : Sample(4),
      errorCode            : Sample(2),
      headerTimestamp      : Sample(8),
      timeStamp1           : Sample(8),
      timeStamp2           : Sample(8),
      messageLength        : Sample(2),
      serverMessagePayload : ServerMessagePayload ]

EncodeServerDirectPacketBody(message) ==
    message.packetSequenceNumber
        \o message.checksum
        \o EncodeUIntBE(message.serverMessagePayload.tag, 2)
        \o message.logTime
        \o message.alphaChar
        \o message.traderId
        \o message.errorCode
        \o message.headerTimestamp
        \o message.timeStamp1
        \o message.timeStamp2
        \o message.messageLength
        \o EncodeServerMessagePayload(message.serverMessagePayload)

(* Packet Length counts the bytes it frames, so it is written from them *)
EncodeServerDirectPacket(message) ==
    LET body == EncodeServerDirectPacketBody(message)
    IN  EncodeUIntBE(Len(body) + 2, 2) \o body

DecodeServerDirectPacketBody(bytes) ==
    LET packetSequenceNumber == ReadBytes(bytes, 4) IN IF ~packetSequenceNumber.ok THEN Fail ELSE
    LET checksum == ReadBytes(packetSequenceNumber.rest, 16) IN IF ~checksum.ok THEN Fail ELSE
    LET transactionCode == ReadUIntBE(checksum.rest, 2) IN IF ~transactionCode.ok THEN Fail ELSE
    LET logTime == ReadBytes(transactionCode.rest, 4) IN IF ~logTime.ok THEN Fail ELSE
    LET alphaChar == ReadBytes(logTime.rest, 2) IN IF ~alphaChar.ok THEN Fail ELSE
    LET traderId == ReadBytes(alphaChar.rest, 4) IN IF ~traderId.ok THEN Fail ELSE
    LET errorCode == ReadBytes(traderId.rest, 2) IN IF ~errorCode.ok THEN Fail ELSE
    LET headerTimestamp == ReadBytes(errorCode.rest, 8) IN IF ~headerTimestamp.ok THEN Fail ELSE
    LET timeStamp1 == ReadBytes(headerTimestamp.rest, 8) IN IF ~timeStamp1.ok THEN Fail ELSE
    LET timeStamp2 == ReadBytes(timeStamp1.rest, 8) IN IF ~timeStamp2.ok THEN Fail ELSE
    LET messageLength == ReadBytes(timeStamp2.rest, 2) IN IF ~messageLength.ok THEN Fail ELSE
    LET serverMessagePayload == DecodeServerMessagePayload(transactionCode.value, messageLength.rest) IN IF ~serverMessagePayload.ok THEN Fail ELSE
    Ok([ packetSequenceNumber |-> packetSequenceNumber.value,
         checksum             |-> checksum.value,
         logTime              |-> logTime.value,
         alphaChar            |-> alphaChar.value,
         traderId             |-> traderId.value,
         errorCode            |-> errorCode.value,
         headerTimestamp      |-> headerTimestamp.value,
         timeStamp1           |-> timeStamp1.value,
         timeStamp2           |-> timeStamp2.value,
         messageLength        |-> messageLength.value,
         serverMessagePayload |-> serverMessagePayload.value ], serverMessagePayload.rest)

DecodeServerDirectPacket(bytes) ==
    LET length == ReadUIntBE(bytes, 2) IN IF ~length.ok THEN Fail ELSE
    LET size == length.value - 2 IN
    IF size < 0 \/ Len(length.rest) < size THEN Fail ELSE
    LET framed == SubSeq(length.rest, 1, size)
        beyond == SubSeq(length.rest, size + 1, Len(length.rest))
        body   == DecodeServerDirectPacketBody(framed)
    IN  IF ~body.ok \/ body.rest # << >> THEN Fail ELSE
    Ok(body.value, beyond)

ZeroServerDirectPacket ==
    [ packetSequenceNumber |-> [i \in 1 .. 4 |-> 0],
      checksum             |-> [i \in 1 .. 16 |-> 0],
      logTime              |-> [i \in 1 .. 4 |-> 0],
      alphaChar            |-> [i \in 1 .. 2 |-> 0],
      traderId             |-> [i \in 1 .. 4 |-> 0],
      errorCode            |-> [i \in 1 .. 2 |-> 0],
      headerTimestamp      |-> [i \in 1 .. 8 |-> 0],
      timeStamp1           |-> [i \in 1 .. 8 |-> 0],
      timeStamp2           |-> [i \in 1 .. 8 |-> 0],
      messageLength        |-> [i \in 1 .. 2 |-> 0],
      serverMessagePayload |-> ZeroServerMessagePayload ]

(* Server Direct Packet at zero, then each field in turn at the values it is checked at *)
CheckedServerDirectPacket ==
    { ZeroServerDirectPacket }
        \cup { [ZeroServerDirectPacket EXCEPT !.packetSequenceNumber = one] : one \in Sample(4) }
        \cup { [ZeroServerDirectPacket EXCEPT !.checksum = one] : one \in Sample(16) }
        \cup { [ZeroServerDirectPacket EXCEPT !.logTime = one] : one \in Sample(4) }
        \cup { [ZeroServerDirectPacket EXCEPT !.alphaChar = one] : one \in Sample(2) }
        \cup { [ZeroServerDirectPacket EXCEPT !.traderId = one] : one \in Sample(4) }
        \cup { [ZeroServerDirectPacket EXCEPT !.errorCode = one] : one \in Sample(2) }
        \cup { [ZeroServerDirectPacket EXCEPT !.headerTimestamp = one] : one \in Sample(8) }
        \cup { [ZeroServerDirectPacket EXCEPT !.timeStamp1 = one] : one \in Sample(8) }
        \cup { [ZeroServerDirectPacket EXCEPT !.timeStamp2 = one] : one \in Sample(8) }
        \cup { [ZeroServerDirectPacket EXCEPT !.messageLength = one] : one \in Sample(2) }
        \cup { [ZeroServerDirectPacket EXCEPT !.serverMessagePayload = one] : one \in CheckedServerMessagePayload }

(* A run of Server Direct Packet, written one after another *)
RECURSIVE EncodeServerDirectPacketList(_)
EncodeServerDirectPacketList(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeServerDirectPacket(Head(messages)) \o EncodeServerDirectPacketList(Tail(messages))

(* As many Server Direct Packet as the bytes hold, which is what its payload rule states. *)
(* Each one takes bytes off the reader, so the run ends where the data does. *)
RECURSIVE ReadServerDirectPacketAll(_)
ReadServerDirectPacketAll(bytes) ==
    IF bytes = << >>
    THEN Ok(<< >>, << >>)
    ELSE LET one == DecodeServerDirectPacket(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadServerDirectPacketAll(one.rest)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Server Direct Packet of each kind, for the lists that carry them *)
OneServerDirectPacket ==
    { [ZeroServerDirectPacket EXCEPT !.serverMessagePayload = [tag |-> SignOnOutMessageCode, body |-> ZeroSignOnOutMessage]],
      [ZeroServerDirectPacket EXCEPT !.serverMessagePayload = [tag |-> TradeConfirmationMessageCode, body |-> ZeroTradeConfirmationMessage]],
      [ZeroServerDirectPacket EXCEPT !.serverMessagePayload = [tag |-> TradeModifyConfirmMessageCode, body |-> ZeroTradeModifyConfirmMessage]],
      [ZeroServerDirectPacket EXCEPT !.serverMessagePayload = [tag |-> TradeModifyRejectMessageCode, body |-> ZeroTradeModifyRejectMessage]],
      [ZeroServerDirectPacket EXCEPT !.serverMessagePayload = [tag |-> TradeCancelConfirmMessageCode, body |-> ZeroTradeCancelConfirmMessage]],
      [ZeroServerDirectPacket EXCEPT !.serverMessagePayload = [tag |-> TradeCancelRejectMessageCode, body |-> ZeroTradeCancelRejectMessage]],
      [ZeroServerDirectPacket EXCEPT !.serverMessagePayload = [tag |-> NltTradeConfirmationMessageCode, body |-> ZeroNltTradeConfirmationMessage]],
      [ZeroServerDirectPacket EXCEPT !.serverMessagePayload = [tag |-> NltTrdModConfirmationMessageCode, body |-> ZeroNltTrdModConfirmationMessage]],
      [ZeroServerDirectPacket EXCEPT !.serverMessagePayload = [tag |-> NltTrdModRejectMessageCode, body |-> ZeroNltTrdModRejectMessage]],
      [ZeroServerDirectPacket EXCEPT !.serverMessagePayload = [tag |-> NltTrdCxlConfirmationMessageCode, body |-> ZeroNltTrdCxlConfirmationMessage]],
      [ZeroServerDirectPacket EXCEPT !.serverMessagePayload = [tag |-> NltTrdCxlRejectMessageCode, body |-> ZeroNltTrdCxlRejectMessage]],
      [ZeroServerDirectPacket EXCEPT !.serverMessagePayload = [tag |-> GiveupAppConfirmTmMessageCode, body |-> ZeroGiveupAppConfirmTmMessage]],
      [ZeroServerDirectPacket EXCEPT !.serverMessagePayload = [tag |-> GiveupRejConfirmTmMessageCode, body |-> ZeroGiveupRejConfirmTmMessage]],
      [ZeroServerDirectPacket EXCEPT !.serverMessagePayload = [tag |-> BoardLotOutMessageCode, body |-> ZeroBoardLotOutMessage]],
      [ZeroServerDirectPacket EXCEPT !.serverMessagePayload = [tag |-> OrderModOutMessageCode, body |-> ZeroOrderModOutMessage]],
      [ZeroServerDirectPacket EXCEPT !.serverMessagePayload = [tag |-> OrderModRejectMessageCode, body |-> ZeroOrderModRejectMessage]],
      [ZeroServerDirectPacket EXCEPT !.serverMessagePayload = [tag |-> OrderCancelOutMessageCode, body |-> ZeroOrderCancelOutMessage]],
      [ZeroServerDirectPacket EXCEPT !.serverMessagePayload = [tag |-> OrderCancelRejectMessageCode, body |-> ZeroOrderCancelRejectMessage]],
      [ZeroServerDirectPacket EXCEPT !.serverMessagePayload = [tag |-> OrderConfirmationMessageCode, body |-> ZeroOrderConfirmationMessage]],
      [ZeroServerDirectPacket EXCEPT !.serverMessagePayload = [tag |-> OrderModConfirmationMessageCode, body |-> ZeroOrderModConfirmationMessage]],
      [ZeroServerDirectPacket EXCEPT !.serverMessagePayload = [tag |-> OrderCancelConfirmationMessageCode, body |-> ZeroOrderCancelConfirmationMessage]],
      [ZeroServerDirectPacket EXCEPT !.serverMessagePayload = [tag |-> FreezeToControlMessageCode, body |-> ZeroFreezeToControlMessage]],
      [ZeroServerDirectPacket EXCEPT !.serverMessagePayload = [tag |-> OrderErrorMessageCode, body |-> ZeroOrderErrorMessage]],
      [ZeroServerDirectPacket EXCEPT !.serverMessagePayload = [tag |-> BatchOrderCancelMessageCode, body |-> ZeroBatchOrderCancelMessage]],
      [ZeroServerDirectPacket EXCEPT !.serverMessagePayload = [tag |-> NetOrderErrorMessageCode, body |-> ZeroNetOrderErrorMessage]],
      [ZeroServerDirectPacket EXCEPT !.serverMessagePayload = [tag |-> NltConfirmationMessageCode, body |-> ZeroNltConfirmationMessage]],
      [ZeroServerDirectPacket EXCEPT !.serverMessagePayload = [tag |-> NltModConfirmationMessageCode, body |-> ZeroNltModConfirmationMessage]],
      [ZeroServerDirectPacket EXCEPT !.serverMessagePayload = [tag |-> NltCxlConfirmationMessageCode, body |-> ZeroNltCxlConfirmationMessage]],
      [ZeroServerDirectPacket EXCEPT !.serverMessagePayload = [tag |-> NltModRejectMessageCode, body |-> ZeroNltModRejectMessage]],
      [ZeroServerDirectPacket EXCEPT !.serverMessagePayload = [tag |-> NltCxlRejectMessageCode, body |-> ZeroNltCxlRejectMessage]],
      [ZeroServerDirectPacket EXCEPT !.serverMessagePayload = [tag |-> SpreadOrderConfirmationMessageCode, body |-> ZeroSpreadOrderConfirmationMessage]],
      [ZeroServerDirectPacket EXCEPT !.serverMessagePayload = [tag |-> SpOrderErrorMessageCode, body |-> ZeroSpOrderErrorMessage]],
      [ZeroServerDirectPacket EXCEPT !.serverMessagePayload = [tag |-> SpNetOrderErrorMessageCode, body |-> ZeroSpNetOrderErrorMessage]],
      [ZeroServerDirectPacket EXCEPT !.serverMessagePayload = [tag |-> SpreadCxlConfirmationMessageCode, body |-> ZeroSpreadCxlConfirmationMessage]],
      [ZeroServerDirectPacket EXCEPT !.serverMessagePayload = [tag |-> SpreadModConfirmationMessageCode, body |-> ZeroSpreadModConfirmationMessage]],
      [ZeroServerDirectPacket EXCEPT !.serverMessagePayload = [tag |-> SpreadModRejectMessageCode, body |-> ZeroSpreadModRejectMessage]],
      [ZeroServerDirectPacket EXCEPT !.serverMessagePayload = [tag |-> SpreadCxlRejectMessageCode, body |-> ZeroSpreadCxlRejectMessage]],
      [ZeroServerDirectPacket EXCEPT !.serverMessagePayload = [tag |-> BatchSpreadOrderCancelMessageCode, body |-> ZeroBatchSpreadOrderCancelMessage]],
      [ZeroServerDirectPacket EXCEPT !.serverMessagePayload = [tag |-> TwolOrderConfirmationMessageCode, body |-> ZeroTwolOrderConfirmationMessage]],
      [ZeroServerDirectPacket EXCEPT !.serverMessagePayload = [tag |-> ThrlOrderConfirmationMessageCode, body |-> ZeroThrlOrderConfirmationMessage]],
      [ZeroServerDirectPacket EXCEPT !.serverMessagePayload = [tag |-> TwolOrderErrorMessageCode, body |-> ZeroTwolOrderErrorMessage]],
      [ZeroServerDirectPacket EXCEPT !.serverMessagePayload = [tag |-> ThrlOrderErrorMessageCode, body |-> ZeroThrlOrderErrorMessage]],
      [ZeroServerDirectPacket EXCEPT !.serverMessagePayload = [tag |-> TwolNetOrderErrorMessageCode, body |-> ZeroTwolNetOrderErrorMessage]],
      [ZeroServerDirectPacket EXCEPT !.serverMessagePayload = [tag |-> ThrlNetOrderErrorMessageCode, body |-> ZeroThrlNetOrderErrorMessage]],
      [ZeroServerDirectPacket EXCEPT !.serverMessagePayload = [tag |-> TwolOrderCxlConfirmationMessageCode, body |-> ZeroTwolOrderCxlConfirmationMessage]],
      [ZeroServerDirectPacket EXCEPT !.serverMessagePayload = [tag |-> ThrlOrderCxlConfirmationMessageCode, body |-> ZeroThrlOrderCxlConfirmationMessage]] }

(***************************************************************************)
(* Server Packet                                                           *)
(***************************************************************************)

ServerPacket ==
    [ serverDirectPacket : SampleLists(OneServerDirectPacket) ]

EncodeServerPacket(message) ==
    EncodeServerDirectPacketList(message.serverDirectPacket)

DecodeServerPacket(bytes) ==
    LET serverDirectPacket == ReadServerDirectPacketAll(bytes) IN IF ~serverDirectPacket.ok THEN Fail ELSE
    Ok([ serverDirectPacket |-> serverDirectPacket.value ], serverDirectPacket.rest)

ZeroServerPacket ==
    [ serverDirectPacket |-> << >> ]

(* Server Packet at zero, then each field in turn at the values it is checked at *)
CheckedServerPacket ==
    { ZeroServerPacket }
        \cup { [ZeroServerPacket EXCEPT !.serverDirectPacket = one] : one \in SampleLists(OneServerDirectPacket) }

(***************************************************************************)
(* What TLC checks                                                         *)
(***************************************************************************)

(* An integer a rule depends on writes its width and reads back what was written *)
RoundTripUIntLE ==
    \A width \in 1 .. 3 :
        \A value \in {0, 1, 255, 256, 65535} :
            (value < 256 ^ width) =>
                /\ Len(EncodeUIntLE(value, width)) = width
                /\ DecodeUIntLE(EncodeUIntLE(value, width)) = value
                /\ Len(EncodeUIntBE(value, width)) = width
                /\ DecodeUIntBE(EncodeUIntBE(value, width)) = value
                /\ \A i \in 1 .. width : EncodeUIntLE(value, width)[i] \in Byte
                /\ \A i \in 1 .. width : EncodeUIntBE(value, width)[i] \in Byte

(* Every Sign On Out Message decodes back to what was encoded, and leaves nothing over *)
RoundTripSignOnOutMessage ==
    \A message \in CheckedSignOnOutMessage :
        LET read == DecodeSignOnOutMessage(EncodeSignOnOutMessage(message))
        IN  /\ read.ok
            /\ read.value = message
            /\ read.rest = << >>

(* Every Contract Desc decodes back to what was encoded, and leaves nothing over *)
RoundTripContractDesc ==
    \A message \in CheckedContractDesc :
        LET read == DecodeContractDesc(EncodeContractDesc(message))
        IN  /\ read.ok
            /\ read.value = message
            /\ read.rest = << >>

(* Every Trade Confirmation Message decodes back to what was encoded, and leaves nothing over *)
RoundTripTradeConfirmationMessage ==
    \A message \in CheckedTradeConfirmationMessage :
        LET read == DecodeTradeConfirmationMessage(EncodeTradeConfirmationMessage(message))
        IN  /\ read.ok
            /\ read.value = message
            /\ read.rest = << >>

