        \cup { [ZeroNltConfirmationMessage EXCEPT !.participantType = one] : one \in Sample(1) }
        \cup { [ZeroNltConfirmationMessage EXCEPT !.reserved1 = one] : one \in Sample(1) }
        \cup { [ZeroNltConfirmationMessage EXCEPT !.competitorPeriod = one] : one \in Sample(2) }
