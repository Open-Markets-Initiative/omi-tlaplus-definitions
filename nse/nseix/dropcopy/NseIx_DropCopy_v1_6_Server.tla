        \cup { [ZeroContractDesc50 EXCEPT !.instrumentName = one] : one \in Sample(6) }
        \cup { [ZeroContractDesc50 EXCEPT !.symbol = one] : one \in Sample(10) }
        \cup { [ZeroContractDesc50 EXCEPT !.expiryDate = one] : one \in Sample(4) }
        \cup { [ZeroContractDesc50 EXCEPT !.strikePrice = one] : one \in Sample(4) }
