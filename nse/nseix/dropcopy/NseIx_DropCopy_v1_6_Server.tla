        \cup { [ZeroNltCxlRejectMessage EXCEPT !.stOrderFlags = one] : one \in Sample(2) }
        \cup { [ZeroNltCxlRejectMessage EXCEPT !.branchId = one] : one \in Sample(2) }
        \cup { [ZeroNltCxlRejectMessage EXCEPT !.traderId = one] : one \in Sample(4) }
        \cup { [ZeroNltCxlRejectMessage EXCEPT !.brokerId = one] : one \in Sample(5) }
        \cup { [ZeroNltCxlRejectMessage EXCEPT !.cOrdFiller = one] : one \in Sample(24) }
