        \cup { [ZeroFreezeToControlMessage EXCEPT !.giveupFlag = one] : one \in Sample(1) }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.reference = one] : one \in Sample(4) }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.nnfField = one] : one \in Sample(8) }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.mktReplay = one] : one \in Sample(8) }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.echoBack = one] : one \in Sample(16) }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.lastActivityReference = one] : one \in Sample(8) }
        \cup { [ZeroFreezeToControlMessage EXCEPT !.reserved52 = one] : one \in Sample(52) }

(***************************************************************************)
