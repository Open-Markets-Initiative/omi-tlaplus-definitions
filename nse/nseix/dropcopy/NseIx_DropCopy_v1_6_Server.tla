ContractDesc53 ==
    [ instrumentName : Sample(6),
      symbol         : Sample(10),
      expiryDate     : Sample(4),
      strikePrice    : Sample(4),
      optionType     : Sample(2),
      caLevel        : Sample(2) ]

EncodeContractDesc53(message) ==
    message.instrumentName
        \o message.symbol
        \o message.expiryDate
        \o message.strikePrice
        \o message.optionType
        \o message.caLevel

DecodeContractDesc53(bytes) ==
