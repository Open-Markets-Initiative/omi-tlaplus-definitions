        \cup { [ZeroSpreadCxlConfirmationMessage EXCEPT !.participantType1 = one] : one \in Sample(1) }
        \cup { [ZeroSpreadCxlConfirmationMessage EXCEPT !.filler1 = one] : one \in Sample(1) }
