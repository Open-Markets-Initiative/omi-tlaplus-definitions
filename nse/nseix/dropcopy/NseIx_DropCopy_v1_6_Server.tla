ZeroTradeModifyRejectMessage ==
    [ responseOrderNumber   |-> [i \in 1 .. 8 |-> 0],
      brokerId              |-> [i \in 1 .. 5 |-> 0],
      reserved1             |-> [i \in 1 .. 1 |-> 0],
      traderNum             |-> [i \in 1 .. 4 |-> 0],
