        \cup { [ZeroMsSpdLegInfoLeg313 EXCEPT !.totalVolRemaining2 = one] : one \in Sample(4) }
        \cup { [ZeroMsSpdLegInfoLeg313 EXCEPT !.volume2 = one] : one \in Sample(4) }
        \cup { [ZeroMsSpdLegInfoLeg313 EXCEPT !.volumeFilledToday2 = one] : one \in Sample(4) }
        \cup { [ZeroMsSpdLegInfoLeg313 EXCEPT !.price2 = one] : one \in Sample(4) }
        \cup { [ZeroMsSpdLegInfoLeg313 EXCEPT !.triggerPrice2 = one] : one \in Sample(4) }
        \cup { [ZeroMsSpdLegInfoLeg313 EXCEPT !.minFillAon2 = one] : one \in Sample(4) }
        \cup { [ZeroMsSpdLegInfoLeg313 EXCEPT !.stOrderFlags = one] : one \in Sample(2) }
        \cup { [ZeroMsSpdLegInfoLeg313 EXCEPT !.openClose2 = one] : one \in Sample(1) }
        \cup { [ZeroMsSpdLegInfoLeg313 EXCEPT !.additionalOrderFlags = one] : one \in Sample(1) }
        \cup { [ZeroMsSpdLegInfoLeg313 EXCEPT !.giveupFlag2 = one] : one \in Sample(1) }
        \cup { [ZeroMsSpdLegInfoLeg313 EXCEPT !.fillerY = one] : one \in Sample(1) }

