      totalVolumeRemaining     |-> [i \in 1 .. 4 |-> 0],
      volume                   |-> [i \in 1 .. 4 |-> 0],
      volumeFilledToday        |-> [i \in 1 .. 4 |-> 0],
      price                    |-> [i \in 1 .. 4 |-> 0],
      triggerPrice             |-> [i \in 1 .. 4 |-> 0],
      goodTillDate             |-> [i \in 1 .. 4 |-> 0],
      entryDateTime            |-> [i \in 1 .. 4 |-> 0],
      minimumFillAonVolume     |-> [i \in 1 .. 4 |-> 0],
      lastModified             |-> [i \in 1 .. 4 |-> 0],
      stOrderFlags             |-> [i \in 1 .. 2 |-> 0],
      branchId                 |-> [i \in 1 .. 2 |-> 0],
      traderId                 |-> [i \in 1 .. 4 |-> 0],
      brokerId                 |-> [i \in 1 .. 5 |-> 0],
      cOrdFiller               |-> [i \in 1 .. 24 |-> 0],
      openClose                |-> [i \in 1 .. 1 |-> 0],
      settlor                  |-> [i \in 1 .. 12 |-> 0],
      proClientIndicator       |-> [i \in 1 .. 2 |-> 0],
      settlementPeriod         |-> [i \in 1 .. 2 |-> 0],
      additionalOrderFlags     |-> [i \in 1 .. 1 |-> 0],
      giveupFlag               |-> [i \in 1 .. 1 |-> 0],
      reference                |-> [i \in 1 .. 4 |-> 0],
      nnfField                 |-> [i \in 1 .. 8 |-> 0],
      mktReplay                |-> [i \in 1 .. 8 |-> 0],
      echoBack                 |-> [i \in 1 .. 16 |-> 0],
      lastActivityReference    |-> [i \in 1 .. 8 |-> 0],
      reserved52               |-> [i \in 1 .. 52 |-> 0] ]

(* Nlt Cxl Reject Message at zero, then each field in turn at the values it is checked at *)
CheckedNltCxlRejectMessage ==
    { ZeroNltCxlRejectMessage }
        \cup { [ZeroNltCxlRejectMessage EXCEPT !.participantType = one] : one \in Sample(1) }
        \cup { [ZeroNltCxlRejectMessage EXCEPT !.reserved1 = one] : one \in Sample(1) }
        \cup { [ZeroNltCxlRejectMessage EXCEPT !.competitorPeriod = one] : one \in Sample(2) }
        \cup { [ZeroNltCxlRejectMessage EXCEPT !.solicitorPeriod = one] : one \in Sample(2) }
        \cup { [ZeroNltCxlRejectMessage EXCEPT !.modifiedCancelledBy = one] : one \in Sample(1) }
        \cup { [ZeroNltCxlRejectMessage EXCEPT !.secondReserved1 = one] : one \in Sample(1) }
        \cup { [ZeroNltCxlRejectMessage EXCEPT !.reasonCode = one] : one \in Sample(2) }
        \cup { [ZeroNltCxlRejectMessage EXCEPT !.reserved4 = one] : one \in Sample(4) }
        \cup { [ZeroNltCxlRejectMessage EXCEPT !.tokenNo = one] : one \in Sample(4) }
        \cup { [ZeroNltCxlRejectMessage EXCEPT !.contractDesc = one] : one \in CheckedContractDesc27 }
        \cup { [ZeroNltCxlRejectMessage EXCEPT !.counterPartyBrokerId = one] : one \in Sample(5) }
        \cup { [ZeroNltCxlRejectMessage EXCEPT !.thirdReserved1 = one] : one \in Sample(1) }
