        \cup { [ZeroNltConfirmationMessage EXCEPT !.disclosedVolume = one] : one \in Sample(4) }
        \cup { [ZeroNltConfirmationMessage EXCEPT !.disclosedVolumeRemaining = one] : one \in Sample(4) }
        \cup { [ZeroNltConfirmationMessage EXCEPT !.totalVolumeRemaining = one] : one \in Sample(4) }
        \cup { [ZeroNltConfirmationMessage EXCEPT !.volume = one] : one \in Sample(4) }
