        \cup { [ZeroMsSpdLegInfoLeg316 EXCEPT !.token2 = one] : one \in Sample(4) }
        \cup { [ZeroMsSpdLegInfoLeg316 EXCEPT !.contractDesc = one] : one \in CheckedContractDesc75 }
