        \cup [ tag : {TwolOrderCxlConfirmationMessageCode}, body : TwolOrderCxlConfirmationMessage ]
        \cup [ tag : {ThrlOrderCxlConfirmationMessageCode}, body : ThrlOrderCxlConfirmationMessage ]

