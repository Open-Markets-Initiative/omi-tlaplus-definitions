CheckedNltTrdCxlRejectMessage ==
    { ZeroNltTrdCxlRejectMessage }
        \cup { [ZeroNltTrdCxlRejectMessage EXCEPT !.responseOrderNumber = one] : one \in Sample(8) }
        \cup { [ZeroNltTrdCxlRejectMessage EXCEPT !.brokerId = one] : one \in Sample(5) }
