        \cup { [ZeroTwolOrderCxlConfirmationMessage EXCEPT !.orderNumber1 = one] : one \in Sample(8) }
        \cup { [ZeroTwolOrderCxlConfirmationMessage EXCEPT !.accountNumber1 = one] : one \in Sample(10) }
