CheckedMsSpdLegInfoLeg36 ==
    { ZeroMsSpdLegInfoLeg36 }
        \cup { [ZeroMsSpdLegInfoLeg36 EXCEPT !.token2 = one] : one \in Sample(4) }
        \cup { [ZeroMsSpdLegInfoLeg36 EXCEPT !.contractDesc = one] : one \in CheckedContractDesc45 }
