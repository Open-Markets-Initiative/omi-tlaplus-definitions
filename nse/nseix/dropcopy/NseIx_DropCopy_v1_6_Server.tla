        \cup { [ZeroNltCxlConfirmationMessage EXCEPT !.orderNumber = one] : one \in Sample(8) }
        \cup { [ZeroNltCxlConfirmationMessage EXCEPT !.accountNumber = one] : one \in Sample(10) }
        \cup { [ZeroNltCxlConfirmationMessage EXCEPT !.bookType = one] : one \in Sample(2) }
