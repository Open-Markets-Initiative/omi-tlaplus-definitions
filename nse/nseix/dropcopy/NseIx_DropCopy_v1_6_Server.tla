    message.responseOrderNumber
        \o message.brokerId
        \o message.reserved1
        \o message.traderNum
        \o message.accountNum
        \o message.buySell
        \o message.originalVol
        \o message.disclosedVol
        \o message.remainingVol
        \o message.disclosedVolRemaining
        \o message.price
        \o message.stOrderFlags
        \o message.gtd
        \o message.fillNumber
        \o message.fillQty
        \o message.fillPrice
