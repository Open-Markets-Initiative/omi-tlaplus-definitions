(* Twol Order Cxl Confirmation Message at zero, then each field in turn at the values it is checked at *)
CheckedTwolOrderCxlConfirmationMessage ==
    { ZeroTwolOrderCxlConfirmationMessage }
        \cup { [ZeroTwolOrderCxlConfirmationMessage EXCEPT !.participantType1 = one] : one \in Sample(1) }
        \cup { [ZeroTwolOrderCxlConfirmationMessage EXCEPT !.filler1 = one] : one \in Sample(1) }
        \cup { [ZeroTwolOrderCxlConfirmationMessage EXCEPT !.competitorPeriod1 = one] : one \in Sample(2) }
