Captures == { CancelOrderMessageCapture, CancelOrderRejectMessageCapture, LastExecIdMessageCapture, LastExecIdRequestMessageCapture, LoggedOutMessageCapture, LogonConfMessageCapture, LogonMessageCapture, LogoutMessageCapture, MassCancelOrderAckMessageCapture, MassCancelOrderMessageCapture, MassCancelOrderRejectMessageCapture, NewOrderMessageCapture, OrderCanceledMessageCapture, OrderEnteredMessageCapture, OrderFilledMessageCapture, OrderRejectMessageCapture, OrderReplacedMessageCapture, PingMessageCapture, PongMessageCapture, ReplaceOrderMessageCapture, SetAccountMessageCapture, SetAckMessageCapture, SetTraderMessageCapture, StreamOrderMessageCapture, UnlockTradingAckMessageCapture, UnlockTradingMessageCapture }

(* Every recorded packet reads, reads whole, and writes back unchanged *)
CapturesRoundTrip ==
    \A bytes \in Captures :
        LET read == DecodePacket(bytes)
        IN  /\ read.ok
            /\ read.rest = << >>
            /\ EncodePacket(read.value) = bytes

(* Every recorded packet is bytes *)
CapturesAreBytes == \A bytes \in Captures : \A i \in 1 .. Len(bytes) : bytes[i] \in Byte

