        settled75 == [settled74 EXCEPT !.comboOrder = IF settled74.numberOfReturnBitfields >= 16 /\ (settled74.orderAcknowledgmentReturnBitfield16 # << >> /\ (settled74.orderAcknowledgmentReturnBitfield16[1] \div 4) % 2 > 0) THEN (IF settled74.comboOrder = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled74.comboOrder) ELSE << >>]
        settled76 == [settled75 EXCEPT !.compression = IF settled75.numberOfReturnBitfields >= 16 /\ (settled75.orderAcknowledgmentReturnBitfield16 # << >> /\ (settled75.orderAcknowledgmentReturnBitfield16[1] \div 8) % 2 > 0) THEN (IF settled75.compression = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled75.compression) ELSE << >>]
        settled77 == [settled76 EXCEPT !.floorDestination = IF settled76.numberOfReturnBitfields >= 16 /\ (settled76.orderAcknowledgmentReturnBitfield16 # << >> /\ (settled76.orderAcknowledgmentReturnBitfield16[1] \div 16) % 2 > 0) THEN (IF settled76.floorDestination = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled76.floorDestination) ELSE << >>]
        settled78 == [settled77 EXCEPT !.floorRoutingInst = IF settled77.numberOfReturnBitfields >= 16 /\ (settled77.orderAcknowledgmentReturnBitfield16 # << >> /\ (settled77.orderAcknowledgmentReturnBitfield16[1] \div 32) % 2 > 0) THEN (IF settled77.floorRoutingInst = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled77.floorRoutingInst) ELSE << >>]
        settled79 == [settled78 EXCEPT !.multiClassSprd = IF settled78.numberOfReturnBitfields >= 16 /\ (settled78.orderAcknowledgmentReturnBitfield16 # << >> /\ (settled78.orderAcknowledgmentReturnBitfield16[1] \div 64) % 2 > 0) THEN (IF settled78.multiClassSprd = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled78.multiClassSprd) ELSE << >>]
        settled80 == [settled79 EXCEPT !.orderOrigin = IF settled79.numberOfReturnBitfields >= 16 /\ (settled79.orderAcknowledgmentReturnBitfield16 # << >> /\ (settled79.orderAcknowledgmentReturnBitfield16[1] \div 128) % 2 > 0) THEN (IF settled79.orderOrigin = << >> THEN <<[i \in 1 .. 3 |-> 0]>> ELSE settled79.orderOrigin) ELSE << >>]
        settled81 == [settled80 EXCEPT !.priceType = IF settled80.numberOfReturnBitfields >= 17 /\ (settled80.orderAcknowledgmentReturnBitfield17 # << >> /\ settled80.orderAcknowledgmentReturnBitfield17[1] % 2 > 0) THEN (IF settled80.priceType = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled80.priceType) ELSE << >>]
        settled82 == [settled81 EXCEPT !.strategyId = IF settled81.numberOfReturnBitfields >= 17 /\ (settled81.orderAcknowledgmentReturnBitfield17 # << >> /\ (settled81.orderAcknowledgmentReturnBitfield17[1] \div 2) % 2 > 0) THEN (IF settled81.strategyId = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled81.strategyId) ELSE << >>]
        settled83 == [settled82 EXCEPT !.crossInitiator = IF settled82.numberOfReturnBitfields >= 18 /\ (settled82.orderAcknowledgmentReturnBitfield18 # << >> /\ (settled82.orderAcknowledgmentReturnBitfield18[1] \div 2) % 2 > 0) THEN (IF settled82.crossInitiator = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled82.crossInitiator) ELSE << >>]
        settled84 == [settled83 EXCEPT !.held = IF settled83.numberOfReturnBitfields >= 18 /\ (settled83.orderAcknowledgmentReturnBitfield18 # << >> /\ (settled83.orderAcknowledgmentReturnBitfield18[1] \div 32) % 2 > 0) THEN (IF settled83.held = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled83.held) ELSE << >>]
        settled85 == [settled84 EXCEPT !.crossOnBehalfOfId = IF settled84.numberOfReturnBitfields >= 19 /\ (settled84.orderAcknowledgmentReturnBitfield19 # << >> /\ (settled84.orderAcknowledgmentReturnBitfield19[1] \div 4) % 2 > 0) THEN (IF settled84.crossOnBehalfOfId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled84.crossOnBehalfOfId) ELSE << >>]
        settled86 == [settled85 EXCEPT !.stopPxType = IF settled85.numberOfReturnBitfields >= 19 /\ (settled85.orderAcknowledgmentReturnBitfield19 # << >> /\ (settled85.orderAcknowledgmentReturnBitfield19[1] \div 64) % 2 > 0) THEN (IF settled85.stopPxType = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled85.stopPxType) ELSE << >>]
    IN  settled86

ZeroOrderAcknowledgmentMessage ==
    SettleOrderAcknowledgmentMessage([ transactionTime                     |-> [i \in 1 .. 8 |-> 0],
                                       clOrdId                             |-> [i \in 1 .. 20 |-> 0],
                                       orderId                             |-> [i \in 1 .. 8 |-> 0],
                                       reserved1                           |-> [i \in 1 .. 1 |-> 0],
                                       numberOfReturnBitf                  |-> [i \in 1 .. 1 |-> 0],
                                       numberOfReturnBitfields             |-> 0,
                                       orderAcknowledgmentReturnBitfield1  |-> << >>,
                                       orderAcknowledgmentReturnBitfield2  |-> << >>,
                                       orderAcknowledgmentReturnBitfield3  |-> << >>,
                                       orderAcknowledgmentReturnBitfield4  |-> << >>,
                                       orderAcknowledgmentReturnBitfield5  |-> << >>,
                                       orderAcknowledgmentReturnBitfield6  |-> << >>,
                                       orderAcknowledgmentReturnBitfield7  |-> << >>,
                                       orderAcknowledgmentReturnBitfield8  |-> << >>,
                                       orderAcknowledgmentReturnBitfield9  |-> << >>,
                                       orderAcknowledgmentReturnBitfield10 |-> << >>,
                                       orderAcknowledgmentReturnBitfield11 |-> << >>,
                                       orderAcknowledgmentReturnBitfield12 |-> << >>,
                                       orderAcknowledgmentReturnBitfield13 |-> << >>,
                                       orderAcknowledgmentReturnBitfield14 |-> << >>,
                                       orderAcknowledgmentReturnBitfield15 |-> << >>,
                                       orderAcknowledgmentReturnBitfield16 |-> << >>,
                                       orderAcknowledgmentReturnBitfield17 |-> << >>,
                                       orderAcknowledgmentReturnBitfield18 |-> << >>,
                                       orderAcknowledgmentReturnBitfield19 |-> << >>,
                                       orderAcknowledgmentReturnBitfield20 |-> << >>,
                                       orderAcknowledgmentReturnBitfield21 |-> << >>,
                                       side                                |-> << >>,
                                       priceLong                           |-> << >>,
                                       execInst                            |-> << >>,
                                       ordType                             |-> << >>,
                                       timeInForce                         |-> << >>,
                                       minQty                              |-> << >>,
                                       symbolLong                          |-> << >>,
                                       capacity                            |-> << >>,
                                       account                             |-> << >>,
                                       clearingFirm                        |-> << >>,
                                       clearingAccount                     |-> << >>,
                                       displayIndicator                    |-> << >>,
                                       maxFloor                            |-> << >>,
                                       orderQtyLong                        |-> << >>,
                                       preventMatch                        |-> << >>,
                                       maturityDate                        |-> << >>,
                                       strikePrice                         |-> << >>,
                                       putOrCall                           |-> << >>,
                                       openClose                           |-> << >>,
                                       correctedSize                       |-> << >>,
                                       origClOrdId                         |-> << >>,
                                       leavesQty                           |-> << >>,
                                       lastShares                          |-> << >>,
                                       lastPx                              |-> << >>,
                                       displayPrice                        |-> << >>,
                                       workingPrice                        |-> << >>,
                                       baseLiquidityIndicator              |-> << >>,
                                       expireTime                          |-> << >>,
                                       secondaryOrderId                    |-> << >>,
                                       contraCapacity                      |-> << >>,
                                       attributedQuote                     |-> << >>,
                                       subLiquidityIndicator               |-> << >>,
                                       echoText                            |-> << >>,
                                       stopPx                              |-> << >>,
                                       routingInst                         |-> << >>,
                                       routStrategy                        |-> << >>,
                                       routeDeliveryMethod                 |-> << >>,
                                       exDestination                       |-> << >>,
                                       marketingFeeCode                    |-> << >>,
                                       targetPartyId                       |-> << >>,
                                       auctionId                           |-> << >>,
                                       cmtaNumber                          |-> << >>,
                                       crossId                             |-> << >>,
                                       allocQty                            |-> << >>,
                                       giveUpFirmId                        |-> << >>,
                                       routingFirmId                       |-> << >>,
                                       crossExclusionIndicator             |-> << >>,
                                       clearingOptionalData                |-> << >>,
                                       drillThruProtection                 |-> << >>,
                                       equityPartyId                       |-> << >>,
                                       clientIdAttr                        |-> << >>,
                                       frequentTraderId                    |-> << >>,
                                       sessionEligibility                  |-> << >>,
                                       comboOrder                          |-> << >>,
                                       compression                         |-> << >>,
                                       floorDestination                    |-> << >>,
                                       floorRoutingInst                    |-> << >>,
                                       multiClassSprd                      |-> << >>,
                                       orderOrigin                         |-> << >>,
                                       priceType                           |-> << >>,
                                       strategyId                          |-> << >>,
                                       crossInitiator                      |-> << >>,
                                       held                                |-> << >>,
                                       crossOnBehalfOfId                   |-> << >>,
                                       stopPxType                          |-> << >> ])

(* Order Acknowledgment Message at zero, then each field in turn at the values it is checked at *)
CheckedOrderAcknowledgmentMessage ==
    { ZeroOrderAcknowledgmentMessage }
        \cup { SettleOrderAcknowledgmentMessage([ZeroOrderAcknowledgmentMessage EXCEPT !.transactionTime = one]) : one \in Sample(8) }
        \cup { SettleOrderAcknowledgmentMessage([ZeroOrderAcknowledgmentMessage EXCEPT !.clOrdId = one]) : one \in Sample(20) }
        \cup { SettleOrderAcknowledgmentMessage([ZeroOrderAcknowledgmentMessage EXCEPT !.orderId = one]) : one \in Sample(8) }
        \cup { SettleOrderAcknowledgmentMessage([ZeroOrderAcknowledgmentMessage EXCEPT !.reserved1 = one]) : one \in Sample(1) }
        \cup { SettleOrderAcknowledgmentMessage([ZeroOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitf = one]) : one \in Sample(1) }
        \cup { SettleOrderAcknowledgmentMessage([ZeroOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = one]) : one \in {0, 1, 255} }
        \cup { SettleOrderAcknowledgmentMessage([ZeroOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 1, !.orderAcknowledgmentReturnBitfield1 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderAcknowledgmentMessage([ZeroOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 2, !.orderAcknowledgmentReturnBitfield2 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
