        \cup { SettleOrderRejectedMessage([ZeroOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 16, !.orderRejectedReturnBitfield16 = <<4>>, !.comboOrder = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderRejectedMessage([ZeroOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 16, !.orderRejectedReturnBitfield16 = <<8>>, !.compression = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderRejectedMessage([ZeroOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 16, !.orderRejectedReturnBitfield16 = <<16>>, !.floorDestination = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderRejectedMessage([ZeroOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 16, !.orderRejectedReturnBitfield16 = <<32>>, !.floorRoutingInst = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderRejectedMessage([ZeroOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 16, !.orderRejectedReturnBitfield16 = <<64>>, !.multiClassSprd = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderRejectedMessage([ZeroOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 16, !.orderRejectedReturnBitfield16 = <<128>>, !.orderOrigin = one]) : one \in { <<held>> : held \in Sample(3) } }
        \cup { SettleOrderRejectedMessage([ZeroOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 17, !.orderRejectedReturnBitfield17 = <<1>>, !.priceType = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderRejectedMessage([ZeroOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 17, !.orderRejectedReturnBitfield17 = <<2>>, !.strategyId = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderRejectedMessage([ZeroOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 18, !.orderRejectedReturnBitfield18 = <<2>>, !.crossInitiator = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderRejectedMessage([ZeroOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 18, !.orderRejectedReturnBitfield18 = <<4>>, !.subreason = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderRejectedMessage([ZeroOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 18, !.orderRejectedReturnBitfield18 = <<32>>, !.held = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderRejectedMessage([ZeroOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 19, !.orderRejectedReturnBitfield19 = <<4>>, !.crossOnBehalfOfId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderRejectedMessage([ZeroOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 19, !.orderRejectedReturnBitfield19 = <<64>>, !.stopPxType = one]) : one \in { <<held>> : held \in Sample(1) } }

(***************************************************************************)
(* Cross Order Rejected Message                                            *)
(***************************************************************************)

CrossOrderRejectedMessage ==
    [ transactionTime                    : Sample(8),
      crossId                            : Sample(20),
      orderRejectReason                  : Sample(1),
      text                               : Sample(60),
      reserved1                          : Sample(1),
      numberOfReturnBitfields            : 0 .. 255,
      crossOrderRejectedReturnBitfield1  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderRejectedReturnBitfield2  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderRejectedReturnBitfield3  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderRejectedReturnBitfield4  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderRejectedReturnBitfield5  : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderRejectedReturnBitfield6  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderRejectedReturnBitfield7  : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderRejectedReturnBitfield8  : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderRejectedReturnBitfield9  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderRejectedReturnBitfield10 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderRejectedReturnBitfield11 : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderRejectedReturnBitfield12 : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderRejectedReturnBitfield13 : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderRejectedReturnBitfield14 : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderRejectedReturnBitfield15 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderRejectedReturnBitfield16 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderRejectedReturnBitfield17 : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderRejectedReturnBitfield18 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderRejectedReturnBitfield19 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderRejectedReturnBitfield20 : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderRejectedReturnBitfield21 : { << >> } \cup { <<held>> : held \in Sample(1) },
      priceLong                          : { << >> } \cup { <<held>> : held \in Sample(8) },
      execInst                           : { << >> } \cup { <<held>> : held \in Sample(1) },
      symbolLong                         : { << >> } \cup { <<held>> : held \in Sample(8) },
      orderQtyLong                       : { << >> } \cup { <<held>> : held \in Sample(4) },
      preventMatch                       : { << >> } \cup { <<held>> : held \in Sample(3) },
      maturityDate                       : { << >> } \cup { <<held>> : held \in Sample(4) },
      strikePrice                        : { << >> } \cup { <<held>> : held \in Sample(8) },
      putOrCall                          : { << >> } \cup { <<held>> : held \in Sample(1) },
      attributedQuote                    : { << >> } \cup { <<held>> : held \in Sample(1) },
      targetPartyId                      : { << >> } \cup { <<held>> : held \in Sample(4) },
      crossType                          : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossPrioritization                : { << >> } \cup { <<held>> : held \in Sample(1) },
      routingFirmId                      : { << >> } \cup { <<held>> : held \in Sample(4) },
      equityPartyId                      : { << >> } \cup { <<held>> : held \in Sample(4) },
      frequentTraderId                   : { << >> } \cup { <<held>> : held \in Sample(6) },
      compression                        : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossInitiator                     : { << >> } \cup { <<held>> : held \in Sample(4) },
      subreason                          : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOnBehalfOfId                  : { << >> } \cup { <<held>> : held \in Sample(4) } ]

EncodeCrossOrderRejectedMessage(message) ==
    message.transactionTime
        \o message.crossId
        \o message.orderRejectReason
        \o message.text
        \o message.reserved1
        \o EncodeUIntBE(message.numberOfReturnBitfields, 1)
        \o (IF message.crossOrderRejectedReturnBitfield1 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderRejectedReturnBitfield1[1], 1))
        \o (IF message.crossOrderRejectedReturnBitfield2 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderRejectedReturnBitfield2[1], 1))
        \o (IF message.crossOrderRejectedReturnBitfield3 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderRejectedReturnBitfield3[1], 1))
        \o (IF message.crossOrderRejectedReturnBitfield4 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderRejectedReturnBitfield4[1], 1))
        \o (IF message.crossOrderRejectedReturnBitfield5 = << >> THEN << >> ELSE message.crossOrderRejectedReturnBitfield5[1])
        \o (IF message.crossOrderRejectedReturnBitfield6 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderRejectedReturnBitfield6[1], 1))
        \o (IF message.crossOrderRejectedReturnBitfield7 = << >> THEN << >> ELSE message.crossOrderRejectedReturnBitfield7[1])
        \o (IF message.crossOrderRejectedReturnBitfield8 = << >> THEN << >> ELSE message.crossOrderRejectedReturnBitfield8[1])
        \o (IF message.crossOrderRejectedReturnBitfield9 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderRejectedReturnBitfield9[1], 1))
        \o (IF message.crossOrderRejectedReturnBitfield10 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderRejectedReturnBitfield10[1], 1))
        \o (IF message.crossOrderRejectedReturnBitfield11 = << >> THEN << >> ELSE message.crossOrderRejectedReturnBitfield11[1])
        \o (IF message.crossOrderRejectedReturnBitfield12 = << >> THEN << >> ELSE message.crossOrderRejectedReturnBitfield12[1])
        \o (IF message.crossOrderRejectedReturnBitfield13 = << >> THEN << >> ELSE message.crossOrderRejectedReturnBitfield13[1])
        \o (IF message.crossOrderRejectedReturnBitfield14 = << >> THEN << >> ELSE message.crossOrderRejectedReturnBitfield14[1])
        \o (IF message.crossOrderRejectedReturnBitfield15 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderRejectedReturnBitfield15[1], 1))
        \o (IF message.crossOrderRejectedReturnBitfield16 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderRejectedReturnBitfield16[1], 1))
        \o (IF message.crossOrderRejectedReturnBitfield17 = << >> THEN << >> ELSE message.crossOrderRejectedReturnBitfield17[1])
        \o (IF message.crossOrderRejectedReturnBitfield18 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderRejectedReturnBitfield18[1], 1))
        \o (IF message.crossOrderRejectedReturnBitfield19 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderRejectedReturnBitfield19[1], 1))
        \o (IF message.crossOrderRejectedReturnBitfield20 = << >> THEN << >> ELSE message.crossOrderRejectedReturnBitfield20[1])
        \o (IF message.crossOrderRejectedReturnBitfield21 = << >> THEN << >> ELSE message.crossOrderRejectedReturnBitfield21[1])
        \o (IF message.priceLong = << >> THEN << >> ELSE message.priceLong[1])
        \o (IF message.execInst = << >> THEN << >> ELSE message.execInst[1])
        \o (IF message.symbolLong = << >> THEN << >> ELSE message.symbolLong[1])
        \o (IF message.orderQtyLong = << >> THEN << >> ELSE message.orderQtyLong[1])
        \o (IF message.preventMatch = << >> THEN << >> ELSE message.preventMatch[1])
        \o (IF message.maturityDate = << >> THEN << >> ELSE message.maturityDate[1])
        \o (IF message.strikePrice = << >> THEN << >> ELSE message.strikePrice[1])
        \o (IF message.putOrCall = << >> THEN << >> ELSE message.putOrCall[1])
        \o (IF message.attributedQuote = << >> THEN << >> ELSE message.attributedQuote[1])
        \o (IF message.targetPartyId = << >> THEN << >> ELSE message.targetPartyId[1])
        \o (IF message.crossType = << >> THEN << >> ELSE message.crossType[1])
        \o (IF message.crossPrioritization = << >> THEN << >> ELSE message.crossPrioritization[1])
        \o (IF message.routingFirmId = << >> THEN << >> ELSE message.routingFirmId[1])
        \o (IF message.equityPartyId = << >> THEN << >> ELSE message.equityPartyId[1])
        \o (IF message.frequentTraderId = << >> THEN << >> ELSE message.frequentTraderId[1])
        \o (IF message.compression = << >> THEN << >> ELSE message.compression[1])
        \o (IF message.crossInitiator = << >> THEN << >> ELSE message.crossInitiator[1])
        \o (IF message.subreason = << >> THEN << >> ELSE message.subreason[1])
        \o (IF message.crossOnBehalfOfId = << >> THEN << >> ELSE message.crossOnBehalfOfId[1])

DecodeCrossOrderRejectedMessage(bytes) ==
    LET transactionTime == ReadBytes(bytes, 8) IN IF ~transactionTime.ok THEN Fail ELSE
    LET crossId == ReadBytes(transactionTime.rest, 20) IN IF ~crossId.ok THEN Fail ELSE
    LET orderRejectReason == ReadBytes(crossId.rest, 1) IN IF ~orderRejectReason.ok THEN Fail ELSE
    LET text == ReadBytes(orderRejectReason.rest, 60) IN IF ~text.ok THEN Fail ELSE
    LET reserved1 == ReadBytes(text.rest, 1) IN IF ~reserved1.ok THEN Fail ELSE
    LET numberOfReturnBitfields == ReadUIntBE(reserved1.rest, 1) IN IF ~numberOfReturnBitfields.ok THEN Fail ELSE
    LET crossOrderRejectedReturnBitfield1 == ReadWhen(numberOfReturnBitfields.value >= 1, ReadUIntLE(numberOfReturnBitfields.rest, 1), numberOfReturnBitfields.rest) IN IF ~crossOrderRejectedReturnBitfield1.ok THEN Fail ELSE
    LET crossOrderRejectedReturnBitfield2 == ReadWhen(numberOfReturnBitfields.value >= 2, ReadUIntLE(crossOrderRejectedReturnBitfield1.rest, 1), crossOrderRejectedReturnBitfield1.rest) IN IF ~crossOrderRejectedReturnBitfield2.ok THEN Fail ELSE
    LET crossOrderRejectedReturnBitfield3 == ReadWhen(numberOfReturnBitfields.value >= 3, ReadUIntLE(crossOrderRejectedReturnBitfield2.rest, 1), crossOrderRejectedReturnBitfield2.rest) IN IF ~crossOrderRejectedReturnBitfield3.ok THEN Fail ELSE
    LET crossOrderRejectedReturnBitfield4 == ReadWhen(numberOfReturnBitfields.value >= 4, ReadUIntLE(crossOrderRejectedReturnBitfield3.rest, 1), crossOrderRejectedReturnBitfield3.rest) IN IF ~crossOrderRejectedReturnBitfield4.ok THEN Fail ELSE
    LET crossOrderRejectedReturnBitfield5 == ReadWhen(numberOfReturnBitfields.value >= 5, ReadBytes(crossOrderRejectedReturnBitfield4.rest, 1), crossOrderRejectedReturnBitfield4.rest) IN IF ~crossOrderRejectedReturnBitfield5.ok THEN Fail ELSE
    LET crossOrderRejectedReturnBitfield6 == ReadWhen(numberOfReturnBitfields.value >= 6, ReadUIntLE(crossOrderRejectedReturnBitfield5.rest, 1), crossOrderRejectedReturnBitfield5.rest) IN IF ~crossOrderRejectedReturnBitfield6.ok THEN Fail ELSE
    LET crossOrderRejectedReturnBitfield7 == ReadWhen(numberOfReturnBitfields.value >= 7, ReadBytes(crossOrderRejectedReturnBitfield6.rest, 1), crossOrderRejectedReturnBitfield6.rest) IN IF ~crossOrderRejectedReturnBitfield7.ok THEN Fail ELSE
    LET crossOrderRejectedReturnBitfield8 == ReadWhen(numberOfReturnBitfields.value >= 8, ReadBytes(crossOrderRejectedReturnBitfield7.rest, 1), crossOrderRejectedReturnBitfield7.rest) IN IF ~crossOrderRejectedReturnBitfield8.ok THEN Fail ELSE
    LET crossOrderRejectedReturnBitfield9 == ReadWhen(numberOfReturnBitfields.value >= 9, ReadUIntLE(crossOrderRejectedReturnBitfield8.rest, 1), crossOrderRejectedReturnBitfield8.rest) IN IF ~crossOrderRejectedReturnBitfield9.ok THEN Fail ELSE
    LET crossOrderRejectedReturnBitfield10 == ReadWhen(numberOfReturnBitfields.value >= 10, ReadUIntLE(crossOrderRejectedReturnBitfield9.rest, 1), crossOrderRejectedReturnBitfield9.rest) IN IF ~crossOrderRejectedReturnBitfield10.ok THEN Fail ELSE
    LET crossOrderRejectedReturnBitfield11 == ReadWhen(numberOfReturnBitfields.value >= 11, ReadBytes(crossOrderRejectedReturnBitfield10.rest, 1), crossOrderRejectedReturnBitfield10.rest) IN IF ~crossOrderRejectedReturnBitfield11.ok THEN Fail ELSE
    LET crossOrderRejectedReturnBitfield12 == ReadWhen(numberOfReturnBitfields.value >= 12, ReadBytes(crossOrderRejectedReturnBitfield11.rest, 1), crossOrderRejectedReturnBitfield11.rest) IN IF ~crossOrderRejectedReturnBitfield12.ok THEN Fail ELSE
    LET crossOrderRejectedReturnBitfield13 == ReadWhen(numberOfReturnBitfields.value >= 13, ReadBytes(crossOrderRejectedReturnBitfield12.rest, 1), crossOrderRejectedReturnBitfield12.rest) IN IF ~crossOrderRejectedReturnBitfield13.ok THEN Fail ELSE
    LET crossOrderRejectedReturnBitfield14 == ReadWhen(numberOfReturnBitfields.value >= 14, ReadBytes(crossOrderRejectedReturnBitfield13.rest, 1), crossOrderRejectedReturnBitfield13.rest) IN IF ~crossOrderRejectedReturnBitfield14.ok THEN Fail ELSE
    LET crossOrderRejectedReturnBitfield15 == ReadWhen(numberOfReturnBitfields.value >= 15, ReadUIntLE(crossOrderRejectedReturnBitfield14.rest, 1), crossOrderRejectedReturnBitfield14.rest) IN IF ~crossOrderRejectedReturnBitfield15.ok THEN Fail ELSE
    LET crossOrderRejectedReturnBitfield16 == ReadWhen(numberOfReturnBitfields.value >= 16, ReadUIntLE(crossOrderRejectedReturnBitfield15.rest, 1), crossOrderRejectedReturnBitfield15.rest) IN IF ~crossOrderRejectedReturnBitfield16.ok THEN Fail ELSE
    LET crossOrderRejectedReturnBitfield17 == ReadWhen(numberOfReturnBitfields.value >= 17, ReadBytes(crossOrderRejectedReturnBitfield16.rest, 1), crossOrderRejectedReturnBitfield16.rest) IN IF ~crossOrderRejectedReturnBitfield17.ok THEN Fail ELSE
    LET crossOrderRejectedReturnBitfield18 == ReadWhen(numberOfReturnBitfields.value >= 18, ReadUIntLE(crossOrderRejectedReturnBitfield17.rest, 1), crossOrderRejectedReturnBitfield17.rest) IN IF ~crossOrderRejectedReturnBitfield18.ok THEN Fail ELSE
    LET crossOrderRejectedReturnBitfield19 == ReadWhen(numberOfReturnBitfields.value >= 19, ReadUIntLE(crossOrderRejectedReturnBitfield18.rest, 1), crossOrderRejectedReturnBitfield18.rest) IN IF ~crossOrderRejectedReturnBitfield19.ok THEN Fail ELSE
    LET crossOrderRejectedReturnBitfield20 == ReadWhen(numberOfReturnBitfields.value >= 20, ReadBytes(crossOrderRejectedReturnBitfield19.rest, 1), crossOrderRejectedReturnBitfield19.rest) IN IF ~crossOrderRejectedReturnBitfield20.ok THEN Fail ELSE
    LET crossOrderRejectedReturnBitfield21 == ReadWhen(numberOfReturnBitfields.value >= 21, ReadBytes(crossOrderRejectedReturnBitfield20.rest, 1), crossOrderRejectedReturnBitfield20.rest) IN IF ~crossOrderRejectedReturnBitfield21.ok THEN Fail ELSE
    LET priceLong == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (crossOrderRejectedReturnBitfield1.value # << >> /\ (crossOrderRejectedReturnBitfield1.value[1] \div 4) % 2 > 0), ReadBytes(crossOrderRejectedReturnBitfield21.rest, 8), crossOrderRejectedReturnBitfield21.rest) IN IF ~priceLong.ok THEN Fail ELSE
    LET execInst == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (crossOrderRejectedReturnBitfield1.value # << >> /\ (crossOrderRejectedReturnBitfield1.value[1] \div 8) % 2 > 0), ReadBytes(priceLong.rest, 1), priceLong.rest) IN IF ~execInst.ok THEN Fail ELSE
    LET symbolLong == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (crossOrderRejectedReturnBitfield2.value # << >> /\ crossOrderRejectedReturnBitfield2.value[1] % 2 > 0), ReadBytes(execInst.rest, 8), execInst.rest) IN IF ~symbolLong.ok THEN Fail ELSE
    LET orderQtyLong == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (crossOrderRejectedReturnBitfield3.value # << >> /\ (crossOrderRejectedReturnBitfield3.value[1] \div 64) % 2 > 0), ReadBytes(symbolLong.rest, 4), symbolLong.rest) IN IF ~orderQtyLong.ok THEN Fail ELSE
    LET preventMatch == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (crossOrderRejectedReturnBitfield3.value # << >> /\ (crossOrderRejectedReturnBitfield3.value[1] \div 128) % 2 > 0), ReadBytes(orderQtyLong.rest, 3), orderQtyLong.rest) IN IF ~preventMatch.ok THEN Fail ELSE
    LET maturityDate == ReadWhen(numberOfReturnBitfields.value >= 4 /\ (crossOrderRejectedReturnBitfield4.value # << >> /\ crossOrderRejectedReturnBitfield4.value[1] % 2 > 0), ReadBytes(preventMatch.rest, 4), preventMatch.rest) IN IF ~maturityDate.ok THEN Fail ELSE
    LET strikePrice == ReadWhen(numberOfReturnBitfields.value >= 4 /\ (crossOrderRejectedReturnBitfield4.value # << >> /\ (crossOrderRejectedReturnBitfield4.value[1] \div 2) % 2 > 0), ReadBytes(maturityDate.rest, 8), maturityDate.rest) IN IF ~strikePrice.ok THEN Fail ELSE
    LET putOrCall == ReadWhen(numberOfReturnBitfields.value >= 4 /\ (crossOrderRejectedReturnBitfield4.value # << >> /\ (crossOrderRejectedReturnBitfield4.value[1] \div 4) % 2 > 0), ReadBytes(strikePrice.rest, 1), strikePrice.rest) IN IF ~putOrCall.ok THEN Fail ELSE
    LET attributedQuote == ReadWhen(numberOfReturnBitfields.value >= 6 /\ (crossOrderRejectedReturnBitfield6.value # << >> /\ (crossOrderRejectedReturnBitfield6.value[1] \div 8) % 2 > 0), ReadBytes(putOrCall.rest, 1), putOrCall.rest) IN IF ~attributedQuote.ok THEN Fail ELSE
    LET targetPartyId == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (crossOrderRejectedReturnBitfield9.value # << >> /\ (crossOrderRejectedReturnBitfield9.value[1] \div 2) % 2 > 0), ReadBytes(attributedQuote.rest, 4), attributedQuote.rest) IN IF ~targetPartyId.ok THEN Fail ELSE
    LET crossType == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (crossOrderRejectedReturnBitfield9.value # << >> /\ (crossOrderRejectedReturnBitfield9.value[1] \div 64) % 2 > 0), ReadBytes(targetPartyId.rest, 1), targetPartyId.rest) IN IF ~crossType.ok THEN Fail ELSE
    LET crossPrioritization == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (crossOrderRejectedReturnBitfield9.value # << >> /\ (crossOrderRejectedReturnBitfield9.value[1] \div 128) % 2 > 0), ReadBytes(crossType.rest, 1), crossType.rest) IN IF ~crossPrioritization.ok THEN Fail ELSE
    LET routingFirmId == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (crossOrderRejectedReturnBitfield10.value # << >> /\ (crossOrderRejectedReturnBitfield10.value[1] \div 8) % 2 > 0), ReadBytes(crossPrioritization.rest, 4), crossPrioritization.rest) IN IF ~routingFirmId.ok THEN Fail ELSE
    LET equityPartyId == ReadWhen(numberOfReturnBitfields.value >= 15 /\ (crossOrderRejectedReturnBitfield15.value # << >> /\ (crossOrderRejectedReturnBitfield15.value[1] \div 2) % 2 > 0), ReadBytes(routingFirmId.rest, 4), routingFirmId.rest) IN IF ~equityPartyId.ok THEN Fail ELSE
    LET frequentTraderId == ReadWhen(numberOfReturnBitfields.value >= 16 /\ (crossOrderRejectedReturnBitfield16.value # << >> /\ crossOrderRejectedReturnBitfield16.value[1] % 2 > 0), ReadBytes(equityPartyId.rest, 6), equityPartyId.rest) IN IF ~frequentTraderId.ok THEN Fail ELSE
    LET compression == ReadWhen(numberOfReturnBitfields.value >= 16 /\ (crossOrderRejectedReturnBitfield16.value # << >> /\ (crossOrderRejectedReturnBitfield16.value[1] \div 8) % 2 > 0), ReadBytes(frequentTraderId.rest, 1), frequentTraderId.rest) IN IF ~compression.ok THEN Fail ELSE
    LET crossInitiator == ReadWhen(numberOfReturnBitfields.value >= 18 /\ (crossOrderRejectedReturnBitfield18.value # << >> /\ (crossOrderRejectedReturnBitfield18.value[1] \div 2) % 2 > 0), ReadBytes(compression.rest, 4), compression.rest) IN IF ~crossInitiator.ok THEN Fail ELSE
    LET subreason == ReadWhen(numberOfReturnBitfields.value >= 18 /\ (crossOrderRejectedReturnBitfield18.value # << >> /\ (crossOrderRejectedReturnBitfield18.value[1] \div 4) % 2 > 0), ReadBytes(crossInitiator.rest, 1), crossInitiator.rest) IN IF ~subreason.ok THEN Fail ELSE
    LET crossOnBehalfOfId == ReadWhen(numberOfReturnBitfields.value >= 19 /\ (crossOrderRejectedReturnBitfield19.value # << >> /\ (crossOrderRejectedReturnBitfield19.value[1] \div 4) % 2 > 0), ReadBytes(subreason.rest, 4), subreason.rest) IN IF ~crossOnBehalfOfId.ok THEN Fail ELSE
    Ok([ transactionTime                    |-> transactionTime.value,
         crossId                            |-> crossId.value,
         orderRejectReason                  |-> orderRejectReason.value,
         text                               |-> text.value,
         reserved1                          |-> reserved1.value,
         numberOfReturnBitfields            |-> numberOfReturnBitfields.value,
         crossOrderRejectedReturnBitfield1  |-> crossOrderRejectedReturnBitfield1.value,
         crossOrderRejectedReturnBitfield2  |-> crossOrderRejectedReturnBitfield2.value,
         crossOrderRejectedReturnBitfield3  |-> crossOrderRejectedReturnBitfield3.value,
         crossOrderRejectedReturnBitfield4  |-> crossOrderRejectedReturnBitfield4.value,
         crossOrderRejectedReturnBitfield5  |-> crossOrderRejectedReturnBitfield5.value,
         crossOrderRejectedReturnBitfield6  |-> crossOrderRejectedReturnBitfield6.value,
         crossOrderRejectedReturnBitfield7  |-> crossOrderRejectedReturnBitfield7.value,
         crossOrderRejectedReturnBitfield8  |-> crossOrderRejectedReturnBitfield8.value,
         crossOrderRejectedReturnBitfield9  |-> crossOrderRejectedReturnBitfield9.value,
         crossOrderRejectedReturnBitfield10 |-> crossOrderRejectedReturnBitfield10.value,
         crossOrderRejectedReturnBitfield11 |-> crossOrderRejectedReturnBitfield11.value,
         crossOrderRejectedReturnBitfield12 |-> crossOrderRejectedReturnBitfield12.value,
         crossOrderRejectedReturnBitfield13 |-> crossOrderRejectedReturnBitfield13.value,
         crossOrderRejectedReturnBitfield14 |-> crossOrderRejectedReturnBitfield14.value,
         crossOrderRejectedReturnBitfield15 |-> crossOrderRejectedReturnBitfield15.value,
         crossOrderRejectedReturnBitfield16 |-> crossOrderRejectedReturnBitfield16.value,
         crossOrderRejectedReturnBitfield17 |-> crossOrderRejectedReturnBitfield17.value,
         crossOrderRejectedReturnBitfield18 |-> crossOrderRejectedReturnBitfield18.value,
         crossOrderRejectedReturnBitfield19 |-> crossOrderRejectedReturnBitfield19.value,
         crossOrderRejectedReturnBitfield20 |-> crossOrderRejectedReturnBitfield20.value,
         crossOrderRejectedReturnBitfield21 |-> crossOrderRejectedReturnBitfield21.value,
         priceLong                          |-> priceLong.value,
         execInst                           |-> execInst.value,
         symbolLong                         |-> symbolLong.value,
         orderQtyLong                       |-> orderQtyLong.value,
         preventMatch                       |-> preventMatch.value,
         maturityDate                       |-> maturityDate.value,
         strikePrice                        |-> strikePrice.value,
         putOrCall                          |-> putOrCall.value,
         attributedQuote                    |-> attributedQuote.value,
         targetPartyId                      |-> targetPartyId.value,
         crossType                          |-> crossType.value,
         crossPrioritization                |-> crossPrioritization.value,
         routingFirmId                      |-> routingFirmId.value,
         equityPartyId                      |-> equityPartyId.value,
         frequentTraderId                   |-> frequentTraderId.value,
         compression                        |-> compression.value,
         crossInitiator                     |-> crossInitiator.value,
         subreason                          |-> subreason.value,
         crossOnBehalfOfId                  |-> crossOnBehalfOfId.value ], crossOnBehalfOfId.rest)

(* Cross Order Rejected Message with each field marked present by fields before it there exactly where they say *)
SettleCrossOrderRejectedMessage(message) ==
    LET settled1 == [message EXCEPT !.crossOrderRejectedReturnBitfield1 = IF message.numberOfReturnBitfields >= 1 THEN (IF message.crossOrderRejectedReturnBitfield1 = << >> THEN <<0>> ELSE message.crossOrderRejectedReturnBitfield1) ELSE << >>]
        settled2 == [settled1 EXCEPT !.crossOrderRejectedReturnBitfield2 = IF settled1.numberOfReturnBitfields >= 2 THEN (IF settled1.crossOrderRejectedReturnBitfield2 = << >> THEN <<0>> ELSE settled1.crossOrderRejectedReturnBitfield2) ELSE << >>]
        settled3 == [settled2 EXCEPT !.crossOrderRejectedReturnBitfield3 = IF settled2.numberOfReturnBitfields >= 3 THEN (IF settled2.crossOrderRejectedReturnBitfield3 = << >> THEN <<0>> ELSE settled2.crossOrderRejectedReturnBitfield3) ELSE << >>]
        settled4 == [settled3 EXCEPT !.crossOrderRejectedReturnBitfield4 = IF settled3.numberOfReturnBitfields >= 4 THEN (IF settled3.crossOrderRejectedReturnBitfield4 = << >> THEN <<0>> ELSE settled3.crossOrderRejectedReturnBitfield4) ELSE << >>]
        settled5 == [settled4 EXCEPT !.crossOrderRejectedReturnBitfield5 = IF settled4.numberOfReturnBitfields >= 5 THEN (IF settled4.crossOrderRejectedReturnBitfield5 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled4.crossOrderRejectedReturnBitfield5) ELSE << >>]
        settled6 == [settled5 EXCEPT !.crossOrderRejectedReturnBitfield6 = IF settled5.numberOfReturnBitfields >= 6 THEN (IF settled5.crossOrderRejectedReturnBitfield6 = << >> THEN <<0>> ELSE settled5.crossOrderRejectedReturnBitfield6) ELSE << >>]
        settled7 == [settled6 EXCEPT !.crossOrderRejectedReturnBitfield7 = IF settled6.numberOfReturnBitfields >= 7 THEN (IF settled6.crossOrderRejectedReturnBitfield7 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled6.crossOrderRejectedReturnBitfield7) ELSE << >>]
        settled8 == [settled7 EXCEPT !.crossOrderRejectedReturnBitfield8 = IF settled7.numberOfReturnBitfields >= 8 THEN (IF settled7.crossOrderRejectedReturnBitfield8 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled7.crossOrderRejectedReturnBitfield8) ELSE << >>]
        settled9 == [settled8 EXCEPT !.crossOrderRejectedReturnBitfield9 = IF settled8.numberOfReturnBitfields >= 9 THEN (IF settled8.crossOrderRejectedReturnBitfield9 = << >> THEN <<0>> ELSE settled8.crossOrderRejectedReturnBitfield9) ELSE << >>]
        settled10 == [settled9 EXCEPT !.crossOrderRejectedReturnBitfield10 = IF settled9.numberOfReturnBitfields >= 10 THEN (IF settled9.crossOrderRejectedReturnBitfield10 = << >> THEN <<0>> ELSE settled9.crossOrderRejectedReturnBitfield10) ELSE << >>]
        settled11 == [settled10 EXCEPT !.crossOrderRejectedReturnBitfield11 = IF settled10.numberOfReturnBitfields >= 11 THEN (IF settled10.crossOrderRejectedReturnBitfield11 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled10.crossOrderRejectedReturnBitfield11) ELSE << >>]
        settled12 == [settled11 EXCEPT !.crossOrderRejectedReturnBitfield12 = IF settled11.numberOfReturnBitfields >= 12 THEN (IF settled11.crossOrderRejectedReturnBitfield12 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled11.crossOrderRejectedReturnBitfield12) ELSE << >>]
        settled13 == [settled12 EXCEPT !.crossOrderRejectedReturnBitfield13 = IF settled12.numberOfReturnBitfields >= 13 THEN (IF settled12.crossOrderRejectedReturnBitfield13 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled12.crossOrderRejectedReturnBitfield13) ELSE << >>]
        settled14 == [settled13 EXCEPT !.crossOrderRejectedReturnBitfield14 = IF settled13.numberOfReturnBitfields >= 14 THEN (IF settled13.crossOrderRejectedReturnBitfield14 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled13.crossOrderRejectedReturnBitfield14) ELSE << >>]
        settled15 == [settled14 EXCEPT !.crossOrderRejectedReturnBitfield15 = IF settled14.numberOfReturnBitfields >= 15 THEN (IF settled14.crossOrderRejectedReturnBitfield15 = << >> THEN <<0>> ELSE settled14.crossOrderRejectedReturnBitfield15) ELSE << >>]
        settled16 == [settled15 EXCEPT !.crossOrderRejectedReturnBitfield16 = IF settled15.numberOfReturnBitfields >= 16 THEN (IF settled15.crossOrderRejectedReturnBitfield16 = << >> THEN <<0>> ELSE settled15.crossOrderRejectedReturnBitfield16) ELSE << >>]
        settled17 == [settled16 EXCEPT !.crossOrderRejectedReturnBitfield17 = IF settled16.numberOfReturnBitfields >= 17 THEN (IF settled16.crossOrderRejectedReturnBitfield17 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled16.crossOrderRejectedReturnBitfield17) ELSE << >>]
        settled18 == [settled17 EXCEPT !.crossOrderRejectedReturnBitfield18 = IF settled17.numberOfReturnBitfields >= 18 THEN (IF settled17.crossOrderRejectedReturnBitfield18 = << >> THEN <<0>> ELSE settled17.crossOrderRejectedReturnBitfield18) ELSE << >>]
        settled19 == [settled18 EXCEPT !.crossOrderRejectedReturnBitfield19 = IF settled18.numberOfReturnBitfields >= 19 THEN (IF settled18.crossOrderRejectedReturnBitfield19 = << >> THEN <<0>> ELSE settled18.crossOrderRejectedReturnBitfield19) ELSE << >>]
        settled20 == [settled19 EXCEPT !.crossOrderRejectedReturnBitfield20 = IF settled19.numberOfReturnBitfields >= 20 THEN (IF settled19.crossOrderRejectedReturnBitfield20 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled19.crossOrderRejectedReturnBitfield20) ELSE << >>]
        settled21 == [settled20 EXCEPT !.crossOrderRejectedReturnBitfield21 = IF settled20.numberOfReturnBitfields >= 21 THEN (IF settled20.crossOrderRejectedReturnBitfield21 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled20.crossOrderRejectedReturnBitfield21) ELSE << >>]
        settled22 == [settled21 EXCEPT !.priceLong = IF settled21.numberOfReturnBitfields >= 1 /\ (settled21.crossOrderRejectedReturnBitfield1 # << >> /\ (settled21.crossOrderRejectedReturnBitfield1[1] \div 4) % 2 > 0) THEN (IF settled21.priceLong = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled21.priceLong) ELSE << >>]
        settled23 == [settled22 EXCEPT !.execInst = IF settled22.numberOfReturnBitfields >= 1 /\ (settled22.crossOrderRejectedReturnBitfield1 # << >> /\ (settled22.crossOrderRejectedReturnBitfield1[1] \div 8) % 2 > 0) THEN (IF settled22.execInst = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled22.execInst) ELSE << >>]
        settled24 == [settled23 EXCEPT !.symbolLong = IF settled23.numberOfReturnBitfields >= 2 /\ (settled23.crossOrderRejectedReturnBitfield2 # << >> /\ settled23.crossOrderRejectedReturnBitfield2[1] % 2 > 0) THEN (IF settled23.symbolLong = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled23.symbolLong) ELSE << >>]
        settled25 == [settled24 EXCEPT !.orderQtyLong = IF settled24.numberOfReturnBitfields >= 3 /\ (settled24.crossOrderRejectedReturnBitfield3 # << >> /\ (settled24.crossOrderRejectedReturnBitfield3[1] \div 64) % 2 > 0) THEN (IF settled24.orderQtyLong = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled24.orderQtyLong) ELSE << >>]
        settled26 == [settled25 EXCEPT !.preventMatch = IF settled25.numberOfReturnBitfields >= 3 /\ (settled25.crossOrderRejectedReturnBitfield3 # << >> /\ (settled25.crossOrderRejectedReturnBitfield3[1] \div 128) % 2 > 0) THEN (IF settled25.preventMatch = << >> THEN <<[i \in 1 .. 3 |-> 0]>> ELSE settled25.preventMatch) ELSE << >>]
        settled27 == [settled26 EXCEPT !.maturityDate = IF settled26.numberOfReturnBitfields >= 4 /\ (settled26.crossOrderRejectedReturnBitfield4 # << >> /\ settled26.crossOrderRejectedReturnBitfield4[1] % 2 > 0) THEN (IF settled26.maturityDate = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled26.maturityDate) ELSE << >>]
        settled28 == [settled27 EXCEPT !.strikePrice = IF settled27.numberOfReturnBitfields >= 4 /\ (settled27.crossOrderRejectedReturnBitfield4 # << >> /\ (settled27.crossOrderRejectedReturnBitfield4[1] \div 2) % 2 > 0) THEN (IF settled27.strikePrice = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled27.strikePrice) ELSE << >>]
        settled29 == [settled28 EXCEPT !.putOrCall = IF settled28.numberOfReturnBitfields >= 4 /\ (settled28.crossOrderRejectedReturnBitfield4 # << >> /\ (settled28.crossOrderRejectedReturnBitfield4[1] \div 4) % 2 > 0) THEN (IF settled28.putOrCall = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled28.putOrCall) ELSE << >>]
        settled30 == [settled29 EXCEPT !.attributedQuote = IF settled29.numberOfReturnBitfields >= 6 /\ (settled29.crossOrderRejectedReturnBitfield6 # << >> /\ (settled29.crossOrderRejectedReturnBitfield6[1] \div 8) % 2 > 0) THEN (IF settled29.attributedQuote = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled29.attributedQuote) ELSE << >>]
        settled31 == [settled30 EXCEPT !.targetPartyId = IF settled30.numberOfReturnBitfields >= 9 /\ (settled30.crossOrderRejectedReturnBitfield9 # << >> /\ (settled30.crossOrderRejectedReturnBitfield9[1] \div 2) % 2 > 0) THEN (IF settled30.targetPartyId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled30.targetPartyId) ELSE << >>]
        settled32 == [settled31 EXCEPT !.crossType = IF settled31.numberOfReturnBitfields >= 9 /\ (settled31.crossOrderRejectedReturnBitfield9 # << >> /\ (settled31.crossOrderRejectedReturnBitfield9[1] \div 64) % 2 > 0) THEN (IF settled31.crossType = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled31.crossType) ELSE << >>]
        settled33 == [settled32 EXCEPT !.crossPrioritization = IF settled32.numberOfReturnBitfields >= 9 /\ (settled32.crossOrderRejectedReturnBitfield9 # << >> /\ (settled32.crossOrderRejectedReturnBitfield9[1] \div 128) % 2 > 0) THEN (IF settled32.crossPrioritization = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled32.crossPrioritization) ELSE << >>]
        settled34 == [settled33 EXCEPT !.routingFirmId = IF settled33.numberOfReturnBitfields >= 10 /\ (settled33.crossOrderRejectedReturnBitfield10 # << >> /\ (settled33.crossOrderRejectedReturnBitfield10[1] \div 8) % 2 > 0) THEN (IF settled33.routingFirmId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled33.routingFirmId) ELSE << >>]
        settled35 == [settled34 EXCEPT !.equityPartyId = IF settled34.numberOfReturnBitfields >= 15 /\ (settled34.crossOrderRejectedReturnBitfield15 # << >> /\ (settled34.crossOrderRejectedReturnBitfield15[1] \div 2) % 2 > 0) THEN (IF settled34.equityPartyId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled34.equityPartyId) ELSE << >>]
        settled36 == [settled35 EXCEPT !.frequentTraderId = IF settled35.numberOfReturnBitfields >= 16 /\ (settled35.crossOrderRejectedReturnBitfield16 # << >> /\ settled35.crossOrderRejectedReturnBitfield16[1] % 2 > 0) THEN (IF settled35.frequentTraderId = << >> THEN <<[i \in 1 .. 6 |-> 0]>> ELSE settled35.frequentTraderId) ELSE << >>]
        settled37 == [settled36 EXCEPT !.compression = IF settled36.numberOfReturnBitfields >= 16 /\ (settled36.crossOrderRejectedReturnBitfield16 # << >> /\ (settled36.crossOrderRejectedReturnBitfield16[1] \div 8) % 2 > 0) THEN (IF settled36.compression = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled36.compression) ELSE << >>]
        settled38 == [settled37 EXCEPT !.crossInitiator = IF settled37.numberOfReturnBitfields >= 18 /\ (settled37.crossOrderRejectedReturnBitfield18 # << >> /\ (settled37.crossOrderRejectedReturnBitfield18[1] \div 2) % 2 > 0) THEN (IF settled37.crossInitiator = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled37.crossInitiator) ELSE << >>]
        settled39 == [settled38 EXCEPT !.subreason = IF settled38.numberOfReturnBitfields >= 18 /\ (settled38.crossOrderRejectedReturnBitfield18 # << >> /\ (settled38.crossOrderRejectedReturnBitfield18[1] \div 4) % 2 > 0) THEN (IF settled38.subreason = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled38.subreason) ELSE << >>]
        settled40 == [settled39 EXCEPT !.crossOnBehalfOfId = IF settled39.numberOfReturnBitfields >= 19 /\ (settled39.crossOrderRejectedReturnBitfield19 # << >> /\ (settled39.crossOrderRejectedReturnBitfield19[1] \div 4) % 2 > 0) THEN (IF settled39.crossOnBehalfOfId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled39.crossOnBehalfOfId) ELSE << >>]
    IN  settled40

ZeroCrossOrderRejectedMessage ==
    SettleCrossOrderRejectedMessage([ transactionTime                    |-> [i \in 1 .. 8 |-> 0],
                                      crossId                            |-> [i \in 1 .. 20 |-> 0],
                                      orderRejectReason                  |-> [i \in 1 .. 1 |-> 0],
                                      text                               |-> [i \in 1 .. 60 |-> 0],
                                      reserved1                          |-> [i \in 1 .. 1 |-> 0],
                                      numberOfReturnBitfields            |-> 0,
                                      crossOrderRejectedReturnBitfield1  |-> << >>,
                                      crossOrderRejectedReturnBitfield2  |-> << >>,
                                      crossOrderRejectedReturnBitfield3  |-> << >>,
                                      crossOrderRejectedReturnBitfield4  |-> << >>,
                                      crossOrderRejectedReturnBitfield5  |-> << >>,
                                      crossOrderRejectedReturnBitfield6  |-> << >>,
                                      crossOrderRejectedReturnBitfield7  |-> << >>,
                                      crossOrderRejectedReturnBitfield8  |-> << >>,
                                      crossOrderRejectedReturnBitfield9  |-> << >>,
                                      crossOrderRejectedReturnBitfield10 |-> << >>,
                                      crossOrderRejectedReturnBitfield11 |-> << >>,
                                      crossOrderRejectedReturnBitfield12 |-> << >>,
                                      crossOrderRejectedReturnBitfield13 |-> << >>,
                                      crossOrderRejectedReturnBitfield14 |-> << >>,
                                      crossOrderRejectedReturnBitfield15 |-> << >>,
                                      crossOrderRejectedReturnBitfield16 |-> << >>,
                                      crossOrderRejectedReturnBitfield17 |-> << >>,
                                      crossOrderRejectedReturnBitfield18 |-> << >>,
                                      crossOrderRejectedReturnBitfield19 |-> << >>,
                                      crossOrderRejectedReturnBitfield20 |-> << >>,
                                      crossOrderRejectedReturnBitfield21 |-> << >>,
                                      priceLong                          |-> << >>,
                                      execInst                           |-> << >>,
                                      symbolLong                         |-> << >>,
                                      orderQtyLong                       |-> << >>,
                                      preventMatch                       |-> << >>,
                                      maturityDate                       |-> << >>,
                                      strikePrice                        |-> << >>,
                                      putOrCall                          |-> << >>,
                                      attributedQuote                    |-> << >>,
                                      targetPartyId                      |-> << >>,
                                      crossType                          |-> << >>,
                                      crossPrioritization                |-> << >>,
                                      routingFirmId                      |-> << >>,
                                      equityPartyId                      |-> << >>,
                                      frequentTraderId                   |-> << >>,
                                      compression                        |-> << >>,
                                      crossInitiator                     |-> << >>,
                                      subreason                          |-> << >>,
                                      crossOnBehalfOfId                  |-> << >> ])

(* Cross Order Rejected Message at zero, then each field in turn at the values it is checked at *)
CheckedCrossOrderRejectedMessage ==
    { ZeroCrossOrderRejectedMessage }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.transactionTime = one]) : one \in Sample(8) }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.crossId = one]) : one \in Sample(20) }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.orderRejectReason = one]) : one \in Sample(1) }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.text = one]) : one \in Sample(60) }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.reserved1 = one]) : one \in Sample(1) }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = one]) : one \in {0, 1, 255} }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 1, !.crossOrderRejectedReturnBitfield1 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 2, !.crossOrderRejectedReturnBitfield2 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 3, !.crossOrderRejectedReturnBitfield3 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 4, !.crossOrderRejectedReturnBitfield4 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 5, !.crossOrderRejectedReturnBitfield5 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 6, !.crossOrderRejectedReturnBitfield6 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 7, !.crossOrderRejectedReturnBitfield7 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 8, !.crossOrderRejectedReturnBitfield8 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 9, !.crossOrderRejectedReturnBitfield9 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 10, !.crossOrderRejectedReturnBitfield10 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 11, !.crossOrderRejectedReturnBitfield11 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 12, !.crossOrderRejectedReturnBitfield12 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 13, !.crossOrderRejectedReturnBitfield13 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 14, !.crossOrderRejectedReturnBitfield14 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 15, !.crossOrderRejectedReturnBitfield15 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 16, !.crossOrderRejectedReturnBitfield16 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 17, !.crossOrderRejectedReturnBitfield17 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 18, !.crossOrderRejectedReturnBitfield18 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 19, !.crossOrderRejectedReturnBitfield19 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 20, !.crossOrderRejectedReturnBitfield20 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 21, !.crossOrderRejectedReturnBitfield21 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 1, !.crossOrderRejectedReturnBitfield1 = <<4>>, !.priceLong = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 1, !.crossOrderRejectedReturnBitfield1 = <<8>>, !.execInst = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 2, !.crossOrderRejectedReturnBitfield2 = <<1>>, !.symbolLong = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 3, !.crossOrderRejectedReturnBitfield3 = <<64>>, !.orderQtyLong = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 3, !.crossOrderRejectedReturnBitfield3 = <<128>>, !.preventMatch = one]) : one \in { <<held>> : held \in Sample(3) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 4, !.crossOrderRejectedReturnBitfield4 = <<1>>, !.maturityDate = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 4, !.crossOrderRejectedReturnBitfield4 = <<2>>, !.strikePrice = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 4, !.crossOrderRejectedReturnBitfield4 = <<4>>, !.putOrCall = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 6, !.crossOrderRejectedReturnBitfield6 = <<8>>, !.attributedQuote = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 9, !.crossOrderRejectedReturnBitfield9 = <<2>>, !.targetPartyId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 9, !.crossOrderRejectedReturnBitfield9 = <<64>>, !.crossType = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 9, !.crossOrderRejectedReturnBitfield9 = <<128>>, !.crossPrioritization = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 10, !.crossOrderRejectedReturnBitfield10 = <<8>>, !.routingFirmId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 15, !.crossOrderRejectedReturnBitfield15 = <<2>>, !.equityPartyId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 16, !.crossOrderRejectedReturnBitfield16 = <<1>>, !.frequentTraderId = one]) : one \in { <<held>> : held \in Sample(6) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 16, !.crossOrderRejectedReturnBitfield16 = <<8>>, !.compression = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 18, !.crossOrderRejectedReturnBitfield18 = <<2>>, !.crossInitiator = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 18, !.crossOrderRejectedReturnBitfield18 = <<4>>, !.subreason = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 19, !.crossOrderRejectedReturnBitfield19 = <<4>>, !.crossOnBehalfOfId = one]) : one \in { <<held>> : held \in Sample(4) } }

(***************************************************************************)
(* Quote Update Rejected Message: 42 bytes                                 *)
(***************************************************************************)

QuoteUpdateRejectedMessage ==
    [ transactionTime   : Sample(8),
      quoteUpdateId     : Sample(16),
      quoteRejectReason : Sample(1),
      reserved17        : Sample(17) ]

EncodeQuoteUpdateRejectedMessage(message) ==
    message.transactionTime
        \o message.quoteUpdateId
        \o message.quoteRejectReason
        \o message.reserved17

DecodeQuoteUpdateRejectedMessage(bytes) ==
    LET transactionTime == ReadBytes(bytes, 8) IN IF ~transactionTime.ok THEN Fail ELSE
    LET quoteUpdateId == ReadBytes(transactionTime.rest, 16) IN IF ~quoteUpdateId.ok THEN Fail ELSE
    LET quoteRejectReason == ReadBytes(quoteUpdateId.rest, 1) IN IF ~quoteRejectReason.ok THEN Fail ELSE
    LET reserved17 == ReadBytes(quoteRejectReason.rest, 17) IN IF ~reserved17.ok THEN Fail ELSE
    Ok([ transactionTime   |-> transactionTime.value,
         quoteUpdateId     |-> quoteUpdateId.value,
         quoteRejectReason |-> quoteRejectReason.value,
         reserved17        |-> reserved17.value ], reserved17.rest)

ZeroQuoteUpdateRejectedMessage ==
    [ transactionTime   |-> [i \in 1 .. 8 |-> 0],
      quoteUpdateId     |-> [i \in 1 .. 16 |-> 0],
      quoteRejectReason |-> [i \in 1 .. 1 |-> 0],
      reserved17        |-> [i \in 1 .. 17 |-> 0] ]

(* Quote Update Rejected Message at zero, then each field in turn at the values it is checked at *)
CheckedQuoteUpdateRejectedMessage ==
    { ZeroQuoteUpdateRejectedMessage }
        \cup { [ZeroQuoteUpdateRejectedMessage EXCEPT !.transactionTime = one] : one \in Sample(8) }
        \cup { [ZeroQuoteUpdateRejectedMessage EXCEPT !.quoteUpdateId = one] : one \in Sample(16) }
        \cup { [ZeroQuoteUpdateRejectedMessage EXCEPT !.quoteRejectReason = one] : one \in Sample(1) }
        \cup { [ZeroQuoteUpdateRejectedMessage EXCEPT !.reserved17 = one] : one \in Sample(17) }

(***************************************************************************)
(* Order Modified Message                                                  *)
(***************************************************************************)

OrderModifiedMessage ==
    [ transactionTime               : Sample(8),
      clOrdId                       : Sample(20),
      orderId                       : Sample(8),
      reserved1                     : Sample(1),
      numberOfReturnBitfields       : 0 .. 255,
      orderModifiedReturnBitfield1  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderModifiedReturnBitfield2  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderModifiedReturnBitfield3  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderModifiedReturnBitfield4  : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderModifiedReturnBitfield5  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderModifiedReturnBitfield6  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderModifiedReturnBitfield7  : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderModifiedReturnBitfield8  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderModifiedReturnBitfield9  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderModifiedReturnBitfield10 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderModifiedReturnBitfield11 : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderModifiedReturnBitfield12 : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderModifiedReturnBitfield13 : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderModifiedReturnBitfield14 : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderModifiedReturnBitfield15 : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderModifiedReturnBitfield16 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderModifiedReturnBitfield17 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderModifiedReturnBitfield18 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderModifiedReturnBitfield19 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderModifiedReturnBitfield20 : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderModifiedReturnBitfield21 : { << >> } \cup { <<held>> : held \in Sample(1) },
      side                          : { << >> } \cup { <<held>> : held \in Sample(1) },
      priceLong                     : { << >> } \cup { <<held>> : held \in Sample(8) },
      execInst                      : { << >> } \cup { <<held>> : held \in Sample(1) },
      ordType                       : { << >> } \cup { <<held>> : held \in Sample(1) },
      timeInForce                   : { << >> } \cup { <<held>> : held \in Sample(1) },
      minQty                        : { << >> } \cup { <<held>> : held \in Sample(4) },
      symbolLong                    : { << >> } \cup { <<held>> : held \in Sample(8) },
      account                       : { << >> } \cup { <<held>> : held \in Sample(16) },
      clearingFirm                  : { << >> } \cup { <<held>> : held \in Sample(4) },
      clearingAccount               : { << >> } \cup { <<held>> : held \in Sample(4) },
      displayIndicator              : { << >> } \cup { <<held>> : held \in Sample(1) },
      maxFloor                      : { << >> } \cup { <<held>> : held \in Sample(4) },
      orderQtyLong                  : { << >> } \cup { <<held>> : held \in Sample(4) },
      preventMatch                  : { << >> } \cup { <<held>> : held \in Sample(3) },
      origClOrdId                   : { << >> } \cup { <<held>> : held \in Sample(20) },
      leavesQty                     : { << >> } \cup { <<held>> : held \in Sample(4) },
      lastShares                    : { << >> } \cup { <<held>> : held \in Sample(4) },
      lastPx                        : { << >> } \cup { <<held>> : held \in Sample(8) },
      displayPrice                  : { << >> } \cup { <<held>> : held \in Sample(8) },
      workingPrice                  : { << >> } \cup { <<held>> : held \in Sample(8) },
      baseLiquidityIndicator        : { << >> } \cup { <<held>> : held \in Sample(1) },
      expireTime                    : { << >> } \cup { <<held>> : held \in Sample(8) },
      secondaryOrderId              : { << >> } \cup { <<held>> : held \in Sample(8) },
      contraCapacity                : { << >> } \cup { <<held>> : held \in Sample(1) },
      attributedQuote               : { << >> } \cup { <<held>> : held \in Sample(1) },
      echoText                      : { << >> } \cup { <<held>> : held \in Sample(64) },
      stopPx                        : { << >> } \cup { <<held>> : held \in Sample(8) },
      routingInst                   : { << >> } \cup { <<held>> : held \in Sample(4) },
      routStrategy                  : { << >> } \cup { <<held>> : held \in Sample(6) },
      routeDeliveryMethod           : { << >> } \cup { <<held>> : held \in Sample(3) },
      exDestination                 : { << >> } \cup { <<held>> : held \in Sample(1) },
      marketingFeeCode              : { << >> } \cup { <<held>> : held \in Sample(2) },
      targetPartyId                 : { << >> } \cup { <<held>> : held \in Sample(4) },
      auctionId                     : { << >> } \cup { <<held>> : held \in Sample(8) },
      cmtaNumber                    : { << >> } \cup { <<held>> : held \in Sample(4) },
      crossId                       : { << >> } \cup { <<held>> : held \in Sample(20) },
      allocQty                      : { << >> } \cup { <<held>> : held \in Sample(4) },
      giveUpFirmId                  : { << >> } \cup { <<held>> : held \in Sample(4) },
      routingFirmId                 : { << >> } \cup { <<held>> : held \in Sample(4) },
      crossExclusionIndicator       : { << >> } \cup { <<held>> : held \in Sample(1) },
      frequentTraderId              : { << >> } \cup { <<held>> : held \in Sample(6) },
      comboOrder                    : { << >> } \cup { <<held>> : held \in Sample(1) },
      compression                   : { << >> } \cup { <<held>> : held \in Sample(1) },
      floorDestination              : { << >> } \cup { <<held>> : held \in Sample(4) },
      floorRoutingInst              : { << >> } \cup { <<held>> : held \in Sample(1) },
      multiClassSprd                : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderOrigin                   : { << >> } \cup { <<held>> : held \in Sample(3) },
      priceType                     : { << >> } \cup { <<held>> : held \in Sample(1) },
      strategyId                    : { << >> } \cup { <<held>> : held \in Sample(1) },
      held                          : { << >> } \cup { <<held>> : held \in Sample(1) },
      stopPxType                    : { << >> } \cup { <<held>> : held \in Sample(1) } ]

EncodeOrderModifiedMessage(message) ==
    message.transactionTime
        \o message.clOrdId
        \o message.orderId
        \o message.reserved1
        \o EncodeUIntBE(message.numberOfReturnBitfields, 1)
        \o (IF message.orderModifiedReturnBitfield1 = << >> THEN << >> ELSE EncodeUIntLE(message.orderModifiedReturnBitfield1[1], 1))
        \o (IF message.orderModifiedReturnBitfield2 = << >> THEN << >> ELSE EncodeUIntLE(message.orderModifiedReturnBitfield2[1], 1))
        \o (IF message.orderModifiedReturnBitfield3 = << >> THEN << >> ELSE EncodeUIntLE(message.orderModifiedReturnBitfield3[1], 1))
        \o (IF message.orderModifiedReturnBitfield4 = << >> THEN << >> ELSE message.orderModifiedReturnBitfield4[1])
        \o (IF message.orderModifiedReturnBitfield5 = << >> THEN << >> ELSE EncodeUIntLE(message.orderModifiedReturnBitfield5[1], 1))
        \o (IF message.orderModifiedReturnBitfield6 = << >> THEN << >> ELSE EncodeUIntLE(message.orderModifiedReturnBitfield6[1], 1))
        \o (IF message.orderModifiedReturnBitfield7 = << >> THEN << >> ELSE message.orderModifiedReturnBitfield7[1])
        \o (IF message.orderModifiedReturnBitfield8 = << >> THEN << >> ELSE EncodeUIntLE(message.orderModifiedReturnBitfield8[1], 1))
        \o (IF message.orderModifiedReturnBitfield9 = << >> THEN << >> ELSE EncodeUIntLE(message.orderModifiedReturnBitfield9[1], 1))
        \o (IF message.orderModifiedReturnBitfield10 = << >> THEN << >> ELSE EncodeUIntLE(message.orderModifiedReturnBitfield10[1], 1))
        \o (IF message.orderModifiedReturnBitfield11 = << >> THEN << >> ELSE message.orderModifiedReturnBitfield11[1])
        \o (IF message.orderModifiedReturnBitfield12 = << >> THEN << >> ELSE message.orderModifiedReturnBitfield12[1])
        \o (IF message.orderModifiedReturnBitfield13 = << >> THEN << >> ELSE message.orderModifiedReturnBitfield13[1])
        \o (IF message.orderModifiedReturnBitfield14 = << >> THEN << >> ELSE message.orderModifiedReturnBitfield14[1])
        \o (IF message.orderModifiedReturnBitfield15 = << >> THEN << >> ELSE message.orderModifiedReturnBitfield15[1])
        \o (IF message.orderModifiedReturnBitfield16 = << >> THEN << >> ELSE EncodeUIntLE(message.orderModifiedReturnBitfield16[1], 1))
        \o (IF message.orderModifiedReturnBitfield17 = << >> THEN << >> ELSE EncodeUIntLE(message.orderModifiedReturnBitfield17[1], 1))
        \o (IF message.orderModifiedReturnBitfield18 = << >> THEN << >> ELSE EncodeUIntLE(message.orderModifiedReturnBitfield18[1], 1))
        \o (IF message.orderModifiedReturnBitfield19 = << >> THEN << >> ELSE EncodeUIntLE(message.orderModifiedReturnBitfield19[1], 1))
        \o (IF message.orderModifiedReturnBitfield20 = << >> THEN << >> ELSE message.orderModifiedReturnBitfield20[1])
        \o (IF message.orderModifiedReturnBitfield21 = << >> THEN << >> ELSE message.orderModifiedReturnBitfield21[1])
        \o (IF message.side = << >> THEN << >> ELSE message.side[1])
        \o (IF message.priceLong = << >> THEN << >> ELSE message.priceLong[1])
        \o (IF message.execInst = << >> THEN << >> ELSE message.execInst[1])
        \o (IF message.ordType = << >> THEN << >> ELSE message.ordType[1])
        \o (IF message.timeInForce = << >> THEN << >> ELSE message.timeInForce[1])
        \o (IF message.minQty = << >> THEN << >> ELSE message.minQty[1])
        \o (IF message.symbolLong = << >> THEN << >> ELSE message.symbolLong[1])
        \o (IF message.account = << >> THEN << >> ELSE message.account[1])
        \o (IF message.clearingFirm = << >> THEN << >> ELSE message.clearingFirm[1])
        \o (IF message.clearingAccount = << >> THEN << >> ELSE message.clearingAccount[1])
        \o (IF message.displayIndicator = << >> THEN << >> ELSE message.displayIndicator[1])
        \o (IF message.maxFloor = << >> THEN << >> ELSE message.maxFloor[1])
        \o (IF message.orderQtyLong = << >> THEN << >> ELSE message.orderQtyLong[1])
        \o (IF message.preventMatch = << >> THEN << >> ELSE message.preventMatch[1])
        \o (IF message.origClOrdId = << >> THEN << >> ELSE message.origClOrdId[1])
        \o (IF message.leavesQty = << >> THEN << >> ELSE message.leavesQty[1])
        \o (IF message.lastShares = << >> THEN << >> ELSE message.lastShares[1])
        \o (IF message.lastPx = << >> THEN << >> ELSE message.lastPx[1])
        \o (IF message.displayPrice = << >> THEN << >> ELSE message.displayPrice[1])
        \o (IF message.workingPrice = << >> THEN << >> ELSE message.workingPrice[1])
        \o (IF message.baseLiquidityIndicator = << >> THEN << >> ELSE message.baseLiquidityIndicator[1])
        \o (IF message.expireTime = << >> THEN << >> ELSE message.expireTime[1])
        \o (IF message.secondaryOrderId = << >> THEN << >> ELSE message.secondaryOrderId[1])
        \o (IF message.contraCapacity = << >> THEN << >> ELSE message.contraCapacity[1])
        \o (IF message.attributedQuote = << >> THEN << >> ELSE message.attributedQuote[1])
        \o (IF message.echoText = << >> THEN << >> ELSE message.echoText[1])
        \o (IF message.stopPx = << >> THEN << >> ELSE message.stopPx[1])
        \o (IF message.routingInst = << >> THEN << >> ELSE message.routingInst[1])
        \o (IF message.routStrategy = << >> THEN << >> ELSE message.routStrategy[1])
        \o (IF message.routeDeliveryMethod = << >> THEN << >> ELSE message.routeDeliveryMethod[1])
        \o (IF message.exDestination = << >> THEN << >> ELSE message.exDestination[1])
        \o (IF message.marketingFeeCode = << >> THEN << >> ELSE message.marketingFeeCode[1])
        \o (IF message.targetPartyId = << >> THEN << >> ELSE message.targetPartyId[1])
        \o (IF message.auctionId = << >> THEN << >> ELSE message.auctionId[1])
        \o (IF message.cmtaNumber = << >> THEN << >> ELSE message.cmtaNumber[1])
        \o (IF message.crossId = << >> THEN << >> ELSE message.crossId[1])
        \o (IF message.allocQty = << >> THEN << >> ELSE message.allocQty[1])
        \o (IF message.giveUpFirmId = << >> THEN << >> ELSE message.giveUpFirmId[1])
        \o (IF message.routingFirmId = << >> THEN << >> ELSE message.routingFirmId[1])
        \o (IF message.crossExclusionIndicator = << >> THEN << >> ELSE message.crossExclusionIndicator[1])
        \o (IF message.frequentTraderId = << >> THEN << >> ELSE message.frequentTraderId[1])
        \o (IF message.comboOrder = << >> THEN << >> ELSE message.comboOrder[1])
        \o (IF message.compression = << >> THEN << >> ELSE message.compression[1])
        \o (IF message.floorDestination = << >> THEN << >> ELSE message.floorDestination[1])
        \o (IF message.floorRoutingInst = << >> THEN << >> ELSE message.floorRoutingInst[1])
        \o (IF message.multiClassSprd = << >> THEN << >> ELSE message.multiClassSprd[1])
        \o (IF message.orderOrigin = << >> THEN << >> ELSE message.orderOrigin[1])
        \o (IF message.priceType = << >> THEN << >> ELSE message.priceType[1])
        \o (IF message.strategyId = << >> THEN << >> ELSE message.strategyId[1])
        \o (IF message.held = << >> THEN << >> ELSE message.held[1])
        \o (IF message.stopPxType = << >> THEN << >> ELSE message.stopPxType[1])

DecodeOrderModifiedMessage(bytes) ==
    LET transactionTime == ReadBytes(bytes, 8) IN IF ~transactionTime.ok THEN Fail ELSE
    LET clOrdId == ReadBytes(transactionTime.rest, 20) IN IF ~clOrdId.ok THEN Fail ELSE
    LET orderId == ReadBytes(clOrdId.rest, 8) IN IF ~orderId.ok THEN Fail ELSE
    LET reserved1 == ReadBytes(orderId.rest, 1) IN IF ~reserved1.ok THEN Fail ELSE
    LET numberOfReturnBitfields == ReadUIntBE(reserved1.rest, 1) IN IF ~numberOfReturnBitfields.ok THEN Fail ELSE
    LET orderModifiedReturnBitfield1 == ReadWhen(numberOfReturnBitfields.value >= 1, ReadUIntLE(numberOfReturnBitfields.rest, 1), numberOfReturnBitfields.rest) IN IF ~orderModifiedReturnBitfield1.ok THEN Fail ELSE
    LET orderModifiedReturnBitfield2 == ReadWhen(numberOfReturnBitfields.value >= 2, ReadUIntLE(orderModifiedReturnBitfield1.rest, 1), orderModifiedReturnBitfield1.rest) IN IF ~orderModifiedReturnBitfield2.ok THEN Fail ELSE
    LET orderModifiedReturnBitfield3 == ReadWhen(numberOfReturnBitfields.value >= 3, ReadUIntLE(orderModifiedReturnBitfield2.rest, 1), orderModifiedReturnBitfield2.rest) IN IF ~orderModifiedReturnBitfield3.ok THEN Fail ELSE
    LET orderModifiedReturnBitfield4 == ReadWhen(numberOfReturnBitfields.value >= 4, ReadBytes(orderModifiedReturnBitfield3.rest, 1), orderModifiedReturnBitfield3.rest) IN IF ~orderModifiedReturnBitfield4.ok THEN Fail ELSE
    LET orderModifiedReturnBitfield5 == ReadWhen(numberOfReturnBitfields.value >= 5, ReadUIntLE(orderModifiedReturnBitfield4.rest, 1), orderModifiedReturnBitfield4.rest) IN IF ~orderModifiedReturnBitfield5.ok THEN Fail ELSE
    LET orderModifiedReturnBitfield6 == ReadWhen(numberOfReturnBitfields.value >= 6, ReadUIntLE(orderModifiedReturnBitfield5.rest, 1), orderModifiedReturnBitfield5.rest) IN IF ~orderModifiedReturnBitfield6.ok THEN Fail ELSE
    LET orderModifiedReturnBitfield7 == ReadWhen(numberOfReturnBitfields.value >= 7, ReadBytes(orderModifiedReturnBitfield6.rest, 1), orderModifiedReturnBitfield6.rest) IN IF ~orderModifiedReturnBitfield7.ok THEN Fail ELSE
    LET orderModifiedReturnBitfield8 == ReadWhen(numberOfReturnBitfields.value >= 8, ReadUIntLE(orderModifiedReturnBitfield7.rest, 1), orderModifiedReturnBitfield7.rest) IN IF ~orderModifiedReturnBitfield8.ok THEN Fail ELSE
    LET orderModifiedReturnBitfield9 == ReadWhen(numberOfReturnBitfields.value >= 9, ReadUIntLE(orderModifiedReturnBitfield8.rest, 1), orderModifiedReturnBitfield8.rest) IN IF ~orderModifiedReturnBitfield9.ok THEN Fail ELSE
    LET orderModifiedReturnBitfield10 == ReadWhen(numberOfReturnBitfields.value >= 10, ReadUIntLE(orderModifiedReturnBitfield9.rest, 1), orderModifiedReturnBitfield9.rest) IN IF ~orderModifiedReturnBitfield10.ok THEN Fail ELSE
    LET orderModifiedReturnBitfield11 == ReadWhen(numberOfReturnBitfields.value >= 11, ReadBytes(orderModifiedReturnBitfield10.rest, 1), orderModifiedReturnBitfield10.rest) IN IF ~orderModifiedReturnBitfield11.ok THEN Fail ELSE
    LET orderModifiedReturnBitfield12 == ReadWhen(numberOfReturnBitfields.value >= 12, ReadBytes(orderModifiedReturnBitfield11.rest, 1), orderModifiedReturnBitfield11.rest) IN IF ~orderModifiedReturnBitfield12.ok THEN Fail ELSE
    LET orderModifiedReturnBitfield13 == ReadWhen(numberOfReturnBitfields.value >= 13, ReadBytes(orderModifiedReturnBitfield12.rest, 1), orderModifiedReturnBitfield12.rest) IN IF ~orderModifiedReturnBitfield13.ok THEN Fail ELSE
    LET orderModifiedReturnBitfield14 == ReadWhen(numberOfReturnBitfields.value >= 14, ReadBytes(orderModifiedReturnBitfield13.rest, 1), orderModifiedReturnBitfield13.rest) IN IF ~orderModifiedReturnBitfield14.ok THEN Fail ELSE
    LET orderModifiedReturnBitfield15 == ReadWhen(numberOfReturnBitfields.value >= 15, ReadBytes(orderModifiedReturnBitfield14.rest, 1), orderModifiedReturnBitfield14.rest) IN IF ~orderModifiedReturnBitfield15.ok THEN Fail ELSE
    LET orderModifiedReturnBitfield16 == ReadWhen(numberOfReturnBitfields.value >= 16, ReadUIntLE(orderModifiedReturnBitfield15.rest, 1), orderModifiedReturnBitfield15.rest) IN IF ~orderModifiedReturnBitfield16.ok THEN Fail ELSE
    LET orderModifiedReturnBitfield17 == ReadWhen(numberOfReturnBitfields.value >= 17, ReadUIntLE(orderModifiedReturnBitfield16.rest, 1), orderModifiedReturnBitfield16.rest) IN IF ~orderModifiedReturnBitfield17.ok THEN Fail ELSE
    LET orderModifiedReturnBitfield18 == ReadWhen(numberOfReturnBitfields.value >= 18, ReadUIntLE(orderModifiedReturnBitfield17.rest, 1), orderModifiedReturnBitfield17.rest) IN IF ~orderModifiedReturnBitfield18.ok THEN Fail ELSE
    LET orderModifiedReturnBitfield19 == ReadWhen(numberOfReturnBitfields.value >= 19, ReadUIntLE(orderModifiedReturnBitfield18.rest, 1), orderModifiedReturnBitfield18.rest) IN IF ~orderModifiedReturnBitfield19.ok THEN Fail ELSE
    LET orderModifiedReturnBitfield20 == ReadWhen(numberOfReturnBitfields.value >= 20, ReadBytes(orderModifiedReturnBitfield19.rest, 1), orderModifiedReturnBitfield19.rest) IN IF ~orderModifiedReturnBitfield20.ok THEN Fail ELSE
    LET orderModifiedReturnBitfield21 == ReadWhen(numberOfReturnBitfields.value >= 21, ReadBytes(orderModifiedReturnBitfield20.rest, 1), orderModifiedReturnBitfield20.rest) IN IF ~orderModifiedReturnBitfield21.ok THEN Fail ELSE
    LET side == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderModifiedReturnBitfield1.value # << >> /\ orderModifiedReturnBitfield1.value[1] % 2 > 0), ReadBytes(orderModifiedReturnBitfield21.rest, 1), orderModifiedReturnBitfield21.rest) IN IF ~side.ok THEN Fail ELSE
    LET priceLong == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderModifiedReturnBitfield1.value # << >> /\ (orderModifiedReturnBitfield1.value[1] \div 4) % 2 > 0), ReadBytes(side.rest, 8), side.rest) IN IF ~priceLong.ok THEN Fail ELSE
    LET execInst == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderModifiedReturnBitfield1.value # << >> /\ (orderModifiedReturnBitfield1.value[1] \div 8) % 2 > 0), ReadBytes(priceLong.rest, 1), priceLong.rest) IN IF ~execInst.ok THEN Fail ELSE
    LET ordType == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderModifiedReturnBitfield1.value # << >> /\ (orderModifiedReturnBitfield1.value[1] \div 16) % 2 > 0), ReadBytes(execInst.rest, 1), execInst.rest) IN IF ~ordType.ok THEN Fail ELSE
    LET timeInForce == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderModifiedReturnBitfield1.value # << >> /\ (orderModifiedReturnBitfield1.value[1] \div 32) % 2 > 0), ReadBytes(ordType.rest, 1), ordType.rest) IN IF ~timeInForce.ok THEN Fail ELSE
    LET minQty == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderModifiedReturnBitfield1.value # << >> /\ (orderModifiedReturnBitfield1.value[1] \div 64) % 2 > 0), ReadBytes(timeInForce.rest, 4), timeInForce.rest) IN IF ~minQty.ok THEN Fail ELSE
    LET symbolLong == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (orderModifiedReturnBitfield2.value # << >> /\ orderModifiedReturnBitfield2.value[1] % 2 > 0), ReadBytes(minQty.rest, 8), minQty.rest) IN IF ~symbolLong.ok THEN Fail ELSE
    LET account == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderModifiedReturnBitfield3.value # << >> /\ orderModifiedReturnBitfield3.value[1] % 2 > 0), ReadBytes(symbolLong.rest, 16), symbolLong.rest) IN IF ~account.ok THEN Fail ELSE
    LET clearingFirm == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderModifiedReturnBitfield3.value # << >> /\ (orderModifiedReturnBitfield3.value[1] \div 2) % 2 > 0), ReadBytes(account.rest, 4), account.rest) IN IF ~clearingFirm.ok THEN Fail ELSE
    LET clearingAccount == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderModifiedReturnBitfield3.value # << >> /\ (orderModifiedReturnBitfield3.value[1] \div 4) % 2 > 0), ReadBytes(clearingFirm.rest, 4), clearingFirm.rest) IN IF ~clearingAccount.ok THEN Fail ELSE
    LET displayIndicator == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderModifiedReturnBitfield3.value # << >> /\ (orderModifiedReturnBitfield3.value[1] \div 8) % 2 > 0), ReadBytes(clearingAccount.rest, 1), clearingAccount.rest) IN IF ~displayIndicator.ok THEN Fail ELSE
    LET maxFloor == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderModifiedReturnBitfield3.value # << >> /\ (orderModifiedReturnBitfield3.value[1] \div 16) % 2 > 0), ReadBytes(displayIndicator.rest, 4), displayIndicator.rest) IN IF ~maxFloor.ok THEN Fail ELSE
    LET orderQtyLong == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderModifiedReturnBitfield3.value # << >> /\ (orderModifiedReturnBitfield3.value[1] \div 64) % 2 > 0), ReadBytes(maxFloor.rest, 4), maxFloor.rest) IN IF ~orderQtyLong.ok THEN Fail ELSE
    LET preventMatch == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderModifiedReturnBitfield3.value # << >> /\ (orderModifiedReturnBitfield3.value[1] \div 128) % 2 > 0), ReadBytes(orderQtyLong.rest, 3), orderQtyLong.rest) IN IF ~preventMatch.ok THEN Fail ELSE
    LET origClOrdId == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderModifiedReturnBitfield5.value # << >> /\ orderModifiedReturnBitfield5.value[1] % 2 > 0), ReadBytes(preventMatch.rest, 20), preventMatch.rest) IN IF ~origClOrdId.ok THEN Fail ELSE
    LET leavesQty == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderModifiedReturnBitfield5.value # << >> /\ (orderModifiedReturnBitfield5.value[1] \div 2) % 2 > 0), ReadBytes(origClOrdId.rest, 4), origClOrdId.rest) IN IF ~leavesQty.ok THEN Fail ELSE
    LET lastShares == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderModifiedReturnBitfield5.value # << >> /\ (orderModifiedReturnBitfield5.value[1] \div 4) % 2 > 0), ReadBytes(leavesQty.rest, 4), leavesQty.rest) IN IF ~lastShares.ok THEN Fail ELSE
    LET lastPx == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderModifiedReturnBitfield5.value # << >> /\ (orderModifiedReturnBitfield5.value[1] \div 8) % 2 > 0), ReadBytes(lastShares.rest, 8), lastShares.rest) IN IF ~lastPx.ok THEN Fail ELSE
    LET displayPrice == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderModifiedReturnBitfield5.value # << >> /\ (orderModifiedReturnBitfield5.value[1] \div 16) % 2 > 0), ReadBytes(lastPx.rest, 8), lastPx.rest) IN IF ~displayPrice.ok THEN Fail ELSE
    LET workingPrice == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderModifiedReturnBitfield5.value # << >> /\ (orderModifiedReturnBitfield5.value[1] \div 32) % 2 > 0), ReadBytes(displayPrice.rest, 8), displayPrice.rest) IN IF ~workingPrice.ok THEN Fail ELSE
    LET baseLiquidityIndicator == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderModifiedReturnBitfield5.value # << >> /\ (orderModifiedReturnBitfield5.value[1] \div 64) % 2 > 0), ReadBytes(workingPrice.rest, 1), workingPrice.rest) IN IF ~baseLiquidityIndicator.ok THEN Fail ELSE
    LET expireTime == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderModifiedReturnBitfield5.value # << >> /\ (orderModifiedReturnBitfield5.value[1] \div 128) % 2 > 0), ReadBytes(baseLiquidityIndicator.rest, 8), baseLiquidityIndicator.rest) IN IF ~expireTime.ok THEN Fail ELSE
    LET secondaryOrderId == ReadWhen(numberOfReturnBitfields.value >= 6 /\ (orderModifiedReturnBitfield6.value # << >> /\ orderModifiedReturnBitfield6.value[1] % 2 > 0), ReadBytes(expireTime.rest, 8), expireTime.rest) IN IF ~secondaryOrderId.ok THEN Fail ELSE
    LET contraCapacity == ReadWhen(numberOfReturnBitfields.value >= 6 /\ (orderModifiedReturnBitfield6.value # << >> /\ (orderModifiedReturnBitfield6.value[1] \div 4) % 2 > 0), ReadBytes(secondaryOrderId.rest, 1), secondaryOrderId.rest) IN IF ~contraCapacity.ok THEN Fail ELSE
    LET attributedQuote == ReadWhen(numberOfReturnBitfields.value >= 6 /\ (orderModifiedReturnBitfield6.value # << >> /\ (orderModifiedReturnBitfield6.value[1] \div 8) % 2 > 0), ReadBytes(contraCapacity.rest, 1), contraCapacity.rest) IN IF ~attributedQuote.ok THEN Fail ELSE
    LET echoText == ReadWhen(numberOfReturnBitfields.value >= 8 /\ (orderModifiedReturnBitfield8.value # << >> /\ (orderModifiedReturnBitfield8.value[1] \div 2) % 2 > 0), ReadBytes(attributedQuote.rest, 64), attributedQuote.rest) IN IF ~echoText.ok THEN Fail ELSE
    LET stopPx == ReadWhen(numberOfReturnBitfields.value >= 8 /\ (orderModifiedReturnBitfield8.value # << >> /\ (orderModifiedReturnBitfield8.value[1] \div 4) % 2 > 0), ReadBytes(echoText.rest, 8), echoText.rest) IN IF ~stopPx.ok THEN Fail ELSE
    LET routingInst == ReadWhen(numberOfReturnBitfields.value >= 8 /\ (orderModifiedReturnBitfield8.value # << >> /\ (orderModifiedReturnBitfield8.value[1] \div 8) % 2 > 0), ReadBytes(stopPx.rest, 4), stopPx.rest) IN IF ~routingInst.ok THEN Fail ELSE
    LET routStrategy == ReadWhen(numberOfReturnBitfields.value >= 8 /\ (orderModifiedReturnBitfield8.value # << >> /\ (orderModifiedReturnBitfield8.value[1] \div 16) % 2 > 0), ReadBytes(routingInst.rest, 6), routingInst.rest) IN IF ~routStrategy.ok THEN Fail ELSE
    LET routeDeliveryMethod == ReadWhen(numberOfReturnBitfields.value >= 8 /\ (orderModifiedReturnBitfield8.value # << >> /\ (orderModifiedReturnBitfield8.value[1] \div 32) % 2 > 0), ReadBytes(routStrategy.rest, 3), routStrategy.rest) IN IF ~routeDeliveryMethod.ok THEN Fail ELSE
    LET exDestination == ReadWhen(numberOfReturnBitfields.value >= 8 /\ (orderModifiedReturnBitfield8.value # << >> /\ (orderModifiedReturnBitfield8.value[1] \div 64) % 2 > 0), ReadBytes(routeDeliveryMethod.rest, 1), routeDeliveryMethod.rest) IN IF ~exDestination.ok THEN Fail ELSE
    LET marketingFeeCode == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (orderModifiedReturnBitfield9.value # << >> /\ orderModifiedReturnBitfield9.value[1] % 2 > 0), ReadBytes(exDestination.rest, 2), exDestination.rest) IN IF ~marketingFeeCode.ok THEN Fail ELSE
    LET targetPartyId == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (orderModifiedReturnBitfield9.value # << >> /\ (orderModifiedReturnBitfield9.value[1] \div 2) % 2 > 0), ReadBytes(marketingFeeCode.rest, 4), marketingFeeCode.rest) IN IF ~targetPartyId.ok THEN Fail ELSE
    LET auctionId == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (orderModifiedReturnBitfield9.value # << >> /\ (orderModifiedReturnBitfield9.value[1] \div 4) % 2 > 0), ReadBytes(targetPartyId.rest, 8), targetPartyId.rest) IN IF ~auctionId.ok THEN Fail ELSE
    LET cmtaNumber == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (orderModifiedReturnBitfield9.value # << >> /\ (orderModifiedReturnBitfield9.value[1] \div 32) % 2 > 0), ReadBytes(auctionId.rest, 4), auctionId.rest) IN IF ~cmtaNumber.ok THEN Fail ELSE
    LET crossId == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (orderModifiedReturnBitfield10.value # << >> /\ orderModifiedReturnBitfield10.value[1] % 2 > 0), ReadBytes(cmtaNumber.rest, 20), cmtaNumber.rest) IN IF ~crossId.ok THEN Fail ELSE
    LET allocQty == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (orderModifiedReturnBitfield10.value # << >> /\ (orderModifiedReturnBitfield10.value[1] \div 2) % 2 > 0), ReadBytes(crossId.rest, 4), crossId.rest) IN IF ~allocQty.ok THEN Fail ELSE
    LET giveUpFirmId == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (orderModifiedReturnBitfield10.value # << >> /\ (orderModifiedReturnBitfield10.value[1] \div 4) % 2 > 0), ReadBytes(allocQty.rest, 4), allocQty.rest) IN IF ~giveUpFirmId.ok THEN Fail ELSE
    LET routingFirmId == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (orderModifiedReturnBitfield10.value # << >> /\ (orderModifiedReturnBitfield10.value[1] \div 8) % 2 > 0), ReadBytes(giveUpFirmId.rest, 4), giveUpFirmId.rest) IN IF ~routingFirmId.ok THEN Fail ELSE
    LET crossExclusionIndicator == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (orderModifiedReturnBitfield10.value # << >> /\ (orderModifiedReturnBitfield10.value[1] \div 32) % 2 > 0), ReadBytes(routingFirmId.rest, 1), routingFirmId.rest) IN IF ~crossExclusionIndicator.ok THEN Fail ELSE
    LET frequentTraderId == ReadWhen(numberOfReturnBitfields.value >= 16 /\ (orderModifiedReturnBitfield16.value # << >> /\ orderModifiedReturnBitfield16.value[1] % 2 > 0), ReadBytes(crossExclusionIndicator.rest, 6), crossExclusionIndicator.rest) IN IF ~frequentTraderId.ok THEN Fail ELSE
    LET comboOrder == ReadWhen(numberOfReturnBitfields.value >= 16 /\ (orderModifiedReturnBitfield16.value # << >> /\ (orderModifiedReturnBitfield16.value[1] \div 4) % 2 > 0), ReadBytes(frequentTraderId.rest, 1), frequentTraderId.rest) IN IF ~comboOrder.ok THEN Fail ELSE
    LET compression == ReadWhen(numberOfReturnBitfields.value >= 16 /\ (orderModifiedReturnBitfield16.value # << >> /\ (orderModifiedReturnBitfield16.value[1] \div 8) % 2 > 0), ReadBytes(comboOrder.rest, 1), comboOrder.rest) IN IF ~compression.ok THEN Fail ELSE
    LET floorDestination == ReadWhen(numberOfReturnBitfields.value >= 16 /\ (orderModifiedReturnBitfield16.value # << >> /\ (orderModifiedReturnBitfield16.value[1] \div 16) % 2 > 0), ReadBytes(compression.rest, 4), compression.rest) IN IF ~floorDestination.ok THEN Fail ELSE
    LET floorRoutingInst == ReadWhen(numberOfReturnBitfields.value >= 16 /\ (orderModifiedReturnBitfield16.value # << >> /\ (orderModifiedReturnBitfield16.value[1] \div 32) % 2 > 0), ReadBytes(floorDestination.rest, 1), floorDestination.rest) IN IF ~floorRoutingInst.ok THEN Fail ELSE
    LET multiClassSprd == ReadWhen(numberOfReturnBitfields.value >= 16 /\ (orderModifiedReturnBitfield16.value # << >> /\ (orderModifiedReturnBitfield16.value[1] \div 64) % 2 > 0), ReadBytes(floorRoutingInst.rest, 1), floorRoutingInst.rest) IN IF ~multiClassSprd.ok THEN Fail ELSE
    LET orderOrigin == ReadWhen(numberOfReturnBitfields.value >= 16 /\ (orderModifiedReturnBitfield16.value # << >> /\ (orderModifiedReturnBitfield16.value[1] \div 128) % 2 > 0), ReadBytes(multiClassSprd.rest, 3), multiClassSprd.rest) IN IF ~orderOrigin.ok THEN Fail ELSE
    LET priceType == ReadWhen(numberOfReturnBitfields.value >= 17 /\ (orderModifiedReturnBitfield17.value # << >> /\ orderModifiedReturnBitfield17.value[1] % 2 > 0), ReadBytes(orderOrigin.rest, 1), orderOrigin.rest) IN IF ~priceType.ok THEN Fail ELSE
    LET strategyId == ReadWhen(numberOfReturnBitfields.value >= 17 /\ (orderModifiedReturnBitfield17.value # << >> /\ (orderModifiedReturnBitfield17.value[1] \div 2) % 2 > 0), ReadBytes(priceType.rest, 1), priceType.rest) IN IF ~strategyId.ok THEN Fail ELSE
    LET held == ReadWhen(numberOfReturnBitfields.value >= 18 /\ (orderModifiedReturnBitfield18.value # << >> /\ (orderModifiedReturnBitfield18.value[1] \div 32) % 2 > 0), ReadBytes(strategyId.rest, 1), strategyId.rest) IN IF ~held.ok THEN Fail ELSE
    LET stopPxType == ReadWhen(numberOfReturnBitfields.value >= 19 /\ (orderModifiedReturnBitfield19.value # << >> /\ (orderModifiedReturnBitfield19.value[1] \div 64) % 2 > 0), ReadBytes(held.rest, 1), held.rest) IN IF ~stopPxType.ok THEN Fail ELSE
    Ok([ transactionTime               |-> transactionTime.value,
         clOrdId                       |-> clOrdId.value,
         orderId                       |-> orderId.value,
         reserved1                     |-> reserved1.value,
         numberOfReturnBitfields       |-> numberOfReturnBitfields.value,
         orderModifiedReturnBitfield1  |-> orderModifiedReturnBitfield1.value,
         orderModifiedReturnBitfield2  |-> orderModifiedReturnBitfield2.value,
         orderModifiedReturnBitfield3  |-> orderModifiedReturnBitfield3.value,
         orderModifiedReturnBitfield4  |-> orderModifiedReturnBitfield4.value,
         orderModifiedReturnBitfield5  |-> orderModifiedReturnBitfield5.value,
         orderModifiedReturnBitfield6  |-> orderModifiedReturnBitfield6.value,
         orderModifiedReturnBitfield7  |-> orderModifiedReturnBitfield7.value,
         orderModifiedReturnBitfield8  |-> orderModifiedReturnBitfield8.value,
         orderModifiedReturnBitfield9  |-> orderModifiedReturnBitfield9.value,
         orderModifiedReturnBitfield10 |-> orderModifiedReturnBitfield10.value,
         orderModifiedReturnBitfield11 |-> orderModifiedReturnBitfield11.value,
         orderModifiedReturnBitfield12 |-> orderModifiedReturnBitfield12.value,
         orderModifiedReturnBitfield13 |-> orderModifiedReturnBitfield13.value,
         orderModifiedReturnBitfield14 |-> orderModifiedReturnBitfield14.value,
         orderModifiedReturnBitfield15 |-> orderModifiedReturnBitfield15.value,
         orderModifiedReturnBitfield16 |-> orderModifiedReturnBitfield16.value,
         orderModifiedReturnBitfield17 |-> orderModifiedReturnBitfield17.value,
         orderModifiedReturnBitfield18 |-> orderModifiedReturnBitfield18.value,
         orderModifiedReturnBitfield19 |-> orderModifiedReturnBitfield19.value,
         orderModifiedReturnBitfield20 |-> orderModifiedReturnBitfield20.value,
         orderModifiedReturnBitfield21 |-> orderModifiedReturnBitfield21.value,
         side                          |-> side.value,
         priceLong                     |-> priceLong.value,
         execInst                      |-> execInst.value,
         ordType                       |-> ordType.value,
         timeInForce                   |-> timeInForce.value,
         minQty                        |-> minQty.value,
         symbolLong                    |-> symbolLong.value,
         account                       |-> account.value,
         clearingFirm                  |-> clearingFirm.value,
         clearingAccount               |-> clearingAccount.value,
         displayIndicator              |-> displayIndicator.value,
         maxFloor                      |-> maxFloor.value,
         orderQtyLong                  |-> orderQtyLong.value,
         preventMatch                  |-> preventMatch.value,
         origClOrdId                   |-> origClOrdId.value,
         leavesQty                     |-> leavesQty.value,
         lastShares                    |-> lastShares.value,
         lastPx                        |-> lastPx.value,
         displayPrice                  |-> displayPrice.value,
         workingPrice                  |-> workingPrice.value,
         baseLiquidityIndicator        |-> baseLiquidityIndicator.value,
         expireTime                    |-> expireTime.value,
         secondaryOrderId              |-> secondaryOrderId.value,
         contraCapacity                |-> contraCapacity.value,
         attributedQuote               |-> attributedQuote.value,
         echoText                      |-> echoText.value,
         stopPx                        |-> stopPx.value,
         routingInst                   |-> routingInst.value,
         routStrategy                  |-> routStrategy.value,
         routeDeliveryMethod           |-> routeDeliveryMethod.value,
         exDestination                 |-> exDestination.value,
         marketingFeeCode              |-> marketingFeeCode.value,
         targetPartyId                 |-> targetPartyId.value,
         auctionId                     |-> auctionId.value,
         cmtaNumber                    |-> cmtaNumber.value,
         crossId                       |-> crossId.value,
         allocQty                      |-> allocQty.value,
         giveUpFirmId                  |-> giveUpFirmId.value,
         routingFirmId                 |-> routingFirmId.value,
         crossExclusionIndicator       |-> crossExclusionIndicator.value,
         frequentTraderId              |-> frequentTraderId.value,
         comboOrder                    |-> comboOrder.value,
         compression                   |-> compression.value,
         floorDestination              |-> floorDestination.value,
         floorRoutingInst              |-> floorRoutingInst.value,
         multiClassSprd                |-> multiClassSprd.value,
         orderOrigin                   |-> orderOrigin.value,
         priceType                     |-> priceType.value,
         strategyId                    |-> strategyId.value,
         held                          |-> held.value,
         stopPxType                    |-> stopPxType.value ], stopPxType.rest)

(* Order Modified Message with each field marked present by fields before it there exactly where they say *)
SettleOrderModifiedMessage(message) ==
    LET settled1 == [message EXCEPT !.orderModifiedReturnBitfield1 = IF message.numberOfReturnBitfields >= 1 THEN (IF message.orderModifiedReturnBitfield1 = << >> THEN <<0>> ELSE message.orderModifiedReturnBitfield1) ELSE << >>]
        settled2 == [settled1 EXCEPT !.orderModifiedReturnBitfield2 = IF settled1.numberOfReturnBitfields >= 2 THEN (IF settled1.orderModifiedReturnBitfield2 = << >> THEN <<0>> ELSE settled1.orderModifiedReturnBitfield2) ELSE << >>]
        settled3 == [settled2 EXCEPT !.orderModifiedReturnBitfield3 = IF settled2.numberOfReturnBitfields >= 3 THEN (IF settled2.orderModifiedReturnBitfield3 = << >> THEN <<0>> ELSE settled2.orderModifiedReturnBitfield3) ELSE << >>]
        settled4 == [settled3 EXCEPT !.orderModifiedReturnBitfield4 = IF settled3.numberOfReturnBitfields >= 4 THEN (IF settled3.orderModifiedReturnBitfield4 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled3.orderModifiedReturnBitfield4) ELSE << >>]
        settled5 == [settled4 EXCEPT !.orderModifiedReturnBitfield5 = IF settled4.numberOfReturnBitfields >= 5 THEN (IF settled4.orderModifiedReturnBitfield5 = << >> THEN <<0>> ELSE settled4.orderModifiedReturnBitfield5) ELSE << >>]
        settled6 == [settled5 EXCEPT !.orderModifiedReturnBitfield6 = IF settled5.numberOfReturnBitfields >= 6 THEN (IF settled5.orderModifiedReturnBitfield6 = << >> THEN <<0>> ELSE settled5.orderModifiedReturnBitfield6) ELSE << >>]
        settled7 == [settled6 EXCEPT !.orderModifiedReturnBitfield7 = IF settled6.numberOfReturnBitfields >= 7 THEN (IF settled6.orderModifiedReturnBitfield7 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled6.orderModifiedReturnBitfield7) ELSE << >>]
        settled8 == [settled7 EXCEPT !.orderModifiedReturnBitfield8 = IF settled7.numberOfReturnBitfields >= 8 THEN (IF settled7.orderModifiedReturnBitfield8 = << >> THEN <<0>> ELSE settled7.orderModifiedReturnBitfield8) ELSE << >>]
        settled9 == [settled8 EXCEPT !.orderModifiedReturnBitfield9 = IF settled8.numberOfReturnBitfields >= 9 THEN (IF settled8.orderModifiedReturnBitfield9 = << >> THEN <<0>> ELSE settled8.orderModifiedReturnBitfield9) ELSE << >>]
        settled10 == [settled9 EXCEPT !.orderModifiedReturnBitfield10 = IF settled9.numberOfReturnBitfields >= 10 THEN (IF settled9.orderModifiedReturnBitfield10 = << >> THEN <<0>> ELSE settled9.orderModifiedReturnBitfield10) ELSE << >>]
        settled11 == [settled10 EXCEPT !.orderModifiedReturnBitfield11 = IF settled10.numberOfReturnBitfields >= 11 THEN (IF settled10.orderModifiedReturnBitfield11 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled10.orderModifiedReturnBitfield11) ELSE << >>]
        settled12 == [settled11 EXCEPT !.orderModifiedReturnBitfield12 = IF settled11.numberOfReturnBitfields >= 12 THEN (IF settled11.orderModifiedReturnBitfield12 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled11.orderModifiedReturnBitfield12) ELSE << >>]
        settled13 == [settled12 EXCEPT !.orderModifiedReturnBitfield13 = IF settled12.numberOfReturnBitfields >= 13 THEN (IF settled12.orderModifiedReturnBitfield13 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled12.orderModifiedReturnBitfield13) ELSE << >>]
        settled14 == [settled13 EXCEPT !.orderModifiedReturnBitfield14 = IF settled13.numberOfReturnBitfields >= 14 THEN (IF settled13.orderModifiedReturnBitfield14 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled13.orderModifiedReturnBitfield14) ELSE << >>]
        settled15 == [settled14 EXCEPT !.orderModifiedReturnBitfield15 = IF settled14.numberOfReturnBitfields >= 15 THEN (IF settled14.orderModifiedReturnBitfield15 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled14.orderModifiedReturnBitfield15) ELSE << >>]
        settled16 == [settled15 EXCEPT !.orderModifiedReturnBitfield16 = IF settled15.numberOfReturnBitfields >= 16 THEN (IF settled15.orderModifiedReturnBitfield16 = << >> THEN <<0>> ELSE settled15.orderModifiedReturnBitfield16) ELSE << >>]
        settled17 == [settled16 EXCEPT !.orderModifiedReturnBitfield17 = IF settled16.numberOfReturnBitfields >= 17 THEN (IF settled16.orderModifiedReturnBitfield17 = << >> THEN <<0>> ELSE settled16.orderModifiedReturnBitfield17) ELSE << >>]
        settled18 == [settled17 EXCEPT !.orderModifiedReturnBitfield18 = IF settled17.numberOfReturnBitfields >= 18 THEN (IF settled17.orderModifiedReturnBitfield18 = << >> THEN <<0>> ELSE settled17.orderModifiedReturnBitfield18) ELSE << >>]
        settled19 == [settled18 EXCEPT !.orderModifiedReturnBitfield19 = IF settled18.numberOfReturnBitfields >= 19 THEN (IF settled18.orderModifiedReturnBitfield19 = << >> THEN <<0>> ELSE settled18.orderModifiedReturnBitfield19) ELSE << >>]
        settled20 == [settled19 EXCEPT !.orderModifiedReturnBitfield20 = IF settled19.numberOfReturnBitfields >= 20 THEN (IF settled19.orderModifiedReturnBitfield20 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled19.orderModifiedReturnBitfield20) ELSE << >>]
        settled21 == [settled20 EXCEPT !.orderModifiedReturnBitfield21 = IF settled20.numberOfReturnBitfields >= 21 THEN (IF settled20.orderModifiedReturnBitfield21 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled20.orderModifiedReturnBitfield21) ELSE << >>]
        settled22 == [settled21 EXCEPT !.side = IF settled21.numberOfReturnBitfields >= 1 /\ (settled21.orderModifiedReturnBitfield1 # << >> /\ settled21.orderModifiedReturnBitfield1[1] % 2 > 0) THEN (IF settled21.side = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled21.side) ELSE << >>]
        settled23 == [settled22 EXCEPT !.priceLong = IF settled22.numberOfReturnBitfields >= 1 /\ (settled22.orderModifiedReturnBitfield1 # << >> /\ (settled22.orderModifiedReturnBitfield1[1] \div 4) % 2 > 0) THEN (IF settled22.priceLong = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled22.priceLong) ELSE << >>]
        settled24 == [settled23 EXCEPT !.execInst = IF settled23.numberOfReturnBitfields >= 1 /\ (settled23.orderModifiedReturnBitfield1 # << >> /\ (settled23.orderModifiedReturnBitfield1[1] \div 8) % 2 > 0) THEN (IF settled23.execInst = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled23.execInst) ELSE << >>]
        settled25 == [settled24 EXCEPT !.ordType = IF settled24.numberOfReturnBitfields >= 1 /\ (settled24.orderModifiedReturnBitfield1 # << >> /\ (settled24.orderModifiedReturnBitfield1[1] \div 16) % 2 > 0) THEN (IF settled24.ordType = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled24.ordType) ELSE << >>]
        settled26 == [settled25 EXCEPT !.timeInForce = IF settled25.numberOfReturnBitfields >= 1 /\ (settled25.orderModifiedReturnBitfield1 # << >> /\ (settled25.orderModifiedReturnBitfield1[1] \div 32) % 2 > 0) THEN (IF settled25.timeInForce = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled25.timeInForce) ELSE << >>]
        settled27 == [settled26 EXCEPT !.minQty = IF settled26.numberOfReturnBitfields >= 1 /\ (settled26.orderModifiedReturnBitfield1 # << >> /\ (settled26.orderModifiedReturnBitfield1[1] \div 64) % 2 > 0) THEN (IF settled26.minQty = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled26.minQty) ELSE << >>]
        settled28 == [settled27 EXCEPT !.symbolLong = IF settled27.numberOfReturnBitfields >= 2 /\ (settled27.orderModifiedReturnBitfield2 # << >> /\ settled27.orderModifiedReturnBitfield2[1] % 2 > 0) THEN (IF settled27.symbolLong = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled27.symbolLong) ELSE << >>]
        settled29 == [settled28 EXCEPT !.account = IF settled28.numberOfReturnBitfields >= 3 /\ (settled28.orderModifiedReturnBitfield3 # << >> /\ settled28.orderModifiedReturnBitfield3[1] % 2 > 0) THEN (IF settled28.account = << >> THEN <<[i \in 1 .. 16 |-> 0]>> ELSE settled28.account) ELSE << >>]
        settled30 == [settled29 EXCEPT !.clearingFirm = IF settled29.numberOfReturnBitfields >= 3 /\ (settled29.orderModifiedReturnBitfield3 # << >> /\ (settled29.orderModifiedReturnBitfield3[1] \div 2) % 2 > 0) THEN (IF settled29.clearingFirm = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled29.clearingFirm) ELSE << >>]
        settled31 == [settled30 EXCEPT !.clearingAccount = IF settled30.numberOfReturnBitfields >= 3 /\ (settled30.orderModifiedReturnBitfield3 # << >> /\ (settled30.orderModifiedReturnBitfield3[1] \div 4) % 2 > 0) THEN (IF settled30.clearingAccount = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled30.clearingAccount) ELSE << >>]
        settled32 == [settled31 EXCEPT !.displayIndicator = IF settled31.numberOfReturnBitfields >= 3 /\ (settled31.orderModifiedReturnBitfield3 # << >> /\ (settled31.orderModifiedReturnBitfield3[1] \div 8) % 2 > 0) THEN (IF settled31.displayIndicator = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled31.displayIndicator) ELSE << >>]
        settled33 == [settled32 EXCEPT !.maxFloor = IF settled32.numberOfReturnBitfields >= 3 /\ (settled32.orderModifiedReturnBitfield3 # << >> /\ (settled32.orderModifiedReturnBitfield3[1] \div 16) % 2 > 0) THEN (IF settled32.maxFloor = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled32.maxFloor) ELSE << >>]
        settled34 == [settled33 EXCEPT !.orderQtyLong = IF settled33.numberOfReturnBitfields >= 3 /\ (settled33.orderModifiedReturnBitfield3 # << >> /\ (settled33.orderModifiedReturnBitfield3[1] \div 64) % 2 > 0) THEN (IF settled33.orderQtyLong = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled33.orderQtyLong) ELSE << >>]
        settled35 == [settled34 EXCEPT !.preventMatch = IF settled34.numberOfReturnBitfields >= 3 /\ (settled34.orderModifiedReturnBitfield3 # << >> /\ (settled34.orderModifiedReturnBitfield3[1] \div 128) % 2 > 0) THEN (IF settled34.preventMatch = << >> THEN <<[i \in 1 .. 3 |-> 0]>> ELSE settled34.preventMatch) ELSE << >>]
        settled36 == [settled35 EXCEPT !.origClOrdId = IF settled35.numberOfReturnBitfields >= 5 /\ (settled35.orderModifiedReturnBitfield5 # << >> /\ settled35.orderModifiedReturnBitfield5[1] % 2 > 0) THEN (IF settled35.origClOrdId = << >> THEN <<[i \in 1 .. 20 |-> 0]>> ELSE settled35.origClOrdId) ELSE << >>]
        settled37 == [settled36 EXCEPT !.leavesQty = IF settled36.numberOfReturnBitfields >= 5 /\ (settled36.orderModifiedReturnBitfield5 # << >> /\ (settled36.orderModifiedReturnBitfield5[1] \div 2) % 2 > 0) THEN (IF settled36.leavesQty = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled36.leavesQty) ELSE << >>]
        settled38 == [settled37 EXCEPT !.lastShares = IF settled37.numberOfReturnBitfields >= 5 /\ (settled37.orderModifiedReturnBitfield5 # << >> /\ (settled37.orderModifiedReturnBitfield5[1] \div 4) % 2 > 0) THEN (IF settled37.lastShares = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled37.lastShares) ELSE << >>]
        settled39 == [settled38 EXCEPT !.lastPx = IF settled38.numberOfReturnBitfields >= 5 /\ (settled38.orderModifiedReturnBitfield5 # << >> /\ (settled38.orderModifiedReturnBitfield5[1] \div 8) % 2 > 0) THEN (IF settled38.lastPx = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled38.lastPx) ELSE << >>]
        settled40 == [settled39 EXCEPT !.displayPrice = IF settled39.numberOfReturnBitfields >= 5 /\ (settled39.orderModifiedReturnBitfield5 # << >> /\ (settled39.orderModifiedReturnBitfield5[1] \div 16) % 2 > 0) THEN (IF settled39.displayPrice = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled39.displayPrice) ELSE << >>]
        settled41 == [settled40 EXCEPT !.workingPrice = IF settled40.numberOfReturnBitfields >= 5 /\ (settled40.orderModifiedReturnBitfield5 # << >> /\ (settled40.orderModifiedReturnBitfield5[1] \div 32) % 2 > 0) THEN (IF settled40.workingPrice = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled40.workingPrice) ELSE << >>]
        settled42 == [settled41 EXCEPT !.baseLiquidityIndicator = IF settled41.numberOfReturnBitfields >= 5 /\ (settled41.orderModifiedReturnBitfield5 # << >> /\ (settled41.orderModifiedReturnBitfield5[1] \div 64) % 2 > 0) THEN (IF settled41.baseLiquidityIndicator = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled41.baseLiquidityIndicator) ELSE << >>]
        settled43 == [settled42 EXCEPT !.expireTime = IF settled42.numberOfReturnBitfields >= 5 /\ (settled42.orderModifiedReturnBitfield5 # << >> /\ (settled42.orderModifiedReturnBitfield5[1] \div 128) % 2 > 0) THEN (IF settled42.expireTime = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled42.expireTime) ELSE << >>]
        settled44 == [settled43 EXCEPT !.secondaryOrderId = IF settled43.numberOfReturnBitfields >= 6 /\ (settled43.orderModifiedReturnBitfield6 # << >> /\ settled43.orderModifiedReturnBitfield6[1] % 2 > 0) THEN (IF settled43.secondaryOrderId = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled43.secondaryOrderId) ELSE << >>]
        settled45 == [settled44 EXCEPT !.contraCapacity = IF settled44.numberOfReturnBitfields >= 6 /\ (settled44.orderModifiedReturnBitfield6 # << >> /\ (settled44.orderModifiedReturnBitfield6[1] \div 4) % 2 > 0) THEN (IF settled44.contraCapacity = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled44.contraCapacity) ELSE << >>]
        settled46 == [settled45 EXCEPT !.attributedQuote = IF settled45.numberOfReturnBitfields >= 6 /\ (settled45.orderModifiedReturnBitfield6 # << >> /\ (settled45.orderModifiedReturnBitfield6[1] \div 8) % 2 > 0) THEN (IF settled45.attributedQuote = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled45.attributedQuote) ELSE << >>]
        settled47 == [settled46 EXCEPT !.echoText = IF settled46.numberOfReturnBitfields >= 8 /\ (settled46.orderModifiedReturnBitfield8 # << >> /\ (settled46.orderModifiedReturnBitfield8[1] \div 2) % 2 > 0) THEN (IF settled46.echoText = << >> THEN <<[i \in 1 .. 64 |-> 0]>> ELSE settled46.echoText) ELSE << >>]
        settled48 == [settled47 EXCEPT !.stopPx = IF settled47.numberOfReturnBitfields >= 8 /\ (settled47.orderModifiedReturnBitfield8 # << >> /\ (settled47.orderModifiedReturnBitfield8[1] \div 4) % 2 > 0) THEN (IF settled47.stopPx = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled47.stopPx) ELSE << >>]
        settled49 == [settled48 EXCEPT !.routingInst = IF settled48.numberOfReturnBitfields >= 8 /\ (settled48.orderModifiedReturnBitfield8 # << >> /\ (settled48.orderModifiedReturnBitfield8[1] \div 8) % 2 > 0) THEN (IF settled48.routingInst = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled48.routingInst) ELSE << >>]
        settled50 == [settled49 EXCEPT !.routStrategy = IF settled49.numberOfReturnBitfields >= 8 /\ (settled49.orderModifiedReturnBitfield8 # << >> /\ (settled49.orderModifiedReturnBitfield8[1] \div 16) % 2 > 0) THEN (IF settled49.routStrategy = << >> THEN <<[i \in 1 .. 6 |-> 0]>> ELSE settled49.routStrategy) ELSE << >>]
        settled51 == [settled50 EXCEPT !.routeDeliveryMethod = IF settled50.numberOfReturnBitfields >= 8 /\ (settled50.orderModifiedReturnBitfield8 # << >> /\ (settled50.orderModifiedReturnBitfield8[1] \div 32) % 2 > 0) THEN (IF settled50.routeDeliveryMethod = << >> THEN <<[i \in 1 .. 3 |-> 0]>> ELSE settled50.routeDeliveryMethod) ELSE << >>]
        settled52 == [settled51 EXCEPT !.exDestination = IF settled51.numberOfReturnBitfields >= 8 /\ (settled51.orderModifiedReturnBitfield8 # << >> /\ (settled51.orderModifiedReturnBitfield8[1] \div 64) % 2 > 0) THEN (IF settled51.exDestination = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled51.exDestination) ELSE << >>]
        settled53 == [settled52 EXCEPT !.marketingFeeCode = IF settled52.numberOfReturnBitfields >= 9 /\ (settled52.orderModifiedReturnBitfield9 # << >> /\ settled52.orderModifiedReturnBitfield9[1] % 2 > 0) THEN (IF settled52.marketingFeeCode = << >> THEN <<[i \in 1 .. 2 |-> 0]>> ELSE settled52.marketingFeeCode) ELSE << >>]
        settled54 == [settled53 EXCEPT !.targetPartyId = IF settled53.numberOfReturnBitfields >= 9 /\ (settled53.orderModifiedReturnBitfield9 # << >> /\ (settled53.orderModifiedReturnBitfield9[1] \div 2) % 2 > 0) THEN (IF settled53.targetPartyId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled53.targetPartyId) ELSE << >>]
        settled55 == [settled54 EXCEPT !.auctionId = IF settled54.numberOfReturnBitfields >= 9 /\ (settled54.orderModifiedReturnBitfield9 # << >> /\ (settled54.orderModifiedReturnBitfield9[1] \div 4) % 2 > 0) THEN (IF settled54.auctionId = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled54.auctionId) ELSE << >>]
        settled56 == [settled55 EXCEPT !.cmtaNumber = IF settled55.numberOfReturnBitfields >= 9 /\ (settled55.orderModifiedReturnBitfield9 # << >> /\ (settled55.orderModifiedReturnBitfield9[1] \div 32) % 2 > 0) THEN (IF settled55.cmtaNumber = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled55.cmtaNumber) ELSE << >>]
        settled57 == [settled56 EXCEPT !.crossId = IF settled56.numberOfReturnBitfields >= 10 /\ (settled56.orderModifiedReturnBitfield10 # << >> /\ settled56.orderModifiedReturnBitfield10[1] % 2 > 0) THEN (IF settled56.crossId = << >> THEN <<[i \in 1 .. 20 |-> 0]>> ELSE settled56.crossId) ELSE << >>]
        settled58 == [settled57 EXCEPT !.allocQty = IF settled57.numberOfReturnBitfields >= 10 /\ (settled57.orderModifiedReturnBitfield10 # << >> /\ (settled57.orderModifiedReturnBitfield10[1] \div 2) % 2 > 0) THEN (IF settled57.allocQty = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled57.allocQty) ELSE << >>]
        settled59 == [settled58 EXCEPT !.giveUpFirmId = IF settled58.numberOfReturnBitfields >= 10 /\ (settled58.orderModifiedReturnBitfield10 # << >> /\ (settled58.orderModifiedReturnBitfield10[1] \div 4) % 2 > 0) THEN (IF settled58.giveUpFirmId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled58.giveUpFirmId) ELSE << >>]
        settled60 == [settled59 EXCEPT !.routingFirmId = IF settled59.numberOfReturnBitfields >= 10 /\ (settled59.orderModifiedReturnBitfield10 # << >> /\ (settled59.orderModifiedReturnBitfield10[1] \div 8) % 2 > 0) THEN (IF settled59.routingFirmId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled59.routingFirmId) ELSE << >>]
        settled61 == [settled60 EXCEPT !.crossExclusionIndicator = IF settled60.numberOfReturnBitfields >= 10 /\ (settled60.orderModifiedReturnBitfield10 # << >> /\ (settled60.orderModifiedReturnBitfield10[1] \div 32) % 2 > 0) THEN (IF settled60.crossExclusionIndicator = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled60.crossExclusionIndicator) ELSE << >>]
        settled62 == [settled61 EXCEPT !.frequentTraderId = IF settled61.numberOfReturnBitfields >= 16 /\ (settled61.orderModifiedReturnBitfield16 # << >> /\ settled61.orderModifiedReturnBitfield16[1] % 2 > 0) THEN (IF settled61.frequentTraderId = << >> THEN <<[i \in 1 .. 6 |-> 0]>> ELSE settled61.frequentTraderId) ELSE << >>]
        settled63 == [settled62 EXCEPT !.comboOrder = IF settled62.numberOfReturnBitfields >= 16 /\ (settled62.orderModifiedReturnBitfield16 # << >> /\ (settled62.orderModifiedReturnBitfield16[1] \div 4) % 2 > 0) THEN (IF settled62.comboOrder = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled62.comboOrder) ELSE << >>]
        settled64 == [settled63 EXCEPT !.compression = IF settled63.numberOfReturnBitfields >= 16 /\ (settled63.orderModifiedReturnBitfield16 # << >> /\ (settled63.orderModifiedReturnBitfield16[1] \div 8) % 2 > 0) THEN (IF settled63.compression = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled63.compression) ELSE << >>]
        settled65 == [settled64 EXCEPT !.floorDestination = IF settled64.numberOfReturnBitfields >= 16 /\ (settled64.orderModifiedReturnBitfield16 # << >> /\ (settled64.orderModifiedReturnBitfield16[1] \div 16) % 2 > 0) THEN (IF settled64.floorDestination = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled64.floorDestination) ELSE << >>]
        settled66 == [settled65 EXCEPT !.floorRoutingInst = IF settled65.numberOfReturnBitfields >= 16 /\ (settled65.orderModifiedReturnBitfield16 # << >> /\ (settled65.orderModifiedReturnBitfield16[1] \div 32) % 2 > 0) THEN (IF settled65.floorRoutingInst = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled65.floorRoutingInst) ELSE << >>]
        settled67 == [settled66 EXCEPT !.multiClassSprd = IF settled66.numberOfReturnBitfields >= 16 /\ (settled66.orderModifiedReturnBitfield16 # << >> /\ (settled66.orderModifiedReturnBitfield16[1] \div 64) % 2 > 0) THEN (IF settled66.multiClassSprd = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled66.multiClassSprd) ELSE << >>]
        settled68 == [settled67 EXCEPT !.orderOrigin = IF settled67.numberOfReturnBitfields >= 16 /\ (settled67.orderModifiedReturnBitfield16 # << >> /\ (settled67.orderModifiedReturnBitfield16[1] \div 128) % 2 > 0) THEN (IF settled67.orderOrigin = << >> THEN <<[i \in 1 .. 3 |-> 0]>> ELSE settled67.orderOrigin) ELSE << >>]
        settled69 == [settled68 EXCEPT !.priceType = IF settled68.numberOfReturnBitfields >= 17 /\ (settled68.orderModifiedReturnBitfield17 # << >> /\ settled68.orderModifiedReturnBitfield17[1] % 2 > 0) THEN (IF settled68.priceType = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled68.priceType) ELSE << >>]
        settled70 == [settled69 EXCEPT !.strategyId = IF settled69.numberOfReturnBitfields >= 17 /\ (settled69.orderModifiedReturnBitfield17 # << >> /\ (settled69.orderModifiedReturnBitfield17[1] \div 2) % 2 > 0) THEN (IF settled69.strategyId = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled69.strategyId) ELSE << >>]
        settled71 == [settled70 EXCEPT !.held = IF settled70.numberOfReturnBitfields >= 18 /\ (settled70.orderModifiedReturnBitfield18 # << >> /\ (settled70.orderModifiedReturnBitfield18[1] \div 32) % 2 > 0) THEN (IF settled70.held = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled70.held) ELSE << >>]
        settled72 == [settled71 EXCEPT !.stopPxType = IF settled71.numberOfReturnBitfields >= 19 /\ (settled71.orderModifiedReturnBitfield19 # << >> /\ (settled71.orderModifiedReturnBitfield19[1] \div 64) % 2 > 0) THEN (IF settled71.stopPxType = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled71.stopPxType) ELSE << >>]
    IN  settled72

ZeroOrderModifiedMessage ==
    SettleOrderModifiedMessage([ transactionTime               |-> [i \in 1 .. 8 |-> 0],
                                 clOrdId                       |-> [i \in 1 .. 20 |-> 0],
                                 orderId                       |-> [i \in 1 .. 8 |-> 0],
                                 reserved1                     |-> [i \in 1 .. 1 |-> 0],
                                 numberOfReturnBitfields       |-> 0,
                                 orderModifiedReturnBitfield1  |-> << >>,
                                 orderModifiedReturnBitfield2  |-> << >>,
                                 orderModifiedReturnBitfield3  |-> << >>,
                                 orderModifiedReturnBitfield4  |-> << >>,
                                 orderModifiedReturnBitfield5  |-> << >>,
                                 orderModifiedReturnBitfield6  |-> << >>,
                                 orderModifiedReturnBitfield7  |-> << >>,
                                 orderModifiedReturnBitfield8  |-> << >>,
                                 orderModifiedReturnBitfield9  |-> << >>,
                                 orderModifiedReturnBitfield10 |-> << >>,
                                 orderModifiedReturnBitfield11 |-> << >>,
                                 orderModifiedReturnBitfield12 |-> << >>,
                                 orderModifiedReturnBitfield13 |-> << >>,
                                 orderModifiedReturnBitfield14 |-> << >>,
                                 orderModifiedReturnBitfield15 |-> << >>,
                                 orderModifiedReturnBitfield16 |-> << >>,
                                 orderModifiedReturnBitfield17 |-> << >>,
                                 orderModifiedReturnBitfield18 |-> << >>,
                                 orderModifiedReturnBitfield19 |-> << >>,
                                 orderModifiedReturnBitfield20 |-> << >>,
                                 orderModifiedReturnBitfield21 |-> << >>,
                                 side                          |-> << >>,
                                 priceLong                     |-> << >>,
                                 execInst                      |-> << >>,
                                 ordType                       |-> << >>,
                                 timeInForce                   |-> << >>,
                                 minQty                        |-> << >>,
                                 symbolLong                    |-> << >>,
                                 account                       |-> << >>,
                                 clearingFirm                  |-> << >>,
                                 clearingAccount               |-> << >>,
                                 displayIndicator              |-> << >>,
                                 maxFloor                      |-> << >>,
                                 orderQtyLong                  |-> << >>,
                                 preventMatch                  |-> << >>,
                                 origClOrdId                   |-> << >>,
                                 leavesQty                     |-> << >>,
                                 lastShares                    |-> << >>,
                                 lastPx                        |-> << >>,
                                 displayPrice                  |-> << >>,
                                 workingPrice                  |-> << >>,
                                 baseLiquidityIndicator        |-> << >>,
                                 expireTime                    |-> << >>,
                                 secondaryOrderId              |-> << >>,
                                 contraCapacity                |-> << >>,
                                 attributedQuote               |-> << >>,
                                 echoText                      |-> << >>,
                                 stopPx                        |-> << >>,
                                 routingInst                   |-> << >>,
                                 routStrategy                  |-> << >>,
                                 routeDeliveryMethod           |-> << >>,
                                 exDestination                 |-> << >>,
                                 marketingFeeCode              |-> << >>,
                                 targetPartyId                 |-> << >>,
                                 auctionId                     |-> << >>,
                                 cmtaNumber                    |-> << >>,
                                 crossId                       |-> << >>,
                                 allocQty                      |-> << >>,
                                 giveUpFirmId                  |-> << >>,
                                 routingFirmId                 |-> << >>,
                                 crossExclusionIndicator       |-> << >>,
                                 frequentTraderId              |-> << >>,
                                 comboOrder                    |-> << >>,
                                 compression                   |-> << >>,
                                 floorDestination              |-> << >>,
                                 floorRoutingInst              |-> << >>,
                                 multiClassSprd                |-> << >>,
                                 orderOrigin                   |-> << >>,
                                 priceType                     |-> << >>,
                                 strategyId                    |-> << >>,
                                 held                          |-> << >>,
                                 stopPxType                    |-> << >> ])

(* Order Modified Message at zero, then each field in turn at the values it is checked at *)
CheckedOrderModifiedMessage ==
    { ZeroOrderModifiedMessage }
        \cup { SettleOrderModifiedMessage([ZeroOrderModifiedMessage EXCEPT !.transactionTime = one]) : one \in Sample(8) }
        \cup { SettleOrderModifiedMessage([ZeroOrderModifiedMessage EXCEPT !.clOrdId = one]) : one \in Sample(20) }
        \cup { SettleOrderModifiedMessage([ZeroOrderModifiedMessage EXCEPT !.orderId = one]) : one \in Sample(8) }
        \cup { SettleOrderModifiedMessage([ZeroOrderModifiedMessage EXCEPT !.reserved1 = one]) : one \in Sample(1) }
        \cup { SettleOrderModifiedMessage([ZeroOrderModifiedMessage EXCEPT !.numberOfReturnBitfields = one]) : one \in {0, 1, 255} }
        \cup { SettleOrderModifiedMessage([ZeroOrderModifiedMessage EXCEPT !.numberOfReturnBitfields = 1, !.orderModifiedReturnBitfield1 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderModifiedMessage([ZeroOrderModifiedMessage EXCEPT !.numberOfReturnBitfields = 2, !.orderModifiedReturnBitfield2 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderModifiedMessage([ZeroOrderModifiedMessage EXCEPT !.numberOfReturnBitfields = 3, !.orderModifiedReturnBitfield3 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderModifiedMessage([ZeroOrderModifiedMessage EXCEPT !.numberOfReturnBitfields = 4, !.orderModifiedReturnBitfield4 = one]) : one \in { <<held>> : held \in Sample(1) } }
