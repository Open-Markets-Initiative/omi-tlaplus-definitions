        \cup { SettleOrderRestatedMessage([ZeroOrderRestatedMessage EXCEPT !.numberOfReturnBitfields = 19, !.orderRestatedReturnBitfield19 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
