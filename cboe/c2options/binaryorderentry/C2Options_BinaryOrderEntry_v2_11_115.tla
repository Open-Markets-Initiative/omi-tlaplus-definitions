(***************************************************************************)
(* Order Restated Message                                                  *)
(***************************************************************************)

OrderRestatedMessage ==
    [ transactionTime               : Sample(8),
      clOrdId                       : Sample(20),
      orderId                       : Sample(8),
      restatementReason             : Sample(1),
      reserved1                     : Sample(1),
      numberOfReturnBitfields       : 0 .. 255,
      orderRestatedReturnBitfield1  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderRestatedReturnBitfield2  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderRestatedReturnBitfield3  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderRestatedReturnBitfield4  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderRestatedReturnBitfield5  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderRestatedReturnBitfield6  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderRestatedReturnBitfield7  : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderRestatedReturnBitfield8  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderRestatedReturnBitfield9  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderRestatedReturnBitfield10 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderRestatedReturnBitfield11 : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderRestatedReturnBitfield12 : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderRestatedReturnBitfield13 : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderRestatedReturnBitfield14 : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderRestatedReturnBitfield15 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderRestatedReturnBitfield16 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderRestatedReturnBitfield17 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderRestatedReturnBitfield18 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderRestatedReturnBitfield19 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      side                          : { << >> } \cup { <<held>> : held \in Sample(1) },
      priceLong                     : { << >> } \cup { <<held>> : held \in Sample(8) },
      execInst                      : { << >> } \cup { <<held>> : held \in Sample(1) },
      ordType                       : { << >> } \cup { <<held>> : held \in Sample(1) },
      timeInForce                   : { << >> } \cup { <<held>> : held \in Sample(1) },
      minQty                        : { << >> } \cup { <<held>> : held \in Sample(4) },
      symbolLong                    : { << >> } \cup { <<held>> : held \in Sample(8) },
      capacity                      : { << >> } \cup { <<held>> : held \in Sample(1) },
      account                       : { << >> } \cup { <<held>> : held \in Sample(16) },
      clearingFirm                  : { << >> } \cup { <<held>> : held \in Sample(4) },
      clearingAccount               : { << >> } \cup { <<held>> : held \in Sample(4) },
      displayIndicator              : { << >> } \cup { <<held>> : held \in Sample(1) },
      maxFloor                      : { << >> } \cup { <<held>> : held \in Sample(4) },
      orderQtyLong                  : { << >> } \cup { <<held>> : held \in Sample(4) },
      preventMatch                  : { << >> } \cup { <<held>> : held \in Sample(3) },
      maturityDate                  : { << >> } \cup { <<held>> : held \in Sample(4) },
      strikePrice                   : { << >> } \cup { <<held>> : held \in Sample(8) },
      putOrCall                     : { << >> } \cup { <<held>> : held \in Sample(1) },
      openClose                     : { << >> } \cup { <<held>> : held \in Sample(1) },
      correctedSize                 : { << >> } \cup { <<held>> : held \in Sample(4) },
      origClOrdId                   : { << >> } \cup { <<held>> : held \in Sample(20) },
      leavesQty                     : { << >> } \cup { <<held>> : held \in Sample(4) },
      lastShares                    : { << >> } \cup { <<held>> : held \in Sample(4) },
      lastPx                        : { << >> } \cup { <<held>> : held \in Sample(8) },
      displayPrice                  : { << >> } \cup { <<held>> : held \in Sample(8) },
      workingPrice                  : { << >> } \cup { <<held>> : held \in Sample(8) },
      baseLiquidityIndicator        : { << >> } \cup { <<held>> : held \in Sample(1) },
      expireTime                    : { << >> } \cup { <<held>> : held \in Sample(8) },
      secondaryOrderId              : { << >> } \cup { <<held>> : held \in Sample(8) },
      contraCapacity                : { << >> } \cup { <<held>> : held \in Sample(1) },
      attributedQuote               : { << >> } \cup { <<held>> : held \in Sample(1) },
      echoText                      : { << >> } \cup { <<held>> : held \in Sample(64) },
      stopPx                        : { << >> } \cup { <<held>> : held \in Sample(8) },
      routingInst                   : { << >> } \cup { <<held>> : held \in Sample(4) },
      routStrategy                  : { << >> } \cup { <<held>> : held \in Sample(6) },
      routeDeliveryMethod           : { << >> } \cup { <<held>> : held \in Sample(3) },
      exDestination                 : { << >> } \cup { <<held>> : held \in Sample(1) },
      marketingFeeCode              : { << >> } \cup { <<held>> : held \in Sample(2) },
      targetPartyId                 : { << >> } \cup { <<held>> : held \in Sample(4) },
      auctionId                     : { << >> } \cup { <<held>> : held \in Sample(8) },
      cmtaNumber                    : { << >> } \cup { <<held>> : held \in Sample(4) },
      crossId                       : { << >> } \cup { <<held>> : held \in Sample(20) },
      allocQty                      : { << >> } \cup { <<held>> : held \in Sample(4) },
      giveUpFirmId                  : { << >> } \cup { <<held>> : held \in Sample(4) },
      routingFirmId                 : { << >> } \cup { <<held>> : held \in Sample(4) },
      crossExclusionIndicator       : { << >> } \cup { <<held>> : held \in Sample(1) },
      clientIdAttr                  : { << >> } \cup { <<held>> : held \in Sample(4) },
      frequentTraderId              : { << >> } \cup { <<held>> : held \in Sample(6) },
      comboOrder                    : { << >> } \cup { <<held>> : held \in Sample(1) },
      compression                   : { << >> } \cup { <<held>> : held \in Sample(1) },
      floorDestination              : { << >> } \cup { <<held>> : held \in Sample(4) },
      floorRoutingInst              : { << >> } \cup { <<held>> : held \in Sample(1) },
      multiClassSprd                : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderOrigin                   : { << >> } \cup { <<held>> : held \in Sample(3) },
      priceType                     : { << >> } \cup { <<held>> : held \in Sample(1) },
      strategyId                    : { << >> } \cup { <<held>> : held \in Sample(1) },
      held                          : { << >> } \cup { <<held>> : held \in Sample(1) },
      stopPxType                    : { << >> } \cup { <<held>> : held \in Sample(1) } ]

EncodeOrderRestatedMessage(message) ==
    message.transactionTime
        \o message.clOrdId
        \o message.orderId
        \o message.restatementReason
        \o message.reserved1
        \o EncodeUIntBE(message.numberOfReturnBitfields, 1)
        \o (IF message.orderRestatedReturnBitfield1 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRestatedReturnBitfield1[1], 1))
        \o (IF message.orderRestatedReturnBitfield2 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRestatedReturnBitfield2[1], 1))
        \o (IF message.orderRestatedReturnBitfield3 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRestatedReturnBitfield3[1], 1))
        \o (IF message.orderRestatedReturnBitfield4 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRestatedReturnBitfield4[1], 1))
        \o (IF message.orderRestatedReturnBitfield5 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRestatedReturnBitfield5[1], 1))
        \o (IF message.orderRestatedReturnBitfield6 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRestatedReturnBitfield6[1], 1))
        \o (IF message.orderRestatedReturnBitfield7 = << >> THEN << >> ELSE message.orderRestatedReturnBitfield7[1])
        \o (IF message.orderRestatedReturnBitfield8 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRestatedReturnBitfield8[1], 1))
        \o (IF message.orderRestatedReturnBitfield9 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRestatedReturnBitfield9[1], 1))
        \o (IF message.orderRestatedReturnBitfield10 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRestatedReturnBitfield10[1], 1))
        \o (IF message.orderRestatedReturnBitfield11 = << >> THEN << >> ELSE message.orderRestatedReturnBitfield11[1])
        \o (IF message.orderRestatedReturnBitfield12 = << >> THEN << >> ELSE message.orderRestatedReturnBitfield12[1])
        \o (IF message.orderRestatedReturnBitfield13 = << >> THEN << >> ELSE message.orderRestatedReturnBitfield13[1])
        \o (IF message.orderRestatedReturnBitfield14 = << >> THEN << >> ELSE message.orderRestatedReturnBitfield14[1])
        \o (IF message.orderRestatedReturnBitfield15 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRestatedReturnBitfield15[1], 1))
        \o (IF message.orderRestatedReturnBitfield16 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRestatedReturnBitfield16[1], 1))
        \o (IF message.orderRestatedReturnBitfield17 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRestatedReturnBitfield17[1], 1))
        \o (IF message.orderRestatedReturnBitfield18 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRestatedReturnBitfield18[1], 1))
        \o (IF message.orderRestatedReturnBitfield19 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRestatedReturnBitfield19[1], 1))
        \o (IF message.side = << >> THEN << >> ELSE message.side[1])
        \o (IF message.priceLong = << >> THEN << >> ELSE message.priceLong[1])
        \o (IF message.execInst = << >> THEN << >> ELSE message.execInst[1])
        \o (IF message.ordType = << >> THEN << >> ELSE message.ordType[1])
        \o (IF message.timeInForce = << >> THEN << >> ELSE message.timeInForce[1])
        \o (IF message.minQty = << >> THEN << >> ELSE message.minQty[1])
        \o (IF message.symbolLong = << >> THEN << >> ELSE message.symbolLong[1])
        \o (IF message.capacity = << >> THEN << >> ELSE message.capacity[1])
        \o (IF message.account = << >> THEN << >> ELSE message.account[1])
        \o (IF message.clearingFirm = << >> THEN << >> ELSE message.clearingFirm[1])
        \o (IF message.clearingAccount = << >> THEN << >> ELSE message.clearingAccount[1])
        \o (IF message.displayIndicator = << >> THEN << >> ELSE message.displayIndicator[1])
        \o (IF message.maxFloor = << >> THEN << >> ELSE message.maxFloor[1])
        \o (IF message.orderQtyLong = << >> THEN << >> ELSE message.orderQtyLong[1])
        \o (IF message.preventMatch = << >> THEN << >> ELSE message.preventMatch[1])
        \o (IF message.maturityDate = << >> THEN << >> ELSE message.maturityDate[1])
        \o (IF message.strikePrice = << >> THEN << >> ELSE message.strikePrice[1])
        \o (IF message.putOrCall = << >> THEN << >> ELSE message.putOrCall[1])
        \o (IF message.openClose = << >> THEN << >> ELSE message.openClose[1])
        \o (IF message.correctedSize = << >> THEN << >> ELSE message.correctedSize[1])
        \o (IF message.origClOrdId = << >> THEN << >> ELSE message.origClOrdId[1])
        \o (IF message.leavesQty = << >> THEN << >> ELSE message.leavesQty[1])
        \o (IF message.lastShares = << >> THEN << >> ELSE message.lastShares[1])
        \o (IF message.lastPx = << >> THEN << >> ELSE message.lastPx[1])
        \o (IF message.displayPrice = << >> THEN << >> ELSE message.displayPrice[1])
        \o (IF message.workingPrice = << >> THEN << >> ELSE message.workingPrice[1])
        \o (IF message.baseLiquidityIndicator = << >> THEN << >> ELSE message.baseLiquidityIndicator[1])
        \o (IF message.expireTime = << >> THEN << >> ELSE message.expireTime[1])
        \o (IF message.secondaryOrderId = << >> THEN << >> ELSE message.secondaryOrderId[1])
        \o (IF message.contraCapacity = << >> THEN << >> ELSE message.contraCapacity[1])
        \o (IF message.attributedQuote = << >> THEN << >> ELSE message.attributedQuote[1])
        \o (IF message.echoText = << >> THEN << >> ELSE message.echoText[1])
        \o (IF message.stopPx = << >> THEN << >> ELSE message.stopPx[1])
        \o (IF message.routingInst = << >> THEN << >> ELSE message.routingInst[1])
        \o (IF message.routStrategy = << >> THEN << >> ELSE message.routStrategy[1])
        \o (IF message.routeDeliveryMethod = << >> THEN << >> ELSE message.routeDeliveryMethod[1])
        \o (IF message.exDestination = << >> THEN << >> ELSE message.exDestination[1])
        \o (IF message.marketingFeeCode = << >> THEN << >> ELSE message.marketingFeeCode[1])
        \o (IF message.targetPartyId = << >> THEN << >> ELSE message.targetPartyId[1])
        \o (IF message.auctionId = << >> THEN << >> ELSE message.auctionId[1])
        \o (IF message.cmtaNumber = << >> THEN << >> ELSE message.cmtaNumber[1])
        \o (IF message.crossId = << >> THEN << >> ELSE message.crossId[1])
        \o (IF message.allocQty = << >> THEN << >> ELSE message.allocQty[1])
        \o (IF message.giveUpFirmId = << >> THEN << >> ELSE message.giveUpFirmId[1])
        \o (IF message.routingFirmId = << >> THEN << >> ELSE message.routingFirmId[1])
        \o (IF message.crossExclusionIndicator = << >> THEN << >> ELSE message.crossExclusionIndicator[1])
        \o (IF message.clientIdAttr = << >> THEN << >> ELSE message.clientIdAttr[1])
        \o (IF message.frequentTraderId = << >> THEN << >> ELSE message.frequentTraderId[1])
        \o (IF message.comboOrder = << >> THEN << >> ELSE message.comboOrder[1])
        \o (IF message.compression = << >> THEN << >> ELSE message.compression[1])
        \o (IF message.floorDestination = << >> THEN << >> ELSE message.floorDestination[1])
        \o (IF message.floorRoutingInst = << >> THEN << >> ELSE message.floorRoutingInst[1])
        \o (IF message.multiClassSprd = << >> THEN << >> ELSE message.multiClassSprd[1])
        \o (IF message.orderOrigin = << >> THEN << >> ELSE message.orderOrigin[1])
        \o (IF message.priceType = << >> THEN << >> ELSE message.priceType[1])
        \o (IF message.strategyId = << >> THEN << >> ELSE message.strategyId[1])
        \o (IF message.held = << >> THEN << >> ELSE message.held[1])
        \o (IF message.stopPxType = << >> THEN << >> ELSE message.stopPxType[1])

DecodeOrderRestatedMessage(bytes) ==
    LET transactionTime == ReadBytes(bytes, 8) IN IF ~transactionTime.ok THEN Fail ELSE
    LET clOrdId == ReadBytes(transactionTime.rest, 20) IN IF ~clOrdId.ok THEN Fail ELSE
    LET orderId == ReadBytes(clOrdId.rest, 8) IN IF ~orderId.ok THEN Fail ELSE
    LET restatementReason == ReadBytes(orderId.rest, 1) IN IF ~restatementReason.ok THEN Fail ELSE
    LET reserved1 == ReadBytes(restatementReason.rest, 1) IN IF ~reserved1.ok THEN Fail ELSE
    LET numberOfReturnBitfields == ReadUIntBE(reserved1.rest, 1) IN IF ~numberOfReturnBitfields.ok THEN Fail ELSE
    LET orderRestatedReturnBitfield1 == ReadWhen(numberOfReturnBitfields.value >= 1, ReadUIntLE(numberOfReturnBitfields.rest, 1), numberOfReturnBitfields.rest) IN IF ~orderRestatedReturnBitfield1.ok THEN Fail ELSE
    LET orderRestatedReturnBitfield2 == ReadWhen(numberOfReturnBitfields.value >= 2, ReadUIntLE(orderRestatedReturnBitfield1.rest, 1), orderRestatedReturnBitfield1.rest) IN IF ~orderRestatedReturnBitfield2.ok THEN Fail ELSE
    LET orderRestatedReturnBitfield3 == ReadWhen(numberOfReturnBitfields.value >= 3, ReadUIntLE(orderRestatedReturnBitfield2.rest, 1), orderRestatedReturnBitfield2.rest) IN IF ~orderRestatedReturnBitfield3.ok THEN Fail ELSE
    LET orderRestatedReturnBitfield4 == ReadWhen(numberOfReturnBitfields.value >= 4, ReadUIntLE(orderRestatedReturnBitfield3.rest, 1), orderRestatedReturnBitfield3.rest) IN IF ~orderRestatedReturnBitfield4.ok THEN Fail ELSE
    LET orderRestatedReturnBitfield5 == ReadWhen(numberOfReturnBitfields.value >= 5, ReadUIntLE(orderRestatedReturnBitfield4.rest, 1), orderRestatedReturnBitfield4.rest) IN IF ~orderRestatedReturnBitfield5.ok THEN Fail ELSE
    LET orderRestatedReturnBitfield6 == ReadWhen(numberOfReturnBitfields.value >= 6, ReadUIntLE(orderRestatedReturnBitfield5.rest, 1), orderRestatedReturnBitfield5.rest) IN IF ~orderRestatedReturnBitfield6.ok THEN Fail ELSE
    LET orderRestatedReturnBitfield7 == ReadWhen(numberOfReturnBitfields.value >= 7, ReadBytes(orderRestatedReturnBitfield6.rest, 1), orderRestatedReturnBitfield6.rest) IN IF ~orderRestatedReturnBitfield7.ok THEN Fail ELSE
    LET orderRestatedReturnBitfield8 == ReadWhen(numberOfReturnBitfields.value >= 8, ReadUIntLE(orderRestatedReturnBitfield7.rest, 1), orderRestatedReturnBitfield7.rest) IN IF ~orderRestatedReturnBitfield8.ok THEN Fail ELSE
    LET orderRestatedReturnBitfield9 == ReadWhen(numberOfReturnBitfields.value >= 9, ReadUIntLE(orderRestatedReturnBitfield8.rest, 1), orderRestatedReturnBitfield8.rest) IN IF ~orderRestatedReturnBitfield9.ok THEN Fail ELSE
    LET orderRestatedReturnBitfield10 == ReadWhen(numberOfReturnBitfields.value >= 10, ReadUIntLE(orderRestatedReturnBitfield9.rest, 1), orderRestatedReturnBitfield9.rest) IN IF ~orderRestatedReturnBitfield10.ok THEN Fail ELSE
    LET orderRestatedReturnBitfield11 == ReadWhen(numberOfReturnBitfields.value >= 11, ReadBytes(orderRestatedReturnBitfield10.rest, 1), orderRestatedReturnBitfield10.rest) IN IF ~orderRestatedReturnBitfield11.ok THEN Fail ELSE
    LET orderRestatedReturnBitfield12 == ReadWhen(numberOfReturnBitfields.value >= 12, ReadBytes(orderRestatedReturnBitfield11.rest, 1), orderRestatedReturnBitfield11.rest) IN IF ~orderRestatedReturnBitfield12.ok THEN Fail ELSE
    LET orderRestatedReturnBitfield13 == ReadWhen(numberOfReturnBitfields.value >= 13, ReadBytes(orderRestatedReturnBitfield12.rest, 1), orderRestatedReturnBitfield12.rest) IN IF ~orderRestatedReturnBitfield13.ok THEN Fail ELSE
    LET orderRestatedReturnBitfield14 == ReadWhen(numberOfReturnBitfields.value >= 14, ReadBytes(orderRestatedReturnBitfield13.rest, 1), orderRestatedReturnBitfield13.rest) IN IF ~orderRestatedReturnBitfield14.ok THEN Fail ELSE
    LET orderRestatedReturnBitfield15 == ReadWhen(numberOfReturnBitfields.value >= 15, ReadUIntLE(orderRestatedReturnBitfield14.rest, 1), orderRestatedReturnBitfield14.rest) IN IF ~orderRestatedReturnBitfield15.ok THEN Fail ELSE
    LET orderRestatedReturnBitfield16 == ReadWhen(numberOfReturnBitfields.value >= 16, ReadUIntLE(orderRestatedReturnBitfield15.rest, 1), orderRestatedReturnBitfield15.rest) IN IF ~orderRestatedReturnBitfield16.ok THEN Fail ELSE
    LET orderRestatedReturnBitfield17 == ReadWhen(numberOfReturnBitfields.value >= 17, ReadUIntLE(orderRestatedReturnBitfield16.rest, 1), orderRestatedReturnBitfield16.rest) IN IF ~orderRestatedReturnBitfield17.ok THEN Fail ELSE
    LET orderRestatedReturnBitfield18 == ReadWhen(numberOfReturnBitfields.value >= 18, ReadUIntLE(orderRestatedReturnBitfield17.rest, 1), orderRestatedReturnBitfield17.rest) IN IF ~orderRestatedReturnBitfield18.ok THEN Fail ELSE
    LET orderRestatedReturnBitfield19 == ReadWhen(numberOfReturnBitfields.value >= 19, ReadUIntLE(orderRestatedReturnBitfield18.rest, 1), orderRestatedReturnBitfield18.rest) IN IF ~orderRestatedReturnBitfield19.ok THEN Fail ELSE
    LET side == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderRestatedReturnBitfield1.value # << >> /\ orderRestatedReturnBitfield1.value[1] % 2 > 0), ReadBytes(orderRestatedReturnBitfield19.rest, 1), orderRestatedReturnBitfield19.rest) IN IF ~side.ok THEN Fail ELSE
    LET priceLong == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderRestatedReturnBitfield1.value # << >> /\ (orderRestatedReturnBitfield1.value[1] \div 4) % 2 > 0), ReadBytes(side.rest, 8), side.rest) IN IF ~priceLong.ok THEN Fail ELSE
    LET execInst == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderRestatedReturnBitfield1.value # << >> /\ (orderRestatedReturnBitfield1.value[1] \div 8) % 2 > 0), ReadBytes(priceLong.rest, 1), priceLong.rest) IN IF ~execInst.ok THEN Fail ELSE
    LET ordType == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderRestatedReturnBitfield1.value # << >> /\ (orderRestatedReturnBitfield1.value[1] \div 16) % 2 > 0), ReadBytes(execInst.rest, 1), execInst.rest) IN IF ~ordType.ok THEN Fail ELSE
    LET timeInForce == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderRestatedReturnBitfield1.value # << >> /\ (orderRestatedReturnBitfield1.value[1] \div 32) % 2 > 0), ReadBytes(ordType.rest, 1), ordType.rest) IN IF ~timeInForce.ok THEN Fail ELSE
    LET minQty == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderRestatedReturnBitfield1.value # << >> /\ (orderRestatedReturnBitfield1.value[1] \div 64) % 2 > 0), ReadBytes(timeInForce.rest, 4), timeInForce.rest) IN IF ~minQty.ok THEN Fail ELSE
    LET symbolLong == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (orderRestatedReturnBitfield2.value # << >> /\ orderRestatedReturnBitfield2.value[1] % 2 > 0), ReadBytes(minQty.rest, 8), minQty.rest) IN IF ~symbolLong.ok THEN Fail ELSE
    LET capacity == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (orderRestatedReturnBitfield2.value # << >> /\ (orderRestatedReturnBitfield2.value[1] \div 64) % 2 > 0), ReadBytes(symbolLong.rest, 1), symbolLong.rest) IN IF ~capacity.ok THEN Fail ELSE
    LET account == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderRestatedReturnBitfield3.value # << >> /\ orderRestatedReturnBitfield3.value[1] % 2 > 0), ReadBytes(capacity.rest, 16), capacity.rest) IN IF ~account.ok THEN Fail ELSE
    LET clearingFirm == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderRestatedReturnBitfield3.value # << >> /\ (orderRestatedReturnBitfield3.value[1] \div 2) % 2 > 0), ReadBytes(account.rest, 4), account.rest) IN IF ~clearingFirm.ok THEN Fail ELSE
    LET clearingAccount == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderRestatedReturnBitfield3.value # << >> /\ (orderRestatedReturnBitfield3.value[1] \div 4) % 2 > 0), ReadBytes(clearingFirm.rest, 4), clearingFirm.rest) IN IF ~clearingAccount.ok THEN Fail ELSE
    LET displayIndicator == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderRestatedReturnBitfield3.value # << >> /\ (orderRestatedReturnBitfield3.value[1] \div 8) % 2 > 0), ReadBytes(clearingAccount.rest, 1), clearingAccount.rest) IN IF ~displayIndicator.ok THEN Fail ELSE
    LET maxFloor == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderRestatedReturnBitfield3.value # << >> /\ (orderRestatedReturnBitfield3.value[1] \div 16) % 2 > 0), ReadBytes(displayIndicator.rest, 4), displayIndicator.rest) IN IF ~maxFloor.ok THEN Fail ELSE
    LET orderQtyLong == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderRestatedReturnBitfield3.value # << >> /\ (orderRestatedReturnBitfield3.value[1] \div 64) % 2 > 0), ReadBytes(maxFloor.rest, 4), maxFloor.rest) IN IF ~orderQtyLong.ok THEN Fail ELSE
    LET preventMatch == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderRestatedReturnBitfield3.value # << >> /\ (orderRestatedReturnBitfield3.value[1] \div 128) % 2 > 0), ReadBytes(orderQtyLong.rest, 3), orderQtyLong.rest) IN IF ~preventMatch.ok THEN Fail ELSE
    LET maturityDate == ReadWhen(numberOfReturnBitfields.value >= 4 /\ (orderRestatedReturnBitfield4.value # << >> /\ orderRestatedReturnBitfield4.value[1] % 2 > 0), ReadBytes(preventMatch.rest, 4), preventMatch.rest) IN IF ~maturityDate.ok THEN Fail ELSE
    LET strikePrice == ReadWhen(numberOfReturnBitfields.value >= 4 /\ (orderRestatedReturnBitfield4.value # << >> /\ (orderRestatedReturnBitfield4.value[1] \div 2) % 2 > 0), ReadBytes(maturityDate.rest, 8), maturityDate.rest) IN IF ~strikePrice.ok THEN Fail ELSE
    LET putOrCall == ReadWhen(numberOfReturnBitfields.value >= 4 /\ (orderRestatedReturnBitfield4.value # << >> /\ (orderRestatedReturnBitfield4.value[1] \div 4) % 2 > 0), ReadBytes(strikePrice.rest, 1), strikePrice.rest) IN IF ~putOrCall.ok THEN Fail ELSE
    LET openClose == ReadWhen(numberOfReturnBitfields.value >= 4 /\ (orderRestatedReturnBitfield4.value # << >> /\ (orderRestatedReturnBitfield4.value[1] \div 8) % 2 > 0), ReadBytes(putOrCall.rest, 1), putOrCall.rest) IN IF ~openClose.ok THEN Fail ELSE
    LET correctedSize == ReadWhen(numberOfReturnBitfields.value >= 4 /\ (orderRestatedReturnBitfield4.value # << >> /\ (orderRestatedReturnBitfield4.value[1] \div 32) % 2 > 0), ReadBytes(openClose.rest, 4), openClose.rest) IN IF ~correctedSize.ok THEN Fail ELSE
    LET origClOrdId == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderRestatedReturnBitfield5.value # << >> /\ orderRestatedReturnBitfield5.value[1] % 2 > 0), ReadBytes(correctedSize.rest, 20), correctedSize.rest) IN IF ~origClOrdId.ok THEN Fail ELSE
    LET leavesQty == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderRestatedReturnBitfield5.value # << >> /\ (orderRestatedReturnBitfield5.value[1] \div 2) % 2 > 0), ReadBytes(origClOrdId.rest, 4), origClOrdId.rest) IN IF ~leavesQty.ok THEN Fail ELSE
    LET lastShares == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderRestatedReturnBitfield5.value # << >> /\ (orderRestatedReturnBitfield5.value[1] \div 4) % 2 > 0), ReadBytes(leavesQty.rest, 4), leavesQty.rest) IN IF ~lastShares.ok THEN Fail ELSE
    LET lastPx == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderRestatedReturnBitfield5.value # << >> /\ (orderRestatedReturnBitfield5.value[1] \div 8) % 2 > 0), ReadBytes(lastShares.rest, 8), lastShares.rest) IN IF ~lastPx.ok THEN Fail ELSE
    LET displayPrice == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderRestatedReturnBitfield5.value # << >> /\ (orderRestatedReturnBitfield5.value[1] \div 16) % 2 > 0), ReadBytes(lastPx.rest, 8), lastPx.rest) IN IF ~displayPrice.ok THEN Fail ELSE
    LET workingPrice == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderRestatedReturnBitfield5.value # << >> /\ (orderRestatedReturnBitfield5.value[1] \div 32) % 2 > 0), ReadBytes(displayPrice.rest, 8), displayPrice.rest) IN IF ~workingPrice.ok THEN Fail ELSE
    LET baseLiquidityIndicator == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderRestatedReturnBitfield5.value # << >> /\ (orderRestatedReturnBitfield5.value[1] \div 64) % 2 > 0), ReadBytes(workingPrice.rest, 1), workingPrice.rest) IN IF ~baseLiquidityIndicator.ok THEN Fail ELSE
    LET expireTime == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderRestatedReturnBitfield5.value # << >> /\ (orderRestatedReturnBitfield5.value[1] \div 128) % 2 > 0), ReadBytes(baseLiquidityIndicator.rest, 8), baseLiquidityIndicator.rest) IN IF ~expireTime.ok THEN Fail ELSE
    LET secondaryOrderId == ReadWhen(numberOfReturnBitfields.value >= 6 /\ (orderRestatedReturnBitfield6.value # << >> /\ orderRestatedReturnBitfield6.value[1] % 2 > 0), ReadBytes(expireTime.rest, 8), expireTime.rest) IN IF ~secondaryOrderId.ok THEN Fail ELSE
    LET contraCapacity == ReadWhen(numberOfReturnBitfields.value >= 6 /\ (orderRestatedReturnBitfield6.value # << >> /\ (orderRestatedReturnBitfield6.value[1] \div 4) % 2 > 0), ReadBytes(secondaryOrderId.rest, 1), secondaryOrderId.rest) IN IF ~contraCapacity.ok THEN Fail ELSE
    LET attributedQuote == ReadWhen(numberOfReturnBitfields.value >= 6 /\ (orderRestatedReturnBitfield6.value # << >> /\ (orderRestatedReturnBitfield6.value[1] \div 8) % 2 > 0), ReadBytes(contraCapacity.rest, 1), contraCapacity.rest) IN IF ~attributedQuote.ok THEN Fail ELSE
    LET echoText == ReadWhen(numberOfReturnBitfields.value >= 8 /\ (orderRestatedReturnBitfield8.value # << >> /\ (orderRestatedReturnBitfield8.value[1] \div 2) % 2 > 0), ReadBytes(attributedQuote.rest, 64), attributedQuote.rest) IN IF ~echoText.ok THEN Fail ELSE
    LET stopPx == ReadWhen(numberOfReturnBitfields.value >= 8 /\ (orderRestatedReturnBitfield8.value # << >> /\ (orderRestatedReturnBitfield8.value[1] \div 4) % 2 > 0), ReadBytes(echoText.rest, 8), echoText.rest) IN IF ~stopPx.ok THEN Fail ELSE
    LET routingInst == ReadWhen(numberOfReturnBitfields.value >= 8 /\ (orderRestatedReturnBitfield8.value # << >> /\ (orderRestatedReturnBitfield8.value[1] \div 8) % 2 > 0), ReadBytes(stopPx.rest, 4), stopPx.rest) IN IF ~routingInst.ok THEN Fail ELSE
    LET routStrategy == ReadWhen(numberOfReturnBitfields.value >= 8 /\ (orderRestatedReturnBitfield8.value # << >> /\ (orderRestatedReturnBitfield8.value[1] \div 16) % 2 > 0), ReadBytes(routingInst.rest, 6), routingInst.rest) IN IF ~routStrategy.ok THEN Fail ELSE
    LET routeDeliveryMethod == ReadWhen(numberOfReturnBitfields.value >= 8 /\ (orderRestatedReturnBitfield8.value # << >> /\ (orderRestatedReturnBitfield8.value[1] \div 32) % 2 > 0), ReadBytes(routStrategy.rest, 3), routStrategy.rest) IN IF ~routeDeliveryMethod.ok THEN Fail ELSE
    LET exDestination == ReadWhen(numberOfReturnBitfields.value >= 8 /\ (orderRestatedReturnBitfield8.value # << >> /\ (orderRestatedReturnBitfield8.value[1] \div 64) % 2 > 0), ReadBytes(routeDeliveryMethod.rest, 1), routeDeliveryMethod.rest) IN IF ~exDestination.ok THEN Fail ELSE
    LET marketingFeeCode == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (orderRestatedReturnBitfield9.value # << >> /\ orderRestatedReturnBitfield9.value[1] % 2 > 0), ReadBytes(exDestination.rest, 2), exDestination.rest) IN IF ~marketingFeeCode.ok THEN Fail ELSE
    LET targetPartyId == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (orderRestatedReturnBitfield9.value # << >> /\ (orderRestatedReturnBitfield9.value[1] \div 2) % 2 > 0), ReadBytes(marketingFeeCode.rest, 4), marketingFeeCode.rest) IN IF ~targetPartyId.ok THEN Fail ELSE
    LET auctionId == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (orderRestatedReturnBitfield9.value # << >> /\ (orderRestatedReturnBitfield9.value[1] \div 4) % 2 > 0), ReadBytes(targetPartyId.rest, 8), targetPartyId.rest) IN IF ~auctionId.ok THEN Fail ELSE
    LET cmtaNumber == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (orderRestatedReturnBitfield9.value # << >> /\ (orderRestatedReturnBitfield9.value[1] \div 32) % 2 > 0), ReadBytes(auctionId.rest, 4), auctionId.rest) IN IF ~cmtaNumber.ok THEN Fail ELSE
    LET crossId == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (orderRestatedReturnBitfield10.value # << >> /\ orderRestatedReturnBitfield10.value[1] % 2 > 0), ReadBytes(cmtaNumber.rest, 20), cmtaNumber.rest) IN IF ~crossId.ok THEN Fail ELSE
    LET allocQty == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (orderRestatedReturnBitfield10.value # << >> /\ (orderRestatedReturnBitfield10.value[1] \div 2) % 2 > 0), ReadBytes(crossId.rest, 4), crossId.rest) IN IF ~allocQty.ok THEN Fail ELSE
    LET giveUpFirmId == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (orderRestatedReturnBitfield10.value # << >> /\ (orderRestatedReturnBitfield10.value[1] \div 4) % 2 > 0), ReadBytes(allocQty.rest, 4), allocQty.rest) IN IF ~giveUpFirmId.ok THEN Fail ELSE
    LET routingFirmId == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (orderRestatedReturnBitfield10.value # << >> /\ (orderRestatedReturnBitfield10.value[1] \div 8) % 2 > 0), ReadBytes(giveUpFirmId.rest, 4), giveUpFirmId.rest) IN IF ~routingFirmId.ok THEN Fail ELSE
    LET crossExclusionIndicator == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (orderRestatedReturnBitfield10.value # << >> /\ (orderRestatedReturnBitfield10.value[1] \div 32) % 2 > 0), ReadBytes(routingFirmId.rest, 1), routingFirmId.rest) IN IF ~crossExclusionIndicator.ok THEN Fail ELSE
    LET clientIdAttr == ReadWhen(numberOfReturnBitfields.value >= 15 /\ (orderRestatedReturnBitfield15.value # << >> /\ (orderRestatedReturnBitfield15.value[1] \div 128) % 2 > 0), ReadBytes(crossExclusionIndicator.rest, 4), crossExclusionIndicator.rest) IN IF ~clientIdAttr.ok THEN Fail ELSE
    LET frequentTraderId == ReadWhen(numberOfReturnBitfields.value >= 16 /\ (orderRestatedReturnBitfield16.value # << >> /\ orderRestatedReturnBitfield16.value[1] % 2 > 0), ReadBytes(clientIdAttr.rest, 6), clientIdAttr.rest) IN IF ~frequentTraderId.ok THEN Fail ELSE
    LET comboOrder == ReadWhen(numberOfReturnBitfields.value >= 16 /\ (orderRestatedReturnBitfield16.value # << >> /\ (orderRestatedReturnBitfield16.value[1] \div 4) % 2 > 0), ReadBytes(frequentTraderId.rest, 1), frequentTraderId.rest) IN IF ~comboOrder.ok THEN Fail ELSE
    LET compression == ReadWhen(numberOfReturnBitfields.value >= 16 /\ (orderRestatedReturnBitfield16.value # << >> /\ (orderRestatedReturnBitfield16.value[1] \div 8) % 2 > 0), ReadBytes(comboOrder.rest, 1), comboOrder.rest) IN IF ~compression.ok THEN Fail ELSE
    LET floorDestination == ReadWhen(numberOfReturnBitfields.value >= 16 /\ (orderRestatedReturnBitfield16.value # << >> /\ (orderRestatedReturnBitfield16.value[1] \div 16) % 2 > 0), ReadBytes(compression.rest, 4), compression.rest) IN IF ~floorDestination.ok THEN Fail ELSE
    LET floorRoutingInst == ReadWhen(numberOfReturnBitfields.value >= 16 /\ (orderRestatedReturnBitfield16.value # << >> /\ (orderRestatedReturnBitfield16.value[1] \div 32) % 2 > 0), ReadBytes(floorDestination.rest, 1), floorDestination.rest) IN IF ~floorRoutingInst.ok THEN Fail ELSE
    LET multiClassSprd == ReadWhen(numberOfReturnBitfields.value >= 16 /\ (orderRestatedReturnBitfield16.value # << >> /\ (orderRestatedReturnBitfield16.value[1] \div 64) % 2 > 0), ReadBytes(floorRoutingInst.rest, 1), floorRoutingInst.rest) IN IF ~multiClassSprd.ok THEN Fail ELSE
    LET orderOrigin == ReadWhen(numberOfReturnBitfields.value >= 16 /\ (orderRestatedReturnBitfield16.value # << >> /\ (orderRestatedReturnBitfield16.value[1] \div 128) % 2 > 0), ReadBytes(multiClassSprd.rest, 3), multiClassSprd.rest) IN IF ~orderOrigin.ok THEN Fail ELSE
    LET priceType == ReadWhen(numberOfReturnBitfields.value >= 17 /\ (orderRestatedReturnBitfield17.value # << >> /\ orderRestatedReturnBitfield17.value[1] % 2 > 0), ReadBytes(orderOrigin.rest, 1), orderOrigin.rest) IN IF ~priceType.ok THEN Fail ELSE
    LET strategyId == ReadWhen(numberOfReturnBitfields.value >= 17 /\ (orderRestatedReturnBitfield17.value # << >> /\ (orderRestatedReturnBitfield17.value[1] \div 2) % 2 > 0), ReadBytes(priceType.rest, 1), priceType.rest) IN IF ~strategyId.ok THEN Fail ELSE
    LET held == ReadWhen(numberOfReturnBitfields.value >= 18 /\ (orderRestatedReturnBitfield18.value # << >> /\ (orderRestatedReturnBitfield18.value[1] \div 32) % 2 > 0), ReadBytes(strategyId.rest, 1), strategyId.rest) IN IF ~held.ok THEN Fail ELSE
    LET stopPxType == ReadWhen(numberOfReturnBitfields.value >= 19 /\ (orderRestatedReturnBitfield19.value # << >> /\ (orderRestatedReturnBitfield19.value[1] \div 64) % 2 > 0), ReadBytes(held.rest, 1), held.rest) IN IF ~stopPxType.ok THEN Fail ELSE
    Ok([ transactionTime               |-> transactionTime.value,
         clOrdId                       |-> clOrdId.value,
         orderId                       |-> orderId.value,
         restatementReason             |-> restatementReason.value,
         reserved1                     |-> reserved1.value,
         numberOfReturnBitfields       |-> numberOfReturnBitfields.value,
         orderRestatedReturnBitfield1  |-> orderRestatedReturnBitfield1.value,
         orderRestatedReturnBitfield2  |-> orderRestatedReturnBitfield2.value,
         orderRestatedReturnBitfield3  |-> orderRestatedReturnBitfield3.value,
         orderRestatedReturnBitfield4  |-> orderRestatedReturnBitfield4.value,
         orderRestatedReturnBitfield5  |-> orderRestatedReturnBitfield5.value,
         orderRestatedReturnBitfield6  |-> orderRestatedReturnBitfield6.value,
         orderRestatedReturnBitfield7  |-> orderRestatedReturnBitfield7.value,
         orderRestatedReturnBitfield8  |-> orderRestatedReturnBitfield8.value,
         orderRestatedReturnBitfield9  |-> orderRestatedReturnBitfield9.value,
         orderRestatedReturnBitfield10 |-> orderRestatedReturnBitfield10.value,
         orderRestatedReturnBitfield11 |-> orderRestatedReturnBitfield11.value,
         orderRestatedReturnBitfield12 |-> orderRestatedReturnBitfield12.value,
         orderRestatedReturnBitfield13 |-> orderRestatedReturnBitfield13.value,
         orderRestatedReturnBitfield14 |-> orderRestatedReturnBitfield14.value,
         orderRestatedReturnBitfield15 |-> orderRestatedReturnBitfield15.value,
         orderRestatedReturnBitfield16 |-> orderRestatedReturnBitfield16.value,
         orderRestatedReturnBitfield17 |-> orderRestatedReturnBitfield17.value,
         orderRestatedReturnBitfield18 |-> orderRestatedReturnBitfield18.value,
         orderRestatedReturnBitfield19 |-> orderRestatedReturnBitfield19.value,
         side                          |-> side.value,
         priceLong                     |-> priceLong.value,
         execInst                      |-> execInst.value,
         ordType                       |-> ordType.value,
         timeInForce                   |-> timeInForce.value,
         minQty                        |-> minQty.value,
         symbolLong                    |-> symbolLong.value,
         capacity                      |-> capacity.value,
         account                       |-> account.value,
         clearingFirm                  |-> clearingFirm.value,
         clearingAccount               |-> clearingAccount.value,
         displayIndicator              |-> displayIndicator.value,
         maxFloor                      |-> maxFloor.value,
         orderQtyLong                  |-> orderQtyLong.value,
         preventMatch                  |-> preventMatch.value,
         maturityDate                  |-> maturityDate.value,
         strikePrice                   |-> strikePrice.value,
         putOrCall                     |-> putOrCall.value,
         openClose                     |-> openClose.value,
         correctedSize                 |-> correctedSize.value,
         origClOrdId                   |-> origClOrdId.value,
         leavesQty                     |-> leavesQty.value,
         lastShares                    |-> lastShares.value,
         lastPx                        |-> lastPx.value,
         displayPrice                  |-> displayPrice.value,
         workingPrice                  |-> workingPrice.value,
         baseLiquidityIndicator        |-> baseLiquidityIndicator.value,
         expireTime                    |-> expireTime.value,
         secondaryOrderId              |-> secondaryOrderId.value,
         contraCapacity                |-> contraCapacity.value,
         attributedQuote               |-> attributedQuote.value,
         echoText                      |-> echoText.value,
         stopPx                        |-> stopPx.value,
         routingInst                   |-> routingInst.value,
         routStrategy                  |-> routStrategy.value,
         routeDeliveryMethod           |-> routeDeliveryMethod.value,
         exDestination                 |-> exDestination.value,
         marketingFeeCode              |-> marketingFeeCode.value,
         targetPartyId                 |-> targetPartyId.value,
         auctionId                     |-> auctionId.value,
         cmtaNumber                    |-> cmtaNumber.value,
         crossId                       |-> crossId.value,
         allocQty                      |-> allocQty.value,
         giveUpFirmId                  |-> giveUpFirmId.value,
         routingFirmId                 |-> routingFirmId.value,
         crossExclusionIndicator       |-> crossExclusionIndicator.value,
         clientIdAttr                  |-> clientIdAttr.value,
         frequentTraderId              |-> frequentTraderId.value,
         comboOrder                    |-> comboOrder.value,
         compression                   |-> compression.value,
         floorDestination              |-> floorDestination.value,
         floorRoutingInst              |-> floorRoutingInst.value,
         multiClassSprd                |-> multiClassSprd.value,
         orderOrigin                   |-> orderOrigin.value,
         priceType                     |-> priceType.value,
         strategyId                    |-> strategyId.value,
         held                          |-> held.value,
         stopPxType                    |-> stopPxType.value ], stopPxType.rest)

(* Order Restated Message with each field marked present by fields before it there exactly where they say *)
SettleOrderRestatedMessage(message) ==
    LET settled1 == [message EXCEPT !.orderRestatedReturnBitfield1 = IF message.numberOfReturnBitfields >= 1 THEN (IF message.orderRestatedReturnBitfield1 = << >> THEN <<0>> ELSE message.orderRestatedReturnBitfield1) ELSE << >>]
        settled2 == [settled1 EXCEPT !.orderRestatedReturnBitfield2 = IF settled1.numberOfReturnBitfields >= 2 THEN (IF settled1.orderRestatedReturnBitfield2 = << >> THEN <<0>> ELSE settled1.orderRestatedReturnBitfield2) ELSE << >>]
        settled3 == [settled2 EXCEPT !.orderRestatedReturnBitfield3 = IF settled2.numberOfReturnBitfields >= 3 THEN (IF settled2.orderRestatedReturnBitfield3 = << >> THEN <<0>> ELSE settled2.orderRestatedReturnBitfield3) ELSE << >>]
        settled4 == [settled3 EXCEPT !.orderRestatedReturnBitfield4 = IF settled3.numberOfReturnBitfields >= 4 THEN (IF settled3.orderRestatedReturnBitfield4 = << >> THEN <<0>> ELSE settled3.orderRestatedReturnBitfield4) ELSE << >>]
        settled5 == [settled4 EXCEPT !.orderRestatedReturnBitfield5 = IF settled4.numberOfReturnBitfields >= 5 THEN (IF settled4.orderRestatedReturnBitfield5 = << >> THEN <<0>> ELSE settled4.orderRestatedReturnBitfield5) ELSE << >>]
        settled6 == [settled5 EXCEPT !.orderRestatedReturnBitfield6 = IF settled5.numberOfReturnBitfields >= 6 THEN (IF settled5.orderRestatedReturnBitfield6 = << >> THEN <<0>> ELSE settled5.orderRestatedReturnBitfield6) ELSE << >>]
        settled7 == [settled6 EXCEPT !.orderRestatedReturnBitfield7 = IF settled6.numberOfReturnBitfields >= 7 THEN (IF settled6.orderRestatedReturnBitfield7 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled6.orderRestatedReturnBitfield7) ELSE << >>]
        settled8 == [settled7 EXCEPT !.orderRestatedReturnBitfield8 = IF settled7.numberOfReturnBitfields >= 8 THEN (IF settled7.orderRestatedReturnBitfield8 = << >> THEN <<0>> ELSE settled7.orderRestatedReturnBitfield8) ELSE << >>]
        settled9 == [settled8 EXCEPT !.orderRestatedReturnBitfield9 = IF settled8.numberOfReturnBitfields >= 9 THEN (IF settled8.orderRestatedReturnBitfield9 = << >> THEN <<0>> ELSE settled8.orderRestatedReturnBitfield9) ELSE << >>]
        settled10 == [settled9 EXCEPT !.orderRestatedReturnBitfield10 = IF settled9.numberOfReturnBitfields >= 10 THEN (IF settled9.orderRestatedReturnBitfield10 = << >> THEN <<0>> ELSE settled9.orderRestatedReturnBitfield10) ELSE << >>]
        settled11 == [settled10 EXCEPT !.orderRestatedReturnBitfield11 = IF settled10.numberOfReturnBitfields >= 11 THEN (IF settled10.orderRestatedReturnBitfield11 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled10.orderRestatedReturnBitfield11) ELSE << >>]
        settled12 == [settled11 EXCEPT !.orderRestatedReturnBitfield12 = IF settled11.numberOfReturnBitfields >= 12 THEN (IF settled11.orderRestatedReturnBitfield12 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled11.orderRestatedReturnBitfield12) ELSE << >>]
        settled13 == [settled12 EXCEPT !.orderRestatedReturnBitfield13 = IF settled12.numberOfReturnBitfields >= 13 THEN (IF settled12.orderRestatedReturnBitfield13 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled12.orderRestatedReturnBitfield13) ELSE << >>]
        settled14 == [settled13 EXCEPT !.orderRestatedReturnBitfield14 = IF settled13.numberOfReturnBitfields >= 14 THEN (IF settled13.orderRestatedReturnBitfield14 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled13.orderRestatedReturnBitfield14) ELSE << >>]
        settled15 == [settled14 EXCEPT !.orderRestatedReturnBitfield15 = IF settled14.numberOfReturnBitfields >= 15 THEN (IF settled14.orderRestatedReturnBitfield15 = << >> THEN <<0>> ELSE settled14.orderRestatedReturnBitfield15) ELSE << >>]
        settled16 == [settled15 EXCEPT !.orderRestatedReturnBitfield16 = IF settled15.numberOfReturnBitfields >= 16 THEN (IF settled15.orderRestatedReturnBitfield16 = << >> THEN <<0>> ELSE settled15.orderRestatedReturnBitfield16) ELSE << >>]
        settled17 == [settled16 EXCEPT !.orderRestatedReturnBitfield17 = IF settled16.numberOfReturnBitfields >= 17 THEN (IF settled16.orderRestatedReturnBitfield17 = << >> THEN <<0>> ELSE settled16.orderRestatedReturnBitfield17) ELSE << >>]
        settled18 == [settled17 EXCEPT !.orderRestatedReturnBitfield18 = IF settled17.numberOfReturnBitfields >= 18 THEN (IF settled17.orderRestatedReturnBitfield18 = << >> THEN <<0>> ELSE settled17.orderRestatedReturnBitfield18) ELSE << >>]
        settled19 == [settled18 EXCEPT !.orderRestatedReturnBitfield19 = IF settled18.numberOfReturnBitfields >= 19 THEN (IF settled18.orderRestatedReturnBitfield19 = << >> THEN <<0>> ELSE settled18.orderRestatedReturnBitfield19) ELSE << >>]
        settled20 == [settled19 EXCEPT !.side = IF settled19.numberOfReturnBitfields >= 1 /\ (settled19.orderRestatedReturnBitfield1 # << >> /\ settled19.orderRestatedReturnBitfield1[1] % 2 > 0) THEN (IF settled19.side = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled19.side) ELSE << >>]
        settled21 == [settled20 EXCEPT !.priceLong = IF settled20.numberOfReturnBitfields >= 1 /\ (settled20.orderRestatedReturnBitfield1 # << >> /\ (settled20.orderRestatedReturnBitfield1[1] \div 4) % 2 > 0) THEN (IF settled20.priceLong = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled20.priceLong) ELSE << >>]
        settled22 == [settled21 EXCEPT !.execInst = IF settled21.numberOfReturnBitfields >= 1 /\ (settled21.orderRestatedReturnBitfield1 # << >> /\ (settled21.orderRestatedReturnBitfield1[1] \div 8) % 2 > 0) THEN (IF settled21.execInst = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled21.execInst) ELSE << >>]
        settled23 == [settled22 EXCEPT !.ordType = IF settled22.numberOfReturnBitfields >= 1 /\ (settled22.orderRestatedReturnBitfield1 # << >> /\ (settled22.orderRestatedReturnBitfield1[1] \div 16) % 2 > 0) THEN (IF settled22.ordType = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled22.ordType) ELSE << >>]
        settled24 == [settled23 EXCEPT !.timeInForce = IF settled23.numberOfReturnBitfields >= 1 /\ (settled23.orderRestatedReturnBitfield1 # << >> /\ (settled23.orderRestatedReturnBitfield1[1] \div 32) % 2 > 0) THEN (IF settled23.timeInForce = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled23.timeInForce) ELSE << >>]
        settled25 == [settled24 EXCEPT !.minQty = IF settled24.numberOfReturnBitfields >= 1 /\ (settled24.orderRestatedReturnBitfield1 # << >> /\ (settled24.orderRestatedReturnBitfield1[1] \div 64) % 2 > 0) THEN (IF settled24.minQty = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled24.minQty) ELSE << >>]
        settled26 == [settled25 EXCEPT !.symbolLong = IF settled25.numberOfReturnBitfields >= 2 /\ (settled25.orderRestatedReturnBitfield2 # << >> /\ settled25.orderRestatedReturnBitfield2[1] % 2 > 0) THEN (IF settled25.symbolLong = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled25.symbolLong) ELSE << >>]
        settled27 == [settled26 EXCEPT !.capacity = IF settled26.numberOfReturnBitfields >= 2 /\ (settled26.orderRestatedReturnBitfield2 # << >> /\ (settled26.orderRestatedReturnBitfield2[1] \div 64) % 2 > 0) THEN (IF settled26.capacity = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled26.capacity) ELSE << >>]
        settled28 == [settled27 EXCEPT !.account = IF settled27.numberOfReturnBitfields >= 3 /\ (settled27.orderRestatedReturnBitfield3 # << >> /\ settled27.orderRestatedReturnBitfield3[1] % 2 > 0) THEN (IF settled27.account = << >> THEN <<[i \in 1 .. 16 |-> 0]>> ELSE settled27.account) ELSE << >>]
        settled29 == [settled28 EXCEPT !.clearingFirm = IF settled28.numberOfReturnBitfields >= 3 /\ (settled28.orderRestatedReturnBitfield3 # << >> /\ (settled28.orderRestatedReturnBitfield3[1] \div 2) % 2 > 0) THEN (IF settled28.clearingFirm = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled28.clearingFirm) ELSE << >>]
        settled30 == [settled29 EXCEPT !.clearingAccount = IF settled29.numberOfReturnBitfields >= 3 /\ (settled29.orderRestatedReturnBitfield3 # << >> /\ (settled29.orderRestatedReturnBitfield3[1] \div 4) % 2 > 0) THEN (IF settled29.clearingAccount = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled29.clearingAccount) ELSE << >>]
        settled31 == [settled30 EXCEPT !.displayIndicator = IF settled30.numberOfReturnBitfields >= 3 /\ (settled30.orderRestatedReturnBitfield3 # << >> /\ (settled30.orderRestatedReturnBitfield3[1] \div 8) % 2 > 0) THEN (IF settled30.displayIndicator = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled30.displayIndicator) ELSE << >>]
        settled32 == [settled31 EXCEPT !.maxFloor = IF settled31.numberOfReturnBitfields >= 3 /\ (settled31.orderRestatedReturnBitfield3 # << >> /\ (settled31.orderRestatedReturnBitfield3[1] \div 16) % 2 > 0) THEN (IF settled31.maxFloor = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled31.maxFloor) ELSE << >>]
        settled33 == [settled32 EXCEPT !.orderQtyLong = IF settled32.numberOfReturnBitfields >= 3 /\ (settled32.orderRestatedReturnBitfield3 # << >> /\ (settled32.orderRestatedReturnBitfield3[1] \div 64) % 2 > 0) THEN (IF settled32.orderQtyLong = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled32.orderQtyLong) ELSE << >>]
        settled34 == [settled33 EXCEPT !.preventMatch = IF settled33.numberOfReturnBitfields >= 3 /\ (settled33.orderRestatedReturnBitfield3 # << >> /\ (settled33.orderRestatedReturnBitfield3[1] \div 128) % 2 > 0) THEN (IF settled33.preventMatch = << >> THEN <<[i \in 1 .. 3 |-> 0]>> ELSE settled33.preventMatch) ELSE << >>]
        settled35 == [settled34 EXCEPT !.maturityDate = IF settled34.numberOfReturnBitfields >= 4 /\ (settled34.orderRestatedReturnBitfield4 # << >> /\ settled34.orderRestatedReturnBitfield4[1] % 2 > 0) THEN (IF settled34.maturityDate = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled34.maturityDate) ELSE << >>]
        settled36 == [settled35 EXCEPT !.strikePrice = IF settled35.numberOfReturnBitfields >= 4 /\ (settled35.orderRestatedReturnBitfield4 # << >> /\ (settled35.orderRestatedReturnBitfield4[1] \div 2) % 2 > 0) THEN (IF settled35.strikePrice = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled35.strikePrice) ELSE << >>]
        settled37 == [settled36 EXCEPT !.putOrCall = IF settled36.numberOfReturnBitfields >= 4 /\ (settled36.orderRestatedReturnBitfield4 # << >> /\ (settled36.orderRestatedReturnBitfield4[1] \div 4) % 2 > 0) THEN (IF settled36.putOrCall = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled36.putOrCall) ELSE << >>]
        settled38 == [settled37 EXCEPT !.openClose = IF settled37.numberOfReturnBitfields >= 4 /\ (settled37.orderRestatedReturnBitfield4 # << >> /\ (settled37.orderRestatedReturnBitfield4[1] \div 8) % 2 > 0) THEN (IF settled37.openClose = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled37.openClose) ELSE << >>]
        settled39 == [settled38 EXCEPT !.correctedSize = IF settled38.numberOfReturnBitfields >= 4 /\ (settled38.orderRestatedReturnBitfield4 # << >> /\ (settled38.orderRestatedReturnBitfield4[1] \div 32) % 2 > 0) THEN (IF settled38.correctedSize = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled38.correctedSize) ELSE << >>]
        settled40 == [settled39 EXCEPT !.origClOrdId = IF settled39.numberOfReturnBitfields >= 5 /\ (settled39.orderRestatedReturnBitfield5 # << >> /\ settled39.orderRestatedReturnBitfield5[1] % 2 > 0) THEN (IF settled39.origClOrdId = << >> THEN <<[i \in 1 .. 20 |-> 0]>> ELSE settled39.origClOrdId) ELSE << >>]
        settled41 == [settled40 EXCEPT !.leavesQty = IF settled40.numberOfReturnBitfields >= 5 /\ (settled40.orderRestatedReturnBitfield5 # << >> /\ (settled40.orderRestatedReturnBitfield5[1] \div 2) % 2 > 0) THEN (IF settled40.leavesQty = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled40.leavesQty) ELSE << >>]
