        settled57 == [settled56 EXCEPT !.routeDeliveryMethod = IF settled56.numberOfReturnBitfields >= 8 /\ (settled56.orderCancelledReturnBitfield8 # << >> /\ (settled56.orderCancelledReturnBitfield8[1] \div 32) % 2 > 0) THEN (IF settled56.routeDeliveryMethod = << >> THEN <<[i \in 1 .. 3 |-> 0]>> ELSE settled56.routeDeliveryMethod) ELSE << >>]
        settled58 == [settled57 EXCEPT !.exDestination = IF settled57.numberOfReturnBitfields >= 8 /\ (settled57.orderCancelledReturnBitfield8 # << >> /\ (settled57.orderCancelledReturnBitfield8[1] \div 64) % 2 > 0) THEN (IF settled57.exDestination = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled57.exDestination) ELSE << >>]
        settled59 == [settled58 EXCEPT !.marketingFeeCode = IF settled58.numberOfReturnBitfields >= 9 /\ (settled58.orderCancelledReturnBitfield9 # << >> /\ settled58.orderCancelledReturnBitfield9[1] % 2 > 0) THEN (IF settled58.marketingFeeCode = << >> THEN <<[i \in 1 .. 2 |-> 0]>> ELSE settled58.marketingFeeCode) ELSE << >>]
        settled60 == [settled59 EXCEPT !.targetPartyId = IF settled59.numberOfReturnBitfields >= 9 /\ (settled59.orderCancelledReturnBitfield9 # << >> /\ (settled59.orderCancelledReturnBitfield9[1] \div 2) % 2 > 0) THEN (IF settled59.targetPartyId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled59.targetPartyId) ELSE << >>]
        settled61 == [settled60 EXCEPT !.auctionId = IF settled60.numberOfReturnBitfields >= 9 /\ (settled60.orderCancelledReturnBitfield9 # << >> /\ (settled60.orderCancelledReturnBitfield9[1] \div 4) % 2 > 0) THEN (IF settled60.auctionId = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled60.auctionId) ELSE << >>]
        settled62 == [settled61 EXCEPT !.cmtaNumber = IF settled61.numberOfReturnBitfields >= 9 /\ (settled61.orderCancelledReturnBitfield9 # << >> /\ (settled61.orderCancelledReturnBitfield9[1] \div 32) % 2 > 0) THEN (IF settled61.cmtaNumber = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled61.cmtaNumber) ELSE << >>]
        settled63 == [settled62 EXCEPT !.crossId = IF settled62.numberOfReturnBitfields >= 10 /\ (settled62.orderCancelledReturnBitfield10 # << >> /\ settled62.orderCancelledReturnBitfield10[1] % 2 > 0) THEN (IF settled62.crossId = << >> THEN <<[i \in 1 .. 20 |-> 0]>> ELSE settled62.crossId) ELSE << >>]
