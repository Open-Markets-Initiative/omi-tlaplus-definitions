      floorDestination              : { << >> } \cup { <<held>> : held \in Sample(4) },
      floorRoutingInst              : { << >> } \cup { <<held>> : held \in Sample(1) },
      multiClassSprd                : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderOrigin                   : { << >> } \cup { <<held>> : held \in Sample(3) },
      priceType                     : { << >> } \cup { <<held>> : held \in Sample(1) },
      strategyId                    : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossInitiator                : { << >> } \cup { <<held>> : held \in Sample(4) },
      subreason                     : { << >> } \cup { <<held>> : held \in Sample(1) },
      held                          : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOnBehalfOfId             : { << >> } \cup { <<held>> : held \in Sample(4) },
      stopPxType                    : { << >> } \cup { <<held>> : held \in Sample(1) } ]

EncodeOrderRejectedMessage(message) ==
    message.transactionTime
        \o message.clOrdId
        \o message.orderRejectReason
        \o message.text
        \o message.reserved1
        \o EncodeUIntBE(message.numberOfReturnBitfields, 1)
        \o (IF message.orderRejectedReturnBitfield1 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRejectedReturnBitfield1[1], 1))
        \o (IF message.orderRejectedReturnBitfield2 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRejectedReturnBitfield2[1], 1))
        \o (IF message.orderRejectedReturnBitfield3 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRejectedReturnBitfield3[1], 1))
        \o (IF message.orderRejectedReturnBitfield4 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRejectedReturnBitfield4[1], 1))
        \o (IF message.orderRejectedReturnBitfield5 = << >> THEN << >> ELSE message.orderRejectedReturnBitfield5[1])
        \o (IF message.orderRejectedReturnBitfield6 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRejectedReturnBitfield6[1], 1))
        \o (IF message.orderRejectedReturnBitfield7 = << >> THEN << >> ELSE message.orderRejectedReturnBitfield7[1])
        \o (IF message.orderRejectedReturnBitfield8 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRejectedReturnBitfield8[1], 1))
        \o (IF message.orderRejectedReturnBitfield9 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRejectedReturnBitfield9[1], 1))
        \o (IF message.orderRejectedReturnBitfield10 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRejectedReturnBitfield10[1], 1))
        \o (IF message.orderRejectedReturnBitfield11 = << >> THEN << >> ELSE message.orderRejectedReturnBitfield11[1])
        \o (IF message.orderRejectedReturnBitfield12 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRejectedReturnBitfield12[1], 1))
        \o (IF message.orderRejectedReturnBitfield13 = << >> THEN << >> ELSE message.orderRejectedReturnBitfield13[1])
        \o (IF message.orderRejectedReturnBitfield14 = << >> THEN << >> ELSE message.orderRejectedReturnBitfield14[1])
        \o (IF message.orderRejectedReturnBitfield15 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRejectedReturnBitfield15[1], 1))
        \o (IF message.orderRejectedReturnBitfield16 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRejectedReturnBitfield16[1], 1))
        \o (IF message.orderRejectedReturnBitfield17 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRejectedReturnBitfield17[1], 1))
        \o (IF message.orderRejectedReturnBitfield18 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRejectedReturnBitfield18[1], 1))
        \o (IF message.orderRejectedReturnBitfield19 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRejectedReturnBitfield19[1], 1))
        \o (IF message.orderRejectedReturnBitfield20 = << >> THEN << >> ELSE message.orderRejectedReturnBitfield20[1])
        \o (IF message.orderRejectedReturnBitfield21 = << >> THEN << >> ELSE message.orderRejectedReturnBitfield21[1])
        \o (IF message.side = << >> THEN << >> ELSE message.side[1])
        \o (IF message.priceLong = << >> THEN << >> ELSE message.priceLong[1])
        \o (IF message.execInst = << >> THEN << >> ELSE message.execInst[1])
        \o (IF message.ordType = << >> THEN << >> ELSE message.ordType[1])
        \o (IF message.timeInForce = << >> THEN << >> ELSE message.timeInForce[1])
        \o (IF message.minQty = << >> THEN << >> ELSE message.minQty[1])
        \o (IF message.symbolLong = << >> THEN << >> ELSE message.symbolLong[1])
        \o (IF message.capacity = << >> THEN << >> ELSE message.capacity[1])
        \o (IF message.account = << >> THEN << >> ELSE message.account[1])
        \o (IF message.clearingFirm = << >> THEN << >> ELSE message.clearingFirm[1])
        \o (IF message.clearingAccount = << >> THEN << >> ELSE message.clearingAccount[1])
        \o (IF message.displayIndicator = << >> THEN << >> ELSE message.displayIndicator[1])
        \o (IF message.maxFloor = << >> THEN << >> ELSE message.maxFloor[1])
        \o (IF message.orderQtyLong = << >> THEN << >> ELSE message.orderQtyLong[1])
        \o (IF message.preventMatch = << >> THEN << >> ELSE message.preventMatch[1])
        \o (IF message.maturityDate = << >> THEN << >> ELSE message.maturityDate[1])
        \o (IF message.strikePrice = << >> THEN << >> ELSE message.strikePrice[1])
        \o (IF message.putOrCall = << >> THEN << >> ELSE message.putOrCall[1])
        \o (IF message.openClose = << >> THEN << >> ELSE message.openClose[1])
        \o (IF message.correctedSize = << >> THEN << >> ELSE message.correctedSize[1])
        \o (IF message.secondaryOrderId = << >> THEN << >> ELSE message.secondaryOrderId[1])
        \o (IF message.contraCapacity = << >> THEN << >> ELSE message.contraCapacity[1])
        \o (IF message.attributedQuote = << >> THEN << >> ELSE message.attributedQuote[1])
        \o (IF message.echoText = << >> THEN << >> ELSE message.echoText[1])
        \o (IF message.stopPx = << >> THEN << >> ELSE message.stopPx[1])
        \o (IF message.routingInst = << >> THEN << >> ELSE message.routingInst[1])
        \o (IF message.routStrategy = << >> THEN << >> ELSE message.routStrategy[1])
        \o (IF message.routeDeliveryMethod = << >> THEN << >> ELSE message.routeDeliveryMethod[1])
        \o (IF message.exDestination = << >> THEN << >> ELSE message.exDestination[1])
        \o (IF message.marketingFeeCode = << >> THEN << >> ELSE message.marketingFeeCode[1])
        \o (IF message.targetPartyId = << >> THEN << >> ELSE message.targetPartyId[1])
        \o (IF message.auctionId = << >> THEN << >> ELSE message.auctionId[1])
        \o (IF message.cmtaNumber = << >> THEN << >> ELSE message.cmtaNumber[1])
        \o (IF message.crossId = << >> THEN << >> ELSE message.crossId[1])
        \o (IF message.allocQty = << >> THEN << >> ELSE message.allocQty[1])
        \o (IF message.giveUpFirmId = << >> THEN << >> ELSE message.giveUpFirmId[1])
        \o (IF message.routingFirmId = << >> THEN << >> ELSE message.routingFirmId[1])
        \o (IF message.crossExclusionIndicator = << >> THEN << >> ELSE message.crossExclusionIndicator[1])
        \o (IF message.clearingOptionalData = << >> THEN << >> ELSE message.clearingOptionalData[1])
        \o (IF message.equityPartyId = << >> THEN << >> ELSE message.equityPartyId[1])
        \o (IF message.clientIdAttr = << >> THEN << >> ELSE message.clientIdAttr[1])
        \o (IF message.frequentTraderId = << >> THEN << >> ELSE message.frequentTraderId[1])
        \o (IF message.sessionEligibility = << >> THEN << >> ELSE message.sessionEligibility[1])
        \o (IF message.comboOrder = << >> THEN << >> ELSE message.comboOrder[1])
        \o (IF message.compression = << >> THEN << >> ELSE message.compression[1])
        \o (IF message.floorDestination = << >> THEN << >> ELSE message.floorDestination[1])
        \o (IF message.floorRoutingInst = << >> THEN << >> ELSE message.floorRoutingInst[1])
        \o (IF message.multiClassSprd = << >> THEN << >> ELSE message.multiClassSprd[1])
        \o (IF message.orderOrigin = << >> THEN << >> ELSE message.orderOrigin[1])
        \o (IF message.priceType = << >> THEN << >> ELSE message.priceType[1])
        \o (IF message.strategyId = << >> THEN << >> ELSE message.strategyId[1])
        \o (IF message.crossInitiator = << >> THEN << >> ELSE message.crossInitiator[1])
        \o (IF message.subreason = << >> THEN << >> ELSE message.subreason[1])
        \o (IF message.held = << >> THEN << >> ELSE message.held[1])
        \o (IF message.crossOnBehalfOfId = << >> THEN << >> ELSE message.crossOnBehalfOfId[1])
        \o (IF message.stopPxType = << >> THEN << >> ELSE message.stopPxType[1])

DecodeOrderRejectedMessage(bytes) ==
    LET transactionTime == ReadBytes(bytes, 8) IN IF ~transactionTime.ok THEN Fail ELSE
    LET clOrdId == ReadBytes(transactionTime.rest, 20) IN IF ~clOrdId.ok THEN Fail ELSE
    LET orderRejectReason == ReadBytes(clOrdId.rest, 1) IN IF ~orderRejectReason.ok THEN Fail ELSE
    LET text == ReadBytes(orderRejectReason.rest, 60) IN IF ~text.ok THEN Fail ELSE
    LET reserved1 == ReadBytes(text.rest, 1) IN IF ~reserved1.ok THEN Fail ELSE
    LET numberOfReturnBitfields == ReadUIntBE(reserved1.rest, 1) IN IF ~numberOfReturnBitfields.ok THEN Fail ELSE
    LET orderRejectedReturnBitfield1 == ReadWhen(numberOfReturnBitfields.value >= 1, ReadUIntLE(numberOfReturnBitfields.rest, 1), numberOfReturnBitfields.rest) IN IF ~orderRejectedReturnBitfield1.ok THEN Fail ELSE
    LET orderRejectedReturnBitfield2 == ReadWhen(numberOfReturnBitfields.value >= 2, ReadUIntLE(orderRejectedReturnBitfield1.rest, 1), orderRejectedReturnBitfield1.rest) IN IF ~orderRejectedReturnBitfield2.ok THEN Fail ELSE
    LET orderRejectedReturnBitfield3 == ReadWhen(numberOfReturnBitfields.value >= 3, ReadUIntLE(orderRejectedReturnBitfield2.rest, 1), orderRejectedReturnBitfield2.rest) IN IF ~orderRejectedReturnBitfield3.ok THEN Fail ELSE
    LET orderRejectedReturnBitfield4 == ReadWhen(numberOfReturnBitfields.value >= 4, ReadUIntLE(orderRejectedReturnBitfield3.rest, 1), orderRejectedReturnBitfield3.rest) IN IF ~orderRejectedReturnBitfield4.ok THEN Fail ELSE
    LET orderRejectedReturnBitfield5 == ReadWhen(numberOfReturnBitfields.value >= 5, ReadBytes(orderRejectedReturnBitfield4.rest, 1), orderRejectedReturnBitfield4.rest) IN IF ~orderRejectedReturnBitfield5.ok THEN Fail ELSE
    LET orderRejectedReturnBitfield6 == ReadWhen(numberOfReturnBitfields.value >= 6, ReadUIntLE(orderRejectedReturnBitfield5.rest, 1), orderRejectedReturnBitfield5.rest) IN IF ~orderRejectedReturnBitfield6.ok THEN Fail ELSE
    LET orderRejectedReturnBitfield7 == ReadWhen(numberOfReturnBitfields.value >= 7, ReadBytes(orderRejectedReturnBitfield6.rest, 1), orderRejectedReturnBitfield6.rest) IN IF ~orderRejectedReturnBitfield7.ok THEN Fail ELSE
    LET orderRejectedReturnBitfield8 == ReadWhen(numberOfReturnBitfields.value >= 8, ReadUIntLE(orderRejectedReturnBitfield7.rest, 1), orderRejectedReturnBitfield7.rest) IN IF ~orderRejectedReturnBitfield8.ok THEN Fail ELSE
    LET orderRejectedReturnBitfield9 == ReadWhen(numberOfReturnBitfields.value >= 9, ReadUIntLE(orderRejectedReturnBitfield8.rest, 1), orderRejectedReturnBitfield8.rest) IN IF ~orderRejectedReturnBitfield9.ok THEN Fail ELSE
    LET orderRejectedReturnBitfield10 == ReadWhen(numberOfReturnBitfields.value >= 10, ReadUIntLE(orderRejectedReturnBitfield9.rest, 1), orderRejectedReturnBitfield9.rest) IN IF ~orderRejectedReturnBitfield10.ok THEN Fail ELSE
    LET orderRejectedReturnBitfield11 == ReadWhen(numberOfReturnBitfields.value >= 11, ReadBytes(orderRejectedReturnBitfield10.rest, 1), orderRejectedReturnBitfield10.rest) IN IF ~orderRejectedReturnBitfield11.ok THEN Fail ELSE
    LET orderRejectedReturnBitfield12 == ReadWhen(numberOfReturnBitfields.value >= 12, ReadUIntLE(orderRejectedReturnBitfield11.rest, 1), orderRejectedReturnBitfield11.rest) IN IF ~orderRejectedReturnBitfield12.ok THEN Fail ELSE
    LET orderRejectedReturnBitfield13 == ReadWhen(numberOfReturnBitfields.value >= 13, ReadBytes(orderRejectedReturnBitfield12.rest, 1), orderRejectedReturnBitfield12.rest) IN IF ~orderRejectedReturnBitfield13.ok THEN Fail ELSE
    LET orderRejectedReturnBitfield14 == ReadWhen(numberOfReturnBitfields.value >= 14, ReadBytes(orderRejectedReturnBitfield13.rest, 1), orderRejectedReturnBitfield13.rest) IN IF ~orderRejectedReturnBitfield14.ok THEN Fail ELSE
    LET orderRejectedReturnBitfield15 == ReadWhen(numberOfReturnBitfields.value >= 15, ReadUIntLE(orderRejectedReturnBitfield14.rest, 1), orderRejectedReturnBitfield14.rest) IN IF ~orderRejectedReturnBitfield15.ok THEN Fail ELSE
    LET orderRejectedReturnBitfield16 == ReadWhen(numberOfReturnBitfields.value >= 16, ReadUIntLE(orderRejectedReturnBitfield15.rest, 1), orderRejectedReturnBitfield15.rest) IN IF ~orderRejectedReturnBitfield16.ok THEN Fail ELSE
    LET orderRejectedReturnBitfield17 == ReadWhen(numberOfReturnBitfields.value >= 17, ReadUIntLE(orderRejectedReturnBitfield16.rest, 1), orderRejectedReturnBitfield16.rest) IN IF ~orderRejectedReturnBitfield17.ok THEN Fail ELSE
    LET orderRejectedReturnBitfield18 == ReadWhen(numberOfReturnBitfields.value >= 18, ReadUIntLE(orderRejectedReturnBitfield17.rest, 1), orderRejectedReturnBitfield17.rest) IN IF ~orderRejectedReturnBitfield18.ok THEN Fail ELSE
    LET orderRejectedReturnBitfield19 == ReadWhen(numberOfReturnBitfields.value >= 19, ReadUIntLE(orderRejectedReturnBitfield18.rest, 1), orderRejectedReturnBitfield18.rest) IN IF ~orderRejectedReturnBitfield19.ok THEN Fail ELSE
    LET orderRejectedReturnBitfield20 == ReadWhen(numberOfReturnBitfields.value >= 20, ReadBytes(orderRejectedReturnBitfield19.rest, 1), orderRejectedReturnBitfield19.rest) IN IF ~orderRejectedReturnBitfield20.ok THEN Fail ELSE
    LET orderRejectedReturnBitfield21 == ReadWhen(numberOfReturnBitfields.value >= 21, ReadBytes(orderRejectedReturnBitfield20.rest, 1), orderRejectedReturnBitfield20.rest) IN IF ~orderRejectedReturnBitfield21.ok THEN Fail ELSE
    LET side == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderRejectedReturnBitfield1.value # << >> /\ orderRejectedReturnBitfield1.value[1] % 2 > 0), ReadBytes(orderRejectedReturnBitfield21.rest, 1), orderRejectedReturnBitfield21.rest) IN IF ~side.ok THEN Fail ELSE
    LET priceLong == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderRejectedReturnBitfield1.value # << >> /\ (orderRejectedReturnBitfield1.value[1] \div 4) % 2 > 0), ReadBytes(side.rest, 8), side.rest) IN IF ~priceLong.ok THEN Fail ELSE
    LET execInst == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderRejectedReturnBitfield1.value # << >> /\ (orderRejectedReturnBitfield1.value[1] \div 8) % 2 > 0), ReadBytes(priceLong.rest, 1), priceLong.rest) IN IF ~execInst.ok THEN Fail ELSE
    LET ordType == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderRejectedReturnBitfield1.value # << >> /\ (orderRejectedReturnBitfield1.value[1] \div 16) % 2 > 0), ReadBytes(execInst.rest, 1), execInst.rest) IN IF ~ordType.ok THEN Fail ELSE
    LET timeInForce == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderRejectedReturnBitfield1.value # << >> /\ (orderRejectedReturnBitfield1.value[1] \div 32) % 2 > 0), ReadBytes(ordType.rest, 1), ordType.rest) IN IF ~timeInForce.ok THEN Fail ELSE
    LET minQty == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderRejectedReturnBitfield1.value # << >> /\ (orderRejectedReturnBitfield1.value[1] \div 64) % 2 > 0), ReadBytes(timeInForce.rest, 4), timeInForce.rest) IN IF ~minQty.ok THEN Fail ELSE
    LET symbolLong == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (orderRejectedReturnBitfield2.value # << >> /\ orderRejectedReturnBitfield2.value[1] % 2 > 0), ReadBytes(minQty.rest, 8), minQty.rest) IN IF ~symbolLong.ok THEN Fail ELSE
    LET capacity == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (orderRejectedReturnBitfield2.value # << >> /\ (orderRejectedReturnBitfield2.value[1] \div 64) % 2 > 0), ReadBytes(symbolLong.rest, 1), symbolLong.rest) IN IF ~capacity.ok THEN Fail ELSE
    LET account == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderRejectedReturnBitfield3.value # << >> /\ orderRejectedReturnBitfield3.value[1] % 2 > 0), ReadBytes(capacity.rest, 16), capacity.rest) IN IF ~account.ok THEN Fail ELSE
    LET clearingFirm == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderRejectedReturnBitfield3.value # << >> /\ (orderRejectedReturnBitfield3.value[1] \div 2) % 2 > 0), ReadBytes(account.rest, 4), account.rest) IN IF ~clearingFirm.ok THEN Fail ELSE
    LET clearingAccount == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderRejectedReturnBitfield3.value # << >> /\ (orderRejectedReturnBitfield3.value[1] \div 4) % 2 > 0), ReadBytes(clearingFirm.rest, 4), clearingFirm.rest) IN IF ~clearingAccount.ok THEN Fail ELSE
    LET displayIndicator == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderRejectedReturnBitfield3.value # << >> /\ (orderRejectedReturnBitfield3.value[1] \div 8) % 2 > 0), ReadBytes(clearingAccount.rest, 1), clearingAccount.rest) IN IF ~displayIndicator.ok THEN Fail ELSE
    LET maxFloor == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderRejectedReturnBitfield3.value # << >> /\ (orderRejectedReturnBitfield3.value[1] \div 16) % 2 > 0), ReadBytes(displayIndicator.rest, 4), displayIndicator.rest) IN IF ~maxFloor.ok THEN Fail ELSE
    LET orderQtyLong == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderRejectedReturnBitfield3.value # << >> /\ (orderRejectedReturnBitfield3.value[1] \div 64) % 2 > 0), ReadBytes(maxFloor.rest, 4), maxFloor.rest) IN IF ~orderQtyLong.ok THEN Fail ELSE
    LET preventMatch == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderRejectedReturnBitfield3.value # << >> /\ (orderRejectedReturnBitfield3.value[1] \div 128) % 2 > 0), ReadBytes(orderQtyLong.rest, 3), orderQtyLong.rest) IN IF ~preventMatch.ok THEN Fail ELSE
    LET maturityDate == ReadWhen(numberOfReturnBitfields.value >= 4 /\ (orderRejectedReturnBitfield4.value # << >> /\ orderRejectedReturnBitfield4.value[1] % 2 > 0), ReadBytes(preventMatch.rest, 4), preventMatch.rest) IN IF ~maturityDate.ok THEN Fail ELSE
    LET strikePrice == ReadWhen(numberOfReturnBitfields.value >= 4 /\ (orderRejectedReturnBitfield4.value # << >> /\ (orderRejectedReturnBitfield4.value[1] \div 2) % 2 > 0), ReadBytes(maturityDate.rest, 8), maturityDate.rest) IN IF ~strikePrice.ok THEN Fail ELSE
    LET putOrCall == ReadWhen(numberOfReturnBitfields.value >= 4 /\ (orderRejectedReturnBitfield4.value # << >> /\ (orderRejectedReturnBitfield4.value[1] \div 4) % 2 > 0), ReadBytes(strikePrice.rest, 1), strikePrice.rest) IN IF ~putOrCall.ok THEN Fail ELSE
    LET openClose == ReadWhen(numberOfReturnBitfields.value >= 4 /\ (orderRejectedReturnBitfield4.value # << >> /\ (orderRejectedReturnBitfield4.value[1] \div 8) % 2 > 0), ReadBytes(putOrCall.rest, 1), putOrCall.rest) IN IF ~openClose.ok THEN Fail ELSE
    LET correctedSize == ReadWhen(numberOfReturnBitfields.value >= 4 /\ (orderRejectedReturnBitfield4.value # << >> /\ (orderRejectedReturnBitfield4.value[1] \div 32) % 2 > 0), ReadBytes(openClose.rest, 4), openClose.rest) IN IF ~correctedSize.ok THEN Fail ELSE
    LET secondaryOrderId == ReadWhen(numberOfReturnBitfields.value >= 6 /\ (orderRejectedReturnBitfield6.value # << >> /\ orderRejectedReturnBitfield6.value[1] % 2 > 0), ReadBytes(correctedSize.rest, 8), correctedSize.rest) IN IF ~secondaryOrderId.ok THEN Fail ELSE
    LET contraCapacity == ReadWhen(numberOfReturnBitfields.value >= 6 /\ (orderRejectedReturnBitfield6.value # << >> /\ (orderRejectedReturnBitfield6.value[1] \div 4) % 2 > 0), ReadBytes(secondaryOrderId.rest, 1), secondaryOrderId.rest) IN IF ~contraCapacity.ok THEN Fail ELSE
    LET attributedQuote == ReadWhen(numberOfReturnBitfields.value >= 6 /\ (orderRejectedReturnBitfield6.value # << >> /\ (orderRejectedReturnBitfield6.value[1] \div 8) % 2 > 0), ReadBytes(contraCapacity.rest, 1), contraCapacity.rest) IN IF ~attributedQuote.ok THEN Fail ELSE
    LET echoText == ReadWhen(numberOfReturnBitfields.value >= 8 /\ (orderRejectedReturnBitfield8.value # << >> /\ (orderRejectedReturnBitfield8.value[1] \div 2) % 2 > 0), ReadBytes(attributedQuote.rest, 64), attributedQuote.rest) IN IF ~echoText.ok THEN Fail ELSE
    LET stopPx == ReadWhen(numberOfReturnBitfields.value >= 8 /\ (orderRejectedReturnBitfield8.value # << >> /\ (orderRejectedReturnBitfield8.value[1] \div 4) % 2 > 0), ReadBytes(echoText.rest, 8), echoText.rest) IN IF ~stopPx.ok THEN Fail ELSE
    LET routingInst == ReadWhen(numberOfReturnBitfields.value >= 8 /\ (orderRejectedReturnBitfield8.value # << >> /\ (orderRejectedReturnBitfield8.value[1] \div 8) % 2 > 0), ReadBytes(stopPx.rest, 4), stopPx.rest) IN IF ~routingInst.ok THEN Fail ELSE
    LET routStrategy == ReadWhen(numberOfReturnBitfields.value >= 8 /\ (orderRejectedReturnBitfield8.value # << >> /\ (orderRejectedReturnBitfield8.value[1] \div 16) % 2 > 0), ReadBytes(routingInst.rest, 6), routingInst.rest) IN IF ~routStrategy.ok THEN Fail ELSE
    LET routeDeliveryMethod == ReadWhen(numberOfReturnBitfields.value >= 8 /\ (orderRejectedReturnBitfield8.value # << >> /\ (orderRejectedReturnBitfield8.value[1] \div 32) % 2 > 0), ReadBytes(routStrategy.rest, 3), routStrategy.rest) IN IF ~routeDeliveryMethod.ok THEN Fail ELSE
    LET exDestination == ReadWhen(numberOfReturnBitfields.value >= 8 /\ (orderRejectedReturnBitfield8.value # << >> /\ (orderRejectedReturnBitfield8.value[1] \div 64) % 2 > 0), ReadBytes(routeDeliveryMethod.rest, 1), routeDeliveryMethod.rest) IN IF ~exDestination.ok THEN Fail ELSE
    LET marketingFeeCode == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (orderRejectedReturnBitfield9.value # << >> /\ orderRejectedReturnBitfield9.value[1] % 2 > 0), ReadBytes(exDestination.rest, 2), exDestination.rest) IN IF ~marketingFeeCode.ok THEN Fail ELSE
    LET targetPartyId == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (orderRejectedReturnBitfield9.value # << >> /\ (orderRejectedReturnBitfield9.value[1] \div 2) % 2 > 0), ReadBytes(marketingFeeCode.rest, 4), marketingFeeCode.rest) IN IF ~targetPartyId.ok THEN Fail ELSE
    LET auctionId == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (orderRejectedReturnBitfield9.value # << >> /\ (orderRejectedReturnBitfield9.value[1] \div 4) % 2 > 0), ReadBytes(targetPartyId.rest, 8), targetPartyId.rest) IN IF ~auctionId.ok THEN Fail ELSE
    LET cmtaNumber == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (orderRejectedReturnBitfield9.value # << >> /\ (orderRejectedReturnBitfield9.value[1] \div 32) % 2 > 0), ReadBytes(auctionId.rest, 4), auctionId.rest) IN IF ~cmtaNumber.ok THEN Fail ELSE
    LET crossId == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (orderRejectedReturnBitfield10.value # << >> /\ orderRejectedReturnBitfield10.value[1] % 2 > 0), ReadBytes(cmtaNumber.rest, 20), cmtaNumber.rest) IN IF ~crossId.ok THEN Fail ELSE
    LET allocQty == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (orderRejectedReturnBitfield10.value # << >> /\ (orderRejectedReturnBitfield10.value[1] \div 2) % 2 > 0), ReadBytes(crossId.rest, 4), crossId.rest) IN IF ~allocQty.ok THEN Fail ELSE
    LET giveUpFirmId == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (orderRejectedReturnBitfield10.value # << >> /\ (orderRejectedReturnBitfield10.value[1] \div 4) % 2 > 0), ReadBytes(allocQty.rest, 4), allocQty.rest) IN IF ~giveUpFirmId.ok THEN Fail ELSE
    LET routingFirmId == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (orderRejectedReturnBitfield10.value # << >> /\ (orderRejectedReturnBitfield10.value[1] \div 8) % 2 > 0), ReadBytes(giveUpFirmId.rest, 4), giveUpFirmId.rest) IN IF ~routingFirmId.ok THEN Fail ELSE
    LET crossExclusionIndicator == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (orderRejectedReturnBitfield10.value # << >> /\ (orderRejectedReturnBitfield10.value[1] \div 32) % 2 > 0), ReadBytes(routingFirmId.rest, 1), routingFirmId.rest) IN IF ~crossExclusionIndicator.ok THEN Fail ELSE
    LET clearingOptionalData == ReadWhen(numberOfReturnBitfields.value >= 12 /\ (orderRejectedReturnBitfield12.value # << >> /\ (orderRejectedReturnBitfield12.value[1] \div 128) % 2 > 0), ReadBytes(crossExclusionIndicator.rest, 16), crossExclusionIndicator.rest) IN IF ~clearingOptionalData.ok THEN Fail ELSE
    LET equityPartyId == ReadWhen(numberOfReturnBitfields.value >= 15 /\ (orderRejectedReturnBitfield15.value # << >> /\ (orderRejectedReturnBitfield15.value[1] \div 2) % 2 > 0), ReadBytes(clearingOptionalData.rest, 4), clearingOptionalData.rest) IN IF ~equityPartyId.ok THEN Fail ELSE
    LET clientIdAttr == ReadWhen(numberOfReturnBitfields.value >= 15 /\ (orderRejectedReturnBitfield15.value # << >> /\ (orderRejectedReturnBitfield15.value[1] \div 128) % 2 > 0), ReadBytes(equityPartyId.rest, 4), equityPartyId.rest) IN IF ~clientIdAttr.ok THEN Fail ELSE
    LET frequentTraderId == ReadWhen(numberOfReturnBitfields.value >= 16 /\ (orderRejectedReturnBitfield16.value # << >> /\ orderRejectedReturnBitfield16.value[1] % 2 > 0), ReadBytes(clientIdAttr.rest, 6), clientIdAttr.rest) IN IF ~frequentTraderId.ok THEN Fail ELSE
    LET sessionEligibility == ReadWhen(numberOfReturnBitfields.value >= 16 /\ (orderRejectedReturnBitfield16.value # << >> /\ (orderRejectedReturnBitfield16.value[1] \div 2) % 2 > 0), ReadBytes(frequentTraderId.rest, 1), frequentTraderId.rest) IN IF ~sessionEligibility.ok THEN Fail ELSE
    LET comboOrder == ReadWhen(numberOfReturnBitfields.value >= 16 /\ (orderRejectedReturnBitfield16.value # << >> /\ (orderRejectedReturnBitfield16.value[1] \div 4) % 2 > 0), ReadBytes(sessionEligibility.rest, 1), sessionEligibility.rest) IN IF ~comboOrder.ok THEN Fail ELSE
    LET compression == ReadWhen(numberOfReturnBitfields.value >= 16 /\ (orderRejectedReturnBitfield16.value # << >> /\ (orderRejectedReturnBitfield16.value[1] \div 8) % 2 > 0), ReadBytes(comboOrder.rest, 1), comboOrder.rest) IN IF ~compression.ok THEN Fail ELSE
    LET floorDestination == ReadWhen(numberOfReturnBitfields.value >= 16 /\ (orderRejectedReturnBitfield16.value # << >> /\ (orderRejectedReturnBitfield16.value[1] \div 16) % 2 > 0), ReadBytes(compression.rest, 4), compression.rest) IN IF ~floorDestination.ok THEN Fail ELSE
    LET floorRoutingInst == ReadWhen(numberOfReturnBitfields.value >= 16 /\ (orderRejectedReturnBitfield16.value # << >> /\ (orderRejectedReturnBitfield16.value[1] \div 32) % 2 > 0), ReadBytes(floorDestination.rest, 1), floorDestination.rest) IN IF ~floorRoutingInst.ok THEN Fail ELSE
    LET multiClassSprd == ReadWhen(numberOfReturnBitfields.value >= 16 /\ (orderRejectedReturnBitfield16.value # << >> /\ (orderRejectedReturnBitfield16.value[1] \div 64) % 2 > 0), ReadBytes(floorRoutingInst.rest, 1), floorRoutingInst.rest) IN IF ~multiClassSprd.ok THEN Fail ELSE
    LET orderOrigin == ReadWhen(numberOfReturnBitfields.value >= 16 /\ (orderRejectedReturnBitfield16.value # << >> /\ (orderRejectedReturnBitfield16.value[1] \div 128) % 2 > 0), ReadBytes(multiClassSprd.rest, 3), multiClassSprd.rest) IN IF ~orderOrigin.ok THEN Fail ELSE
    LET priceType == ReadWhen(numberOfReturnBitfields.value >= 17 /\ (orderRejectedReturnBitfield17.value # << >> /\ orderRejectedReturnBitfield17.value[1] % 2 > 0), ReadBytes(orderOrigin.rest, 1), orderOrigin.rest) IN IF ~priceType.ok THEN Fail ELSE
    LET strategyId == ReadWhen(numberOfReturnBitfields.value >= 17 /\ (orderRejectedReturnBitfield17.value # << >> /\ (orderRejectedReturnBitfield17.value[1] \div 2) % 2 > 0), ReadBytes(priceType.rest, 1), priceType.rest) IN IF ~strategyId.ok THEN Fail ELSE
    LET crossInitiator == ReadWhen(numberOfReturnBitfields.value >= 18 /\ (orderRejectedReturnBitfield18.value # << >> /\ (orderRejectedReturnBitfield18.value[1] \div 2) % 2 > 0), ReadBytes(strategyId.rest, 4), strategyId.rest) IN IF ~crossInitiator.ok THEN Fail ELSE
    LET subreason == ReadWhen(numberOfReturnBitfields.value >= 18 /\ (orderRejectedReturnBitfield18.value # << >> /\ (orderRejectedReturnBitfield18.value[1] \div 4) % 2 > 0), ReadBytes(crossInitiator.rest, 1), crossInitiator.rest) IN IF ~subreason.ok THEN Fail ELSE
    LET held == ReadWhen(numberOfReturnBitfields.value >= 18 /\ (orderRejectedReturnBitfield18.value # << >> /\ (orderRejectedReturnBitfield18.value[1] \div 32) % 2 > 0), ReadBytes(subreason.rest, 1), subreason.rest) IN IF ~held.ok THEN Fail ELSE
    LET crossOnBehalfOfId == ReadWhen(numberOfReturnBitfields.value >= 19 /\ (orderRejectedReturnBitfield19.value # << >> /\ (orderRejectedReturnBitfield19.value[1] \div 4) % 2 > 0), ReadBytes(held.rest, 4), held.rest) IN IF ~crossOnBehalfOfId.ok THEN Fail ELSE
    LET stopPxType == ReadWhen(numberOfReturnBitfields.value >= 19 /\ (orderRejectedReturnBitfield19.value # << >> /\ (orderRejectedReturnBitfield19.value[1] \div 64) % 2 > 0), ReadBytes(crossOnBehalfOfId.rest, 1), crossOnBehalfOfId.rest) IN IF ~stopPxType.ok THEN Fail ELSE
    Ok([ transactionTime               |-> transactionTime.value,
         clOrdId                       |-> clOrdId.value,
         orderRejectReason             |-> orderRejectReason.value,
         text                          |-> text.value,
         reserved1                     |-> reserved1.value,
         numberOfReturnBitfields       |-> numberOfReturnBitfields.value,
         orderRejectedReturnBitfield1  |-> orderRejectedReturnBitfield1.value,
         orderRejectedReturnBitfield2  |-> orderRejectedReturnBitfield2.value,
         orderRejectedReturnBitfield3  |-> orderRejectedReturnBitfield3.value,
         orderRejectedReturnBitfield4  |-> orderRejectedReturnBitfield4.value,
         orderRejectedReturnBitfield5  |-> orderRejectedReturnBitfield5.value,
         orderRejectedReturnBitfield6  |-> orderRejectedReturnBitfield6.value,
         orderRejectedReturnBitfield7  |-> orderRejectedReturnBitfield7.value,
         orderRejectedReturnBitfield8  |-> orderRejectedReturnBitfield8.value,
         orderRejectedReturnBitfield9  |-> orderRejectedReturnBitfield9.value,
         orderRejectedReturnBitfield10 |-> orderRejectedReturnBitfield10.value,
         orderRejectedReturnBitfield11 |-> orderRejectedReturnBitfield11.value,
         orderRejectedReturnBitfield12 |-> orderRejectedReturnBitfield12.value,
         orderRejectedReturnBitfield13 |-> orderRejectedReturnBitfield13.value,
         orderRejectedReturnBitfield14 |-> orderRejectedReturnBitfield14.value,
         orderRejectedReturnBitfield15 |-> orderRejectedReturnBitfield15.value,
         orderRejectedReturnBitfield16 |-> orderRejectedReturnBitfield16.value,
         orderRejectedReturnBitfield17 |-> orderRejectedReturnBitfield17.value,
         orderRejectedReturnBitfield18 |-> orderRejectedReturnBitfield18.value,
         orderRejectedReturnBitfield19 |-> orderRejectedReturnBitfield19.value,
         orderRejectedReturnBitfield20 |-> orderRejectedReturnBitfield20.value,
         orderRejectedReturnBitfield21 |-> orderRejectedReturnBitfield21.value,
         side                          |-> side.value,
         priceLong                     |-> priceLong.value,
         execInst                      |-> execInst.value,
         ordType                       |-> ordType.value,
         timeInForce                   |-> timeInForce.value,
         minQty                        |-> minQty.value,
         symbolLong                    |-> symbolLong.value,
         capacity                      |-> capacity.value,
         account                       |-> account.value,
         clearingFirm                  |-> clearingFirm.value,
         clearingAccount               |-> clearingAccount.value,
         displayIndicator              |-> displayIndicator.value,
         maxFloor                      |-> maxFloor.value,
         orderQtyLong                  |-> orderQtyLong.value,
         preventMatch                  |-> preventMatch.value,
         maturityDate                  |-> maturityDate.value,
         strikePrice                   |-> strikePrice.value,
         putOrCall                     |-> putOrCall.value,
         openClose                     |-> openClose.value,
         correctedSize                 |-> correctedSize.value,
         secondaryOrderId              |-> secondaryOrderId.value,
         contraCapacity                |-> contraCapacity.value,
         attributedQuote               |-> attributedQuote.value,
         echoText                      |-> echoText.value,
         stopPx                        |-> stopPx.value,
         routingInst                   |-> routingInst.value,
         routStrategy                  |-> routStrategy.value,
         routeDeliveryMethod           |-> routeDeliveryMethod.value,
         exDestination                 |-> exDestination.value,
         marketingFeeCode              |-> marketingFeeCode.value,
         targetPartyId                 |-> targetPartyId.value,
         auctionId                     |-> auctionId.value,
         cmtaNumber                    |-> cmtaNumber.value,
         crossId                       |-> crossId.value,
         allocQty                      |-> allocQty.value,
         giveUpFirmId                  |-> giveUpFirmId.value,
         routingFirmId                 |-> routingFirmId.value,
         crossExclusionIndicator       |-> crossExclusionIndicator.value,
         clearingOptionalData          |-> clearingOptionalData.value,
         equityPartyId                 |-> equityPartyId.value,
         clientIdAttr                  |-> clientIdAttr.value,
         frequentTraderId              |-> frequentTraderId.value,
         sessionEligibility            |-> sessionEligibility.value,
         comboOrder                    |-> comboOrder.value,
         compression                   |-> compression.value,
         floorDestination              |-> floorDestination.value,
         floorRoutingInst              |-> floorRoutingInst.value,
         multiClassSprd                |-> multiClassSprd.value,
         orderOrigin                   |-> orderOrigin.value,
         priceType                     |-> priceType.value,
         strategyId                    |-> strategyId.value,
         crossInitiator                |-> crossInitiator.value,
         subreason                     |-> subreason.value,
         held                          |-> held.value,
         crossOnBehalfOfId             |-> crossOnBehalfOfId.value,
         stopPxType                    |-> stopPxType.value ], stopPxType.rest)

(* Order Rejected Message with each field marked present by fields before it there exactly where they say *)
SettleOrderRejectedMessage(message) ==
    LET settled1 == [message EXCEPT !.orderRejectedReturnBitfield1 = IF message.numberOfReturnBitfields >= 1 THEN (IF message.orderRejectedReturnBitfield1 = << >> THEN <<0>> ELSE message.orderRejectedReturnBitfield1) ELSE << >>]
        settled2 == [settled1 EXCEPT !.orderRejectedReturnBitfield2 = IF settled1.numberOfReturnBitfields >= 2 THEN (IF settled1.orderRejectedReturnBitfield2 = << >> THEN <<0>> ELSE settled1.orderRejectedReturnBitfield2) ELSE << >>]
        settled3 == [settled2 EXCEPT !.orderRejectedReturnBitfield3 = IF settled2.numberOfReturnBitfields >= 3 THEN (IF settled2.orderRejectedReturnBitfield3 = << >> THEN <<0>> ELSE settled2.orderRejectedReturnBitfield3) ELSE << >>]
        settled4 == [settled3 EXCEPT !.orderRejectedReturnBitfield4 = IF settled3.numberOfReturnBitfields >= 4 THEN (IF settled3.orderRejectedReturnBitfield4 = << >> THEN <<0>> ELSE settled3.orderRejectedReturnBitfield4) ELSE << >>]
        settled5 == [settled4 EXCEPT !.orderRejectedReturnBitfield5 = IF settled4.numberOfReturnBitfields >= 5 THEN (IF settled4.orderRejectedReturnBitfield5 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled4.orderRejectedReturnBitfield5) ELSE << >>]
        settled6 == [settled5 EXCEPT !.orderRejectedReturnBitfield6 = IF settled5.numberOfReturnBitfields >= 6 THEN (IF settled5.orderRejectedReturnBitfield6 = << >> THEN <<0>> ELSE settled5.orderRejectedReturnBitfield6) ELSE << >>]
        settled7 == [settled6 EXCEPT !.orderRejectedReturnBitfield7 = IF settled6.numberOfReturnBitfields >= 7 THEN (IF settled6.orderRejectedReturnBitfield7 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled6.orderRejectedReturnBitfield7) ELSE << >>]
        settled8 == [settled7 EXCEPT !.orderRejectedReturnBitfield8 = IF settled7.numberOfReturnBitfields >= 8 THEN (IF settled7.orderRejectedReturnBitfield8 = << >> THEN <<0>> ELSE settled7.orderRejectedReturnBitfield8) ELSE << >>]
        settled9 == [settled8 EXCEPT !.orderRejectedReturnBitfield9 = IF settled8.numberOfReturnBitfields >= 9 THEN (IF settled8.orderRejectedReturnBitfield9 = << >> THEN <<0>> ELSE settled8.orderRejectedReturnBitfield9) ELSE << >>]
        settled10 == [settled9 EXCEPT !.orderRejectedReturnBitfield10 = IF settled9.numberOfReturnBitfields >= 10 THEN (IF settled9.orderRejectedReturnBitfield10 = << >> THEN <<0>> ELSE settled9.orderRejectedReturnBitfield10) ELSE << >>]
        settled11 == [settled10 EXCEPT !.orderRejectedReturnBitfield11 = IF settled10.numberOfReturnBitfields >= 11 THEN (IF settled10.orderRejectedReturnBitfield11 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled10.orderRejectedReturnBitfield11) ELSE << >>]
        settled12 == [settled11 EXCEPT !.orderRejectedReturnBitfield12 = IF settled11.numberOfReturnBitfields >= 12 THEN (IF settled11.orderRejectedReturnBitfield12 = << >> THEN <<0>> ELSE settled11.orderRejectedReturnBitfield12) ELSE << >>]
        settled13 == [settled12 EXCEPT !.orderRejectedReturnBitfield13 = IF settled12.numberOfReturnBitfields >= 13 THEN (IF settled12.orderRejectedReturnBitfield13 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled12.orderRejectedReturnBitfield13) ELSE << >>]
        settled14 == [settled13 EXCEPT !.orderRejectedReturnBitfield14 = IF settled13.numberOfReturnBitfields >= 14 THEN (IF settled13.orderRejectedReturnBitfield14 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled13.orderRejectedReturnBitfield14) ELSE << >>]
        settled15 == [settled14 EXCEPT !.orderRejectedReturnBitfield15 = IF settled14.numberOfReturnBitfields >= 15 THEN (IF settled14.orderRejectedReturnBitfield15 = << >> THEN <<0>> ELSE settled14.orderRejectedReturnBitfield15) ELSE << >>]
        settled16 == [settled15 EXCEPT !.orderRejectedReturnBitfield16 = IF settled15.numberOfReturnBitfields >= 16 THEN (IF settled15.orderRejectedReturnBitfield16 = << >> THEN <<0>> ELSE settled15.orderRejectedReturnBitfield16) ELSE << >>]
        settled17 == [settled16 EXCEPT !.orderRejectedReturnBitfield17 = IF settled16.numberOfReturnBitfields >= 17 THEN (IF settled16.orderRejectedReturnBitfield17 = << >> THEN <<0>> ELSE settled16.orderRejectedReturnBitfield17) ELSE << >>]
        settled18 == [settled17 EXCEPT !.orderRejectedReturnBitfield18 = IF settled17.numberOfReturnBitfields >= 18 THEN (IF settled17.orderRejectedReturnBitfield18 = << >> THEN <<0>> ELSE settled17.orderRejectedReturnBitfield18) ELSE << >>]
        settled19 == [settled18 EXCEPT !.orderRejectedReturnBitfield19 = IF settled18.numberOfReturnBitfields >= 19 THEN (IF settled18.orderRejectedReturnBitfield19 = << >> THEN <<0>> ELSE settled18.orderRejectedReturnBitfield19) ELSE << >>]
        settled20 == [settled19 EXCEPT !.orderRejectedReturnBitfield20 = IF settled19.numberOfReturnBitfields >= 20 THEN (IF settled19.orderRejectedReturnBitfield20 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled19.orderRejectedReturnBitfield20) ELSE << >>]
        settled21 == [settled20 EXCEPT !.orderRejectedReturnBitfield21 = IF settled20.numberOfReturnBitfields >= 21 THEN (IF settled20.orderRejectedReturnBitfield21 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled20.orderRejectedReturnBitfield21) ELSE << >>]
        settled22 == [settled21 EXCEPT !.side = IF settled21.numberOfReturnBitfields >= 1 /\ (settled21.orderRejectedReturnBitfield1 # << >> /\ settled21.orderRejectedReturnBitfield1[1] % 2 > 0) THEN (IF settled21.side = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled21.side) ELSE << >>]
        settled23 == [settled22 EXCEPT !.priceLong = IF settled22.numberOfReturnBitfields >= 1 /\ (settled22.orderRejectedReturnBitfield1 # << >> /\ (settled22.orderRejectedReturnBitfield1[1] \div 4) % 2 > 0) THEN (IF settled22.priceLong = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled22.priceLong) ELSE << >>]
        settled24 == [settled23 EXCEPT !.execInst = IF settled23.numberOfReturnBitfields >= 1 /\ (settled23.orderRejectedReturnBitfield1 # << >> /\ (settled23.orderRejectedReturnBitfield1[1] \div 8) % 2 > 0) THEN (IF settled23.execInst = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled23.execInst) ELSE << >>]
        settled25 == [settled24 EXCEPT !.ordType = IF settled24.numberOfReturnBitfields >= 1 /\ (settled24.orderRejectedReturnBitfield1 # << >> /\ (settled24.orderRejectedReturnBitfield1[1] \div 16) % 2 > 0) THEN (IF settled24.ordType = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled24.ordType) ELSE << >>]
        settled26 == [settled25 EXCEPT !.timeInForce = IF settled25.numberOfReturnBitfields >= 1 /\ (settled25.orderRejectedReturnBitfield1 # << >> /\ (settled25.orderRejectedReturnBitfield1[1] \div 32) % 2 > 0) THEN (IF settled25.timeInForce = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled25.timeInForce) ELSE << >>]
        settled27 == [settled26 EXCEPT !.minQty = IF settled26.numberOfReturnBitfields >= 1 /\ (settled26.orderRejectedReturnBitfield1 # << >> /\ (settled26.orderRejectedReturnBitfield1[1] \div 64) % 2 > 0) THEN (IF settled26.minQty = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled26.minQty) ELSE << >>]
        settled28 == [settled27 EXCEPT !.symbolLong = IF settled27.numberOfReturnBitfields >= 2 /\ (settled27.orderRejectedReturnBitfield2 # << >> /\ settled27.orderRejectedReturnBitfield2[1] % 2 > 0) THEN (IF settled27.symbolLong = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled27.symbolLong) ELSE << >>]
        settled29 == [settled28 EXCEPT !.capacity = IF settled28.numberOfReturnBitfields >= 2 /\ (settled28.orderRejectedReturnBitfield2 # << >> /\ (settled28.orderRejectedReturnBitfield2[1] \div 64) % 2 > 0) THEN (IF settled28.capacity = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled28.capacity) ELSE << >>]
        settled30 == [settled29 EXCEPT !.account = IF settled29.numberOfReturnBitfields >= 3 /\ (settled29.orderRejectedReturnBitfield3 # << >> /\ settled29.orderRejectedReturnBitfield3[1] % 2 > 0) THEN (IF settled29.account = << >> THEN <<[i \in 1 .. 16 |-> 0]>> ELSE settled29.account) ELSE << >>]
        settled31 == [settled30 EXCEPT !.clearingFirm = IF settled30.numberOfReturnBitfields >= 3 /\ (settled30.orderRejectedReturnBitfield3 # << >> /\ (settled30.orderRejectedReturnBitfield3[1] \div 2) % 2 > 0) THEN (IF settled30.clearingFirm = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled30.clearingFirm) ELSE << >>]
        settled32 == [settled31 EXCEPT !.clearingAccount = IF settled31.numberOfReturnBitfields >= 3 /\ (settled31.orderRejectedReturnBitfield3 # << >> /\ (settled31.orderRejectedReturnBitfield3[1] \div 4) % 2 > 0) THEN (IF settled31.clearingAccount = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled31.clearingAccount) ELSE << >>]
        settled33 == [settled32 EXCEPT !.displayIndicator = IF settled32.numberOfReturnBitfields >= 3 /\ (settled32.orderRejectedReturnBitfield3 # << >> /\ (settled32.orderRejectedReturnBitfield3[1] \div 8) % 2 > 0) THEN (IF settled32.displayIndicator = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled32.displayIndicator) ELSE << >>]
        settled34 == [settled33 EXCEPT !.maxFloor = IF settled33.numberOfReturnBitfields >= 3 /\ (settled33.orderRejectedReturnBitfield3 # << >> /\ (settled33.orderRejectedReturnBitfield3[1] \div 16) % 2 > 0) THEN (IF settled33.maxFloor = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled33.maxFloor) ELSE << >>]
        settled35 == [settled34 EXCEPT !.orderQtyLong = IF settled34.numberOfReturnBitfields >= 3 /\ (settled34.orderRejectedReturnBitfield3 # << >> /\ (settled34.orderRejectedReturnBitfield3[1] \div 64) % 2 > 0) THEN (IF settled34.orderQtyLong = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled34.orderQtyLong) ELSE << >>]
        settled36 == [settled35 EXCEPT !.preventMatch = IF settled35.numberOfReturnBitfields >= 3 /\ (settled35.orderRejectedReturnBitfield3 # << >> /\ (settled35.orderRejectedReturnBitfield3[1] \div 128) % 2 > 0) THEN (IF settled35.preventMatch = << >> THEN <<[i \in 1 .. 3 |-> 0]>> ELSE settled35.preventMatch) ELSE << >>]
        settled37 == [settled36 EXCEPT !.maturityDate = IF settled36.numberOfReturnBitfields >= 4 /\ (settled36.orderRejectedReturnBitfield4 # << >> /\ settled36.orderRejectedReturnBitfield4[1] % 2 > 0) THEN (IF settled36.maturityDate = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled36.maturityDate) ELSE << >>]
