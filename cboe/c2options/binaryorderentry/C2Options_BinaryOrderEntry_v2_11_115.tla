        settled24 == [settled23 EXCEPT !.timeInForce = IF settled23.numberOfReturnBitfields >= 1 /\ (settled23.cancelRejectedReturnBitfield1 # << >> /\ (settled23.cancelRejectedReturnBitfield1[1] \div 32) % 2 > 0) THEN (IF settled23.timeInForce = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled23.timeInForce) ELSE << >>]
        settled25 == [settled24 EXCEPT !.minQty = IF settled24.numberOfReturnBitfields >= 1 /\ (settled24.cancelRejectedReturnBitfield1 # << >> /\ (settled24.cancelRejectedReturnBitfield1[1] \div 64) % 2 > 0) THEN (IF settled24.minQty = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled24.minQty) ELSE << >>]
        settled26 == [settled25 EXCEPT !.symbolLong = IF settled25.numberOfReturnBitfields >= 2 /\ (settled25.cancelRejectedReturnBitfield2 # << >> /\ settled25.cancelRejectedReturnBitfield2[1] % 2 > 0) THEN (IF settled25.symbolLong = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled25.symbolLong) ELSE << >>]
        settled27 == [settled26 EXCEPT !.capacity = IF settled26.numberOfReturnBitfields >= 2 /\ (settled26.cancelRejectedReturnBitfield2 # << >> /\ (settled26.cancelRejectedReturnBitfield2[1] \div 64) % 2 > 0) THEN (IF settled26.capacity = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled26.capacity) ELSE << >>]
        settled28 == [settled27 EXCEPT !.maturityDate = IF settled27.numberOfReturnBitfields >= 4 /\ (settled27.cancelRejectedReturnBitfield4 # << >> /\ settled27.cancelRejectedReturnBitfield4[1] % 2 > 0) THEN (IF settled27.maturityDate = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled27.maturityDate) ELSE << >>]
        settled29 == [settled28 EXCEPT !.strikePrice = IF settled28.numberOfReturnBitfields >= 4 /\ (settled28.cancelRejectedReturnBitfield4 # << >> /\ (settled28.cancelRejectedReturnBitfield4[1] \div 2) % 2 > 0) THEN (IF settled28.strikePrice = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled28.strikePrice) ELSE << >>]
