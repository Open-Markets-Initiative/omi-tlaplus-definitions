        LET read == DecodeCrossOrderCancelledOrderAllocations(EncodeCrossOrderCancelledOrderAllocations(checked.message), checked.given[1], checked.given[2], checked.given[3], checked.given[4], checked.given[5], checked.given[6], checked.given[7])
        IN  /\ read.ok
            /\ read.value = checked.message
