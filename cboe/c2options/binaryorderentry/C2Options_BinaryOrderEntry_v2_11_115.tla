        \cup { SettleOrderAcknowledgmentMessage([ZeroOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 15, !.orderAcknowledgmentReturnBitfield15 = <<128>>, !.clientIdAttr = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderAcknowledgmentMessage([ZeroOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 16, !.orderAcknowledgmentReturnBitfield16 = <<1>>, !.frequentTraderId = one]) : one \in { <<held>> : held \in Sample(6) } }
        \cup { SettleOrderAcknowledgmentMessage([ZeroOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 16, !.orderAcknowledgmentReturnBitfield16 = <<2>>, !.sessionEligibility = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderAcknowledgmentMessage([ZeroOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 16, !.orderAcknowledgmentReturnBitfield16 = <<4>>, !.comboOrder = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderAcknowledgmentMessage([ZeroOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 16, !.orderAcknowledgmentReturnBitfield16 = <<8>>, !.compression = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderAcknowledgmentMessage([ZeroOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 16, !.orderAcknowledgmentReturnBitfield16 = <<16>>, !.floorDestination = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderAcknowledgmentMessage([ZeroOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 16, !.orderAcknowledgmentReturnBitfield16 = <<32>>, !.floorRoutingInst = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderAcknowledgmentMessage([ZeroOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 16, !.orderAcknowledgmentReturnBitfield16 = <<64>>, !.multiClassSprd = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderAcknowledgmentMessage([ZeroOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 16, !.orderAcknowledgmentReturnBitfield16 = <<128>>, !.orderOrigin = one]) : one \in { <<held>> : held \in Sample(3) } }
        \cup { SettleOrderAcknowledgmentMessage([ZeroOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 17, !.orderAcknowledgmentReturnBitfield17 = <<1>>, !.priceType = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderAcknowledgmentMessage([ZeroOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 17, !.orderAcknowledgmentReturnBitfield17 = <<2>>, !.strategyId = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderAcknowledgmentMessage([ZeroOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 18, !.orderAcknowledgmentReturnBitfield18 = <<2>>, !.crossInitiator = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderAcknowledgmentMessage([ZeroOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 18, !.orderAcknowledgmentReturnBitfield18 = <<32>>, !.held = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderAcknowledgmentMessage([ZeroOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 19, !.orderAcknowledgmentReturnBitfield19 = <<4>>, !.crossOnBehalfOfId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderAcknowledgmentMessage([ZeroOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 19, !.orderAcknowledgmentReturnBitfield19 = <<64>>, !.stopPxType = one]) : one \in { <<held>> : held \in Sample(1) } }

(***************************************************************************)
(* Cross Order Acknowledgment Order Allocations                            *)
(***************************************************************************)

CrossOrderAcknowledgmentOrderAllocations ==
    [ clOrdId         : Sample(20),
      orderId         : Sample(8),
      side            : { << >> } \cup { <<held>> : held \in Sample(1) },
      allocQty        : { << >> } \cup { <<held>> : held \in Sample(4) },
      capacity        : { << >> } \cup { <<held>> : held \in Sample(1) },
      openClose       : { << >> } \cup { <<held>> : held \in Sample(1) },
      giveUpFirmId    : { << >> } \cup { <<held>> : held \in Sample(4) },
      account         : { << >> } \cup { <<held>> : held \in Sample(16) },
      cmtaNumber      : { << >> } \cup { <<held>> : held \in Sample(4) },
      clearingAccount : { << >> } \cup { <<held>> : held \in Sample(4) } ]

EncodeCrossOrderAcknowledgmentOrderAllocations(message) ==
    message.clOrdId
        \o message.orderId
        \o (IF message.side = << >> THEN << >> ELSE message.side[1])
        \o (IF message.allocQty = << >> THEN << >> ELSE message.allocQty[1])
        \o (IF message.capacity = << >> THEN << >> ELSE message.capacity[1])
        \o (IF message.openClose = << >> THEN << >> ELSE message.openClose[1])
        \o (IF message.giveUpFirmId = << >> THEN << >> ELSE message.giveUpFirmId[1])
        \o (IF message.account = << >> THEN << >> ELSE message.account[1])
        \o (IF message.cmtaNumber = << >> THEN << >> ELSE message.cmtaNumber[1])
        \o (IF message.clearingAccount = << >> THEN << >> ELSE message.clearingAccount[1])

DecodeCrossOrderAcknowledgmentOrderAllocations(bytes, handedNumberOfReturnBitfields, handedCrossOrderAcknowledgmentReturnBitfield1, handedCrossOrderAcknowledgmentReturnBitfield2, handedCrossOrderAcknowledgmentReturnBitfield3, handedCrossOrderAcknowledgmentReturnBitfield4, handedCrossOrderAcknowledgmentReturnBitfield9, handedCrossOrderAcknowledgmentReturnBitfield10) ==
    LET clOrdId == ReadBytes(bytes, 20) IN IF ~clOrdId.ok THEN Fail ELSE
    LET orderId == ReadBytes(clOrdId.rest, 8) IN IF ~orderId.ok THEN Fail ELSE
    LET side == ReadWhen(handedNumberOfReturnBitfields >= 1 /\ (handedCrossOrderAcknowledgmentReturnBitfield1 # << >> /\ handedCrossOrderAcknowledgmentReturnBitfield1[1] % 2 > 0), ReadBytes(orderId.rest, 1), orderId.rest) IN IF ~side.ok THEN Fail ELSE
    LET allocQty == ReadWhen(handedNumberOfReturnBitfields >= 10 /\ (handedCrossOrderAcknowledgmentReturnBitfield10 # << >> /\ (handedCrossOrderAcknowledgmentReturnBitfield10[1] \div 2) % 2 > 0), ReadBytes(side.rest, 4), side.rest) IN IF ~allocQty.ok THEN Fail ELSE
    LET capacity == ReadWhen(handedNumberOfReturnBitfields >= 2 /\ (handedCrossOrderAcknowledgmentReturnBitfield2 # << >> /\ (handedCrossOrderAcknowledgmentReturnBitfield2[1] \div 64) % 2 > 0), ReadBytes(allocQty.rest, 1), allocQty.rest) IN IF ~capacity.ok THEN Fail ELSE
    LET openClose == ReadWhen(handedNumberOfReturnBitfields >= 4 /\ (handedCrossOrderAcknowledgmentReturnBitfield4 # << >> /\ (handedCrossOrderAcknowledgmentReturnBitfield4[1] \div 8) % 2 > 0), ReadBytes(capacity.rest, 1), capacity.rest) IN IF ~openClose.ok THEN Fail ELSE
    LET giveUpFirmId == ReadWhen(handedNumberOfReturnBitfields >= 10 /\ (handedCrossOrderAcknowledgmentReturnBitfield10 # << >> /\ (handedCrossOrderAcknowledgmentReturnBitfield10[1] \div 4) % 2 > 0), ReadBytes(openClose.rest, 4), openClose.rest) IN IF ~giveUpFirmId.ok THEN Fail ELSE
    LET account == ReadWhen(handedNumberOfReturnBitfields >= 3 /\ (handedCrossOrderAcknowledgmentReturnBitfield3 # << >> /\ handedCrossOrderAcknowledgmentReturnBitfield3[1] % 2 > 0), ReadBytes(giveUpFirmId.rest, 16), giveUpFirmId.rest) IN IF ~account.ok THEN Fail ELSE
    LET cmtaNumber == ReadWhen(handedNumberOfReturnBitfields >= 9 /\ (handedCrossOrderAcknowledgmentReturnBitfield9 # << >> /\ (handedCrossOrderAcknowledgmentReturnBitfield9[1] \div 32) % 2 > 0), ReadBytes(account.rest, 4), account.rest) IN IF ~cmtaNumber.ok THEN Fail ELSE
    LET clearingAccount == ReadWhen(handedNumberOfReturnBitfields >= 3 /\ (handedCrossOrderAcknowledgmentReturnBitfield3 # << >> /\ (handedCrossOrderAcknowledgmentReturnBitfield3[1] \div 4) % 2 > 0), ReadBytes(cmtaNumber.rest, 4), cmtaNumber.rest) IN IF ~clearingAccount.ok THEN Fail ELSE
    Ok([ clOrdId         |-> clOrdId.value,
         orderId         |-> orderId.value,
         side            |-> side.value,
         allocQty        |-> allocQty.value,
         capacity        |-> capacity.value,
         openClose       |-> openClose.value,
         giveUpFirmId    |-> giveUpFirmId.value,
         account         |-> account.value,
         cmtaNumber      |-> cmtaNumber.value,
         clearingAccount |-> clearingAccount.value ], clearingAccount.rest)

(* Cross Order Acknowledgment Order Allocations with each field marked present by fields before it there exactly where they say *)
SettleCrossOrderAcknowledgmentOrderAllocations(message, handedNumberOfReturnBitfields, handedCrossOrderAcknowledgmentReturnBitfield1, handedCrossOrderAcknowledgmentReturnBitfield2, handedCrossOrderAcknowledgmentReturnBitfield3, handedCrossOrderAcknowledgmentReturnBitfield4, handedCrossOrderAcknowledgmentReturnBitfield9, handedCrossOrderAcknowledgmentReturnBitfield10) ==
    LET settled1 == [message EXCEPT !.side = IF handedNumberOfReturnBitfields >= 1 /\ (handedCrossOrderAcknowledgmentReturnBitfield1 # << >> /\ handedCrossOrderAcknowledgmentReturnBitfield1[1] % 2 > 0) THEN (IF message.side = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE message.side) ELSE << >>]
        settled2 == [settled1 EXCEPT !.allocQty = IF handedNumberOfReturnBitfields >= 10 /\ (handedCrossOrderAcknowledgmentReturnBitfield10 # << >> /\ (handedCrossOrderAcknowledgmentReturnBitfield10[1] \div 2) % 2 > 0) THEN (IF settled1.allocQty = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled1.allocQty) ELSE << >>]
        settled3 == [settled2 EXCEPT !.capacity = IF handedNumberOfReturnBitfields >= 2 /\ (handedCrossOrderAcknowledgmentReturnBitfield2 # << >> /\ (handedCrossOrderAcknowledgmentReturnBitfield2[1] \div 64) % 2 > 0) THEN (IF settled2.capacity = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled2.capacity) ELSE << >>]
        settled4 == [settled3 EXCEPT !.openClose = IF handedNumberOfReturnBitfields >= 4 /\ (handedCrossOrderAcknowledgmentReturnBitfield4 # << >> /\ (handedCrossOrderAcknowledgmentReturnBitfield4[1] \div 8) % 2 > 0) THEN (IF settled3.openClose = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled3.openClose) ELSE << >>]
        settled5 == [settled4 EXCEPT !.giveUpFirmId = IF handedNumberOfReturnBitfields >= 10 /\ (handedCrossOrderAcknowledgmentReturnBitfield10 # << >> /\ (handedCrossOrderAcknowledgmentReturnBitfield10[1] \div 4) % 2 > 0) THEN (IF settled4.giveUpFirmId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled4.giveUpFirmId) ELSE << >>]
        settled6 == [settled5 EXCEPT !.account = IF handedNumberOfReturnBitfields >= 3 /\ (handedCrossOrderAcknowledgmentReturnBitfield3 # << >> /\ handedCrossOrderAcknowledgmentReturnBitfield3[1] % 2 > 0) THEN (IF settled5.account = << >> THEN <<[i \in 1 .. 16 |-> 0]>> ELSE settled5.account) ELSE << >>]
        settled7 == [settled6 EXCEPT !.cmtaNumber = IF handedNumberOfReturnBitfields >= 9 /\ (handedCrossOrderAcknowledgmentReturnBitfield9 # << >> /\ (handedCrossOrderAcknowledgmentReturnBitfield9[1] \div 32) % 2 > 0) THEN (IF settled6.cmtaNumber = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled6.cmtaNumber) ELSE << >>]
        settled8 == [settled7 EXCEPT !.clearingAccount = IF handedNumberOfReturnBitfields >= 3 /\ (handedCrossOrderAcknowledgmentReturnBitfield3 # << >> /\ (handedCrossOrderAcknowledgmentReturnBitfield3[1] \div 4) % 2 > 0) THEN (IF settled7.clearingAccount = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled7.clearingAccount) ELSE << >>]
    IN  settled8

ZeroCrossOrderAcknowledgmentOrderAllocations ==
    SettleCrossOrderAcknowledgmentOrderAllocations([ clOrdId         |-> [i \in 1 .. 20 |-> 0],
                                                     orderId         |-> [i \in 1 .. 8 |-> 0],
                                                     side            |-> << >>,
                                                     allocQty        |-> << >>,
                                                     capacity        |-> << >>,
                                                     openClose       |-> << >>,
                                                     giveUpFirmId    |-> << >>,
                                                     account         |-> << >>,
                                                     cmtaNumber      |-> << >>,
                                                     clearingAccount |-> << >> ], 0, << >>, << >>, << >>, << >>, << >>, << >>)

(* Cross Order Acknowledgment Order Allocations at zero, then each field in turn at the values it is checked at *)
CheckedCrossOrderAcknowledgmentOrderAllocations ==
    { [given |-> <<0, << >>, << >>, << >>, << >>, << >>, << >>>>, message |-> ZeroCrossOrderAcknowledgmentOrderAllocations] }
        \cup { [given |-> <<0, << >>, << >>, << >>, << >>, << >>, << >>>>, message |-> SettleCrossOrderAcknowledgmentOrderAllocations([ZeroCrossOrderAcknowledgmentOrderAllocations EXCEPT !.clOrdId = one], 0, << >>, << >>, << >>, << >>, << >>, << >>)] : one \in Sample(20) }
        \cup { [given |-> <<0, << >>, << >>, << >>, << >>, << >>, << >>>>, message |-> SettleCrossOrderAcknowledgmentOrderAllocations([ZeroCrossOrderAcknowledgmentOrderAllocations EXCEPT !.orderId = one], 0, << >>, << >>, << >>, << >>, << >>, << >>)] : one \in Sample(8) }
        \cup { [given |-> <<1, <<1>>, << >>, << >>, << >>, << >>, << >>>>, message |-> SettleCrossOrderAcknowledgmentOrderAllocations([ZeroCrossOrderAcknowledgmentOrderAllocations EXCEPT !.side = one], 1, <<1>>, << >>, << >>, << >>, << >>, << >>)] : one \in { <<held>> : held \in Sample(1) } }
        \cup { [given |-> <<10, << >>, << >>, << >>, << >>, << >>, <<2>>>>, message |-> SettleCrossOrderAcknowledgmentOrderAllocations([ZeroCrossOrderAcknowledgmentOrderAllocations EXCEPT !.allocQty = one], 10, << >>, << >>, << >>, << >>, << >>, <<2>>)] : one \in { <<held>> : held \in Sample(4) } }
        \cup { [given |-> <<2, << >>, <<64>>, << >>, << >>, << >>, << >>>>, message |-> SettleCrossOrderAcknowledgmentOrderAllocations([ZeroCrossOrderAcknowledgmentOrderAllocations EXCEPT !.capacity = one], 2, << >>, <<64>>, << >>, << >>, << >>, << >>)] : one \in { <<held>> : held \in Sample(1) } }
        \cup { [given |-> <<4, << >>, << >>, << >>, <<8>>, << >>, << >>>>, message |-> SettleCrossOrderAcknowledgmentOrderAllocations([ZeroCrossOrderAcknowledgmentOrderAllocations EXCEPT !.openClose = one], 4, << >>, << >>, << >>, <<8>>, << >>, << >>)] : one \in { <<held>> : held \in Sample(1) } }
        \cup { [given |-> <<10, << >>, << >>, << >>, << >>, << >>, <<4>>>>, message |-> SettleCrossOrderAcknowledgmentOrderAllocations([ZeroCrossOrderAcknowledgmentOrderAllocations EXCEPT !.giveUpFirmId = one], 10, << >>, << >>, << >>, << >>, << >>, <<4>>)] : one \in { <<held>> : held \in Sample(4) } }
        \cup { [given |-> <<3, << >>, << >>, <<1>>, << >>, << >>, << >>>>, message |-> SettleCrossOrderAcknowledgmentOrderAllocations([ZeroCrossOrderAcknowledgmentOrderAllocations EXCEPT !.account = one], 3, << >>, << >>, <<1>>, << >>, << >>, << >>)] : one \in { <<held>> : held \in Sample(16) } }
        \cup { [given |-> <<9, << >>, << >>, << >>, << >>, <<32>>, << >>>>, message |-> SettleCrossOrderAcknowledgmentOrderAllocations([ZeroCrossOrderAcknowledgmentOrderAllocations EXCEPT !.cmtaNumber = one], 9, << >>, << >>, << >>, << >>, <<32>>, << >>)] : one \in { <<held>> : held \in Sample(4) } }
        \cup { [given |-> <<3, << >>, << >>, <<4>>, << >>, << >>, << >>>>, message |-> SettleCrossOrderAcknowledgmentOrderAllocations([ZeroCrossOrderAcknowledgmentOrderAllocations EXCEPT !.clearingAccount = one], 3, << >>, << >>, <<4>>, << >>, << >>, << >>)] : one \in { <<held>> : held \in Sample(4) } }

(* A run of Cross Order Acknowledgment Order Allocations, written one after another *)
RECURSIVE EncodeCrossOrderAcknowledgmentOrderAllocationsList(_)
EncodeCrossOrderAcknowledgmentOrderAllocationsList(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeCrossOrderAcknowledgmentOrderAllocations(Head(messages)) \o EncodeCrossOrderAcknowledgmentOrderAllocationsList(Tail(messages))

(* As many Cross Order Acknowledgment Order Allocations as the field that counts them says *)
RECURSIVE ReadCrossOrderAcknowledgmentOrderAllocationsList(_, _, _, _, _, _, _, _, _)
ReadCrossOrderAcknowledgmentOrderAllocationsList(bytes, count, handedNumberOfReturnBitfields, handedCrossOrderAcknowledgmentReturnBitfield1, handedCrossOrderAcknowledgmentReturnBitfield2, handedCrossOrderAcknowledgmentReturnBitfield3, handedCrossOrderAcknowledgmentReturnBitfield4, handedCrossOrderAcknowledgmentReturnBitfield9, handedCrossOrderAcknowledgmentReturnBitfield10) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeCrossOrderAcknowledgmentOrderAllocations(bytes, handedNumberOfReturnBitfields, handedCrossOrderAcknowledgmentReturnBitfield1, handedCrossOrderAcknowledgmentReturnBitfield2, handedCrossOrderAcknowledgmentReturnBitfield3, handedCrossOrderAcknowledgmentReturnBitfield4, handedCrossOrderAcknowledgmentReturnBitfield9, handedCrossOrderAcknowledgmentReturnBitfield10)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadCrossOrderAcknowledgmentOrderAllocationsList(one.rest, count - 1, handedNumberOfReturnBitfields, handedCrossOrderAcknowledgmentReturnBitfield1, handedCrossOrderAcknowledgmentReturnBitfield2, handedCrossOrderAcknowledgmentReturnBitfield3, handedCrossOrderAcknowledgmentReturnBitfield4, handedCrossOrderAcknowledgmentReturnBitfield9, handedCrossOrderAcknowledgmentReturnBitfield10)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Cross Order Acknowledgment Order Allocations of each kind, for the lists that carry them *)
OneCrossOrderAcknowledgmentOrderAllocations == { ZeroCrossOrderAcknowledgmentOrderAllocations }

(***************************************************************************)
(* Cross Order Acknowledgment Message                                      *)
(***************************************************************************)

CrossOrderAcknowledgmentMessage ==
    [ transactionTime                          : Sample(8),
      crossId                                  : Sample(20),
      auctionId                                : Sample(8),
      reserved1                                : Sample(1),
      numberOfReturnBitf                       : Sample(1),
      numberOfReturnBitfields                  : 0 .. 255,
      crossOrderAcknowledgmentReturnBitfield1  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderAcknowledgmentReturnBitfield2  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderAcknowledgmentReturnBitfield3  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderAcknowledgmentReturnBitfield4  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderAcknowledgmentReturnBitfield5  : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderAcknowledgmentReturnBitfield6  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderAcknowledgmentReturnBitfield7  : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderAcknowledgmentReturnBitfield8  : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderAcknowledgmentReturnBitfield9  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderAcknowledgmentReturnBitfield10 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderAcknowledgmentReturnBitfield11 : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderAcknowledgmentReturnBitfield12 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderAcknowledgmentReturnBitfield13 : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderAcknowledgmentReturnBitfield14 : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderAcknowledgmentReturnBitfield15 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderAcknowledgmentReturnBitfield16 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderAcknowledgmentReturnBitfield17 : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderAcknowledgmentReturnBitfield18 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderAcknowledgmentReturnBitfield19 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderAcknowledgmentOrderAllocations : SampleLists(OneCrossOrderAcknowledgmentOrderAllocations),
      priceLong                                : { << >> } \cup { <<held>> : held \in Sample(8) },
      execInst                                 : { << >> } \cup { <<held>> : held \in Sample(1) },
      symbolLong                               : { << >> } \cup { <<held>> : held \in Sample(8) },
      orderQtyLong                             : { << >> } \cup { <<held>> : held \in Sample(4) },
      preventMatch                             : { << >> } \cup { <<held>> : held \in Sample(3) },
      maturityDate                             : { << >> } \cup { <<held>> : held \in Sample(4) },
      strikePrice                              : { << >> } \cup { <<held>> : held \in Sample(8) },
      putOrCall                                : { << >> } \cup { <<held>> : held \in Sample(1) },
      attributedQuote                          : { << >> } \cup { <<held>> : held \in Sample(1) },
      targetPartyId                            : { << >> } \cup { <<held>> : held \in Sample(4) },
      crossType                                : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossPrioritization                      : { << >> } \cup { <<held>> : held \in Sample(1) },
      routingFirmId                            : { << >> } \cup { <<held>> : held \in Sample(4) },
      clearingOptionalData                     : { << >> } \cup { <<held>> : held \in Sample(16) },
      equityPartyId                            : { << >> } \cup { <<held>> : held \in Sample(4) },
      clientIdAttr                             : { << >> } \cup { <<held>> : held \in Sample(4) },
      frequentTraderId                         : { << >> } \cup { <<held>> : held \in Sample(6) },
      compression                              : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossInitiator                           : { << >> } \cup { <<held>> : held \in Sample(4) },
      crossOnBehalfOfId                        : { << >> } \cup { <<held>> : held \in Sample(4) } ]

EncodeCrossOrderAcknowledgmentMessage(message) ==
    message.transactionTime
        \o message.crossId
        \o message.auctionId
        \o message.reserved1
        \o message.numberOfReturnBitf
        \o EncodeUIntBE(message.numberOfReturnBitfields, 1)
        \o (IF message.crossOrderAcknowledgmentReturnBitfield1 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderAcknowledgmentReturnBitfield1[1], 1))
        \o (IF message.crossOrderAcknowledgmentReturnBitfield2 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderAcknowledgmentReturnBitfield2[1], 1))
        \o (IF message.crossOrderAcknowledgmentReturnBitfield3 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderAcknowledgmentReturnBitfield3[1], 1))
        \o (IF message.crossOrderAcknowledgmentReturnBitfield4 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderAcknowledgmentReturnBitfield4[1], 1))
        \o (IF message.crossOrderAcknowledgmentReturnBitfield5 = << >> THEN << >> ELSE message.crossOrderAcknowledgmentReturnBitfield5[1])
        \o (IF message.crossOrderAcknowledgmentReturnBitfield6 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderAcknowledgmentReturnBitfield6[1], 1))
        \o (IF message.crossOrderAcknowledgmentReturnBitfield7 = << >> THEN << >> ELSE message.crossOrderAcknowledgmentReturnBitfield7[1])
        \o (IF message.crossOrderAcknowledgmentReturnBitfield8 = << >> THEN << >> ELSE message.crossOrderAcknowledgmentReturnBitfield8[1])
        \o (IF message.crossOrderAcknowledgmentReturnBitfield9 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderAcknowledgmentReturnBitfield9[1], 1))
        \o (IF message.crossOrderAcknowledgmentReturnBitfield10 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderAcknowledgmentReturnBitfield10[1], 1))
        \o (IF message.crossOrderAcknowledgmentReturnBitfield11 = << >> THEN << >> ELSE message.crossOrderAcknowledgmentReturnBitfield11[1])
        \o (IF message.crossOrderAcknowledgmentReturnBitfield12 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderAcknowledgmentReturnBitfield12[1], 1))
        \o (IF message.crossOrderAcknowledgmentReturnBitfield13 = << >> THEN << >> ELSE message.crossOrderAcknowledgmentReturnBitfield13[1])
        \o (IF message.crossOrderAcknowledgmentReturnBitfield14 = << >> THEN << >> ELSE message.crossOrderAcknowledgmentReturnBitfield14[1])
        \o (IF message.crossOrderAcknowledgmentReturnBitfield15 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderAcknowledgmentReturnBitfield15[1], 1))
        \o (IF message.crossOrderAcknowledgmentReturnBitfield16 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderAcknowledgmentReturnBitfield16[1], 1))
        \o (IF message.crossOrderAcknowledgmentReturnBitfield17 = << >> THEN << >> ELSE message.crossOrderAcknowledgmentReturnBitfield17[1])
        \o (IF message.crossOrderAcknowledgmentReturnBitfield18 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderAcknowledgmentReturnBitfield18[1], 1))
        \o (IF message.crossOrderAcknowledgmentReturnBitfield19 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderAcknowledgmentReturnBitfield19[1], 1))
        \o EncodeUIntLE(Len(message.crossOrderAcknowledgmentOrderAllocations), 2)
        \o EncodeCrossOrderAcknowledgmentOrderAllocationsList(message.crossOrderAcknowledgmentOrderAllocations)
        \o (IF message.priceLong = << >> THEN << >> ELSE message.priceLong[1])
        \o (IF message.execInst = << >> THEN << >> ELSE message.execInst[1])
        \o (IF message.symbolLong = << >> THEN << >> ELSE message.symbolLong[1])
        \o (IF message.orderQtyLong = << >> THEN << >> ELSE message.orderQtyLong[1])
        \o (IF message.preventMatch = << >> THEN << >> ELSE message.preventMatch[1])
        \o (IF message.maturityDate = << >> THEN << >> ELSE message.maturityDate[1])
        \o (IF message.strikePrice = << >> THEN << >> ELSE message.strikePrice[1])
        \o (IF message.putOrCall = << >> THEN << >> ELSE message.putOrCall[1])
        \o (IF message.attributedQuote = << >> THEN << >> ELSE message.attributedQuote[1])
        \o (IF message.targetPartyId = << >> THEN << >> ELSE message.targetPartyId[1])
        \o (IF message.crossType = << >> THEN << >> ELSE message.crossType[1])
        \o (IF message.crossPrioritization = << >> THEN << >> ELSE message.crossPrioritization[1])
        \o (IF message.routingFirmId = << >> THEN << >> ELSE message.routingFirmId[1])
        \o (IF message.clearingOptionalData = << >> THEN << >> ELSE message.clearingOptionalData[1])
        \o (IF message.equityPartyId = << >> THEN << >> ELSE message.equityPartyId[1])
        \o (IF message.clientIdAttr = << >> THEN << >> ELSE message.clientIdAttr[1])
        \o (IF message.frequentTraderId = << >> THEN << >> ELSE message.frequentTraderId[1])
        \o (IF message.compression = << >> THEN << >> ELSE message.compression[1])
        \o (IF message.crossInitiator = << >> THEN << >> ELSE message.crossInitiator[1])
        \o (IF message.crossOnBehalfOfId = << >> THEN << >> ELSE message.crossOnBehalfOfId[1])

DecodeCrossOrderAcknowledgmentMessage(bytes) ==
    LET transactionTime == ReadBytes(bytes, 8) IN IF ~transactionTime.ok THEN Fail ELSE
    LET crossId == ReadBytes(transactionTime.rest, 20) IN IF ~crossId.ok THEN Fail ELSE
    LET auctionId == ReadBytes(crossId.rest, 8) IN IF ~auctionId.ok THEN Fail ELSE
    LET reserved1 == ReadBytes(auctionId.rest, 1) IN IF ~reserved1.ok THEN Fail ELSE
    LET numberOfReturnBitf == ReadBytes(reserved1.rest, 1) IN IF ~numberOfReturnBitf.ok THEN Fail ELSE
    LET numberOfReturnBitfields == ReadUIntBE(numberOfReturnBitf.rest, 1) IN IF ~numberOfReturnBitfields.ok THEN Fail ELSE
    LET crossOrderAcknowledgmentReturnBitfield1 == ReadWhen(numberOfReturnBitfields.value >= 1, ReadUIntLE(numberOfReturnBitfields.rest, 1), numberOfReturnBitfields.rest) IN IF ~crossOrderAcknowledgmentReturnBitfield1.ok THEN Fail ELSE
    LET crossOrderAcknowledgmentReturnBitfield2 == ReadWhen(numberOfReturnBitfields.value >= 2, ReadUIntLE(crossOrderAcknowledgmentReturnBitfield1.rest, 1), crossOrderAcknowledgmentReturnBitfield1.rest) IN IF ~crossOrderAcknowledgmentReturnBitfield2.ok THEN Fail ELSE
    LET crossOrderAcknowledgmentReturnBitfield3 == ReadWhen(numberOfReturnBitfields.value >= 3, ReadUIntLE(crossOrderAcknowledgmentReturnBitfield2.rest, 1), crossOrderAcknowledgmentReturnBitfield2.rest) IN IF ~crossOrderAcknowledgmentReturnBitfield3.ok THEN Fail ELSE
    LET crossOrderAcknowledgmentReturnBitfield4 == ReadWhen(numberOfReturnBitfields.value >= 4, ReadUIntLE(crossOrderAcknowledgmentReturnBitfield3.rest, 1), crossOrderAcknowledgmentReturnBitfield3.rest) IN IF ~crossOrderAcknowledgmentReturnBitfield4.ok THEN Fail ELSE
    LET crossOrderAcknowledgmentReturnBitfield5 == ReadWhen(numberOfReturnBitfields.value >= 5, ReadBytes(crossOrderAcknowledgmentReturnBitfield4.rest, 1), crossOrderAcknowledgmentReturnBitfield4.rest) IN IF ~crossOrderAcknowledgmentReturnBitfield5.ok THEN Fail ELSE
    LET crossOrderAcknowledgmentReturnBitfield6 == ReadWhen(numberOfReturnBitfields.value >= 6, ReadUIntLE(crossOrderAcknowledgmentReturnBitfield5.rest, 1), crossOrderAcknowledgmentReturnBitfield5.rest) IN IF ~crossOrderAcknowledgmentReturnBitfield6.ok THEN Fail ELSE
    LET crossOrderAcknowledgmentReturnBitfield7 == ReadWhen(numberOfReturnBitfields.value >= 7, ReadBytes(crossOrderAcknowledgmentReturnBitfield6.rest, 1), crossOrderAcknowledgmentReturnBitfield6.rest) IN IF ~crossOrderAcknowledgmentReturnBitfield7.ok THEN Fail ELSE
    LET crossOrderAcknowledgmentReturnBitfield8 == ReadWhen(numberOfReturnBitfields.value >= 8, ReadBytes(crossOrderAcknowledgmentReturnBitfield7.rest, 1), crossOrderAcknowledgmentReturnBitfield7.rest) IN IF ~crossOrderAcknowledgmentReturnBitfield8.ok THEN Fail ELSE
    LET crossOrderAcknowledgmentReturnBitfield9 == ReadWhen(numberOfReturnBitfields.value >= 9, ReadUIntLE(crossOrderAcknowledgmentReturnBitfield8.rest, 1), crossOrderAcknowledgmentReturnBitfield8.rest) IN IF ~crossOrderAcknowledgmentReturnBitfield9.ok THEN Fail ELSE
    LET crossOrderAcknowledgmentReturnBitfield10 == ReadWhen(numberOfReturnBitfields.value >= 10, ReadUIntLE(crossOrderAcknowledgmentReturnBitfield9.rest, 1), crossOrderAcknowledgmentReturnBitfield9.rest) IN IF ~crossOrderAcknowledgmentReturnBitfield10.ok THEN Fail ELSE
    LET crossOrderAcknowledgmentReturnBitfield11 == ReadWhen(numberOfReturnBitfields.value >= 11, ReadBytes(crossOrderAcknowledgmentReturnBitfield10.rest, 1), crossOrderAcknowledgmentReturnBitfield10.rest) IN IF ~crossOrderAcknowledgmentReturnBitfield11.ok THEN Fail ELSE
    LET crossOrderAcknowledgmentReturnBitfield12 == ReadWhen(numberOfReturnBitfields.value >= 12, ReadUIntLE(crossOrderAcknowledgmentReturnBitfield11.rest, 1), crossOrderAcknowledgmentReturnBitfield11.rest) IN IF ~crossOrderAcknowledgmentReturnBitfield12.ok THEN Fail ELSE
    LET crossOrderAcknowledgmentReturnBitfield13 == ReadWhen(numberOfReturnBitfields.value >= 13, ReadBytes(crossOrderAcknowledgmentReturnBitfield12.rest, 1), crossOrderAcknowledgmentReturnBitfield12.rest) IN IF ~crossOrderAcknowledgmentReturnBitfield13.ok THEN Fail ELSE
    LET crossOrderAcknowledgmentReturnBitfield14 == ReadWhen(numberOfReturnBitfields.value >= 14, ReadBytes(crossOrderAcknowledgmentReturnBitfield13.rest, 1), crossOrderAcknowledgmentReturnBitfield13.rest) IN IF ~crossOrderAcknowledgmentReturnBitfield14.ok THEN Fail ELSE
    LET crossOrderAcknowledgmentReturnBitfield15 == ReadWhen(numberOfReturnBitfields.value >= 15, ReadUIntLE(crossOrderAcknowledgmentReturnBitfield14.rest, 1), crossOrderAcknowledgmentReturnBitfield14.rest) IN IF ~crossOrderAcknowledgmentReturnBitfield15.ok THEN Fail ELSE
    LET crossOrderAcknowledgmentReturnBitfield16 == ReadWhen(numberOfReturnBitfields.value >= 16, ReadUIntLE(crossOrderAcknowledgmentReturnBitfield15.rest, 1), crossOrderAcknowledgmentReturnBitfield15.rest) IN IF ~crossOrderAcknowledgmentReturnBitfield16.ok THEN Fail ELSE
    LET crossOrderAcknowledgmentReturnBitfield17 == ReadWhen(numberOfReturnBitfields.value >= 17, ReadBytes(crossOrderAcknowledgmentReturnBitfield16.rest, 1), crossOrderAcknowledgmentReturnBitfield16.rest) IN IF ~crossOrderAcknowledgmentReturnBitfield17.ok THEN Fail ELSE
    LET crossOrderAcknowledgmentReturnBitfield18 == ReadWhen(numberOfReturnBitfields.value >= 18, ReadUIntLE(crossOrderAcknowledgmentReturnBitfield17.rest, 1), crossOrderAcknowledgmentReturnBitfield17.rest) IN IF ~crossOrderAcknowledgmentReturnBitfield18.ok THEN Fail ELSE
    LET crossOrderAcknowledgmentReturnBitfield19 == ReadWhen(numberOfReturnBitfields.value >= 19, ReadUIntLE(crossOrderAcknowledgmentReturnBitfield18.rest, 1), crossOrderAcknowledgmentReturnBitfield18.rest) IN IF ~crossOrderAcknowledgmentReturnBitfield19.ok THEN Fail ELSE
    LET groupCnt == ReadUIntLE(crossOrderAcknowledgmentReturnBitfield19.rest, 2) IN IF ~groupCnt.ok THEN Fail ELSE
    LET crossOrderAcknowledgmentOrderAllocations == ReadCrossOrderAcknowledgmentOrderAllocationsList(groupCnt.rest, groupCnt.value, numberOfReturnBitfields.value, crossOrderAcknowledgmentReturnBitfield1.value, crossOrderAcknowledgmentReturnBitfield2.value, crossOrderAcknowledgmentReturnBitfield3.value, crossOrderAcknowledgmentReturnBitfield4.value, crossOrderAcknowledgmentReturnBitfield9.value, crossOrderAcknowledgmentReturnBitfield10.value) IN IF ~crossOrderAcknowledgmentOrderAllocations.ok THEN Fail ELSE
    LET priceLong == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (crossOrderAcknowledgmentReturnBitfield1.value # << >> /\ (crossOrderAcknowledgmentReturnBitfield1.value[1] \div 4) % 2 > 0), ReadBytes(crossOrderAcknowledgmentOrderAllocations.rest, 8), crossOrderAcknowledgmentOrderAllocations.rest) IN IF ~priceLong.ok THEN Fail ELSE
    LET execInst == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (crossOrderAcknowledgmentReturnBitfield1.value # << >> /\ (crossOrderAcknowledgmentReturnBitfield1.value[1] \div 8) % 2 > 0), ReadBytes(priceLong.rest, 1), priceLong.rest) IN IF ~execInst.ok THEN Fail ELSE
    LET symbolLong == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (crossOrderAcknowledgmentReturnBitfield2.value # << >> /\ crossOrderAcknowledgmentReturnBitfield2.value[1] % 2 > 0), ReadBytes(execInst.rest, 8), execInst.rest) IN IF ~symbolLong.ok THEN Fail ELSE
    LET orderQtyLong == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (crossOrderAcknowledgmentReturnBitfield3.value # << >> /\ (crossOrderAcknowledgmentReturnBitfield3.value[1] \div 64) % 2 > 0), ReadBytes(symbolLong.rest, 4), symbolLong.rest) IN IF ~orderQtyLong.ok THEN Fail ELSE
    LET preventMatch == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (crossOrderAcknowledgmentReturnBitfield3.value # << >> /\ (crossOrderAcknowledgmentReturnBitfield3.value[1] \div 128) % 2 > 0), ReadBytes(orderQtyLong.rest, 3), orderQtyLong.rest) IN IF ~preventMatch.ok THEN Fail ELSE
    LET maturityDate == ReadWhen(numberOfReturnBitfields.value >= 4 /\ (crossOrderAcknowledgmentReturnBitfield4.value # << >> /\ crossOrderAcknowledgmentReturnBitfield4.value[1] % 2 > 0), ReadBytes(preventMatch.rest, 4), preventMatch.rest) IN IF ~maturityDate.ok THEN Fail ELSE
    LET strikePrice == ReadWhen(numberOfReturnBitfields.value >= 4 /\ (crossOrderAcknowledgmentReturnBitfield4.value # << >> /\ (crossOrderAcknowledgmentReturnBitfield4.value[1] \div 2) % 2 > 0), ReadBytes(maturityDate.rest, 8), maturityDate.rest) IN IF ~strikePrice.ok THEN Fail ELSE
    LET putOrCall == ReadWhen(numberOfReturnBitfields.value >= 4 /\ (crossOrderAcknowledgmentReturnBitfield4.value # << >> /\ (crossOrderAcknowledgmentReturnBitfield4.value[1] \div 4) % 2 > 0), ReadBytes(strikePrice.rest, 1), strikePrice.rest) IN IF ~putOrCall.ok THEN Fail ELSE
    LET attributedQuote == ReadWhen(numberOfReturnBitfields.value >= 6 /\ (crossOrderAcknowledgmentReturnBitfield6.value # << >> /\ (crossOrderAcknowledgmentReturnBitfield6.value[1] \div 8) % 2 > 0), ReadBytes(putOrCall.rest, 1), putOrCall.rest) IN IF ~attributedQuote.ok THEN Fail ELSE
    LET targetPartyId == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (crossOrderAcknowledgmentReturnBitfield9.value # << >> /\ (crossOrderAcknowledgmentReturnBitfield9.value[1] \div 2) % 2 > 0), ReadBytes(attributedQuote.rest, 4), attributedQuote.rest) IN IF ~targetPartyId.ok THEN Fail ELSE
    LET crossType == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (crossOrderAcknowledgmentReturnBitfield9.value # << >> /\ (crossOrderAcknowledgmentReturnBitfield9.value[1] \div 64) % 2 > 0), ReadBytes(targetPartyId.rest, 1), targetPartyId.rest) IN IF ~crossType.ok THEN Fail ELSE
    LET crossPrioritization == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (crossOrderAcknowledgmentReturnBitfield9.value # << >> /\ (crossOrderAcknowledgmentReturnBitfield9.value[1] \div 128) % 2 > 0), ReadBytes(crossType.rest, 1), crossType.rest) IN IF ~crossPrioritization.ok THEN Fail ELSE
    LET routingFirmId == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (crossOrderAcknowledgmentReturnBitfield10.value # << >> /\ (crossOrderAcknowledgmentReturnBitfield10.value[1] \div 8) % 2 > 0), ReadBytes(crossPrioritization.rest, 4), crossPrioritization.rest) IN IF ~routingFirmId.ok THEN Fail ELSE
    LET clearingOptionalData == ReadWhen(numberOfReturnBitfields.value >= 12 /\ (crossOrderAcknowledgmentReturnBitfield12.value # << >> /\ (crossOrderAcknowledgmentReturnBitfield12.value[1] \div 128) % 2 > 0), ReadBytes(routingFirmId.rest, 16), routingFirmId.rest) IN IF ~clearingOptionalData.ok THEN Fail ELSE
    LET equityPartyId == ReadWhen(numberOfReturnBitfields.value >= 15 /\ (crossOrderAcknowledgmentReturnBitfield15.value # << >> /\ (crossOrderAcknowledgmentReturnBitfield15.value[1] \div 2) % 2 > 0), ReadBytes(clearingOptionalData.rest, 4), clearingOptionalData.rest) IN IF ~equityPartyId.ok THEN Fail ELSE
    LET clientIdAttr == ReadWhen(numberOfReturnBitfields.value >= 15 /\ (crossOrderAcknowledgmentReturnBitfield15.value # << >> /\ (crossOrderAcknowledgmentReturnBitfield15.value[1] \div 128) % 2 > 0), ReadBytes(equityPartyId.rest, 4), equityPartyId.rest) IN IF ~clientIdAttr.ok THEN Fail ELSE
    LET frequentTraderId == ReadWhen(numberOfReturnBitfields.value >= 16 /\ (crossOrderAcknowledgmentReturnBitfield16.value # << >> /\ crossOrderAcknowledgmentReturnBitfield16.value[1] % 2 > 0), ReadBytes(clientIdAttr.rest, 6), clientIdAttr.rest) IN IF ~frequentTraderId.ok THEN Fail ELSE
    LET compression == ReadWhen(numberOfReturnBitfields.value >= 16 /\ (crossOrderAcknowledgmentReturnBitfield16.value # << >> /\ (crossOrderAcknowledgmentReturnBitfield16.value[1] \div 8) % 2 > 0), ReadBytes(frequentTraderId.rest, 1), frequentTraderId.rest) IN IF ~compression.ok THEN Fail ELSE
    LET crossInitiator == ReadWhen(numberOfReturnBitfields.value >= 18 /\ (crossOrderAcknowledgmentReturnBitfield18.value # << >> /\ (crossOrderAcknowledgmentReturnBitfield18.value[1] \div 2) % 2 > 0), ReadBytes(compression.rest, 4), compression.rest) IN IF ~crossInitiator.ok THEN Fail ELSE
    LET crossOnBehalfOfId == ReadWhen(numberOfReturnBitfields.value >= 19 /\ (crossOrderAcknowledgmentReturnBitfield19.value # << >> /\ (crossOrderAcknowledgmentReturnBitfield19.value[1] \div 4) % 2 > 0), ReadBytes(crossInitiator.rest, 4), crossInitiator.rest) IN IF ~crossOnBehalfOfId.ok THEN Fail ELSE
    Ok([ transactionTime                          |-> transactionTime.value,
         crossId                                  |-> crossId.value,
         auctionId                                |-> auctionId.value,
         reserved1                                |-> reserved1.value,
         numberOfReturnBitf                       |-> numberOfReturnBitf.value,
         numberOfReturnBitfields                  |-> numberOfReturnBitfields.value,
         crossOrderAcknowledgmentReturnBitfield1  |-> crossOrderAcknowledgmentReturnBitfield1.value,
         crossOrderAcknowledgmentReturnBitfield2  |-> crossOrderAcknowledgmentReturnBitfield2.value,
         crossOrderAcknowledgmentReturnBitfield3  |-> crossOrderAcknowledgmentReturnBitfield3.value,
         crossOrderAcknowledgmentReturnBitfield4  |-> crossOrderAcknowledgmentReturnBitfield4.value,
         crossOrderAcknowledgmentReturnBitfield5  |-> crossOrderAcknowledgmentReturnBitfield5.value,
         crossOrderAcknowledgmentReturnBitfield6  |-> crossOrderAcknowledgmentReturnBitfield6.value,
         crossOrderAcknowledgmentReturnBitfield7  |-> crossOrderAcknowledgmentReturnBitfield7.value,
         crossOrderAcknowledgmentReturnBitfield8  |-> crossOrderAcknowledgmentReturnBitfield8.value,
         crossOrderAcknowledgmentReturnBitfield9  |-> crossOrderAcknowledgmentReturnBitfield9.value,
         crossOrderAcknowledgmentReturnBitfield10 |-> crossOrderAcknowledgmentReturnBitfield10.value,
         crossOrderAcknowledgmentReturnBitfield11 |-> crossOrderAcknowledgmentReturnBitfield11.value,
         crossOrderAcknowledgmentReturnBitfield12 |-> crossOrderAcknowledgmentReturnBitfield12.value,
         crossOrderAcknowledgmentReturnBitfield13 |-> crossOrderAcknowledgmentReturnBitfield13.value,
         crossOrderAcknowledgmentReturnBitfield14 |-> crossOrderAcknowledgmentReturnBitfield14.value,
         crossOrderAcknowledgmentReturnBitfield15 |-> crossOrderAcknowledgmentReturnBitfield15.value,
         crossOrderAcknowledgmentReturnBitfield16 |-> crossOrderAcknowledgmentReturnBitfield16.value,
         crossOrderAcknowledgmentReturnBitfield17 |-> crossOrderAcknowledgmentReturnBitfield17.value,
         crossOrderAcknowledgmentReturnBitfield18 |-> crossOrderAcknowledgmentReturnBitfield18.value,
         crossOrderAcknowledgmentReturnBitfield19 |-> crossOrderAcknowledgmentReturnBitfield19.value,
         crossOrderAcknowledgmentOrderAllocations |-> crossOrderAcknowledgmentOrderAllocations.value,
         priceLong                                |-> priceLong.value,
         execInst                                 |-> execInst.value,
         symbolLong                               |-> symbolLong.value,
         orderQtyLong                             |-> orderQtyLong.value,
         preventMatch                             |-> preventMatch.value,
         maturityDate                             |-> maturityDate.value,
         strikePrice                              |-> strikePrice.value,
         putOrCall                                |-> putOrCall.value,
         attributedQuote                          |-> attributedQuote.value,
         targetPartyId                            |-> targetPartyId.value,
         crossType                                |-> crossType.value,
         crossPrioritization                      |-> crossPrioritization.value,
         routingFirmId                            |-> routingFirmId.value,
         clearingOptionalData                     |-> clearingOptionalData.value,
         equityPartyId                            |-> equityPartyId.value,
         clientIdAttr                             |-> clientIdAttr.value,
         frequentTraderId                         |-> frequentTraderId.value,
         compression                              |-> compression.value,
         crossInitiator                           |-> crossInitiator.value,
         crossOnBehalfOfId                        |-> crossOnBehalfOfId.value ], crossOnBehalfOfId.rest)

(* Cross Order Acknowledgment Message with each field marked present by fields before it there exactly where they say *)
SettleCrossOrderAcknowledgmentMessage(message) ==
    LET settled1 == [message EXCEPT !.crossOrderAcknowledgmentReturnBitfield1 = IF message.numberOfReturnBitfields >= 1 THEN (IF message.crossOrderAcknowledgmentReturnBitfield1 = << >> THEN <<0>> ELSE message.crossOrderAcknowledgmentReturnBitfield1) ELSE << >>]
        settled2 == [settled1 EXCEPT !.crossOrderAcknowledgmentReturnBitfield2 = IF settled1.numberOfReturnBitfields >= 2 THEN (IF settled1.crossOrderAcknowledgmentReturnBitfield2 = << >> THEN <<0>> ELSE settled1.crossOrderAcknowledgmentReturnBitfield2) ELSE << >>]
        settled3 == [settled2 EXCEPT !.crossOrderAcknowledgmentReturnBitfield3 = IF settled2.numberOfReturnBitfields >= 3 THEN (IF settled2.crossOrderAcknowledgmentReturnBitfield3 = << >> THEN <<0>> ELSE settled2.crossOrderAcknowledgmentReturnBitfield3) ELSE << >>]
        settled4 == [settled3 EXCEPT !.crossOrderAcknowledgmentReturnBitfield4 = IF settled3.numberOfReturnBitfields >= 4 THEN (IF settled3.crossOrderAcknowledgmentReturnBitfield4 = << >> THEN <<0>> ELSE settled3.crossOrderAcknowledgmentReturnBitfield4) ELSE << >>]
        settled5 == [settled4 EXCEPT !.crossOrderAcknowledgmentReturnBitfield5 = IF settled4.numberOfReturnBitfields >= 5 THEN (IF settled4.crossOrderAcknowledgmentReturnBitfield5 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled4.crossOrderAcknowledgmentReturnBitfield5) ELSE << >>]
        settled6 == [settled5 EXCEPT !.crossOrderAcknowledgmentReturnBitfield6 = IF settled5.numberOfReturnBitfields >= 6 THEN (IF settled5.crossOrderAcknowledgmentReturnBitfield6 = << >> THEN <<0>> ELSE settled5.crossOrderAcknowledgmentReturnBitfield6) ELSE << >>]
        settled7 == [settled6 EXCEPT !.crossOrderAcknowledgmentReturnBitfield7 = IF settled6.numberOfReturnBitfields >= 7 THEN (IF settled6.crossOrderAcknowledgmentReturnBitfield7 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled6.crossOrderAcknowledgmentReturnBitfield7) ELSE << >>]
        settled8 == [settled7 EXCEPT !.crossOrderAcknowledgmentReturnBitfield8 = IF settled7.numberOfReturnBitfields >= 8 THEN (IF settled7.crossOrderAcknowledgmentReturnBitfield8 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled7.crossOrderAcknowledgmentReturnBitfield8) ELSE << >>]
        settled9 == [settled8 EXCEPT !.crossOrderAcknowledgmentReturnBitfield9 = IF settled8.numberOfReturnBitfields >= 9 THEN (IF settled8.crossOrderAcknowledgmentReturnBitfield9 = << >> THEN <<0>> ELSE settled8.crossOrderAcknowledgmentReturnBitfield9) ELSE << >>]
        settled10 == [settled9 EXCEPT !.crossOrderAcknowledgmentReturnBitfield10 = IF settled9.numberOfReturnBitfields >= 10 THEN (IF settled9.crossOrderAcknowledgmentReturnBitfield10 = << >> THEN <<0>> ELSE settled9.crossOrderAcknowledgmentReturnBitfield10) ELSE << >>]
        settled11 == [settled10 EXCEPT !.crossOrderAcknowledgmentReturnBitfield11 = IF settled10.numberOfReturnBitfields >= 11 THEN (IF settled10.crossOrderAcknowledgmentReturnBitfield11 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled10.crossOrderAcknowledgmentReturnBitfield11) ELSE << >>]
        settled12 == [settled11 EXCEPT !.crossOrderAcknowledgmentReturnBitfield12 = IF settled11.numberOfReturnBitfields >= 12 THEN (IF settled11.crossOrderAcknowledgmentReturnBitfield12 = << >> THEN <<0>> ELSE settled11.crossOrderAcknowledgmentReturnBitfield12) ELSE << >>]
        settled13 == [settled12 EXCEPT !.crossOrderAcknowledgmentReturnBitfield13 = IF settled12.numberOfReturnBitfields >= 13 THEN (IF settled12.crossOrderAcknowledgmentReturnBitfield13 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled12.crossOrderAcknowledgmentReturnBitfield13) ELSE << >>]
        settled14 == [settled13 EXCEPT !.crossOrderAcknowledgmentReturnBitfield14 = IF settled13.numberOfReturnBitfields >= 14 THEN (IF settled13.crossOrderAcknowledgmentReturnBitfield14 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled13.crossOrderAcknowledgmentReturnBitfield14) ELSE << >>]
        settled15 == [settled14 EXCEPT !.crossOrderAcknowledgmentReturnBitfield15 = IF settled14.numberOfReturnBitfields >= 15 THEN (IF settled14.crossOrderAcknowledgmentReturnBitfield15 = << >> THEN <<0>> ELSE settled14.crossOrderAcknowledgmentReturnBitfield15) ELSE << >>]
        settled16 == [settled15 EXCEPT !.crossOrderAcknowledgmentReturnBitfield16 = IF settled15.numberOfReturnBitfields >= 16 THEN (IF settled15.crossOrderAcknowledgmentReturnBitfield16 = << >> THEN <<0>> ELSE settled15.crossOrderAcknowledgmentReturnBitfield16) ELSE << >>]
        settled17 == [settled16 EXCEPT !.crossOrderAcknowledgmentReturnBitfield17 = IF settled16.numberOfReturnBitfields >= 17 THEN (IF settled16.crossOrderAcknowledgmentReturnBitfield17 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled16.crossOrderAcknowledgmentReturnBitfield17) ELSE << >>]
        settled18 == [settled17 EXCEPT !.crossOrderAcknowledgmentReturnBitfield18 = IF settled17.numberOfReturnBitfields >= 18 THEN (IF settled17.crossOrderAcknowledgmentReturnBitfield18 = << >> THEN <<0>> ELSE settled17.crossOrderAcknowledgmentReturnBitfield18) ELSE << >>]
        settled19 == [settled18 EXCEPT !.crossOrderAcknowledgmentReturnBitfield19 = IF settled18.numberOfReturnBitfields >= 19 THEN (IF settled18.crossOrderAcknowledgmentReturnBitfield19 = << >> THEN <<0>> ELSE settled18.crossOrderAcknowledgmentReturnBitfield19) ELSE << >>]
        settled20 == [settled19 EXCEPT !.crossOrderAcknowledgmentOrderAllocations = [i \in DOMAIN settled19.crossOrderAcknowledgmentOrderAllocations |-> SettleCrossOrderAcknowledgmentOrderAllocations(settled19.crossOrderAcknowledgmentOrderAllocations[i], settled19.numberOfReturnBitfields, settled19.crossOrderAcknowledgmentReturnBitfield1, settled19.crossOrderAcknowledgmentReturnBitfield2, settled19.crossOrderAcknowledgmentReturnBitfield3, settled19.crossOrderAcknowledgmentReturnBitfield4, settled19.crossOrderAcknowledgmentReturnBitfield9, settled19.crossOrderAcknowledgmentReturnBitfield10)]]
        settled21 == [settled20 EXCEPT !.priceLong = IF settled20.numberOfReturnBitfields >= 1 /\ (settled20.crossOrderAcknowledgmentReturnBitfield1 # << >> /\ (settled20.crossOrderAcknowledgmentReturnBitfield1[1] \div 4) % 2 > 0) THEN (IF settled20.priceLong = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled20.priceLong) ELSE << >>]
        settled22 == [settled21 EXCEPT !.execInst = IF settled21.numberOfReturnBitfields >= 1 /\ (settled21.crossOrderAcknowledgmentReturnBitfield1 # << >> /\ (settled21.crossOrderAcknowledgmentReturnBitfield1[1] \div 8) % 2 > 0) THEN (IF settled21.execInst = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled21.execInst) ELSE << >>]
        settled23 == [settled22 EXCEPT !.symbolLong = IF settled22.numberOfReturnBitfields >= 2 /\ (settled22.crossOrderAcknowledgmentReturnBitfield2 # << >> /\ settled22.crossOrderAcknowledgmentReturnBitfield2[1] % 2 > 0) THEN (IF settled22.symbolLong = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled22.symbolLong) ELSE << >>]
        settled24 == [settled23 EXCEPT !.orderQtyLong = IF settled23.numberOfReturnBitfields >= 3 /\ (settled23.crossOrderAcknowledgmentReturnBitfield3 # << >> /\ (settled23.crossOrderAcknowledgmentReturnBitfield3[1] \div 64) % 2 > 0) THEN (IF settled23.orderQtyLong = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled23.orderQtyLong) ELSE << >>]
        settled25 == [settled24 EXCEPT !.preventMatch = IF settled24.numberOfReturnBitfields >= 3 /\ (settled24.crossOrderAcknowledgmentReturnBitfield3 # << >> /\ (settled24.crossOrderAcknowledgmentReturnBitfield3[1] \div 128) % 2 > 0) THEN (IF settled24.preventMatch = << >> THEN <<[i \in 1 .. 3 |-> 0]>> ELSE settled24.preventMatch) ELSE << >>]
        settled26 == [settled25 EXCEPT !.maturityDate = IF settled25.numberOfReturnBitfields >= 4 /\ (settled25.crossOrderAcknowledgmentReturnBitfield4 # << >> /\ settled25.crossOrderAcknowledgmentReturnBitfield4[1] % 2 > 0) THEN (IF settled25.maturityDate = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled25.maturityDate) ELSE << >>]
        settled27 == [settled26 EXCEPT !.strikePrice = IF settled26.numberOfReturnBitfields >= 4 /\ (settled26.crossOrderAcknowledgmentReturnBitfield4 # << >> /\ (settled26.crossOrderAcknowledgmentReturnBitfield4[1] \div 2) % 2 > 0) THEN (IF settled26.strikePrice = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled26.strikePrice) ELSE << >>]
        settled28 == [settled27 EXCEPT !.putOrCall = IF settled27.numberOfReturnBitfields >= 4 /\ (settled27.crossOrderAcknowledgmentReturnBitfield4 # << >> /\ (settled27.crossOrderAcknowledgmentReturnBitfield4[1] \div 4) % 2 > 0) THEN (IF settled27.putOrCall = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled27.putOrCall) ELSE << >>]
        settled29 == [settled28 EXCEPT !.attributedQuote = IF settled28.numberOfReturnBitfields >= 6 /\ (settled28.crossOrderAcknowledgmentReturnBitfield6 # << >> /\ (settled28.crossOrderAcknowledgmentReturnBitfield6[1] \div 8) % 2 > 0) THEN (IF settled28.attributedQuote = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled28.attributedQuote) ELSE << >>]
        settled30 == [settled29 EXCEPT !.targetPartyId = IF settled29.numberOfReturnBitfields >= 9 /\ (settled29.crossOrderAcknowledgmentReturnBitfield9 # << >> /\ (settled29.crossOrderAcknowledgmentReturnBitfield9[1] \div 2) % 2 > 0) THEN (IF settled29.targetPartyId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled29.targetPartyId) ELSE << >>]
        settled31 == [settled30 EXCEPT !.crossType = IF settled30.numberOfReturnBitfields >= 9 /\ (settled30.crossOrderAcknowledgmentReturnBitfield9 # << >> /\ (settled30.crossOrderAcknowledgmentReturnBitfield9[1] \div 64) % 2 > 0) THEN (IF settled30.crossType = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled30.crossType) ELSE << >>]
        settled32 == [settled31 EXCEPT !.crossPrioritization = IF settled31.numberOfReturnBitfields >= 9 /\ (settled31.crossOrderAcknowledgmentReturnBitfield9 # << >> /\ (settled31.crossOrderAcknowledgmentReturnBitfield9[1] \div 128) % 2 > 0) THEN (IF settled31.crossPrioritization = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled31.crossPrioritization) ELSE << >>]
        settled33 == [settled32 EXCEPT !.routingFirmId = IF settled32.numberOfReturnBitfields >= 10 /\ (settled32.crossOrderAcknowledgmentReturnBitfield10 # << >> /\ (settled32.crossOrderAcknowledgmentReturnBitfield10[1] \div 8) % 2 > 0) THEN (IF settled32.routingFirmId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled32.routingFirmId) ELSE << >>]
        settled34 == [settled33 EXCEPT !.clearingOptionalData = IF settled33.numberOfReturnBitfields >= 12 /\ (settled33.crossOrderAcknowledgmentReturnBitfield12 # << >> /\ (settled33.crossOrderAcknowledgmentReturnBitfield12[1] \div 128) % 2 > 0) THEN (IF settled33.clearingOptionalData = << >> THEN <<[i \in 1 .. 16 |-> 0]>> ELSE settled33.clearingOptionalData) ELSE << >>]
        settled35 == [settled34 EXCEPT !.equityPartyId = IF settled34.numberOfReturnBitfields >= 15 /\ (settled34.crossOrderAcknowledgmentReturnBitfield15 # << >> /\ (settled34.crossOrderAcknowledgmentReturnBitfield15[1] \div 2) % 2 > 0) THEN (IF settled34.equityPartyId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled34.equityPartyId) ELSE << >>]
        settled36 == [settled35 EXCEPT !.clientIdAttr = IF settled35.numberOfReturnBitfields >= 15 /\ (settled35.crossOrderAcknowledgmentReturnBitfield15 # << >> /\ (settled35.crossOrderAcknowledgmentReturnBitfield15[1] \div 128) % 2 > 0) THEN (IF settled35.clientIdAttr = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled35.clientIdAttr) ELSE << >>]
        settled37 == [settled36 EXCEPT !.frequentTraderId = IF settled36.numberOfReturnBitfields >= 16 /\ (settled36.crossOrderAcknowledgmentReturnBitfield16 # << >> /\ settled36.crossOrderAcknowledgmentReturnBitfield16[1] % 2 > 0) THEN (IF settled36.frequentTraderId = << >> THEN <<[i \in 1 .. 6 |-> 0]>> ELSE settled36.frequentTraderId) ELSE << >>]
        settled38 == [settled37 EXCEPT !.compression = IF settled37.numberOfReturnBitfields >= 16 /\ (settled37.crossOrderAcknowledgmentReturnBitfield16 # << >> /\ (settled37.crossOrderAcknowledgmentReturnBitfield16[1] \div 8) % 2 > 0) THEN (IF settled37.compression = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled37.compression) ELSE << >>]
        settled39 == [settled38 EXCEPT !.crossInitiator = IF settled38.numberOfReturnBitfields >= 18 /\ (settled38.crossOrderAcknowledgmentReturnBitfield18 # << >> /\ (settled38.crossOrderAcknowledgmentReturnBitfield18[1] \div 2) % 2 > 0) THEN (IF settled38.crossInitiator = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled38.crossInitiator) ELSE << >>]
        settled40 == [settled39 EXCEPT !.crossOnBehalfOfId = IF settled39.numberOfReturnBitfields >= 19 /\ (settled39.crossOrderAcknowledgmentReturnBitfield19 # << >> /\ (settled39.crossOrderAcknowledgmentReturnBitfield19[1] \div 4) % 2 > 0) THEN (IF settled39.crossOnBehalfOfId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled39.crossOnBehalfOfId) ELSE << >>]
    IN  settled40

ZeroCrossOrderAcknowledgmentMessage ==
    SettleCrossOrderAcknowledgmentMessage([ transactionTime                          |-> [i \in 1 .. 8 |-> 0],
                                            crossId                                  |-> [i \in 1 .. 20 |-> 0],
                                            auctionId                                |-> [i \in 1 .. 8 |-> 0],
                                            reserved1                                |-> [i \in 1 .. 1 |-> 0],
                                            numberOfReturnBitf                       |-> [i \in 1 .. 1 |-> 0],
                                            numberOfReturnBitfields                  |-> 0,
                                            crossOrderAcknowledgmentReturnBitfield1  |-> << >>,
                                            crossOrderAcknowledgmentReturnBitfield2  |-> << >>,
                                            crossOrderAcknowledgmentReturnBitfield3  |-> << >>,
                                            crossOrderAcknowledgmentReturnBitfield4  |-> << >>,
                                            crossOrderAcknowledgmentReturnBitfield5  |-> << >>,
                                            crossOrderAcknowledgmentReturnBitfield6  |-> << >>,
                                            crossOrderAcknowledgmentReturnBitfield7  |-> << >>,
                                            crossOrderAcknowledgmentReturnBitfield8  |-> << >>,
                                            crossOrderAcknowledgmentReturnBitfield9  |-> << >>,
                                            crossOrderAcknowledgmentReturnBitfield10 |-> << >>,
                                            crossOrderAcknowledgmentReturnBitfield11 |-> << >>,
                                            crossOrderAcknowledgmentReturnBitfield12 |-> << >>,
                                            crossOrderAcknowledgmentReturnBitfield13 |-> << >>,
                                            crossOrderAcknowledgmentReturnBitfield14 |-> << >>,
                                            crossOrderAcknowledgmentReturnBitfield15 |-> << >>,
                                            crossOrderAcknowledgmentReturnBitfield16 |-> << >>,
                                            crossOrderAcknowledgmentReturnBitfield17 |-> << >>,
                                            crossOrderAcknowledgmentReturnBitfield18 |-> << >>,
                                            crossOrderAcknowledgmentReturnBitfield19 |-> << >>,
                                            crossOrderAcknowledgmentOrderAllocations |-> << >>,
                                            priceLong                                |-> << >>,
                                            execInst                                 |-> << >>,
                                            symbolLong                               |-> << >>,
                                            orderQtyLong                             |-> << >>,
                                            preventMatch                             |-> << >>,
                                            maturityDate                             |-> << >>,
                                            strikePrice                              |-> << >>,
                                            putOrCall                                |-> << >>,
                                            attributedQuote                          |-> << >>,
                                            targetPartyId                            |-> << >>,
                                            crossType                                |-> << >>,
                                            crossPrioritization                      |-> << >>,
                                            routingFirmId                            |-> << >>,
                                            clearingOptionalData                     |-> << >>,
                                            equityPartyId                            |-> << >>,
                                            clientIdAttr                             |-> << >>,
                                            frequentTraderId                         |-> << >>,
                                            compression                              |-> << >>,
                                            crossInitiator                           |-> << >>,
                                            crossOnBehalfOfId                        |-> << >> ])

(* Cross Order Acknowledgment Message at zero, then each field in turn at the values it is checked at *)
CheckedCrossOrderAcknowledgmentMessage ==
    { ZeroCrossOrderAcknowledgmentMessage }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.transactionTime = one]) : one \in Sample(8) }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.crossId = one]) : one \in Sample(20) }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.auctionId = one]) : one \in Sample(8) }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.reserved1 = one]) : one \in Sample(1) }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitf = one]) : one \in Sample(1) }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = one]) : one \in {0, 1, 255} }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 1, !.crossOrderAcknowledgmentReturnBitfield1 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 2, !.crossOrderAcknowledgmentReturnBitfield2 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 3, !.crossOrderAcknowledgmentReturnBitfield3 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 4, !.crossOrderAcknowledgmentReturnBitfield4 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 5, !.crossOrderAcknowledgmentReturnBitfield5 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 6, !.crossOrderAcknowledgmentReturnBitfield6 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 7, !.crossOrderAcknowledgmentReturnBitfield7 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 8, !.crossOrderAcknowledgmentReturnBitfield8 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 9, !.crossOrderAcknowledgmentReturnBitfield9 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 10, !.crossOrderAcknowledgmentReturnBitfield10 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 11, !.crossOrderAcknowledgmentReturnBitfield11 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 12, !.crossOrderAcknowledgmentReturnBitfield12 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 13, !.crossOrderAcknowledgmentReturnBitfield13 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 14, !.crossOrderAcknowledgmentReturnBitfield14 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 15, !.crossOrderAcknowledgmentReturnBitfield15 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 16, !.crossOrderAcknowledgmentReturnBitfield16 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 17, !.crossOrderAcknowledgmentReturnBitfield17 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 18, !.crossOrderAcknowledgmentReturnBitfield18 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 19, !.crossOrderAcknowledgmentReturnBitfield19 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.crossOrderAcknowledgmentOrderAllocations = one]) : one \in SampleLists(OneCrossOrderAcknowledgmentOrderAllocations) }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 1, !.crossOrderAcknowledgmentReturnBitfield1 = <<1>>, !.crossOrderAcknowledgmentOrderAllocations = one]) : one \in SampleLists(OneCrossOrderAcknowledgmentOrderAllocations) }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 10, !.crossOrderAcknowledgmentReturnBitfield10 = <<2>>, !.crossOrderAcknowledgmentOrderAllocations = one]) : one \in SampleLists(OneCrossOrderAcknowledgmentOrderAllocations) }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 2, !.crossOrderAcknowledgmentReturnBitfield2 = <<64>>, !.crossOrderAcknowledgmentOrderAllocations = one]) : one \in SampleLists(OneCrossOrderAcknowledgmentOrderAllocations) }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 4, !.crossOrderAcknowledgmentReturnBitfield4 = <<8>>, !.crossOrderAcknowledgmentOrderAllocations = one]) : one \in SampleLists(OneCrossOrderAcknowledgmentOrderAllocations) }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 10, !.crossOrderAcknowledgmentReturnBitfield10 = <<4>>, !.crossOrderAcknowledgmentOrderAllocations = one]) : one \in SampleLists(OneCrossOrderAcknowledgmentOrderAllocations) }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 3, !.crossOrderAcknowledgmentReturnBitfield3 = <<1>>, !.crossOrderAcknowledgmentOrderAllocations = one]) : one \in SampleLists(OneCrossOrderAcknowledgmentOrderAllocations) }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 9, !.crossOrderAcknowledgmentReturnBitfield9 = <<32>>, !.crossOrderAcknowledgmentOrderAllocations = one]) : one \in SampleLists(OneCrossOrderAcknowledgmentOrderAllocations) }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 3, !.crossOrderAcknowledgmentReturnBitfield3 = <<4>>, !.crossOrderAcknowledgmentOrderAllocations = one]) : one \in SampleLists(OneCrossOrderAcknowledgmentOrderAllocations) }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 1, !.crossOrderAcknowledgmentReturnBitfield1 = <<4>>, !.priceLong = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 1, !.crossOrderAcknowledgmentReturnBitfield1 = <<8>>, !.execInst = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 2, !.crossOrderAcknowledgmentReturnBitfield2 = <<1>>, !.symbolLong = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 3, !.crossOrderAcknowledgmentReturnBitfield3 = <<64>>, !.orderQtyLong = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 3, !.crossOrderAcknowledgmentReturnBitfield3 = <<128>>, !.preventMatch = one]) : one \in { <<held>> : held \in Sample(3) } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 4, !.crossOrderAcknowledgmentReturnBitfield4 = <<1>>, !.maturityDate = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 4, !.crossOrderAcknowledgmentReturnBitfield4 = <<2>>, !.strikePrice = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 4, !.crossOrderAcknowledgmentReturnBitfield4 = <<4>>, !.putOrCall = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 6, !.crossOrderAcknowledgmentReturnBitfield6 = <<8>>, !.attributedQuote = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 9, !.crossOrderAcknowledgmentReturnBitfield9 = <<2>>, !.targetPartyId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 9, !.crossOrderAcknowledgmentReturnBitfield9 = <<64>>, !.crossType = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 9, !.crossOrderAcknowledgmentReturnBitfield9 = <<128>>, !.crossPrioritization = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 10, !.crossOrderAcknowledgmentReturnBitfield10 = <<8>>, !.routingFirmId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 12, !.crossOrderAcknowledgmentReturnBitfield12 = <<128>>, !.clearingOptionalData = one]) : one \in { <<held>> : held \in Sample(16) } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 15, !.crossOrderAcknowledgmentReturnBitfield15 = <<2>>, !.equityPartyId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 15, !.crossOrderAcknowledgmentReturnBitfield15 = <<128>>, !.clientIdAttr = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 16, !.crossOrderAcknowledgmentReturnBitfield16 = <<1>>, !.frequentTraderId = one]) : one \in { <<held>> : held \in Sample(6) } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 16, !.crossOrderAcknowledgmentReturnBitfield16 = <<8>>, !.compression = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 18, !.crossOrderAcknowledgmentReturnBitfield18 = <<2>>, !.crossInitiator = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 19, !.crossOrderAcknowledgmentReturnBitfield19 = <<4>>, !.crossOnBehalfOfId = one]) : one \in { <<held>> : held \in Sample(4) } }

(***************************************************************************)
(* Quote Update Acknowledgment Quote: 16 bytes                             *)
(***************************************************************************)

QuoteUpdateAcknowledgmentQuote ==
    [ orderId               : Sample(8),
      quoteResult           : Sample(1),
      subLiquidityIndicator : Sample(1),
      subreason             : Sample(1),
      reserved5             : Sample(5) ]

EncodeQuoteUpdateAcknowledgmentQuote(message) ==
    message.orderId
        \o message.quoteResult
        \o message.subLiquidityIndicator
        \o message.subreason
        \o message.reserved5

DecodeQuoteUpdateAcknowledgmentQuote(bytes) ==
    LET orderId == ReadBytes(bytes, 8) IN IF ~orderId.ok THEN Fail ELSE
    LET quoteResult == ReadBytes(orderId.rest, 1) IN IF ~quoteResult.ok THEN Fail ELSE
    LET subLiquidityIndicator == ReadBytes(quoteResult.rest, 1) IN IF ~subLiquidityIndicator.ok THEN Fail ELSE
    LET subreason == ReadBytes(subLiquidityIndicator.rest, 1) IN IF ~subreason.ok THEN Fail ELSE
    LET reserved5 == ReadBytes(subreason.rest, 5) IN IF ~reserved5.ok THEN Fail ELSE
    Ok([ orderId               |-> orderId.value,
         quoteResult           |-> quoteResult.value,
         subLiquidityIndicator |-> subLiquidityIndicator.value,
         subreason             |-> subreason.value,
         reserved5             |-> reserved5.value ], reserved5.rest)

ZeroQuoteUpdateAcknowledgmentQuote ==
    [ orderId               |-> [i \in 1 .. 8 |-> 0],
      quoteResult           |-> [i \in 1 .. 1 |-> 0],
      subLiquidityIndicator |-> [i \in 1 .. 1 |-> 0],
      subreason             |-> [i \in 1 .. 1 |-> 0],
      reserved5             |-> [i \in 1 .. 5 |-> 0] ]

(* Quote Update Acknowledgment Quote at zero, then each field in turn at the values it is checked at *)
CheckedQuoteUpdateAcknowledgmentQuote ==
    { ZeroQuoteUpdateAcknowledgmentQuote }
        \cup { [ZeroQuoteUpdateAcknowledgmentQuote EXCEPT !.orderId = one] : one \in Sample(8) }
        \cup { [ZeroQuoteUpdateAcknowledgmentQuote EXCEPT !.quoteResult = one] : one \in Sample(1) }
        \cup { [ZeroQuoteUpdateAcknowledgmentQuote EXCEPT !.subLiquidityIndicator = one] : one \in Sample(1) }
        \cup { [ZeroQuoteUpdateAcknowledgmentQuote EXCEPT !.subreason = one] : one \in Sample(1) }
        \cup { [ZeroQuoteUpdateAcknowledgmentQuote EXCEPT !.reserved5 = one] : one \in Sample(5) }

(* A run of Quote Update Acknowledgment Quote, written one after another *)
RECURSIVE EncodeQuoteUpdateAcknowledgmentQuoteList(_)
EncodeQuoteUpdateAcknowledgmentQuoteList(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeQuoteUpdateAcknowledgmentQuote(Head(messages)) \o EncodeQuoteUpdateAcknowledgmentQuoteList(Tail(messages))

(* As many Quote Update Acknowledgment Quote as the field that counts them says *)
RECURSIVE ReadQuoteUpdateAcknowledgmentQuoteList(_, _)
ReadQuoteUpdateAcknowledgmentQuoteList(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeQuoteUpdateAcknowledgmentQuote(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadQuoteUpdateAcknowledgmentQuoteList(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Quote Update Acknowledgment Quote of each kind, for the lists that carry them *)
OneQuoteUpdateAcknowledgmentQuote == { ZeroQuoteUpdateAcknowledgmentQuote }

(***************************************************************************)
(* Quote Update Acknowledgment Message                                     *)
(***************************************************************************)

QuoteUpdateAcknowledgmentMessage ==
    [ transactionTime                : Sample(8),
      quoteUpdateId                  : Sample(16),
      quoteRejectReason              : Sample(1),
      reserved17                     : Sample(17),
      quoteUpdateAcknowledgmentQuote : SampleLists(OneQuoteUpdateAcknowledgmentQuote) ]

EncodeQuoteUpdateAcknowledgmentMessage(message) ==
    message.transactionTime
        \o message.quoteUpdateId
        \o message.quoteRejectReason
        \o message.reserved17
        \o EncodeUIntBE(Len(message.quoteUpdateAcknowledgmentQuote), 1)
        \o EncodeQuoteUpdateAcknowledgmentQuoteList(message.quoteUpdateAcknowledgmentQuote)

DecodeQuoteUpdateAcknowledgmentMessage(bytes) ==
    LET transactionTime == ReadBytes(bytes, 8) IN IF ~transactionTime.ok THEN Fail ELSE
    LET quoteUpdateId == ReadBytes(transactionTime.rest, 16) IN IF ~quoteUpdateId.ok THEN Fail ELSE
    LET quoteRejectReason == ReadBytes(quoteUpdateId.rest, 1) IN IF ~quoteRejectReason.ok THEN Fail ELSE
    LET reserved17 == ReadBytes(quoteRejectReason.rest, 17) IN IF ~reserved17.ok THEN Fail ELSE
    LET quoteCnt == ReadUIntBE(reserved17.rest, 1) IN IF ~quoteCnt.ok THEN Fail ELSE
    LET quoteUpdateAcknowledgmentQuote == ReadQuoteUpdateAcknowledgmentQuoteList(quoteCnt.rest, quoteCnt.value) IN IF ~quoteUpdateAcknowledgmentQuote.ok THEN Fail ELSE
    Ok([ transactionTime                |-> transactionTime.value,
         quoteUpdateId                  |-> quoteUpdateId.value,
         quoteRejectReason              |-> quoteRejectReason.value,
         reserved17                     |-> reserved17.value,
         quoteUpdateAcknowledgmentQuote |-> quoteUpdateAcknowledgmentQuote.value ], quoteUpdateAcknowledgmentQuote.rest)

ZeroQuoteUpdateAcknowledgmentMessage ==
    [ transactionTime                |-> [i \in 1 .. 8 |-> 0],
      quoteUpdateId                  |-> [i \in 1 .. 16 |-> 0],
      quoteRejectReason              |-> [i \in 1 .. 1 |-> 0],
      reserved17                     |-> [i \in 1 .. 17 |-> 0],
      quoteUpdateAcknowledgmentQuote |-> << >> ]

(* Quote Update Acknowledgment Message at zero, then each field in turn at the values it is checked at *)
CheckedQuoteUpdateAcknowledgmentMessage ==
    { ZeroQuoteUpdateAcknowledgmentMessage }
        \cup { [ZeroQuoteUpdateAcknowledgmentMessage EXCEPT !.transactionTime = one] : one \in Sample(8) }
        \cup { [ZeroQuoteUpdateAcknowledgmentMessage EXCEPT !.quoteUpdateId = one] : one \in Sample(16) }
        \cup { [ZeroQuoteUpdateAcknowledgmentMessage EXCEPT !.quoteRejectReason = one] : one \in Sample(1) }
        \cup { [ZeroQuoteUpdateAcknowledgmentMessage EXCEPT !.reserved17 = one] : one \in Sample(17) }
        \cup { [ZeroQuoteUpdateAcknowledgmentMessage EXCEPT !.quoteUpdateAcknowledgmentQuote = one] : one \in SampleLists(OneQuoteUpdateAcknowledgmentQuote) }

