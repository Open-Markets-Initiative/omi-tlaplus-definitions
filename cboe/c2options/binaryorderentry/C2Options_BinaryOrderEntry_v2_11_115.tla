        \o (IF message.floorRoutingInst = << >> THEN << >> ELSE message.floorRoutingInst[1])
        \o (IF message.multiClassSprd = << >> THEN << >> ELSE message.multiClassSprd[1])
        \o (IF message.orderOrigin = << >> THEN << >> ELSE message.orderOrigin[1])
        \o (IF message.priceType = << >> THEN << >> ELSE message.priceType[1])
        \o (IF message.strategyId = << >> THEN << >> ELSE message.strategyId[1])
        \o (IF message.crossInitiator = << >> THEN << >> ELSE message.crossInitiator[1])
        \o (IF message.held = << >> THEN << >> ELSE message.held[1])
        \o (IF message.crossOnBehalfOfId = << >> THEN << >> ELSE message.crossOnBehalfOfId[1])
        \o (IF message.stopPxType = << >> THEN << >> ELSE message.stopPxType[1])

DecodeOrderAcknowledgmentMessage(bytes) ==
    LET transactionTime == ReadBytes(bytes, 8) IN IF ~transactionTime.ok THEN Fail ELSE
    LET clOrdId == ReadBytes(transactionTime.rest, 20) IN IF ~clOrdId.ok THEN Fail ELSE
    LET orderId == ReadBytes(clOrdId.rest, 8) IN IF ~orderId.ok THEN Fail ELSE
    LET reserved1 == ReadBytes(orderId.rest, 1) IN IF ~reserved1.ok THEN Fail ELSE
    LET numberOfReturnBitf == ReadBytes(reserved1.rest, 1) IN IF ~numberOfReturnBitf.ok THEN Fail ELSE
    LET numberOfReturnBitfields == ReadUIntBE(numberOfReturnBitf.rest, 1) IN IF ~numberOfReturnBitfields.ok THEN Fail ELSE
    LET orderAcknowledgmentReturnBitfield1 == ReadWhen(numberOfReturnBitfields.value >= 1, ReadUIntLE(numberOfReturnBitfields.rest, 1), numberOfReturnBitfields.rest) IN IF ~orderAcknowledgmentReturnBitfield1.ok THEN Fail ELSE
    LET orderAcknowledgmentReturnBitfield2 == ReadWhen(numberOfReturnBitfields.value >= 2, ReadUIntLE(orderAcknowledgmentReturnBitfield1.rest, 1), orderAcknowledgmentReturnBitfield1.rest) IN IF ~orderAcknowledgmentReturnBitfield2.ok THEN Fail ELSE
    LET orderAcknowledgmentReturnBitfield3 == ReadWhen(numberOfReturnBitfields.value >= 3, ReadUIntLE(orderAcknowledgmentReturnBitfield2.rest, 1), orderAcknowledgmentReturnBitfield2.rest) IN IF ~orderAcknowledgmentReturnBitfield3.ok THEN Fail ELSE
    LET orderAcknowledgmentReturnBitfield4 == ReadWhen(numberOfReturnBitfields.value >= 4, ReadUIntLE(orderAcknowledgmentReturnBitfield3.rest, 1), orderAcknowledgmentReturnBitfield3.rest) IN IF ~orderAcknowledgmentReturnBitfield4.ok THEN Fail ELSE
    LET orderAcknowledgmentReturnBitfield5 == ReadWhen(numberOfReturnBitfields.value >= 5, ReadUIntLE(orderAcknowledgmentReturnBitfield4.rest, 1), orderAcknowledgmentReturnBitfield4.rest) IN IF ~orderAcknowledgmentReturnBitfield5.ok THEN Fail ELSE
    LET orderAcknowledgmentReturnBitfield6 == ReadWhen(numberOfReturnBitfields.value >= 6, ReadUIntLE(orderAcknowledgmentReturnBitfield5.rest, 1), orderAcknowledgmentReturnBitfield5.rest) IN IF ~orderAcknowledgmentReturnBitfield6.ok THEN Fail ELSE
    LET orderAcknowledgmentReturnBitfield7 == ReadWhen(numberOfReturnBitfields.value >= 7, ReadUIntLE(orderAcknowledgmentReturnBitfield6.rest, 1), orderAcknowledgmentReturnBitfield6.rest) IN IF ~orderAcknowledgmentReturnBitfield7.ok THEN Fail ELSE
    LET orderAcknowledgmentReturnBitfield8 == ReadWhen(numberOfReturnBitfields.value >= 8, ReadUIntLE(orderAcknowledgmentReturnBitfield7.rest, 1), orderAcknowledgmentReturnBitfield7.rest) IN IF ~orderAcknowledgmentReturnBitfield8.ok THEN Fail ELSE
    LET orderAcknowledgmentReturnBitfield9 == ReadWhen(numberOfReturnBitfields.value >= 9, ReadUIntLE(orderAcknowledgmentReturnBitfield8.rest, 1), orderAcknowledgmentReturnBitfield8.rest) IN IF ~orderAcknowledgmentReturnBitfield9.ok THEN Fail ELSE
    LET orderAcknowledgmentReturnBitfield10 == ReadWhen(numberOfReturnBitfields.value >= 10, ReadUIntLE(orderAcknowledgmentReturnBitfield9.rest, 1), orderAcknowledgmentReturnBitfield9.rest) IN IF ~orderAcknowledgmentReturnBitfield10.ok THEN Fail ELSE
    LET orderAcknowledgmentReturnBitfield11 == ReadWhen(numberOfReturnBitfields.value >= 11, ReadBytes(orderAcknowledgmentReturnBitfield10.rest, 1), orderAcknowledgmentReturnBitfield10.rest) IN IF ~orderAcknowledgmentReturnBitfield11.ok THEN Fail ELSE
    LET orderAcknowledgmentReturnBitfield12 == ReadWhen(numberOfReturnBitfields.value >= 12, ReadUIntLE(orderAcknowledgmentReturnBitfield11.rest, 1), orderAcknowledgmentReturnBitfield11.rest) IN IF ~orderAcknowledgmentReturnBitfield12.ok THEN Fail ELSE
    LET orderAcknowledgmentReturnBitfield13 == ReadWhen(numberOfReturnBitfields.value >= 13, ReadUIntLE(orderAcknowledgmentReturnBitfield12.rest, 1), orderAcknowledgmentReturnBitfield12.rest) IN IF ~orderAcknowledgmentReturnBitfield13.ok THEN Fail ELSE
    LET orderAcknowledgmentReturnBitfield14 == ReadWhen(numberOfReturnBitfields.value >= 14, ReadBytes(orderAcknowledgmentReturnBitfield13.rest, 1), orderAcknowledgmentReturnBitfield13.rest) IN IF ~orderAcknowledgmentReturnBitfield14.ok THEN Fail ELSE
    LET orderAcknowledgmentReturnBitfield15 == ReadWhen(numberOfReturnBitfields.value >= 15, ReadUIntLE(orderAcknowledgmentReturnBitfield14.rest, 1), orderAcknowledgmentReturnBitfield14.rest) IN IF ~orderAcknowledgmentReturnBitfield15.ok THEN Fail ELSE
    LET orderAcknowledgmentReturnBitfield16 == ReadWhen(numberOfReturnBitfields.value >= 16, ReadUIntLE(orderAcknowledgmentReturnBitfield15.rest, 1), orderAcknowledgmentReturnBitfield15.rest) IN IF ~orderAcknowledgmentReturnBitfield16.ok THEN Fail ELSE
    LET orderAcknowledgmentReturnBitfield17 == ReadWhen(numberOfReturnBitfields.value >= 17, ReadUIntLE(orderAcknowledgmentReturnBitfield16.rest, 1), orderAcknowledgmentReturnBitfield16.rest) IN IF ~orderAcknowledgmentReturnBitfield17.ok THEN Fail ELSE
    LET orderAcknowledgmentReturnBitfield18 == ReadWhen(numberOfReturnBitfields.value >= 18, ReadUIntLE(orderAcknowledgmentReturnBitfield17.rest, 1), orderAcknowledgmentReturnBitfield17.rest) IN IF ~orderAcknowledgmentReturnBitfield18.ok THEN Fail ELSE
    LET orderAcknowledgmentReturnBitfield19 == ReadWhen(numberOfReturnBitfields.value >= 19, ReadUIntLE(orderAcknowledgmentReturnBitfield18.rest, 1), orderAcknowledgmentReturnBitfield18.rest) IN IF ~orderAcknowledgmentReturnBitfield19.ok THEN Fail ELSE
    LET orderAcknowledgmentReturnBitfield20 == ReadWhen(numberOfReturnBitfields.value >= 20, ReadBytes(orderAcknowledgmentReturnBitfield19.rest, 1), orderAcknowledgmentReturnBitfield19.rest) IN IF ~orderAcknowledgmentReturnBitfield20.ok THEN Fail ELSE
    LET orderAcknowledgmentReturnBitfield21 == ReadWhen(numberOfReturnBitfields.value >= 21, ReadBytes(orderAcknowledgmentReturnBitfield20.rest, 1), orderAcknowledgmentReturnBitfield20.rest) IN IF ~orderAcknowledgmentReturnBitfield21.ok THEN Fail ELSE
    LET side == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderAcknowledgmentReturnBitfield1.value # << >> /\ orderAcknowledgmentReturnBitfield1.value[1] % 2 > 0), ReadBytes(orderAcknowledgmentReturnBitfield21.rest, 1), orderAcknowledgmentReturnBitfield21.rest) IN IF ~side.ok THEN Fail ELSE
    LET priceLong == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderAcknowledgmentReturnBitfield1.value # << >> /\ (orderAcknowledgmentReturnBitfield1.value[1] \div 4) % 2 > 0), ReadBytes(side.rest, 8), side.rest) IN IF ~priceLong.ok THEN Fail ELSE
    LET execInst == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderAcknowledgmentReturnBitfield1.value # << >> /\ (orderAcknowledgmentReturnBitfield1.value[1] \div 8) % 2 > 0), ReadBytes(priceLong.rest, 1), priceLong.rest) IN IF ~execInst.ok THEN Fail ELSE
    LET ordType == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderAcknowledgmentReturnBitfield1.value # << >> /\ (orderAcknowledgmentReturnBitfield1.value[1] \div 16) % 2 > 0), ReadBytes(execInst.rest, 1), execInst.rest) IN IF ~ordType.ok THEN Fail ELSE
    LET timeInForce == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderAcknowledgmentReturnBitfield1.value # << >> /\ (orderAcknowledgmentReturnBitfield1.value[1] \div 32) % 2 > 0), ReadBytes(ordType.rest, 1), ordType.rest) IN IF ~timeInForce.ok THEN Fail ELSE
    LET minQty == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderAcknowledgmentReturnBitfield1.value # << >> /\ (orderAcknowledgmentReturnBitfield1.value[1] \div 64) % 2 > 0), ReadBytes(timeInForce.rest, 4), timeInForce.rest) IN IF ~minQty.ok THEN Fail ELSE
    LET symbolLong == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (orderAcknowledgmentReturnBitfield2.value # << >> /\ orderAcknowledgmentReturnBitfield2.value[1] % 2 > 0), ReadBytes(minQty.rest, 8), minQty.rest) IN IF ~symbolLong.ok THEN Fail ELSE
    LET capacity == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (orderAcknowledgmentReturnBitfield2.value # << >> /\ (orderAcknowledgmentReturnBitfield2.value[1] \div 64) % 2 > 0), ReadBytes(symbolLong.rest, 1), symbolLong.rest) IN IF ~capacity.ok THEN Fail ELSE
    LET account == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderAcknowledgmentReturnBitfield3.value # << >> /\ orderAcknowledgmentReturnBitfield3.value[1] % 2 > 0), ReadBytes(capacity.rest, 16), capacity.rest) IN IF ~account.ok THEN Fail ELSE
    LET clearingFirm == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderAcknowledgmentReturnBitfield3.value # << >> /\ (orderAcknowledgmentReturnBitfield3.value[1] \div 2) % 2 > 0), ReadBytes(account.rest, 4), account.rest) IN IF ~clearingFirm.ok THEN Fail ELSE
    LET clearingAccount == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderAcknowledgmentReturnBitfield3.value # << >> /\ (orderAcknowledgmentReturnBitfield3.value[1] \div 4) % 2 > 0), ReadBytes(clearingFirm.rest, 4), clearingFirm.rest) IN IF ~clearingAccount.ok THEN Fail ELSE
    LET displayIndicator == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderAcknowledgmentReturnBitfield3.value # << >> /\ (orderAcknowledgmentReturnBitfield3.value[1] \div 8) % 2 > 0), ReadBytes(clearingAccount.rest, 1), clearingAccount.rest) IN IF ~displayIndicator.ok THEN Fail ELSE
    LET maxFloor == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderAcknowledgmentReturnBitfield3.value # << >> /\ (orderAcknowledgmentReturnBitfield3.value[1] \div 16) % 2 > 0), ReadBytes(displayIndicator.rest, 4), displayIndicator.rest) IN IF ~maxFloor.ok THEN Fail ELSE
    LET orderQtyLong == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderAcknowledgmentReturnBitfield3.value # << >> /\ (orderAcknowledgmentReturnBitfield3.value[1] \div 64) % 2 > 0), ReadBytes(maxFloor.rest, 4), maxFloor.rest) IN IF ~orderQtyLong.ok THEN Fail ELSE
    LET preventMatch == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderAcknowledgmentReturnBitfield3.value # << >> /\ (orderAcknowledgmentReturnBitfield3.value[1] \div 128) % 2 > 0), ReadBytes(orderQtyLong.rest, 3), orderQtyLong.rest) IN IF ~preventMatch.ok THEN Fail ELSE
    LET maturityDate == ReadWhen(numberOfReturnBitfields.value >= 4 /\ (orderAcknowledgmentReturnBitfield4.value # << >> /\ orderAcknowledgmentReturnBitfield4.value[1] % 2 > 0), ReadBytes(preventMatch.rest, 4), preventMatch.rest) IN IF ~maturityDate.ok THEN Fail ELSE
    LET strikePrice == ReadWhen(numberOfReturnBitfields.value >= 4 /\ (orderAcknowledgmentReturnBitfield4.value # << >> /\ (orderAcknowledgmentReturnBitfield4.value[1] \div 2) % 2 > 0), ReadBytes(maturityDate.rest, 8), maturityDate.rest) IN IF ~strikePrice.ok THEN Fail ELSE
    LET putOrCall == ReadWhen(numberOfReturnBitfields.value >= 4 /\ (orderAcknowledgmentReturnBitfield4.value # << >> /\ (orderAcknowledgmentReturnBitfield4.value[1] \div 4) % 2 > 0), ReadBytes(strikePrice.rest, 1), strikePrice.rest) IN IF ~putOrCall.ok THEN Fail ELSE
    LET openClose == ReadWhen(numberOfReturnBitfields.value >= 4 /\ (orderAcknowledgmentReturnBitfield4.value # << >> /\ (orderAcknowledgmentReturnBitfield4.value[1] \div 8) % 2 > 0), ReadBytes(putOrCall.rest, 1), putOrCall.rest) IN IF ~openClose.ok THEN Fail ELSE
    LET correctedSize == ReadWhen(numberOfReturnBitfields.value >= 4 /\ (orderAcknowledgmentReturnBitfield4.value # << >> /\ (orderAcknowledgmentReturnBitfield4.value[1] \div 32) % 2 > 0), ReadBytes(openClose.rest, 4), openClose.rest) IN IF ~correctedSize.ok THEN Fail ELSE
    LET origClOrdId == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderAcknowledgmentReturnBitfield5.value # << >> /\ orderAcknowledgmentReturnBitfield5.value[1] % 2 > 0), ReadBytes(correctedSize.rest, 20), correctedSize.rest) IN IF ~origClOrdId.ok THEN Fail ELSE
    LET leavesQty == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderAcknowledgmentReturnBitfield5.value # << >> /\ (orderAcknowledgmentReturnBitfield5.value[1] \div 2) % 2 > 0), ReadBytes(origClOrdId.rest, 4), origClOrdId.rest) IN IF ~leavesQty.ok THEN Fail ELSE
    LET lastShares == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderAcknowledgmentReturnBitfield5.value # << >> /\ (orderAcknowledgmentReturnBitfield5.value[1] \div 4) % 2 > 0), ReadBytes(leavesQty.rest, 4), leavesQty.rest) IN IF ~lastShares.ok THEN Fail ELSE
    LET lastPx == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderAcknowledgmentReturnBitfield5.value # << >> /\ (orderAcknowledgmentReturnBitfield5.value[1] \div 8) % 2 > 0), ReadBytes(lastShares.rest, 8), lastShares.rest) IN IF ~lastPx.ok THEN Fail ELSE
    LET displayPrice == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderAcknowledgmentReturnBitfield5.value # << >> /\ (orderAcknowledgmentReturnBitfield5.value[1] \div 16) % 2 > 0), ReadBytes(lastPx.rest, 8), lastPx.rest) IN IF ~displayPrice.ok THEN Fail ELSE
    LET workingPrice == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderAcknowledgmentReturnBitfield5.value # << >> /\ (orderAcknowledgmentReturnBitfield5.value[1] \div 32) % 2 > 0), ReadBytes(displayPrice.rest, 8), displayPrice.rest) IN IF ~workingPrice.ok THEN Fail ELSE
    LET baseLiquidityIndicator == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderAcknowledgmentReturnBitfield5.value # << >> /\ (orderAcknowledgmentReturnBitfield5.value[1] \div 64) % 2 > 0), ReadBytes(workingPrice.rest, 1), workingPrice.rest) IN IF ~baseLiquidityIndicator.ok THEN Fail ELSE
    LET expireTime == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderAcknowledgmentReturnBitfield5.value # << >> /\ (orderAcknowledgmentReturnBitfield5.value[1] \div 128) % 2 > 0), ReadBytes(baseLiquidityIndicator.rest, 8), baseLiquidityIndicator.rest) IN IF ~expireTime.ok THEN Fail ELSE
    LET secondaryOrderId == ReadWhen(numberOfReturnBitfields.value >= 6 /\ (orderAcknowledgmentReturnBitfield6.value # << >> /\ orderAcknowledgmentReturnBitfield6.value[1] % 2 > 0), ReadBytes(expireTime.rest, 8), expireTime.rest) IN IF ~secondaryOrderId.ok THEN Fail ELSE
    LET contraCapacity == ReadWhen(numberOfReturnBitfields.value >= 6 /\ (orderAcknowledgmentReturnBitfield6.value # << >> /\ (orderAcknowledgmentReturnBitfield6.value[1] \div 4) % 2 > 0), ReadBytes(secondaryOrderId.rest, 1), secondaryOrderId.rest) IN IF ~contraCapacity.ok THEN Fail ELSE
    LET attributedQuote == ReadWhen(numberOfReturnBitfields.value >= 6 /\ (orderAcknowledgmentReturnBitfield6.value # << >> /\ (orderAcknowledgmentReturnBitfield6.value[1] \div 8) % 2 > 0), ReadBytes(contraCapacity.rest, 1), contraCapacity.rest) IN IF ~attributedQuote.ok THEN Fail ELSE
    LET subLiquidityIndicator == ReadWhen(numberOfReturnBitfields.value >= 7 /\ (orderAcknowledgmentReturnBitfield7.value # << >> /\ orderAcknowledgmentReturnBitfield7.value[1] % 2 > 0), ReadBytes(attributedQuote.rest, 1), attributedQuote.rest) IN IF ~subLiquidityIndicator.ok THEN Fail ELSE
    LET echoText == ReadWhen(numberOfReturnBitfields.value >= 8 /\ (orderAcknowledgmentReturnBitfield8.value # << >> /\ (orderAcknowledgmentReturnBitfield8.value[1] \div 2) % 2 > 0), ReadBytes(subLiquidityIndicator.rest, 64), subLiquidityIndicator.rest) IN IF ~echoText.ok THEN Fail ELSE
    LET stopPx == ReadWhen(numberOfReturnBitfields.value >= 8 /\ (orderAcknowledgmentReturnBitfield8.value # << >> /\ (orderAcknowledgmentReturnBitfield8.value[1] \div 4) % 2 > 0), ReadBytes(echoText.rest, 8), echoText.rest) IN IF ~stopPx.ok THEN Fail ELSE
    LET routingInst == ReadWhen(numberOfReturnBitfields.value >= 8 /\ (orderAcknowledgmentReturnBitfield8.value # << >> /\ (orderAcknowledgmentReturnBitfield8.value[1] \div 8) % 2 > 0), ReadBytes(stopPx.rest, 4), stopPx.rest) IN IF ~routingInst.ok THEN Fail ELSE
    LET routStrategy == ReadWhen(numberOfReturnBitfields.value >= 8 /\ (orderAcknowledgmentReturnBitfield8.value # << >> /\ (orderAcknowledgmentReturnBitfield8.value[1] \div 16) % 2 > 0), ReadBytes(routingInst.rest, 6), routingInst.rest) IN IF ~routStrategy.ok THEN Fail ELSE
    LET routeDeliveryMethod == ReadWhen(numberOfReturnBitfields.value >= 8 /\ (orderAcknowledgmentReturnBitfield8.value # << >> /\ (orderAcknowledgmentReturnBitfield8.value[1] \div 32) % 2 > 0), ReadBytes(routStrategy.rest, 3), routStrategy.rest) IN IF ~routeDeliveryMethod.ok THEN Fail ELSE
    LET exDestination == ReadWhen(numberOfReturnBitfields.value >= 8 /\ (orderAcknowledgmentReturnBitfield8.value # << >> /\ (orderAcknowledgmentReturnBitfield8.value[1] \div 64) % 2 > 0), ReadBytes(routeDeliveryMethod.rest, 1), routeDeliveryMethod.rest) IN IF ~exDestination.ok THEN Fail ELSE
    LET marketingFeeCode == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (orderAcknowledgmentReturnBitfield9.value # << >> /\ orderAcknowledgmentReturnBitfield9.value[1] % 2 > 0), ReadBytes(exDestination.rest, 2), exDestination.rest) IN IF ~marketingFeeCode.ok THEN Fail ELSE
    LET targetPartyId == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (orderAcknowledgmentReturnBitfield9.value # << >> /\ (orderAcknowledgmentReturnBitfield9.value[1] \div 2) % 2 > 0), ReadBytes(marketingFeeCode.rest, 4), marketingFeeCode.rest) IN IF ~targetPartyId.ok THEN Fail ELSE
    LET auctionId == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (orderAcknowledgmentReturnBitfield9.value # << >> /\ (orderAcknowledgmentReturnBitfield9.value[1] \div 4) % 2 > 0), ReadBytes(targetPartyId.rest, 8), targetPartyId.rest) IN IF ~auctionId.ok THEN Fail ELSE
    LET cmtaNumber == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (orderAcknowledgmentReturnBitfield9.value # << >> /\ (orderAcknowledgmentReturnBitfield9.value[1] \div 32) % 2 > 0), ReadBytes(auctionId.rest, 4), auctionId.rest) IN IF ~cmtaNumber.ok THEN Fail ELSE
    LET crossId == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (orderAcknowledgmentReturnBitfield10.value # << >> /\ orderAcknowledgmentReturnBitfield10.value[1] % 2 > 0), ReadBytes(cmtaNumber.rest, 20), cmtaNumber.rest) IN IF ~crossId.ok THEN Fail ELSE
    LET allocQty == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (orderAcknowledgmentReturnBitfield10.value # << >> /\ (orderAcknowledgmentReturnBitfield10.value[1] \div 2) % 2 > 0), ReadBytes(crossId.rest, 4), crossId.rest) IN IF ~allocQty.ok THEN Fail ELSE
    LET giveUpFirmId == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (orderAcknowledgmentReturnBitfield10.value # << >> /\ (orderAcknowledgmentReturnBitfield10.value[1] \div 4) % 2 > 0), ReadBytes(allocQty.rest, 4), allocQty.rest) IN IF ~giveUpFirmId.ok THEN Fail ELSE
    LET routingFirmId == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (orderAcknowledgmentReturnBitfield10.value # << >> /\ (orderAcknowledgmentReturnBitfield10.value[1] \div 8) % 2 > 0), ReadBytes(giveUpFirmId.rest, 4), giveUpFirmId.rest) IN IF ~routingFirmId.ok THEN Fail ELSE
    LET crossExclusionIndicator == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (orderAcknowledgmentReturnBitfield10.value # << >> /\ (orderAcknowledgmentReturnBitfield10.value[1] \div 32) % 2 > 0), ReadBytes(routingFirmId.rest, 1), routingFirmId.rest) IN IF ~crossExclusionIndicator.ok THEN Fail ELSE
    LET clearingOptionalData == ReadWhen(numberOfReturnBitfields.value >= 12 /\ (orderAcknowledgmentReturnBitfield12.value # << >> /\ (orderAcknowledgmentReturnBitfield12.value[1] \div 128) % 2 > 0), ReadBytes(crossExclusionIndicator.rest, 16), crossExclusionIndicator.rest) IN IF ~clearingOptionalData.ok THEN Fail ELSE
    LET drillThruProtection == ReadWhen(numberOfReturnBitfields.value >= 13 /\ (orderAcknowledgmentReturnBitfield13.value # << >> /\ (orderAcknowledgmentReturnBitfield13.value[1] \div 64) % 2 > 0), ReadBytes(clearingOptionalData.rest, 8), clearingOptionalData.rest) IN IF ~drillThruProtection.ok THEN Fail ELSE
    LET equityPartyId == ReadWhen(numberOfReturnBitfields.value >= 15 /\ (orderAcknowledgmentReturnBitfield15.value # << >> /\ (orderAcknowledgmentReturnBitfield15.value[1] \div 2) % 2 > 0), ReadBytes(drillThruProtection.rest, 4), drillThruProtection.rest) IN IF ~equityPartyId.ok THEN Fail ELSE
    LET clientIdAttr == ReadWhen(numberOfReturnBitfields.value >= 15 /\ (orderAcknowledgmentReturnBitfield15.value # << >> /\ (orderAcknowledgmentReturnBitfield15.value[1] \div 128) % 2 > 0), ReadBytes(equityPartyId.rest, 4), equityPartyId.rest) IN IF ~clientIdAttr.ok THEN Fail ELSE
    LET frequentTraderId == ReadWhen(numberOfReturnBitfields.value >= 16 /\ (orderAcknowledgmentReturnBitfield16.value # << >> /\ orderAcknowledgmentReturnBitfield16.value[1] % 2 > 0), ReadBytes(clientIdAttr.rest, 6), clientIdAttr.rest) IN IF ~frequentTraderId.ok THEN Fail ELSE
    LET sessionEligibility == ReadWhen(numberOfReturnBitfields.value >= 16 /\ (orderAcknowledgmentReturnBitfield16.value # << >> /\ (orderAcknowledgmentReturnBitfield16.value[1] \div 2) % 2 > 0), ReadBytes(frequentTraderId.rest, 1), frequentTraderId.rest) IN IF ~sessionEligibility.ok THEN Fail ELSE
    LET comboOrder == ReadWhen(numberOfReturnBitfields.value >= 16 /\ (orderAcknowledgmentReturnBitfield16.value # << >> /\ (orderAcknowledgmentReturnBitfield16.value[1] \div 4) % 2 > 0), ReadBytes(sessionEligibility.rest, 1), sessionEligibility.rest) IN IF ~comboOrder.ok THEN Fail ELSE
    LET compression == ReadWhen(numberOfReturnBitfields.value >= 16 /\ (orderAcknowledgmentReturnBitfield16.value # << >> /\ (orderAcknowledgmentReturnBitfield16.value[1] \div 8) % 2 > 0), ReadBytes(comboOrder.rest, 1), comboOrder.rest) IN IF ~compression.ok THEN Fail ELSE
    LET floorDestination == ReadWhen(numberOfReturnBitfields.value >= 16 /\ (orderAcknowledgmentReturnBitfield16.value # << >> /\ (orderAcknowledgmentReturnBitfield16.value[1] \div 16) % 2 > 0), ReadBytes(compression.rest, 4), compression.rest) IN IF ~floorDestination.ok THEN Fail ELSE
    LET floorRoutingInst == ReadWhen(numberOfReturnBitfields.value >= 16 /\ (orderAcknowledgmentReturnBitfield16.value # << >> /\ (orderAcknowledgmentReturnBitfield16.value[1] \div 32) % 2 > 0), ReadBytes(floorDestination.rest, 1), floorDestination.rest) IN IF ~floorRoutingInst.ok THEN Fail ELSE
    LET multiClassSprd == ReadWhen(numberOfReturnBitfields.value >= 16 /\ (orderAcknowledgmentReturnBitfield16.value # << >> /\ (orderAcknowledgmentReturnBitfield16.value[1] \div 64) % 2 > 0), ReadBytes(floorRoutingInst.rest, 1), floorRoutingInst.rest) IN IF ~multiClassSprd.ok THEN Fail ELSE
    LET orderOrigin == ReadWhen(numberOfReturnBitfields.value >= 16 /\ (orderAcknowledgmentReturnBitfield16.value # << >> /\ (orderAcknowledgmentReturnBitfield16.value[1] \div 128) % 2 > 0), ReadBytes(multiClassSprd.rest, 3), multiClassSprd.rest) IN IF ~orderOrigin.ok THEN Fail ELSE
    LET priceType == ReadWhen(numberOfReturnBitfields.value >= 17 /\ (orderAcknowledgmentReturnBitfield17.value # << >> /\ orderAcknowledgmentReturnBitfield17.value[1] % 2 > 0), ReadBytes(orderOrigin.rest, 1), orderOrigin.rest) IN IF ~priceType.ok THEN Fail ELSE
    LET strategyId == ReadWhen(numberOfReturnBitfields.value >= 17 /\ (orderAcknowledgmentReturnBitfield17.value # << >> /\ (orderAcknowledgmentReturnBitfield17.value[1] \div 2) % 2 > 0), ReadBytes(priceType.rest, 1), priceType.rest) IN IF ~strategyId.ok THEN Fail ELSE
    LET crossInitiator == ReadWhen(numberOfReturnBitfields.value >= 18 /\ (orderAcknowledgmentReturnBitfield18.value # << >> /\ (orderAcknowledgmentReturnBitfield18.value[1] \div 2) % 2 > 0), ReadBytes(strategyId.rest, 4), strategyId.rest) IN IF ~crossInitiator.ok THEN Fail ELSE
    LET held == ReadWhen(numberOfReturnBitfields.value >= 18 /\ (orderAcknowledgmentReturnBitfield18.value # << >> /\ (orderAcknowledgmentReturnBitfield18.value[1] \div 32) % 2 > 0), ReadBytes(crossInitiator.rest, 1), crossInitiator.rest) IN IF ~held.ok THEN Fail ELSE
    LET crossOnBehalfOfId == ReadWhen(numberOfReturnBitfields.value >= 19 /\ (orderAcknowledgmentReturnBitfield19.value # << >> /\ (orderAcknowledgmentReturnBitfield19.value[1] \div 4) % 2 > 0), ReadBytes(held.rest, 4), held.rest) IN IF ~crossOnBehalfOfId.ok THEN Fail ELSE
    LET stopPxType == ReadWhen(numberOfReturnBitfields.value >= 19 /\ (orderAcknowledgmentReturnBitfield19.value # << >> /\ (orderAcknowledgmentReturnBitfield19.value[1] \div 64) % 2 > 0), ReadBytes(crossOnBehalfOfId.rest, 1), crossOnBehalfOfId.rest) IN IF ~stopPxType.ok THEN Fail ELSE
    Ok([ transactionTime                     |-> transactionTime.value,
         clOrdId                             |-> clOrdId.value,
         orderId                             |-> orderId.value,
         reserved1                           |-> reserved1.value,
         numberOfReturnBitf                  |-> numberOfReturnBitf.value,
         numberOfReturnBitfields             |-> numberOfReturnBitfields.value,
         orderAcknowledgmentReturnBitfield1  |-> orderAcknowledgmentReturnBitfield1.value,
         orderAcknowledgmentReturnBitfield2  |-> orderAcknowledgmentReturnBitfield2.value,
         orderAcknowledgmentReturnBitfield3  |-> orderAcknowledgmentReturnBitfield3.value,
         orderAcknowledgmentReturnBitfield4  |-> orderAcknowledgmentReturnBitfield4.value,
         orderAcknowledgmentReturnBitfield5  |-> orderAcknowledgmentReturnBitfield5.value,
         orderAcknowledgmentReturnBitfield6  |-> orderAcknowledgmentReturnBitfield6.value,
         orderAcknowledgmentReturnBitfield7  |-> orderAcknowledgmentReturnBitfield7.value,
         orderAcknowledgmentReturnBitfield8  |-> orderAcknowledgmentReturnBitfield8.value,
         orderAcknowledgmentReturnBitfield9  |-> orderAcknowledgmentReturnBitfield9.value,
         orderAcknowledgmentReturnBitfield10 |-> orderAcknowledgmentReturnBitfield10.value,
         orderAcknowledgmentReturnBitfield11 |-> orderAcknowledgmentReturnBitfield11.value,
         orderAcknowledgmentReturnBitfield12 |-> orderAcknowledgmentReturnBitfield12.value,
         orderAcknowledgmentReturnBitfield13 |-> orderAcknowledgmentReturnBitfield13.value,
         orderAcknowledgmentReturnBitfield14 |-> orderAcknowledgmentReturnBitfield14.value,
         orderAcknowledgmentReturnBitfield15 |-> orderAcknowledgmentReturnBitfield15.value,
         orderAcknowledgmentReturnBitfield16 |-> orderAcknowledgmentReturnBitfield16.value,
         orderAcknowledgmentReturnBitfield17 |-> orderAcknowledgmentReturnBitfield17.value,
         orderAcknowledgmentReturnBitfield18 |-> orderAcknowledgmentReturnBitfield18.value,
         orderAcknowledgmentReturnBitfield19 |-> orderAcknowledgmentReturnBitfield19.value,
         orderAcknowledgmentReturnBitfield20 |-> orderAcknowledgmentReturnBitfield20.value,
         orderAcknowledgmentReturnBitfield21 |-> orderAcknowledgmentReturnBitfield21.value,
         side                                |-> side.value,
         priceLong                           |-> priceLong.value,
         execInst                            |-> execInst.value,
         ordType                             |-> ordType.value,
         timeInForce                         |-> timeInForce.value,
         minQty                              |-> minQty.value,
         symbolLong                          |-> symbolLong.value,
         capacity                            |-> capacity.value,
         account                             |-> account.value,
         clearingFirm                        |-> clearingFirm.value,
         clearingAccount                     |-> clearingAccount.value,
         displayIndicator                    |-> displayIndicator.value,
         maxFloor                            |-> maxFloor.value,
         orderQtyLong                        |-> orderQtyLong.value,
