--------------- MODULE C2Options_BinaryOrderEntry_v2_11_115 ----------------
(***************************************************************************)
(* Chicago Board Options Exchange Binary Order Entry v2.11.115             *)
(*                                                                         *)
(* Generated from the binary model. A field is the bytes it occupies; an   *)
(* integer is read only where a rule depends on one - a length, a count, a *)
(* message type - which are the dependencies the parse rules run on.       *)
(*                                                                         *)
(* TLC checks that every record decodes back to what was encoded, that a   *)
(* dispatch selects the message its type names, and that a derived length  *)
(* or count is written from what it describes.                             *)
(*                                                                         *)
(* Note: TLC evaluates integers in 32 bits, so a field wider than that has *)
(* no range it can enumerate; every field is checked as its bytes, which   *)
(* is exact at any width.                                                  *)
(*                                                                         *)
(* License: MIT No Attribution                                             *)
(*                                                                         *)
(* Note: Login Request Message fills what is left of the frame Message     *)
(* Length states, which is what it is read from.                           *)
(*                                                                         *)
(* Note: Login Response Message fills what is left of the frame Message    *)
(* Length states, which is what it is read from.                           *)
(*                                                                         *)
(* Note: Logout Message fills what is left of the frame Message Length     *)
(* states, which is what it is read from.                                  *)
(*                                                                         *)
(* Note: A field marked present by fields read before it is read only when *)
(* they say it is there, and the records checked hold it exactly where     *)
(* they do: one holding it anywhere else is no message the protocol sends. *)
(*                                                                         *)
(* Note: New Order Message fills what is left of the frame Message Length  *)
(* states, which is what it is read from.                                  *)
(*                                                                         *)
(* Note: New Order Cross Message fills what is left of the frame Message   *)
(* Length states, which is what it is read from.                           *)
(*                                                                         *)
(* Note: New Complex Order Message fills what is left of the frame Message *)
(* Length states, which is what it is read from.                           *)
(*                                                                         *)
(* Note: New Order Cross Multileg Message fills what is left of the frame  *)
(* Message Length states, which is what it is read from.                   *)
(*                                                                         *)
(* Note: Cancel Order Message fills what is left of the frame Message      *)
(* Length states, which is what it is read from.                           *)
(*                                                                         *)
(* Note: Modify Order Message fills what is left of the frame Message      *)
(* Length states, which is what it is read from.                           *)
(*                                                                         *)
(* Note: Quote Update Message fills what is left of the frame Message      *)
(* Length states, which is what it is read from.                           *)
(*                                                                         *)
(* Note: Quote Update Short Message fills what is left of the frame        *)
(* Message Length states, which is what it is read from.                   *)
(*                                                                         *)
(* Note: Complex Quote Update Message fills what is left of the frame      *)
(* Message Length states, which is what it is read from.                   *)
(*                                                                         *)
(* Note: Complex Quote Update Short Message fills what is left of the      *)
(* frame Message Length states, which is what it is read from.             *)
(*                                                                         *)
(* Note: Purge Orders Message fills what is left of the frame Message      *)
(* Length states, which is what it is read from.                           *)
(*                                                                         *)
(* Note: Reset Risk Message fills what is left of the frame Message Length *)
(* states, which is what it is read from.                                  *)
(*                                                                         *)
(* Note: New Complex Instrument Message fills what is left of the frame    *)
(* Message Length states, which is what it is read from.                   *)
(*                                                                         *)
(* Note: Add Floor Trade Message fills what is left of the frame Message   *)
(* Length states, which is what it is read from.                           *)
(*                                                                         *)
(* Note: Floor Trade Confirmation Message fills what is left of the frame  *)
(* Message Length states, which is what it is read from.                   *)
(*                                                                         *)
(* Note: Delete Floor Trade Message fills what is left of the frame        *)
(* Message Length states, which is what it is read from.                   *)
(*                                                                         *)
(* Note: Order Acknowledgment Message fills what is left of the frame      *)
(* Message Length states, which is what it is read from.                   *)
(*                                                                         *)
(* Note: Cross Order Acknowledgment Message fills what is left of the      *)
(* frame Message Length states, which is what it is read from.             *)
(*                                                                         *)
(* Note: Quote Update Acknowledgment Message fills what is left of the     *)
(* frame Message Length states, which is what it is read from.             *)
(*                                                                         *)
(* Note: Order Rejected Message fills what is left of the frame Message    *)
(* Length states, which is what it is read from.                           *)
(*                                                                         *)
(* Note: Cross Order Rejected Message fills what is left of the frame      *)
(* Message Length states, which is what it is read from.                   *)
(*                                                                         *)
(* Note: Quote Update Rejected Message fills what is left of the frame     *)
(* Message Length states, which is what it is read from.                   *)
(*                                                                         *)
(* Note: Order Modified Message fills what is left of the frame Message    *)
(* Length states, which is what it is read from.                           *)
(*                                                                         *)
(* Note: Order Restated Message fills what is left of the frame Message    *)
(* Length states, which is what it is read from.                           *)
(*                                                                         *)
(* Note: Quote Restated Message fills what is left of the frame Message    *)
(* Length states, which is what it is read from.                           *)
(*                                                                         *)
(* Note: User Modify Rejected Message fills what is left of the frame      *)
(* Message Length states, which is what it is read from.                   *)
(*                                                                         *)
(* Note: Order Cancelled Message fills what is left of the frame Message   *)
(* Length states, which is what it is read from.                           *)
(*                                                                         *)
(* Note: Quote Cancelled Message fills what is left of the frame Message   *)
(* Length states, which is what it is read from.                           *)
(*                                                                         *)
(* Note: Cross Order Cancelled Message fills what is left of the frame     *)
(* Message Length states, which is what it is read from.                   *)
(*                                                                         *)
(* Note: Cancel Rejected Message fills what is left of the frame Message   *)
(* Length states, which is what it is read from.                           *)
(*                                                                         *)
(* Note: Order Execution Message fills what is left of the frame Message   *)
(* Length states, which is what it is read from.                           *)
(*                                                                         *)
(* Note: Quote Execution Message fills what is left of the frame Message   *)
(* Length states, which is what it is read from.                           *)
(*                                                                         *)
(* Note: Complex Quote Execution Message fills what is left of the frame   *)
(* Message Length states, which is what it is read from.                   *)
(*                                                                         *)
(* Note: Trade Cancel Or Correct Message fills what is left of the frame   *)
(* Message Length states, which is what it is read from.                   *)
(*                                                                         *)
(* Note: Purge Rejected Message fills what is left of the frame Message    *)
(* Length states, which is what it is read from.                           *)
(*                                                                         *)
(* Note: Reset Risk Acknowledgment Message fills what is left of the frame *)
(* Message Length states, which is what it is read from.                   *)
(*                                                                         *)
(* Note: Mass Cancel Acknowledgment Message fills what is left of the      *)
(* frame Message Length states, which is what it is read from.             *)
(*                                                                         *)
(* Note: Purge Notification Message fills what is left of the frame        *)
(* Message Length states, which is what it is read from.                   *)
(*                                                                         *)
(* Note: Complex Instrument Accepted Message fills what is left of the     *)
(* frame Message Length states, which is what it is read from.             *)
(*                                                                         *)
(* Note: Complex Instrument Rejected Message fills what is left of the     *)
(* frame Message Length states, which is what it is read from.             *)
(*                                                                         *)
(* Note: Floor Trade Notification Message fills what is left of the frame  *)
(* Message Length states, which is what it is read from.                   *)
(*                                                                         *)
(* Note: Add Floor Trade Rejected Message fills what is left of the frame  *)
(* Message Length states, which is what it is read from.                   *)
(*                                                                         *)
(* Note: Floor Trade Confirmation Rejected Message fills what is left of   *)
(* the frame Message Length states, which is what it is read from.         *)
(*                                                                         *)
(* Note: Delete Floor Trade Rejected Message fills what is left of the     *)
(* frame Message Length states, which is what it is read from.             *)
(*                                                                         *)
(* Note: Delete Floor Trade Acknowledgement Message fills what is left of  *)
(* the frame Message Length states, which is what it is read from.         *)
(***************************************************************************)
EXTENDS Integers, Sequences

(***************************************************************************)
(* Wire primitives                                                         *)
(***************************************************************************)

Byte == 0 .. 255

(* An unsigned integer, least significant byte first. Read only where a rule *)
(* depends on the value: a length, a count, a message type. *)
RECURSIVE DecodeUIntLE(_)
DecodeUIntLE(bytes) ==
    IF bytes = << >>
    THEN 0
    ELSE Head(bytes) + 256 * DecodeUIntLE(Tail(bytes))

RECURSIVE EncodeUIntLE(_, _)
EncodeUIntLE(value, width) ==
    IF width = 0
    THEN << >>
    ELSE <<value % 256>> \o EncodeUIntLE(value \div 256, width - 1)

(* The same, most significant byte first, which is how a big endian protocol writes it *)
RECURSIVE DecodeUIntBE(_)
DecodeUIntBE(bytes) ==
    IF bytes = << >>
    THEN 0
    ELSE DecodeUIntBE(SubSeq(bytes, 1, Len(bytes) - 1)) * 256 + bytes[Len(bytes)]

RECURSIVE EncodeUIntBE(_, _)
EncodeUIntBE(value, width) ==
    IF width = 0
    THEN << >>
    ELSE EncodeUIntBE(value \div 256, width - 1) \o <<value % 256>>

(***************************************************************************)
(* A decoder yields the value it read and the bytes left, or fails         *)
(***************************************************************************)

Fail == [ok |-> FALSE]
Ok(value, rest) == [ok |-> TRUE, value |-> value, rest |-> rest]

(* The bytes a field of this width occupies, kept as they lie *)
ReadBytes(bytes, width) ==
    IF Len(bytes) < width
    THEN Fail
    ELSE Ok(SubSeq(bytes, 1, width), SubSeq(bytes, width + 1, Len(bytes)))

(* The integer a rule depends on, in the byte order the field states *)
ReadUIntLE(bytes, width) ==
    IF Len(bytes) < width
    THEN Fail
    ELSE Ok(DecodeUIntLE(SubSeq(bytes, 1, width)), SubSeq(bytes, width + 1, Len(bytes)))

ReadUIntBE(bytes, width) ==
    IF Len(bytes) < width
    THEN Fail
    ELSE Ok(DecodeUIntBE(SubSeq(bytes, 1, width)), SubSeq(bytes, width + 1, Len(bytes)))

(* A field there only when what was read before it says so: read when it is, and held *)
(* as a sequence of the one value it read, or of none when it is not there. *)
ReadWhen(holds, read, bytes) ==
    IF ~holds
    THEN Ok(<< >>, bytes)
    ELSE IF ~read.ok THEN Fail ELSE Ok(<<read.value>>, read.rest)

(***************************************************************************)
(* The values a field is checked at: zero, the spaces a text field is      *)
(* padded with, and                                                        *)
(* every bit set, which is where an encoding goes wrong if it goes wrong   *)
(***************************************************************************)

Sample(width) ==
    { [i \in 1 .. width |-> 0],
      [i \in 1 .. width |-> 32],
      [i \in 1 .. width |-> 255] }

(* The bytes a field of no width of its own is checked at: none, one, and a short run *)
SampleBytes == { << >>, <<0>>, <<32, 255>> }

(* The lists a record is checked over: none, one, and a run of two. What a run has *)
(* to get right is reading one entry after another, which two of a kind already say. *)
SampleLists(entries) ==
    { << >> }
        \cup { <<one>> : one \in entries }
        \cup { <<one, one>> : one \in entries }

(***************************************************************************)
(* Param Group: 3 bytes                                                    *)
(***************************************************************************)

ParamGroup ==
    [ paramGroupLength : Sample(2),
      paramGroupType   : Sample(1) ]

EncodeParamGroup(message) ==
    message.paramGroupLength
        \o message.paramGroupType

DecodeParamGroup(bytes) ==
    LET paramGroupLength == ReadBytes(bytes, 2) IN IF ~paramGroupLength.ok THEN Fail ELSE
    LET paramGroupType == ReadBytes(paramGroupLength.rest, 1) IN IF ~paramGroupType.ok THEN Fail ELSE
    Ok([ paramGroupLength |-> paramGroupLength.value,
         paramGroupType   |-> paramGroupType.value ], paramGroupType.rest)

ZeroParamGroup ==
    [ paramGroupLength |-> [i \in 1 .. 2 |-> 0],
      paramGroupType   |-> [i \in 1 .. 1 |-> 0] ]

(* Param Group at zero, then each field in turn at the values it is checked at *)
CheckedParamGroup ==
    { ZeroParamGroup }
        \cup { [ZeroParamGroup EXCEPT !.paramGroupLength = one] : one \in Sample(2) }
        \cup { [ZeroParamGroup EXCEPT !.paramGroupType = one] : one \in Sample(1) }

(* A run of Param Group, written one after another *)
RECURSIVE EncodeParamGroupList(_)
EncodeParamGroupList(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeParamGroup(Head(messages)) \o EncodeParamGroupList(Tail(messages))

(* As many Param Group as the field that counts them says *)
RECURSIVE ReadParamGroupList(_, _)
ReadParamGroupList(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeParamGroup(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadParamGroupList(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Param Group of each kind, for the lists that carry them *)
OneParamGroup == { ZeroParamGroup }

(***************************************************************************)
(* Login Request Message                                                   *)
(***************************************************************************)

LoginRequestMessage ==
    [ sessionSubId : Sample(4),
      username     : Sample(4),
      password     : Sample(10),
      paramGroup   : SampleLists(OneParamGroup) ]

EncodeLoginRequestMessage(message) ==
    message.sessionSubId
        \o message.username
        \o message.password
        \o EncodeUIntBE(Len(message.paramGroup), 1)
        \o EncodeParamGroupList(message.paramGroup)

DecodeLoginRequestMessage(bytes) ==
    LET sessionSubId == ReadBytes(bytes, 4) IN IF ~sessionSubId.ok THEN Fail ELSE
    LET username == ReadBytes(sessionSubId.rest, 4) IN IF ~username.ok THEN Fail ELSE
    LET password == ReadBytes(username.rest, 10) IN IF ~password.ok THEN Fail ELSE
    LET numberOfParamGroups == ReadUIntBE(password.rest, 1) IN IF ~numberOfParamGroups.ok THEN Fail ELSE
    LET paramGroup == ReadParamGroupList(numberOfParamGroups.rest, numberOfParamGroups.value) IN IF ~paramGroup.ok THEN Fail ELSE
    Ok([ sessionSubId |-> sessionSubId.value,
         username     |-> username.value,
         password     |-> password.value,
         paramGroup   |-> paramGroup.value ], paramGroup.rest)

ZeroLoginRequestMessage ==
    [ sessionSubId |-> [i \in 1 .. 4 |-> 0],
      username     |-> [i \in 1 .. 4 |-> 0],
      password     |-> [i \in 1 .. 10 |-> 0],
      paramGroup   |-> << >> ]

(* Login Request Message at zero, then each field in turn at the values it is checked at *)
CheckedLoginRequestMessage ==
    { ZeroLoginRequestMessage }
        \cup { [ZeroLoginRequestMessage EXCEPT !.sessionSubId = one] : one \in Sample(4) }
        \cup { [ZeroLoginRequestMessage EXCEPT !.username = one] : one \in Sample(4) }
        \cup { [ZeroLoginRequestMessage EXCEPT !.password = one] : one \in Sample(10) }
        \cup { [ZeroLoginRequestMessage EXCEPT !.paramGroup = one] : one \in SampleLists(OneParamGroup) }

(***************************************************************************)
(* Units: 5 bytes                                                          *)
(***************************************************************************)

Units ==
    [ unitNumber   : Sample(1),
      unitSequence : Sample(4) ]

EncodeUnits(message) ==
    message.unitNumber
        \o message.unitSequence

DecodeUnits(bytes) ==
    LET unitNumber == ReadBytes(bytes, 1) IN IF ~unitNumber.ok THEN Fail ELSE
    LET unitSequence == ReadBytes(unitNumber.rest, 4) IN IF ~unitSequence.ok THEN Fail ELSE
    Ok([ unitNumber   |-> unitNumber.value,
         unitSequence |-> unitSequence.value ], unitSequence.rest)

ZeroUnits ==
    [ unitNumber   |-> [i \in 1 .. 1 |-> 0],
      unitSequence |-> [i \in 1 .. 4 |-> 0] ]

(* Units at zero, then each field in turn at the values it is checked at *)
CheckedUnits ==
    { ZeroUnits }
        \cup { [ZeroUnits EXCEPT !.unitNumber = one] : one \in Sample(1) }
        \cup { [ZeroUnits EXCEPT !.unitSequence = one] : one \in Sample(4) }

(* A run of Units, written one after another *)
RECURSIVE EncodeUnitsList(_)
EncodeUnitsList(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeUnits(Head(messages)) \o EncodeUnitsList(Tail(messages))

(* As many Units as the field that counts them says *)
RECURSIVE ReadUnitsList(_, _)
ReadUnitsList(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeUnits(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadUnitsList(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Units of each kind, for the lists that carry them *)
OneUnits == { ZeroUnits }

(***************************************************************************)
(* Param Group: 3 bytes                                                    *)
(***************************************************************************)

ParamGroup2 ==
    [ paramGroupLength : Sample(2),
      paramGroupType   : Sample(1) ]

EncodeParamGroup2(message) ==
    message.paramGroupLength
        \o message.paramGroupType

DecodeParamGroup2(bytes) ==
    LET paramGroupLength == ReadBytes(bytes, 2) IN IF ~paramGroupLength.ok THEN Fail ELSE
    LET paramGroupType == ReadBytes(paramGroupLength.rest, 1) IN IF ~paramGroupType.ok THEN Fail ELSE
    Ok([ paramGroupLength |-> paramGroupLength.value,
         paramGroupType   |-> paramGroupType.value ], paramGroupType.rest)

ZeroParamGroup2 ==
    [ paramGroupLength |-> [i \in 1 .. 2 |-> 0],
      paramGroupType   |-> [i \in 1 .. 1 |-> 0] ]

(* Param Group at zero, then each field in turn at the values it is checked at *)
CheckedParamGroup2 ==
    { ZeroParamGroup2 }
        \cup { [ZeroParamGroup2 EXCEPT !.paramGroupLength = one] : one \in Sample(2) }
        \cup { [ZeroParamGroup2 EXCEPT !.paramGroupType = one] : one \in Sample(1) }

(* A run of Param Group, written one after another *)
RECURSIVE EncodeParamGroup2List(_)
EncodeParamGroup2List(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeParamGroup2(Head(messages)) \o EncodeParamGroup2List(Tail(messages))

(* As many Param Group as the field that counts them says *)
RECURSIVE ReadParamGroup2List(_, _)
ReadParamGroup2List(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeParamGroup2(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadParamGroup2List(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Param Group of each kind, for the lists that carry them *)
OneParamGroup2 == { ZeroParamGroup2 }

(***************************************************************************)
(* Login Response Message                                                  *)
(***************************************************************************)

LoginResponseMessage ==
    [ loginResponseStatus        : Sample(1),
      loginResponseText          : Sample(60),
      noUnspecifiedUnitReplay    : Sample(1),
      lastReceivedSequenceNumber : Sample(4),
      units                      : SampleLists(OneUnits),
      paramGroup                 : SampleLists(OneParamGroup2) ]

EncodeLoginResponseMessage(message) ==
    message.loginResponseStatus
        \o message.loginResponseText
        \o message.noUnspecifiedUnitReplay
        \o message.lastReceivedSequenceNumber
        \o EncodeUIntBE(Len(message.units), 1)
        \o EncodeUnitsList(message.units)
        \o EncodeUIntBE(Len(message.paramGroup), 1)
        \o EncodeParamGroup2List(message.paramGroup)

DecodeLoginResponseMessage(bytes) ==
    LET loginResponseStatus == ReadBytes(bytes, 1) IN IF ~loginResponseStatus.ok THEN Fail ELSE
    LET loginResponseText == ReadBytes(loginResponseStatus.rest, 60) IN IF ~loginResponseText.ok THEN Fail ELSE
    LET noUnspecifiedUnitReplay == ReadBytes(loginResponseText.rest, 1) IN IF ~noUnspecifiedUnitReplay.ok THEN Fail ELSE
    LET lastReceivedSequenceNumber == ReadBytes(noUnspecifiedUnitReplay.rest, 4) IN IF ~lastReceivedSequenceNumber.ok THEN Fail ELSE
    LET numberOfUnits == ReadUIntBE(lastReceivedSequenceNumber.rest, 1) IN IF ~numberOfUnits.ok THEN Fail ELSE
    LET units == ReadUnitsList(numberOfUnits.rest, numberOfUnits.value) IN IF ~units.ok THEN Fail ELSE
    LET numberOfParamGroups == ReadUIntBE(units.rest, 1) IN IF ~numberOfParamGroups.ok THEN Fail ELSE
    LET paramGroup == ReadParamGroup2List(numberOfParamGroups.rest, numberOfParamGroups.value) IN IF ~paramGroup.ok THEN Fail ELSE
    Ok([ loginResponseStatus        |-> loginResponseStatus.value,
         loginResponseText          |-> loginResponseText.value,
         noUnspecifiedUnitReplay    |-> noUnspecifiedUnitReplay.value,
         lastReceivedSequenceNumber |-> lastReceivedSequenceNumber.value,
         units                      |-> units.value,
         paramGroup                 |-> paramGroup.value ], paramGroup.rest)

ZeroLoginResponseMessage ==
    [ loginResponseStatus        |-> [i \in 1 .. 1 |-> 0],
      loginResponseText          |-> [i \in 1 .. 60 |-> 0],
      noUnspecifiedUnitReplay    |-> [i \in 1 .. 1 |-> 0],
      lastReceivedSequenceNumber |-> [i \in 1 .. 4 |-> 0],
      units                      |-> << >>,
      paramGroup                 |-> << >> ]

(* Login Response Message at zero, then each field in turn at the values it is checked at *)
CheckedLoginResponseMessage ==
    { ZeroLoginResponseMessage }
        \cup { [ZeroLoginResponseMessage EXCEPT !.loginResponseStatus = one] : one \in Sample(1) }
        \cup { [ZeroLoginResponseMessage EXCEPT !.loginResponseText = one] : one \in Sample(60) }
        \cup { [ZeroLoginResponseMessage EXCEPT !.noUnspecifiedUnitReplay = one] : one \in Sample(1) }
        \cup { [ZeroLoginResponseMessage EXCEPT !.lastReceivedSequenceNumber = one] : one \in Sample(4) }
        \cup { [ZeroLoginResponseMessage EXCEPT !.units = one] : one \in SampleLists(OneUnits) }
        \cup { [ZeroLoginResponseMessage EXCEPT !.paramGroup = one] : one \in SampleLists(OneParamGroup2) }

(***************************************************************************)
(* Units: 5 bytes                                                          *)
(***************************************************************************)

Units2 ==
    [ unitNumber   : Sample(1),
      unitSequence : Sample(4) ]

EncodeUnits2(message) ==
    message.unitNumber
        \o message.unitSequence

DecodeUnits2(bytes) ==
    LET unitNumber == ReadBytes(bytes, 1) IN IF ~unitNumber.ok THEN Fail ELSE
    LET unitSequence == ReadBytes(unitNumber.rest, 4) IN IF ~unitSequence.ok THEN Fail ELSE
    Ok([ unitNumber   |-> unitNumber.value,
         unitSequence |-> unitSequence.value ], unitSequence.rest)

ZeroUnits2 ==
    [ unitNumber   |-> [i \in 1 .. 1 |-> 0],
      unitSequence |-> [i \in 1 .. 4 |-> 0] ]

(* Units at zero, then each field in turn at the values it is checked at *)
CheckedUnits2 ==
    { ZeroUnits2 }
        \cup { [ZeroUnits2 EXCEPT !.unitNumber = one] : one \in Sample(1) }
        \cup { [ZeroUnits2 EXCEPT !.unitSequence = one] : one \in Sample(4) }

(* A run of Units, written one after another *)
RECURSIVE EncodeUnits2List(_)
EncodeUnits2List(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeUnits2(Head(messages)) \o EncodeUnits2List(Tail(messages))

(* As many Units as the field that counts them says *)
RECURSIVE ReadUnits2List(_, _)
ReadUnits2List(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeUnits2(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadUnits2List(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Units of each kind, for the lists that carry them *)
OneUnits2 == { ZeroUnits2 }

(***************************************************************************)
(* Logout Message                                                          *)
(***************************************************************************)

LogoutMessage ==
    [ logoutReason               : Sample(1),
      logoutReasonText           : Sample(60),
      lastReceivedSequenceNumber : Sample(4),
      units                      : SampleLists(OneUnits2) ]

EncodeLogoutMessage(message) ==
    message.logoutReason
        \o message.logoutReasonText
        \o message.lastReceivedSequenceNumber
        \o EncodeUIntBE(Len(message.units), 1)
        \o EncodeUnits2List(message.units)

DecodeLogoutMessage(bytes) ==
    LET logoutReason == ReadBytes(bytes, 1) IN IF ~logoutReason.ok THEN Fail ELSE
    LET logoutReasonText == ReadBytes(logoutReason.rest, 60) IN IF ~logoutReasonText.ok THEN Fail ELSE
    LET lastReceivedSequenceNumber == ReadBytes(logoutReasonText.rest, 4) IN IF ~lastReceivedSequenceNumber.ok THEN Fail ELSE
    LET numberOfUnits == ReadUIntBE(lastReceivedSequenceNumber.rest, 1) IN IF ~numberOfUnits.ok THEN Fail ELSE
    LET units == ReadUnits2List(numberOfUnits.rest, numberOfUnits.value) IN IF ~units.ok THEN Fail ELSE
    Ok([ logoutReason               |-> logoutReason.value,
         logoutReasonText           |-> logoutReasonText.value,
         lastReceivedSequenceNumber |-> lastReceivedSequenceNumber.value,
         units                      |-> units.value ], units.rest)

ZeroLogoutMessage ==
    [ logoutReason               |-> [i \in 1 .. 1 |-> 0],
      logoutReasonText           |-> [i \in 1 .. 60 |-> 0],
      lastReceivedSequenceNumber |-> [i \in 1 .. 4 |-> 0],
      units                      |-> << >> ]

(* Logout Message at zero, then each field in turn at the values it is checked at *)
CheckedLogoutMessage ==
    { ZeroLogoutMessage }
        \cup { [ZeroLogoutMessage EXCEPT !.logoutReason = one] : one \in Sample(1) }
        \cup { [ZeroLogoutMessage EXCEPT !.logoutReasonText = one] : one \in Sample(60) }
        \cup { [ZeroLogoutMessage EXCEPT !.lastReceivedSequenceNumber = one] : one \in Sample(4) }
        \cup { [ZeroLogoutMessage EXCEPT !.units = one] : one \in SampleLists(OneUnits2) }

(***************************************************************************)
(* New Order Message                                                       *)
(***************************************************************************)

NewOrderMessage ==
    [ clOrdId                   : Sample(20),
      side                      : Sample(1),
      orderQtyLong              : Sample(4),
      numberOfNewOrderBitfields : 0 .. 255,
      newOrderBitfield1         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      newOrderBitfield2         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      newOrderBitfield3         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      newOrderBitfield4         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      newOrderBitfield5         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      newOrderBitfield6         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      newOrderBitfield7         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      newOrderBitfield8         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      newOrderBitfield9         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      newOrderBitfield10        : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      newOrderBitfield11        : { << >> } \cup { <<held>> : held \in Sample(1) },
      clearingFirm              : { << >> } \cup { <<held>> : held \in Sample(4) },
      clearingAccount           : { << >> } \cup { <<held>> : held \in Sample(4) },
      priceLong                 : { << >> } \cup { <<held>> : held \in Sample(8) },
      execInst                  : { << >> } \cup { <<held>> : held \in Sample(1) },
      ordType                   : { << >> } \cup { <<held>> : held \in Sample(1) },
      timeInForce               : { << >> } \cup { <<held>> : held \in Sample(1) },
      minQty                    : { << >> } \cup { <<held>> : held \in Sample(4) },
      maxFloor                  : { << >> } \cup { <<held>> : held \in Sample(4) },
      symbolLong                : { << >> } \cup { <<held>> : held \in Sample(8) },
      capacity                  : { << >> } \cup { <<held>> : held \in Sample(1) },
      routingInst               : { << >> } \cup { <<held>> : held \in Sample(4) },
      account                   : { << >> } \cup { <<held>> : held \in Sample(16) },
      displayIndicator          : { << >> } \cup { <<held>> : held \in Sample(1) },
      preventMatch              : { << >> } \cup { <<held>> : held \in Sample(3) },
      expireTime                : { << >> } \cup { <<held>> : held \in Sample(8) },
      maturityDate              : { << >> } \cup { <<held>> : held \in Sample(4) },
      strikePrice               : { << >> } \cup { <<held>> : held \in Sample(8) },
      putOrCall                 : { << >> } \cup { <<held>> : held \in Sample(1) },
      riskReset                 : { << >> } \cup { <<held>> : held \in Sample(8) },
      openClose                 : { << >> } \cup { <<held>> : held \in Sample(1) },
      cmtaNumber                : { << >> } \cup { <<held>> : held \in Sample(4) },
      targetPartyId             : { << >> } \cup { <<held>> : held \in Sample(4) },
      sessionEligibility        : { << >> } \cup { <<held>> : held \in Sample(1) },
      attributedQuote           : { << >> } \cup { <<held>> : held \in Sample(1) },
      displayRange              : { << >> } \cup { <<held>> : held \in Sample(4) },
      stopPx                    : { << >> } \cup { <<held>> : held \in Sample(8) },
      routStrategy              : { << >> } \cup { <<held>> : held \in Sample(6) },
      routeDeliveryMethod       : { << >> } \cup { <<held>> : held \in Sample(3) },
      exDestination             : { << >> } \cup { <<held>> : held \in Sample(1) },
      echoText                  : { << >> } \cup { <<held>> : held \in Sample(64) },
      auctionId                 : { << >> } \cup { <<held>> : held \in Sample(8) },
      routingFirmId             : { << >> } \cup { <<held>> : held \in Sample(4) },
      customGroupId             : { << >> } \cup { <<held>> : held \in Sample(2) },
      clearingOptionalData      : { << >> } \cup { <<held>> : held \in Sample(16) },
      clientIdAttr              : { << >> } \cup { <<held>> : held \in Sample(4) },
      frequentTraderId          : { << >> } \cup { <<held>> : held \in Sample(6) },
      compression               : { << >> } \cup { <<held>> : held \in Sample(1) },
      floorDestination          : { << >> } \cup { <<held>> : held \in Sample(4) },
      floorRoutingInst          : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderOrigin               : { << >> } \cup { <<held>> : held \in Sample(3) },
      ors                       : { << >> } \cup { <<held>> : held \in Sample(1) },
      priceType                 : { << >> } \cup { <<held>> : held \in Sample(1) },
      held                      : { << >> } \cup { <<held>> : held \in Sample(1) } ]

EncodeNewOrderMessage(message) ==
    message.clOrdId
        \o message.side
        \o message.orderQtyLong
        \o EncodeUIntBE(message.numberOfNewOrderBitfields, 1)
        \o (IF message.newOrderBitfield1 = << >> THEN << >> ELSE EncodeUIntLE(message.newOrderBitfield1[1], 1))
        \o (IF message.newOrderBitfield2 = << >> THEN << >> ELSE EncodeUIntLE(message.newOrderBitfield2[1], 1))
        \o (IF message.newOrderBitfield3 = << >> THEN << >> ELSE EncodeUIntLE(message.newOrderBitfield3[1], 1))
        \o (IF message.newOrderBitfield4 = << >> THEN << >> ELSE EncodeUIntLE(message.newOrderBitfield4[1], 1))
        \o (IF message.newOrderBitfield5 = << >> THEN << >> ELSE EncodeUIntLE(message.newOrderBitfield5[1], 1))
        \o (IF message.newOrderBitfield6 = << >> THEN << >> ELSE EncodeUIntLE(message.newOrderBitfield6[1], 1))
        \o (IF message.newOrderBitfield7 = << >> THEN << >> ELSE EncodeUIntLE(message.newOrderBitfield7[1], 1))
        \o (IF message.newOrderBitfield8 = << >> THEN << >> ELSE EncodeUIntLE(message.newOrderBitfield8[1], 1))
        \o (IF message.newOrderBitfield9 = << >> THEN << >> ELSE EncodeUIntLE(message.newOrderBitfield9[1], 1))
        \o (IF message.newOrderBitfield10 = << >> THEN << >> ELSE EncodeUIntLE(message.newOrderBitfield10[1], 1))
        \o (IF message.newOrderBitfield11 = << >> THEN << >> ELSE message.newOrderBitfield11[1])
        \o (IF message.clearingFirm = << >> THEN << >> ELSE message.clearingFirm[1])
        \o (IF message.clearingAccount = << >> THEN << >> ELSE message.clearingAccount[1])
        \o (IF message.priceLong = << >> THEN << >> ELSE message.priceLong[1])
        \o (IF message.execInst = << >> THEN << >> ELSE message.execInst[1])
        \o (IF message.ordType = << >> THEN << >> ELSE message.ordType[1])
        \o (IF message.timeInForce = << >> THEN << >> ELSE message.timeInForce[1])
        \o (IF message.minQty = << >> THEN << >> ELSE message.minQty[1])
        \o (IF message.maxFloor = << >> THEN << >> ELSE message.maxFloor[1])
        \o (IF message.symbolLong = << >> THEN << >> ELSE message.symbolLong[1])
        \o (IF message.capacity = << >> THEN << >> ELSE message.capacity[1])
        \o (IF message.routingInst = << >> THEN << >> ELSE message.routingInst[1])
        \o (IF message.account = << >> THEN << >> ELSE message.account[1])
        \o (IF message.displayIndicator = << >> THEN << >> ELSE message.displayIndicator[1])
        \o (IF message.preventMatch = << >> THEN << >> ELSE message.preventMatch[1])
        \o (IF message.expireTime = << >> THEN << >> ELSE message.expireTime[1])
        \o (IF message.maturityDate = << >> THEN << >> ELSE message.maturityDate[1])
        \o (IF message.strikePrice = << >> THEN << >> ELSE message.strikePrice[1])
        \o (IF message.putOrCall = << >> THEN << >> ELSE message.putOrCall[1])
        \o (IF message.riskReset = << >> THEN << >> ELSE message.riskReset[1])
        \o (IF message.openClose = << >> THEN << >> ELSE message.openClose[1])
        \o (IF message.cmtaNumber = << >> THEN << >> ELSE message.cmtaNumber[1])
        \o (IF message.targetPartyId = << >> THEN << >> ELSE message.targetPartyId[1])
        \o (IF message.sessionEligibility = << >> THEN << >> ELSE message.sessionEligibility[1])
        \o (IF message.attributedQuote = << >> THEN << >> ELSE message.attributedQuote[1])
        \o (IF message.displayRange = << >> THEN << >> ELSE message.displayRange[1])
        \o (IF message.stopPx = << >> THEN << >> ELSE message.stopPx[1])
        \o (IF message.routStrategy = << >> THEN << >> ELSE message.routStrategy[1])
        \o (IF message.routeDeliveryMethod = << >> THEN << >> ELSE message.routeDeliveryMethod[1])
        \o (IF message.exDestination = << >> THEN << >> ELSE message.exDestination[1])
        \o (IF message.echoText = << >> THEN << >> ELSE message.echoText[1])
        \o (IF message.auctionId = << >> THEN << >> ELSE message.auctionId[1])
        \o (IF message.routingFirmId = << >> THEN << >> ELSE message.routingFirmId[1])
        \o (IF message.customGroupId = << >> THEN << >> ELSE message.customGroupId[1])
        \o (IF message.clearingOptionalData = << >> THEN << >> ELSE message.clearingOptionalData[1])
        \o (IF message.clientIdAttr = << >> THEN << >> ELSE message.clientIdAttr[1])
        \o (IF message.frequentTraderId = << >> THEN << >> ELSE message.frequentTraderId[1])
        \o (IF message.compression = << >> THEN << >> ELSE message.compression[1])
        \o (IF message.floorDestination = << >> THEN << >> ELSE message.floorDestination[1])
        \o (IF message.floorRoutingInst = << >> THEN << >> ELSE message.floorRoutingInst[1])
        \o (IF message.orderOrigin = << >> THEN << >> ELSE message.orderOrigin[1])
        \o (IF message.ors = << >> THEN << >> ELSE message.ors[1])
        \o (IF message.priceType = << >> THEN << >> ELSE message.priceType[1])
        \o (IF message.held = << >> THEN << >> ELSE message.held[1])

DecodeNewOrderMessage(bytes) ==
    LET clOrdId == ReadBytes(bytes, 20) IN IF ~clOrdId.ok THEN Fail ELSE
    LET side == ReadBytes(clOrdId.rest, 1) IN IF ~side.ok THEN Fail ELSE
    LET orderQtyLong == ReadBytes(side.rest, 4) IN IF ~orderQtyLong.ok THEN Fail ELSE
    LET numberOfNewOrderBitfields == ReadUIntBE(orderQtyLong.rest, 1) IN IF ~numberOfNewOrderBitfields.ok THEN Fail ELSE
    LET newOrderBitfield1 == ReadWhen(numberOfNewOrderBitfields.value >= 1, ReadUIntLE(numberOfNewOrderBitfields.rest, 1), numberOfNewOrderBitfields.rest) IN IF ~newOrderBitfield1.ok THEN Fail ELSE
    LET newOrderBitfield2 == ReadWhen(numberOfNewOrderBitfields.value >= 2, ReadUIntLE(newOrderBitfield1.rest, 1), newOrderBitfield1.rest) IN IF ~newOrderBitfield2.ok THEN Fail ELSE
    LET newOrderBitfield3 == ReadWhen(numberOfNewOrderBitfields.value >= 3, ReadUIntLE(newOrderBitfield2.rest, 1), newOrderBitfield2.rest) IN IF ~newOrderBitfield3.ok THEN Fail ELSE
    LET newOrderBitfield4 == ReadWhen(numberOfNewOrderBitfields.value >= 4, ReadUIntLE(newOrderBitfield3.rest, 1), newOrderBitfield3.rest) IN IF ~newOrderBitfield4.ok THEN Fail ELSE
    LET newOrderBitfield5 == ReadWhen(numberOfNewOrderBitfields.value >= 5, ReadUIntLE(newOrderBitfield4.rest, 1), newOrderBitfield4.rest) IN IF ~newOrderBitfield5.ok THEN Fail ELSE
    LET newOrderBitfield6 == ReadWhen(numberOfNewOrderBitfields.value >= 6, ReadUIntLE(newOrderBitfield5.rest, 1), newOrderBitfield5.rest) IN IF ~newOrderBitfield6.ok THEN Fail ELSE
    LET newOrderBitfield7 == ReadWhen(numberOfNewOrderBitfields.value >= 7, ReadUIntLE(newOrderBitfield6.rest, 1), newOrderBitfield6.rest) IN IF ~newOrderBitfield7.ok THEN Fail ELSE
    LET newOrderBitfield8 == ReadWhen(numberOfNewOrderBitfields.value >= 8, ReadUIntLE(newOrderBitfield7.rest, 1), newOrderBitfield7.rest) IN IF ~newOrderBitfield8.ok THEN Fail ELSE
    LET newOrderBitfield9 == ReadWhen(numberOfNewOrderBitfields.value >= 9, ReadUIntLE(newOrderBitfield8.rest, 1), newOrderBitfield8.rest) IN IF ~newOrderBitfield9.ok THEN Fail ELSE
    LET newOrderBitfield10 == ReadWhen(numberOfNewOrderBitfields.value >= 10, ReadUIntLE(newOrderBitfield9.rest, 1), newOrderBitfield9.rest) IN IF ~newOrderBitfield10.ok THEN Fail ELSE
    LET newOrderBitfield11 == ReadWhen(numberOfNewOrderBitfields.value >= 11, ReadBytes(newOrderBitfield10.rest, 1), newOrderBitfield10.rest) IN IF ~newOrderBitfield11.ok THEN Fail ELSE
    LET clearingFirm == ReadWhen(numberOfNewOrderBitfields.value >= 1 /\ (newOrderBitfield1.value # << >> /\ newOrderBitfield1.value[1] % 2 > 0), ReadBytes(newOrderBitfield11.rest, 4), newOrderBitfield11.rest) IN IF ~clearingFirm.ok THEN Fail ELSE
    LET clearingAccount == ReadWhen(numberOfNewOrderBitfields.value >= 1 /\ (newOrderBitfield1.value # << >> /\ (newOrderBitfield1.value[1] \div 2) % 2 > 0), ReadBytes(clearingFirm.rest, 4), clearingFirm.rest) IN IF ~clearingAccount.ok THEN Fail ELSE
    LET priceLong == ReadWhen(numberOfNewOrderBitfields.value >= 1 /\ (newOrderBitfield1.value # << >> /\ (newOrderBitfield1.value[1] \div 4) % 2 > 0), ReadBytes(clearingAccount.rest, 8), clearingAccount.rest) IN IF ~priceLong.ok THEN Fail ELSE
    LET execInst == ReadWhen(numberOfNewOrderBitfields.value >= 1 /\ (newOrderBitfield1.value # << >> /\ (newOrderBitfield1.value[1] \div 8) % 2 > 0), ReadBytes(priceLong.rest, 1), priceLong.rest) IN IF ~execInst.ok THEN Fail ELSE
    LET ordType == ReadWhen(numberOfNewOrderBitfields.value >= 1 /\ (newOrderBitfield1.value # << >> /\ (newOrderBitfield1.value[1] \div 16) % 2 > 0), ReadBytes(execInst.rest, 1), execInst.rest) IN IF ~ordType.ok THEN Fail ELSE
    LET timeInForce == ReadWhen(numberOfNewOrderBitfields.value >= 1 /\ (newOrderBitfield1.value # << >> /\ (newOrderBitfield1.value[1] \div 32) % 2 > 0), ReadBytes(ordType.rest, 1), ordType.rest) IN IF ~timeInForce.ok THEN Fail ELSE
    LET minQty == ReadWhen(numberOfNewOrderBitfields.value >= 1 /\ (newOrderBitfield1.value # << >> /\ (newOrderBitfield1.value[1] \div 64) % 2 > 0), ReadBytes(timeInForce.rest, 4), timeInForce.rest) IN IF ~minQty.ok THEN Fail ELSE
    LET maxFloor == ReadWhen(numberOfNewOrderBitfields.value >= 1 /\ (newOrderBitfield1.value # << >> /\ (newOrderBitfield1.value[1] \div 128) % 2 > 0), ReadBytes(minQty.rest, 4), minQty.rest) IN IF ~maxFloor.ok THEN Fail ELSE
    LET symbolLong == ReadWhen(numberOfNewOrderBitfields.value >= 2 /\ (newOrderBitfield2.value # << >> /\ newOrderBitfield2.value[1] % 2 > 0), ReadBytes(maxFloor.rest, 8), maxFloor.rest) IN IF ~symbolLong.ok THEN Fail ELSE
    LET capacity == ReadWhen(numberOfNewOrderBitfields.value >= 2 /\ (newOrderBitfield2.value # << >> /\ (newOrderBitfield2.value[1] \div 64) % 2 > 0), ReadBytes(symbolLong.rest, 1), symbolLong.rest) IN IF ~capacity.ok THEN Fail ELSE
    LET routingInst == ReadWhen(numberOfNewOrderBitfields.value >= 2 /\ (newOrderBitfield2.value # << >> /\ (newOrderBitfield2.value[1] \div 128) % 2 > 0), ReadBytes(capacity.rest, 4), capacity.rest) IN IF ~routingInst.ok THEN Fail ELSE
    LET account == ReadWhen(numberOfNewOrderBitfields.value >= 3 /\ (newOrderBitfield3.value # << >> /\ newOrderBitfield3.value[1] % 2 > 0), ReadBytes(routingInst.rest, 16), routingInst.rest) IN IF ~account.ok THEN Fail ELSE
    LET displayIndicator == ReadWhen(numberOfNewOrderBitfields.value >= 3 /\ (newOrderBitfield3.value # << >> /\ (newOrderBitfield3.value[1] \div 2) % 2 > 0), ReadBytes(account.rest, 1), account.rest) IN IF ~displayIndicator.ok THEN Fail ELSE
    LET preventMatch == ReadWhen(numberOfNewOrderBitfields.value >= 3 /\ (newOrderBitfield3.value # << >> /\ (newOrderBitfield3.value[1] \div 32) % 2 > 0), ReadBytes(displayIndicator.rest, 3), displayIndicator.rest) IN IF ~preventMatch.ok THEN Fail ELSE
    LET expireTime == ReadWhen(numberOfNewOrderBitfields.value >= 3 /\ (newOrderBitfield3.value # << >> /\ (newOrderBitfield3.value[1] \div 128) % 2 > 0), ReadBytes(preventMatch.rest, 8), preventMatch.rest) IN IF ~expireTime.ok THEN Fail ELSE
    LET maturityDate == ReadWhen(numberOfNewOrderBitfields.value >= 4 /\ (newOrderBitfield4.value # << >> /\ newOrderBitfield4.value[1] % 2 > 0), ReadBytes(expireTime.rest, 4), expireTime.rest) IN IF ~maturityDate.ok THEN Fail ELSE
    LET strikePrice == ReadWhen(numberOfNewOrderBitfields.value >= 4 /\ (newOrderBitfield4.value # << >> /\ (newOrderBitfield4.value[1] \div 2) % 2 > 0), ReadBytes(maturityDate.rest, 8), maturityDate.rest) IN IF ~strikePrice.ok THEN Fail ELSE
    LET putOrCall == ReadWhen(numberOfNewOrderBitfields.value >= 4 /\ (newOrderBitfield4.value # << >> /\ (newOrderBitfield4.value[1] \div 4) % 2 > 0), ReadBytes(strikePrice.rest, 1), strikePrice.rest) IN IF ~putOrCall.ok THEN Fail ELSE
    LET riskReset == ReadWhen(numberOfNewOrderBitfields.value >= 4 /\ (newOrderBitfield4.value # << >> /\ (newOrderBitfield4.value[1] \div 8) % 2 > 0), ReadBytes(putOrCall.rest, 8), putOrCall.rest) IN IF ~riskReset.ok THEN Fail ELSE
    LET openClose == ReadWhen(numberOfNewOrderBitfields.value >= 4 /\ (newOrderBitfield4.value # << >> /\ (newOrderBitfield4.value[1] \div 16) % 2 > 0), ReadBytes(riskReset.rest, 1), riskReset.rest) IN IF ~openClose.ok THEN Fail ELSE
    LET cmtaNumber == ReadWhen(numberOfNewOrderBitfields.value >= 4 /\ (newOrderBitfield4.value # << >> /\ (newOrderBitfield4.value[1] \div 32) % 2 > 0), ReadBytes(openClose.rest, 4), openClose.rest) IN IF ~cmtaNumber.ok THEN Fail ELSE
    LET targetPartyId == ReadWhen(numberOfNewOrderBitfields.value >= 4 /\ (newOrderBitfield4.value # << >> /\ (newOrderBitfield4.value[1] \div 64) % 2 > 0), ReadBytes(cmtaNumber.rest, 4), cmtaNumber.rest) IN IF ~targetPartyId.ok THEN Fail ELSE
    LET sessionEligibility == ReadWhen(numberOfNewOrderBitfields.value >= 5 /\ (newOrderBitfield5.value # << >> /\ newOrderBitfield5.value[1] % 2 > 0), ReadBytes(targetPartyId.rest, 1), targetPartyId.rest) IN IF ~sessionEligibility.ok THEN Fail ELSE
    LET attributedQuote == ReadWhen(numberOfNewOrderBitfields.value >= 5 /\ (newOrderBitfield5.value # << >> /\ (newOrderBitfield5.value[1] \div 2) % 2 > 0), ReadBytes(sessionEligibility.rest, 1), sessionEligibility.rest) IN IF ~attributedQuote.ok THEN Fail ELSE
    LET displayRange == ReadWhen(numberOfNewOrderBitfields.value >= 6 /\ (newOrderBitfield6.value # << >> /\ newOrderBitfield6.value[1] % 2 > 0), ReadBytes(attributedQuote.rest, 4), attributedQuote.rest) IN IF ~displayRange.ok THEN Fail ELSE
    LET stopPx == ReadWhen(numberOfNewOrderBitfields.value >= 6 /\ (newOrderBitfield6.value # << >> /\ (newOrderBitfield6.value[1] \div 2) % 2 > 0), ReadBytes(displayRange.rest, 8), displayRange.rest) IN IF ~stopPx.ok THEN Fail ELSE
    LET routStrategy == ReadWhen(numberOfNewOrderBitfields.value >= 6 /\ (newOrderBitfield6.value # << >> /\ (newOrderBitfield6.value[1] \div 4) % 2 > 0), ReadBytes(stopPx.rest, 6), stopPx.rest) IN IF ~routStrategy.ok THEN Fail ELSE
    LET routeDeliveryMethod == ReadWhen(numberOfNewOrderBitfields.value >= 6 /\ (newOrderBitfield6.value # << >> /\ (newOrderBitfield6.value[1] \div 8) % 2 > 0), ReadBytes(routStrategy.rest, 3), routStrategy.rest) IN IF ~routeDeliveryMethod.ok THEN Fail ELSE
    LET exDestination == ReadWhen(numberOfNewOrderBitfields.value >= 6 /\ (newOrderBitfield6.value # << >> /\ (newOrderBitfield6.value[1] \div 16) % 2 > 0), ReadBytes(routeDeliveryMethod.rest, 1), routeDeliveryMethod.rest) IN IF ~exDestination.ok THEN Fail ELSE
    LET echoText == ReadWhen(numberOfNewOrderBitfields.value >= 6 /\ (newOrderBitfield6.value # << >> /\ (newOrderBitfield6.value[1] \div 32) % 2 > 0), ReadBytes(exDestination.rest, 64), exDestination.rest) IN IF ~echoText.ok THEN Fail ELSE
    LET auctionId == ReadWhen(numberOfNewOrderBitfields.value >= 6 /\ (newOrderBitfield6.value # << >> /\ (newOrderBitfield6.value[1] \div 64) % 2 > 0), ReadBytes(echoText.rest, 8), echoText.rest) IN IF ~auctionId.ok THEN Fail ELSE
    LET routingFirmId == ReadWhen(numberOfNewOrderBitfields.value >= 6 /\ (newOrderBitfield6.value # << >> /\ (newOrderBitfield6.value[1] \div 128) % 2 > 0), ReadBytes(auctionId.rest, 4), auctionId.rest) IN IF ~routingFirmId.ok THEN Fail ELSE
    LET customGroupId == ReadWhen(numberOfNewOrderBitfields.value >= 7 /\ (newOrderBitfield7.value # << >> /\ (newOrderBitfield7.value[1] \div 2) % 2 > 0), ReadBytes(routingFirmId.rest, 2), routingFirmId.rest) IN IF ~customGroupId.ok THEN Fail ELSE
    LET clearingOptionalData == ReadWhen(numberOfNewOrderBitfields.value >= 8 /\ (newOrderBitfield8.value # << >> /\ (newOrderBitfield8.value[1] \div 4) % 2 > 0), ReadBytes(customGroupId.rest, 16), customGroupId.rest) IN IF ~clearingOptionalData.ok THEN Fail ELSE
    LET clientIdAttr == ReadWhen(numberOfNewOrderBitfields.value >= 8 /\ (newOrderBitfield8.value # << >> /\ (newOrderBitfield8.value[1] \div 8) % 2 > 0), ReadBytes(clearingOptionalData.rest, 4), clearingOptionalData.rest) IN IF ~clientIdAttr.ok THEN Fail ELSE
    LET frequentTraderId == ReadWhen(numberOfNewOrderBitfields.value >= 8 /\ (newOrderBitfield8.value # << >> /\ (newOrderBitfield8.value[1] \div 16) % 2 > 0), ReadBytes(clientIdAttr.rest, 6), clientIdAttr.rest) IN IF ~frequentTraderId.ok THEN Fail ELSE
    LET compression == ReadWhen(numberOfNewOrderBitfields.value >= 8 /\ (newOrderBitfield8.value # << >> /\ (newOrderBitfield8.value[1] \div 32) % 2 > 0), ReadBytes(frequentTraderId.rest, 1), frequentTraderId.rest) IN IF ~compression.ok THEN Fail ELSE
    LET floorDestination == ReadWhen(numberOfNewOrderBitfields.value >= 8 /\ (newOrderBitfield8.value # << >> /\ (newOrderBitfield8.value[1] \div 64) % 2 > 0), ReadBytes(compression.rest, 4), compression.rest) IN IF ~floorDestination.ok THEN Fail ELSE
    LET floorRoutingInst == ReadWhen(numberOfNewOrderBitfields.value >= 8 /\ (newOrderBitfield8.value # << >> /\ (newOrderBitfield8.value[1] \div 128) % 2 > 0), ReadBytes(floorDestination.rest, 1), floorDestination.rest) IN IF ~floorRoutingInst.ok THEN Fail ELSE
    LET orderOrigin == ReadWhen(numberOfNewOrderBitfields.value >= 9 /\ (newOrderBitfield9.value # << >> /\ newOrderBitfield9.value[1] % 2 > 0), ReadBytes(floorRoutingInst.rest, 3), floorRoutingInst.rest) IN IF ~orderOrigin.ok THEN Fail ELSE
    LET ors == ReadWhen(numberOfNewOrderBitfields.value >= 9 /\ (newOrderBitfield9.value # << >> /\ (newOrderBitfield9.value[1] \div 2) % 2 > 0), ReadBytes(orderOrigin.rest, 1), orderOrigin.rest) IN IF ~ors.ok THEN Fail ELSE
    LET priceType == ReadWhen(numberOfNewOrderBitfields.value >= 9 /\ (newOrderBitfield9.value # << >> /\ (newOrderBitfield9.value[1] \div 4) % 2 > 0), ReadBytes(ors.rest, 1), ors.rest) IN IF ~priceType.ok THEN Fail ELSE
    LET held == ReadWhen(numberOfNewOrderBitfields.value >= 10 /\ (newOrderBitfield10.value # << >> /\ newOrderBitfield10.value[1] % 2 > 0), ReadBytes(priceType.rest, 1), priceType.rest) IN IF ~held.ok THEN Fail ELSE
    Ok([ clOrdId                   |-> clOrdId.value,
         side                      |-> side.value,
         orderQtyLong              |-> orderQtyLong.value,
         numberOfNewOrderBitfields |-> numberOfNewOrderBitfields.value,
         newOrderBitfield1         |-> newOrderBitfield1.value,
         newOrderBitfield2         |-> newOrderBitfield2.value,
         newOrderBitfield3         |-> newOrderBitfield3.value,
         newOrderBitfield4         |-> newOrderBitfield4.value,
         newOrderBitfield5         |-> newOrderBitfield5.value,
         newOrderBitfield6         |-> newOrderBitfield6.value,
         newOrderBitfield7         |-> newOrderBitfield7.value,
         newOrderBitfield8         |-> newOrderBitfield8.value,
         newOrderBitfield9         |-> newOrderBitfield9.value,
         newOrderBitfield10        |-> newOrderBitfield10.value,
         newOrderBitfield11        |-> newOrderBitfield11.value,
         clearingFirm              |-> clearingFirm.value,
         clearingAccount           |-> clearingAccount.value,
         priceLong                 |-> priceLong.value,
         execInst                  |-> execInst.value,
         ordType                   |-> ordType.value,
         timeInForce               |-> timeInForce.value,
         minQty                    |-> minQty.value,
         maxFloor                  |-> maxFloor.value,
         symbolLong                |-> symbolLong.value,
         capacity                  |-> capacity.value,
         routingInst               |-> routingInst.value,
         account                   |-> account.value,
         displayIndicator          |-> displayIndicator.value,
         preventMatch              |-> preventMatch.value,
         expireTime                |-> expireTime.value,
         maturityDate              |-> maturityDate.value,
         strikePrice               |-> strikePrice.value,
         putOrCall                 |-> putOrCall.value,
         riskReset                 |-> riskReset.value,
         openClose                 |-> openClose.value,
         cmtaNumber                |-> cmtaNumber.value,
         targetPartyId             |-> targetPartyId.value,
         sessionEligibility        |-> sessionEligibility.value,
         attributedQuote           |-> attributedQuote.value,
         displayRange              |-> displayRange.value,
         stopPx                    |-> stopPx.value,
         routStrategy              |-> routStrategy.value,
         routeDeliveryMethod       |-> routeDeliveryMethod.value,
         exDestination             |-> exDestination.value,
         echoText                  |-> echoText.value,
         auctionId                 |-> auctionId.value,
         routingFirmId             |-> routingFirmId.value,
         customGroupId             |-> customGroupId.value,
         clearingOptionalData      |-> clearingOptionalData.value,
         clientIdAttr              |-> clientIdAttr.value,
         frequentTraderId          |-> frequentTraderId.value,
         compression               |-> compression.value,
         floorDestination          |-> floorDestination.value,
         floorRoutingInst          |-> floorRoutingInst.value,
         orderOrigin               |-> orderOrigin.value,
         ors                       |-> ors.value,
         priceType                 |-> priceType.value,
         held                      |-> held.value ], held.rest)

(* New Order Message with each field marked present by fields before it there exactly where they say *)
SettleNewOrderMessage(message) ==
    LET settled1 == [message EXCEPT !.newOrderBitfield1 = IF message.numberOfNewOrderBitfields >= 1 THEN (IF message.newOrderBitfield1 = << >> THEN <<0>> ELSE message.newOrderBitfield1) ELSE << >>]
        settled2 == [settled1 EXCEPT !.newOrderBitfield2 = IF settled1.numberOfNewOrderBitfields >= 2 THEN (IF settled1.newOrderBitfield2 = << >> THEN <<0>> ELSE settled1.newOrderBitfield2) ELSE << >>]
        settled3 == [settled2 EXCEPT !.newOrderBitfield3 = IF settled2.numberOfNewOrderBitfields >= 3 THEN (IF settled2.newOrderBitfield3 = << >> THEN <<0>> ELSE settled2.newOrderBitfield3) ELSE << >>]
        settled4 == [settled3 EXCEPT !.newOrderBitfield4 = IF settled3.numberOfNewOrderBitfields >= 4 THEN (IF settled3.newOrderBitfield4 = << >> THEN <<0>> ELSE settled3.newOrderBitfield4) ELSE << >>]
        settled5 == [settled4 EXCEPT !.newOrderBitfield5 = IF settled4.numberOfNewOrderBitfields >= 5 THEN (IF settled4.newOrderBitfield5 = << >> THEN <<0>> ELSE settled4.newOrderBitfield5) ELSE << >>]
        settled6 == [settled5 EXCEPT !.newOrderBitfield6 = IF settled5.numberOfNewOrderBitfields >= 6 THEN (IF settled5.newOrderBitfield6 = << >> THEN <<0>> ELSE settled5.newOrderBitfield6) ELSE << >>]
        settled7 == [settled6 EXCEPT !.newOrderBitfield7 = IF settled6.numberOfNewOrderBitfields >= 7 THEN (IF settled6.newOrderBitfield7 = << >> THEN <<0>> ELSE settled6.newOrderBitfield7) ELSE << >>]
        settled8 == [settled7 EXCEPT !.newOrderBitfield8 = IF settled7.numberOfNewOrderBitfields >= 8 THEN (IF settled7.newOrderBitfield8 = << >> THEN <<0>> ELSE settled7.newOrderBitfield8) ELSE << >>]
        settled9 == [settled8 EXCEPT !.newOrderBitfield9 = IF settled8.numberOfNewOrderBitfields >= 9 THEN (IF settled8.newOrderBitfield9 = << >> THEN <<0>> ELSE settled8.newOrderBitfield9) ELSE << >>]
        settled10 == [settled9 EXCEPT !.newOrderBitfield10 = IF settled9.numberOfNewOrderBitfields >= 10 THEN (IF settled9.newOrderBitfield10 = << >> THEN <<0>> ELSE settled9.newOrderBitfield10) ELSE << >>]
        settled11 == [settled10 EXCEPT !.newOrderBitfield11 = IF settled10.numberOfNewOrderBitfields >= 11 THEN (IF settled10.newOrderBitfield11 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled10.newOrderBitfield11) ELSE << >>]
        settled12 == [settled11 EXCEPT !.clearingFirm = IF settled11.numberOfNewOrderBitfields >= 1 /\ (settled11.newOrderBitfield1 # << >> /\ settled11.newOrderBitfield1[1] % 2 > 0) THEN (IF settled11.clearingFirm = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled11.clearingFirm) ELSE << >>]
        settled13 == [settled12 EXCEPT !.clearingAccount = IF settled12.numberOfNewOrderBitfields >= 1 /\ (settled12.newOrderBitfield1 # << >> /\ (settled12.newOrderBitfield1[1] \div 2) % 2 > 0) THEN (IF settled12.clearingAccount = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled12.clearingAccount) ELSE << >>]
        settled14 == [settled13 EXCEPT !.priceLong = IF settled13.numberOfNewOrderBitfields >= 1 /\ (settled13.newOrderBitfield1 # << >> /\ (settled13.newOrderBitfield1[1] \div 4) % 2 > 0) THEN (IF settled13.priceLong = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled13.priceLong) ELSE << >>]
        settled15 == [settled14 EXCEPT !.execInst = IF settled14.numberOfNewOrderBitfields >= 1 /\ (settled14.newOrderBitfield1 # << >> /\ (settled14.newOrderBitfield1[1] \div 8) % 2 > 0) THEN (IF settled14.execInst = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled14.execInst) ELSE << >>]
        settled16 == [settled15 EXCEPT !.ordType = IF settled15.numberOfNewOrderBitfields >= 1 /\ (settled15.newOrderBitfield1 # << >> /\ (settled15.newOrderBitfield1[1] \div 16) % 2 > 0) THEN (IF settled15.ordType = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled15.ordType) ELSE << >>]
        settled17 == [settled16 EXCEPT !.timeInForce = IF settled16.numberOfNewOrderBitfields >= 1 /\ (settled16.newOrderBitfield1 # << >> /\ (settled16.newOrderBitfield1[1] \div 32) % 2 > 0) THEN (IF settled16.timeInForce = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled16.timeInForce) ELSE << >>]
        settled18 == [settled17 EXCEPT !.minQty = IF settled17.numberOfNewOrderBitfields >= 1 /\ (settled17.newOrderBitfield1 # << >> /\ (settled17.newOrderBitfield1[1] \div 64) % 2 > 0) THEN (IF settled17.minQty = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled17.minQty) ELSE << >>]
        settled19 == [settled18 EXCEPT !.maxFloor = IF settled18.numberOfNewOrderBitfields >= 1 /\ (settled18.newOrderBitfield1 # << >> /\ (settled18.newOrderBitfield1[1] \div 128) % 2 > 0) THEN (IF settled18.maxFloor = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled18.maxFloor) ELSE << >>]
        settled20 == [settled19 EXCEPT !.symbolLong = IF settled19.numberOfNewOrderBitfields >= 2 /\ (settled19.newOrderBitfield2 # << >> /\ settled19.newOrderBitfield2[1] % 2 > 0) THEN (IF settled19.symbolLong = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled19.symbolLong) ELSE << >>]
        settled21 == [settled20 EXCEPT !.capacity = IF settled20.numberOfNewOrderBitfields >= 2 /\ (settled20.newOrderBitfield2 # << >> /\ (settled20.newOrderBitfield2[1] \div 64) % 2 > 0) THEN (IF settled20.capacity = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled20.capacity) ELSE << >>]
        settled22 == [settled21 EXCEPT !.routingInst = IF settled21.numberOfNewOrderBitfields >= 2 /\ (settled21.newOrderBitfield2 # << >> /\ (settled21.newOrderBitfield2[1] \div 128) % 2 > 0) THEN (IF settled21.routingInst = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled21.routingInst) ELSE << >>]
        settled23 == [settled22 EXCEPT !.account = IF settled22.numberOfNewOrderBitfields >= 3 /\ (settled22.newOrderBitfield3 # << >> /\ settled22.newOrderBitfield3[1] % 2 > 0) THEN (IF settled22.account = << >> THEN <<[i \in 1 .. 16 |-> 0]>> ELSE settled22.account) ELSE << >>]
        settled24 == [settled23 EXCEPT !.displayIndicator = IF settled23.numberOfNewOrderBitfields >= 3 /\ (settled23.newOrderBitfield3 # << >> /\ (settled23.newOrderBitfield3[1] \div 2) % 2 > 0) THEN (IF settled23.displayIndicator = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled23.displayIndicator) ELSE << >>]
        settled25 == [settled24 EXCEPT !.preventMatch = IF settled24.numberOfNewOrderBitfields >= 3 /\ (settled24.newOrderBitfield3 # << >> /\ (settled24.newOrderBitfield3[1] \div 32) % 2 > 0) THEN (IF settled24.preventMatch = << >> THEN <<[i \in 1 .. 3 |-> 0]>> ELSE settled24.preventMatch) ELSE << >>]
        settled26 == [settled25 EXCEPT !.expireTime = IF settled25.numberOfNewOrderBitfields >= 3 /\ (settled25.newOrderBitfield3 # << >> /\ (settled25.newOrderBitfield3[1] \div 128) % 2 > 0) THEN (IF settled25.expireTime = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled25.expireTime) ELSE << >>]
        settled27 == [settled26 EXCEPT !.maturityDate = IF settled26.numberOfNewOrderBitfields >= 4 /\ (settled26.newOrderBitfield4 # << >> /\ settled26.newOrderBitfield4[1] % 2 > 0) THEN (IF settled26.maturityDate = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled26.maturityDate) ELSE << >>]
        settled28 == [settled27 EXCEPT !.strikePrice = IF settled27.numberOfNewOrderBitfields >= 4 /\ (settled27.newOrderBitfield4 # << >> /\ (settled27.newOrderBitfield4[1] \div 2) % 2 > 0) THEN (IF settled27.strikePrice = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled27.strikePrice) ELSE << >>]
        settled29 == [settled28 EXCEPT !.putOrCall = IF settled28.numberOfNewOrderBitfields >= 4 /\ (settled28.newOrderBitfield4 # << >> /\ (settled28.newOrderBitfield4[1] \div 4) % 2 > 0) THEN (IF settled28.putOrCall = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled28.putOrCall) ELSE << >>]
        settled30 == [settled29 EXCEPT !.riskReset = IF settled29.numberOfNewOrderBitfields >= 4 /\ (settled29.newOrderBitfield4 # << >> /\ (settled29.newOrderBitfield4[1] \div 8) % 2 > 0) THEN (IF settled29.riskReset = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled29.riskReset) ELSE << >>]
        settled31 == [settled30 EXCEPT !.openClose = IF settled30.numberOfNewOrderBitfields >= 4 /\ (settled30.newOrderBitfield4 # << >> /\ (settled30.newOrderBitfield4[1] \div 16) % 2 > 0) THEN (IF settled30.openClose = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled30.openClose) ELSE << >>]
        settled32 == [settled31 EXCEPT !.cmtaNumber = IF settled31.numberOfNewOrderBitfields >= 4 /\ (settled31.newOrderBitfield4 # << >> /\ (settled31.newOrderBitfield4[1] \div 32) % 2 > 0) THEN (IF settled31.cmtaNumber = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled31.cmtaNumber) ELSE << >>]
        settled33 == [settled32 EXCEPT !.targetPartyId = IF settled32.numberOfNewOrderBitfields >= 4 /\ (settled32.newOrderBitfield4 # << >> /\ (settled32.newOrderBitfield4[1] \div 64) % 2 > 0) THEN (IF settled32.targetPartyId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled32.targetPartyId) ELSE << >>]
        settled34 == [settled33 EXCEPT !.sessionEligibility = IF settled33.numberOfNewOrderBitfields >= 5 /\ (settled33.newOrderBitfield5 # << >> /\ settled33.newOrderBitfield5[1] % 2 > 0) THEN (IF settled33.sessionEligibility = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled33.sessionEligibility) ELSE << >>]
        settled35 == [settled34 EXCEPT !.attributedQuote = IF settled34.numberOfNewOrderBitfields >= 5 /\ (settled34.newOrderBitfield5 # << >> /\ (settled34.newOrderBitfield5[1] \div 2) % 2 > 0) THEN (IF settled34.attributedQuote = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled34.attributedQuote) ELSE << >>]
        settled36 == [settled35 EXCEPT !.displayRange = IF settled35.numberOfNewOrderBitfields >= 6 /\ (settled35.newOrderBitfield6 # << >> /\ settled35.newOrderBitfield6[1] % 2 > 0) THEN (IF settled35.displayRange = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled35.displayRange) ELSE << >>]
        settled37 == [settled36 EXCEPT !.stopPx = IF settled36.numberOfNewOrderBitfields >= 6 /\ (settled36.newOrderBitfield6 # << >> /\ (settled36.newOrderBitfield6[1] \div 2) % 2 > 0) THEN (IF settled36.stopPx = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled36.stopPx) ELSE << >>]
        settled38 == [settled37 EXCEPT !.routStrategy = IF settled37.numberOfNewOrderBitfields >= 6 /\ (settled37.newOrderBitfield6 # << >> /\ (settled37.newOrderBitfield6[1] \div 4) % 2 > 0) THEN (IF settled37.routStrategy = << >> THEN <<[i \in 1 .. 6 |-> 0]>> ELSE settled37.routStrategy) ELSE << >>]
        settled39 == [settled38 EXCEPT !.routeDeliveryMethod = IF settled38.numberOfNewOrderBitfields >= 6 /\ (settled38.newOrderBitfield6 # << >> /\ (settled38.newOrderBitfield6[1] \div 8) % 2 > 0) THEN (IF settled38.routeDeliveryMethod = << >> THEN <<[i \in 1 .. 3 |-> 0]>> ELSE settled38.routeDeliveryMethod) ELSE << >>]
        settled40 == [settled39 EXCEPT !.exDestination = IF settled39.numberOfNewOrderBitfields >= 6 /\ (settled39.newOrderBitfield6 # << >> /\ (settled39.newOrderBitfield6[1] \div 16) % 2 > 0) THEN (IF settled39.exDestination = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled39.exDestination) ELSE << >>]
        settled41 == [settled40 EXCEPT !.echoText = IF settled40.numberOfNewOrderBitfields >= 6 /\ (settled40.newOrderBitfield6 # << >> /\ (settled40.newOrderBitfield6[1] \div 32) % 2 > 0) THEN (IF settled40.echoText = << >> THEN <<[i \in 1 .. 64 |-> 0]>> ELSE settled40.echoText) ELSE << >>]
        settled42 == [settled41 EXCEPT !.auctionId = IF settled41.numberOfNewOrderBitfields >= 6 /\ (settled41.newOrderBitfield6 # << >> /\ (settled41.newOrderBitfield6[1] \div 64) % 2 > 0) THEN (IF settled41.auctionId = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled41.auctionId) ELSE << >>]
        settled43 == [settled42 EXCEPT !.routingFirmId = IF settled42.numberOfNewOrderBitfields >= 6 /\ (settled42.newOrderBitfield6 # << >> /\ (settled42.newOrderBitfield6[1] \div 128) % 2 > 0) THEN (IF settled42.routingFirmId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled42.routingFirmId) ELSE << >>]
        settled44 == [settled43 EXCEPT !.customGroupId = IF settled43.numberOfNewOrderBitfields >= 7 /\ (settled43.newOrderBitfield7 # << >> /\ (settled43.newOrderBitfield7[1] \div 2) % 2 > 0) THEN (IF settled43.customGroupId = << >> THEN <<[i \in 1 .. 2 |-> 0]>> ELSE settled43.customGroupId) ELSE << >>]
        settled45 == [settled44 EXCEPT !.clearingOptionalData = IF settled44.numberOfNewOrderBitfields >= 8 /\ (settled44.newOrderBitfield8 # << >> /\ (settled44.newOrderBitfield8[1] \div 4) % 2 > 0) THEN (IF settled44.clearingOptionalData = << >> THEN <<[i \in 1 .. 16 |-> 0]>> ELSE settled44.clearingOptionalData) ELSE << >>]
        settled46 == [settled45 EXCEPT !.clientIdAttr = IF settled45.numberOfNewOrderBitfields >= 8 /\ (settled45.newOrderBitfield8 # << >> /\ (settled45.newOrderBitfield8[1] \div 8) % 2 > 0) THEN (IF settled45.clientIdAttr = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled45.clientIdAttr) ELSE << >>]
        settled47 == [settled46 EXCEPT !.frequentTraderId = IF settled46.numberOfNewOrderBitfields >= 8 /\ (settled46.newOrderBitfield8 # << >> /\ (settled46.newOrderBitfield8[1] \div 16) % 2 > 0) THEN (IF settled46.frequentTraderId = << >> THEN <<[i \in 1 .. 6 |-> 0]>> ELSE settled46.frequentTraderId) ELSE << >>]
        settled48 == [settled47 EXCEPT !.compression = IF settled47.numberOfNewOrderBitfields >= 8 /\ (settled47.newOrderBitfield8 # << >> /\ (settled47.newOrderBitfield8[1] \div 32) % 2 > 0) THEN (IF settled47.compression = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled47.compression) ELSE << >>]
        settled49 == [settled48 EXCEPT !.floorDestination = IF settled48.numberOfNewOrderBitfields >= 8 /\ (settled48.newOrderBitfield8 # << >> /\ (settled48.newOrderBitfield8[1] \div 64) % 2 > 0) THEN (IF settled48.floorDestination = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled48.floorDestination) ELSE << >>]
        settled50 == [settled49 EXCEPT !.floorRoutingInst = IF settled49.numberOfNewOrderBitfields >= 8 /\ (settled49.newOrderBitfield8 # << >> /\ (settled49.newOrderBitfield8[1] \div 128) % 2 > 0) THEN (IF settled49.floorRoutingInst = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled49.floorRoutingInst) ELSE << >>]
        settled51 == [settled50 EXCEPT !.orderOrigin = IF settled50.numberOfNewOrderBitfields >= 9 /\ (settled50.newOrderBitfield9 # << >> /\ settled50.newOrderBitfield9[1] % 2 > 0) THEN (IF settled50.orderOrigin = << >> THEN <<[i \in 1 .. 3 |-> 0]>> ELSE settled50.orderOrigin) ELSE << >>]
        settled52 == [settled51 EXCEPT !.ors = IF settled51.numberOfNewOrderBitfields >= 9 /\ (settled51.newOrderBitfield9 # << >> /\ (settled51.newOrderBitfield9[1] \div 2) % 2 > 0) THEN (IF settled51.ors = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled51.ors) ELSE << >>]
        settled53 == [settled52 EXCEPT !.priceType = IF settled52.numberOfNewOrderBitfields >= 9 /\ (settled52.newOrderBitfield9 # << >> /\ (settled52.newOrderBitfield9[1] \div 4) % 2 > 0) THEN (IF settled52.priceType = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled52.priceType) ELSE << >>]
        settled54 == [settled53 EXCEPT !.held = IF settled53.numberOfNewOrderBitfields >= 10 /\ (settled53.newOrderBitfield10 # << >> /\ settled53.newOrderBitfield10[1] % 2 > 0) THEN (IF settled53.held = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled53.held) ELSE << >>]
    IN  settled54

ZeroNewOrderMessage ==
    SettleNewOrderMessage([ clOrdId                   |-> [i \in 1 .. 20 |-> 0],
                            side                      |-> [i \in 1 .. 1 |-> 0],
                            orderQtyLong              |-> [i \in 1 .. 4 |-> 0],
                            numberOfNewOrderBitfields |-> 0,
                            newOrderBitfield1         |-> << >>,
                            newOrderBitfield2         |-> << >>,
                            newOrderBitfield3         |-> << >>,
                            newOrderBitfield4         |-> << >>,
                            newOrderBitfield5         |-> << >>,
                            newOrderBitfield6         |-> << >>,
                            newOrderBitfield7         |-> << >>,
                            newOrderBitfield8         |-> << >>,
                            newOrderBitfield9         |-> << >>,
                            newOrderBitfield10        |-> << >>,
                            newOrderBitfield11        |-> << >>,
                            clearingFirm              |-> << >>,
                            clearingAccount           |-> << >>,
                            priceLong                 |-> << >>,
                            execInst                  |-> << >>,
                            ordType                   |-> << >>,
                            timeInForce               |-> << >>,
                            minQty                    |-> << >>,
                            maxFloor                  |-> << >>,
                            symbolLong                |-> << >>,
                            capacity                  |-> << >>,
                            routingInst               |-> << >>,
                            account                   |-> << >>,
                            displayIndicator          |-> << >>,
                            preventMatch              |-> << >>,
                            expireTime                |-> << >>,
                            maturityDate              |-> << >>,
                            strikePrice               |-> << >>,
                            putOrCall                 |-> << >>,
                            riskReset                 |-> << >>,
                            openClose                 |-> << >>,
                            cmtaNumber                |-> << >>,
                            targetPartyId             |-> << >>,
                            sessionEligibility        |-> << >>,
                            attributedQuote           |-> << >>,
                            displayRange              |-> << >>,
                            stopPx                    |-> << >>,
                            routStrategy              |-> << >>,
                            routeDeliveryMethod       |-> << >>,
                            exDestination             |-> << >>,
                            echoText                  |-> << >>,
                            auctionId                 |-> << >>,
                            routingFirmId             |-> << >>,
                            customGroupId             |-> << >>,
                            clearingOptionalData      |-> << >>,
                            clientIdAttr              |-> << >>,
                            frequentTraderId          |-> << >>,
                            compression               |-> << >>,
                            floorDestination          |-> << >>,
                            floorRoutingInst          |-> << >>,
                            orderOrigin               |-> << >>,
                            ors                       |-> << >>,
                            priceType                 |-> << >>,
                            held                      |-> << >> ])

(* New Order Message at zero, then each field in turn at the values it is checked at *)
CheckedNewOrderMessage ==
    { ZeroNewOrderMessage }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.clOrdId = one]) : one \in Sample(20) }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.side = one]) : one \in Sample(1) }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.orderQtyLong = one]) : one \in Sample(4) }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = one]) : one \in {0, 1, 255} }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 1, !.newOrderBitfield1 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 2, !.newOrderBitfield2 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 3, !.newOrderBitfield3 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 4, !.newOrderBitfield4 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 5, !.newOrderBitfield5 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 6, !.newOrderBitfield6 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 7, !.newOrderBitfield7 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 8, !.newOrderBitfield8 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 9, !.newOrderBitfield9 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 10, !.newOrderBitfield10 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 11, !.newOrderBitfield11 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 1, !.newOrderBitfield1 = <<1>>, !.clearingFirm = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 1, !.newOrderBitfield1 = <<2>>, !.clearingAccount = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 1, !.newOrderBitfield1 = <<4>>, !.priceLong = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 1, !.newOrderBitfield1 = <<8>>, !.execInst = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 1, !.newOrderBitfield1 = <<16>>, !.ordType = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 1, !.newOrderBitfield1 = <<32>>, !.timeInForce = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 1, !.newOrderBitfield1 = <<64>>, !.minQty = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 1, !.newOrderBitfield1 = <<128>>, !.maxFloor = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 2, !.newOrderBitfield2 = <<1>>, !.symbolLong = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 2, !.newOrderBitfield2 = <<64>>, !.capacity = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 2, !.newOrderBitfield2 = <<128>>, !.routingInst = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 3, !.newOrderBitfield3 = <<1>>, !.account = one]) : one \in { <<held>> : held \in Sample(16) } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 3, !.newOrderBitfield3 = <<2>>, !.displayIndicator = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 3, !.newOrderBitfield3 = <<32>>, !.preventMatch = one]) : one \in { <<held>> : held \in Sample(3) } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 3, !.newOrderBitfield3 = <<128>>, !.expireTime = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 4, !.newOrderBitfield4 = <<1>>, !.maturityDate = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 4, !.newOrderBitfield4 = <<2>>, !.strikePrice = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 4, !.newOrderBitfield4 = <<4>>, !.putOrCall = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 4, !.newOrderBitfield4 = <<8>>, !.riskReset = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 4, !.newOrderBitfield4 = <<16>>, !.openClose = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 4, !.newOrderBitfield4 = <<32>>, !.cmtaNumber = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 4, !.newOrderBitfield4 = <<64>>, !.targetPartyId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 5, !.newOrderBitfield5 = <<1>>, !.sessionEligibility = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 5, !.newOrderBitfield5 = <<2>>, !.attributedQuote = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 6, !.newOrderBitfield6 = <<1>>, !.displayRange = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 6, !.newOrderBitfield6 = <<2>>, !.stopPx = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 6, !.newOrderBitfield6 = <<4>>, !.routStrategy = one]) : one \in { <<held>> : held \in Sample(6) } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 6, !.newOrderBitfield6 = <<8>>, !.routeDeliveryMethod = one]) : one \in { <<held>> : held \in Sample(3) } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 6, !.newOrderBitfield6 = <<16>>, !.exDestination = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 6, !.newOrderBitfield6 = <<32>>, !.echoText = one]) : one \in { <<held>> : held \in Sample(64) } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 6, !.newOrderBitfield6 = <<64>>, !.auctionId = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 6, !.newOrderBitfield6 = <<128>>, !.routingFirmId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 7, !.newOrderBitfield7 = <<2>>, !.customGroupId = one]) : one \in { <<held>> : held \in Sample(2) } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 8, !.newOrderBitfield8 = <<4>>, !.clearingOptionalData = one]) : one \in { <<held>> : held \in Sample(16) } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 8, !.newOrderBitfield8 = <<8>>, !.clientIdAttr = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 8, !.newOrderBitfield8 = <<16>>, !.frequentTraderId = one]) : one \in { <<held>> : held \in Sample(6) } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 8, !.newOrderBitfield8 = <<32>>, !.compression = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 8, !.newOrderBitfield8 = <<64>>, !.floorDestination = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 8, !.newOrderBitfield8 = <<128>>, !.floorRoutingInst = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 9, !.newOrderBitfield9 = <<1>>, !.orderOrigin = one]) : one \in { <<held>> : held \in Sample(3) } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 9, !.newOrderBitfield9 = <<2>>, !.ors = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 9, !.newOrderBitfield9 = <<4>>, !.priceType = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderMessage([ZeroNewOrderMessage EXCEPT !.numberOfNewOrderBitfields = 10, !.newOrderBitfield10 = <<1>>, !.held = one]) : one \in { <<held>> : held \in Sample(1) } }

(***************************************************************************)
(* Order Allocations                                                       *)
(***************************************************************************)

OrderAllocations ==
    [ side                 : Sample(1),
      allocQty             : Sample(4),
      clOrdId              : Sample(20),
      capacity             : Sample(1),
      openClose            : Sample(1),
      giveUpFirmId         : Sample(4),
      account              : { << >> } \cup { <<held>> : held \in Sample(16) },
      cmtaNumber           : { << >> } \cup { <<held>> : held \in Sample(4) },
      clearingAccount      : { << >> } \cup { <<held>> : held \in Sample(4) },
      clearingOptionalData : { << >> } \cup { <<held>> : held \in Sample(16) },
      frequentTraderId     : { << >> } \cup { <<held>> : held \in Sample(6) } ]

EncodeOrderAllocations(message) ==
    message.side
        \o message.allocQty
        \o message.clOrdId
        \o message.capacity
        \o message.openClose
        \o message.giveUpFirmId
        \o (IF message.account = << >> THEN << >> ELSE message.account[1])
        \o (IF message.cmtaNumber = << >> THEN << >> ELSE message.cmtaNumber[1])
        \o (IF message.clearingAccount = << >> THEN << >> ELSE message.clearingAccount[1])
        \o (IF message.clearingOptionalData = << >> THEN << >> ELSE message.clearingOptionalData[1])
        \o (IF message.frequentTraderId = << >> THEN << >> ELSE message.frequentTraderId[1])

DecodeOrderAllocations(bytes, handedNumberOfNewOrderCrossBitfields, handedNewOrderCrossBitfield2, handedNewOrderCrossBitfield4) ==
    LET side == ReadBytes(bytes, 1) IN IF ~side.ok THEN Fail ELSE
    LET allocQty == ReadBytes(side.rest, 4) IN IF ~allocQty.ok THEN Fail ELSE
    LET clOrdId == ReadBytes(allocQty.rest, 20) IN IF ~clOrdId.ok THEN Fail ELSE
    LET capacity == ReadBytes(clOrdId.rest, 1) IN IF ~capacity.ok THEN Fail ELSE
    LET openClose == ReadBytes(capacity.rest, 1) IN IF ~openClose.ok THEN Fail ELSE
    LET giveUpFirmId == ReadBytes(openClose.rest, 4) IN IF ~giveUpFirmId.ok THEN Fail ELSE
    LET account == ReadWhen(handedNumberOfNewOrderCrossBitfields >= 2 /\ (handedNewOrderCrossBitfield2 # << >> /\ (handedNewOrderCrossBitfield2[1] \div 8) % 2 > 0), ReadBytes(giveUpFirmId.rest, 16), giveUpFirmId.rest) IN IF ~account.ok THEN Fail ELSE
    LET cmtaNumber == ReadWhen(handedNumberOfNewOrderCrossBitfields >= 2 /\ (handedNewOrderCrossBitfield2 # << >> /\ (handedNewOrderCrossBitfield2[1] \div 16) % 2 > 0), ReadBytes(account.rest, 4), account.rest) IN IF ~cmtaNumber.ok THEN Fail ELSE
    LET clearingAccount == ReadWhen(handedNumberOfNewOrderCrossBitfields >= 2 /\ (handedNewOrderCrossBitfield2 # << >> /\ (handedNewOrderCrossBitfield2[1] \div 32) % 2 > 0), ReadBytes(cmtaNumber.rest, 4), cmtaNumber.rest) IN IF ~clearingAccount.ok THEN Fail ELSE
    LET clearingOptionalData == ReadWhen(handedNumberOfNewOrderCrossBitfields >= 2 /\ (handedNewOrderCrossBitfield2 # << >> /\ (handedNewOrderCrossBitfield2[1] \div 128) % 2 > 0), ReadBytes(clearingAccount.rest, 16), clearingAccount.rest) IN IF ~clearingOptionalData.ok THEN Fail ELSE
    LET frequentTraderId == ReadWhen(handedNumberOfNewOrderCrossBitfields >= 4 /\ (handedNewOrderCrossBitfield4 # << >> /\ (handedNewOrderCrossBitfield4[1] \div 4) % 2 > 0), ReadBytes(clearingOptionalData.rest, 6), clearingOptionalData.rest) IN IF ~frequentTraderId.ok THEN Fail ELSE
    Ok([ side                 |-> side.value,
         allocQty             |-> allocQty.value,
         clOrdId              |-> clOrdId.value,
         capacity             |-> capacity.value,
         openClose            |-> openClose.value,
         giveUpFirmId         |-> giveUpFirmId.value,
         account              |-> account.value,
         cmtaNumber           |-> cmtaNumber.value,
         clearingAccount      |-> clearingAccount.value,
         clearingOptionalData |-> clearingOptionalData.value,
         frequentTraderId     |-> frequentTraderId.value ], frequentTraderId.rest)

(* Order Allocations with each field marked present by fields before it there exactly where they say *)
SettleOrderAllocations(message, handedNumberOfNewOrderCrossBitfields, handedNewOrderCrossBitfield2, handedNewOrderCrossBitfield4) ==
    LET settled1 == [message EXCEPT !.account = IF handedNumberOfNewOrderCrossBitfields >= 2 /\ (handedNewOrderCrossBitfield2 # << >> /\ (handedNewOrderCrossBitfield2[1] \div 8) % 2 > 0) THEN (IF message.account = << >> THEN <<[i \in 1 .. 16 |-> 0]>> ELSE message.account) ELSE << >>]
        settled2 == [settled1 EXCEPT !.cmtaNumber = IF handedNumberOfNewOrderCrossBitfields >= 2 /\ (handedNewOrderCrossBitfield2 # << >> /\ (handedNewOrderCrossBitfield2[1] \div 16) % 2 > 0) THEN (IF settled1.cmtaNumber = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled1.cmtaNumber) ELSE << >>]
        settled3 == [settled2 EXCEPT !.clearingAccount = IF handedNumberOfNewOrderCrossBitfields >= 2 /\ (handedNewOrderCrossBitfield2 # << >> /\ (handedNewOrderCrossBitfield2[1] \div 32) % 2 > 0) THEN (IF settled2.clearingAccount = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled2.clearingAccount) ELSE << >>]
        settled4 == [settled3 EXCEPT !.clearingOptionalData = IF handedNumberOfNewOrderCrossBitfields >= 2 /\ (handedNewOrderCrossBitfield2 # << >> /\ (handedNewOrderCrossBitfield2[1] \div 128) % 2 > 0) THEN (IF settled3.clearingOptionalData = << >> THEN <<[i \in 1 .. 16 |-> 0]>> ELSE settled3.clearingOptionalData) ELSE << >>]
        settled5 == [settled4 EXCEPT !.frequentTraderId = IF handedNumberOfNewOrderCrossBitfields >= 4 /\ (handedNewOrderCrossBitfield4 # << >> /\ (handedNewOrderCrossBitfield4[1] \div 4) % 2 > 0) THEN (IF settled4.frequentTraderId = << >> THEN <<[i \in 1 .. 6 |-> 0]>> ELSE settled4.frequentTraderId) ELSE << >>]
    IN  settled5

ZeroOrderAllocations ==
    SettleOrderAllocations([ side                 |-> [i \in 1 .. 1 |-> 0],
                             allocQty             |-> [i \in 1 .. 4 |-> 0],
                             clOrdId              |-> [i \in 1 .. 20 |-> 0],
                             capacity             |-> [i \in 1 .. 1 |-> 0],
                             openClose            |-> [i \in 1 .. 1 |-> 0],
                             giveUpFirmId         |-> [i \in 1 .. 4 |-> 0],
                             account              |-> << >>,
                             cmtaNumber           |-> << >>,
                             clearingAccount      |-> << >>,
                             clearingOptionalData |-> << >>,
                             frequentTraderId     |-> << >> ], 0, << >>, << >>)

(* Order Allocations at zero, then each field in turn at the values it is checked at *)
CheckedOrderAllocations ==
    { [given |-> <<0, << >>, << >>>>, message |-> ZeroOrderAllocations] }
        \cup { [given |-> <<0, << >>, << >>>>, message |-> SettleOrderAllocations([ZeroOrderAllocations EXCEPT !.side = one], 0, << >>, << >>)] : one \in Sample(1) }
        \cup { [given |-> <<0, << >>, << >>>>, message |-> SettleOrderAllocations([ZeroOrderAllocations EXCEPT !.allocQty = one], 0, << >>, << >>)] : one \in Sample(4) }
        \cup { [given |-> <<0, << >>, << >>>>, message |-> SettleOrderAllocations([ZeroOrderAllocations EXCEPT !.clOrdId = one], 0, << >>, << >>)] : one \in Sample(20) }
        \cup { [given |-> <<0, << >>, << >>>>, message |-> SettleOrderAllocations([ZeroOrderAllocations EXCEPT !.capacity = one], 0, << >>, << >>)] : one \in Sample(1) }
        \cup { [given |-> <<0, << >>, << >>>>, message |-> SettleOrderAllocations([ZeroOrderAllocations EXCEPT !.openClose = one], 0, << >>, << >>)] : one \in Sample(1) }
        \cup { [given |-> <<0, << >>, << >>>>, message |-> SettleOrderAllocations([ZeroOrderAllocations EXCEPT !.giveUpFirmId = one], 0, << >>, << >>)] : one \in Sample(4) }
        \cup { [given |-> <<2, <<8>>, << >>>>, message |-> SettleOrderAllocations([ZeroOrderAllocations EXCEPT !.account = one], 2, <<8>>, << >>)] : one \in { <<held>> : held \in Sample(16) } }
        \cup { [given |-> <<2, <<16>>, << >>>>, message |-> SettleOrderAllocations([ZeroOrderAllocations EXCEPT !.cmtaNumber = one], 2, <<16>>, << >>)] : one \in { <<held>> : held \in Sample(4) } }
        \cup { [given |-> <<2, <<32>>, << >>>>, message |-> SettleOrderAllocations([ZeroOrderAllocations EXCEPT !.clearingAccount = one], 2, <<32>>, << >>)] : one \in { <<held>> : held \in Sample(4) } }
        \cup { [given |-> <<2, <<128>>, << >>>>, message |-> SettleOrderAllocations([ZeroOrderAllocations EXCEPT !.clearingOptionalData = one], 2, <<128>>, << >>)] : one \in { <<held>> : held \in Sample(16) } }
        \cup { [given |-> <<4, << >>, <<4>>>>, message |-> SettleOrderAllocations([ZeroOrderAllocations EXCEPT !.frequentTraderId = one], 4, << >>, <<4>>)] : one \in { <<held>> : held \in Sample(6) } }

(* A run of Order Allocations, written one after another *)
RECURSIVE EncodeOrderAllocationsList(_)
EncodeOrderAllocationsList(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeOrderAllocations(Head(messages)) \o EncodeOrderAllocationsList(Tail(messages))

(* As many Order Allocations as the field that counts them says *)
RECURSIVE ReadOrderAllocationsList(_, _, _, _, _)
ReadOrderAllocationsList(bytes, count, handedNumberOfNewOrderCrossBitfields, handedNewOrderCrossBitfield2, handedNewOrderCrossBitfield4) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeOrderAllocations(bytes, handedNumberOfNewOrderCrossBitfields, handedNewOrderCrossBitfield2, handedNewOrderCrossBitfield4)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadOrderAllocationsList(one.rest, count - 1, handedNumberOfNewOrderCrossBitfields, handedNewOrderCrossBitfield2, handedNewOrderCrossBitfield4)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Order Allocations of each kind, for the lists that carry them *)
OneOrderAllocations == { ZeroOrderAllocations }

(***************************************************************************)
(* New Order Cross Message                                                 *)
(***************************************************************************)

NewOrderCrossMessage ==
    [ crossId                        : Sample(20),
      crossType                      : Sample(1),
      crossPrioritization            : Sample(1),
      priceLong                      : Sample(8),
      orderQtyLong                   : Sample(4),
      numberOfNewOrderCrossBitfields : 0 .. 255,
      newOrderCrossBitfield1         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      newOrderCrossBitfield2         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      newOrderCrossBitfield3         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      newOrderCrossBitfield4         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderAllocations               : SampleLists(OneOrderAllocations),
      symbolLong                     : { << >> } \cup { <<held>> : held \in Sample(8) },
      maturityDate                   : { << >> } \cup { <<held>> : held \in Sample(4) },
      strikePrice                    : { << >> } \cup { <<held>> : held \in Sample(8) },
      putOrCall                      : { << >> } \cup { <<held>> : held \in Sample(1) },
      execInst                       : { << >> } \cup { <<held>> : held \in Sample(1) },
      attributedQuote                : { << >> } \cup { <<held>> : held \in Sample(1) },
      targetPartyId                  : { << >> } \cup { <<held>> : held \in Sample(4) },
      preventMatch                   : { << >> } \cup { <<held>> : held \in Sample(3) },
      autoMatch                      : { << >> } \cup { <<held>> : held \in Sample(1) },
      autoMatchPrice                 : { << >> } \cup { <<held>> : held \in Sample(8) },
      lastPriority                   : { << >> } \cup { <<held>> : held \in Sample(1) },
      routingFirmId                  : { << >> } \cup { <<held>> : held \in Sample(4) },
      clientIdAttr                   : { << >> } \cup { <<held>> : held \in Sample(4) },
      equityTradePrice               : { << >> } \cup { <<held>> : held \in Sample(8) },
      equityTradeSize                : { << >> } \cup { <<held>> : held \in Sample(4) },
      equityTradeVenue               : { << >> } \cup { <<held>> : held \in Sample(1) },
      equityTransactTime             : { << >> } \cup { <<held>> : held \in Sample(8) },
      equityBuyClearingFirm          : { << >> } \cup { <<held>> : held \in Sample(4) },
      equitySellClearingFirm         : { << >> } \cup { <<held>> : held \in Sample(4) },
      sessionEligibility             : { << >> } \cup { <<held>> : held \in Sample(1) },
      compression                    : { << >> } \cup { <<held>> : held \in Sample(1) },
      ors                            : { << >> } \cup { <<held>> : held \in Sample(1) } ]

EncodeNewOrderCrossMessage(message) ==
    message.crossId
        \o message.crossType
        \o message.crossPrioritization
        \o message.priceLong
        \o message.orderQtyLong
        \o EncodeUIntBE(message.numberOfNewOrderCrossBitfields, 1)
        \o (IF message.newOrderCrossBitfield1 = << >> THEN << >> ELSE EncodeUIntLE(message.newOrderCrossBitfield1[1], 1))
        \o (IF message.newOrderCrossBitfield2 = << >> THEN << >> ELSE EncodeUIntLE(message.newOrderCrossBitfield2[1], 1))
        \o (IF message.newOrderCrossBitfield3 = << >> THEN << >> ELSE EncodeUIntLE(message.newOrderCrossBitfield3[1], 1))
        \o (IF message.newOrderCrossBitfield4 = << >> THEN << >> ELSE EncodeUIntLE(message.newOrderCrossBitfield4[1], 1))
        \o EncodeUIntLE(Len(message.orderAllocations), 2)
        \o EncodeOrderAllocationsList(message.orderAllocations)
        \o (IF message.symbolLong = << >> THEN << >> ELSE message.symbolLong[1])
        \o (IF message.maturityDate = << >> THEN << >> ELSE message.maturityDate[1])
        \o (IF message.strikePrice = << >> THEN << >> ELSE message.strikePrice[1])
        \o (IF message.putOrCall = << >> THEN << >> ELSE message.putOrCall[1])
        \o (IF message.execInst = << >> THEN << >> ELSE message.execInst[1])
        \o (IF message.attributedQuote = << >> THEN << >> ELSE message.attributedQuote[1])
        \o (IF message.targetPartyId = << >> THEN << >> ELSE message.targetPartyId[1])
        \o (IF message.preventMatch = << >> THEN << >> ELSE message.preventMatch[1])
        \o (IF message.autoMatch = << >> THEN << >> ELSE message.autoMatch[1])
        \o (IF message.autoMatchPrice = << >> THEN << >> ELSE message.autoMatchPrice[1])
        \o (IF message.lastPriority = << >> THEN << >> ELSE message.lastPriority[1])
        \o (IF message.routingFirmId = << >> THEN << >> ELSE message.routingFirmId[1])
        \o (IF message.clientIdAttr = << >> THEN << >> ELSE message.clientIdAttr[1])
        \o (IF message.equityTradePrice = << >> THEN << >> ELSE message.equityTradePrice[1])
        \o (IF message.equityTradeSize = << >> THEN << >> ELSE message.equityTradeSize[1])
        \o (IF message.equityTradeVenue = << >> THEN << >> ELSE message.equityTradeVenue[1])
        \o (IF message.equityTransactTime = << >> THEN << >> ELSE message.equityTransactTime[1])
        \o (IF message.equityBuyClearingFirm = << >> THEN << >> ELSE message.equityBuyClearingFirm[1])
        \o (IF message.equitySellClearingFirm = << >> THEN << >> ELSE message.equitySellClearingFirm[1])
        \o (IF message.sessionEligibility = << >> THEN << >> ELSE message.sessionEligibility[1])
        \o (IF message.compression = << >> THEN << >> ELSE message.compression[1])
        \o (IF message.ors = << >> THEN << >> ELSE message.ors[1])

DecodeNewOrderCrossMessage(bytes) ==
    LET crossId == ReadBytes(bytes, 20) IN IF ~crossId.ok THEN Fail ELSE
    LET crossType == ReadBytes(crossId.rest, 1) IN IF ~crossType.ok THEN Fail ELSE
    LET crossPrioritization == ReadBytes(crossType.rest, 1) IN IF ~crossPrioritization.ok THEN Fail ELSE
    LET priceLong == ReadBytes(crossPrioritization.rest, 8) IN IF ~priceLong.ok THEN Fail ELSE
    LET orderQtyLong == ReadBytes(priceLong.rest, 4) IN IF ~orderQtyLong.ok THEN Fail ELSE
    LET numberOfNewOrderCrossBitfields == ReadUIntBE(orderQtyLong.rest, 1) IN IF ~numberOfNewOrderCrossBitfields.ok THEN Fail ELSE
    LET newOrderCrossBitfield1 == ReadWhen(numberOfNewOrderCrossBitfields.value >= 1, ReadUIntLE(numberOfNewOrderCrossBitfields.rest, 1), numberOfNewOrderCrossBitfields.rest) IN IF ~newOrderCrossBitfield1.ok THEN Fail ELSE
    LET newOrderCrossBitfield2 == ReadWhen(numberOfNewOrderCrossBitfields.value >= 2, ReadUIntLE(newOrderCrossBitfield1.rest, 1), newOrderCrossBitfield1.rest) IN IF ~newOrderCrossBitfield2.ok THEN Fail ELSE
    LET newOrderCrossBitfield3 == ReadWhen(numberOfNewOrderCrossBitfields.value >= 3, ReadUIntLE(newOrderCrossBitfield2.rest, 1), newOrderCrossBitfield2.rest) IN IF ~newOrderCrossBitfield3.ok THEN Fail ELSE
    LET newOrderCrossBitfield4 == ReadWhen(numberOfNewOrderCrossBitfields.value >= 4, ReadUIntLE(newOrderCrossBitfield3.rest, 1), newOrderCrossBitfield3.rest) IN IF ~newOrderCrossBitfield4.ok THEN Fail ELSE
    LET groupCnt == ReadUIntLE(newOrderCrossBitfield4.rest, 2) IN IF ~groupCnt.ok THEN Fail ELSE
    LET orderAllocations == ReadOrderAllocationsList(groupCnt.rest, groupCnt.value, numberOfNewOrderCrossBitfields.value, newOrderCrossBitfield2.value, newOrderCrossBitfield4.value) IN IF ~orderAllocations.ok THEN Fail ELSE
    LET symbolLong == ReadWhen(numberOfNewOrderCrossBitfields.value >= 1 /\ (newOrderCrossBitfield1.value # << >> /\ newOrderCrossBitfield1.value[1] % 2 > 0), ReadBytes(orderAllocations.rest, 8), orderAllocations.rest) IN IF ~symbolLong.ok THEN Fail ELSE
    LET maturityDate == ReadWhen(numberOfNewOrderCrossBitfields.value >= 1 /\ (newOrderCrossBitfield1.value # << >> /\ (newOrderCrossBitfield1.value[1] \div 2) % 2 > 0), ReadBytes(symbolLong.rest, 4), symbolLong.rest) IN IF ~maturityDate.ok THEN Fail ELSE
    LET strikePrice == ReadWhen(numberOfNewOrderCrossBitfields.value >= 1 /\ (newOrderCrossBitfield1.value # << >> /\ (newOrderCrossBitfield1.value[1] \div 4) % 2 > 0), ReadBytes(maturityDate.rest, 8), maturityDate.rest) IN IF ~strikePrice.ok THEN Fail ELSE
    LET putOrCall == ReadWhen(numberOfNewOrderCrossBitfields.value >= 1 /\ (newOrderCrossBitfield1.value # << >> /\ (newOrderCrossBitfield1.value[1] \div 8) % 2 > 0), ReadBytes(strikePrice.rest, 1), strikePrice.rest) IN IF ~putOrCall.ok THEN Fail ELSE
    LET execInst == ReadWhen(numberOfNewOrderCrossBitfields.value >= 1 /\ (newOrderCrossBitfield1.value # << >> /\ (newOrderCrossBitfield1.value[1] \div 16) % 2 > 0), ReadBytes(putOrCall.rest, 1), putOrCall.rest) IN IF ~execInst.ok THEN Fail ELSE
    LET attributedQuote == ReadWhen(numberOfNewOrderCrossBitfields.value >= 1 /\ (newOrderCrossBitfield1.value # << >> /\ (newOrderCrossBitfield1.value[1] \div 32) % 2 > 0), ReadBytes(execInst.rest, 1), execInst.rest) IN IF ~attributedQuote.ok THEN Fail ELSE
    LET targetPartyId == ReadWhen(numberOfNewOrderCrossBitfields.value >= 1 /\ (newOrderCrossBitfield1.value # << >> /\ (newOrderCrossBitfield1.value[1] \div 64) % 2 > 0), ReadBytes(attributedQuote.rest, 4), attributedQuote.rest) IN IF ~targetPartyId.ok THEN Fail ELSE
    LET preventMatch == ReadWhen(numberOfNewOrderCrossBitfields.value >= 1 /\ (newOrderCrossBitfield1.value # << >> /\ (newOrderCrossBitfield1.value[1] \div 128) % 2 > 0), ReadBytes(targetPartyId.rest, 3), targetPartyId.rest) IN IF ~preventMatch.ok THEN Fail ELSE
    LET autoMatch == ReadWhen(numberOfNewOrderCrossBitfields.value >= 2 /\ (newOrderCrossBitfield2.value # << >> /\ newOrderCrossBitfield2.value[1] % 2 > 0), ReadBytes(preventMatch.rest, 1), preventMatch.rest) IN IF ~autoMatch.ok THEN Fail ELSE
    LET autoMatchPrice == ReadWhen(numberOfNewOrderCrossBitfields.value >= 2 /\ (newOrderCrossBitfield2.value # << >> /\ (newOrderCrossBitfield2.value[1] \div 2) % 2 > 0), ReadBytes(autoMatch.rest, 8), autoMatch.rest) IN IF ~autoMatchPrice.ok THEN Fail ELSE
    LET lastPriority == ReadWhen(numberOfNewOrderCrossBitfields.value >= 2 /\ (newOrderCrossBitfield2.value # << >> /\ (newOrderCrossBitfield2.value[1] \div 4) % 2 > 0), ReadBytes(autoMatchPrice.rest, 1), autoMatchPrice.rest) IN IF ~lastPriority.ok THEN Fail ELSE
    LET routingFirmId == ReadWhen(numberOfNewOrderCrossBitfields.value >= 2 /\ (newOrderCrossBitfield2.value # << >> /\ (newOrderCrossBitfield2.value[1] \div 64) % 2 > 0), ReadBytes(lastPriority.rest, 4), lastPriority.rest) IN IF ~routingFirmId.ok THEN Fail ELSE
    LET clientIdAttr == ReadWhen(numberOfNewOrderCrossBitfields.value >= 3 /\ (newOrderCrossBitfield3.value # << >> /\ newOrderCrossBitfield3.value[1] % 2 > 0), ReadBytes(routingFirmId.rest, 4), routingFirmId.rest) IN IF ~clientIdAttr.ok THEN Fail ELSE
    LET equityTradePrice == ReadWhen(numberOfNewOrderCrossBitfields.value >= 3 /\ (newOrderCrossBitfield3.value # << >> /\ (newOrderCrossBitfield3.value[1] \div 2) % 2 > 0), ReadBytes(clientIdAttr.rest, 8), clientIdAttr.rest) IN IF ~equityTradePrice.ok THEN Fail ELSE
    LET equityTradeSize == ReadWhen(numberOfNewOrderCrossBitfields.value >= 3 /\ (newOrderCrossBitfield3.value # << >> /\ (newOrderCrossBitfield3.value[1] \div 4) % 2 > 0), ReadBytes(equityTradePrice.rest, 4), equityTradePrice.rest) IN IF ~equityTradeSize.ok THEN Fail ELSE
    LET equityTradeVenue == ReadWhen(numberOfNewOrderCrossBitfields.value >= 3 /\ (newOrderCrossBitfield3.value # << >> /\ (newOrderCrossBitfield3.value[1] \div 8) % 2 > 0), ReadBytes(equityTradeSize.rest, 1), equityTradeSize.rest) IN IF ~equityTradeVenue.ok THEN Fail ELSE
    LET equityTransactTime == ReadWhen(numberOfNewOrderCrossBitfields.value >= 3 /\ (newOrderCrossBitfield3.value # << >> /\ (newOrderCrossBitfield3.value[1] \div 16) % 2 > 0), ReadBytes(equityTradeVenue.rest, 8), equityTradeVenue.rest) IN IF ~equityTransactTime.ok THEN Fail ELSE
    LET equityBuyClearingFirm == ReadWhen(numberOfNewOrderCrossBitfields.value >= 3 /\ (newOrderCrossBitfield3.value # << >> /\ (newOrderCrossBitfield3.value[1] \div 32) % 2 > 0), ReadBytes(equityTransactTime.rest, 4), equityTransactTime.rest) IN IF ~equityBuyClearingFirm.ok THEN Fail ELSE
    LET equitySellClearingFirm == ReadWhen(numberOfNewOrderCrossBitfields.value >= 3 /\ (newOrderCrossBitfield3.value # << >> /\ (newOrderCrossBitfield3.value[1] \div 64) % 2 > 0), ReadBytes(equityBuyClearingFirm.rest, 4), equityBuyClearingFirm.rest) IN IF ~equitySellClearingFirm.ok THEN Fail ELSE
    LET sessionEligibility == ReadWhen(numberOfNewOrderCrossBitfields.value >= 3 /\ (newOrderCrossBitfield3.value # << >> /\ (newOrderCrossBitfield3.value[1] \div 128) % 2 > 0), ReadBytes(equitySellClearingFirm.rest, 1), equitySellClearingFirm.rest) IN IF ~sessionEligibility.ok THEN Fail ELSE
    LET compression == ReadWhen(numberOfNewOrderCrossBitfields.value >= 4 /\ (newOrderCrossBitfield4.value # << >> /\ newOrderCrossBitfield4.value[1] % 2 > 0), ReadBytes(sessionEligibility.rest, 1), sessionEligibility.rest) IN IF ~compression.ok THEN Fail ELSE
    LET ors == ReadWhen(numberOfNewOrderCrossBitfields.value >= 4 /\ (newOrderCrossBitfield4.value # << >> /\ (newOrderCrossBitfield4.value[1] \div 2) % 2 > 0), ReadBytes(compression.rest, 1), compression.rest) IN IF ~ors.ok THEN Fail ELSE
    Ok([ crossId                        |-> crossId.value,
         crossType                      |-> crossType.value,
         crossPrioritization            |-> crossPrioritization.value,
         priceLong                      |-> priceLong.value,
         orderQtyLong                   |-> orderQtyLong.value,
         numberOfNewOrderCrossBitfields |-> numberOfNewOrderCrossBitfields.value,
         newOrderCrossBitfield1         |-> newOrderCrossBitfield1.value,
         newOrderCrossBitfield2         |-> newOrderCrossBitfield2.value,
         newOrderCrossBitfield3         |-> newOrderCrossBitfield3.value,
         newOrderCrossBitfield4         |-> newOrderCrossBitfield4.value,
         orderAllocations               |-> orderAllocations.value,
         symbolLong                     |-> symbolLong.value,
         maturityDate                   |-> maturityDate.value,
         strikePrice                    |-> strikePrice.value,
         putOrCall                      |-> putOrCall.value,
         execInst                       |-> execInst.value,
         attributedQuote                |-> attributedQuote.value,
         targetPartyId                  |-> targetPartyId.value,
         preventMatch                   |-> preventMatch.value,
         autoMatch                      |-> autoMatch.value,
         autoMatchPrice                 |-> autoMatchPrice.value,
         lastPriority                   |-> lastPriority.value,
         routingFirmId                  |-> routingFirmId.value,
         clientIdAttr                   |-> clientIdAttr.value,
         equityTradePrice               |-> equityTradePrice.value,
         equityTradeSize                |-> equityTradeSize.value,
         equityTradeVenue               |-> equityTradeVenue.value,
         equityTransactTime             |-> equityTransactTime.value,
         equityBuyClearingFirm          |-> equityBuyClearingFirm.value,
         equitySellClearingFirm         |-> equitySellClearingFirm.value,
         sessionEligibility             |-> sessionEligibility.value,
         compression                    |-> compression.value,
         ors                            |-> ors.value ], ors.rest)

(* New Order Cross Message with each field marked present by fields before it there exactly where they say *)
SettleNewOrderCrossMessage(message) ==
    LET settled1 == [message EXCEPT !.newOrderCrossBitfield1 = IF message.numberOfNewOrderCrossBitfields >= 1 THEN (IF message.newOrderCrossBitfield1 = << >> THEN <<0>> ELSE message.newOrderCrossBitfield1) ELSE << >>]
        settled2 == [settled1 EXCEPT !.newOrderCrossBitfield2 = IF settled1.numberOfNewOrderCrossBitfields >= 2 THEN (IF settled1.newOrderCrossBitfield2 = << >> THEN <<0>> ELSE settled1.newOrderCrossBitfield2) ELSE << >>]
        settled3 == [settled2 EXCEPT !.newOrderCrossBitfield3 = IF settled2.numberOfNewOrderCrossBitfields >= 3 THEN (IF settled2.newOrderCrossBitfield3 = << >> THEN <<0>> ELSE settled2.newOrderCrossBitfield3) ELSE << >>]
        settled4 == [settled3 EXCEPT !.newOrderCrossBitfield4 = IF settled3.numberOfNewOrderCrossBitfields >= 4 THEN (IF settled3.newOrderCrossBitfield4 = << >> THEN <<0>> ELSE settled3.newOrderCrossBitfield4) ELSE << >>]
        settled5 == [settled4 EXCEPT !.orderAllocations = [i \in DOMAIN settled4.orderAllocations |-> SettleOrderAllocations(settled4.orderAllocations[i], settled4.numberOfNewOrderCrossBitfields, settled4.newOrderCrossBitfield2, settled4.newOrderCrossBitfield4)]]
        settled6 == [settled5 EXCEPT !.symbolLong = IF settled5.numberOfNewOrderCrossBitfields >= 1 /\ (settled5.newOrderCrossBitfield1 # << >> /\ settled5.newOrderCrossBitfield1[1] % 2 > 0) THEN (IF settled5.symbolLong = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled5.symbolLong) ELSE << >>]
        settled7 == [settled6 EXCEPT !.maturityDate = IF settled6.numberOfNewOrderCrossBitfields >= 1 /\ (settled6.newOrderCrossBitfield1 # << >> /\ (settled6.newOrderCrossBitfield1[1] \div 2) % 2 > 0) THEN (IF settled6.maturityDate = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled6.maturityDate) ELSE << >>]
        settled8 == [settled7 EXCEPT !.strikePrice = IF settled7.numberOfNewOrderCrossBitfields >= 1 /\ (settled7.newOrderCrossBitfield1 # << >> /\ (settled7.newOrderCrossBitfield1[1] \div 4) % 2 > 0) THEN (IF settled7.strikePrice = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled7.strikePrice) ELSE << >>]
        settled9 == [settled8 EXCEPT !.putOrCall = IF settled8.numberOfNewOrderCrossBitfields >= 1 /\ (settled8.newOrderCrossBitfield1 # << >> /\ (settled8.newOrderCrossBitfield1[1] \div 8) % 2 > 0) THEN (IF settled8.putOrCall = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled8.putOrCall) ELSE << >>]
        settled10 == [settled9 EXCEPT !.execInst = IF settled9.numberOfNewOrderCrossBitfields >= 1 /\ (settled9.newOrderCrossBitfield1 # << >> /\ (settled9.newOrderCrossBitfield1[1] \div 16) % 2 > 0) THEN (IF settled9.execInst = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled9.execInst) ELSE << >>]
        settled11 == [settled10 EXCEPT !.attributedQuote = IF settled10.numberOfNewOrderCrossBitfields >= 1 /\ (settled10.newOrderCrossBitfield1 # << >> /\ (settled10.newOrderCrossBitfield1[1] \div 32) % 2 > 0) THEN (IF settled10.attributedQuote = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled10.attributedQuote) ELSE << >>]
        settled12 == [settled11 EXCEPT !.targetPartyId = IF settled11.numberOfNewOrderCrossBitfields >= 1 /\ (settled11.newOrderCrossBitfield1 # << >> /\ (settled11.newOrderCrossBitfield1[1] \div 64) % 2 > 0) THEN (IF settled11.targetPartyId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled11.targetPartyId) ELSE << >>]
        settled13 == [settled12 EXCEPT !.preventMatch = IF settled12.numberOfNewOrderCrossBitfields >= 1 /\ (settled12.newOrderCrossBitfield1 # << >> /\ (settled12.newOrderCrossBitfield1[1] \div 128) % 2 > 0) THEN (IF settled12.preventMatch = << >> THEN <<[i \in 1 .. 3 |-> 0]>> ELSE settled12.preventMatch) ELSE << >>]
        settled14 == [settled13 EXCEPT !.autoMatch = IF settled13.numberOfNewOrderCrossBitfields >= 2 /\ (settled13.newOrderCrossBitfield2 # << >> /\ settled13.newOrderCrossBitfield2[1] % 2 > 0) THEN (IF settled13.autoMatch = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled13.autoMatch) ELSE << >>]
        settled15 == [settled14 EXCEPT !.autoMatchPrice = IF settled14.numberOfNewOrderCrossBitfields >= 2 /\ (settled14.newOrderCrossBitfield2 # << >> /\ (settled14.newOrderCrossBitfield2[1] \div 2) % 2 > 0) THEN (IF settled14.autoMatchPrice = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled14.autoMatchPrice) ELSE << >>]
        settled16 == [settled15 EXCEPT !.lastPriority = IF settled15.numberOfNewOrderCrossBitfields >= 2 /\ (settled15.newOrderCrossBitfield2 # << >> /\ (settled15.newOrderCrossBitfield2[1] \div 4) % 2 > 0) THEN (IF settled15.lastPriority = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled15.lastPriority) ELSE << >>]
        settled17 == [settled16 EXCEPT !.routingFirmId = IF settled16.numberOfNewOrderCrossBitfields >= 2 /\ (settled16.newOrderCrossBitfield2 # << >> /\ (settled16.newOrderCrossBitfield2[1] \div 64) % 2 > 0) THEN (IF settled16.routingFirmId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled16.routingFirmId) ELSE << >>]
        settled18 == [settled17 EXCEPT !.clientIdAttr = IF settled17.numberOfNewOrderCrossBitfields >= 3 /\ (settled17.newOrderCrossBitfield3 # << >> /\ settled17.newOrderCrossBitfield3[1] % 2 > 0) THEN (IF settled17.clientIdAttr = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled17.clientIdAttr) ELSE << >>]
        settled19 == [settled18 EXCEPT !.equityTradePrice = IF settled18.numberOfNewOrderCrossBitfields >= 3 /\ (settled18.newOrderCrossBitfield3 # << >> /\ (settled18.newOrderCrossBitfield3[1] \div 2) % 2 > 0) THEN (IF settled18.equityTradePrice = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled18.equityTradePrice) ELSE << >>]
        settled20 == [settled19 EXCEPT !.equityTradeSize = IF settled19.numberOfNewOrderCrossBitfields >= 3 /\ (settled19.newOrderCrossBitfield3 # << >> /\ (settled19.newOrderCrossBitfield3[1] \div 4) % 2 > 0) THEN (IF settled19.equityTradeSize = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled19.equityTradeSize) ELSE << >>]
        settled21 == [settled20 EXCEPT !.equityTradeVenue = IF settled20.numberOfNewOrderCrossBitfields >= 3 /\ (settled20.newOrderCrossBitfield3 # << >> /\ (settled20.newOrderCrossBitfield3[1] \div 8) % 2 > 0) THEN (IF settled20.equityTradeVenue = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled20.equityTradeVenue) ELSE << >>]
        settled22 == [settled21 EXCEPT !.equityTransactTime = IF settled21.numberOfNewOrderCrossBitfields >= 3 /\ (settled21.newOrderCrossBitfield3 # << >> /\ (settled21.newOrderCrossBitfield3[1] \div 16) % 2 > 0) THEN (IF settled21.equityTransactTime = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled21.equityTransactTime) ELSE << >>]
        settled23 == [settled22 EXCEPT !.equityBuyClearingFirm = IF settled22.numberOfNewOrderCrossBitfields >= 3 /\ (settled22.newOrderCrossBitfield3 # << >> /\ (settled22.newOrderCrossBitfield3[1] \div 32) % 2 > 0) THEN (IF settled22.equityBuyClearingFirm = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled22.equityBuyClearingFirm) ELSE << >>]
        settled24 == [settled23 EXCEPT !.equitySellClearingFirm = IF settled23.numberOfNewOrderCrossBitfields >= 3 /\ (settled23.newOrderCrossBitfield3 # << >> /\ (settled23.newOrderCrossBitfield3[1] \div 64) % 2 > 0) THEN (IF settled23.equitySellClearingFirm = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled23.equitySellClearingFirm) ELSE << >>]
        settled25 == [settled24 EXCEPT !.sessionEligibility = IF settled24.numberOfNewOrderCrossBitfields >= 3 /\ (settled24.newOrderCrossBitfield3 # << >> /\ (settled24.newOrderCrossBitfield3[1] \div 128) % 2 > 0) THEN (IF settled24.sessionEligibility = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled24.sessionEligibility) ELSE << >>]
        settled26 == [settled25 EXCEPT !.compression = IF settled25.numberOfNewOrderCrossBitfields >= 4 /\ (settled25.newOrderCrossBitfield4 # << >> /\ settled25.newOrderCrossBitfield4[1] % 2 > 0) THEN (IF settled25.compression = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled25.compression) ELSE << >>]
        settled27 == [settled26 EXCEPT !.ors = IF settled26.numberOfNewOrderCrossBitfields >= 4 /\ (settled26.newOrderCrossBitfield4 # << >> /\ (settled26.newOrderCrossBitfield4[1] \div 2) % 2 > 0) THEN (IF settled26.ors = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled26.ors) ELSE << >>]
    IN  settled27

ZeroNewOrderCrossMessage ==
    SettleNewOrderCrossMessage([ crossId                        |-> [i \in 1 .. 20 |-> 0],
                                 crossType                      |-> [i \in 1 .. 1 |-> 0],
                                 crossPrioritization            |-> [i \in 1 .. 1 |-> 0],
                                 priceLong                      |-> [i \in 1 .. 8 |-> 0],
                                 orderQtyLong                   |-> [i \in 1 .. 4 |-> 0],
                                 numberOfNewOrderCrossBitfields |-> 0,
                                 newOrderCrossBitfield1         |-> << >>,
                                 newOrderCrossBitfield2         |-> << >>,
                                 newOrderCrossBitfield3         |-> << >>,
                                 newOrderCrossBitfield4         |-> << >>,
                                 orderAllocations               |-> << >>,
                                 symbolLong                     |-> << >>,
                                 maturityDate                   |-> << >>,
                                 strikePrice                    |-> << >>,
                                 putOrCall                      |-> << >>,
                                 execInst                       |-> << >>,
                                 attributedQuote                |-> << >>,
                                 targetPartyId                  |-> << >>,
                                 preventMatch                   |-> << >>,
                                 autoMatch                      |-> << >>,
                                 autoMatchPrice                 |-> << >>,
                                 lastPriority                   |-> << >>,
                                 routingFirmId                  |-> << >>,
                                 clientIdAttr                   |-> << >>,
                                 equityTradePrice               |-> << >>,
                                 equityTradeSize                |-> << >>,
                                 equityTradeVenue               |-> << >>,
                                 equityTransactTime             |-> << >>,
                                 equityBuyClearingFirm          |-> << >>,
                                 equitySellClearingFirm         |-> << >>,
                                 sessionEligibility             |-> << >>,
                                 compression                    |-> << >>,
                                 ors                            |-> << >> ])

(* New Order Cross Message at zero, then each field in turn at the values it is checked at *)
CheckedNewOrderCrossMessage ==
    { ZeroNewOrderCrossMessage }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.crossId = one]) : one \in Sample(20) }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.crossType = one]) : one \in Sample(1) }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.crossPrioritization = one]) : one \in Sample(1) }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.priceLong = one]) : one \in Sample(8) }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.orderQtyLong = one]) : one \in Sample(4) }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = one]) : one \in {0, 1, 255} }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 1, !.newOrderCrossBitfield1 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 2, !.newOrderCrossBitfield2 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 3, !.newOrderCrossBitfield3 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 4, !.newOrderCrossBitfield4 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.orderAllocations = one]) : one \in SampleLists(OneOrderAllocations) }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 2, !.newOrderCrossBitfield2 = <<8>>, !.orderAllocations = one]) : one \in SampleLists(OneOrderAllocations) }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 2, !.newOrderCrossBitfield2 = <<16>>, !.orderAllocations = one]) : one \in SampleLists(OneOrderAllocations) }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 2, !.newOrderCrossBitfield2 = <<32>>, !.orderAllocations = one]) : one \in SampleLists(OneOrderAllocations) }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 2, !.newOrderCrossBitfield2 = <<128>>, !.orderAllocations = one]) : one \in SampleLists(OneOrderAllocations) }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 4, !.newOrderCrossBitfield4 = <<4>>, !.orderAllocations = one]) : one \in SampleLists(OneOrderAllocations) }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 1, !.newOrderCrossBitfield1 = <<1>>, !.symbolLong = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 1, !.newOrderCrossBitfield1 = <<2>>, !.maturityDate = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 1, !.newOrderCrossBitfield1 = <<4>>, !.strikePrice = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 1, !.newOrderCrossBitfield1 = <<8>>, !.putOrCall = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 1, !.newOrderCrossBitfield1 = <<16>>, !.execInst = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 1, !.newOrderCrossBitfield1 = <<32>>, !.attributedQuote = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 1, !.newOrderCrossBitfield1 = <<64>>, !.targetPartyId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 1, !.newOrderCrossBitfield1 = <<128>>, !.preventMatch = one]) : one \in { <<held>> : held \in Sample(3) } }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 2, !.newOrderCrossBitfield2 = <<1>>, !.autoMatch = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 2, !.newOrderCrossBitfield2 = <<2>>, !.autoMatchPrice = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 2, !.newOrderCrossBitfield2 = <<4>>, !.lastPriority = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 2, !.newOrderCrossBitfield2 = <<64>>, !.routingFirmId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 3, !.newOrderCrossBitfield3 = <<1>>, !.clientIdAttr = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 3, !.newOrderCrossBitfield3 = <<2>>, !.equityTradePrice = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 3, !.newOrderCrossBitfield3 = <<4>>, !.equityTradeSize = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 3, !.newOrderCrossBitfield3 = <<8>>, !.equityTradeVenue = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 3, !.newOrderCrossBitfield3 = <<16>>, !.equityTransactTime = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 3, !.newOrderCrossBitfield3 = <<32>>, !.equityBuyClearingFirm = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 3, !.newOrderCrossBitfield3 = <<64>>, !.equitySellClearingFirm = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 3, !.newOrderCrossBitfield3 = <<128>>, !.sessionEligibility = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 4, !.newOrderCrossBitfield4 = <<1>>, !.compression = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 4, !.newOrderCrossBitfield4 = <<2>>, !.ors = one]) : one \in { <<held>> : held \in Sample(1) } }

(***************************************************************************)
(* Complex Leg Order Info: 1 bytes                                         *)
(***************************************************************************)

ComplexLegOrderInfo ==
    [ legPositionEffect : Sample(1) ]

EncodeComplexLegOrderInfo(message) ==
    message.legPositionEffect

DecodeComplexLegOrderInfo(bytes) ==
    LET legPositionEffect == ReadBytes(bytes, 1) IN IF ~legPositionEffect.ok THEN Fail ELSE
    Ok([ legPositionEffect |-> legPositionEffect.value ], legPositionEffect.rest)

ZeroComplexLegOrderInfo ==
    [ legPositionEffect |-> [i \in 1 .. 1 |-> 0] ]

(* Complex Leg Order Info at zero, then each field in turn at the values it is checked at *)
CheckedComplexLegOrderInfo ==
    { ZeroComplexLegOrderInfo }
        \cup { [ZeroComplexLegOrderInfo EXCEPT !.legPositionEffect = one] : one \in Sample(1) }

(* A run of Complex Leg Order Info, written one after another *)
RECURSIVE EncodeComplexLegOrderInfoList(_)
EncodeComplexLegOrderInfoList(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeComplexLegOrderInfo(Head(messages)) \o EncodeComplexLegOrderInfoList(Tail(messages))

(* As many Complex Leg Order Info as the field that counts them says *)
RECURSIVE ReadComplexLegOrderInfoList(_, _)
ReadComplexLegOrderInfoList(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeComplexLegOrderInfo(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadComplexLegOrderInfoList(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Complex Leg Order Info of each kind, for the lists that carry them *)
OneComplexLegOrderInfo == { ZeroComplexLegOrderInfo }

(***************************************************************************)
(* New Complex Order Message                                               *)
(***************************************************************************)

NewComplexOrderMessage ==
    [ clOrdId                          : Sample(20),
      side                             : Sample(1),
      orderQtyLong                     : Sample(4),
      numberOfNewComplexOrderBitfields : 0 .. 255,
      newComplexOrderBitfield1         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      newComplexOrderBitfield2         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      newComplexOrderBitfield3         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      newComplexOrderBitfield4         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      newComplexOrderBitfield5         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      newComplexOrderBitfield6         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      newComplexOrderBitfield7         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      newComplexOrderBitfield8         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      newComplexOrderBitfield9         : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexLegOrderInfo              : SampleLists(OneComplexLegOrderInfo),
      clearingFirm                     : { << >> } \cup { <<held>> : held \in Sample(4) },
      clearingAccount                  : { << >> } \cup { <<held>> : held \in Sample(4) },
      priceLong                        : { << >> } \cup { <<held>> : held \in Sample(8) },
      ordType                          : { << >> } \cup { <<held>> : held \in Sample(1) },
      timeInForce                      : { << >> } \cup { <<held>> : held \in Sample(1) },
      symbolLong                       : { << >> } \cup { <<held>> : held \in Sample(8) },
      capacity                         : { << >> } \cup { <<held>> : held \in Sample(1) },
      routingInst                      : { << >> } \cup { <<held>> : held \in Sample(4) },
      account                          : { << >> } \cup { <<held>> : held \in Sample(16) },
      preventMatch                     : { << >> } \cup { <<held>> : held \in Sample(3) },
      expireTime                       : { << >> } \cup { <<held>> : held \in Sample(8) },
      cmtaNumber                       : { << >> } \cup { <<held>> : held \in Sample(4) },
      targetPartyId                    : { << >> } \cup { <<held>> : held \in Sample(4) },
      attributedQuote                  : { << >> } \cup { <<held>> : held \in Sample(1) },
      echoText                         : { << >> } \cup { <<held>> : held \in Sample(64) },
      auctionId                        : { << >> } \cup { <<held>> : held \in Sample(8) },
      routingFirmId                    : { << >> } \cup { <<held>> : held \in Sample(4) },
      drillThruProtection              : { << >> } \cup { <<held>> : held \in Sample(8) },
      riskReset                        : { << >> } \cup { <<held>> : held \in Sample(8) },
      customGroupId                    : { << >> } \cup { <<held>> : held \in Sample(2) },
      equityPartyId                    : { << >> } \cup { <<held>> : held \in Sample(4) },
      clearingOptionalData             : { << >> } \cup { <<held>> : held \in Sample(16) },
      clientIdAttr                     : { << >> } \cup { <<held>> : held \in Sample(4) },
      frequentTraderId                 : { << >> } \cup { <<held>> : held \in Sample(6) },
      sessionEligibility               : { << >> } \cup { <<held>> : held \in Sample(1) },
      maxFloor                         : { << >> } \cup { <<held>> : held \in Sample(4) },
      displayRange                     : { << >> } \cup { <<held>> : held \in Sample(4) },
      comboOrder                       : { << >> } \cup { <<held>> : held \in Sample(1) },
      compression                      : { << >> } \cup { <<held>> : held \in Sample(1) },
      equityExDestination              : { << >> } \cup { <<held>> : held \in Sample(1) },
      equityLegShortSell               : { << >> } \cup { <<held>> : held \in Sample(1) },
      floorDestination                 : { << >> } \cup { <<held>> : held \in Sample(4) },
      floorRoutingInst                 : { << >> } \cup { <<held>> : held \in Sample(1) },
      multiClassSprd                   : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderOrigin                      : { << >> } \cup { <<held>> : held \in Sample(3) },
      ors                              : { << >> } \cup { <<held>> : held \in Sample(1) },
      priceType                        : { << >> } \cup { <<held>> : held \in Sample(1) },
      strategyId                       : { << >> } \cup { <<held>> : held \in Sample(1) },
      execInst                         : { << >> } \cup { <<held>> : held \in Sample(1) },
      tiedHedge                        : { << >> } \cup { <<held>> : held \in Sample(1) },
      held                             : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossInitiator                   : { << >> } \cup { <<held>> : held \in Sample(4) },
      crossOnBehalfOfId                : { << >> } \cup { <<held>> : held \in Sample(4) },
      stopPx                           : { << >> } \cup { <<held>> : held \in Sample(8) },
      stopPxType                       : { << >> } \cup { <<held>> : held \in Sample(1) } ]

EncodeNewComplexOrderMessage(message) ==
    message.clOrdId
        \o message.side
        \o message.orderQtyLong
        \o EncodeUIntBE(message.numberOfNewComplexOrderBitfields, 1)
        \o (IF message.newComplexOrderBitfield1 = << >> THEN << >> ELSE EncodeUIntLE(message.newComplexOrderBitfield1[1], 1))
        \o (IF message.newComplexOrderBitfield2 = << >> THEN << >> ELSE EncodeUIntLE(message.newComplexOrderBitfield2[1], 1))
        \o (IF message.newComplexOrderBitfield3 = << >> THEN << >> ELSE EncodeUIntLE(message.newComplexOrderBitfield3[1], 1))
        \o (IF message.newComplexOrderBitfield4 = << >> THEN << >> ELSE EncodeUIntLE(message.newComplexOrderBitfield4[1], 1))
        \o (IF message.newComplexOrderBitfield5 = << >> THEN << >> ELSE EncodeUIntLE(message.newComplexOrderBitfield5[1], 1))
        \o (IF message.newComplexOrderBitfield6 = << >> THEN << >> ELSE EncodeUIntLE(message.newComplexOrderBitfield6[1], 1))
        \o (IF message.newComplexOrderBitfield7 = << >> THEN << >> ELSE EncodeUIntLE(message.newComplexOrderBitfield7[1], 1))
        \o (IF message.newComplexOrderBitfield8 = << >> THEN << >> ELSE EncodeUIntLE(message.newComplexOrderBitfield8[1], 1))
        \o (IF message.newComplexOrderBitfield9 = << >> THEN << >> ELSE message.newComplexOrderBitfield9[1])
        \o EncodeUIntBE(Len(message.complexLegOrderInfo), 1)
        \o EncodeComplexLegOrderInfoList(message.complexLegOrderInfo)
        \o (IF message.clearingFirm = << >> THEN << >> ELSE message.clearingFirm[1])
        \o (IF message.clearingAccount = << >> THEN << >> ELSE message.clearingAccount[1])
        \o (IF message.priceLong = << >> THEN << >> ELSE message.priceLong[1])
        \o (IF message.ordType = << >> THEN << >> ELSE message.ordType[1])
        \o (IF message.timeInForce = << >> THEN << >> ELSE message.timeInForce[1])
        \o (IF message.symbolLong = << >> THEN << >> ELSE message.symbolLong[1])
        \o (IF message.capacity = << >> THEN << >> ELSE message.capacity[1])
        \o (IF message.routingInst = << >> THEN << >> ELSE message.routingInst[1])
        \o (IF message.account = << >> THEN << >> ELSE message.account[1])
        \o (IF message.preventMatch = << >> THEN << >> ELSE message.preventMatch[1])
        \o (IF message.expireTime = << >> THEN << >> ELSE message.expireTime[1])
        \o (IF message.cmtaNumber = << >> THEN << >> ELSE message.cmtaNumber[1])
        \o (IF message.targetPartyId = << >> THEN << >> ELSE message.targetPartyId[1])
        \o (IF message.attributedQuote = << >> THEN << >> ELSE message.attributedQuote[1])
        \o (IF message.echoText = << >> THEN << >> ELSE message.echoText[1])
        \o (IF message.auctionId = << >> THEN << >> ELSE message.auctionId[1])
        \o (IF message.routingFirmId = << >> THEN << >> ELSE message.routingFirmId[1])
        \o (IF message.drillThruProtection = << >> THEN << >> ELSE message.drillThruProtection[1])
        \o (IF message.riskReset = << >> THEN << >> ELSE message.riskReset[1])
        \o (IF message.customGroupId = << >> THEN << >> ELSE message.customGroupId[1])
        \o (IF message.equityPartyId = << >> THEN << >> ELSE message.equityPartyId[1])
        \o (IF message.clearingOptionalData = << >> THEN << >> ELSE message.clearingOptionalData[1])
        \o (IF message.clientIdAttr = << >> THEN << >> ELSE message.clientIdAttr[1])
        \o (IF message.frequentTraderId = << >> THEN << >> ELSE message.frequentTraderId[1])
        \o (IF message.sessionEligibility = << >> THEN << >> ELSE message.sessionEligibility[1])
        \o (IF message.maxFloor = << >> THEN << >> ELSE message.maxFloor[1])
        \o (IF message.displayRange = << >> THEN << >> ELSE message.displayRange[1])
        \o (IF message.comboOrder = << >> THEN << >> ELSE message.comboOrder[1])
        \o (IF message.compression = << >> THEN << >> ELSE message.compression[1])
        \o (IF message.equityExDestination = << >> THEN << >> ELSE message.equityExDestination[1])
        \o (IF message.equityLegShortSell = << >> THEN << >> ELSE message.equityLegShortSell[1])
        \o (IF message.floorDestination = << >> THEN << >> ELSE message.floorDestination[1])
        \o (IF message.floorRoutingInst = << >> THEN << >> ELSE message.floorRoutingInst[1])
        \o (IF message.multiClassSprd = << >> THEN << >> ELSE message.multiClassSprd[1])
        \o (IF message.orderOrigin = << >> THEN << >> ELSE message.orderOrigin[1])
        \o (IF message.ors = << >> THEN << >> ELSE message.ors[1])
        \o (IF message.priceType = << >> THEN << >> ELSE message.priceType[1])
        \o (IF message.strategyId = << >> THEN << >> ELSE message.strategyId[1])
        \o (IF message.execInst = << >> THEN << >> ELSE message.execInst[1])
        \o (IF message.tiedHedge = << >> THEN << >> ELSE message.tiedHedge[1])
        \o (IF message.held = << >> THEN << >> ELSE message.held[1])
        \o (IF message.crossInitiator = << >> THEN << >> ELSE message.crossInitiator[1])
        \o (IF message.crossOnBehalfOfId = << >> THEN << >> ELSE message.crossOnBehalfOfId[1])
        \o (IF message.stopPx = << >> THEN << >> ELSE message.stopPx[1])
        \o (IF message.stopPxType = << >> THEN << >> ELSE message.stopPxType[1])

DecodeNewComplexOrderMessage(bytes) ==
    LET clOrdId == ReadBytes(bytes, 20) IN IF ~clOrdId.ok THEN Fail ELSE
    LET side == ReadBytes(clOrdId.rest, 1) IN IF ~side.ok THEN Fail ELSE
    LET orderQtyLong == ReadBytes(side.rest, 4) IN IF ~orderQtyLong.ok THEN Fail ELSE
    LET numberOfNewComplexOrderBitfields == ReadUIntBE(orderQtyLong.rest, 1) IN IF ~numberOfNewComplexOrderBitfields.ok THEN Fail ELSE
    LET newComplexOrderBitfield1 == ReadWhen(numberOfNewComplexOrderBitfields.value >= 1, ReadUIntLE(numberOfNewComplexOrderBitfields.rest, 1), numberOfNewComplexOrderBitfields.rest) IN IF ~newComplexOrderBitfield1.ok THEN Fail ELSE
    LET newComplexOrderBitfield2 == ReadWhen(numberOfNewComplexOrderBitfields.value >= 2, ReadUIntLE(newComplexOrderBitfield1.rest, 1), newComplexOrderBitfield1.rest) IN IF ~newComplexOrderBitfield2.ok THEN Fail ELSE
    LET newComplexOrderBitfield3 == ReadWhen(numberOfNewComplexOrderBitfields.value >= 3, ReadUIntLE(newComplexOrderBitfield2.rest, 1), newComplexOrderBitfield2.rest) IN IF ~newComplexOrderBitfield3.ok THEN Fail ELSE
    LET newComplexOrderBitfield4 == ReadWhen(numberOfNewComplexOrderBitfields.value >= 4, ReadUIntLE(newComplexOrderBitfield3.rest, 1), newComplexOrderBitfield3.rest) IN IF ~newComplexOrderBitfield4.ok THEN Fail ELSE
    LET newComplexOrderBitfield5 == ReadWhen(numberOfNewComplexOrderBitfields.value >= 5, ReadUIntLE(newComplexOrderBitfield4.rest, 1), newComplexOrderBitfield4.rest) IN IF ~newComplexOrderBitfield5.ok THEN Fail ELSE
    LET newComplexOrderBitfield6 == ReadWhen(numberOfNewComplexOrderBitfields.value >= 6, ReadUIntLE(newComplexOrderBitfield5.rest, 1), newComplexOrderBitfield5.rest) IN IF ~newComplexOrderBitfield6.ok THEN Fail ELSE
    LET newComplexOrderBitfield7 == ReadWhen(numberOfNewComplexOrderBitfields.value >= 7, ReadUIntLE(newComplexOrderBitfield6.rest, 1), newComplexOrderBitfield6.rest) IN IF ~newComplexOrderBitfield7.ok THEN Fail ELSE
    LET newComplexOrderBitfield8 == ReadWhen(numberOfNewComplexOrderBitfields.value >= 8, ReadUIntLE(newComplexOrderBitfield7.rest, 1), newComplexOrderBitfield7.rest) IN IF ~newComplexOrderBitfield8.ok THEN Fail ELSE
    LET newComplexOrderBitfield9 == ReadWhen(numberOfNewComplexOrderBitfields.value >= 9, ReadBytes(newComplexOrderBitfield8.rest, 1), newComplexOrderBitfield8.rest) IN IF ~newComplexOrderBitfield9.ok THEN Fail ELSE
    LET noLegs == ReadUIntBE(newComplexOrderBitfield9.rest, 1) IN IF ~noLegs.ok THEN Fail ELSE
    LET complexLegOrderInfo == ReadComplexLegOrderInfoList(noLegs.rest, noLegs.value) IN IF ~complexLegOrderInfo.ok THEN Fail ELSE
    LET clearingFirm == ReadWhen(numberOfNewComplexOrderBitfields.value >= 1 /\ (newComplexOrderBitfield1.value # << >> /\ newComplexOrderBitfield1.value[1] % 2 > 0), ReadBytes(complexLegOrderInfo.rest, 4), complexLegOrderInfo.rest) IN IF ~clearingFirm.ok THEN Fail ELSE
    LET clearingAccount == ReadWhen(numberOfNewComplexOrderBitfields.value >= 1 /\ (newComplexOrderBitfield1.value # << >> /\ (newComplexOrderBitfield1.value[1] \div 2) % 2 > 0), ReadBytes(clearingFirm.rest, 4), clearingFirm.rest) IN IF ~clearingAccount.ok THEN Fail ELSE
    LET priceLong == ReadWhen(numberOfNewComplexOrderBitfields.value >= 1 /\ (newComplexOrderBitfield1.value # << >> /\ (newComplexOrderBitfield1.value[1] \div 4) % 2 > 0), ReadBytes(clearingAccount.rest, 8), clearingAccount.rest) IN IF ~priceLong.ok THEN Fail ELSE
    LET ordType == ReadWhen(numberOfNewComplexOrderBitfields.value >= 1 /\ (newComplexOrderBitfield1.value # << >> /\ (newComplexOrderBitfield1.value[1] \div 8) % 2 > 0), ReadBytes(priceLong.rest, 1), priceLong.rest) IN IF ~ordType.ok THEN Fail ELSE
    LET timeInForce == ReadWhen(numberOfNewComplexOrderBitfields.value >= 1 /\ (newComplexOrderBitfield1.value # << >> /\ (newComplexOrderBitfield1.value[1] \div 16) % 2 > 0), ReadBytes(ordType.rest, 1), ordType.rest) IN IF ~timeInForce.ok THEN Fail ELSE
    LET symbolLong == ReadWhen(numberOfNewComplexOrderBitfields.value >= 1 /\ (newComplexOrderBitfield1.value # << >> /\ (newComplexOrderBitfield1.value[1] \div 32) % 2 > 0), ReadBytes(timeInForce.rest, 8), timeInForce.rest) IN IF ~symbolLong.ok THEN Fail ELSE
    LET capacity == ReadWhen(numberOfNewComplexOrderBitfields.value >= 1 /\ (newComplexOrderBitfield1.value # << >> /\ (newComplexOrderBitfield1.value[1] \div 64) % 2 > 0), ReadBytes(symbolLong.rest, 1), symbolLong.rest) IN IF ~capacity.ok THEN Fail ELSE
    LET routingInst == ReadWhen(numberOfNewComplexOrderBitfields.value >= 1 /\ (newComplexOrderBitfield1.value # << >> /\ (newComplexOrderBitfield1.value[1] \div 128) % 2 > 0), ReadBytes(capacity.rest, 4), capacity.rest) IN IF ~routingInst.ok THEN Fail ELSE
    LET account == ReadWhen(numberOfNewComplexOrderBitfields.value >= 2 /\ (newComplexOrderBitfield2.value # << >> /\ newComplexOrderBitfield2.value[1] % 2 > 0), ReadBytes(routingInst.rest, 16), routingInst.rest) IN IF ~account.ok THEN Fail ELSE
    LET preventMatch == ReadWhen(numberOfNewComplexOrderBitfields.value >= 2 /\ (newComplexOrderBitfield2.value # << >> /\ (newComplexOrderBitfield2.value[1] \div 2) % 2 > 0), ReadBytes(account.rest, 3), account.rest) IN IF ~preventMatch.ok THEN Fail ELSE
    LET expireTime == ReadWhen(numberOfNewComplexOrderBitfields.value >= 2 /\ (newComplexOrderBitfield2.value # << >> /\ (newComplexOrderBitfield2.value[1] \div 4) % 2 > 0), ReadBytes(preventMatch.rest, 8), preventMatch.rest) IN IF ~expireTime.ok THEN Fail ELSE
    LET cmtaNumber == ReadWhen(numberOfNewComplexOrderBitfields.value >= 2 /\ (newComplexOrderBitfield2.value # << >> /\ (newComplexOrderBitfield2.value[1] \div 8) % 2 > 0), ReadBytes(expireTime.rest, 4), expireTime.rest) IN IF ~cmtaNumber.ok THEN Fail ELSE
    LET targetPartyId == ReadWhen(numberOfNewComplexOrderBitfields.value >= 2 /\ (newComplexOrderBitfield2.value # << >> /\ (newComplexOrderBitfield2.value[1] \div 16) % 2 > 0), ReadBytes(cmtaNumber.rest, 4), cmtaNumber.rest) IN IF ~targetPartyId.ok THEN Fail ELSE
    LET attributedQuote == ReadWhen(numberOfNewComplexOrderBitfields.value >= 2 /\ (newComplexOrderBitfield2.value # << >> /\ (newComplexOrderBitfield2.value[1] \div 32) % 2 > 0), ReadBytes(targetPartyId.rest, 1), targetPartyId.rest) IN IF ~attributedQuote.ok THEN Fail ELSE
    LET echoText == ReadWhen(numberOfNewComplexOrderBitfields.value >= 2 /\ (newComplexOrderBitfield2.value # << >> /\ (newComplexOrderBitfield2.value[1] \div 64) % 2 > 0), ReadBytes(attributedQuote.rest, 64), attributedQuote.rest) IN IF ~echoText.ok THEN Fail ELSE
    LET auctionId == ReadWhen(numberOfNewComplexOrderBitfields.value >= 2 /\ (newComplexOrderBitfield2.value # << >> /\ (newComplexOrderBitfield2.value[1] \div 128) % 2 > 0), ReadBytes(echoText.rest, 8), echoText.rest) IN IF ~auctionId.ok THEN Fail ELSE
    LET routingFirmId == ReadWhen(numberOfNewComplexOrderBitfields.value >= 3 /\ (newComplexOrderBitfield3.value # << >> /\ newComplexOrderBitfield3.value[1] % 2 > 0), ReadBytes(auctionId.rest, 4), auctionId.rest) IN IF ~routingFirmId.ok THEN Fail ELSE
    LET drillThruProtection == ReadWhen(numberOfNewComplexOrderBitfields.value >= 3 /\ (newComplexOrderBitfield3.value # << >> /\ (newComplexOrderBitfield3.value[1] \div 2) % 2 > 0), ReadBytes(routingFirmId.rest, 8), routingFirmId.rest) IN IF ~drillThruProtection.ok THEN Fail ELSE
    LET riskReset == ReadWhen(numberOfNewComplexOrderBitfields.value >= 3 /\ (newComplexOrderBitfield3.value # << >> /\ (newComplexOrderBitfield3.value[1] \div 4) % 2 > 0), ReadBytes(drillThruProtection.rest, 8), drillThruProtection.rest) IN IF ~riskReset.ok THEN Fail ELSE
    LET customGroupId == ReadWhen(numberOfNewComplexOrderBitfields.value >= 3 /\ (newComplexOrderBitfield3.value # << >> /\ (newComplexOrderBitfield3.value[1] \div 8) % 2 > 0), ReadBytes(riskReset.rest, 2), riskReset.rest) IN IF ~customGroupId.ok THEN Fail ELSE
    LET equityPartyId == ReadWhen(numberOfNewComplexOrderBitfields.value >= 3 /\ (newComplexOrderBitfield3.value # << >> /\ (newComplexOrderBitfield3.value[1] \div 32) % 2 > 0), ReadBytes(customGroupId.rest, 4), customGroupId.rest) IN IF ~equityPartyId.ok THEN Fail ELSE
    LET clearingOptionalData == ReadWhen(numberOfNewComplexOrderBitfields.value >= 3 /\ (newComplexOrderBitfield3.value # << >> /\ (newComplexOrderBitfield3.value[1] \div 128) % 2 > 0), ReadBytes(equityPartyId.rest, 16), equityPartyId.rest) IN IF ~clearingOptionalData.ok THEN Fail ELSE
    LET clientIdAttr == ReadWhen(numberOfNewComplexOrderBitfields.value >= 4 /\ (newComplexOrderBitfield4.value # << >> /\ newComplexOrderBitfield4.value[1] % 2 > 0), ReadBytes(clearingOptionalData.rest, 4), clearingOptionalData.rest) IN IF ~clientIdAttr.ok THEN Fail ELSE
    LET frequentTraderId == ReadWhen(numberOfNewComplexOrderBitfields.value >= 4 /\ (newComplexOrderBitfield4.value # << >> /\ (newComplexOrderBitfield4.value[1] \div 2) % 2 > 0), ReadBytes(clientIdAttr.rest, 6), clientIdAttr.rest) IN IF ~frequentTraderId.ok THEN Fail ELSE
    LET sessionEligibility == ReadWhen(numberOfNewComplexOrderBitfields.value >= 4 /\ (newComplexOrderBitfield4.value # << >> /\ (newComplexOrderBitfield4.value[1] \div 4) % 2 > 0), ReadBytes(frequentTraderId.rest, 1), frequentTraderId.rest) IN IF ~sessionEligibility.ok THEN Fail ELSE
    LET maxFloor == ReadWhen(numberOfNewComplexOrderBitfields.value >= 4 /\ (newComplexOrderBitfield4.value # << >> /\ (newComplexOrderBitfield4.value[1] \div 8) % 2 > 0), ReadBytes(sessionEligibility.rest, 4), sessionEligibility.rest) IN IF ~maxFloor.ok THEN Fail ELSE
    LET displayRange == ReadWhen(numberOfNewComplexOrderBitfields.value >= 4 /\ (newComplexOrderBitfield4.value # << >> /\ (newComplexOrderBitfield4.value[1] \div 16) % 2 > 0), ReadBytes(maxFloor.rest, 4), maxFloor.rest) IN IF ~displayRange.ok THEN Fail ELSE
    LET comboOrder == ReadWhen(numberOfNewComplexOrderBitfields.value >= 4 /\ (newComplexOrderBitfield4.value # << >> /\ (newComplexOrderBitfield4.value[1] \div 32) % 2 > 0), ReadBytes(displayRange.rest, 1), displayRange.rest) IN IF ~comboOrder.ok THEN Fail ELSE
    LET compression == ReadWhen(numberOfNewComplexOrderBitfields.value >= 4 /\ (newComplexOrderBitfield4.value # << >> /\ (newComplexOrderBitfield4.value[1] \div 64) % 2 > 0), ReadBytes(comboOrder.rest, 1), comboOrder.rest) IN IF ~compression.ok THEN Fail ELSE
    LET equityExDestination == ReadWhen(numberOfNewComplexOrderBitfields.value >= 4 /\ (newComplexOrderBitfield4.value # << >> /\ (newComplexOrderBitfield4.value[1] \div 128) % 2 > 0), ReadBytes(compression.rest, 1), compression.rest) IN IF ~equityExDestination.ok THEN Fail ELSE
    LET equityLegShortSell == ReadWhen(numberOfNewComplexOrderBitfields.value >= 5 /\ (newComplexOrderBitfield5.value # << >> /\ newComplexOrderBitfield5.value[1] % 2 > 0), ReadBytes(equityExDestination.rest, 1), equityExDestination.rest) IN IF ~equityLegShortSell.ok THEN Fail ELSE
    LET floorDestination == ReadWhen(numberOfNewComplexOrderBitfields.value >= 5 /\ (newComplexOrderBitfield5.value # << >> /\ (newComplexOrderBitfield5.value[1] \div 2) % 2 > 0), ReadBytes(equityLegShortSell.rest, 4), equityLegShortSell.rest) IN IF ~floorDestination.ok THEN Fail ELSE
    LET floorRoutingInst == ReadWhen(numberOfNewComplexOrderBitfields.value >= 5 /\ (newComplexOrderBitfield5.value # << >> /\ (newComplexOrderBitfield5.value[1] \div 4) % 2 > 0), ReadBytes(floorDestination.rest, 1), floorDestination.rest) IN IF ~floorRoutingInst.ok THEN Fail ELSE
    LET multiClassSprd == ReadWhen(numberOfNewComplexOrderBitfields.value >= 5 /\ (newComplexOrderBitfield5.value # << >> /\ (newComplexOrderBitfield5.value[1] \div 8) % 2 > 0), ReadBytes(floorRoutingInst.rest, 1), floorRoutingInst.rest) IN IF ~multiClassSprd.ok THEN Fail ELSE
    LET orderOrigin == ReadWhen(numberOfNewComplexOrderBitfields.value >= 5 /\ (newComplexOrderBitfield5.value # << >> /\ (newComplexOrderBitfield5.value[1] \div 16) % 2 > 0), ReadBytes(multiClassSprd.rest, 3), multiClassSprd.rest) IN IF ~orderOrigin.ok THEN Fail ELSE
    LET ors == ReadWhen(numberOfNewComplexOrderBitfields.value >= 5 /\ (newComplexOrderBitfield5.value # << >> /\ (newComplexOrderBitfield5.value[1] \div 32) % 2 > 0), ReadBytes(orderOrigin.rest, 1), orderOrigin.rest) IN IF ~ors.ok THEN Fail ELSE
    LET priceType == ReadWhen(numberOfNewComplexOrderBitfields.value >= 5 /\ (newComplexOrderBitfield5.value # << >> /\ (newComplexOrderBitfield5.value[1] \div 64) % 2 > 0), ReadBytes(ors.rest, 1), ors.rest) IN IF ~priceType.ok THEN Fail ELSE
    LET strategyId == ReadWhen(numberOfNewComplexOrderBitfields.value >= 5 /\ (newComplexOrderBitfield5.value # << >> /\ (newComplexOrderBitfield5.value[1] \div 128) % 2 > 0), ReadBytes(priceType.rest, 1), priceType.rest) IN IF ~strategyId.ok THEN Fail ELSE
    LET execInst == ReadWhen(numberOfNewComplexOrderBitfields.value >= 6 /\ (newComplexOrderBitfield6.value # << >> /\ (newComplexOrderBitfield6.value[1] \div 2) % 2 > 0), ReadBytes(strategyId.rest, 1), strategyId.rest) IN IF ~execInst.ok THEN Fail ELSE
    LET tiedHedge == ReadWhen(numberOfNewComplexOrderBitfields.value >= 6 /\ (newComplexOrderBitfield6.value # << >> /\ (newComplexOrderBitfield6.value[1] \div 4) % 2 > 0), ReadBytes(execInst.rest, 1), execInst.rest) IN IF ~tiedHedge.ok THEN Fail ELSE
    LET held == ReadWhen(numberOfNewComplexOrderBitfields.value >= 7 /\ (newComplexOrderBitfield7.value # << >> /\ (newComplexOrderBitfield7.value[1] \div 128) % 2 > 0), ReadBytes(tiedHedge.rest, 1), tiedHedge.rest) IN IF ~held.ok THEN Fail ELSE
    LET crossInitiator == ReadWhen(numberOfNewComplexOrderBitfields.value >= 8 /\ (newComplexOrderBitfield8.value # << >> /\ (newComplexOrderBitfield8.value[1] \div 2) % 2 > 0), ReadBytes(held.rest, 4), held.rest) IN IF ~crossInitiator.ok THEN Fail ELSE
    LET crossOnBehalfOfId == ReadWhen(numberOfNewComplexOrderBitfields.value >= 8 /\ (newComplexOrderBitfield8.value # << >> /\ (newComplexOrderBitfield8.value[1] \div 4) % 2 > 0), ReadBytes(crossInitiator.rest, 4), crossInitiator.rest) IN IF ~crossOnBehalfOfId.ok THEN Fail ELSE
    LET stopPx == ReadWhen(numberOfNewComplexOrderBitfields.value >= 8 /\ (newComplexOrderBitfield8.value # << >> /\ (newComplexOrderBitfield8.value[1] \div 8) % 2 > 0), ReadBytes(crossOnBehalfOfId.rest, 8), crossOnBehalfOfId.rest) IN IF ~stopPx.ok THEN Fail ELSE
    LET stopPxType == ReadWhen(numberOfNewComplexOrderBitfields.value >= 8 /\ (newComplexOrderBitfield8.value # << >> /\ (newComplexOrderBitfield8.value[1] \div 16) % 2 > 0), ReadBytes(stopPx.rest, 1), stopPx.rest) IN IF ~stopPxType.ok THEN Fail ELSE
    Ok([ clOrdId                          |-> clOrdId.value,
         side                             |-> side.value,
         orderQtyLong                     |-> orderQtyLong.value,
         numberOfNewComplexOrderBitfields |-> numberOfNewComplexOrderBitfields.value,
         newComplexOrderBitfield1         |-> newComplexOrderBitfield1.value,
         newComplexOrderBitfield2         |-> newComplexOrderBitfield2.value,
         newComplexOrderBitfield3         |-> newComplexOrderBitfield3.value,
         newComplexOrderBitfield4         |-> newComplexOrderBitfield4.value,
         newComplexOrderBitfield5         |-> newComplexOrderBitfield5.value,
         newComplexOrderBitfield6         |-> newComplexOrderBitfield6.value,
         newComplexOrderBitfield7         |-> newComplexOrderBitfield7.value,
         newComplexOrderBitfield8         |-> newComplexOrderBitfield8.value,
         newComplexOrderBitfield9         |-> newComplexOrderBitfield9.value,
         complexLegOrderInfo              |-> complexLegOrderInfo.value,
         clearingFirm                     |-> clearingFirm.value,
         clearingAccount                  |-> clearingAccount.value,
         priceLong                        |-> priceLong.value,
         ordType                          |-> ordType.value,
         timeInForce                      |-> timeInForce.value,
         symbolLong                       |-> symbolLong.value,
         capacity                         |-> capacity.value,
         routingInst                      |-> routingInst.value,
         account                          |-> account.value,
         preventMatch                     |-> preventMatch.value,
         expireTime                       |-> expireTime.value,
         cmtaNumber                       |-> cmtaNumber.value,
         targetPartyId                    |-> targetPartyId.value,
         attributedQuote                  |-> attributedQuote.value,
         echoText                         |-> echoText.value,
         auctionId                        |-> auctionId.value,
         routingFirmId                    |-> routingFirmId.value,
         drillThruProtection              |-> drillThruProtection.value,
         riskReset                        |-> riskReset.value,
         customGroupId                    |-> customGroupId.value,
         equityPartyId                    |-> equityPartyId.value,
         clearingOptionalData             |-> clearingOptionalData.value,
         clientIdAttr                     |-> clientIdAttr.value,
         frequentTraderId                 |-> frequentTraderId.value,
         sessionEligibility               |-> sessionEligibility.value,
         maxFloor                         |-> maxFloor.value,
         displayRange                     |-> displayRange.value,
         comboOrder                       |-> comboOrder.value,
         compression                      |-> compression.value,
         equityExDestination              |-> equityExDestination.value,
         equityLegShortSell               |-> equityLegShortSell.value,
         floorDestination                 |-> floorDestination.value,
         floorRoutingInst                 |-> floorRoutingInst.value,
         multiClassSprd                   |-> multiClassSprd.value,
         orderOrigin                      |-> orderOrigin.value,
         ors                              |-> ors.value,
         priceType                        |-> priceType.value,
         strategyId                       |-> strategyId.value,
         execInst                         |-> execInst.value,
         tiedHedge                        |-> tiedHedge.value,
         held                             |-> held.value,
         crossInitiator                   |-> crossInitiator.value,
         crossOnBehalfOfId                |-> crossOnBehalfOfId.value,
         stopPx                           |-> stopPx.value,
         stopPxType                       |-> stopPxType.value ], stopPxType.rest)

(* New Complex Order Message with each field marked present by fields before it there exactly where they say *)
SettleNewComplexOrderMessage(message) ==
    LET settled1 == [message EXCEPT !.newComplexOrderBitfield1 = IF message.numberOfNewComplexOrderBitfields >= 1 THEN (IF message.newComplexOrderBitfield1 = << >> THEN <<0>> ELSE message.newComplexOrderBitfield1) ELSE << >>]
        settled2 == [settled1 EXCEPT !.newComplexOrderBitfield2 = IF settled1.numberOfNewComplexOrderBitfields >= 2 THEN (IF settled1.newComplexOrderBitfield2 = << >> THEN <<0>> ELSE settled1.newComplexOrderBitfield2) ELSE << >>]
        settled3 == [settled2 EXCEPT !.newComplexOrderBitfield3 = IF settled2.numberOfNewComplexOrderBitfields >= 3 THEN (IF settled2.newComplexOrderBitfield3 = << >> THEN <<0>> ELSE settled2.newComplexOrderBitfield3) ELSE << >>]
        settled4 == [settled3 EXCEPT !.newComplexOrderBitfield4 = IF settled3.numberOfNewComplexOrderBitfields >= 4 THEN (IF settled3.newComplexOrderBitfield4 = << >> THEN <<0>> ELSE settled3.newComplexOrderBitfield4) ELSE << >>]
        settled5 == [settled4 EXCEPT !.newComplexOrderBitfield5 = IF settled4.numberOfNewComplexOrderBitfields >= 5 THEN (IF settled4.newComplexOrderBitfield5 = << >> THEN <<0>> ELSE settled4.newComplexOrderBitfield5) ELSE << >>]
        settled6 == [settled5 EXCEPT !.newComplexOrderBitfield6 = IF settled5.numberOfNewComplexOrderBitfields >= 6 THEN (IF settled5.newComplexOrderBitfield6 = << >> THEN <<0>> ELSE settled5.newComplexOrderBitfield6) ELSE << >>]
        settled7 == [settled6 EXCEPT !.newComplexOrderBitfield7 = IF settled6.numberOfNewComplexOrderBitfields >= 7 THEN (IF settled6.newComplexOrderBitfield7 = << >> THEN <<0>> ELSE settled6.newComplexOrderBitfield7) ELSE << >>]
        settled8 == [settled7 EXCEPT !.newComplexOrderBitfield8 = IF settled7.numberOfNewComplexOrderBitfields >= 8 THEN (IF settled7.newComplexOrderBitfield8 = << >> THEN <<0>> ELSE settled7.newComplexOrderBitfield8) ELSE << >>]
        settled9 == [settled8 EXCEPT !.newComplexOrderBitfield9 = IF settled8.numberOfNewComplexOrderBitfields >= 9 THEN (IF settled8.newComplexOrderBitfield9 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled8.newComplexOrderBitfield9) ELSE << >>]
        settled10 == [settled9 EXCEPT !.clearingFirm = IF settled9.numberOfNewComplexOrderBitfields >= 1 /\ (settled9.newComplexOrderBitfield1 # << >> /\ settled9.newComplexOrderBitfield1[1] % 2 > 0) THEN (IF settled9.clearingFirm = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled9.clearingFirm) ELSE << >>]
        settled11 == [settled10 EXCEPT !.clearingAccount = IF settled10.numberOfNewComplexOrderBitfields >= 1 /\ (settled10.newComplexOrderBitfield1 # << >> /\ (settled10.newComplexOrderBitfield1[1] \div 2) % 2 > 0) THEN (IF settled10.clearingAccount = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled10.clearingAccount) ELSE << >>]
        settled12 == [settled11 EXCEPT !.priceLong = IF settled11.numberOfNewComplexOrderBitfields >= 1 /\ (settled11.newComplexOrderBitfield1 # << >> /\ (settled11.newComplexOrderBitfield1[1] \div 4) % 2 > 0) THEN (IF settled11.priceLong = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled11.priceLong) ELSE << >>]
        settled13 == [settled12 EXCEPT !.ordType = IF settled12.numberOfNewComplexOrderBitfields >= 1 /\ (settled12.newComplexOrderBitfield1 # << >> /\ (settled12.newComplexOrderBitfield1[1] \div 8) % 2 > 0) THEN (IF settled12.ordType = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled12.ordType) ELSE << >>]
        settled14 == [settled13 EXCEPT !.timeInForce = IF settled13.numberOfNewComplexOrderBitfields >= 1 /\ (settled13.newComplexOrderBitfield1 # << >> /\ (settled13.newComplexOrderBitfield1[1] \div 16) % 2 > 0) THEN (IF settled13.timeInForce = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled13.timeInForce) ELSE << >>]
        settled15 == [settled14 EXCEPT !.symbolLong = IF settled14.numberOfNewComplexOrderBitfields >= 1 /\ (settled14.newComplexOrderBitfield1 # << >> /\ (settled14.newComplexOrderBitfield1[1] \div 32) % 2 > 0) THEN (IF settled14.symbolLong = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled14.symbolLong) ELSE << >>]
        settled16 == [settled15 EXCEPT !.capacity = IF settled15.numberOfNewComplexOrderBitfields >= 1 /\ (settled15.newComplexOrderBitfield1 # << >> /\ (settled15.newComplexOrderBitfield1[1] \div 64) % 2 > 0) THEN (IF settled15.capacity = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled15.capacity) ELSE << >>]
        settled17 == [settled16 EXCEPT !.routingInst = IF settled16.numberOfNewComplexOrderBitfields >= 1 /\ (settled16.newComplexOrderBitfield1 # << >> /\ (settled16.newComplexOrderBitfield1[1] \div 128) % 2 > 0) THEN (IF settled16.routingInst = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled16.routingInst) ELSE << >>]
        settled18 == [settled17 EXCEPT !.account = IF settled17.numberOfNewComplexOrderBitfields >= 2 /\ (settled17.newComplexOrderBitfield2 # << >> /\ settled17.newComplexOrderBitfield2[1] % 2 > 0) THEN (IF settled17.account = << >> THEN <<[i \in 1 .. 16 |-> 0]>> ELSE settled17.account) ELSE << >>]
        settled19 == [settled18 EXCEPT !.preventMatch = IF settled18.numberOfNewComplexOrderBitfields >= 2 /\ (settled18.newComplexOrderBitfield2 # << >> /\ (settled18.newComplexOrderBitfield2[1] \div 2) % 2 > 0) THEN (IF settled18.preventMatch = << >> THEN <<[i \in 1 .. 3 |-> 0]>> ELSE settled18.preventMatch) ELSE << >>]
        settled20 == [settled19 EXCEPT !.expireTime = IF settled19.numberOfNewComplexOrderBitfields >= 2 /\ (settled19.newComplexOrderBitfield2 # << >> /\ (settled19.newComplexOrderBitfield2[1] \div 4) % 2 > 0) THEN (IF settled19.expireTime = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled19.expireTime) ELSE << >>]
        settled21 == [settled20 EXCEPT !.cmtaNumber = IF settled20.numberOfNewComplexOrderBitfields >= 2 /\ (settled20.newComplexOrderBitfield2 # << >> /\ (settled20.newComplexOrderBitfield2[1] \div 8) % 2 > 0) THEN (IF settled20.cmtaNumber = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled20.cmtaNumber) ELSE << >>]
        settled22 == [settled21 EXCEPT !.targetPartyId = IF settled21.numberOfNewComplexOrderBitfields >= 2 /\ (settled21.newComplexOrderBitfield2 # << >> /\ (settled21.newComplexOrderBitfield2[1] \div 16) % 2 > 0) THEN (IF settled21.targetPartyId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled21.targetPartyId) ELSE << >>]
        settled23 == [settled22 EXCEPT !.attributedQuote = IF settled22.numberOfNewComplexOrderBitfields >= 2 /\ (settled22.newComplexOrderBitfield2 # << >> /\ (settled22.newComplexOrderBitfield2[1] \div 32) % 2 > 0) THEN (IF settled22.attributedQuote = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled22.attributedQuote) ELSE << >>]
        settled24 == [settled23 EXCEPT !.echoText = IF settled23.numberOfNewComplexOrderBitfields >= 2 /\ (settled23.newComplexOrderBitfield2 # << >> /\ (settled23.newComplexOrderBitfield2[1] \div 64) % 2 > 0) THEN (IF settled23.echoText = << >> THEN <<[i \in 1 .. 64 |-> 0]>> ELSE settled23.echoText) ELSE << >>]
        settled25 == [settled24 EXCEPT !.auctionId = IF settled24.numberOfNewComplexOrderBitfields >= 2 /\ (settled24.newComplexOrderBitfield2 # << >> /\ (settled24.newComplexOrderBitfield2[1] \div 128) % 2 > 0) THEN (IF settled24.auctionId = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled24.auctionId) ELSE << >>]
        settled26 == [settled25 EXCEPT !.routingFirmId = IF settled25.numberOfNewComplexOrderBitfields >= 3 /\ (settled25.newComplexOrderBitfield3 # << >> /\ settled25.newComplexOrderBitfield3[1] % 2 > 0) THEN (IF settled25.routingFirmId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled25.routingFirmId) ELSE << >>]
        settled27 == [settled26 EXCEPT !.drillThruProtection = IF settled26.numberOfNewComplexOrderBitfields >= 3 /\ (settled26.newComplexOrderBitfield3 # << >> /\ (settled26.newComplexOrderBitfield3[1] \div 2) % 2 > 0) THEN (IF settled26.drillThruProtection = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled26.drillThruProtection) ELSE << >>]
        settled28 == [settled27 EXCEPT !.riskReset = IF settled27.numberOfNewComplexOrderBitfields >= 3 /\ (settled27.newComplexOrderBitfield3 # << >> /\ (settled27.newComplexOrderBitfield3[1] \div 4) % 2 > 0) THEN (IF settled27.riskReset = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled27.riskReset) ELSE << >>]
        settled29 == [settled28 EXCEPT !.customGroupId = IF settled28.numberOfNewComplexOrderBitfields >= 3 /\ (settled28.newComplexOrderBitfield3 # << >> /\ (settled28.newComplexOrderBitfield3[1] \div 8) % 2 > 0) THEN (IF settled28.customGroupId = << >> THEN <<[i \in 1 .. 2 |-> 0]>> ELSE settled28.customGroupId) ELSE << >>]
        settled30 == [settled29 EXCEPT !.equityPartyId = IF settled29.numberOfNewComplexOrderBitfields >= 3 /\ (settled29.newComplexOrderBitfield3 # << >> /\ (settled29.newComplexOrderBitfield3[1] \div 32) % 2 > 0) THEN (IF settled29.equityPartyId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled29.equityPartyId) ELSE << >>]
        settled31 == [settled30 EXCEPT !.clearingOptionalData = IF settled30.numberOfNewComplexOrderBitfields >= 3 /\ (settled30.newComplexOrderBitfield3 # << >> /\ (settled30.newComplexOrderBitfield3[1] \div 128) % 2 > 0) THEN (IF settled30.clearingOptionalData = << >> THEN <<[i \in 1 .. 16 |-> 0]>> ELSE settled30.clearingOptionalData) ELSE << >>]
        settled32 == [settled31 EXCEPT !.clientIdAttr = IF settled31.numberOfNewComplexOrderBitfields >= 4 /\ (settled31.newComplexOrderBitfield4 # << >> /\ settled31.newComplexOrderBitfield4[1] % 2 > 0) THEN (IF settled31.clientIdAttr = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled31.clientIdAttr) ELSE << >>]
        settled33 == [settled32 EXCEPT !.frequentTraderId = IF settled32.numberOfNewComplexOrderBitfields >= 4 /\ (settled32.newComplexOrderBitfield4 # << >> /\ (settled32.newComplexOrderBitfield4[1] \div 2) % 2 > 0) THEN (IF settled32.frequentTraderId = << >> THEN <<[i \in 1 .. 6 |-> 0]>> ELSE settled32.frequentTraderId) ELSE << >>]
        settled34 == [settled33 EXCEPT !.sessionEligibility = IF settled33.numberOfNewComplexOrderBitfields >= 4 /\ (settled33.newComplexOrderBitfield4 # << >> /\ (settled33.newComplexOrderBitfield4[1] \div 4) % 2 > 0) THEN (IF settled33.sessionEligibility = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled33.sessionEligibility) ELSE << >>]
        settled35 == [settled34 EXCEPT !.maxFloor = IF settled34.numberOfNewComplexOrderBitfields >= 4 /\ (settled34.newComplexOrderBitfield4 # << >> /\ (settled34.newComplexOrderBitfield4[1] \div 8) % 2 > 0) THEN (IF settled34.maxFloor = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled34.maxFloor) ELSE << >>]
        settled36 == [settled35 EXCEPT !.displayRange = IF settled35.numberOfNewComplexOrderBitfields >= 4 /\ (settled35.newComplexOrderBitfield4 # << >> /\ (settled35.newComplexOrderBitfield4[1] \div 16) % 2 > 0) THEN (IF settled35.displayRange = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled35.displayRange) ELSE << >>]
        settled37 == [settled36 EXCEPT !.comboOrder = IF settled36.numberOfNewComplexOrderBitfields >= 4 /\ (settled36.newComplexOrderBitfield4 # << >> /\ (settled36.newComplexOrderBitfield4[1] \div 32) % 2 > 0) THEN (IF settled36.comboOrder = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled36.comboOrder) ELSE << >>]
        settled38 == [settled37 EXCEPT !.compression = IF settled37.numberOfNewComplexOrderBitfields >= 4 /\ (settled37.newComplexOrderBitfield4 # << >> /\ (settled37.newComplexOrderBitfield4[1] \div 64) % 2 > 0) THEN (IF settled37.compression = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled37.compression) ELSE << >>]
        settled39 == [settled38 EXCEPT !.equityExDestination = IF settled38.numberOfNewComplexOrderBitfields >= 4 /\ (settled38.newComplexOrderBitfield4 # << >> /\ (settled38.newComplexOrderBitfield4[1] \div 128) % 2 > 0) THEN (IF settled38.equityExDestination = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled38.equityExDestination) ELSE << >>]
        settled40 == [settled39 EXCEPT !.equityLegShortSell = IF settled39.numberOfNewComplexOrderBitfields >= 5 /\ (settled39.newComplexOrderBitfield5 # << >> /\ settled39.newComplexOrderBitfield5[1] % 2 > 0) THEN (IF settled39.equityLegShortSell = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled39.equityLegShortSell) ELSE << >>]
        settled41 == [settled40 EXCEPT !.floorDestination = IF settled40.numberOfNewComplexOrderBitfields >= 5 /\ (settled40.newComplexOrderBitfield5 # << >> /\ (settled40.newComplexOrderBitfield5[1] \div 2) % 2 > 0) THEN (IF settled40.floorDestination = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled40.floorDestination) ELSE << >>]
        settled42 == [settled41 EXCEPT !.floorRoutingInst = IF settled41.numberOfNewComplexOrderBitfields >= 5 /\ (settled41.newComplexOrderBitfield5 # << >> /\ (settled41.newComplexOrderBitfield5[1] \div 4) % 2 > 0) THEN (IF settled41.floorRoutingInst = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled41.floorRoutingInst) ELSE << >>]
        settled43 == [settled42 EXCEPT !.multiClassSprd = IF settled42.numberOfNewComplexOrderBitfields >= 5 /\ (settled42.newComplexOrderBitfield5 # << >> /\ (settled42.newComplexOrderBitfield5[1] \div 8) % 2 > 0) THEN (IF settled42.multiClassSprd = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled42.multiClassSprd) ELSE << >>]
        settled44 == [settled43 EXCEPT !.orderOrigin = IF settled43.numberOfNewComplexOrderBitfields >= 5 /\ (settled43.newComplexOrderBitfield5 # << >> /\ (settled43.newComplexOrderBitfield5[1] \div 16) % 2 > 0) THEN (IF settled43.orderOrigin = << >> THEN <<[i \in 1 .. 3 |-> 0]>> ELSE settled43.orderOrigin) ELSE << >>]
        settled45 == [settled44 EXCEPT !.ors = IF settled44.numberOfNewComplexOrderBitfields >= 5 /\ (settled44.newComplexOrderBitfield5 # << >> /\ (settled44.newComplexOrderBitfield5[1] \div 32) % 2 > 0) THEN (IF settled44.ors = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled44.ors) ELSE << >>]
        settled46 == [settled45 EXCEPT !.priceType = IF settled45.numberOfNewComplexOrderBitfields >= 5 /\ (settled45.newComplexOrderBitfield5 # << >> /\ (settled45.newComplexOrderBitfield5[1] \div 64) % 2 > 0) THEN (IF settled45.priceType = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled45.priceType) ELSE << >>]
        settled47 == [settled46 EXCEPT !.strategyId = IF settled46.numberOfNewComplexOrderBitfields >= 5 /\ (settled46.newComplexOrderBitfield5 # << >> /\ (settled46.newComplexOrderBitfield5[1] \div 128) % 2 > 0) THEN (IF settled46.strategyId = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled46.strategyId) ELSE << >>]
        settled48 == [settled47 EXCEPT !.execInst = IF settled47.numberOfNewComplexOrderBitfields >= 6 /\ (settled47.newComplexOrderBitfield6 # << >> /\ (settled47.newComplexOrderBitfield6[1] \div 2) % 2 > 0) THEN (IF settled47.execInst = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled47.execInst) ELSE << >>]
        settled49 == [settled48 EXCEPT !.tiedHedge = IF settled48.numberOfNewComplexOrderBitfields >= 6 /\ (settled48.newComplexOrderBitfield6 # << >> /\ (settled48.newComplexOrderBitfield6[1] \div 4) % 2 > 0) THEN (IF settled48.tiedHedge = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled48.tiedHedge) ELSE << >>]
        settled50 == [settled49 EXCEPT !.held = IF settled49.numberOfNewComplexOrderBitfields >= 7 /\ (settled49.newComplexOrderBitfield7 # << >> /\ (settled49.newComplexOrderBitfield7[1] \div 128) % 2 > 0) THEN (IF settled49.held = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled49.held) ELSE << >>]
        settled51 == [settled50 EXCEPT !.crossInitiator = IF settled50.numberOfNewComplexOrderBitfields >= 8 /\ (settled50.newComplexOrderBitfield8 # << >> /\ (settled50.newComplexOrderBitfield8[1] \div 2) % 2 > 0) THEN (IF settled50.crossInitiator = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled50.crossInitiator) ELSE << >>]
        settled52 == [settled51 EXCEPT !.crossOnBehalfOfId = IF settled51.numberOfNewComplexOrderBitfields >= 8 /\ (settled51.newComplexOrderBitfield8 # << >> /\ (settled51.newComplexOrderBitfield8[1] \div 4) % 2 > 0) THEN (IF settled51.crossOnBehalfOfId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled51.crossOnBehalfOfId) ELSE << >>]
        settled53 == [settled52 EXCEPT !.stopPx = IF settled52.numberOfNewComplexOrderBitfields >= 8 /\ (settled52.newComplexOrderBitfield8 # << >> /\ (settled52.newComplexOrderBitfield8[1] \div 8) % 2 > 0) THEN (IF settled52.stopPx = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled52.stopPx) ELSE << >>]
        settled54 == [settled53 EXCEPT !.stopPxType = IF settled53.numberOfNewComplexOrderBitfields >= 8 /\ (settled53.newComplexOrderBitfield8 # << >> /\ (settled53.newComplexOrderBitfield8[1] \div 16) % 2 > 0) THEN (IF settled53.stopPxType = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled53.stopPxType) ELSE << >>]
    IN  settled54

ZeroNewComplexOrderMessage ==
    SettleNewComplexOrderMessage([ clOrdId                          |-> [i \in 1 .. 20 |-> 0],
                                   side                             |-> [i \in 1 .. 1 |-> 0],
                                   orderQtyLong                     |-> [i \in 1 .. 4 |-> 0],
                                   numberOfNewComplexOrderBitfields |-> 0,
                                   newComplexOrderBitfield1         |-> << >>,
                                   newComplexOrderBitfield2         |-> << >>,
                                   newComplexOrderBitfield3         |-> << >>,
                                   newComplexOrderBitfield4         |-> << >>,
                                   newComplexOrderBitfield5         |-> << >>,
                                   newComplexOrderBitfield6         |-> << >>,
                                   newComplexOrderBitfield7         |-> << >>,
                                   newComplexOrderBitfield8         |-> << >>,
                                   newComplexOrderBitfield9         |-> << >>,
                                   complexLegOrderInfo              |-> << >>,
                                   clearingFirm                     |-> << >>,
                                   clearingAccount                  |-> << >>,
                                   priceLong                        |-> << >>,
                                   ordType                          |-> << >>,
                                   timeInForce                      |-> << >>,
                                   symbolLong                       |-> << >>,
                                   capacity                         |-> << >>,
                                   routingInst                      |-> << >>,
                                   account                          |-> << >>,
                                   preventMatch                     |-> << >>,
                                   expireTime                       |-> << >>,
                                   cmtaNumber                       |-> << >>,
                                   targetPartyId                    |-> << >>,
                                   attributedQuote                  |-> << >>,
                                   echoText                         |-> << >>,
                                   auctionId                        |-> << >>,
                                   routingFirmId                    |-> << >>,
                                   drillThruProtection              |-> << >>,
                                   riskReset                        |-> << >>,
                                   customGroupId                    |-> << >>,
                                   equityPartyId                    |-> << >>,
                                   clearingOptionalData             |-> << >>,
                                   clientIdAttr                     |-> << >>,
                                   frequentTraderId                 |-> << >>,
                                   sessionEligibility               |-> << >>,
                                   maxFloor                         |-> << >>,
                                   displayRange                     |-> << >>,
                                   comboOrder                       |-> << >>,
                                   compression                      |-> << >>,
                                   equityExDestination              |-> << >>,
                                   equityLegShortSell               |-> << >>,
                                   floorDestination                 |-> << >>,
                                   floorRoutingInst                 |-> << >>,
                                   multiClassSprd                   |-> << >>,
                                   orderOrigin                      |-> << >>,
                                   ors                              |-> << >>,
                                   priceType                        |-> << >>,
                                   strategyId                       |-> << >>,
                                   execInst                         |-> << >>,
                                   tiedHedge                        |-> << >>,
                                   held                             |-> << >>,
                                   crossInitiator                   |-> << >>,
                                   crossOnBehalfOfId                |-> << >>,
                                   stopPx                           |-> << >>,
                                   stopPxType                       |-> << >> ])

(* New Complex Order Message at zero, then each field in turn at the values it is checked at *)
CheckedNewComplexOrderMessage ==
    { ZeroNewComplexOrderMessage }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.clOrdId = one]) : one \in Sample(20) }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.side = one]) : one \in Sample(1) }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.orderQtyLong = one]) : one \in Sample(4) }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = one]) : one \in {0, 1, 255} }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 1, !.newComplexOrderBitfield1 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 2, !.newComplexOrderBitfield2 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 3, !.newComplexOrderBitfield3 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 4, !.newComplexOrderBitfield4 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 5, !.newComplexOrderBitfield5 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 6, !.newComplexOrderBitfield6 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 7, !.newComplexOrderBitfield7 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 8, !.newComplexOrderBitfield8 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 9, !.newComplexOrderBitfield9 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.complexLegOrderInfo = one]) : one \in SampleLists(OneComplexLegOrderInfo) }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 1, !.newComplexOrderBitfield1 = <<1>>, !.clearingFirm = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 1, !.newComplexOrderBitfield1 = <<2>>, !.clearingAccount = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 1, !.newComplexOrderBitfield1 = <<4>>, !.priceLong = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 1, !.newComplexOrderBitfield1 = <<8>>, !.ordType = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 1, !.newComplexOrderBitfield1 = <<16>>, !.timeInForce = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 1, !.newComplexOrderBitfield1 = <<32>>, !.symbolLong = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 1, !.newComplexOrderBitfield1 = <<64>>, !.capacity = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 1, !.newComplexOrderBitfield1 = <<128>>, !.routingInst = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 2, !.newComplexOrderBitfield2 = <<1>>, !.account = one]) : one \in { <<held>> : held \in Sample(16) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 2, !.newComplexOrderBitfield2 = <<2>>, !.preventMatch = one]) : one \in { <<held>> : held \in Sample(3) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 2, !.newComplexOrderBitfield2 = <<4>>, !.expireTime = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 2, !.newComplexOrderBitfield2 = <<8>>, !.cmtaNumber = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 2, !.newComplexOrderBitfield2 = <<16>>, !.targetPartyId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 2, !.newComplexOrderBitfield2 = <<32>>, !.attributedQuote = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 2, !.newComplexOrderBitfield2 = <<64>>, !.echoText = one]) : one \in { <<held>> : held \in Sample(64) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 2, !.newComplexOrderBitfield2 = <<128>>, !.auctionId = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 3, !.newComplexOrderBitfield3 = <<1>>, !.routingFirmId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 3, !.newComplexOrderBitfield3 = <<2>>, !.drillThruProtection = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 3, !.newComplexOrderBitfield3 = <<4>>, !.riskReset = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 3, !.newComplexOrderBitfield3 = <<8>>, !.customGroupId = one]) : one \in { <<held>> : held \in Sample(2) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 3, !.newComplexOrderBitfield3 = <<32>>, !.equityPartyId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 3, !.newComplexOrderBitfield3 = <<128>>, !.clearingOptionalData = one]) : one \in { <<held>> : held \in Sample(16) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 4, !.newComplexOrderBitfield4 = <<1>>, !.clientIdAttr = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 4, !.newComplexOrderBitfield4 = <<2>>, !.frequentTraderId = one]) : one \in { <<held>> : held \in Sample(6) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 4, !.newComplexOrderBitfield4 = <<4>>, !.sessionEligibility = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 4, !.newComplexOrderBitfield4 = <<8>>, !.maxFloor = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 4, !.newComplexOrderBitfield4 = <<16>>, !.displayRange = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 4, !.newComplexOrderBitfield4 = <<32>>, !.comboOrder = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 4, !.newComplexOrderBitfield4 = <<64>>, !.compression = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 4, !.newComplexOrderBitfield4 = <<128>>, !.equityExDestination = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 5, !.newComplexOrderBitfield5 = <<1>>, !.equityLegShortSell = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 5, !.newComplexOrderBitfield5 = <<2>>, !.floorDestination = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 5, !.newComplexOrderBitfield5 = <<4>>, !.floorRoutingInst = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 5, !.newComplexOrderBitfield5 = <<8>>, !.multiClassSprd = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 5, !.newComplexOrderBitfield5 = <<16>>, !.orderOrigin = one]) : one \in { <<held>> : held \in Sample(3) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 5, !.newComplexOrderBitfield5 = <<32>>, !.ors = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 5, !.newComplexOrderBitfield5 = <<64>>, !.priceType = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 5, !.newComplexOrderBitfield5 = <<128>>, !.strategyId = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 6, !.newComplexOrderBitfield6 = <<2>>, !.execInst = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 6, !.newComplexOrderBitfield6 = <<4>>, !.tiedHedge = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 7, !.newComplexOrderBitfield7 = <<128>>, !.held = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 8, !.newComplexOrderBitfield8 = <<2>>, !.crossInitiator = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 8, !.newComplexOrderBitfield8 = <<4>>, !.crossOnBehalfOfId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 8, !.newComplexOrderBitfield8 = <<8>>, !.stopPx = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 8, !.newComplexOrderBitfield8 = <<16>>, !.stopPxType = one]) : one \in { <<held>> : held \in Sample(1) } }

(***************************************************************************)
(* New Order Cross Multileg Order Allocations                              *)
(***************************************************************************)

NewOrderCrossMultilegOrderAllocations ==
    [ side                  : Sample(1),
      allocQty              : Sample(4),
      clOrdId               : Sample(20),
      capacity              : Sample(1),
      giveUpFirmId          : Sample(4),
      legPositionEffects    : Sample(12),
      account               : { << >> } \cup { <<held>> : held \in Sample(16) },
      cmtaNumber            : { << >> } \cup { <<held>> : held \in Sample(4) },
      clearingAccount       : { << >> } \cup { <<held>> : held \in Sample(4) },
      clearingOptionalData  : { << >> } \cup { <<held>> : held \in Sample(16) },
      equityPartyId         : { << >> } \cup { <<held>> : held \in Sample(4) },
      equityLegShortSell    : { << >> } \cup { <<held>> : held \in Sample(1) },
      frequentTraderId      : { << >> } \cup { <<held>> : held \in Sample(6) },
      legPositionEffectsExt : { << >> } \cup { <<held>> : held \in Sample(16) } ]

EncodeNewOrderCrossMultilegOrderAllocations(message) ==
    message.side
        \o message.allocQty
        \o message.clOrdId
        \o message.capacity
        \o message.giveUpFirmId
        \o message.legPositionEffects
        \o (IF message.account = << >> THEN << >> ELSE message.account[1])
        \o (IF message.cmtaNumber = << >> THEN << >> ELSE message.cmtaNumber[1])
        \o (IF message.clearingAccount = << >> THEN << >> ELSE message.clearingAccount[1])
        \o (IF message.clearingOptionalData = << >> THEN << >> ELSE message.clearingOptionalData[1])
        \o (IF message.equityPartyId = << >> THEN << >> ELSE message.equityPartyId[1])
        \o (IF message.equityLegShortSell = << >> THEN << >> ELSE message.equityLegShortSell[1])
        \o (IF message.frequentTraderId = << >> THEN << >> ELSE message.frequentTraderId[1])
        \o (IF message.legPositionEffectsExt = << >> THEN << >> ELSE message.legPositionEffectsExt[1])

DecodeNewOrderCrossMultilegOrderAllocations(bytes, handedNumberOfNewOrderCrossMultilegBitfields, handedNewOrderCrossMultilegBitfield2, handedNewOrderCrossMultilegBitfield4, handedNewOrderCrossMultilegBitfield5) ==
    LET side == ReadBytes(bytes, 1) IN IF ~side.ok THEN Fail ELSE
    LET allocQty == ReadBytes(side.rest, 4) IN IF ~allocQty.ok THEN Fail ELSE
    LET clOrdId == ReadBytes(allocQty.rest, 20) IN IF ~clOrdId.ok THEN Fail ELSE
    LET capacity == ReadBytes(clOrdId.rest, 1) IN IF ~capacity.ok THEN Fail ELSE
    LET giveUpFirmId == ReadBytes(capacity.rest, 4) IN IF ~giveUpFirmId.ok THEN Fail ELSE
    LET legPositionEffects == ReadBytes(giveUpFirmId.rest, 12) IN IF ~legPositionEffects.ok THEN Fail ELSE
    LET account == ReadWhen(handedNumberOfNewOrderCrossMultilegBitfields >= 2 /\ (handedNewOrderCrossMultilegBitfield2 # << >> /\ (handedNewOrderCrossMultilegBitfield2[1] \div 8) % 2 > 0), ReadBytes(legPositionEffects.rest, 16), legPositionEffects.rest) IN IF ~account.ok THEN Fail ELSE
    LET cmtaNumber == ReadWhen(handedNumberOfNewOrderCrossMultilegBitfields >= 2 /\ (handedNewOrderCrossMultilegBitfield2 # << >> /\ (handedNewOrderCrossMultilegBitfield2[1] \div 16) % 2 > 0), ReadBytes(account.rest, 4), account.rest) IN IF ~cmtaNumber.ok THEN Fail ELSE
    LET clearingAccount == ReadWhen(handedNumberOfNewOrderCrossMultilegBitfields >= 2 /\ (handedNewOrderCrossMultilegBitfield2 # << >> /\ (handedNewOrderCrossMultilegBitfield2[1] \div 32) % 2 > 0), ReadBytes(cmtaNumber.rest, 4), cmtaNumber.rest) IN IF ~clearingAccount.ok THEN Fail ELSE
    LET clearingOptionalData == ReadWhen(handedNumberOfNewOrderCrossMultilegBitfields >= 2 /\ (handedNewOrderCrossMultilegBitfield2 # << >> /\ (handedNewOrderCrossMultilegBitfield2[1] \div 128) % 2 > 0), ReadBytes(clearingAccount.rest, 16), clearingAccount.rest) IN IF ~clearingOptionalData.ok THEN Fail ELSE
    LET equityPartyId == ReadWhen(handedNumberOfNewOrderCrossMultilegBitfields >= 4 /\ (handedNewOrderCrossMultilegBitfield4 # << >> /\ handedNewOrderCrossMultilegBitfield4[1] % 2 > 0), ReadBytes(clearingOptionalData.rest, 4), clearingOptionalData.rest) IN IF ~equityPartyId.ok THEN Fail ELSE
    LET equityLegShortSell == ReadWhen(handedNumberOfNewOrderCrossMultilegBitfields >= 4 /\ (handedNewOrderCrossMultilegBitfield4 # << >> /\ (handedNewOrderCrossMultilegBitfield4[1] \div 2) % 2 > 0), ReadBytes(equityPartyId.rest, 1), equityPartyId.rest) IN IF ~equityLegShortSell.ok THEN Fail ELSE
    LET frequentTraderId == ReadWhen(handedNumberOfNewOrderCrossMultilegBitfields >= 5 /\ (handedNewOrderCrossMultilegBitfield5 # << >> /\ (handedNewOrderCrossMultilegBitfield5[1] \div 2) % 2 > 0), ReadBytes(equityLegShortSell.rest, 6), equityLegShortSell.rest) IN IF ~frequentTraderId.ok THEN Fail ELSE
    LET legPositionEffectsExt == ReadWhen(handedNumberOfNewOrderCrossMultilegBitfields >= 5 /\ (handedNewOrderCrossMultilegBitfield5 # << >> /\ (handedNewOrderCrossMultilegBitfield5[1] \div 8) % 2 > 0), ReadBytes(frequentTraderId.rest, 16), frequentTraderId.rest) IN IF ~legPositionEffectsExt.ok THEN Fail ELSE
    Ok([ side                  |-> side.value,
         allocQty              |-> allocQty.value,
         clOrdId               |-> clOrdId.value,
         capacity              |-> capacity.value,
         giveUpFirmId          |-> giveUpFirmId.value,
         legPositionEffects    |-> legPositionEffects.value,
         account               |-> account.value,
         cmtaNumber            |-> cmtaNumber.value,
         clearingAccount       |-> clearingAccount.value,
         clearingOptionalData  |-> clearingOptionalData.value,
         equityPartyId         |-> equityPartyId.value,
         equityLegShortSell    |-> equityLegShortSell.value,
         frequentTraderId      |-> frequentTraderId.value,
         legPositionEffectsExt |-> legPositionEffectsExt.value ], legPositionEffectsExt.rest)

(* New Order Cross Multileg Order Allocations with each field marked present by fields before it there exactly where they say *)
SettleNewOrderCrossMultilegOrderAllocations(message, handedNumberOfNewOrderCrossMultilegBitfields, handedNewOrderCrossMultilegBitfield2, handedNewOrderCrossMultilegBitfield4, handedNewOrderCrossMultilegBitfield5) ==
    LET settled1 == [message EXCEPT !.account = IF handedNumberOfNewOrderCrossMultilegBitfields >= 2 /\ (handedNewOrderCrossMultilegBitfield2 # << >> /\ (handedNewOrderCrossMultilegBitfield2[1] \div 8) % 2 > 0) THEN (IF message.account = << >> THEN <<[i \in 1 .. 16 |-> 0]>> ELSE message.account) ELSE << >>]
        settled2 == [settled1 EXCEPT !.cmtaNumber = IF handedNumberOfNewOrderCrossMultilegBitfields >= 2 /\ (handedNewOrderCrossMultilegBitfield2 # << >> /\ (handedNewOrderCrossMultilegBitfield2[1] \div 16) % 2 > 0) THEN (IF settled1.cmtaNumber = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled1.cmtaNumber) ELSE << >>]
        settled3 == [settled2 EXCEPT !.clearingAccount = IF handedNumberOfNewOrderCrossMultilegBitfields >= 2 /\ (handedNewOrderCrossMultilegBitfield2 # << >> /\ (handedNewOrderCrossMultilegBitfield2[1] \div 32) % 2 > 0) THEN (IF settled2.clearingAccount = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled2.clearingAccount) ELSE << >>]
        settled4 == [settled3 EXCEPT !.clearingOptionalData = IF handedNumberOfNewOrderCrossMultilegBitfields >= 2 /\ (handedNewOrderCrossMultilegBitfield2 # << >> /\ (handedNewOrderCrossMultilegBitfield2[1] \div 128) % 2 > 0) THEN (IF settled3.clearingOptionalData = << >> THEN <<[i \in 1 .. 16 |-> 0]>> ELSE settled3.clearingOptionalData) ELSE << >>]
        settled5 == [settled4 EXCEPT !.equityPartyId = IF handedNumberOfNewOrderCrossMultilegBitfields >= 4 /\ (handedNewOrderCrossMultilegBitfield4 # << >> /\ handedNewOrderCrossMultilegBitfield4[1] % 2 > 0) THEN (IF settled4.equityPartyId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled4.equityPartyId) ELSE << >>]
        settled6 == [settled5 EXCEPT !.equityLegShortSell = IF handedNumberOfNewOrderCrossMultilegBitfields >= 4 /\ (handedNewOrderCrossMultilegBitfield4 # << >> /\ (handedNewOrderCrossMultilegBitfield4[1] \div 2) % 2 > 0) THEN (IF settled5.equityLegShortSell = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled5.equityLegShortSell) ELSE << >>]
        settled7 == [settled6 EXCEPT !.frequentTraderId = IF handedNumberOfNewOrderCrossMultilegBitfields >= 5 /\ (handedNewOrderCrossMultilegBitfield5 # << >> /\ (handedNewOrderCrossMultilegBitfield5[1] \div 2) % 2 > 0) THEN (IF settled6.frequentTraderId = << >> THEN <<[i \in 1 .. 6 |-> 0]>> ELSE settled6.frequentTraderId) ELSE << >>]
        settled8 == [settled7 EXCEPT !.legPositionEffectsExt = IF handedNumberOfNewOrderCrossMultilegBitfields >= 5 /\ (handedNewOrderCrossMultilegBitfield5 # << >> /\ (handedNewOrderCrossMultilegBitfield5[1] \div 8) % 2 > 0) THEN (IF settled7.legPositionEffectsExt = << >> THEN <<[i \in 1 .. 16 |-> 0]>> ELSE settled7.legPositionEffectsExt) ELSE << >>]
    IN  settled8

ZeroNewOrderCrossMultilegOrderAllocations ==
    SettleNewOrderCrossMultilegOrderAllocations([ side                  |-> [i \in 1 .. 1 |-> 0],
                                                  allocQty              |-> [i \in 1 .. 4 |-> 0],
                                                  clOrdId               |-> [i \in 1 .. 20 |-> 0],
                                                  capacity              |-> [i \in 1 .. 1 |-> 0],
                                                  giveUpFirmId          |-> [i \in 1 .. 4 |-> 0],
                                                  legPositionEffects    |-> [i \in 1 .. 12 |-> 0],
                                                  account               |-> << >>,
                                                  cmtaNumber            |-> << >>,
                                                  clearingAccount       |-> << >>,
                                                  clearingOptionalData  |-> << >>,
                                                  equityPartyId         |-> << >>,
                                                  equityLegShortSell    |-> << >>,
                                                  frequentTraderId      |-> << >>,
                                                  legPositionEffectsExt |-> << >> ], 0, << >>, << >>, << >>)

(* New Order Cross Multileg Order Allocations at zero, then each field in turn at the values it is checked at *)
CheckedNewOrderCrossMultilegOrderAllocations ==
    { [given |-> <<0, << >>, << >>, << >>>>, message |-> ZeroNewOrderCrossMultilegOrderAllocations] }
        \cup { [given |-> <<0, << >>, << >>, << >>>>, message |-> SettleNewOrderCrossMultilegOrderAllocations([ZeroNewOrderCrossMultilegOrderAllocations EXCEPT !.side = one], 0, << >>, << >>, << >>)] : one \in Sample(1) }
        \cup { [given |-> <<0, << >>, << >>, << >>>>, message |-> SettleNewOrderCrossMultilegOrderAllocations([ZeroNewOrderCrossMultilegOrderAllocations EXCEPT !.allocQty = one], 0, << >>, << >>, << >>)] : one \in Sample(4) }
        \cup { [given |-> <<0, << >>, << >>, << >>>>, message |-> SettleNewOrderCrossMultilegOrderAllocations([ZeroNewOrderCrossMultilegOrderAllocations EXCEPT !.clOrdId = one], 0, << >>, << >>, << >>)] : one \in Sample(20) }
        \cup { [given |-> <<0, << >>, << >>, << >>>>, message |-> SettleNewOrderCrossMultilegOrderAllocations([ZeroNewOrderCrossMultilegOrderAllocations EXCEPT !.capacity = one], 0, << >>, << >>, << >>)] : one \in Sample(1) }
        \cup { [given |-> <<0, << >>, << >>, << >>>>, message |-> SettleNewOrderCrossMultilegOrderAllocations([ZeroNewOrderCrossMultilegOrderAllocations EXCEPT !.giveUpFirmId = one], 0, << >>, << >>, << >>)] : one \in Sample(4) }
        \cup { [given |-> <<0, << >>, << >>, << >>>>, message |-> SettleNewOrderCrossMultilegOrderAllocations([ZeroNewOrderCrossMultilegOrderAllocations EXCEPT !.legPositionEffects = one], 0, << >>, << >>, << >>)] : one \in Sample(12) }
        \cup { [given |-> <<2, <<8>>, << >>, << >>>>, message |-> SettleNewOrderCrossMultilegOrderAllocations([ZeroNewOrderCrossMultilegOrderAllocations EXCEPT !.account = one], 2, <<8>>, << >>, << >>)] : one \in { <<held>> : held \in Sample(16) } }
        \cup { [given |-> <<2, <<16>>, << >>, << >>>>, message |-> SettleNewOrderCrossMultilegOrderAllocations([ZeroNewOrderCrossMultilegOrderAllocations EXCEPT !.cmtaNumber = one], 2, <<16>>, << >>, << >>)] : one \in { <<held>> : held \in Sample(4) } }
        \cup { [given |-> <<2, <<32>>, << >>, << >>>>, message |-> SettleNewOrderCrossMultilegOrderAllocations([ZeroNewOrderCrossMultilegOrderAllocations EXCEPT !.clearingAccount = one], 2, <<32>>, << >>, << >>)] : one \in { <<held>> : held \in Sample(4) } }
        \cup { [given |-> <<2, <<128>>, << >>, << >>>>, message |-> SettleNewOrderCrossMultilegOrderAllocations([ZeroNewOrderCrossMultilegOrderAllocations EXCEPT !.clearingOptionalData = one], 2, <<128>>, << >>, << >>)] : one \in { <<held>> : held \in Sample(16) } }
        \cup { [given |-> <<4, << >>, <<1>>, << >>>>, message |-> SettleNewOrderCrossMultilegOrderAllocations([ZeroNewOrderCrossMultilegOrderAllocations EXCEPT !.equityPartyId = one], 4, << >>, <<1>>, << >>)] : one \in { <<held>> : held \in Sample(4) } }
        \cup { [given |-> <<4, << >>, <<2>>, << >>>>, message |-> SettleNewOrderCrossMultilegOrderAllocations([ZeroNewOrderCrossMultilegOrderAllocations EXCEPT !.equityLegShortSell = one], 4, << >>, <<2>>, << >>)] : one \in { <<held>> : held \in Sample(1) } }
        \cup { [given |-> <<5, << >>, << >>, <<2>>>>, message |-> SettleNewOrderCrossMultilegOrderAllocations([ZeroNewOrderCrossMultilegOrderAllocations EXCEPT !.frequentTraderId = one], 5, << >>, << >>, <<2>>)] : one \in { <<held>> : held \in Sample(6) } }
        \cup { [given |-> <<5, << >>, << >>, <<8>>>>, message |-> SettleNewOrderCrossMultilegOrderAllocations([ZeroNewOrderCrossMultilegOrderAllocations EXCEPT !.legPositionEffectsExt = one], 5, << >>, << >>, <<8>>)] : one \in { <<held>> : held \in Sample(16) } }

(* A run of New Order Cross Multileg Order Allocations, written one after another *)
RECURSIVE EncodeNewOrderCrossMultilegOrderAllocationsList(_)
EncodeNewOrderCrossMultilegOrderAllocationsList(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeNewOrderCrossMultilegOrderAllocations(Head(messages)) \o EncodeNewOrderCrossMultilegOrderAllocationsList(Tail(messages))

(* As many New Order Cross Multileg Order Allocations as the field that counts them says *)
RECURSIVE ReadNewOrderCrossMultilegOrderAllocationsList(_, _, _, _, _, _)
ReadNewOrderCrossMultilegOrderAllocationsList(bytes, count, handedNumberOfNewOrderCrossMultilegBitfields, handedNewOrderCrossMultilegBitfield2, handedNewOrderCrossMultilegBitfield4, handedNewOrderCrossMultilegBitfield5) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeNewOrderCrossMultilegOrderAllocations(bytes, handedNumberOfNewOrderCrossMultilegBitfields, handedNewOrderCrossMultilegBitfield2, handedNewOrderCrossMultilegBitfield4, handedNewOrderCrossMultilegBitfield5)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadNewOrderCrossMultilegOrderAllocationsList(one.rest, count - 1, handedNumberOfNewOrderCrossMultilegBitfields, handedNewOrderCrossMultilegBitfield2, handedNewOrderCrossMultilegBitfield4, handedNewOrderCrossMultilegBitfield5)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One New Order Cross Multileg Order Allocations of each kind, for the lists that carry them *)
OneNewOrderCrossMultilegOrderAllocations == { ZeroNewOrderCrossMultilegOrderAllocations }

(***************************************************************************)
(* New Order Cross Multileg Message                                        *)
(***************************************************************************)

NewOrderCrossMultilegMessage ==
    [ crossId                                : Sample(20),
      crossType                              : Sample(1),
      crossPrioritization                    : Sample(1),
      priceLong                              : Sample(8),
      orderQtyLong                           : Sample(4),
      numberOfNewOrderCrossMultilegBitfields : 0 .. 255,
      newOrderCrossMultilegBitfield1         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      newOrderCrossMultilegBitfield2         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      newOrderCrossMultilegBitfield3         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      newOrderCrossMultilegBitfield4         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      newOrderCrossMultilegBitfield5         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      newOrderCrossMultilegBitfield6         : { << >> } \cup { <<held>> : held \in Sample(1) },
      newOrderCrossMultilegOrderAllocations  : SampleLists(OneNewOrderCrossMultilegOrderAllocations),
      symbolLong                             : { << >> } \cup { <<held>> : held \in Sample(8) },
      execInst                               : { << >> } \cup { <<held>> : held \in Sample(1) },
      attributedQuote                        : { << >> } \cup { <<held>> : held \in Sample(1) },
      targetPartyId                          : { << >> } \cup { <<held>> : held \in Sample(4) },
      preventMatch                           : { << >> } \cup { <<held>> : held \in Sample(3) },
      autoMatch                              : { << >> } \cup { <<held>> : held \in Sample(1) },
      autoMatchPrice                         : { << >> } \cup { <<held>> : held \in Sample(8) },
      lastPriority                           : { << >> } \cup { <<held>> : held \in Sample(1) },
      routingFirmId                          : { << >> } \cup { <<held>> : held \in Sample(4) },
      clientIdAttr                           : { << >> } \cup { <<held>> : held \in Sample(4) },
      equityTradePrice                       : { << >> } \cup { <<held>> : held \in Sample(8) },
      equityTradeSize                        : { << >> } \cup { <<held>> : held \in Sample(4) },
      equityTradeVenue                       : { << >> } \cup { <<held>> : held \in Sample(1) },
      equityTransactTime                     : { << >> } \cup { <<held>> : held \in Sample(8) },
      equityBuyClearingFirm                  : { << >> } \cup { <<held>> : held \in Sample(4) },
      equitySellClearingFirm                 : { << >> } \cup { <<held>> : held \in Sample(4) },
      sessionEligibility                     : { << >> } \cup { <<held>> : held \in Sample(1) },
      drillThruProtection                    : { << >> } \cup { <<held>> : held \in Sample(8) },
      equityExDestination                    : { << >> } \cup { <<held>> : held \in Sample(1) },
      compression                            : { << >> } \cup { <<held>> : held \in Sample(1) },
      ors                                    : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossInitiator                         : { << >> } \cup { <<held>> : held \in Sample(4) },
      crossOnBehalfOfId                      : { << >> } \cup { <<held>> : held \in Sample(4) } ]

EncodeNewOrderCrossMultilegMessage(message) ==
    message.crossId
        \o message.crossType
        \o message.crossPrioritization
        \o message.priceLong
        \o message.orderQtyLong
        \o EncodeUIntBE(message.numberOfNewOrderCrossMultilegBitfields, 1)
        \o (IF message.newOrderCrossMultilegBitfield1 = << >> THEN << >> ELSE EncodeUIntLE(message.newOrderCrossMultilegBitfield1[1], 1))
        \o (IF message.newOrderCrossMultilegBitfield2 = << >> THEN << >> ELSE EncodeUIntLE(message.newOrderCrossMultilegBitfield2[1], 1))
        \o (IF message.newOrderCrossMultilegBitfield3 = << >> THEN << >> ELSE EncodeUIntLE(message.newOrderCrossMultilegBitfield3[1], 1))
        \o (IF message.newOrderCrossMultilegBitfield4 = << >> THEN << >> ELSE EncodeUIntLE(message.newOrderCrossMultilegBitfield4[1], 1))
        \o (IF message.newOrderCrossMultilegBitfield5 = << >> THEN << >> ELSE EncodeUIntLE(message.newOrderCrossMultilegBitfield5[1], 1))
        \o (IF message.newOrderCrossMultilegBitfield6 = << >> THEN << >> ELSE message.newOrderCrossMultilegBitfield6[1])
        \o EncodeUIntLE(Len(message.newOrderCrossMultilegOrderAllocations), 2)
        \o EncodeNewOrderCrossMultilegOrderAllocationsList(message.newOrderCrossMultilegOrderAllocations)
        \o (IF message.symbolLong = << >> THEN << >> ELSE message.symbolLong[1])
        \o (IF message.execInst = << >> THEN << >> ELSE message.execInst[1])
        \o (IF message.attributedQuote = << >> THEN << >> ELSE message.attributedQuote[1])
        \o (IF message.targetPartyId = << >> THEN << >> ELSE message.targetPartyId[1])
        \o (IF message.preventMatch = << >> THEN << >> ELSE message.preventMatch[1])
        \o (IF message.autoMatch = << >> THEN << >> ELSE message.autoMatch[1])
        \o (IF message.autoMatchPrice = << >> THEN << >> ELSE message.autoMatchPrice[1])
        \o (IF message.lastPriority = << >> THEN << >> ELSE message.lastPriority[1])
        \o (IF message.routingFirmId = << >> THEN << >> ELSE message.routingFirmId[1])
        \o (IF message.clientIdAttr = << >> THEN << >> ELSE message.clientIdAttr[1])
        \o (IF message.equityTradePrice = << >> THEN << >> ELSE message.equityTradePrice[1])
        \o (IF message.equityTradeSize = << >> THEN << >> ELSE message.equityTradeSize[1])
        \o (IF message.equityTradeVenue = << >> THEN << >> ELSE message.equityTradeVenue[1])
        \o (IF message.equityTransactTime = << >> THEN << >> ELSE message.equityTransactTime[1])
        \o (IF message.equityBuyClearingFirm = << >> THEN << >> ELSE message.equityBuyClearingFirm[1])
        \o (IF message.equitySellClearingFirm = << >> THEN << >> ELSE message.equitySellClearingFirm[1])
        \o (IF message.sessionEligibility = << >> THEN << >> ELSE message.sessionEligibility[1])
        \o (IF message.drillThruProtection = << >> THEN << >> ELSE message.drillThruProtection[1])
        \o (IF message.equityExDestination = << >> THEN << >> ELSE message.equityExDestination[1])
        \o (IF message.compression = << >> THEN << >> ELSE message.compression[1])
        \o (IF message.ors = << >> THEN << >> ELSE message.ors[1])
        \o (IF message.crossInitiator = << >> THEN << >> ELSE message.crossInitiator[1])
        \o (IF message.crossOnBehalfOfId = << >> THEN << >> ELSE message.crossOnBehalfOfId[1])

DecodeNewOrderCrossMultilegMessage(bytes) ==
    LET crossId == ReadBytes(bytes, 20) IN IF ~crossId.ok THEN Fail ELSE
    LET crossType == ReadBytes(crossId.rest, 1) IN IF ~crossType.ok THEN Fail ELSE
    LET crossPrioritization == ReadBytes(crossType.rest, 1) IN IF ~crossPrioritization.ok THEN Fail ELSE
    LET priceLong == ReadBytes(crossPrioritization.rest, 8) IN IF ~priceLong.ok THEN Fail ELSE
    LET orderQtyLong == ReadBytes(priceLong.rest, 4) IN IF ~orderQtyLong.ok THEN Fail ELSE
    LET numberOfNewOrderCrossMultilegBitfields == ReadUIntBE(orderQtyLong.rest, 1) IN IF ~numberOfNewOrderCrossMultilegBitfields.ok THEN Fail ELSE
    LET newOrderCrossMultilegBitfield1 == ReadWhen(numberOfNewOrderCrossMultilegBitfields.value >= 1, ReadUIntLE(numberOfNewOrderCrossMultilegBitfields.rest, 1), numberOfNewOrderCrossMultilegBitfields.rest) IN IF ~newOrderCrossMultilegBitfield1.ok THEN Fail ELSE
    LET newOrderCrossMultilegBitfield2 == ReadWhen(numberOfNewOrderCrossMultilegBitfields.value >= 2, ReadUIntLE(newOrderCrossMultilegBitfield1.rest, 1), newOrderCrossMultilegBitfield1.rest) IN IF ~newOrderCrossMultilegBitfield2.ok THEN Fail ELSE
    LET newOrderCrossMultilegBitfield3 == ReadWhen(numberOfNewOrderCrossMultilegBitfields.value >= 3, ReadUIntLE(newOrderCrossMultilegBitfield2.rest, 1), newOrderCrossMultilegBitfield2.rest) IN IF ~newOrderCrossMultilegBitfield3.ok THEN Fail ELSE
    LET newOrderCrossMultilegBitfield4 == ReadWhen(numberOfNewOrderCrossMultilegBitfields.value >= 4, ReadUIntLE(newOrderCrossMultilegBitfield3.rest, 1), newOrderCrossMultilegBitfield3.rest) IN IF ~newOrderCrossMultilegBitfield4.ok THEN Fail ELSE
    LET newOrderCrossMultilegBitfield5 == ReadWhen(numberOfNewOrderCrossMultilegBitfields.value >= 5, ReadUIntLE(newOrderCrossMultilegBitfield4.rest, 1), newOrderCrossMultilegBitfield4.rest) IN IF ~newOrderCrossMultilegBitfield5.ok THEN Fail ELSE
    LET newOrderCrossMultilegBitfield6 == ReadWhen(numberOfNewOrderCrossMultilegBitfields.value >= 6, ReadBytes(newOrderCrossMultilegBitfield5.rest, 1), newOrderCrossMultilegBitfield5.rest) IN IF ~newOrderCrossMultilegBitfield6.ok THEN Fail ELSE
    LET groupCnt == ReadUIntLE(newOrderCrossMultilegBitfield6.rest, 2) IN IF ~groupCnt.ok THEN Fail ELSE
    LET newOrderCrossMultilegOrderAllocations == ReadNewOrderCrossMultilegOrderAllocationsList(groupCnt.rest, groupCnt.value, numberOfNewOrderCrossMultilegBitfields.value, newOrderCrossMultilegBitfield2.value, newOrderCrossMultilegBitfield4.value, newOrderCrossMultilegBitfield5.value) IN IF ~newOrderCrossMultilegOrderAllocations.ok THEN Fail ELSE
    LET symbolLong == ReadWhen(numberOfNewOrderCrossMultilegBitfields.value >= 1 /\ (newOrderCrossMultilegBitfield1.value # << >> /\ newOrderCrossMultilegBitfield1.value[1] % 2 > 0), ReadBytes(newOrderCrossMultilegOrderAllocations.rest, 8), newOrderCrossMultilegOrderAllocations.rest) IN IF ~symbolLong.ok THEN Fail ELSE
    LET execInst == ReadWhen(numberOfNewOrderCrossMultilegBitfields.value >= 1 /\ (newOrderCrossMultilegBitfield1.value # << >> /\ (newOrderCrossMultilegBitfield1.value[1] \div 16) % 2 > 0), ReadBytes(symbolLong.rest, 1), symbolLong.rest) IN IF ~execInst.ok THEN Fail ELSE
    LET attributedQuote == ReadWhen(numberOfNewOrderCrossMultilegBitfields.value >= 1 /\ (newOrderCrossMultilegBitfield1.value # << >> /\ (newOrderCrossMultilegBitfield1.value[1] \div 32) % 2 > 0), ReadBytes(execInst.rest, 1), execInst.rest) IN IF ~attributedQuote.ok THEN Fail ELSE
    LET targetPartyId == ReadWhen(numberOfNewOrderCrossMultilegBitfields.value >= 1 /\ (newOrderCrossMultilegBitfield1.value # << >> /\ (newOrderCrossMultilegBitfield1.value[1] \div 64) % 2 > 0), ReadBytes(attributedQuote.rest, 4), attributedQuote.rest) IN IF ~targetPartyId.ok THEN Fail ELSE
    LET preventMatch == ReadWhen(numberOfNewOrderCrossMultilegBitfields.value >= 1 /\ (newOrderCrossMultilegBitfield1.value # << >> /\ (newOrderCrossMultilegBitfield1.value[1] \div 128) % 2 > 0), ReadBytes(targetPartyId.rest, 3), targetPartyId.rest) IN IF ~preventMatch.ok THEN Fail ELSE
    LET autoMatch == ReadWhen(numberOfNewOrderCrossMultilegBitfields.value >= 2 /\ (newOrderCrossMultilegBitfield2.value # << >> /\ newOrderCrossMultilegBitfield2.value[1] % 2 > 0), ReadBytes(preventMatch.rest, 1), preventMatch.rest) IN IF ~autoMatch.ok THEN Fail ELSE
    LET autoMatchPrice == ReadWhen(numberOfNewOrderCrossMultilegBitfields.value >= 2 /\ (newOrderCrossMultilegBitfield2.value # << >> /\ (newOrderCrossMultilegBitfield2.value[1] \div 2) % 2 > 0), ReadBytes(autoMatch.rest, 8), autoMatch.rest) IN IF ~autoMatchPrice.ok THEN Fail ELSE
    LET lastPriority == ReadWhen(numberOfNewOrderCrossMultilegBitfields.value >= 2 /\ (newOrderCrossMultilegBitfield2.value # << >> /\ (newOrderCrossMultilegBitfield2.value[1] \div 4) % 2 > 0), ReadBytes(autoMatchPrice.rest, 1), autoMatchPrice.rest) IN IF ~lastPriority.ok THEN Fail ELSE
    LET routingFirmId == ReadWhen(numberOfNewOrderCrossMultilegBitfields.value >= 2 /\ (newOrderCrossMultilegBitfield2.value # << >> /\ (newOrderCrossMultilegBitfield2.value[1] \div 64) % 2 > 0), ReadBytes(lastPriority.rest, 4), lastPriority.rest) IN IF ~routingFirmId.ok THEN Fail ELSE
    LET clientIdAttr == ReadWhen(numberOfNewOrderCrossMultilegBitfields.value >= 3 /\ (newOrderCrossMultilegBitfield3.value # << >> /\ newOrderCrossMultilegBitfield3.value[1] % 2 > 0), ReadBytes(routingFirmId.rest, 4), routingFirmId.rest) IN IF ~clientIdAttr.ok THEN Fail ELSE
    LET equityTradePrice == ReadWhen(numberOfNewOrderCrossMultilegBitfields.value >= 3 /\ (newOrderCrossMultilegBitfield3.value # << >> /\ (newOrderCrossMultilegBitfield3.value[1] \div 2) % 2 > 0), ReadBytes(clientIdAttr.rest, 8), clientIdAttr.rest) IN IF ~equityTradePrice.ok THEN Fail ELSE
    LET equityTradeSize == ReadWhen(numberOfNewOrderCrossMultilegBitfields.value >= 3 /\ (newOrderCrossMultilegBitfield3.value # << >> /\ (newOrderCrossMultilegBitfield3.value[1] \div 4) % 2 > 0), ReadBytes(equityTradePrice.rest, 4), equityTradePrice.rest) IN IF ~equityTradeSize.ok THEN Fail ELSE
    LET equityTradeVenue == ReadWhen(numberOfNewOrderCrossMultilegBitfields.value >= 3 /\ (newOrderCrossMultilegBitfield3.value # << >> /\ (newOrderCrossMultilegBitfield3.value[1] \div 8) % 2 > 0), ReadBytes(equityTradeSize.rest, 1), equityTradeSize.rest) IN IF ~equityTradeVenue.ok THEN Fail ELSE
    LET equityTransactTime == ReadWhen(numberOfNewOrderCrossMultilegBitfields.value >= 3 /\ (newOrderCrossMultilegBitfield3.value # << >> /\ (newOrderCrossMultilegBitfield3.value[1] \div 16) % 2 > 0), ReadBytes(equityTradeVenue.rest, 8), equityTradeVenue.rest) IN IF ~equityTransactTime.ok THEN Fail ELSE
    LET equityBuyClearingFirm == ReadWhen(numberOfNewOrderCrossMultilegBitfields.value >= 3 /\ (newOrderCrossMultilegBitfield3.value # << >> /\ (newOrderCrossMultilegBitfield3.value[1] \div 32) % 2 > 0), ReadBytes(equityTransactTime.rest, 4), equityTransactTime.rest) IN IF ~equityBuyClearingFirm.ok THEN Fail ELSE
    LET equitySellClearingFirm == ReadWhen(numberOfNewOrderCrossMultilegBitfields.value >= 3 /\ (newOrderCrossMultilegBitfield3.value # << >> /\ (newOrderCrossMultilegBitfield3.value[1] \div 64) % 2 > 0), ReadBytes(equityBuyClearingFirm.rest, 4), equityBuyClearingFirm.rest) IN IF ~equitySellClearingFirm.ok THEN Fail ELSE
    LET sessionEligibility == ReadWhen(numberOfNewOrderCrossMultilegBitfields.value >= 3 /\ (newOrderCrossMultilegBitfield3.value # << >> /\ (newOrderCrossMultilegBitfield3.value[1] \div 128) % 2 > 0), ReadBytes(equitySellClearingFirm.rest, 1), equitySellClearingFirm.rest) IN IF ~sessionEligibility.ok THEN Fail ELSE
    LET drillThruProtection == ReadWhen(numberOfNewOrderCrossMultilegBitfields.value >= 4 /\ (newOrderCrossMultilegBitfield4.value # << >> /\ (newOrderCrossMultilegBitfield4.value[1] \div 16) % 2 > 0), ReadBytes(sessionEligibility.rest, 8), sessionEligibility.rest) IN IF ~drillThruProtection.ok THEN Fail ELSE
    LET equityExDestination == ReadWhen(numberOfNewOrderCrossMultilegBitfields.value >= 4 /\ (newOrderCrossMultilegBitfield4.value # << >> /\ (newOrderCrossMultilegBitfield4.value[1] \div 64) % 2 > 0), ReadBytes(drillThruProtection.rest, 1), drillThruProtection.rest) IN IF ~equityExDestination.ok THEN Fail ELSE
    LET compression == ReadWhen(numberOfNewOrderCrossMultilegBitfields.value >= 4 /\ (newOrderCrossMultilegBitfield4.value # << >> /\ (newOrderCrossMultilegBitfield4.value[1] \div 128) % 2 > 0), ReadBytes(equityExDestination.rest, 1), equityExDestination.rest) IN IF ~compression.ok THEN Fail ELSE
    LET ors == ReadWhen(numberOfNewOrderCrossMultilegBitfields.value >= 5 /\ (newOrderCrossMultilegBitfield5.value # << >> /\ newOrderCrossMultilegBitfield5.value[1] % 2 > 0), ReadBytes(compression.rest, 1), compression.rest) IN IF ~ors.ok THEN Fail ELSE
    LET crossInitiator == ReadWhen(numberOfNewOrderCrossMultilegBitfields.value >= 5 /\ (newOrderCrossMultilegBitfield5.value # << >> /\ (newOrderCrossMultilegBitfield5.value[1] \div 4) % 2 > 0), ReadBytes(ors.rest, 4), ors.rest) IN IF ~crossInitiator.ok THEN Fail ELSE
    LET crossOnBehalfOfId == ReadWhen(numberOfNewOrderCrossMultilegBitfields.value >= 5 /\ (newOrderCrossMultilegBitfield5.value # << >> /\ (newOrderCrossMultilegBitfield5.value[1] \div 16) % 2 > 0), ReadBytes(crossInitiator.rest, 4), crossInitiator.rest) IN IF ~crossOnBehalfOfId.ok THEN Fail ELSE
    Ok([ crossId                                |-> crossId.value,
         crossType                              |-> crossType.value,
         crossPrioritization                    |-> crossPrioritization.value,
         priceLong                              |-> priceLong.value,
         orderQtyLong                           |-> orderQtyLong.value,
         numberOfNewOrderCrossMultilegBitfields |-> numberOfNewOrderCrossMultilegBitfields.value,
         newOrderCrossMultilegBitfield1         |-> newOrderCrossMultilegBitfield1.value,
         newOrderCrossMultilegBitfield2         |-> newOrderCrossMultilegBitfield2.value,
         newOrderCrossMultilegBitfield3         |-> newOrderCrossMultilegBitfield3.value,
         newOrderCrossMultilegBitfield4         |-> newOrderCrossMultilegBitfield4.value,
         newOrderCrossMultilegBitfield5         |-> newOrderCrossMultilegBitfield5.value,
         newOrderCrossMultilegBitfield6         |-> newOrderCrossMultilegBitfield6.value,
         newOrderCrossMultilegOrderAllocations  |-> newOrderCrossMultilegOrderAllocations.value,
         symbolLong                             |-> symbolLong.value,
         execInst                               |-> execInst.value,
         attributedQuote                        |-> attributedQuote.value,
         targetPartyId                          |-> targetPartyId.value,
         preventMatch                           |-> preventMatch.value,
         autoMatch                              |-> autoMatch.value,
         autoMatchPrice                         |-> autoMatchPrice.value,
         lastPriority                           |-> lastPriority.value,
         routingFirmId                          |-> routingFirmId.value,
         clientIdAttr                           |-> clientIdAttr.value,
         equityTradePrice                       |-> equityTradePrice.value,
         equityTradeSize                        |-> equityTradeSize.value,
         equityTradeVenue                       |-> equityTradeVenue.value,
         equityTransactTime                     |-> equityTransactTime.value,
         equityBuyClearingFirm                  |-> equityBuyClearingFirm.value,
         equitySellClearingFirm                 |-> equitySellClearingFirm.value,
         sessionEligibility                     |-> sessionEligibility.value,
         drillThruProtection                    |-> drillThruProtection.value,
         equityExDestination                    |-> equityExDestination.value,
         compression                            |-> compression.value,
         ors                                    |-> ors.value,
         crossInitiator                         |-> crossInitiator.value,
         crossOnBehalfOfId                      |-> crossOnBehalfOfId.value ], crossOnBehalfOfId.rest)

(* New Order Cross Multileg Message with each field marked present by fields before it there exactly where they say *)
SettleNewOrderCrossMultilegMessage(message) ==
    LET settled1 == [message EXCEPT !.newOrderCrossMultilegBitfield1 = IF message.numberOfNewOrderCrossMultilegBitfields >= 1 THEN (IF message.newOrderCrossMultilegBitfield1 = << >> THEN <<0>> ELSE message.newOrderCrossMultilegBitfield1) ELSE << >>]
        settled2 == [settled1 EXCEPT !.newOrderCrossMultilegBitfield2 = IF settled1.numberOfNewOrderCrossMultilegBitfields >= 2 THEN (IF settled1.newOrderCrossMultilegBitfield2 = << >> THEN <<0>> ELSE settled1.newOrderCrossMultilegBitfield2) ELSE << >>]
        settled3 == [settled2 EXCEPT !.newOrderCrossMultilegBitfield3 = IF settled2.numberOfNewOrderCrossMultilegBitfields >= 3 THEN (IF settled2.newOrderCrossMultilegBitfield3 = << >> THEN <<0>> ELSE settled2.newOrderCrossMultilegBitfield3) ELSE << >>]
        settled4 == [settled3 EXCEPT !.newOrderCrossMultilegBitfield4 = IF settled3.numberOfNewOrderCrossMultilegBitfields >= 4 THEN (IF settled3.newOrderCrossMultilegBitfield4 = << >> THEN <<0>> ELSE settled3.newOrderCrossMultilegBitfield4) ELSE << >>]
        settled5 == [settled4 EXCEPT !.newOrderCrossMultilegBitfield5 = IF settled4.numberOfNewOrderCrossMultilegBitfields >= 5 THEN (IF settled4.newOrderCrossMultilegBitfield5 = << >> THEN <<0>> ELSE settled4.newOrderCrossMultilegBitfield5) ELSE << >>]
        settled6 == [settled5 EXCEPT !.newOrderCrossMultilegBitfield6 = IF settled5.numberOfNewOrderCrossMultilegBitfields >= 6 THEN (IF settled5.newOrderCrossMultilegBitfield6 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled5.newOrderCrossMultilegBitfield6) ELSE << >>]
        settled7 == [settled6 EXCEPT !.newOrderCrossMultilegOrderAllocations = [i \in DOMAIN settled6.newOrderCrossMultilegOrderAllocations |-> SettleNewOrderCrossMultilegOrderAllocations(settled6.newOrderCrossMultilegOrderAllocations[i], settled6.numberOfNewOrderCrossMultilegBitfields, settled6.newOrderCrossMultilegBitfield2, settled6.newOrderCrossMultilegBitfield4, settled6.newOrderCrossMultilegBitfield5)]]
        settled8 == [settled7 EXCEPT !.symbolLong = IF settled7.numberOfNewOrderCrossMultilegBitfields >= 1 /\ (settled7.newOrderCrossMultilegBitfield1 # << >> /\ settled7.newOrderCrossMultilegBitfield1[1] % 2 > 0) THEN (IF settled7.symbolLong = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled7.symbolLong) ELSE << >>]
        settled9 == [settled8 EXCEPT !.execInst = IF settled8.numberOfNewOrderCrossMultilegBitfields >= 1 /\ (settled8.newOrderCrossMultilegBitfield1 # << >> /\ (settled8.newOrderCrossMultilegBitfield1[1] \div 16) % 2 > 0) THEN (IF settled8.execInst = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled8.execInst) ELSE << >>]
        settled10 == [settled9 EXCEPT !.attributedQuote = IF settled9.numberOfNewOrderCrossMultilegBitfields >= 1 /\ (settled9.newOrderCrossMultilegBitfield1 # << >> /\ (settled9.newOrderCrossMultilegBitfield1[1] \div 32) % 2 > 0) THEN (IF settled9.attributedQuote = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled9.attributedQuote) ELSE << >>]
        settled11 == [settled10 EXCEPT !.targetPartyId = IF settled10.numberOfNewOrderCrossMultilegBitfields >= 1 /\ (settled10.newOrderCrossMultilegBitfield1 # << >> /\ (settled10.newOrderCrossMultilegBitfield1[1] \div 64) % 2 > 0) THEN (IF settled10.targetPartyId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled10.targetPartyId) ELSE << >>]
        settled12 == [settled11 EXCEPT !.preventMatch = IF settled11.numberOfNewOrderCrossMultilegBitfields >= 1 /\ (settled11.newOrderCrossMultilegBitfield1 # << >> /\ (settled11.newOrderCrossMultilegBitfield1[1] \div 128) % 2 > 0) THEN (IF settled11.preventMatch = << >> THEN <<[i \in 1 .. 3 |-> 0]>> ELSE settled11.preventMatch) ELSE << >>]
        settled13 == [settled12 EXCEPT !.autoMatch = IF settled12.numberOfNewOrderCrossMultilegBitfields >= 2 /\ (settled12.newOrderCrossMultilegBitfield2 # << >> /\ settled12.newOrderCrossMultilegBitfield2[1] % 2 > 0) THEN (IF settled12.autoMatch = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled12.autoMatch) ELSE << >>]
        settled14 == [settled13 EXCEPT !.autoMatchPrice = IF settled13.numberOfNewOrderCrossMultilegBitfields >= 2 /\ (settled13.newOrderCrossMultilegBitfield2 # << >> /\ (settled13.newOrderCrossMultilegBitfield2[1] \div 2) % 2 > 0) THEN (IF settled13.autoMatchPrice = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled13.autoMatchPrice) ELSE << >>]
        settled15 == [settled14 EXCEPT !.lastPriority = IF settled14.numberOfNewOrderCrossMultilegBitfields >= 2 /\ (settled14.newOrderCrossMultilegBitfield2 # << >> /\ (settled14.newOrderCrossMultilegBitfield2[1] \div 4) % 2 > 0) THEN (IF settled14.lastPriority = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled14.lastPriority) ELSE << >>]
        settled16 == [settled15 EXCEPT !.routingFirmId = IF settled15.numberOfNewOrderCrossMultilegBitfields >= 2 /\ (settled15.newOrderCrossMultilegBitfield2 # << >> /\ (settled15.newOrderCrossMultilegBitfield2[1] \div 64) % 2 > 0) THEN (IF settled15.routingFirmId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled15.routingFirmId) ELSE << >>]
        settled17 == [settled16 EXCEPT !.clientIdAttr = IF settled16.numberOfNewOrderCrossMultilegBitfields >= 3 /\ (settled16.newOrderCrossMultilegBitfield3 # << >> /\ settled16.newOrderCrossMultilegBitfield3[1] % 2 > 0) THEN (IF settled16.clientIdAttr = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled16.clientIdAttr) ELSE << >>]
        settled18 == [settled17 EXCEPT !.equityTradePrice = IF settled17.numberOfNewOrderCrossMultilegBitfields >= 3 /\ (settled17.newOrderCrossMultilegBitfield3 # << >> /\ (settled17.newOrderCrossMultilegBitfield3[1] \div 2) % 2 > 0) THEN (IF settled17.equityTradePrice = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled17.equityTradePrice) ELSE << >>]
        settled19 == [settled18 EXCEPT !.equityTradeSize = IF settled18.numberOfNewOrderCrossMultilegBitfields >= 3 /\ (settled18.newOrderCrossMultilegBitfield3 # << >> /\ (settled18.newOrderCrossMultilegBitfield3[1] \div 4) % 2 > 0) THEN (IF settled18.equityTradeSize = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled18.equityTradeSize) ELSE << >>]
        settled20 == [settled19 EXCEPT !.equityTradeVenue = IF settled19.numberOfNewOrderCrossMultilegBitfields >= 3 /\ (settled19.newOrderCrossMultilegBitfield3 # << >> /\ (settled19.newOrderCrossMultilegBitfield3[1] \div 8) % 2 > 0) THEN (IF settled19.equityTradeVenue = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled19.equityTradeVenue) ELSE << >>]
        settled21 == [settled20 EXCEPT !.equityTransactTime = IF settled20.numberOfNewOrderCrossMultilegBitfields >= 3 /\ (settled20.newOrderCrossMultilegBitfield3 # << >> /\ (settled20.newOrderCrossMultilegBitfield3[1] \div 16) % 2 > 0) THEN (IF settled20.equityTransactTime = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled20.equityTransactTime) ELSE << >>]
        settled22 == [settled21 EXCEPT !.equityBuyClearingFirm = IF settled21.numberOfNewOrderCrossMultilegBitfields >= 3 /\ (settled21.newOrderCrossMultilegBitfield3 # << >> /\ (settled21.newOrderCrossMultilegBitfield3[1] \div 32) % 2 > 0) THEN (IF settled21.equityBuyClearingFirm = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled21.equityBuyClearingFirm) ELSE << >>]
        settled23 == [settled22 EXCEPT !.equitySellClearingFirm = IF settled22.numberOfNewOrderCrossMultilegBitfields >= 3 /\ (settled22.newOrderCrossMultilegBitfield3 # << >> /\ (settled22.newOrderCrossMultilegBitfield3[1] \div 64) % 2 > 0) THEN (IF settled22.equitySellClearingFirm = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled22.equitySellClearingFirm) ELSE << >>]
        settled24 == [settled23 EXCEPT !.sessionEligibility = IF settled23.numberOfNewOrderCrossMultilegBitfields >= 3 /\ (settled23.newOrderCrossMultilegBitfield3 # << >> /\ (settled23.newOrderCrossMultilegBitfield3[1] \div 128) % 2 > 0) THEN (IF settled23.sessionEligibility = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled23.sessionEligibility) ELSE << >>]
        settled25 == [settled24 EXCEPT !.drillThruProtection = IF settled24.numberOfNewOrderCrossMultilegBitfields >= 4 /\ (settled24.newOrderCrossMultilegBitfield4 # << >> /\ (settled24.newOrderCrossMultilegBitfield4[1] \div 16) % 2 > 0) THEN (IF settled24.drillThruProtection = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled24.drillThruProtection) ELSE << >>]
        settled26 == [settled25 EXCEPT !.equityExDestination = IF settled25.numberOfNewOrderCrossMultilegBitfields >= 4 /\ (settled25.newOrderCrossMultilegBitfield4 # << >> /\ (settled25.newOrderCrossMultilegBitfield4[1] \div 64) % 2 > 0) THEN (IF settled25.equityExDestination = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled25.equityExDestination) ELSE << >>]
        settled27 == [settled26 EXCEPT !.compression = IF settled26.numberOfNewOrderCrossMultilegBitfields >= 4 /\ (settled26.newOrderCrossMultilegBitfield4 # << >> /\ (settled26.newOrderCrossMultilegBitfield4[1] \div 128) % 2 > 0) THEN (IF settled26.compression = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled26.compression) ELSE << >>]
        settled28 == [settled27 EXCEPT !.ors = IF settled27.numberOfNewOrderCrossMultilegBitfields >= 5 /\ (settled27.newOrderCrossMultilegBitfield5 # << >> /\ settled27.newOrderCrossMultilegBitfield5[1] % 2 > 0) THEN (IF settled27.ors = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled27.ors) ELSE << >>]
        settled29 == [settled28 EXCEPT !.crossInitiator = IF settled28.numberOfNewOrderCrossMultilegBitfields >= 5 /\ (settled28.newOrderCrossMultilegBitfield5 # << >> /\ (settled28.newOrderCrossMultilegBitfield5[1] \div 4) % 2 > 0) THEN (IF settled28.crossInitiator = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled28.crossInitiator) ELSE << >>]
        settled30 == [settled29 EXCEPT !.crossOnBehalfOfId = IF settled29.numberOfNewOrderCrossMultilegBitfields >= 5 /\ (settled29.newOrderCrossMultilegBitfield5 # << >> /\ (settled29.newOrderCrossMultilegBitfield5[1] \div 16) % 2 > 0) THEN (IF settled29.crossOnBehalfOfId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled29.crossOnBehalfOfId) ELSE << >>]
    IN  settled30

ZeroNewOrderCrossMultilegMessage ==
    SettleNewOrderCrossMultilegMessage([ crossId                                |-> [i \in 1 .. 20 |-> 0],
                                         crossType                              |-> [i \in 1 .. 1 |-> 0],
                                         crossPrioritization                    |-> [i \in 1 .. 1 |-> 0],
                                         priceLong                              |-> [i \in 1 .. 8 |-> 0],
                                         orderQtyLong                           |-> [i \in 1 .. 4 |-> 0],
                                         numberOfNewOrderCrossMultilegBitfields |-> 0,
                                         newOrderCrossMultilegBitfield1         |-> << >>,
                                         newOrderCrossMultilegBitfield2         |-> << >>,
                                         newOrderCrossMultilegBitfield3         |-> << >>,
                                         newOrderCrossMultilegBitfield4         |-> << >>,
                                         newOrderCrossMultilegBitfield5         |-> << >>,
                                         newOrderCrossMultilegBitfield6         |-> << >>,
                                         newOrderCrossMultilegOrderAllocations  |-> << >>,
                                         symbolLong                             |-> << >>,
                                         execInst                               |-> << >>,
                                         attributedQuote                        |-> << >>,
                                         targetPartyId                          |-> << >>,
                                         preventMatch                           |-> << >>,
                                         autoMatch                              |-> << >>,
                                         autoMatchPrice                         |-> << >>,
                                         lastPriority                           |-> << >>,
                                         routingFirmId                          |-> << >>,
                                         clientIdAttr                           |-> << >>,
                                         equityTradePrice                       |-> << >>,
                                         equityTradeSize                        |-> << >>,
                                         equityTradeVenue                       |-> << >>,
                                         equityTransactTime                     |-> << >>,
                                         equityBuyClearingFirm                  |-> << >>,
                                         equitySellClearingFirm                 |-> << >>,
                                         sessionEligibility                     |-> << >>,
                                         drillThruProtection                    |-> << >>,
                                         equityExDestination                    |-> << >>,
                                         compression                            |-> << >>,
                                         ors                                    |-> << >>,
                                         crossInitiator                         |-> << >>,
                                         crossOnBehalfOfId                      |-> << >> ])

(* New Order Cross Multileg Message at zero, then each field in turn at the values it is checked at *)
CheckedNewOrderCrossMultilegMessage ==
    { ZeroNewOrderCrossMultilegMessage }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.crossId = one]) : one \in Sample(20) }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.crossType = one]) : one \in Sample(1) }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.crossPrioritization = one]) : one \in Sample(1) }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.priceLong = one]) : one \in Sample(8) }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.orderQtyLong = one]) : one \in Sample(4) }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = one]) : one \in {0, 1, 255} }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 1, !.newOrderCrossMultilegBitfield1 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 2, !.newOrderCrossMultilegBitfield2 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 3, !.newOrderCrossMultilegBitfield3 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 4, !.newOrderCrossMultilegBitfield4 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 5, !.newOrderCrossMultilegBitfield5 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 6, !.newOrderCrossMultilegBitfield6 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.newOrderCrossMultilegOrderAllocations = one]) : one \in SampleLists(OneNewOrderCrossMultilegOrderAllocations) }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 2, !.newOrderCrossMultilegBitfield2 = <<8>>, !.newOrderCrossMultilegOrderAllocations = one]) : one \in SampleLists(OneNewOrderCrossMultilegOrderAllocations) }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 2, !.newOrderCrossMultilegBitfield2 = <<16>>, !.newOrderCrossMultilegOrderAllocations = one]) : one \in SampleLists(OneNewOrderCrossMultilegOrderAllocations) }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 2, !.newOrderCrossMultilegBitfield2 = <<32>>, !.newOrderCrossMultilegOrderAllocations = one]) : one \in SampleLists(OneNewOrderCrossMultilegOrderAllocations) }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 2, !.newOrderCrossMultilegBitfield2 = <<128>>, !.newOrderCrossMultilegOrderAllocations = one]) : one \in SampleLists(OneNewOrderCrossMultilegOrderAllocations) }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 4, !.newOrderCrossMultilegBitfield4 = <<1>>, !.newOrderCrossMultilegOrderAllocations = one]) : one \in SampleLists(OneNewOrderCrossMultilegOrderAllocations) }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 4, !.newOrderCrossMultilegBitfield4 = <<2>>, !.newOrderCrossMultilegOrderAllocations = one]) : one \in SampleLists(OneNewOrderCrossMultilegOrderAllocations) }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 5, !.newOrderCrossMultilegBitfield5 = <<2>>, !.newOrderCrossMultilegOrderAllocations = one]) : one \in SampleLists(OneNewOrderCrossMultilegOrderAllocations) }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 5, !.newOrderCrossMultilegBitfield5 = <<8>>, !.newOrderCrossMultilegOrderAllocations = one]) : one \in SampleLists(OneNewOrderCrossMultilegOrderAllocations) }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 1, !.newOrderCrossMultilegBitfield1 = <<1>>, !.symbolLong = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 1, !.newOrderCrossMultilegBitfield1 = <<16>>, !.execInst = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 1, !.newOrderCrossMultilegBitfield1 = <<32>>, !.attributedQuote = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 1, !.newOrderCrossMultilegBitfield1 = <<64>>, !.targetPartyId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 1, !.newOrderCrossMultilegBitfield1 = <<128>>, !.preventMatch = one]) : one \in { <<held>> : held \in Sample(3) } }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 2, !.newOrderCrossMultilegBitfield2 = <<1>>, !.autoMatch = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 2, !.newOrderCrossMultilegBitfield2 = <<2>>, !.autoMatchPrice = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 2, !.newOrderCrossMultilegBitfield2 = <<4>>, !.lastPriority = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 2, !.newOrderCrossMultilegBitfield2 = <<64>>, !.routingFirmId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 3, !.newOrderCrossMultilegBitfield3 = <<1>>, !.clientIdAttr = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 3, !.newOrderCrossMultilegBitfield3 = <<2>>, !.equityTradePrice = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 3, !.newOrderCrossMultilegBitfield3 = <<4>>, !.equityTradeSize = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 3, !.newOrderCrossMultilegBitfield3 = <<8>>, !.equityTradeVenue = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 3, !.newOrderCrossMultilegBitfield3 = <<16>>, !.equityTransactTime = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 3, !.newOrderCrossMultilegBitfield3 = <<32>>, !.equityBuyClearingFirm = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 3, !.newOrderCrossMultilegBitfield3 = <<64>>, !.equitySellClearingFirm = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 3, !.newOrderCrossMultilegBitfield3 = <<128>>, !.sessionEligibility = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 4, !.newOrderCrossMultilegBitfield4 = <<16>>, !.drillThruProtection = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 4, !.newOrderCrossMultilegBitfield4 = <<64>>, !.equityExDestination = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 4, !.newOrderCrossMultilegBitfield4 = <<128>>, !.compression = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 5, !.newOrderCrossMultilegBitfield5 = <<1>>, !.ors = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 5, !.newOrderCrossMultilegBitfield5 = <<4>>, !.crossInitiator = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 5, !.newOrderCrossMultilegBitfield5 = <<16>>, !.crossOnBehalfOfId = one]) : one \in { <<held>> : held \in Sample(4) } }

(***************************************************************************)
(* Cancel Order Message                                                    *)
(***************************************************************************)

CancelOrderMessage ==
    [ origClOrdId                  : Sample(20),
      numberOfCancelOrderBitfields : 0 .. 255,
      cancelOrderBitfield1         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      cancelOrderBitfield2         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      clearingFirm                 : { << >> } \cup { <<held>> : held \in Sample(4) },
      riskRoot                     : { << >> } \cup { <<held>> : held \in Sample(6) },
      massCancelId                 : { << >> } \cup { <<held>> : held \in Sample(20) },
      routingFirmId                : { << >> } \cup { <<held>> : held \in Sample(4) },
      massCancelInst               : { << >> } \cup { <<held>> : held \in Sample(16) },
      sendTime                     : { << >> } \cup { <<held>> : held \in Sample(8) } ]

EncodeCancelOrderMessage(message) ==
    message.origClOrdId
        \o EncodeUIntBE(message.numberOfCancelOrderBitfields, 1)
        \o (IF message.cancelOrderBitfield1 = << >> THEN << >> ELSE EncodeUIntLE(message.cancelOrderBitfield1[1], 1))
        \o (IF message.cancelOrderBitfield2 = << >> THEN << >> ELSE EncodeUIntLE(message.cancelOrderBitfield2[1], 1))
        \o (IF message.clearingFirm = << >> THEN << >> ELSE message.clearingFirm[1])
        \o (IF message.riskRoot = << >> THEN << >> ELSE message.riskRoot[1])
        \o (IF message.massCancelId = << >> THEN << >> ELSE message.massCancelId[1])
        \o (IF message.routingFirmId = << >> THEN << >> ELSE message.routingFirmId[1])
        \o (IF message.massCancelInst = << >> THEN << >> ELSE message.massCancelInst[1])
        \o (IF message.sendTime = << >> THEN << >> ELSE message.sendTime[1])

DecodeCancelOrderMessage(bytes) ==
    LET origClOrdId == ReadBytes(bytes, 20) IN IF ~origClOrdId.ok THEN Fail ELSE
    LET numberOfCancelOrderBitfields == ReadUIntBE(origClOrdId.rest, 1) IN IF ~numberOfCancelOrderBitfields.ok THEN Fail ELSE
    LET cancelOrderBitfield1 == ReadWhen(numberOfCancelOrderBitfields.value >= 1, ReadUIntLE(numberOfCancelOrderBitfields.rest, 1), numberOfCancelOrderBitfields.rest) IN IF ~cancelOrderBitfield1.ok THEN Fail ELSE
    LET cancelOrderBitfield2 == ReadWhen(numberOfCancelOrderBitfields.value >= 2, ReadUIntLE(cancelOrderBitfield1.rest, 1), cancelOrderBitfield1.rest) IN IF ~cancelOrderBitfield2.ok THEN Fail ELSE
    LET clearingFirm == ReadWhen(numberOfCancelOrderBitfields.value >= 1 /\ (cancelOrderBitfield1.value # << >> /\ cancelOrderBitfield1.value[1] % 2 > 0), ReadBytes(cancelOrderBitfield2.rest, 4), cancelOrderBitfield2.rest) IN IF ~clearingFirm.ok THEN Fail ELSE
    LET riskRoot == ReadWhen(numberOfCancelOrderBitfields.value >= 1 /\ (cancelOrderBitfield1.value # << >> /\ (cancelOrderBitfield1.value[1] \div 8) % 2 > 0), ReadBytes(clearingFirm.rest, 6), clearingFirm.rest) IN IF ~riskRoot.ok THEN Fail ELSE
    LET massCancelId == ReadWhen(numberOfCancelOrderBitfields.value >= 1 /\ (cancelOrderBitfield1.value # << >> /\ (cancelOrderBitfield1.value[1] \div 16) % 2 > 0), ReadBytes(riskRoot.rest, 20), riskRoot.rest) IN IF ~massCancelId.ok THEN Fail ELSE
    LET routingFirmId == ReadWhen(numberOfCancelOrderBitfields.value >= 1 /\ (cancelOrderBitfield1.value # << >> /\ (cancelOrderBitfield1.value[1] \div 32) % 2 > 0), ReadBytes(massCancelId.rest, 4), massCancelId.rest) IN IF ~routingFirmId.ok THEN Fail ELSE
    LET massCancelInst == ReadWhen(numberOfCancelOrderBitfields.value >= 2 /\ (cancelOrderBitfield2.value # << >> /\ cancelOrderBitfield2.value[1] % 2 > 0), ReadBytes(routingFirmId.rest, 16), routingFirmId.rest) IN IF ~massCancelInst.ok THEN Fail ELSE
    LET sendTime == ReadWhen(numberOfCancelOrderBitfields.value >= 2 /\ (cancelOrderBitfield2.value # << >> /\ (cancelOrderBitfield2.value[1] \div 8) % 2 > 0), ReadBytes(massCancelInst.rest, 8), massCancelInst.rest) IN IF ~sendTime.ok THEN Fail ELSE
    Ok([ origClOrdId                  |-> origClOrdId.value,
         numberOfCancelOrderBitfields |-> numberOfCancelOrderBitfields.value,
         cancelOrderBitfield1         |-> cancelOrderBitfield1.value,
         cancelOrderBitfield2         |-> cancelOrderBitfield2.value,
         clearingFirm                 |-> clearingFirm.value,
         riskRoot                     |-> riskRoot.value,
         massCancelId                 |-> massCancelId.value,
         routingFirmId                |-> routingFirmId.value,
         massCancelInst               |-> massCancelInst.value,
         sendTime                     |-> sendTime.value ], sendTime.rest)

(* Cancel Order Message with each field marked present by fields before it there exactly where they say *)
SettleCancelOrderMessage(message) ==
    LET settled1 == [message EXCEPT !.cancelOrderBitfield1 = IF message.numberOfCancelOrderBitfields >= 1 THEN (IF message.cancelOrderBitfield1 = << >> THEN <<0>> ELSE message.cancelOrderBitfield1) ELSE << >>]
        settled2 == [settled1 EXCEPT !.cancelOrderBitfield2 = IF settled1.numberOfCancelOrderBitfields >= 2 THEN (IF settled1.cancelOrderBitfield2 = << >> THEN <<0>> ELSE settled1.cancelOrderBitfield2) ELSE << >>]
        settled3 == [settled2 EXCEPT !.clearingFirm = IF settled2.numberOfCancelOrderBitfields >= 1 /\ (settled2.cancelOrderBitfield1 # << >> /\ settled2.cancelOrderBitfield1[1] % 2 > 0) THEN (IF settled2.clearingFirm = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled2.clearingFirm) ELSE << >>]
        settled4 == [settled3 EXCEPT !.riskRoot = IF settled3.numberOfCancelOrderBitfields >= 1 /\ (settled3.cancelOrderBitfield1 # << >> /\ (settled3.cancelOrderBitfield1[1] \div 8) % 2 > 0) THEN (IF settled3.riskRoot = << >> THEN <<[i \in 1 .. 6 |-> 0]>> ELSE settled3.riskRoot) ELSE << >>]
        settled5 == [settled4 EXCEPT !.massCancelId = IF settled4.numberOfCancelOrderBitfields >= 1 /\ (settled4.cancelOrderBitfield1 # << >> /\ (settled4.cancelOrderBitfield1[1] \div 16) % 2 > 0) THEN (IF settled4.massCancelId = << >> THEN <<[i \in 1 .. 20 |-> 0]>> ELSE settled4.massCancelId) ELSE << >>]
        settled6 == [settled5 EXCEPT !.routingFirmId = IF settled5.numberOfCancelOrderBitfields >= 1 /\ (settled5.cancelOrderBitfield1 # << >> /\ (settled5.cancelOrderBitfield1[1] \div 32) % 2 > 0) THEN (IF settled5.routingFirmId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled5.routingFirmId) ELSE << >>]
        settled7 == [settled6 EXCEPT !.massCancelInst = IF settled6.numberOfCancelOrderBitfields >= 2 /\ (settled6.cancelOrderBitfield2 # << >> /\ settled6.cancelOrderBitfield2[1] % 2 > 0) THEN (IF settled6.massCancelInst = << >> THEN <<[i \in 1 .. 16 |-> 0]>> ELSE settled6.massCancelInst) ELSE << >>]
        settled8 == [settled7 EXCEPT !.sendTime = IF settled7.numberOfCancelOrderBitfields >= 2 /\ (settled7.cancelOrderBitfield2 # << >> /\ (settled7.cancelOrderBitfield2[1] \div 8) % 2 > 0) THEN (IF settled7.sendTime = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled7.sendTime) ELSE << >>]
    IN  settled8

ZeroCancelOrderMessage ==
    SettleCancelOrderMessage([ origClOrdId                  |-> [i \in 1 .. 20 |-> 0],
                               numberOfCancelOrderBitfields |-> 0,
                               cancelOrderBitfield1         |-> << >>,
                               cancelOrderBitfield2         |-> << >>,
                               clearingFirm                 |-> << >>,
                               riskRoot                     |-> << >>,
                               massCancelId                 |-> << >>,
                               routingFirmId                |-> << >>,
                               massCancelInst               |-> << >>,
                               sendTime                     |-> << >> ])

(* Cancel Order Message at zero, then each field in turn at the values it is checked at *)
CheckedCancelOrderMessage ==
    { ZeroCancelOrderMessage }
        \cup { SettleCancelOrderMessage([ZeroCancelOrderMessage EXCEPT !.origClOrdId = one]) : one \in Sample(20) }
        \cup { SettleCancelOrderMessage([ZeroCancelOrderMessage EXCEPT !.numberOfCancelOrderBitfields = one]) : one \in {0, 1, 255} }
        \cup { SettleCancelOrderMessage([ZeroCancelOrderMessage EXCEPT !.numberOfCancelOrderBitfields = 1, !.cancelOrderBitfield1 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCancelOrderMessage([ZeroCancelOrderMessage EXCEPT !.numberOfCancelOrderBitfields = 2, !.cancelOrderBitfield2 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCancelOrderMessage([ZeroCancelOrderMessage EXCEPT !.numberOfCancelOrderBitfields = 1, !.cancelOrderBitfield1 = <<1>>, !.clearingFirm = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleCancelOrderMessage([ZeroCancelOrderMessage EXCEPT !.numberOfCancelOrderBitfields = 1, !.cancelOrderBitfield1 = <<8>>, !.riskRoot = one]) : one \in { <<held>> : held \in Sample(6) } }
        \cup { SettleCancelOrderMessage([ZeroCancelOrderMessage EXCEPT !.numberOfCancelOrderBitfields = 1, !.cancelOrderBitfield1 = <<16>>, !.massCancelId = one]) : one \in { <<held>> : held \in Sample(20) } }
        \cup { SettleCancelOrderMessage([ZeroCancelOrderMessage EXCEPT !.numberOfCancelOrderBitfields = 1, !.cancelOrderBitfield1 = <<32>>, !.routingFirmId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleCancelOrderMessage([ZeroCancelOrderMessage EXCEPT !.numberOfCancelOrderBitfields = 2, !.cancelOrderBitfield2 = <<1>>, !.massCancelInst = one]) : one \in { <<held>> : held \in Sample(16) } }
        \cup { SettleCancelOrderMessage([ZeroCancelOrderMessage EXCEPT !.numberOfCancelOrderBitfields = 2, !.cancelOrderBitfield2 = <<8>>, !.sendTime = one]) : one \in { <<held>> : held \in Sample(8) } }

(***************************************************************************)
(* Modify Order Message                                                    *)
(***************************************************************************)

ModifyOrderMessage ==
    [ clOrdId                      : Sample(20),
      origClOrdId                  : Sample(20),
      numberOfModifyOrderBitfields : 0 .. 255,
      modifyOrderBitfield1         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      modifyOrderBitfield2         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      clearingFirm                 : { << >> } \cup { <<held>> : held \in Sample(4) },
      orderQtyLong                 : { << >> } \cup { <<held>> : held \in Sample(4) },
      priceLong                    : { << >> } \cup { <<held>> : held \in Sample(8) },
      ordType                      : { << >> } \cup { <<held>> : held \in Sample(1) },
      cancelOrigOnReject           : { << >> } \cup { <<held>> : held \in Sample(1) },
      execInst                     : { << >> } \cup { <<held>> : held \in Sample(1) },
      maxFloor                     : { << >> } \cup { <<held>> : held \in Sample(4) },
      stopPx                       : { << >> } \cup { <<held>> : held \in Sample(8) },
      routingFirmId                : { << >> } \cup { <<held>> : held \in Sample(4) } ]

EncodeModifyOrderMessage(message) ==
    message.clOrdId
        \o message.origClOrdId
        \o EncodeUIntBE(message.numberOfModifyOrderBitfields, 1)
        \o (IF message.modifyOrderBitfield1 = << >> THEN << >> ELSE EncodeUIntLE(message.modifyOrderBitfield1[1], 1))
        \o (IF message.modifyOrderBitfield2 = << >> THEN << >> ELSE EncodeUIntLE(message.modifyOrderBitfield2[1], 1))
        \o (IF message.clearingFirm = << >> THEN << >> ELSE message.clearingFirm[1])
        \o (IF message.orderQtyLong = << >> THEN << >> ELSE message.orderQtyLong[1])
        \o (IF message.priceLong = << >> THEN << >> ELSE message.priceLong[1])
        \o (IF message.ordType = << >> THEN << >> ELSE message.ordType[1])
        \o (IF message.cancelOrigOnReject = << >> THEN << >> ELSE message.cancelOrigOnReject[1])
        \o (IF message.execInst = << >> THEN << >> ELSE message.execInst[1])
        \o (IF message.maxFloor = << >> THEN << >> ELSE message.maxFloor[1])
        \o (IF message.stopPx = << >> THEN << >> ELSE message.stopPx[1])
        \o (IF message.routingFirmId = << >> THEN << >> ELSE message.routingFirmId[1])

DecodeModifyOrderMessage(bytes) ==
    LET clOrdId == ReadBytes(bytes, 20) IN IF ~clOrdId.ok THEN Fail ELSE
    LET origClOrdId == ReadBytes(clOrdId.rest, 20) IN IF ~origClOrdId.ok THEN Fail ELSE
    LET numberOfModifyOrderBitfields == ReadUIntBE(origClOrdId.rest, 1) IN IF ~numberOfModifyOrderBitfields.ok THEN Fail ELSE
    LET modifyOrderBitfield1 == ReadWhen(numberOfModifyOrderBitfields.value >= 1, ReadUIntLE(numberOfModifyOrderBitfields.rest, 1), numberOfModifyOrderBitfields.rest) IN IF ~modifyOrderBitfield1.ok THEN Fail ELSE
    LET modifyOrderBitfield2 == ReadWhen(numberOfModifyOrderBitfields.value >= 2, ReadUIntLE(modifyOrderBitfield1.rest, 1), modifyOrderBitfield1.rest) IN IF ~modifyOrderBitfield2.ok THEN Fail ELSE
    LET clearingFirm == ReadWhen(numberOfModifyOrderBitfields.value >= 1 /\ (modifyOrderBitfield1.value # << >> /\ modifyOrderBitfield1.value[1] % 2 > 0), ReadBytes(modifyOrderBitfield2.rest, 4), modifyOrderBitfield2.rest) IN IF ~clearingFirm.ok THEN Fail ELSE
    LET orderQtyLong == ReadWhen(numberOfModifyOrderBitfields.value >= 1 /\ (modifyOrderBitfield1.value # << >> /\ (modifyOrderBitfield1.value[1] \div 4) % 2 > 0), ReadBytes(clearingFirm.rest, 4), clearingFirm.rest) IN IF ~orderQtyLong.ok THEN Fail ELSE
    LET priceLong == ReadWhen(numberOfModifyOrderBitfields.value >= 1 /\ (modifyOrderBitfield1.value # << >> /\ (modifyOrderBitfield1.value[1] \div 8) % 2 > 0), ReadBytes(orderQtyLong.rest, 8), orderQtyLong.rest) IN IF ~priceLong.ok THEN Fail ELSE
    LET ordType == ReadWhen(numberOfModifyOrderBitfields.value >= 1 /\ (modifyOrderBitfield1.value # << >> /\ (modifyOrderBitfield1.value[1] \div 16) % 2 > 0), ReadBytes(priceLong.rest, 1), priceLong.rest) IN IF ~ordType.ok THEN Fail ELSE
    LET cancelOrigOnReject == ReadWhen(numberOfModifyOrderBitfields.value >= 1 /\ (modifyOrderBitfield1.value # << >> /\ (modifyOrderBitfield1.value[1] \div 32) % 2 > 0), ReadBytes(ordType.rest, 1), ordType.rest) IN IF ~cancelOrigOnReject.ok THEN Fail ELSE
    LET execInst == ReadWhen(numberOfModifyOrderBitfields.value >= 1 /\ (modifyOrderBitfield1.value # << >> /\ (modifyOrderBitfield1.value[1] \div 64) % 2 > 0), ReadBytes(cancelOrigOnReject.rest, 1), cancelOrigOnReject.rest) IN IF ~execInst.ok THEN Fail ELSE
    LET maxFloor == ReadWhen(numberOfModifyOrderBitfields.value >= 2 /\ (modifyOrderBitfield2.value # << >> /\ modifyOrderBitfield2.value[1] % 2 > 0), ReadBytes(execInst.rest, 4), execInst.rest) IN IF ~maxFloor.ok THEN Fail ELSE
    LET stopPx == ReadWhen(numberOfModifyOrderBitfields.value >= 2 /\ (modifyOrderBitfield2.value # << >> /\ (modifyOrderBitfield2.value[1] \div 2) % 2 > 0), ReadBytes(maxFloor.rest, 8), maxFloor.rest) IN IF ~stopPx.ok THEN Fail ELSE
    LET routingFirmId == ReadWhen(numberOfModifyOrderBitfields.value >= 2 /\ (modifyOrderBitfield2.value # << >> /\ (modifyOrderBitfield2.value[1] \div 4) % 2 > 0), ReadBytes(stopPx.rest, 4), stopPx.rest) IN IF ~routingFirmId.ok THEN Fail ELSE
    Ok([ clOrdId                      |-> clOrdId.value,
         origClOrdId                  |-> origClOrdId.value,
         numberOfModifyOrderBitfields |-> numberOfModifyOrderBitfields.value,
         modifyOrderBitfield1         |-> modifyOrderBitfield1.value,
         modifyOrderBitfield2         |-> modifyOrderBitfield2.value,
         clearingFirm                 |-> clearingFirm.value,
         orderQtyLong                 |-> orderQtyLong.value,
         priceLong                    |-> priceLong.value,
         ordType                      |-> ordType.value,
         cancelOrigOnReject           |-> cancelOrigOnReject.value,
         execInst                     |-> execInst.value,
         maxFloor                     |-> maxFloor.value,
         stopPx                       |-> stopPx.value,
         routingFirmId                |-> routingFirmId.value ], routingFirmId.rest)

(* Modify Order Message with each field marked present by fields before it there exactly where they say *)
SettleModifyOrderMessage(message) ==
    LET settled1 == [message EXCEPT !.modifyOrderBitfield1 = IF message.numberOfModifyOrderBitfields >= 1 THEN (IF message.modifyOrderBitfield1 = << >> THEN <<0>> ELSE message.modifyOrderBitfield1) ELSE << >>]
        settled2 == [settled1 EXCEPT !.modifyOrderBitfield2 = IF settled1.numberOfModifyOrderBitfields >= 2 THEN (IF settled1.modifyOrderBitfield2 = << >> THEN <<0>> ELSE settled1.modifyOrderBitfield2) ELSE << >>]
        settled3 == [settled2 EXCEPT !.clearingFirm = IF settled2.numberOfModifyOrderBitfields >= 1 /\ (settled2.modifyOrderBitfield1 # << >> /\ settled2.modifyOrderBitfield1[1] % 2 > 0) THEN (IF settled2.clearingFirm = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled2.clearingFirm) ELSE << >>]
        settled4 == [settled3 EXCEPT !.orderQtyLong = IF settled3.numberOfModifyOrderBitfields >= 1 /\ (settled3.modifyOrderBitfield1 # << >> /\ (settled3.modifyOrderBitfield1[1] \div 4) % 2 > 0) THEN (IF settled3.orderQtyLong = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled3.orderQtyLong) ELSE << >>]
        settled5 == [settled4 EXCEPT !.priceLong = IF settled4.numberOfModifyOrderBitfields >= 1 /\ (settled4.modifyOrderBitfield1 # << >> /\ (settled4.modifyOrderBitfield1[1] \div 8) % 2 > 0) THEN (IF settled4.priceLong = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled4.priceLong) ELSE << >>]
        settled6 == [settled5 EXCEPT !.ordType = IF settled5.numberOfModifyOrderBitfields >= 1 /\ (settled5.modifyOrderBitfield1 # << >> /\ (settled5.modifyOrderBitfield1[1] \div 16) % 2 > 0) THEN (IF settled5.ordType = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled5.ordType) ELSE << >>]
        settled7 == [settled6 EXCEPT !.cancelOrigOnReject = IF settled6.numberOfModifyOrderBitfields >= 1 /\ (settled6.modifyOrderBitfield1 # << >> /\ (settled6.modifyOrderBitfield1[1] \div 32) % 2 > 0) THEN (IF settled6.cancelOrigOnReject = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled6.cancelOrigOnReject) ELSE << >>]
        settled8 == [settled7 EXCEPT !.execInst = IF settled7.numberOfModifyOrderBitfields >= 1 /\ (settled7.modifyOrderBitfield1 # << >> /\ (settled7.modifyOrderBitfield1[1] \div 64) % 2 > 0) THEN (IF settled7.execInst = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled7.execInst) ELSE << >>]
        settled9 == [settled8 EXCEPT !.maxFloor = IF settled8.numberOfModifyOrderBitfields >= 2 /\ (settled8.modifyOrderBitfield2 # << >> /\ settled8.modifyOrderBitfield2[1] % 2 > 0) THEN (IF settled8.maxFloor = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled8.maxFloor) ELSE << >>]
        settled10 == [settled9 EXCEPT !.stopPx = IF settled9.numberOfModifyOrderBitfields >= 2 /\ (settled9.modifyOrderBitfield2 # << >> /\ (settled9.modifyOrderBitfield2[1] \div 2) % 2 > 0) THEN (IF settled9.stopPx = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled9.stopPx) ELSE << >>]
        settled11 == [settled10 EXCEPT !.routingFirmId = IF settled10.numberOfModifyOrderBitfields >= 2 /\ (settled10.modifyOrderBitfield2 # << >> /\ (settled10.modifyOrderBitfield2[1] \div 4) % 2 > 0) THEN (IF settled10.routingFirmId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled10.routingFirmId) ELSE << >>]
    IN  settled11

ZeroModifyOrderMessage ==
    SettleModifyOrderMessage([ clOrdId                      |-> [i \in 1 .. 20 |-> 0],
                               origClOrdId                  |-> [i \in 1 .. 20 |-> 0],
                               numberOfModifyOrderBitfields |-> 0,
                               modifyOrderBitfield1         |-> << >>,
                               modifyOrderBitfield2         |-> << >>,
                               clearingFirm                 |-> << >>,
                               orderQtyLong                 |-> << >>,
                               priceLong                    |-> << >>,
                               ordType                      |-> << >>,
                               cancelOrigOnReject           |-> << >>,
                               execInst                     |-> << >>,
                               maxFloor                     |-> << >>,
                               stopPx                       |-> << >>,
                               routingFirmId                |-> << >> ])

(* Modify Order Message at zero, then each field in turn at the values it is checked at *)
CheckedModifyOrderMessage ==
    { ZeroModifyOrderMessage }
        \cup { SettleModifyOrderMessage([ZeroModifyOrderMessage EXCEPT !.clOrdId = one]) : one \in Sample(20) }
        \cup { SettleModifyOrderMessage([ZeroModifyOrderMessage EXCEPT !.origClOrdId = one]) : one \in Sample(20) }
        \cup { SettleModifyOrderMessage([ZeroModifyOrderMessage EXCEPT !.numberOfModifyOrderBitfields = one]) : one \in {0, 1, 255} }
        \cup { SettleModifyOrderMessage([ZeroModifyOrderMessage EXCEPT !.numberOfModifyOrderBitfields = 1, !.modifyOrderBitfield1 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleModifyOrderMessage([ZeroModifyOrderMessage EXCEPT !.numberOfModifyOrderBitfields = 2, !.modifyOrderBitfield2 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleModifyOrderMessage([ZeroModifyOrderMessage EXCEPT !.numberOfModifyOrderBitfields = 1, !.modifyOrderBitfield1 = <<1>>, !.clearingFirm = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleModifyOrderMessage([ZeroModifyOrderMessage EXCEPT !.numberOfModifyOrderBitfields = 1, !.modifyOrderBitfield1 = <<4>>, !.orderQtyLong = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleModifyOrderMessage([ZeroModifyOrderMessage EXCEPT !.numberOfModifyOrderBitfields = 1, !.modifyOrderBitfield1 = <<8>>, !.priceLong = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleModifyOrderMessage([ZeroModifyOrderMessage EXCEPT !.numberOfModifyOrderBitfields = 1, !.modifyOrderBitfield1 = <<16>>, !.ordType = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleModifyOrderMessage([ZeroModifyOrderMessage EXCEPT !.numberOfModifyOrderBitfields = 1, !.modifyOrderBitfield1 = <<32>>, !.cancelOrigOnReject = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleModifyOrderMessage([ZeroModifyOrderMessage EXCEPT !.numberOfModifyOrderBitfields = 1, !.modifyOrderBitfield1 = <<64>>, !.execInst = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleModifyOrderMessage([ZeroModifyOrderMessage EXCEPT !.numberOfModifyOrderBitfields = 2, !.modifyOrderBitfield2 = <<1>>, !.maxFloor = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleModifyOrderMessage([ZeroModifyOrderMessage EXCEPT !.numberOfModifyOrderBitfields = 2, !.modifyOrderBitfield2 = <<2>>, !.stopPx = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleModifyOrderMessage([ZeroModifyOrderMessage EXCEPT !.numberOfModifyOrderBitfields = 2, !.modifyOrderBitfield2 = <<4>>, !.routingFirmId = one]) : one \in { <<held>> : held \in Sample(4) } }

(***************************************************************************)
(* Quote: 32 bytes                                                         *)
(***************************************************************************)

Quote ==
    [ symbolShort  : Sample(6),
      side         : Sample(1),
      openClose    : Sample(1),
      priceLong    : Sample(8),
      orderQtyLong : Sample(4),
      reserved12   : Sample(12) ]

EncodeQuote(message) ==
    message.symbolShort
        \o message.side
        \o message.openClose
        \o message.priceLong
        \o message.orderQtyLong
        \o message.reserved12

DecodeQuote(bytes) ==
    LET symbolShort == ReadBytes(bytes, 6) IN IF ~symbolShort.ok THEN Fail ELSE
    LET side == ReadBytes(symbolShort.rest, 1) IN IF ~side.ok THEN Fail ELSE
    LET openClose == ReadBytes(side.rest, 1) IN IF ~openClose.ok THEN Fail ELSE
    LET priceLong == ReadBytes(openClose.rest, 8) IN IF ~priceLong.ok THEN Fail ELSE
    LET orderQtyLong == ReadBytes(priceLong.rest, 4) IN IF ~orderQtyLong.ok THEN Fail ELSE
    LET reserved12 == ReadBytes(orderQtyLong.rest, 12) IN IF ~reserved12.ok THEN Fail ELSE
    Ok([ symbolShort  |-> symbolShort.value,
         side         |-> side.value,
         openClose    |-> openClose.value,
         priceLong    |-> priceLong.value,
         orderQtyLong |-> orderQtyLong.value,
         reserved12   |-> reserved12.value ], reserved12.rest)

ZeroQuote ==
    [ symbolShort  |-> [i \in 1 .. 6 |-> 0],
      side         |-> [i \in 1 .. 1 |-> 0],
      openClose    |-> [i \in 1 .. 1 |-> 0],
      priceLong    |-> [i \in 1 .. 8 |-> 0],
      orderQtyLong |-> [i \in 1 .. 4 |-> 0],
      reserved12   |-> [i \in 1 .. 12 |-> 0] ]

(* Quote at zero, then each field in turn at the values it is checked at *)
CheckedQuote ==
    { ZeroQuote }
        \cup { [ZeroQuote EXCEPT !.symbolShort = one] : one \in Sample(6) }
        \cup { [ZeroQuote EXCEPT !.side = one] : one \in Sample(1) }
        \cup { [ZeroQuote EXCEPT !.openClose = one] : one \in Sample(1) }
        \cup { [ZeroQuote EXCEPT !.priceLong = one] : one \in Sample(8) }
        \cup { [ZeroQuote EXCEPT !.orderQtyLong = one] : one \in Sample(4) }
        \cup { [ZeroQuote EXCEPT !.reserved12 = one] : one \in Sample(12) }

(* A run of Quote, written one after another *)
RECURSIVE EncodeQuoteList(_)
EncodeQuoteList(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeQuote(Head(messages)) \o EncodeQuoteList(Tail(messages))

(* As many Quote as the field that counts them says *)
RECURSIVE ReadQuoteList(_, _)
ReadQuoteList(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeQuote(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadQuoteList(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Quote of each kind, for the lists that carry them *)
OneQuote == { ZeroQuote }

(***************************************************************************)
(* Quote Update Message                                                    *)
(***************************************************************************)

QuoteUpdateMessage ==
    [ quoteUpdateId      : Sample(16),
      clearingFirm       : Sample(4),
      clearingAccount    : Sample(4),
      cmtaNumber         : Sample(4),
      account            : Sample(16),
      customGroupId      : Sample(2),
      capacity           : Sample(1),
      reserved15         : Sample(15),
      sendTime           : Sample(8),
      postingInstruction : Sample(1),
      sessionEligibility : Sample(1),
      quote              : SampleLists(OneQuote) ]

EncodeQuoteUpdateMessage(message) ==
    message.quoteUpdateId
        \o message.clearingFirm
        \o message.clearingAccount
        \o message.cmtaNumber
        \o message.account
        \o message.customGroupId
        \o message.capacity
        \o message.reserved15
        \o message.sendTime
        \o message.postingInstruction
        \o message.sessionEligibility
        \o EncodeUIntBE(Len(message.quote), 1)
        \o EncodeQuoteList(message.quote)

DecodeQuoteUpdateMessage(bytes) ==
    LET quoteUpdateId == ReadBytes(bytes, 16) IN IF ~quoteUpdateId.ok THEN Fail ELSE
    LET clearingFirm == ReadBytes(quoteUpdateId.rest, 4) IN IF ~clearingFirm.ok THEN Fail ELSE
    LET clearingAccount == ReadBytes(clearingFirm.rest, 4) IN IF ~clearingAccount.ok THEN Fail ELSE
    LET cmtaNumber == ReadBytes(clearingAccount.rest, 4) IN IF ~cmtaNumber.ok THEN Fail ELSE
    LET account == ReadBytes(cmtaNumber.rest, 16) IN IF ~account.ok THEN Fail ELSE
    LET customGroupId == ReadBytes(account.rest, 2) IN IF ~customGroupId.ok THEN Fail ELSE
    LET capacity == ReadBytes(customGroupId.rest, 1) IN IF ~capacity.ok THEN Fail ELSE
    LET reserved15 == ReadBytes(capacity.rest, 15) IN IF ~reserved15.ok THEN Fail ELSE
    LET sendTime == ReadBytes(reserved15.rest, 8) IN IF ~sendTime.ok THEN Fail ELSE
    LET postingInstruction == ReadBytes(sendTime.rest, 1) IN IF ~postingInstruction.ok THEN Fail ELSE
    LET sessionEligibility == ReadBytes(postingInstruction.rest, 1) IN IF ~sessionEligibility.ok THEN Fail ELSE
    LET quoteCnt == ReadUIntBE(sessionEligibility.rest, 1) IN IF ~quoteCnt.ok THEN Fail ELSE
    LET quote == ReadQuoteList(quoteCnt.rest, quoteCnt.value) IN IF ~quote.ok THEN Fail ELSE
    Ok([ quoteUpdateId      |-> quoteUpdateId.value,
         clearingFirm       |-> clearingFirm.value,
         clearingAccount    |-> clearingAccount.value,
         cmtaNumber         |-> cmtaNumber.value,
         account            |-> account.value,
         customGroupId      |-> customGroupId.value,
         capacity           |-> capacity.value,
         reserved15         |-> reserved15.value,
         sendTime           |-> sendTime.value,
         postingInstruction |-> postingInstruction.value,
         sessionEligibility |-> sessionEligibility.value,
         quote              |-> quote.value ], quote.rest)

ZeroQuoteUpdateMessage ==
    [ quoteUpdateId      |-> [i \in 1 .. 16 |-> 0],
      clearingFirm       |-> [i \in 1 .. 4 |-> 0],
      clearingAccount    |-> [i \in 1 .. 4 |-> 0],
      cmtaNumber         |-> [i \in 1 .. 4 |-> 0],
      account            |-> [i \in 1 .. 16 |-> 0],
      customGroupId      |-> [i \in 1 .. 2 |-> 0],
      capacity           |-> [i \in 1 .. 1 |-> 0],
      reserved15         |-> [i \in 1 .. 15 |-> 0],
      sendTime           |-> [i \in 1 .. 8 |-> 0],
      postingInstruction |-> [i \in 1 .. 1 |-> 0],
      sessionEligibility |-> [i \in 1 .. 1 |-> 0],
      quote              |-> << >> ]

(* Quote Update Message at zero, then each field in turn at the values it is checked at *)
CheckedQuoteUpdateMessage ==
    { ZeroQuoteUpdateMessage }
        \cup { [ZeroQuoteUpdateMessage EXCEPT !.quoteUpdateId = one] : one \in Sample(16) }
        \cup { [ZeroQuoteUpdateMessage EXCEPT !.clearingFirm = one] : one \in Sample(4) }
        \cup { [ZeroQuoteUpdateMessage EXCEPT !.clearingAccount = one] : one \in Sample(4) }
        \cup { [ZeroQuoteUpdateMessage EXCEPT !.cmtaNumber = one] : one \in Sample(4) }
        \cup { [ZeroQuoteUpdateMessage EXCEPT !.account = one] : one \in Sample(16) }
        \cup { [ZeroQuoteUpdateMessage EXCEPT !.customGroupId = one] : one \in Sample(2) }
        \cup { [ZeroQuoteUpdateMessage EXCEPT !.capacity = one] : one \in Sample(1) }
        \cup { [ZeroQuoteUpdateMessage EXCEPT !.reserved15 = one] : one \in Sample(15) }
        \cup { [ZeroQuoteUpdateMessage EXCEPT !.sendTime = one] : one \in Sample(8) }
        \cup { [ZeroQuoteUpdateMessage EXCEPT !.postingInstruction = one] : one \in Sample(1) }
        \cup { [ZeroQuoteUpdateMessage EXCEPT !.sessionEligibility = one] : one \in Sample(1) }
        \cup { [ZeroQuoteUpdateMessage EXCEPT !.quote = one] : one \in SampleLists(OneQuote) }

(***************************************************************************)
(* Quote Update Short Quote: 16 bytes                                      *)
(***************************************************************************)

QuoteUpdateShortQuote ==
    [ symbolShort   : Sample(6),
      side          : Sample(1),
      openClose     : Sample(1),
      priceShort    : Sample(4),
      orderQtyShort : Sample(2),
      reserved2     : Sample(2) ]

EncodeQuoteUpdateShortQuote(message) ==
    message.symbolShort
        \o message.side
        \o message.openClose
        \o message.priceShort
        \o message.orderQtyShort
        \o message.reserved2

DecodeQuoteUpdateShortQuote(bytes) ==
    LET symbolShort == ReadBytes(bytes, 6) IN IF ~symbolShort.ok THEN Fail ELSE
    LET side == ReadBytes(symbolShort.rest, 1) IN IF ~side.ok THEN Fail ELSE
    LET openClose == ReadBytes(side.rest, 1) IN IF ~openClose.ok THEN Fail ELSE
    LET priceShort == ReadBytes(openClose.rest, 4) IN IF ~priceShort.ok THEN Fail ELSE
    LET orderQtyShort == ReadBytes(priceShort.rest, 2) IN IF ~orderQtyShort.ok THEN Fail ELSE
    LET reserved2 == ReadBytes(orderQtyShort.rest, 2) IN IF ~reserved2.ok THEN Fail ELSE
    Ok([ symbolShort   |-> symbolShort.value,
         side          |-> side.value,
         openClose     |-> openClose.value,
         priceShort    |-> priceShort.value,
         orderQtyShort |-> orderQtyShort.value,
         reserved2     |-> reserved2.value ], reserved2.rest)

ZeroQuoteUpdateShortQuote ==
    [ symbolShort   |-> [i \in 1 .. 6 |-> 0],
      side          |-> [i \in 1 .. 1 |-> 0],
      openClose     |-> [i \in 1 .. 1 |-> 0],
      priceShort    |-> [i \in 1 .. 4 |-> 0],
      orderQtyShort |-> [i \in 1 .. 2 |-> 0],
      reserved2     |-> [i \in 1 .. 2 |-> 0] ]

(* Quote Update Short Quote at zero, then each field in turn at the values it is checked at *)
CheckedQuoteUpdateShortQuote ==
    { ZeroQuoteUpdateShortQuote }
        \cup { [ZeroQuoteUpdateShortQuote EXCEPT !.symbolShort = one] : one \in Sample(6) }
        \cup { [ZeroQuoteUpdateShortQuote EXCEPT !.side = one] : one \in Sample(1) }
        \cup { [ZeroQuoteUpdateShortQuote EXCEPT !.openClose = one] : one \in Sample(1) }
        \cup { [ZeroQuoteUpdateShortQuote EXCEPT !.priceShort = one] : one \in Sample(4) }
        \cup { [ZeroQuoteUpdateShortQuote EXCEPT !.orderQtyShort = one] : one \in Sample(2) }
        \cup { [ZeroQuoteUpdateShortQuote EXCEPT !.reserved2 = one] : one \in Sample(2) }

(* A run of Quote Update Short Quote, written one after another *)
RECURSIVE EncodeQuoteUpdateShortQuoteList(_)
EncodeQuoteUpdateShortQuoteList(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeQuoteUpdateShortQuote(Head(messages)) \o EncodeQuoteUpdateShortQuoteList(Tail(messages))

(* As many Quote Update Short Quote as the field that counts them says *)
RECURSIVE ReadQuoteUpdateShortQuoteList(_, _)
ReadQuoteUpdateShortQuoteList(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeQuoteUpdateShortQuote(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadQuoteUpdateShortQuoteList(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Quote Update Short Quote of each kind, for the lists that carry them *)
OneQuoteUpdateShortQuote == { ZeroQuoteUpdateShortQuote }

(***************************************************************************)
(* Quote Update Short Message                                              *)
(***************************************************************************)

QuoteUpdateShortMessage ==
    [ quoteUpdateId         : Sample(16),
      clearingFirm          : Sample(4),
      clearingAccount       : Sample(4),
      customGroupId         : Sample(2),
      capacity              : Sample(1),
      reserved3             : Sample(3),
      sendTime              : Sample(8),
      postingInstruction    : Sample(1),
      sessionEligibility    : Sample(1),
      quoteUpdateShortQuote : SampleLists(OneQuoteUpdateShortQuote) ]

EncodeQuoteUpdateShortMessage(message) ==
    message.quoteUpdateId
        \o message.clearingFirm
        \o message.clearingAccount
        \o message.customGroupId
        \o message.capacity
        \o message.reserved3
        \o message.sendTime
        \o message.postingInstruction
        \o message.sessionEligibility
        \o EncodeUIntBE(Len(message.quoteUpdateShortQuote), 1)
        \o EncodeQuoteUpdateShortQuoteList(message.quoteUpdateShortQuote)

DecodeQuoteUpdateShortMessage(bytes) ==
    LET quoteUpdateId == ReadBytes(bytes, 16) IN IF ~quoteUpdateId.ok THEN Fail ELSE
    LET clearingFirm == ReadBytes(quoteUpdateId.rest, 4) IN IF ~clearingFirm.ok THEN Fail ELSE
    LET clearingAccount == ReadBytes(clearingFirm.rest, 4) IN IF ~clearingAccount.ok THEN Fail ELSE
    LET customGroupId == ReadBytes(clearingAccount.rest, 2) IN IF ~customGroupId.ok THEN Fail ELSE
    LET capacity == ReadBytes(customGroupId.rest, 1) IN IF ~capacity.ok THEN Fail ELSE
    LET reserved3 == ReadBytes(capacity.rest, 3) IN IF ~reserved3.ok THEN Fail ELSE
    LET sendTime == ReadBytes(reserved3.rest, 8) IN IF ~sendTime.ok THEN Fail ELSE
    LET postingInstruction == ReadBytes(sendTime.rest, 1) IN IF ~postingInstruction.ok THEN Fail ELSE
    LET sessionEligibility == ReadBytes(postingInstruction.rest, 1) IN IF ~sessionEligibility.ok THEN Fail ELSE
    LET quoteCnt == ReadUIntBE(sessionEligibility.rest, 1) IN IF ~quoteCnt.ok THEN Fail ELSE
    LET quoteUpdateShortQuote == ReadQuoteUpdateShortQuoteList(quoteCnt.rest, quoteCnt.value) IN IF ~quoteUpdateShortQuote.ok THEN Fail ELSE
    Ok([ quoteUpdateId         |-> quoteUpdateId.value,
         clearingFirm          |-> clearingFirm.value,
         clearingAccount       |-> clearingAccount.value,
         customGroupId         |-> customGroupId.value,
         capacity              |-> capacity.value,
         reserved3             |-> reserved3.value,
         sendTime              |-> sendTime.value,
         postingInstruction    |-> postingInstruction.value,
         sessionEligibility    |-> sessionEligibility.value,
         quoteUpdateShortQuote |-> quoteUpdateShortQuote.value ], quoteUpdateShortQuote.rest)

ZeroQuoteUpdateShortMessage ==
    [ quoteUpdateId         |-> [i \in 1 .. 16 |-> 0],
      clearingFirm          |-> [i \in 1 .. 4 |-> 0],
      clearingAccount       |-> [i \in 1 .. 4 |-> 0],
      customGroupId         |-> [i \in 1 .. 2 |-> 0],
      capacity              |-> [i \in 1 .. 1 |-> 0],
      reserved3             |-> [i \in 1 .. 3 |-> 0],
      sendTime              |-> [i \in 1 .. 8 |-> 0],
      postingInstruction    |-> [i \in 1 .. 1 |-> 0],
      sessionEligibility    |-> [i \in 1 .. 1 |-> 0],
      quoteUpdateShortQuote |-> << >> ]

(* Quote Update Short Message at zero, then each field in turn at the values it is checked at *)
CheckedQuoteUpdateShortMessage ==
    { ZeroQuoteUpdateShortMessage }
        \cup { [ZeroQuoteUpdateShortMessage EXCEPT !.quoteUpdateId = one] : one \in Sample(16) }
        \cup { [ZeroQuoteUpdateShortMessage EXCEPT !.clearingFirm = one] : one \in Sample(4) }
        \cup { [ZeroQuoteUpdateShortMessage EXCEPT !.clearingAccount = one] : one \in Sample(4) }
        \cup { [ZeroQuoteUpdateShortMessage EXCEPT !.customGroupId = one] : one \in Sample(2) }
        \cup { [ZeroQuoteUpdateShortMessage EXCEPT !.capacity = one] : one \in Sample(1) }
        \cup { [ZeroQuoteUpdateShortMessage EXCEPT !.reserved3 = one] : one \in Sample(3) }
        \cup { [ZeroQuoteUpdateShortMessage EXCEPT !.sendTime = one] : one \in Sample(8) }
        \cup { [ZeroQuoteUpdateShortMessage EXCEPT !.postingInstruction = one] : one \in Sample(1) }
        \cup { [ZeroQuoteUpdateShortMessage EXCEPT !.sessionEligibility = one] : one \in Sample(1) }
        \cup { [ZeroQuoteUpdateShortMessage EXCEPT !.quoteUpdateShortQuote = one] : one \in SampleLists(OneQuoteUpdateShortQuote) }

(***************************************************************************)
(* Quote: 32 bytes                                                         *)
(***************************************************************************)

Quote2 ==
    [ symbolShort  : Sample(6),
      side         : Sample(1),
      openClose    : Sample(1),
      priceLong    : Sample(8),
      orderQtyLong : Sample(4),
      reserved12   : Sample(12) ]

EncodeQuote2(message) ==
    message.symbolShort
        \o message.side
        \o message.openClose
        \o message.priceLong
        \o message.orderQtyLong
        \o message.reserved12

DecodeQuote2(bytes) ==
    LET symbolShort == ReadBytes(bytes, 6) IN IF ~symbolShort.ok THEN Fail ELSE
    LET side == ReadBytes(symbolShort.rest, 1) IN IF ~side.ok THEN Fail ELSE
    LET openClose == ReadBytes(side.rest, 1) IN IF ~openClose.ok THEN Fail ELSE
    LET priceLong == ReadBytes(openClose.rest, 8) IN IF ~priceLong.ok THEN Fail ELSE
    LET orderQtyLong == ReadBytes(priceLong.rest, 4) IN IF ~orderQtyLong.ok THEN Fail ELSE
    LET reserved12 == ReadBytes(orderQtyLong.rest, 12) IN IF ~reserved12.ok THEN Fail ELSE
    Ok([ symbolShort  |-> symbolShort.value,
         side         |-> side.value,
         openClose    |-> openClose.value,
         priceLong    |-> priceLong.value,
         orderQtyLong |-> orderQtyLong.value,
         reserved12   |-> reserved12.value ], reserved12.rest)

ZeroQuote2 ==
    [ symbolShort  |-> [i \in 1 .. 6 |-> 0],
      side         |-> [i \in 1 .. 1 |-> 0],
      openClose    |-> [i \in 1 .. 1 |-> 0],
      priceLong    |-> [i \in 1 .. 8 |-> 0],
      orderQtyLong |-> [i \in 1 .. 4 |-> 0],
      reserved12   |-> [i \in 1 .. 12 |-> 0] ]

(* Quote at zero, then each field in turn at the values it is checked at *)
CheckedQuote2 ==
    { ZeroQuote2 }
        \cup { [ZeroQuote2 EXCEPT !.symbolShort = one] : one \in Sample(6) }
        \cup { [ZeroQuote2 EXCEPT !.side = one] : one \in Sample(1) }
        \cup { [ZeroQuote2 EXCEPT !.openClose = one] : one \in Sample(1) }
        \cup { [ZeroQuote2 EXCEPT !.priceLong = one] : one \in Sample(8) }
        \cup { [ZeroQuote2 EXCEPT !.orderQtyLong = one] : one \in Sample(4) }
        \cup { [ZeroQuote2 EXCEPT !.reserved12 = one] : one \in Sample(12) }

(* A run of Quote, written one after another *)
RECURSIVE EncodeQuote2List(_)
EncodeQuote2List(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeQuote2(Head(messages)) \o EncodeQuote2List(Tail(messages))

(* As many Quote as the field that counts them says *)
RECURSIVE ReadQuote2List(_, _)
ReadQuote2List(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeQuote2(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadQuote2List(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Quote of each kind, for the lists that carry them *)
OneQuote2 == { ZeroQuote2 }

(***************************************************************************)
(* Complex Quote Update Message                                            *)
(***************************************************************************)

ComplexQuoteUpdateMessage ==
    [ quoteUpdateId      : Sample(16),
      clearingFirm       : Sample(4),
      clearingAccount    : Sample(4),
      cmtaNumber         : Sample(4),
      account            : Sample(16),
      customGroupId      : Sample(2),
      capacity           : Sample(1),
      reserved15         : Sample(15),
      sendTime           : Sample(8),
      postingInstruction : Sample(1),
      sessionEligibility : Sample(1),
      quote              : SampleLists(OneQuote2) ]

EncodeComplexQuoteUpdateMessage(message) ==
    message.quoteUpdateId
        \o message.clearingFirm
        \o message.clearingAccount
        \o message.cmtaNumber
        \o message.account
        \o message.customGroupId
        \o message.capacity
        \o message.reserved15
        \o message.sendTime
        \o message.postingInstruction
        \o message.sessionEligibility
        \o EncodeUIntBE(Len(message.quote), 1)
        \o EncodeQuote2List(message.quote)

DecodeComplexQuoteUpdateMessage(bytes) ==
    LET quoteUpdateId == ReadBytes(bytes, 16) IN IF ~quoteUpdateId.ok THEN Fail ELSE
    LET clearingFirm == ReadBytes(quoteUpdateId.rest, 4) IN IF ~clearingFirm.ok THEN Fail ELSE
    LET clearingAccount == ReadBytes(clearingFirm.rest, 4) IN IF ~clearingAccount.ok THEN Fail ELSE
    LET cmtaNumber == ReadBytes(clearingAccount.rest, 4) IN IF ~cmtaNumber.ok THEN Fail ELSE
    LET account == ReadBytes(cmtaNumber.rest, 16) IN IF ~account.ok THEN Fail ELSE
    LET customGroupId == ReadBytes(account.rest, 2) IN IF ~customGroupId.ok THEN Fail ELSE
    LET capacity == ReadBytes(customGroupId.rest, 1) IN IF ~capacity.ok THEN Fail ELSE
    LET reserved15 == ReadBytes(capacity.rest, 15) IN IF ~reserved15.ok THEN Fail ELSE
    LET sendTime == ReadBytes(reserved15.rest, 8) IN IF ~sendTime.ok THEN Fail ELSE
    LET postingInstruction == ReadBytes(sendTime.rest, 1) IN IF ~postingInstruction.ok THEN Fail ELSE
    LET sessionEligibility == ReadBytes(postingInstruction.rest, 1) IN IF ~sessionEligibility.ok THEN Fail ELSE
    LET quoteCnt == ReadUIntBE(sessionEligibility.rest, 1) IN IF ~quoteCnt.ok THEN Fail ELSE
    LET quote == ReadQuote2List(quoteCnt.rest, quoteCnt.value) IN IF ~quote.ok THEN Fail ELSE
    Ok([ quoteUpdateId      |-> quoteUpdateId.value,
         clearingFirm       |-> clearingFirm.value,
         clearingAccount    |-> clearingAccount.value,
         cmtaNumber         |-> cmtaNumber.value,
         account            |-> account.value,
         customGroupId      |-> customGroupId.value,
         capacity           |-> capacity.value,
         reserved15         |-> reserved15.value,
         sendTime           |-> sendTime.value,
         postingInstruction |-> postingInstruction.value,
         sessionEligibility |-> sessionEligibility.value,
         quote              |-> quote.value ], quote.rest)

ZeroComplexQuoteUpdateMessage ==
    [ quoteUpdateId      |-> [i \in 1 .. 16 |-> 0],
      clearingFirm       |-> [i \in 1 .. 4 |-> 0],
      clearingAccount    |-> [i \in 1 .. 4 |-> 0],
      cmtaNumber         |-> [i \in 1 .. 4 |-> 0],
      account            |-> [i \in 1 .. 16 |-> 0],
      customGroupId      |-> [i \in 1 .. 2 |-> 0],
      capacity           |-> [i \in 1 .. 1 |-> 0],
      reserved15         |-> [i \in 1 .. 15 |-> 0],
      sendTime           |-> [i \in 1 .. 8 |-> 0],
      postingInstruction |-> [i \in 1 .. 1 |-> 0],
      sessionEligibility |-> [i \in 1 .. 1 |-> 0],
      quote              |-> << >> ]

(* Complex Quote Update Message at zero, then each field in turn at the values it is checked at *)
CheckedComplexQuoteUpdateMessage ==
    { ZeroComplexQuoteUpdateMessage }
        \cup { [ZeroComplexQuoteUpdateMessage EXCEPT !.quoteUpdateId = one] : one \in Sample(16) }
        \cup { [ZeroComplexQuoteUpdateMessage EXCEPT !.clearingFirm = one] : one \in Sample(4) }
        \cup { [ZeroComplexQuoteUpdateMessage EXCEPT !.clearingAccount = one] : one \in Sample(4) }
        \cup { [ZeroComplexQuoteUpdateMessage EXCEPT !.cmtaNumber = one] : one \in Sample(4) }
        \cup { [ZeroComplexQuoteUpdateMessage EXCEPT !.account = one] : one \in Sample(16) }
        \cup { [ZeroComplexQuoteUpdateMessage EXCEPT !.customGroupId = one] : one \in Sample(2) }
        \cup { [ZeroComplexQuoteUpdateMessage EXCEPT !.capacity = one] : one \in Sample(1) }
        \cup { [ZeroComplexQuoteUpdateMessage EXCEPT !.reserved15 = one] : one \in Sample(15) }
        \cup { [ZeroComplexQuoteUpdateMessage EXCEPT !.sendTime = one] : one \in Sample(8) }
        \cup { [ZeroComplexQuoteUpdateMessage EXCEPT !.postingInstruction = one] : one \in Sample(1) }
        \cup { [ZeroComplexQuoteUpdateMessage EXCEPT !.sessionEligibility = one] : one \in Sample(1) }
        \cup { [ZeroComplexQuoteUpdateMessage EXCEPT !.quote = one] : one \in SampleLists(OneQuote2) }

(***************************************************************************)
(* Complex Quote Update Short Quote: 16 bytes                              *)
(***************************************************************************)

ComplexQuoteUpdateShortQuote ==
    [ symbolShort   : Sample(6),
      side          : Sample(1),
      openClose     : Sample(1),
      priceShort    : Sample(4),
      orderQtyShort : Sample(2),
      reserved2     : Sample(2) ]

EncodeComplexQuoteUpdateShortQuote(message) ==
    message.symbolShort
        \o message.side
        \o message.openClose
        \o message.priceShort
        \o message.orderQtyShort
        \o message.reserved2

DecodeComplexQuoteUpdateShortQuote(bytes) ==
    LET symbolShort == ReadBytes(bytes, 6) IN IF ~symbolShort.ok THEN Fail ELSE
    LET side == ReadBytes(symbolShort.rest, 1) IN IF ~side.ok THEN Fail ELSE
    LET openClose == ReadBytes(side.rest, 1) IN IF ~openClose.ok THEN Fail ELSE
    LET priceShort == ReadBytes(openClose.rest, 4) IN IF ~priceShort.ok THEN Fail ELSE
    LET orderQtyShort == ReadBytes(priceShort.rest, 2) IN IF ~orderQtyShort.ok THEN Fail ELSE
    LET reserved2 == ReadBytes(orderQtyShort.rest, 2) IN IF ~reserved2.ok THEN Fail ELSE
    Ok([ symbolShort   |-> symbolShort.value,
         side          |-> side.value,
         openClose     |-> openClose.value,
         priceShort    |-> priceShort.value,
         orderQtyShort |-> orderQtyShort.value,
         reserved2     |-> reserved2.value ], reserved2.rest)

ZeroComplexQuoteUpdateShortQuote ==
    [ symbolShort   |-> [i \in 1 .. 6 |-> 0],
      side          |-> [i \in 1 .. 1 |-> 0],
      openClose     |-> [i \in 1 .. 1 |-> 0],
      priceShort    |-> [i \in 1 .. 4 |-> 0],
      orderQtyShort |-> [i \in 1 .. 2 |-> 0],
      reserved2     |-> [i \in 1 .. 2 |-> 0] ]

(* Complex Quote Update Short Quote at zero, then each field in turn at the values it is checked at *)
CheckedComplexQuoteUpdateShortQuote ==
    { ZeroComplexQuoteUpdateShortQuote }
        \cup { [ZeroComplexQuoteUpdateShortQuote EXCEPT !.symbolShort = one] : one \in Sample(6) }
        \cup { [ZeroComplexQuoteUpdateShortQuote EXCEPT !.side = one] : one \in Sample(1) }
        \cup { [ZeroComplexQuoteUpdateShortQuote EXCEPT !.openClose = one] : one \in Sample(1) }
        \cup { [ZeroComplexQuoteUpdateShortQuote EXCEPT !.priceShort = one] : one \in Sample(4) }
        \cup { [ZeroComplexQuoteUpdateShortQuote EXCEPT !.orderQtyShort = one] : one \in Sample(2) }
        \cup { [ZeroComplexQuoteUpdateShortQuote EXCEPT !.reserved2 = one] : one \in Sample(2) }

(* A run of Complex Quote Update Short Quote, written one after another *)
RECURSIVE EncodeComplexQuoteUpdateShortQuoteList(_)
EncodeComplexQuoteUpdateShortQuoteList(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeComplexQuoteUpdateShortQuote(Head(messages)) \o EncodeComplexQuoteUpdateShortQuoteList(Tail(messages))

(* As many Complex Quote Update Short Quote as the field that counts them says *)
RECURSIVE ReadComplexQuoteUpdateShortQuoteList(_, _)
ReadComplexQuoteUpdateShortQuoteList(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeComplexQuoteUpdateShortQuote(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadComplexQuoteUpdateShortQuoteList(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Complex Quote Update Short Quote of each kind, for the lists that carry them *)
OneComplexQuoteUpdateShortQuote == { ZeroComplexQuoteUpdateShortQuote }

(***************************************************************************)
(* Complex Quote Update Short Message                                      *)
(***************************************************************************)

ComplexQuoteUpdateShortMessage ==
    [ quoteUpdateId                : Sample(16),
      clearingFirm                 : Sample(4),
      clearingAccount              : Sample(4),
      customGroupId                : Sample(2),
      capacity                     : Sample(1),
      reserved3                    : Sample(3),
      sendTime                     : Sample(8),
      postingInstruction           : Sample(1),
      sessionEligibility           : Sample(1),
      complexQuoteUpdateShortQuote : SampleLists(OneComplexQuoteUpdateShortQuote) ]

EncodeComplexQuoteUpdateShortMessage(message) ==
    message.quoteUpdateId
        \o message.clearingFirm
        \o message.clearingAccount
        \o message.customGroupId
        \o message.capacity
        \o message.reserved3
        \o message.sendTime
        \o message.postingInstruction
        \o message.sessionEligibility
        \o EncodeUIntBE(Len(message.complexQuoteUpdateShortQuote), 1)
        \o EncodeComplexQuoteUpdateShortQuoteList(message.complexQuoteUpdateShortQuote)

DecodeComplexQuoteUpdateShortMessage(bytes) ==
    LET quoteUpdateId == ReadBytes(bytes, 16) IN IF ~quoteUpdateId.ok THEN Fail ELSE
    LET clearingFirm == ReadBytes(quoteUpdateId.rest, 4) IN IF ~clearingFirm.ok THEN Fail ELSE
    LET clearingAccount == ReadBytes(clearingFirm.rest, 4) IN IF ~clearingAccount.ok THEN Fail ELSE
    LET customGroupId == ReadBytes(clearingAccount.rest, 2) IN IF ~customGroupId.ok THEN Fail ELSE
    LET capacity == ReadBytes(customGroupId.rest, 1) IN IF ~capacity.ok THEN Fail ELSE
    LET reserved3 == ReadBytes(capacity.rest, 3) IN IF ~reserved3.ok THEN Fail ELSE
    LET sendTime == ReadBytes(reserved3.rest, 8) IN IF ~sendTime.ok THEN Fail ELSE
    LET postingInstruction == ReadBytes(sendTime.rest, 1) IN IF ~postingInstruction.ok THEN Fail ELSE
    LET sessionEligibility == ReadBytes(postingInstruction.rest, 1) IN IF ~sessionEligibility.ok THEN Fail ELSE
    LET quoteCnt == ReadUIntBE(sessionEligibility.rest, 1) IN IF ~quoteCnt.ok THEN Fail ELSE
    LET complexQuoteUpdateShortQuote == ReadComplexQuoteUpdateShortQuoteList(quoteCnt.rest, quoteCnt.value) IN IF ~complexQuoteUpdateShortQuote.ok THEN Fail ELSE
    Ok([ quoteUpdateId                |-> quoteUpdateId.value,
         clearingFirm                 |-> clearingFirm.value,
         clearingAccount              |-> clearingAccount.value,
         customGroupId                |-> customGroupId.value,
         capacity                     |-> capacity.value,
         reserved3                    |-> reserved3.value,
         sendTime                     |-> sendTime.value,
         postingInstruction           |-> postingInstruction.value,
         sessionEligibility           |-> sessionEligibility.value,
         complexQuoteUpdateShortQuote |-> complexQuoteUpdateShortQuote.value ], complexQuoteUpdateShortQuote.rest)

ZeroComplexQuoteUpdateShortMessage ==
    [ quoteUpdateId                |-> [i \in 1 .. 16 |-> 0],
      clearingFirm                 |-> [i \in 1 .. 4 |-> 0],
      clearingAccount              |-> [i \in 1 .. 4 |-> 0],
      customGroupId                |-> [i \in 1 .. 2 |-> 0],
      capacity                     |-> [i \in 1 .. 1 |-> 0],
      reserved3                    |-> [i \in 1 .. 3 |-> 0],
      sendTime                     |-> [i \in 1 .. 8 |-> 0],
      postingInstruction           |-> [i \in 1 .. 1 |-> 0],
      sessionEligibility           |-> [i \in 1 .. 1 |-> 0],
      complexQuoteUpdateShortQuote |-> << >> ]

(* Complex Quote Update Short Message at zero, then each field in turn at the values it is checked at *)
CheckedComplexQuoteUpdateShortMessage ==
    { ZeroComplexQuoteUpdateShortMessage }
        \cup { [ZeroComplexQuoteUpdateShortMessage EXCEPT !.quoteUpdateId = one] : one \in Sample(16) }
        \cup { [ZeroComplexQuoteUpdateShortMessage EXCEPT !.clearingFirm = one] : one \in Sample(4) }
        \cup { [ZeroComplexQuoteUpdateShortMessage EXCEPT !.clearingAccount = one] : one \in Sample(4) }
        \cup { [ZeroComplexQuoteUpdateShortMessage EXCEPT !.customGroupId = one] : one \in Sample(2) }
        \cup { [ZeroComplexQuoteUpdateShortMessage EXCEPT !.capacity = one] : one \in Sample(1) }
        \cup { [ZeroComplexQuoteUpdateShortMessage EXCEPT !.reserved3 = one] : one \in Sample(3) }
        \cup { [ZeroComplexQuoteUpdateShortMessage EXCEPT !.sendTime = one] : one \in Sample(8) }
        \cup { [ZeroComplexQuoteUpdateShortMessage EXCEPT !.postingInstruction = one] : one \in Sample(1) }
        \cup { [ZeroComplexQuoteUpdateShortMessage EXCEPT !.sessionEligibility = one] : one \in Sample(1) }
        \cup { [ZeroComplexQuoteUpdateShortMessage EXCEPT !.complexQuoteUpdateShortQuote = one] : one \in SampleLists(OneComplexQuoteUpdateShortQuote) }

(***************************************************************************)
(* Custom Group I Ds: 2 bytes                                              *)
(***************************************************************************)

CustomGroupIDs ==
    [ customGroupId : Sample(2) ]

EncodeCustomGroupIDs(message) ==
    message.customGroupId

DecodeCustomGroupIDs(bytes) ==
    LET customGroupId == ReadBytes(bytes, 2) IN IF ~customGroupId.ok THEN Fail ELSE
    Ok([ customGroupId |-> customGroupId.value ], customGroupId.rest)

ZeroCustomGroupIDs ==
    [ customGroupId |-> [i \in 1 .. 2 |-> 0] ]

(* Custom Group I Ds at zero, then each field in turn at the values it is checked at *)
CheckedCustomGroupIDs ==
    { ZeroCustomGroupIDs }
        \cup { [ZeroCustomGroupIDs EXCEPT !.customGroupId = one] : one \in Sample(2) }

(* A run of Custom Group I Ds, written one after another *)
RECURSIVE EncodeCustomGroupIDsList(_)
EncodeCustomGroupIDsList(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeCustomGroupIDs(Head(messages)) \o EncodeCustomGroupIDsList(Tail(messages))

(* As many Custom Group I Ds as the field that counts them says *)
RECURSIVE ReadCustomGroupIDsList(_, _)
ReadCustomGroupIDsList(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeCustomGroupIDs(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadCustomGroupIDsList(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Custom Group I Ds of each kind, for the lists that carry them *)
OneCustomGroupIDs == { ZeroCustomGroupIDs }

(***************************************************************************)
(* Purge Orders Message                                                    *)
(***************************************************************************)

PurgeOrdersMessage ==
    [ reserved1                    : Sample(1),
      numberOfPurgeOrdersBitfields : 0 .. 255,
      purgeOrdersBitfield1         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      purgeOrdersBitfield2         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      customGroupIDs               : SampleLists(OneCustomGroupIDs),
      clearingFirm                 : { << >> } \cup { <<held>> : held \in Sample(4) },
      massCancelInst               : { << >> } \cup { <<held>> : held \in Sample(16) },
      riskRoot                     : { << >> } \cup { <<held>> : held \in Sample(6) },
      massCancelId                 : { << >> } \cup { <<held>> : held \in Sample(20) },
      routingFirmId                : { << >> } \cup { <<held>> : held \in Sample(4) },
      sendTime                     : { << >> } \cup { <<held>> : held \in Sample(8) },
      matchingUnit                 : { << >> } \cup { <<held>> : held \in Sample(1) } ]

EncodePurgeOrdersMessage(message) ==
    message.reserved1
        \o EncodeUIntBE(message.numberOfPurgeOrdersBitfields, 1)
        \o (IF message.purgeOrdersBitfield1 = << >> THEN << >> ELSE EncodeUIntLE(message.purgeOrdersBitfield1[1], 1))
        \o (IF message.purgeOrdersBitfield2 = << >> THEN << >> ELSE EncodeUIntLE(message.purgeOrdersBitfield2[1], 1))
        \o EncodeUIntBE(Len(message.customGroupIDs), 1)
        \o EncodeCustomGroupIDsList(message.customGroupIDs)
        \o (IF message.clearingFirm = << >> THEN << >> ELSE message.clearingFirm[1])
        \o (IF message.massCancelInst = << >> THEN << >> ELSE message.massCancelInst[1])
        \o (IF message.riskRoot = << >> THEN << >> ELSE message.riskRoot[1])
        \o (IF message.massCancelId = << >> THEN << >> ELSE message.massCancelId[1])
        \o (IF message.routingFirmId = << >> THEN << >> ELSE message.routingFirmId[1])
        \o (IF message.sendTime = << >> THEN << >> ELSE message.sendTime[1])
        \o (IF message.matchingUnit = << >> THEN << >> ELSE message.matchingUnit[1])

DecodePurgeOrdersMessage(bytes) ==
    LET reserved1 == ReadBytes(bytes, 1) IN IF ~reserved1.ok THEN Fail ELSE
    LET numberOfPurgeOrdersBitfields == ReadUIntBE(reserved1.rest, 1) IN IF ~numberOfPurgeOrdersBitfields.ok THEN Fail ELSE
    LET purgeOrdersBitfield1 == ReadWhen(numberOfPurgeOrdersBitfields.value >= 1, ReadUIntLE(numberOfPurgeOrdersBitfields.rest, 1), numberOfPurgeOrdersBitfields.rest) IN IF ~purgeOrdersBitfield1.ok THEN Fail ELSE
    LET purgeOrdersBitfield2 == ReadWhen(numberOfPurgeOrdersBitfields.value >= 2, ReadUIntLE(purgeOrdersBitfield1.rest, 1), purgeOrdersBitfield1.rest) IN IF ~purgeOrdersBitfield2.ok THEN Fail ELSE
    LET customGroupIdCnt == ReadUIntBE(purgeOrdersBitfield2.rest, 1) IN IF ~customGroupIdCnt.ok THEN Fail ELSE
    LET customGroupIDs == ReadCustomGroupIDsList(customGroupIdCnt.rest, customGroupIdCnt.value) IN IF ~customGroupIDs.ok THEN Fail ELSE
    LET clearingFirm == ReadWhen(numberOfPurgeOrdersBitfields.value >= 1 /\ (purgeOrdersBitfield1.value # << >> /\ purgeOrdersBitfield1.value[1] % 2 > 0), ReadBytes(customGroupIDs.rest, 4), customGroupIDs.rest) IN IF ~clearingFirm.ok THEN Fail ELSE
    LET massCancelInst == ReadWhen(numberOfPurgeOrdersBitfields.value >= 1 /\ (purgeOrdersBitfield1.value # << >> /\ (purgeOrdersBitfield1.value[1] \div 4) % 2 > 0), ReadBytes(clearingFirm.rest, 16), clearingFirm.rest) IN IF ~massCancelInst.ok THEN Fail ELSE
    LET riskRoot == ReadWhen(numberOfPurgeOrdersBitfields.value >= 1 /\ (purgeOrdersBitfield1.value # << >> /\ (purgeOrdersBitfield1.value[1] \div 8) % 2 > 0), ReadBytes(massCancelInst.rest, 6), massCancelInst.rest) IN IF ~riskRoot.ok THEN Fail ELSE
    LET massCancelId == ReadWhen(numberOfPurgeOrdersBitfields.value >= 1 /\ (purgeOrdersBitfield1.value # << >> /\ (purgeOrdersBitfield1.value[1] \div 16) % 2 > 0), ReadBytes(riskRoot.rest, 20), riskRoot.rest) IN IF ~massCancelId.ok THEN Fail ELSE
    LET routingFirmId == ReadWhen(numberOfPurgeOrdersBitfields.value >= 1 /\ (purgeOrdersBitfield1.value # << >> /\ (purgeOrdersBitfield1.value[1] \div 32) % 2 > 0), ReadBytes(massCancelId.rest, 4), massCancelId.rest) IN IF ~routingFirmId.ok THEN Fail ELSE
    LET sendTime == ReadWhen(numberOfPurgeOrdersBitfields.value >= 2 /\ (purgeOrdersBitfield2.value # << >> /\ (purgeOrdersBitfield2.value[1] \div 64) % 2 > 0), ReadBytes(routingFirmId.rest, 8), routingFirmId.rest) IN IF ~sendTime.ok THEN Fail ELSE
    LET matchingUnit == ReadWhen(numberOfPurgeOrdersBitfields.value >= 2 /\ (purgeOrdersBitfield2.value # << >> /\ (purgeOrdersBitfield2.value[1] \div 128) % 2 > 0), ReadBytes(sendTime.rest, 1), sendTime.rest) IN IF ~matchingUnit.ok THEN Fail ELSE
    Ok([ reserved1                    |-> reserved1.value,
         numberOfPurgeOrdersBitfields |-> numberOfPurgeOrdersBitfields.value,
         purgeOrdersBitfield1         |-> purgeOrdersBitfield1.value,
         purgeOrdersBitfield2         |-> purgeOrdersBitfield2.value,
         customGroupIDs               |-> customGroupIDs.value,
         clearingFirm                 |-> clearingFirm.value,
         massCancelInst               |-> massCancelInst.value,
         riskRoot                     |-> riskRoot.value,
         massCancelId                 |-> massCancelId.value,
         routingFirmId                |-> routingFirmId.value,
         sendTime                     |-> sendTime.value,
         matchingUnit                 |-> matchingUnit.value ], matchingUnit.rest)

(* Purge Orders Message with each field marked present by fields before it there exactly where they say *)
SettlePurgeOrdersMessage(message) ==
    LET settled1 == [message EXCEPT !.purgeOrdersBitfield1 = IF message.numberOfPurgeOrdersBitfields >= 1 THEN (IF message.purgeOrdersBitfield1 = << >> THEN <<0>> ELSE message.purgeOrdersBitfield1) ELSE << >>]
        settled2 == [settled1 EXCEPT !.purgeOrdersBitfield2 = IF settled1.numberOfPurgeOrdersBitfields >= 2 THEN (IF settled1.purgeOrdersBitfield2 = << >> THEN <<0>> ELSE settled1.purgeOrdersBitfield2) ELSE << >>]
        settled3 == [settled2 EXCEPT !.clearingFirm = IF settled2.numberOfPurgeOrdersBitfields >= 1 /\ (settled2.purgeOrdersBitfield1 # << >> /\ settled2.purgeOrdersBitfield1[1] % 2 > 0) THEN (IF settled2.clearingFirm = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled2.clearingFirm) ELSE << >>]
        settled4 == [settled3 EXCEPT !.massCancelInst = IF settled3.numberOfPurgeOrdersBitfields >= 1 /\ (settled3.purgeOrdersBitfield1 # << >> /\ (settled3.purgeOrdersBitfield1[1] \div 4) % 2 > 0) THEN (IF settled3.massCancelInst = << >> THEN <<[i \in 1 .. 16 |-> 0]>> ELSE settled3.massCancelInst) ELSE << >>]
        settled5 == [settled4 EXCEPT !.riskRoot = IF settled4.numberOfPurgeOrdersBitfields >= 1 /\ (settled4.purgeOrdersBitfield1 # << >> /\ (settled4.purgeOrdersBitfield1[1] \div 8) % 2 > 0) THEN (IF settled4.riskRoot = << >> THEN <<[i \in 1 .. 6 |-> 0]>> ELSE settled4.riskRoot) ELSE << >>]
        settled6 == [settled5 EXCEPT !.massCancelId = IF settled5.numberOfPurgeOrdersBitfields >= 1 /\ (settled5.purgeOrdersBitfield1 # << >> /\ (settled5.purgeOrdersBitfield1[1] \div 16) % 2 > 0) THEN (IF settled5.massCancelId = << >> THEN <<[i \in 1 .. 20 |-> 0]>> ELSE settled5.massCancelId) ELSE << >>]
        settled7 == [settled6 EXCEPT !.routingFirmId = IF settled6.numberOfPurgeOrdersBitfields >= 1 /\ (settled6.purgeOrdersBitfield1 # << >> /\ (settled6.purgeOrdersBitfield1[1] \div 32) % 2 > 0) THEN (IF settled6.routingFirmId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled6.routingFirmId) ELSE << >>]
        settled8 == [settled7 EXCEPT !.sendTime = IF settled7.numberOfPurgeOrdersBitfields >= 2 /\ (settled7.purgeOrdersBitfield2 # << >> /\ (settled7.purgeOrdersBitfield2[1] \div 64) % 2 > 0) THEN (IF settled7.sendTime = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled7.sendTime) ELSE << >>]
        settled9 == [settled8 EXCEPT !.matchingUnit = IF settled8.numberOfPurgeOrdersBitfields >= 2 /\ (settled8.purgeOrdersBitfield2 # << >> /\ (settled8.purgeOrdersBitfield2[1] \div 128) % 2 > 0) THEN (IF settled8.matchingUnit = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled8.matchingUnit) ELSE << >>]
    IN  settled9

ZeroPurgeOrdersMessage ==
    SettlePurgeOrdersMessage([ reserved1                    |-> [i \in 1 .. 1 |-> 0],
                               numberOfPurgeOrdersBitfields |-> 0,
                               purgeOrdersBitfield1         |-> << >>,
                               purgeOrdersBitfield2         |-> << >>,
                               customGroupIDs               |-> << >>,
                               clearingFirm                 |-> << >>,
                               massCancelInst               |-> << >>,
                               riskRoot                     |-> << >>,
                               massCancelId                 |-> << >>,
                               routingFirmId                |-> << >>,
                               sendTime                     |-> << >>,
                               matchingUnit                 |-> << >> ])

(* Purge Orders Message at zero, then each field in turn at the values it is checked at *)
CheckedPurgeOrdersMessage ==
    { ZeroPurgeOrdersMessage }
        \cup { SettlePurgeOrdersMessage([ZeroPurgeOrdersMessage EXCEPT !.reserved1 = one]) : one \in Sample(1) }
        \cup { SettlePurgeOrdersMessage([ZeroPurgeOrdersMessage EXCEPT !.numberOfPurgeOrdersBitfields = one]) : one \in {0, 1, 255} }
        \cup { SettlePurgeOrdersMessage([ZeroPurgeOrdersMessage EXCEPT !.numberOfPurgeOrdersBitfields = 1, !.purgeOrdersBitfield1 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettlePurgeOrdersMessage([ZeroPurgeOrdersMessage EXCEPT !.numberOfPurgeOrdersBitfields = 2, !.purgeOrdersBitfield2 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettlePurgeOrdersMessage([ZeroPurgeOrdersMessage EXCEPT !.customGroupIDs = one]) : one \in SampleLists(OneCustomGroupIDs) }
        \cup { SettlePurgeOrdersMessage([ZeroPurgeOrdersMessage EXCEPT !.numberOfPurgeOrdersBitfields = 1, !.purgeOrdersBitfield1 = <<1>>, !.clearingFirm = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettlePurgeOrdersMessage([ZeroPurgeOrdersMessage EXCEPT !.numberOfPurgeOrdersBitfields = 1, !.purgeOrdersBitfield1 = <<4>>, !.massCancelInst = one]) : one \in { <<held>> : held \in Sample(16) } }
        \cup { SettlePurgeOrdersMessage([ZeroPurgeOrdersMessage EXCEPT !.numberOfPurgeOrdersBitfields = 1, !.purgeOrdersBitfield1 = <<8>>, !.riskRoot = one]) : one \in { <<held>> : held \in Sample(6) } }
        \cup { SettlePurgeOrdersMessage([ZeroPurgeOrdersMessage EXCEPT !.numberOfPurgeOrdersBitfields = 1, !.purgeOrdersBitfield1 = <<16>>, !.massCancelId = one]) : one \in { <<held>> : held \in Sample(20) } }
        \cup { SettlePurgeOrdersMessage([ZeroPurgeOrdersMessage EXCEPT !.numberOfPurgeOrdersBitfields = 1, !.purgeOrdersBitfield1 = <<32>>, !.routingFirmId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettlePurgeOrdersMessage([ZeroPurgeOrdersMessage EXCEPT !.numberOfPurgeOrdersBitfields = 2, !.purgeOrdersBitfield2 = <<64>>, !.sendTime = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettlePurgeOrdersMessage([ZeroPurgeOrdersMessage EXCEPT !.numberOfPurgeOrdersBitfields = 2, !.purgeOrdersBitfield2 = <<128>>, !.matchingUnit = one]) : one \in { <<held>> : held \in Sample(1) } }

(***************************************************************************)
(* Reset Risk Message: 40 bytes                                            *)
(***************************************************************************)

ResetRiskMessage ==
    [ riskStatusId       : Sample(16),
      riskReset          : Sample(8),
      targetMatchingUnit : Sample(1),
      reserved3          : Sample(3),
      clearingFirm       : Sample(4),
      riskRoot           : Sample(6),
      customGroupId      : Sample(2) ]

EncodeResetRiskMessage(message) ==
    message.riskStatusId
        \o message.riskReset
        \o message.targetMatchingUnit
        \o message.reserved3
        \o message.clearingFirm
        \o message.riskRoot
        \o message.customGroupId

DecodeResetRiskMessage(bytes) ==
    LET riskStatusId == ReadBytes(bytes, 16) IN IF ~riskStatusId.ok THEN Fail ELSE
    LET riskReset == ReadBytes(riskStatusId.rest, 8) IN IF ~riskReset.ok THEN Fail ELSE
    LET targetMatchingUnit == ReadBytes(riskReset.rest, 1) IN IF ~targetMatchingUnit.ok THEN Fail ELSE
    LET reserved3 == ReadBytes(targetMatchingUnit.rest, 3) IN IF ~reserved3.ok THEN Fail ELSE
    LET clearingFirm == ReadBytes(reserved3.rest, 4) IN IF ~clearingFirm.ok THEN Fail ELSE
    LET riskRoot == ReadBytes(clearingFirm.rest, 6) IN IF ~riskRoot.ok THEN Fail ELSE
    LET customGroupId == ReadBytes(riskRoot.rest, 2) IN IF ~customGroupId.ok THEN Fail ELSE
    Ok([ riskStatusId       |-> riskStatusId.value,
         riskReset          |-> riskReset.value,
         targetMatchingUnit |-> targetMatchingUnit.value,
         reserved3          |-> reserved3.value,
         clearingFirm       |-> clearingFirm.value,
         riskRoot           |-> riskRoot.value,
         customGroupId      |-> customGroupId.value ], customGroupId.rest)

ZeroResetRiskMessage ==
    [ riskStatusId       |-> [i \in 1 .. 16 |-> 0],
      riskReset          |-> [i \in 1 .. 8 |-> 0],
      targetMatchingUnit |-> [i \in 1 .. 1 |-> 0],
      reserved3          |-> [i \in 1 .. 3 |-> 0],
      clearingFirm       |-> [i \in 1 .. 4 |-> 0],
      riskRoot           |-> [i \in 1 .. 6 |-> 0],
      customGroupId      |-> [i \in 1 .. 2 |-> 0] ]

(* Reset Risk Message at zero, then each field in turn at the values it is checked at *)
CheckedResetRiskMessage ==
    { ZeroResetRiskMessage }
        \cup { [ZeroResetRiskMessage EXCEPT !.riskStatusId = one] : one \in Sample(16) }
        \cup { [ZeroResetRiskMessage EXCEPT !.riskReset = one] : one \in Sample(8) }
        \cup { [ZeroResetRiskMessage EXCEPT !.targetMatchingUnit = one] : one \in Sample(1) }
        \cup { [ZeroResetRiskMessage EXCEPT !.reserved3 = one] : one \in Sample(3) }
        \cup { [ZeroResetRiskMessage EXCEPT !.clearingFirm = one] : one \in Sample(4) }
        \cup { [ZeroResetRiskMessage EXCEPT !.riskRoot = one] : one \in Sample(6) }
        \cup { [ZeroResetRiskMessage EXCEPT !.customGroupId = one] : one \in Sample(2) }

(***************************************************************************)
(* Complex Leg: 31 bytes                                                   *)
(***************************************************************************)

ComplexLeg ==
    [ legSymbol       : Sample(8),
      legCfiCode      : Sample(6),
      legMaturityDate : Sample(4),
      legStrikePrice  : Sample(8),
      legRatioQty     : Sample(4),
      legSide         : Sample(1) ]

EncodeComplexLeg(message) ==
    message.legSymbol
        \o message.legCfiCode
        \o message.legMaturityDate
        \o message.legStrikePrice
        \o message.legRatioQty
        \o message.legSide

DecodeComplexLeg(bytes) ==
    LET legSymbol == ReadBytes(bytes, 8) IN IF ~legSymbol.ok THEN Fail ELSE
    LET legCfiCode == ReadBytes(legSymbol.rest, 6) IN IF ~legCfiCode.ok THEN Fail ELSE
    LET legMaturityDate == ReadBytes(legCfiCode.rest, 4) IN IF ~legMaturityDate.ok THEN Fail ELSE
    LET legStrikePrice == ReadBytes(legMaturityDate.rest, 8) IN IF ~legStrikePrice.ok THEN Fail ELSE
    LET legRatioQty == ReadBytes(legStrikePrice.rest, 4) IN IF ~legRatioQty.ok THEN Fail ELSE
    LET legSide == ReadBytes(legRatioQty.rest, 1) IN IF ~legSide.ok THEN Fail ELSE
    Ok([ legSymbol       |-> legSymbol.value,
         legCfiCode      |-> legCfiCode.value,
         legMaturityDate |-> legMaturityDate.value,
         legStrikePrice  |-> legStrikePrice.value,
         legRatioQty     |-> legRatioQty.value,
         legSide         |-> legSide.value ], legSide.rest)

ZeroComplexLeg ==
    [ legSymbol       |-> [i \in 1 .. 8 |-> 0],
      legCfiCode      |-> [i \in 1 .. 6 |-> 0],
      legMaturityDate |-> [i \in 1 .. 4 |-> 0],
      legStrikePrice  |-> [i \in 1 .. 8 |-> 0],
      legRatioQty     |-> [i \in 1 .. 4 |-> 0],
      legSide         |-> [i \in 1 .. 1 |-> 0] ]

(* Complex Leg at zero, then each field in turn at the values it is checked at *)
CheckedComplexLeg ==
    { ZeroComplexLeg }
        \cup { [ZeroComplexLeg EXCEPT !.legSymbol = one] : one \in Sample(8) }
        \cup { [ZeroComplexLeg EXCEPT !.legCfiCode = one] : one \in Sample(6) }
        \cup { [ZeroComplexLeg EXCEPT !.legMaturityDate = one] : one \in Sample(4) }
        \cup { [ZeroComplexLeg EXCEPT !.legStrikePrice = one] : one \in Sample(8) }
        \cup { [ZeroComplexLeg EXCEPT !.legRatioQty = one] : one \in Sample(4) }
        \cup { [ZeroComplexLeg EXCEPT !.legSide = one] : one \in Sample(1) }

(* A run of Complex Leg, written one after another *)
RECURSIVE EncodeComplexLegList(_)
EncodeComplexLegList(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeComplexLeg(Head(messages)) \o EncodeComplexLegList(Tail(messages))

(* As many Complex Leg as the field that counts them says *)
RECURSIVE ReadComplexLegList(_, _)
ReadComplexLegList(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeComplexLeg(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadComplexLegList(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Complex Leg of each kind, for the lists that carry them *)
OneComplexLeg == { ZeroComplexLeg }

(***************************************************************************)
(* New Complex Instrument Message                                          *)
(***************************************************************************)

NewComplexInstrumentMessage ==
    [ clOrdId                               : Sample(20),
      numberOfNewComplexInstrumentBitfields : 0 .. 255,
      newComplexInstrumentBitfield1         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      complexLeg                            : SampleLists(OneComplexLeg),
      clearingFirm                          : { << >> } \cup { <<held>> : held \in Sample(4) },
      legCfiCode                            : { << >> } \cup { <<held>> : held \in Sample(6) },
      legMaturityDate                       : { << >> } \cup { <<held>> : held \in Sample(4) },
      legStrikePrice                        : { << >> } \cup { <<held>> : held \in Sample(8) } ]

EncodeNewComplexInstrumentMessage(message) ==
    message.clOrdId
        \o EncodeUIntBE(message.numberOfNewComplexInstrumentBitfields, 1)
        \o (IF message.newComplexInstrumentBitfield1 = << >> THEN << >> ELSE EncodeUIntLE(message.newComplexInstrumentBitfield1[1], 1))
        \o EncodeUIntBE(Len(message.complexLeg), 1)
        \o EncodeComplexLegList(message.complexLeg)
        \o (IF message.clearingFirm = << >> THEN << >> ELSE message.clearingFirm[1])
        \o (IF message.legCfiCode = << >> THEN << >> ELSE message.legCfiCode[1])
        \o (IF message.legMaturityDate = << >> THEN << >> ELSE message.legMaturityDate[1])
        \o (IF message.legStrikePrice = << >> THEN << >> ELSE message.legStrikePrice[1])

DecodeNewComplexInstrumentMessage(bytes) ==
    LET clOrdId == ReadBytes(bytes, 20) IN IF ~clOrdId.ok THEN Fail ELSE
    LET numberOfNewComplexInstrumentBitfields == ReadUIntBE(clOrdId.rest, 1) IN IF ~numberOfNewComplexInstrumentBitfields.ok THEN Fail ELSE
    LET newComplexInstrumentBitfield1 == ReadWhen(numberOfNewComplexInstrumentBitfields.value >= 1, ReadUIntLE(numberOfNewComplexInstrumentBitfields.rest, 1), numberOfNewComplexInstrumentBitfields.rest) IN IF ~newComplexInstrumentBitfield1.ok THEN Fail ELSE
    LET noLegs == ReadUIntBE(newComplexInstrumentBitfield1.rest, 1) IN IF ~noLegs.ok THEN Fail ELSE
    LET complexLeg == ReadComplexLegList(noLegs.rest, noLegs.value) IN IF ~complexLeg.ok THEN Fail ELSE
    LET clearingFirm == ReadWhen(numberOfNewComplexInstrumentBitfields.value >= 1 /\ (newComplexInstrumentBitfield1.value # << >> /\ (newComplexInstrumentBitfield1.value[1] \div 8) % 2 > 0), ReadBytes(complexLeg.rest, 4), complexLeg.rest) IN IF ~clearingFirm.ok THEN Fail ELSE
    LET legCfiCode == ReadWhen(numberOfNewComplexInstrumentBitfields.value >= 1 /\ (newComplexInstrumentBitfield1.value # << >> /\ newComplexInstrumentBitfield1.value[1] % 2 > 0), ReadBytes(clearingFirm.rest, 6), clearingFirm.rest) IN IF ~legCfiCode.ok THEN Fail ELSE
    LET legMaturityDate == ReadWhen(numberOfNewComplexInstrumentBitfields.value >= 1 /\ (newComplexInstrumentBitfield1.value # << >> /\ (newComplexInstrumentBitfield1.value[1] \div 2) % 2 > 0), ReadBytes(legCfiCode.rest, 4), legCfiCode.rest) IN IF ~legMaturityDate.ok THEN Fail ELSE
    LET legStrikePrice == ReadWhen(numberOfNewComplexInstrumentBitfields.value >= 1 /\ (newComplexInstrumentBitfield1.value # << >> /\ (newComplexInstrumentBitfield1.value[1] \div 4) % 2 > 0), ReadBytes(legMaturityDate.rest, 8), legMaturityDate.rest) IN IF ~legStrikePrice.ok THEN Fail ELSE
    Ok([ clOrdId                               |-> clOrdId.value,
         numberOfNewComplexInstrumentBitfields |-> numberOfNewComplexInstrumentBitfields.value,
         newComplexInstrumentBitfield1         |-> newComplexInstrumentBitfield1.value,
         complexLeg                            |-> complexLeg.value,
         clearingFirm                          |-> clearingFirm.value,
         legCfiCode                            |-> legCfiCode.value,
         legMaturityDate                       |-> legMaturityDate.value,
         legStrikePrice                        |-> legStrikePrice.value ], legStrikePrice.rest)

(* New Complex Instrument Message with each field marked present by fields before it there exactly where they say *)
SettleNewComplexInstrumentMessage(message) ==
    LET settled1 == [message EXCEPT !.newComplexInstrumentBitfield1 = IF message.numberOfNewComplexInstrumentBitfields >= 1 THEN (IF message.newComplexInstrumentBitfield1 = << >> THEN <<0>> ELSE message.newComplexInstrumentBitfield1) ELSE << >>]
        settled2 == [settled1 EXCEPT !.clearingFirm = IF settled1.numberOfNewComplexInstrumentBitfields >= 1 /\ (settled1.newComplexInstrumentBitfield1 # << >> /\ (settled1.newComplexInstrumentBitfield1[1] \div 8) % 2 > 0) THEN (IF settled1.clearingFirm = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled1.clearingFirm) ELSE << >>]
        settled3 == [settled2 EXCEPT !.legCfiCode = IF settled2.numberOfNewComplexInstrumentBitfields >= 1 /\ (settled2.newComplexInstrumentBitfield1 # << >> /\ settled2.newComplexInstrumentBitfield1[1] % 2 > 0) THEN (IF settled2.legCfiCode = << >> THEN <<[i \in 1 .. 6 |-> 0]>> ELSE settled2.legCfiCode) ELSE << >>]
        settled4 == [settled3 EXCEPT !.legMaturityDate = IF settled3.numberOfNewComplexInstrumentBitfields >= 1 /\ (settled3.newComplexInstrumentBitfield1 # << >> /\ (settled3.newComplexInstrumentBitfield1[1] \div 2) % 2 > 0) THEN (IF settled3.legMaturityDate = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled3.legMaturityDate) ELSE << >>]
        settled5 == [settled4 EXCEPT !.legStrikePrice = IF settled4.numberOfNewComplexInstrumentBitfields >= 1 /\ (settled4.newComplexInstrumentBitfield1 # << >> /\ (settled4.newComplexInstrumentBitfield1[1] \div 4) % 2 > 0) THEN (IF settled4.legStrikePrice = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled4.legStrikePrice) ELSE << >>]
    IN  settled5

ZeroNewComplexInstrumentMessage ==
    SettleNewComplexInstrumentMessage([ clOrdId                               |-> [i \in 1 .. 20 |-> 0],
                                        numberOfNewComplexInstrumentBitfields |-> 0,
                                        newComplexInstrumentBitfield1         |-> << >>,
                                        complexLeg                            |-> << >>,
                                        clearingFirm                          |-> << >>,
                                        legCfiCode                            |-> << >>,
                                        legMaturityDate                       |-> << >>,
                                        legStrikePrice                        |-> << >> ])

(* New Complex Instrument Message at zero, then each field in turn at the values it is checked at *)
CheckedNewComplexInstrumentMessage ==
    { ZeroNewComplexInstrumentMessage }
        \cup { SettleNewComplexInstrumentMessage([ZeroNewComplexInstrumentMessage EXCEPT !.clOrdId = one]) : one \in Sample(20) }
        \cup { SettleNewComplexInstrumentMessage([ZeroNewComplexInstrumentMessage EXCEPT !.numberOfNewComplexInstrumentBitfields = one]) : one \in {0, 1, 255} }
        \cup { SettleNewComplexInstrumentMessage([ZeroNewComplexInstrumentMessage EXCEPT !.numberOfNewComplexInstrumentBitfields = 1, !.newComplexInstrumentBitfield1 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleNewComplexInstrumentMessage([ZeroNewComplexInstrumentMessage EXCEPT !.complexLeg = one]) : one \in SampleLists(OneComplexLeg) }
        \cup { SettleNewComplexInstrumentMessage([ZeroNewComplexInstrumentMessage EXCEPT !.numberOfNewComplexInstrumentBitfields = 1, !.newComplexInstrumentBitfield1 = <<8>>, !.clearingFirm = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewComplexInstrumentMessage([ZeroNewComplexInstrumentMessage EXCEPT !.numberOfNewComplexInstrumentBitfields = 1, !.newComplexInstrumentBitfield1 = <<1>>, !.legCfiCode = one]) : one \in { <<held>> : held \in Sample(6) } }
        \cup { SettleNewComplexInstrumentMessage([ZeroNewComplexInstrumentMessage EXCEPT !.numberOfNewComplexInstrumentBitfields = 1, !.newComplexInstrumentBitfield1 = <<2>>, !.legMaturityDate = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewComplexInstrumentMessage([ZeroNewComplexInstrumentMessage EXCEPT !.numberOfNewComplexInstrumentBitfields = 1, !.newComplexInstrumentBitfield1 = <<4>>, !.legStrikePrice = one]) : one \in { <<held>> : held \in Sample(8) } }

(***************************************************************************)
(* Add Floor Trade Message: 136 bytes                                      *)
(***************************************************************************)

AddFloorTradeMessage ==
    [ clOrdId               : Sample(20),
      symbolLong            : Sample(8),
      putOrCall             : Sample(1),
      strikePrice           : Sample(8),
      maturityDate          : Sample(4),
      multilegReportingType : Sample(1),
      comboOrder            : Sample(1),
      account               : Sample(16),
      clearingOptionalData  : Sample(16),
      clearingAccount       : Sample(4),
      cmtaNumber            : Sample(4),
      floorTraderAcronym    : Sample(3),
      side                  : Sample(1),
      orderQtyLong          : Sample(4),
      priceLong             : Sample(8),
      transactionTime       : Sample(8),
      openClose             : Sample(1),
      floorTradeTime        : Sample(8),
      contraTrader          : Sample(4),
      reserved16            : Sample(16) ]

EncodeAddFloorTradeMessage(message) ==
    message.clOrdId
        \o message.symbolLong
        \o message.putOrCall
        \o message.strikePrice
        \o message.maturityDate
        \o message.multilegReportingType
        \o message.comboOrder
        \o message.account
        \o message.clearingOptionalData
        \o message.clearingAccount
        \o message.cmtaNumber
        \o message.floorTraderAcronym
        \o message.side
        \o message.orderQtyLong
        \o message.priceLong
        \o message.transactionTime
        \o message.openClose
        \o message.floorTradeTime
        \o message.contraTrader
        \o message.reserved16

DecodeAddFloorTradeMessage(bytes) ==
    LET clOrdId == ReadBytes(bytes, 20) IN IF ~clOrdId.ok THEN Fail ELSE
    LET symbolLong == ReadBytes(clOrdId.rest, 8) IN IF ~symbolLong.ok THEN Fail ELSE
    LET putOrCall == ReadBytes(symbolLong.rest, 1) IN IF ~putOrCall.ok THEN Fail ELSE
    LET strikePrice == ReadBytes(putOrCall.rest, 8) IN IF ~strikePrice.ok THEN Fail ELSE
    LET maturityDate == ReadBytes(strikePrice.rest, 4) IN IF ~maturityDate.ok THEN Fail ELSE
    LET multilegReportingType == ReadBytes(maturityDate.rest, 1) IN IF ~multilegReportingType.ok THEN Fail ELSE
    LET comboOrder == ReadBytes(multilegReportingType.rest, 1) IN IF ~comboOrder.ok THEN Fail ELSE
    LET account == ReadBytes(comboOrder.rest, 16) IN IF ~account.ok THEN Fail ELSE
    LET clearingOptionalData == ReadBytes(account.rest, 16) IN IF ~clearingOptionalData.ok THEN Fail ELSE
    LET clearingAccount == ReadBytes(clearingOptionalData.rest, 4) IN IF ~clearingAccount.ok THEN Fail ELSE
    LET cmtaNumber == ReadBytes(clearingAccount.rest, 4) IN IF ~cmtaNumber.ok THEN Fail ELSE
    LET floorTraderAcronym == ReadBytes(cmtaNumber.rest, 3) IN IF ~floorTraderAcronym.ok THEN Fail ELSE
    LET side == ReadBytes(floorTraderAcronym.rest, 1) IN IF ~side.ok THEN Fail ELSE
    LET orderQtyLong == ReadBytes(side.rest, 4) IN IF ~orderQtyLong.ok THEN Fail ELSE
    LET priceLong == ReadBytes(orderQtyLong.rest, 8) IN IF ~priceLong.ok THEN Fail ELSE
    LET transactionTime == ReadBytes(priceLong.rest, 8) IN IF ~transactionTime.ok THEN Fail ELSE
    LET openClose == ReadBytes(transactionTime.rest, 1) IN IF ~openClose.ok THEN Fail ELSE
    LET floorTradeTime == ReadBytes(openClose.rest, 8) IN IF ~floorTradeTime.ok THEN Fail ELSE
    LET contraTrader == ReadBytes(floorTradeTime.rest, 4) IN IF ~contraTrader.ok THEN Fail ELSE
    LET reserved16 == ReadBytes(contraTrader.rest, 16) IN IF ~reserved16.ok THEN Fail ELSE
    Ok([ clOrdId               |-> clOrdId.value,
         symbolLong            |-> symbolLong.value,
         putOrCall             |-> putOrCall.value,
         strikePrice           |-> strikePrice.value,
         maturityDate          |-> maturityDate.value,
         multilegReportingType |-> multilegReportingType.value,
         comboOrder            |-> comboOrder.value,
         account               |-> account.value,
         clearingOptionalData  |-> clearingOptionalData.value,
         clearingAccount       |-> clearingAccount.value,
         cmtaNumber            |-> cmtaNumber.value,
         floorTraderAcronym    |-> floorTraderAcronym.value,
         side                  |-> side.value,
         orderQtyLong          |-> orderQtyLong.value,
         priceLong             |-> priceLong.value,
         transactionTime       |-> transactionTime.value,
         openClose             |-> openClose.value,
         floorTradeTime        |-> floorTradeTime.value,
         contraTrader          |-> contraTrader.value,
         reserved16            |-> reserved16.value ], reserved16.rest)

ZeroAddFloorTradeMessage ==
    [ clOrdId               |-> [i \in 1 .. 20 |-> 0],
      symbolLong            |-> [i \in 1 .. 8 |-> 0],
      putOrCall             |-> [i \in 1 .. 1 |-> 0],
      strikePrice           |-> [i \in 1 .. 8 |-> 0],
      maturityDate          |-> [i \in 1 .. 4 |-> 0],
      multilegReportingType |-> [i \in 1 .. 1 |-> 0],
      comboOrder            |-> [i \in 1 .. 1 |-> 0],
      account               |-> [i \in 1 .. 16 |-> 0],
      clearingOptionalData  |-> [i \in 1 .. 16 |-> 0],
      clearingAccount       |-> [i \in 1 .. 4 |-> 0],
      cmtaNumber            |-> [i \in 1 .. 4 |-> 0],
      floorTraderAcronym    |-> [i \in 1 .. 3 |-> 0],
      side                  |-> [i \in 1 .. 1 |-> 0],
      orderQtyLong          |-> [i \in 1 .. 4 |-> 0],
      priceLong             |-> [i \in 1 .. 8 |-> 0],
      transactionTime       |-> [i \in 1 .. 8 |-> 0],
      openClose             |-> [i \in 1 .. 1 |-> 0],
      floorTradeTime        |-> [i \in 1 .. 8 |-> 0],
      contraTrader          |-> [i \in 1 .. 4 |-> 0],
      reserved16            |-> [i \in 1 .. 16 |-> 0] ]

(* Add Floor Trade Message at zero, then each field in turn at the values it is checked at *)
CheckedAddFloorTradeMessage ==
    { ZeroAddFloorTradeMessage }
        \cup { [ZeroAddFloorTradeMessage EXCEPT !.clOrdId = one] : one \in Sample(20) }
        \cup { [ZeroAddFloorTradeMessage EXCEPT !.symbolLong = one] : one \in Sample(8) }
        \cup { [ZeroAddFloorTradeMessage EXCEPT !.putOrCall = one] : one \in Sample(1) }
        \cup { [ZeroAddFloorTradeMessage EXCEPT !.strikePrice = one] : one \in Sample(8) }
        \cup { [ZeroAddFloorTradeMessage EXCEPT !.maturityDate = one] : one \in Sample(4) }
        \cup { [ZeroAddFloorTradeMessage EXCEPT !.multilegReportingType = one] : one \in Sample(1) }
        \cup { [ZeroAddFloorTradeMessage EXCEPT !.comboOrder = one] : one \in Sample(1) }
        \cup { [ZeroAddFloorTradeMessage EXCEPT !.account = one] : one \in Sample(16) }
        \cup { [ZeroAddFloorTradeMessage EXCEPT !.clearingOptionalData = one] : one \in Sample(16) }
        \cup { [ZeroAddFloorTradeMessage EXCEPT !.clearingAccount = one] : one \in Sample(4) }
        \cup { [ZeroAddFloorTradeMessage EXCEPT !.cmtaNumber = one] : one \in Sample(4) }
        \cup { [ZeroAddFloorTradeMessage EXCEPT !.floorTraderAcronym = one] : one \in Sample(3) }
        \cup { [ZeroAddFloorTradeMessage EXCEPT !.side = one] : one \in Sample(1) }
        \cup { [ZeroAddFloorTradeMessage EXCEPT !.orderQtyLong = one] : one \in Sample(4) }
        \cup { [ZeroAddFloorTradeMessage EXCEPT !.priceLong = one] : one \in Sample(8) }
        \cup { [ZeroAddFloorTradeMessage EXCEPT !.transactionTime = one] : one \in Sample(8) }
        \cup { [ZeroAddFloorTradeMessage EXCEPT !.openClose = one] : one \in Sample(1) }
        \cup { [ZeroAddFloorTradeMessage EXCEPT !.floorTradeTime = one] : one \in Sample(8) }
        \cup { [ZeroAddFloorTradeMessage EXCEPT !.contraTrader = one] : one \in Sample(4) }
        \cup { [ZeroAddFloorTradeMessage EXCEPT !.reserved16 = one] : one \in Sample(16) }

(***************************************************************************)
(* Floor Trade Confirmation Message: 73 bytes                              *)
(***************************************************************************)

FloorTradeConfirmationMessage ==
    [ clOrdId         : Sample(20),
      execId          : Sample(8),
      symbolLong      : Sample(8),
      putOrCall       : Sample(1),
      strikePrice     : Sample(8),
      maturityDate    : Sample(4),
      transactionTime : Sample(8),
      priceType       : Sample(1),
      reserved15      : Sample(15) ]

EncodeFloorTradeConfirmationMessage(message) ==
    message.clOrdId
        \o message.execId
        \o message.symbolLong
        \o message.putOrCall
        \o message.strikePrice
        \o message.maturityDate
        \o message.transactionTime
        \o message.priceType
        \o message.reserved15

DecodeFloorTradeConfirmationMessage(bytes) ==
    LET clOrdId == ReadBytes(bytes, 20) IN IF ~clOrdId.ok THEN Fail ELSE
    LET execId == ReadBytes(clOrdId.rest, 8) IN IF ~execId.ok THEN Fail ELSE
    LET symbolLong == ReadBytes(execId.rest, 8) IN IF ~symbolLong.ok THEN Fail ELSE
    LET putOrCall == ReadBytes(symbolLong.rest, 1) IN IF ~putOrCall.ok THEN Fail ELSE
    LET strikePrice == ReadBytes(putOrCall.rest, 8) IN IF ~strikePrice.ok THEN Fail ELSE
    LET maturityDate == ReadBytes(strikePrice.rest, 4) IN IF ~maturityDate.ok THEN Fail ELSE
    LET transactionTime == ReadBytes(maturityDate.rest, 8) IN IF ~transactionTime.ok THEN Fail ELSE
    LET priceType == ReadBytes(transactionTime.rest, 1) IN IF ~priceType.ok THEN Fail ELSE
    LET reserved15 == ReadBytes(priceType.rest, 15) IN IF ~reserved15.ok THEN Fail ELSE
    Ok([ clOrdId         |-> clOrdId.value,
         execId          |-> execId.value,
         symbolLong      |-> symbolLong.value,
         putOrCall       |-> putOrCall.value,
         strikePrice     |-> strikePrice.value,
         maturityDate    |-> maturityDate.value,
         transactionTime |-> transactionTime.value,
         priceType       |-> priceType.value,
         reserved15      |-> reserved15.value ], reserved15.rest)

ZeroFloorTradeConfirmationMessage ==
    [ clOrdId         |-> [i \in 1 .. 20 |-> 0],
      execId          |-> [i \in 1 .. 8 |-> 0],
      symbolLong      |-> [i \in 1 .. 8 |-> 0],
      putOrCall       |-> [i \in 1 .. 1 |-> 0],
      strikePrice     |-> [i \in 1 .. 8 |-> 0],
      maturityDate    |-> [i \in 1 .. 4 |-> 0],
      transactionTime |-> [i \in 1 .. 8 |-> 0],
      priceType       |-> [i \in 1 .. 1 |-> 0],
      reserved15      |-> [i \in 1 .. 15 |-> 0] ]

(* Floor Trade Confirmation Message at zero, then each field in turn at the values it is checked at *)
CheckedFloorTradeConfirmationMessage ==
    { ZeroFloorTradeConfirmationMessage }
        \cup { [ZeroFloorTradeConfirmationMessage EXCEPT !.clOrdId = one] : one \in Sample(20) }
        \cup { [ZeroFloorTradeConfirmationMessage EXCEPT !.execId = one] : one \in Sample(8) }
        \cup { [ZeroFloorTradeConfirmationMessage EXCEPT !.symbolLong = one] : one \in Sample(8) }
        \cup { [ZeroFloorTradeConfirmationMessage EXCEPT !.putOrCall = one] : one \in Sample(1) }
        \cup { [ZeroFloorTradeConfirmationMessage EXCEPT !.strikePrice = one] : one \in Sample(8) }
        \cup { [ZeroFloorTradeConfirmationMessage EXCEPT !.maturityDate = one] : one \in Sample(4) }
        \cup { [ZeroFloorTradeConfirmationMessage EXCEPT !.transactionTime = one] : one \in Sample(8) }
        \cup { [ZeroFloorTradeConfirmationMessage EXCEPT !.priceType = one] : one \in Sample(1) }
        \cup { [ZeroFloorTradeConfirmationMessage EXCEPT !.reserved15 = one] : one \in Sample(15) }

(***************************************************************************)
(* Delete Floor Trade Message: 66 bytes                                    *)
(***************************************************************************)

DeleteFloorTradeMessage ==
    [ clOrdId      : Sample(20),
      execId       : Sample(8),
      symbolLong   : Sample(8),
      putOrCall    : Sample(1),
      strikePrice  : Sample(8),
      maturityDate : Sample(4),
      side         : Sample(1),
      reserved16   : Sample(16) ]

EncodeDeleteFloorTradeMessage(message) ==
    message.clOrdId
        \o message.execId
        \o message.symbolLong
        \o message.putOrCall
        \o message.strikePrice
        \o message.maturityDate
        \o message.side
        \o message.reserved16

DecodeDeleteFloorTradeMessage(bytes) ==
    LET clOrdId == ReadBytes(bytes, 20) IN IF ~clOrdId.ok THEN Fail ELSE
    LET execId == ReadBytes(clOrdId.rest, 8) IN IF ~execId.ok THEN Fail ELSE
    LET symbolLong == ReadBytes(execId.rest, 8) IN IF ~symbolLong.ok THEN Fail ELSE
    LET putOrCall == ReadBytes(symbolLong.rest, 1) IN IF ~putOrCall.ok THEN Fail ELSE
    LET strikePrice == ReadBytes(putOrCall.rest, 8) IN IF ~strikePrice.ok THEN Fail ELSE
    LET maturityDate == ReadBytes(strikePrice.rest, 4) IN IF ~maturityDate.ok THEN Fail ELSE
    LET side == ReadBytes(maturityDate.rest, 1) IN IF ~side.ok THEN Fail ELSE
    LET reserved16 == ReadBytes(side.rest, 16) IN IF ~reserved16.ok THEN Fail ELSE
    Ok([ clOrdId      |-> clOrdId.value,
         execId       |-> execId.value,
         symbolLong   |-> symbolLong.value,
         putOrCall    |-> putOrCall.value,
         strikePrice  |-> strikePrice.value,
         maturityDate |-> maturityDate.value,
         side         |-> side.value,
         reserved16   |-> reserved16.value ], reserved16.rest)

ZeroDeleteFloorTradeMessage ==
    [ clOrdId      |-> [i \in 1 .. 20 |-> 0],
      execId       |-> [i \in 1 .. 8 |-> 0],
      symbolLong   |-> [i \in 1 .. 8 |-> 0],
      putOrCall    |-> [i \in 1 .. 1 |-> 0],
      strikePrice  |-> [i \in 1 .. 8 |-> 0],
      maturityDate |-> [i \in 1 .. 4 |-> 0],
      side         |-> [i \in 1 .. 1 |-> 0],
      reserved16   |-> [i \in 1 .. 16 |-> 0] ]

(* Delete Floor Trade Message at zero, then each field in turn at the values it is checked at *)
CheckedDeleteFloorTradeMessage ==
    { ZeroDeleteFloorTradeMessage }
        \cup { [ZeroDeleteFloorTradeMessage EXCEPT !.clOrdId = one] : one \in Sample(20) }
        \cup { [ZeroDeleteFloorTradeMessage EXCEPT !.execId = one] : one \in Sample(8) }
        \cup { [ZeroDeleteFloorTradeMessage EXCEPT !.symbolLong = one] : one \in Sample(8) }
        \cup { [ZeroDeleteFloorTradeMessage EXCEPT !.putOrCall = one] : one \in Sample(1) }
        \cup { [ZeroDeleteFloorTradeMessage EXCEPT !.strikePrice = one] : one \in Sample(8) }
        \cup { [ZeroDeleteFloorTradeMessage EXCEPT !.maturityDate = one] : one \in Sample(4) }
        \cup { [ZeroDeleteFloorTradeMessage EXCEPT !.side = one] : one \in Sample(1) }
        \cup { [ZeroDeleteFloorTradeMessage EXCEPT !.reserved16 = one] : one \in Sample(16) }

