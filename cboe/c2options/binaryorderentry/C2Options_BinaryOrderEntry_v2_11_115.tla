        settled40 == [settled39 EXCEPT !.openClose = IF settled39.numberOfReturnBitfields >= 4 /\ (settled39.orderRejectedReturnBitfield4 # << >> /\ (settled39.orderRejectedReturnBitfield4[1] \div 8) % 2 > 0) THEN (IF settled39.openClose = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled39.openClose) ELSE << >>]
