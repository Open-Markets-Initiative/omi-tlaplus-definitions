        settled66 == [settled65 EXCEPT !.routingFirmId = IF settled65.numberOfReturnBitfields >= 10 /\ (settled65.orderCancelledReturnBitfield10 # << >> /\ (settled65.orderCancelledReturnBitfield10[1] \div 8) % 2 > 0) THEN (IF settled65.routingFirmId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled65.routingFirmId) ELSE << >>]
