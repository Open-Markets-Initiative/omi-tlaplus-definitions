        settled73 == [settled72 EXCEPT !.floorDestination = IF settled72.numberOfReturnBitfields >= 16 /\ (settled72.orderCancelledReturnBitfield16 # << >> /\ (settled72.orderCancelledReturnBitfield16[1] \div 16) % 2 > 0) THEN (IF settled72.floorDestination = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled72.floorDestination) ELSE << >>]
        settled74 == [settled73 EXCEPT !.floorRoutingInst = IF settled73.numberOfReturnBitfields >= 16 /\ (settled73.orderCancelledReturnBitfield16 # << >> /\ (settled73.orderCancelledReturnBitfield16[1] \div 32) % 2 > 0) THEN (IF settled73.floorRoutingInst = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled73.floorRoutingInst) ELSE << >>]
        settled75 == [settled74 EXCEPT !.multiClassSprd = IF settled74.numberOfReturnBitfields >= 16 /\ (settled74.orderCancelledReturnBitfield16 # << >> /\ (settled74.orderCancelledReturnBitfield16[1] \div 64) % 2 > 0) THEN (IF settled74.multiClassSprd = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled74.multiClassSprd) ELSE << >>]
        settled76 == [settled75 EXCEPT !.orderOrigin = IF settled75.numberOfReturnBitfields >= 16 /\ (settled75.orderCancelledReturnBitfield16 # << >> /\ (settled75.orderCancelledReturnBitfield16[1] \div 128) % 2 > 0) THEN (IF settled75.orderOrigin = << >> THEN <<[i \in 1 .. 3 |-> 0]>> ELSE settled75.orderOrigin) ELSE << >>]
        settled77 == [settled76 EXCEPT !.priceType = IF settled76.numberOfReturnBitfields >= 17 /\ (settled76.orderCancelledReturnBitfield17 # << >> /\ settled76.orderCancelledReturnBitfield17[1] % 2 > 0) THEN (IF settled76.priceType = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled76.priceType) ELSE << >>]
        settled78 == [settled77 EXCEPT !.strategyId = IF settled77.numberOfReturnBitfields >= 17 /\ (settled77.orderCancelledReturnBitfield17 # << >> /\ (settled77.orderCancelledReturnBitfield17[1] \div 2) % 2 > 0) THEN (IF settled77.strategyId = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled77.strategyId) ELSE << >>]
        settled79 == [settled78 EXCEPT !.crossInitiator = IF settled78.numberOfReturnBitfields >= 18 /\ (settled78.orderCancelledReturnBitfield18 # << >> /\ (settled78.orderCancelledReturnBitfield18[1] \div 2) % 2 > 0) THEN (IF settled78.crossInitiator = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled78.crossInitiator) ELSE << >>]
