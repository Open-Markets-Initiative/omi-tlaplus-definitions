        settled60 == [settled59 EXCEPT !.clearingOptionalData = IF settled59.numberOfReturnBitfields >= 12 /\ (settled59.orderRejectedReturnBitfield12 # << >> /\ (settled59.orderRejectedReturnBitfield12[1] \div 128) % 2 > 0) THEN (IF settled59.clearingOptionalData = << >> THEN <<[i \in 1 .. 16 |-> 0]>> ELSE settled59.clearingOptionalData) ELSE << >>]
        settled61 == [settled60 EXCEPT !.equityPartyId = IF settled60.numberOfReturnBitfields >= 15 /\ (settled60.orderRejectedReturnBitfield15 # << >> /\ (settled60.orderRejectedReturnBitfield15[1] \div 2) % 2 > 0) THEN (IF settled60.equityPartyId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled60.equityPartyId) ELSE << >>]
        settled62 == [settled61 EXCEPT !.clientIdAttr = IF settled61.numberOfReturnBitfields >= 15 /\ (settled61.orderRejectedReturnBitfield15 # << >> /\ (settled61.orderRejectedReturnBitfield15[1] \div 128) % 2 > 0) THEN (IF settled61.clientIdAttr = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled61.clientIdAttr) ELSE << >>]
        settled63 == [settled62 EXCEPT !.frequentTraderId = IF settled62.numberOfReturnBitfields >= 16 /\ (settled62.orderRejectedReturnBitfield16 # << >> /\ settled62.orderRejectedReturnBitfield16[1] % 2 > 0) THEN (IF settled62.frequentTraderId = << >> THEN <<[i \in 1 .. 6 |-> 0]>> ELSE settled62.frequentTraderId) ELSE << >>]
        settled64 == [settled63 EXCEPT !.sessionEligibility = IF settled63.numberOfReturnBitfields >= 16 /\ (settled63.orderRejectedReturnBitfield16 # << >> /\ (settled63.orderRejectedReturnBitfield16[1] \div 2) % 2 > 0) THEN (IF settled63.sessionEligibility = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled63.sessionEligibility) ELSE << >>]
        settled65 == [settled64 EXCEPT !.comboOrder = IF settled64.numberOfReturnBitfields >= 16 /\ (settled64.orderRejectedReturnBitfield16 # << >> /\ (settled64.orderRejectedReturnBitfield16[1] \div 4) % 2 > 0) THEN (IF settled64.comboOrder = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled64.comboOrder) ELSE << >>]
        settled66 == [settled65 EXCEPT !.compression = IF settled65.numberOfReturnBitfields >= 16 /\ (settled65.orderRejectedReturnBitfield16 # << >> /\ (settled65.orderRejectedReturnBitfield16[1] \div 8) % 2 > 0) THEN (IF settled65.compression = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled65.compression) ELSE << >>]
        settled67 == [settled66 EXCEPT !.floorDestination = IF settled66.numberOfReturnBitfields >= 16 /\ (settled66.orderRejectedReturnBitfield16 # << >> /\ (settled66.orderRejectedReturnBitfield16[1] \div 16) % 2 > 0) THEN (IF settled66.floorDestination = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled66.floorDestination) ELSE << >>]
        settled68 == [settled67 EXCEPT !.floorRoutingInst = IF settled67.numberOfReturnBitfields >= 16 /\ (settled67.orderRejectedReturnBitfield16 # << >> /\ (settled67.orderRejectedReturnBitfield16[1] \div 32) % 2 > 0) THEN (IF settled67.floorRoutingInst = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled67.floorRoutingInst) ELSE << >>]
        settled69 == [settled68 EXCEPT !.multiClassSprd = IF settled68.numberOfReturnBitfields >= 16 /\ (settled68.orderRejectedReturnBitfield16 # << >> /\ (settled68.orderRejectedReturnBitfield16[1] \div 64) % 2 > 0) THEN (IF settled68.multiClassSprd = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled68.multiClassSprd) ELSE << >>]
        settled70 == [settled69 EXCEPT !.orderOrigin = IF settled69.numberOfReturnBitfields >= 16 /\ (settled69.orderRejectedReturnBitfield16 # << >> /\ (settled69.orderRejectedReturnBitfield16[1] \div 128) % 2 > 0) THEN (IF settled69.orderOrigin = << >> THEN <<[i \in 1 .. 3 |-> 0]>> ELSE settled69.orderOrigin) ELSE << >>]
        settled71 == [settled70 EXCEPT !.priceType = IF settled70.numberOfReturnBitfields >= 17 /\ (settled70.orderRejectedReturnBitfield17 # << >> /\ settled70.orderRejectedReturnBitfield17[1] % 2 > 0) THEN (IF settled70.priceType = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled70.priceType) ELSE << >>]
        settled72 == [settled71 EXCEPT !.strategyId = IF settled71.numberOfReturnBitfields >= 17 /\ (settled71.orderRejectedReturnBitfield17 # << >> /\ (settled71.orderRejectedReturnBitfield17[1] \div 2) % 2 > 0) THEN (IF settled71.strategyId = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled71.strategyId) ELSE << >>]
        settled73 == [settled72 EXCEPT !.crossInitiator = IF settled72.numberOfReturnBitfields >= 18 /\ (settled72.orderRejectedReturnBitfield18 # << >> /\ (settled72.orderRejectedReturnBitfield18[1] \div 2) % 2 > 0) THEN (IF settled72.crossInitiator = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled72.crossInitiator) ELSE << >>]
        settled74 == [settled73 EXCEPT !.subreason = IF settled73.numberOfReturnBitfields >= 18 /\ (settled73.orderRejectedReturnBitfield18 # << >> /\ (settled73.orderRejectedReturnBitfield18[1] \div 4) % 2 > 0) THEN (IF settled73.subreason = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled73.subreason) ELSE << >>]
        settled75 == [settled74 EXCEPT !.held = IF settled74.numberOfReturnBitfields >= 18 /\ (settled74.orderRejectedReturnBitfield18 # << >> /\ (settled74.orderRejectedReturnBitfield18[1] \div 32) % 2 > 0) THEN (IF settled74.held = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled74.held) ELSE << >>]
        settled76 == [settled75 EXCEPT !.crossOnBehalfOfId = IF settled75.numberOfReturnBitfields >= 19 /\ (settled75.orderRejectedReturnBitfield19 # << >> /\ (settled75.orderRejectedReturnBitfield19[1] \div 4) % 2 > 0) THEN (IF settled75.crossOnBehalfOfId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled75.crossOnBehalfOfId) ELSE << >>]
        settled77 == [settled76 EXCEPT !.stopPxType = IF settled76.numberOfReturnBitfields >= 19 /\ (settled76.orderRejectedReturnBitfield19 # << >> /\ (settled76.orderRejectedReturnBitfield19[1] \div 64) % 2 > 0) THEN (IF settled76.stopPxType = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled76.stopPxType) ELSE << >>]
    IN  settled77

ZeroOrderRejectedMessage ==
    SettleOrderRejectedMessage([ transactionTime               |-> [i \in 1 .. 8 |-> 0],
                                 clOrdId                       |-> [i \in 1 .. 20 |-> 0],
                                 orderRejectReason             |-> [i \in 1 .. 1 |-> 0],
                                 text                          |-> [i \in 1 .. 60 |-> 0],
                                 reserved1                     |-> [i \in 1 .. 1 |-> 0],
                                 numberOfReturnBitfields       |-> 0,
                                 orderRejectedReturnBitfield1  |-> << >>,
                                 orderRejectedReturnBitfield2  |-> << >>,
                                 orderRejectedReturnBitfield3  |-> << >>,
                                 orderRejectedReturnBitfield4  |-> << >>,
                                 orderRejectedReturnBitfield5  |-> << >>,
                                 orderRejectedReturnBitfield6  |-> << >>,
                                 orderRejectedReturnBitfield7  |-> << >>,
                                 orderRejectedReturnBitfield8  |-> << >>,
                                 orderRejectedReturnBitfield9  |-> << >>,
                                 orderRejectedReturnBitfield10 |-> << >>,
                                 orderRejectedReturnBitfield11 |-> << >>,
                                 orderRejectedReturnBitfield12 |-> << >>,
                                 orderRejectedReturnBitfield13 |-> << >>,
                                 orderRejectedReturnBitfield14 |-> << >>,
                                 orderRejectedReturnBitfield15 |-> << >>,
                                 orderRejectedReturnBitfield16 |-> << >>,
                                 orderRejectedReturnBitfield17 |-> << >>,
                                 orderRejectedReturnBitfield18 |-> << >>,
                                 orderRejectedReturnBitfield19 |-> << >>,
                                 orderRejectedReturnBitfield20 |-> << >>,
                                 orderRejectedReturnBitfield21 |-> << >>,
                                 side                          |-> << >>,
                                 priceLong                     |-> << >>,
                                 execInst                      |-> << >>,
                                 ordType                       |-> << >>,
                                 timeInForce                   |-> << >>,
                                 minQty                        |-> << >>,
                                 symbolLong                    |-> << >>,
                                 capacity                      |-> << >>,
                                 account                       |-> << >>,
                                 clearingFirm                  |-> << >>,
                                 clearingAccount               |-> << >>,
                                 displayIndicator              |-> << >>,
                                 maxFloor                      |-> << >>,
                                 orderQtyLong                  |-> << >>,
                                 preventMatch                  |-> << >>,
                                 maturityDate                  |-> << >>,
                                 strikePrice                   |-> << >>,
                                 putOrCall                     |-> << >>,
                                 openClose                     |-> << >>,
                                 correctedSize                 |-> << >>,
                                 secondaryOrderId              |-> << >>,
                                 contraCapacity                |-> << >>,
                                 attributedQuote               |-> << >>,
                                 echoText                      |-> << >>,
                                 stopPx                        |-> << >>,
                                 routingInst                   |-> << >>,
                                 routStrategy                  |-> << >>,
                                 routeDeliveryMethod           |-> << >>,
                                 exDestination                 |-> << >>,
                                 marketingFeeCode              |-> << >>,
                                 targetPartyId                 |-> << >>,
                                 auctionId                     |-> << >>,
                                 cmtaNumber                    |-> << >>,
                                 crossId                       |-> << >>,
                                 allocQty                      |-> << >>,
                                 giveUpFirmId                  |-> << >>,
                                 routingFirmId                 |-> << >>,
                                 crossExclusionIndicator       |-> << >>,
                                 clearingOptionalData          |-> << >>,
                                 equityPartyId                 |-> << >>,
                                 clientIdAttr                  |-> << >>,
                                 frequentTraderId              |-> << >>,
                                 sessionEligibility            |-> << >>,
                                 comboOrder                    |-> << >>,
                                 compression                   |-> << >>,
                                 floorDestination              |-> << >>,
                                 floorRoutingInst              |-> << >>,
                                 multiClassSprd                |-> << >>,
                                 orderOrigin                   |-> << >>,
                                 priceType                     |-> << >>,
                                 strategyId                    |-> << >>,
                                 crossInitiator                |-> << >>,
                                 subreason                     |-> << >>,
                                 held                          |-> << >>,
                                 crossOnBehalfOfId             |-> << >>,
                                 stopPxType                    |-> << >> ])

(* Order Rejected Message at zero, then each field in turn at the values it is checked at *)
CheckedOrderRejectedMessage ==
    { ZeroOrderRejectedMessage }
        \cup { SettleOrderRejectedMessage([ZeroOrderRejectedMessage EXCEPT !.transactionTime = one]) : one \in Sample(8) }
        \cup { SettleOrderRejectedMessage([ZeroOrderRejectedMessage EXCEPT !.clOrdId = one]) : one \in Sample(20) }
        \cup { SettleOrderRejectedMessage([ZeroOrderRejectedMessage EXCEPT !.orderRejectReason = one]) : one \in Sample(1) }
        \cup { SettleOrderRejectedMessage([ZeroOrderRejectedMessage EXCEPT !.text = one]) : one \in Sample(60) }
        \cup { SettleOrderRejectedMessage([ZeroOrderRejectedMessage EXCEPT !.reserved1 = one]) : one \in Sample(1) }
        \cup { SettleOrderRejectedMessage([ZeroOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = one]) : one \in {0, 1, 255} }
        \cup { SettleOrderRejectedMessage([ZeroOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 1, !.orderRejectedReturnBitfield1 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderRejectedMessage([ZeroOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 2, !.orderRejectedReturnBitfield2 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderRejectedMessage([ZeroOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 3, !.orderRejectedReturnBitfield3 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
