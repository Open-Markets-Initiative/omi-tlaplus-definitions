(***************************************************************************)
(* Quote Execution Message: 78 bytes                                       *)
(***************************************************************************)

QuoteExecutionMessage ==
    [ transactionTime      : Sample(8),
      quoteUpdateId        : Sample(16),
      orderId              : Sample(8),
      execId               : Sample(8),
      symbolShort          : Sample(6),
      clearingFirm         : Sample(4),
      lastShares           : Sample(4),
      lastPx               : Sample(8),
      leavesQty            : Sample(4),
      contraTrader         : Sample(4),
      contraCapacity       : Sample(1),
      side                 : Sample(1),
      baseLiquidityIndicat : Sample(1),
      subLiquidityIndicato : Sample(1),
      feeCode              : Sample(2),
      marketingFeeCode     : Sample(2) ]

EncodeQuoteExecutionMessage(message) ==
    message.transactionTime
        \o message.quoteUpdateId
        \o message.orderId
        \o message.execId
        \o message.symbolShort
        \o message.clearingFirm
        \o message.lastShares
        \o message.lastPx
        \o message.leavesQty
        \o message.contraTrader
        \o message.contraCapacity
        \o message.side
        \o message.baseLiquidityIndicat
        \o message.subLiquidityIndicato
        \o message.feeCode
        \o message.marketingFeeCode

DecodeQuoteExecutionMessage(bytes) ==
    LET transactionTime == ReadBytes(bytes, 8) IN IF ~transactionTime.ok THEN Fail ELSE
    LET quoteUpdateId == ReadBytes(transactionTime.rest, 16) IN IF ~quoteUpdateId.ok THEN Fail ELSE
    LET orderId == ReadBytes(quoteUpdateId.rest, 8) IN IF ~orderId.ok THEN Fail ELSE
    LET execId == ReadBytes(orderId.rest, 8) IN IF ~execId.ok THEN Fail ELSE
    LET symbolShort == ReadBytes(execId.rest, 6) IN IF ~symbolShort.ok THEN Fail ELSE
    LET clearingFirm == ReadBytes(symbolShort.rest, 4) IN IF ~clearingFirm.ok THEN Fail ELSE
    LET lastShares == ReadBytes(clearingFirm.rest, 4) IN IF ~lastShares.ok THEN Fail ELSE
    LET lastPx == ReadBytes(lastShares.rest, 8) IN IF ~lastPx.ok THEN Fail ELSE
    LET leavesQty == ReadBytes(lastPx.rest, 4) IN IF ~leavesQty.ok THEN Fail ELSE
    LET contraTrader == ReadBytes(leavesQty.rest, 4) IN IF ~contraTrader.ok THEN Fail ELSE
    LET contraCapacity == ReadBytes(contraTrader.rest, 1) IN IF ~contraCapacity.ok THEN Fail ELSE
    LET side == ReadBytes(contraCapacity.rest, 1) IN IF ~side.ok THEN Fail ELSE
    LET baseLiquidityIndicat == ReadBytes(side.rest, 1) IN IF ~baseLiquidityIndicat.ok THEN Fail ELSE
    LET subLiquidityIndicato == ReadBytes(baseLiquidityIndicat.rest, 1) IN IF ~subLiquidityIndicato.ok THEN Fail ELSE
    LET feeCode == ReadBytes(subLiquidityIndicato.rest, 2) IN IF ~feeCode.ok THEN Fail ELSE
    LET marketingFeeCode == ReadBytes(feeCode.rest, 2) IN IF ~marketingFeeCode.ok THEN Fail ELSE
    Ok([ transactionTime      |-> transactionTime.value,
         quoteUpdateId        |-> quoteUpdateId.value,
         orderId              |-> orderId.value,
         execId               |-> execId.value,
         symbolShort          |-> symbolShort.value,
         clearingFirm         |-> clearingFirm.value,
         lastShares           |-> lastShares.value,
         lastPx               |-> lastPx.value,
         leavesQty            |-> leavesQty.value,
         contraTrader         |-> contraTrader.value,
         contraCapacity       |-> contraCapacity.value,
         side                 |-> side.value,
         baseLiquidityIndicat |-> baseLiquidityIndicat.value,
         subLiquidityIndicato |-> subLiquidityIndicato.value,
         feeCode              |-> feeCode.value,
         marketingFeeCode     |-> marketingFeeCode.value ], marketingFeeCode.rest)

ZeroQuoteExecutionMessage ==
    [ transactionTime      |-> [i \in 1 .. 8 |-> 0],
      quoteUpdateId        |-> [i \in 1 .. 16 |-> 0],
      orderId              |-> [i \in 1 .. 8 |-> 0],
      execId               |-> [i \in 1 .. 8 |-> 0],
      symbolShort          |-> [i \in 1 .. 6 |-> 0],
      clearingFirm         |-> [i \in 1 .. 4 |-> 0],
      lastShares           |-> [i \in 1 .. 4 |-> 0],
      lastPx               |-> [i \in 1 .. 8 |-> 0],
      leavesQty            |-> [i \in 1 .. 4 |-> 0],
      contraTrader         |-> [i \in 1 .. 4 |-> 0],
      contraCapacity       |-> [i \in 1 .. 1 |-> 0],
      side                 |-> [i \in 1 .. 1 |-> 0],
      baseLiquidityIndicat |-> [i \in 1 .. 1 |-> 0],
      subLiquidityIndicato |-> [i \in 1 .. 1 |-> 0],
      feeCode              |-> [i \in 1 .. 2 |-> 0],
      marketingFeeCode     |-> [i \in 1 .. 2 |-> 0] ]

(* Quote Execution Message at zero, then each field in turn at the values it is checked at *)
CheckedQuoteExecutionMessage ==
    { ZeroQuoteExecutionMessage }
        \cup { [ZeroQuoteExecutionMessage EXCEPT !.transactionTime = one] : one \in Sample(8) }
        \cup { [ZeroQuoteExecutionMessage EXCEPT !.quoteUpdateId = one] : one \in Sample(16) }
        \cup { [ZeroQuoteExecutionMessage EXCEPT !.orderId = one] : one \in Sample(8) }
        \cup { [ZeroQuoteExecutionMessage EXCEPT !.execId = one] : one \in Sample(8) }
        \cup { [ZeroQuoteExecutionMessage EXCEPT !.symbolShort = one] : one \in Sample(6) }
        \cup { [ZeroQuoteExecutionMessage EXCEPT !.clearingFirm = one] : one \in Sample(4) }
        \cup { [ZeroQuoteExecutionMessage EXCEPT !.lastShares = one] : one \in Sample(4) }
        \cup { [ZeroQuoteExecutionMessage EXCEPT !.lastPx = one] : one \in Sample(8) }
        \cup { [ZeroQuoteExecutionMessage EXCEPT !.leavesQty = one] : one \in Sample(4) }
        \cup { [ZeroQuoteExecutionMessage EXCEPT !.contraTrader = one] : one \in Sample(4) }
        \cup { [ZeroQuoteExecutionMessage EXCEPT !.contraCapacity = one] : one \in Sample(1) }
        \cup { [ZeroQuoteExecutionMessage EXCEPT !.side = one] : one \in Sample(1) }
        \cup { [ZeroQuoteExecutionMessage EXCEPT !.baseLiquidityIndicat = one] : one \in Sample(1) }
        \cup { [ZeroQuoteExecutionMessage EXCEPT !.subLiquidityIndicato = one] : one \in Sample(1) }
        \cup { [ZeroQuoteExecutionMessage EXCEPT !.feeCode = one] : one \in Sample(2) }
        \cup { [ZeroQuoteExecutionMessage EXCEPT !.marketingFeeCode = one] : one \in Sample(2) }

(***************************************************************************)
(* Complex Quote Execution Message: 87 bytes                               *)
(***************************************************************************)

ComplexQuoteExecutionMessage ==
    [ transactionTime       : Sample(8),
      quoteUpdateId         : Sample(16),
      orderId               : Sample(8),
      execId                : Sample(8),
      symbolShort           : Sample(6),
      clearingFirm          : Sample(4),
      lastShares            : Sample(4),
      lastPx                : Sample(8),
      leavesQty             : Sample(4),
      contraTrader          : Sample(4),
      contraCapacity        : Sample(1),
      side                  : Sample(1),
      baseLiquidityIndicat  : Sample(1),
      subLiquidityIndicato  : Sample(1),
      feeCode               : Sample(2),
      marketingFeeCode      : Sample(2),
      multilegReportingType : Sample(1),
      secondaryExecId       : Sample(8) ]

EncodeComplexQuoteExecutionMessage(message) ==
    message.transactionTime
        \o message.quoteUpdateId
        \o message.orderId
        \o message.execId
        \o message.symbolShort
        \o message.clearingFirm
        \o message.lastShares
        \o message.lastPx
        \o message.leavesQty
        \o message.contraTrader
        \o message.contraCapacity
        \o message.side
        \o message.baseLiquidityIndicat
        \o message.subLiquidityIndicato
        \o message.feeCode
        \o message.marketingFeeCode
        \o message.multilegReportingType
        \o message.secondaryExecId

DecodeComplexQuoteExecutionMessage(bytes) ==
    LET transactionTime == ReadBytes(bytes, 8) IN IF ~transactionTime.ok THEN Fail ELSE
    LET quoteUpdateId == ReadBytes(transactionTime.rest, 16) IN IF ~quoteUpdateId.ok THEN Fail ELSE
    LET orderId == ReadBytes(quoteUpdateId.rest, 8) IN IF ~orderId.ok THEN Fail ELSE
    LET execId == ReadBytes(orderId.rest, 8) IN IF ~execId.ok THEN Fail ELSE
    LET symbolShort == ReadBytes(execId.rest, 6) IN IF ~symbolShort.ok THEN Fail ELSE
    LET clearingFirm == ReadBytes(symbolShort.rest, 4) IN IF ~clearingFirm.ok THEN Fail ELSE
    LET lastShares == ReadBytes(clearingFirm.rest, 4) IN IF ~lastShares.ok THEN Fail ELSE
    LET lastPx == ReadBytes(lastShares.rest, 8) IN IF ~lastPx.ok THEN Fail ELSE
    LET leavesQty == ReadBytes(lastPx.rest, 4) IN IF ~leavesQty.ok THEN Fail ELSE
    LET contraTrader == ReadBytes(leavesQty.rest, 4) IN IF ~contraTrader.ok THEN Fail ELSE
    LET contraCapacity == ReadBytes(contraTrader.rest, 1) IN IF ~contraCapacity.ok THEN Fail ELSE
    LET side == ReadBytes(contraCapacity.rest, 1) IN IF ~side.ok THEN Fail ELSE
    LET baseLiquidityIndicat == ReadBytes(side.rest, 1) IN IF ~baseLiquidityIndicat.ok THEN Fail ELSE
    LET subLiquidityIndicato == ReadBytes(baseLiquidityIndicat.rest, 1) IN IF ~subLiquidityIndicato.ok THEN Fail ELSE
    LET feeCode == ReadBytes(subLiquidityIndicato.rest, 2) IN IF ~feeCode.ok THEN Fail ELSE
    LET marketingFeeCode == ReadBytes(feeCode.rest, 2) IN IF ~marketingFeeCode.ok THEN Fail ELSE
    LET multilegReportingType == ReadBytes(marketingFeeCode.rest, 1) IN IF ~multilegReportingType.ok THEN Fail ELSE
    LET secondaryExecId == ReadBytes(multilegReportingType.rest, 8) IN IF ~secondaryExecId.ok THEN Fail ELSE
    Ok([ transactionTime       |-> transactionTime.value,
         quoteUpdateId         |-> quoteUpdateId.value,
         orderId               |-> orderId.value,
         execId                |-> execId.value,
         symbolShort           |-> symbolShort.value,
         clearingFirm          |-> clearingFirm.value,
         lastShares            |-> lastShares.value,
         lastPx                |-> lastPx.value,
         leavesQty             |-> leavesQty.value,
         contraTrader          |-> contraTrader.value,
         contraCapacity        |-> contraCapacity.value,
         side                  |-> side.value,
         baseLiquidityIndicat  |-> baseLiquidityIndicat.value,
         subLiquidityIndicato  |-> subLiquidityIndicato.value,
         feeCode               |-> feeCode.value,
         marketingFeeCode      |-> marketingFeeCode.value,
         multilegReportingType |-> multilegReportingType.value,
         secondaryExecId       |-> secondaryExecId.value ], secondaryExecId.rest)

ZeroComplexQuoteExecutionMessage ==
    [ transactionTime       |-> [i \in 1 .. 8 |-> 0],
      quoteUpdateId         |-> [i \in 1 .. 16 |-> 0],
      orderId               |-> [i \in 1 .. 8 |-> 0],
      execId                |-> [i \in 1 .. 8 |-> 0],
      symbolShort           |-> [i \in 1 .. 6 |-> 0],
      clearingFirm          |-> [i \in 1 .. 4 |-> 0],
      lastShares            |-> [i \in 1 .. 4 |-> 0],
      lastPx                |-> [i \in 1 .. 8 |-> 0],
      leavesQty             |-> [i \in 1 .. 4 |-> 0],
      contraTrader          |-> [i \in 1 .. 4 |-> 0],
      contraCapacity        |-> [i \in 1 .. 1 |-> 0],
      side                  |-> [i \in 1 .. 1 |-> 0],
      baseLiquidityIndicat  |-> [i \in 1 .. 1 |-> 0],
      subLiquidityIndicato  |-> [i \in 1 .. 1 |-> 0],
      feeCode               |-> [i \in 1 .. 2 |-> 0],
      marketingFeeCode      |-> [i \in 1 .. 2 |-> 0],
      multilegReportingType |-> [i \in 1 .. 1 |-> 0],
      secondaryExecId       |-> [i \in 1 .. 8 |-> 0] ]

(* Complex Quote Execution Message at zero, then each field in turn at the values it is checked at *)
CheckedComplexQuoteExecutionMessage ==
    { ZeroComplexQuoteExecutionMessage }
        \cup { [ZeroComplexQuoteExecutionMessage EXCEPT !.transactionTime = one] : one \in Sample(8) }
        \cup { [ZeroComplexQuoteExecutionMessage EXCEPT !.quoteUpdateId = one] : one \in Sample(16) }
        \cup { [ZeroComplexQuoteExecutionMessage EXCEPT !.orderId = one] : one \in Sample(8) }
        \cup { [ZeroComplexQuoteExecutionMessage EXCEPT !.execId = one] : one \in Sample(8) }
        \cup { [ZeroComplexQuoteExecutionMessage EXCEPT !.symbolShort = one] : one \in Sample(6) }
        \cup { [ZeroComplexQuoteExecutionMessage EXCEPT !.clearingFirm = one] : one \in Sample(4) }
        \cup { [ZeroComplexQuoteExecutionMessage EXCEPT !.lastShares = one] : one \in Sample(4) }
        \cup { [ZeroComplexQuoteExecutionMessage EXCEPT !.lastPx = one] : one \in Sample(8) }
        \cup { [ZeroComplexQuoteExecutionMessage EXCEPT !.leavesQty = one] : one \in Sample(4) }
        \cup { [ZeroComplexQuoteExecutionMessage EXCEPT !.contraTrader = one] : one \in Sample(4) }
        \cup { [ZeroComplexQuoteExecutionMessage EXCEPT !.contraCapacity = one] : one \in Sample(1) }
        \cup { [ZeroComplexQuoteExecutionMessage EXCEPT !.side = one] : one \in Sample(1) }
        \cup { [ZeroComplexQuoteExecutionMessage EXCEPT !.baseLiquidityIndicat = one] : one \in Sample(1) }
        \cup { [ZeroComplexQuoteExecutionMessage EXCEPT !.subLiquidityIndicato = one] : one \in Sample(1) }
        \cup { [ZeroComplexQuoteExecutionMessage EXCEPT !.feeCode = one] : one \in Sample(2) }
        \cup { [ZeroComplexQuoteExecutionMessage EXCEPT !.marketingFeeCode = one] : one \in Sample(2) }
        \cup { [ZeroComplexQuoteExecutionMessage EXCEPT !.multilegReportingType = one] : one \in Sample(1) }
        \cup { [ZeroComplexQuoteExecutionMessage EXCEPT !.secondaryExecId = one] : one \in Sample(8) }

(***************************************************************************)
(* Trade Cancel Or Correct Message                                         *)
(***************************************************************************)

TradeCancelOrCorrectMessage ==
    [ transactionTime                      : Sample(8),
      clOrdId                              : Sample(20),
      orderId                              : Sample(8),
      execRefId                            : Sample(8),
      side                                 : Sample(1),
      baseLiquidityIndicator               : Sample(1),
      clearingFirm                         : Sample(4),
      clearingAccount                      : Sample(4),
      lastShares                           : Sample(4),
      lastPx                               : Sample(8),
      correctedPrice                       : Sample(8),
      origTime                             : Sample(8),
      reserved1                            : Sample(1),
      numberOfReturnBitf                   : Sample(1),
      numberOfReturnBitfields              : 0 .. 255,
      tradeCancelorCorrectReturnBitfield1  : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeCancelorCorrectReturnBitfield2  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      tradeCancelorCorrectReturnBitfield3  : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeCancelorCorrectReturnBitfield4  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      tradeCancelorCorrectReturnBitfield5  : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeCancelorCorrectReturnBitfield6  : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeCancelorCorrectReturnBitfield7  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      tradeCancelorCorrectReturnBitfield8  : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeCancelorCorrectReturnBitfield9  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      tradeCancelorCorrectReturnBitfield10 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      tradeCancelorCorrectReturnBitfield11 : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeCancelorCorrectReturnBitfield12 : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeCancelorCorrectReturnBitfield13 : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeCancelorCorrectReturnBitfield14 : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeCancelorCorrectReturnBitfield15 : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeCancelorCorrectReturnBitfield16 : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeCancelorCorrectReturnBitfield17 : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeCancelorCorrectReturnBitfield18 : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeCancelorCorrectReturnBitfield19 : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeCancelorCorrectReturnBitfield20 : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeCancelorCorrectReturnBitfield21 : { << >> } \cup { <<held>> : held \in Sample(1) },
      symbolLong                           : { << >> } \cup { <<held>> : held \in Sample(8) },
      capacity                             : { << >> } \cup { <<held>> : held \in Sample(1) },
      maturityDate                         : { << >> } \cup { <<held>> : held \in Sample(4) },
      strikePrice                          : { << >> } \cup { <<held>> : held \in Sample(8) },
      putOrCall                            : { << >> } \cup { <<held>> : held \in Sample(1) },
      openClose                            : { << >> } \cup { <<held>> : held \in Sample(1) },
      correctedSize                        : { << >> } \cup { <<held>> : held \in Sample(4) },
      subLiquidityIndicator                : { << >> } \cup { <<held>> : held \in Sample(1) },
      marketingFeeCode                     : { << >> } \cup { <<held>> : held \in Sample(2) },
      targetPartyId                        : { << >> } \cup { <<held>> : held \in Sample(4) },
      auctionId                            : { << >> } \cup { <<held>> : held \in Sample(8) },
      cmtaNumber                           : { << >> } \cup { <<held>> : held \in Sample(4) },
      crossId                              : { << >> } \cup { <<held>> : held \in Sample(20) },
      giveUpFirmId                         : { << >> } \cup { <<held>> : held \in Sample(4) },
      routingFirmId                        : { << >> } \cup { <<held>> : held \in Sample(4) },
      crossExclusionIndicator              : { << >> } \cup { <<held>> : held \in Sample(1) } ]

EncodeTradeCancelOrCorrectMessage(message) ==
    message.transactionTime
        \o message.clOrdId
        \o message.orderId
        \o message.execRefId
        \o message.side
        \o message.baseLiquidityIndicator
        \o message.clearingFirm
        \o message.clearingAccount
        \o message.lastShares
        \o message.lastPx
        \o message.correctedPrice
        \o message.origTime
        \o message.reserved1
        \o message.numberOfReturnBitf
        \o EncodeUIntBE(message.numberOfReturnBitfields, 1)
        \o (IF message.tradeCancelorCorrectReturnBitfield1 = << >> THEN << >> ELSE message.tradeCancelorCorrectReturnBitfield1[1])
        \o (IF message.tradeCancelorCorrectReturnBitfield2 = << >> THEN << >> ELSE EncodeUIntLE(message.tradeCancelorCorrectReturnBitfield2[1], 1))
        \o (IF message.tradeCancelorCorrectReturnBitfield3 = << >> THEN << >> ELSE message.tradeCancelorCorrectReturnBitfield3[1])
        \o (IF message.tradeCancelorCorrectReturnBitfield4 = << >> THEN << >> ELSE EncodeUIntLE(message.tradeCancelorCorrectReturnBitfield4[1], 1))
        \o (IF message.tradeCancelorCorrectReturnBitfield5 = << >> THEN << >> ELSE message.tradeCancelorCorrectReturnBitfield5[1])
        \o (IF message.tradeCancelorCorrectReturnBitfield6 = << >> THEN << >> ELSE message.tradeCancelorCorrectReturnBitfield6[1])
        \o (IF message.tradeCancelorCorrectReturnBitfield7 = << >> THEN << >> ELSE EncodeUIntLE(message.tradeCancelorCorrectReturnBitfield7[1], 1))
        \o (IF message.tradeCancelorCorrectReturnBitfield8 = << >> THEN << >> ELSE message.tradeCancelorCorrectReturnBitfield8[1])
        \o (IF message.tradeCancelorCorrectReturnBitfield9 = << >> THEN << >> ELSE EncodeUIntLE(message.tradeCancelorCorrectReturnBitfield9[1], 1))
        \o (IF message.tradeCancelorCorrectReturnBitfield10 = << >> THEN << >> ELSE EncodeUIntLE(message.tradeCancelorCorrectReturnBitfield10[1], 1))
        \o (IF message.tradeCancelorCorrectReturnBitfield11 = << >> THEN << >> ELSE message.tradeCancelorCorrectReturnBitfield11[1])
        \o (IF message.tradeCancelorCorrectReturnBitfield12 = << >> THEN << >> ELSE message.tradeCancelorCorrectReturnBitfield12[1])
        \o (IF message.tradeCancelorCorrectReturnBitfield13 = << >> THEN << >> ELSE message.tradeCancelorCorrectReturnBitfield13[1])
        \o (IF message.tradeCancelorCorrectReturnBitfield14 = << >> THEN << >> ELSE message.tradeCancelorCorrectReturnBitfield14[1])
        \o (IF message.tradeCancelorCorrectReturnBitfield15 = << >> THEN << >> ELSE message.tradeCancelorCorrectReturnBitfield15[1])
        \o (IF message.tradeCancelorCorrectReturnBitfield16 = << >> THEN << >> ELSE message.tradeCancelorCorrectReturnBitfield16[1])
        \o (IF message.tradeCancelorCorrectReturnBitfield17 = << >> THEN << >> ELSE message.tradeCancelorCorrectReturnBitfield17[1])
        \o (IF message.tradeCancelorCorrectReturnBitfield18 = << >> THEN << >> ELSE message.tradeCancelorCorrectReturnBitfield18[1])
        \o (IF message.tradeCancelorCorrectReturnBitfield19 = << >> THEN << >> ELSE message.tradeCancelorCorrectReturnBitfield19[1])
        \o (IF message.tradeCancelorCorrectReturnBitfield20 = << >> THEN << >> ELSE message.tradeCancelorCorrectReturnBitfield20[1])
        \o (IF message.tradeCancelorCorrectReturnBitfield21 = << >> THEN << >> ELSE message.tradeCancelorCorrectReturnBitfield21[1])
        \o (IF message.symbolLong = << >> THEN << >> ELSE message.symbolLong[1])
        \o (IF message.capacity = << >> THEN << >> ELSE message.capacity[1])
        \o (IF message.maturityDate = << >> THEN << >> ELSE message.maturityDate[1])
        \o (IF message.strikePrice = << >> THEN << >> ELSE message.strikePrice[1])
        \o (IF message.putOrCall = << >> THEN << >> ELSE message.putOrCall[1])
        \o (IF message.openClose = << >> THEN << >> ELSE message.openClose[1])
        \o (IF message.correctedSize = << >> THEN << >> ELSE message.correctedSize[1])
        \o (IF message.subLiquidityIndicator = << >> THEN << >> ELSE message.subLiquidityIndicator[1])
        \o (IF message.marketingFeeCode = << >> THEN << >> ELSE message.marketingFeeCode[1])
        \o (IF message.targetPartyId = << >> THEN << >> ELSE message.targetPartyId[1])
        \o (IF message.auctionId = << >> THEN << >> ELSE message.auctionId[1])
        \o (IF message.cmtaNumber = << >> THEN << >> ELSE message.cmtaNumber[1])
        \o (IF message.crossId = << >> THEN << >> ELSE message.crossId[1])
        \o (IF message.giveUpFirmId = << >> THEN << >> ELSE message.giveUpFirmId[1])
        \o (IF message.routingFirmId = << >> THEN << >> ELSE message.routingFirmId[1])
        \o (IF message.crossExclusionIndicator = << >> THEN << >> ELSE message.crossExclusionIndicator[1])

DecodeTradeCancelOrCorrectMessage(bytes) ==
    LET transactionTime == ReadBytes(bytes, 8) IN IF ~transactionTime.ok THEN Fail ELSE
    LET clOrdId == ReadBytes(transactionTime.rest, 20) IN IF ~clOrdId.ok THEN Fail ELSE
    LET orderId == ReadBytes(clOrdId.rest, 8) IN IF ~orderId.ok THEN Fail ELSE
    LET execRefId == ReadBytes(orderId.rest, 8) IN IF ~execRefId.ok THEN Fail ELSE
    LET side == ReadBytes(execRefId.rest, 1) IN IF ~side.ok THEN Fail ELSE
    LET baseLiquidityIndicator == ReadBytes(side.rest, 1) IN IF ~baseLiquidityIndicator.ok THEN Fail ELSE
    LET clearingFirm == ReadBytes(baseLiquidityIndicator.rest, 4) IN IF ~clearingFirm.ok THEN Fail ELSE
    LET clearingAccount == ReadBytes(clearingFirm.rest, 4) IN IF ~clearingAccount.ok THEN Fail ELSE
    LET lastShares == ReadBytes(clearingAccount.rest, 4) IN IF ~lastShares.ok THEN Fail ELSE
    LET lastPx == ReadBytes(lastShares.rest, 8) IN IF ~lastPx.ok THEN Fail ELSE
    LET correctedPrice == ReadBytes(lastPx.rest, 8) IN IF ~correctedPrice.ok THEN Fail ELSE
    LET origTime == ReadBytes(correctedPrice.rest, 8) IN IF ~origTime.ok THEN Fail ELSE
    LET reserved1 == ReadBytes(origTime.rest, 1) IN IF ~reserved1.ok THEN Fail ELSE
    LET numberOfReturnBitf == ReadBytes(reserved1.rest, 1) IN IF ~numberOfReturnBitf.ok THEN Fail ELSE
    LET numberOfReturnBitfields == ReadUIntBE(numberOfReturnBitf.rest, 1) IN IF ~numberOfReturnBitfields.ok THEN Fail ELSE
    LET tradeCancelorCorrectReturnBitfield1 == ReadWhen(numberOfReturnBitfields.value >= 1, ReadBytes(numberOfReturnBitfields.rest, 1), numberOfReturnBitfields.rest) IN IF ~tradeCancelorCorrectReturnBitfield1.ok THEN Fail ELSE
    LET tradeCancelorCorrectReturnBitfield2 == ReadWhen(numberOfReturnBitfields.value >= 2, ReadUIntLE(tradeCancelorCorrectReturnBitfield1.rest, 1), tradeCancelorCorrectReturnBitfield1.rest) IN IF ~tradeCancelorCorrectReturnBitfield2.ok THEN Fail ELSE
    LET tradeCancelorCorrectReturnBitfield3 == ReadWhen(numberOfReturnBitfields.value >= 3, ReadBytes(tradeCancelorCorrectReturnBitfield2.rest, 1), tradeCancelorCorrectReturnBitfield2.rest) IN IF ~tradeCancelorCorrectReturnBitfield3.ok THEN Fail ELSE
    LET tradeCancelorCorrectReturnBitfield4 == ReadWhen(numberOfReturnBitfields.value >= 4, ReadUIntLE(tradeCancelorCorrectReturnBitfield3.rest, 1), tradeCancelorCorrectReturnBitfield3.rest) IN IF ~tradeCancelorCorrectReturnBitfield4.ok THEN Fail ELSE
    LET tradeCancelorCorrectReturnBitfield5 == ReadWhen(numberOfReturnBitfields.value >= 5, ReadBytes(tradeCancelorCorrectReturnBitfield4.rest, 1), tradeCancelorCorrectReturnBitfield4.rest) IN IF ~tradeCancelorCorrectReturnBitfield5.ok THEN Fail ELSE
    LET tradeCancelorCorrectReturnBitfield6 == ReadWhen(numberOfReturnBitfields.value >= 6, ReadBytes(tradeCancelorCorrectReturnBitfield5.rest, 1), tradeCancelorCorrectReturnBitfield5.rest) IN IF ~tradeCancelorCorrectReturnBitfield6.ok THEN Fail ELSE
    LET tradeCancelorCorrectReturnBitfield7 == ReadWhen(numberOfReturnBitfields.value >= 7, ReadUIntLE(tradeCancelorCorrectReturnBitfield6.rest, 1), tradeCancelorCorrectReturnBitfield6.rest) IN IF ~tradeCancelorCorrectReturnBitfield7.ok THEN Fail ELSE
    LET tradeCancelorCorrectReturnBitfield8 == ReadWhen(numberOfReturnBitfields.value >= 8, ReadBytes(tradeCancelorCorrectReturnBitfield7.rest, 1), tradeCancelorCorrectReturnBitfield7.rest) IN IF ~tradeCancelorCorrectReturnBitfield8.ok THEN Fail ELSE
    LET tradeCancelorCorrectReturnBitfield9 == ReadWhen(numberOfReturnBitfields.value >= 9, ReadUIntLE(tradeCancelorCorrectReturnBitfield8.rest, 1), tradeCancelorCorrectReturnBitfield8.rest) IN IF ~tradeCancelorCorrectReturnBitfield9.ok THEN Fail ELSE
    LET tradeCancelorCorrectReturnBitfield10 == ReadWhen(numberOfReturnBitfields.value >= 10, ReadUIntLE(tradeCancelorCorrectReturnBitfield9.rest, 1), tradeCancelorCorrectReturnBitfield9.rest) IN IF ~tradeCancelorCorrectReturnBitfield10.ok THEN Fail ELSE
    LET tradeCancelorCorrectReturnBitfield11 == ReadWhen(numberOfReturnBitfields.value >= 11, ReadBytes(tradeCancelorCorrectReturnBitfield10.rest, 1), tradeCancelorCorrectReturnBitfield10.rest) IN IF ~tradeCancelorCorrectReturnBitfield11.ok THEN Fail ELSE
    LET tradeCancelorCorrectReturnBitfield12 == ReadWhen(numberOfReturnBitfields.value >= 12, ReadBytes(tradeCancelorCorrectReturnBitfield11.rest, 1), tradeCancelorCorrectReturnBitfield11.rest) IN IF ~tradeCancelorCorrectReturnBitfield12.ok THEN Fail ELSE
    LET tradeCancelorCorrectReturnBitfield13 == ReadWhen(numberOfReturnBitfields.value >= 13, ReadBytes(tradeCancelorCorrectReturnBitfield12.rest, 1), tradeCancelorCorrectReturnBitfield12.rest) IN IF ~tradeCancelorCorrectReturnBitfield13.ok THEN Fail ELSE
    LET tradeCancelorCorrectReturnBitfield14 == ReadWhen(numberOfReturnBitfields.value >= 14, ReadBytes(tradeCancelorCorrectReturnBitfield13.rest, 1), tradeCancelorCorrectReturnBitfield13.rest) IN IF ~tradeCancelorCorrectReturnBitfield14.ok THEN Fail ELSE
    LET tradeCancelorCorrectReturnBitfield15 == ReadWhen(numberOfReturnBitfields.value >= 15, ReadBytes(tradeCancelorCorrectReturnBitfield14.rest, 1), tradeCancelorCorrectReturnBitfield14.rest) IN IF ~tradeCancelorCorrectReturnBitfield15.ok THEN Fail ELSE
    LET tradeCancelorCorrectReturnBitfield16 == ReadWhen(numberOfReturnBitfields.value >= 16, ReadBytes(tradeCancelorCorrectReturnBitfield15.rest, 1), tradeCancelorCorrectReturnBitfield15.rest) IN IF ~tradeCancelorCorrectReturnBitfield16.ok THEN Fail ELSE
    LET tradeCancelorCorrectReturnBitfield17 == ReadWhen(numberOfReturnBitfields.value >= 17, ReadBytes(tradeCancelorCorrectReturnBitfield16.rest, 1), tradeCancelorCorrectReturnBitfield16.rest) IN IF ~tradeCancelorCorrectReturnBitfield17.ok THEN Fail ELSE
    LET tradeCancelorCorrectReturnBitfield18 == ReadWhen(numberOfReturnBitfields.value >= 18, ReadBytes(tradeCancelorCorrectReturnBitfield17.rest, 1), tradeCancelorCorrectReturnBitfield17.rest) IN IF ~tradeCancelorCorrectReturnBitfield18.ok THEN Fail ELSE
    LET tradeCancelorCorrectReturnBitfield19 == ReadWhen(numberOfReturnBitfields.value >= 19, ReadBytes(tradeCancelorCorrectReturnBitfield18.rest, 1), tradeCancelorCorrectReturnBitfield18.rest) IN IF ~tradeCancelorCorrectReturnBitfield19.ok THEN Fail ELSE
    LET tradeCancelorCorrectReturnBitfield20 == ReadWhen(numberOfReturnBitfields.value >= 20, ReadBytes(tradeCancelorCorrectReturnBitfield19.rest, 1), tradeCancelorCorrectReturnBitfield19.rest) IN IF ~tradeCancelorCorrectReturnBitfield20.ok THEN Fail ELSE
    LET tradeCancelorCorrectReturnBitfield21 == ReadWhen(numberOfReturnBitfields.value >= 21, ReadBytes(tradeCancelorCorrectReturnBitfield20.rest, 1), tradeCancelorCorrectReturnBitfield20.rest) IN IF ~tradeCancelorCorrectReturnBitfield21.ok THEN Fail ELSE
    LET symbolLong == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (tradeCancelorCorrectReturnBitfield2.value # << >> /\ tradeCancelorCorrectReturnBitfield2.value[1] % 2 > 0), ReadBytes(tradeCancelorCorrectReturnBitfield21.rest, 8), tradeCancelorCorrectReturnBitfield21.rest) IN IF ~symbolLong.ok THEN Fail ELSE
    LET capacity == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (tradeCancelorCorrectReturnBitfield2.value # << >> /\ (tradeCancelorCorrectReturnBitfield2.value[1] \div 64) % 2 > 0), ReadBytes(symbolLong.rest, 1), symbolLong.rest) IN IF ~capacity.ok THEN Fail ELSE
    LET maturityDate == ReadWhen(numberOfReturnBitfields.value >= 4 /\ (tradeCancelorCorrectReturnBitfield4.value # << >> /\ tradeCancelorCorrectReturnBitfield4.value[1] % 2 > 0), ReadBytes(capacity.rest, 4), capacity.rest) IN IF ~maturityDate.ok THEN Fail ELSE
    LET strikePrice == ReadWhen(numberOfReturnBitfields.value >= 4 /\ (tradeCancelorCorrectReturnBitfield4.value # << >> /\ (tradeCancelorCorrectReturnBitfield4.value[1] \div 2) % 2 > 0), ReadBytes(maturityDate.rest, 8), maturityDate.rest) IN IF ~strikePrice.ok THEN Fail ELSE
    LET putOrCall == ReadWhen(numberOfReturnBitfields.value >= 4 /\ (tradeCancelorCorrectReturnBitfield4.value # << >> /\ (tradeCancelorCorrectReturnBitfield4.value[1] \div 4) % 2 > 0), ReadBytes(strikePrice.rest, 1), strikePrice.rest) IN IF ~putOrCall.ok THEN Fail ELSE
    LET openClose == ReadWhen(numberOfReturnBitfields.value >= 4 /\ (tradeCancelorCorrectReturnBitfield4.value # << >> /\ (tradeCancelorCorrectReturnBitfield4.value[1] \div 8) % 2 > 0), ReadBytes(putOrCall.rest, 1), putOrCall.rest) IN IF ~openClose.ok THEN Fail ELSE
    LET correctedSize == ReadWhen(numberOfReturnBitfields.value >= 4 /\ (tradeCancelorCorrectReturnBitfield4.value # << >> /\ (tradeCancelorCorrectReturnBitfield4.value[1] \div 32) % 2 > 0), ReadBytes(openClose.rest, 4), openClose.rest) IN IF ~correctedSize.ok THEN Fail ELSE
    LET subLiquidityIndicator == ReadWhen(numberOfReturnBitfields.value >= 7 /\ (tradeCancelorCorrectReturnBitfield7.value # << >> /\ tradeCancelorCorrectReturnBitfield7.value[1] % 2 > 0), ReadBytes(correctedSize.rest, 1), correctedSize.rest) IN IF ~subLiquidityIndicator.ok THEN Fail ELSE
    LET marketingFeeCode == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (tradeCancelorCorrectReturnBitfield9.value # << >> /\ tradeCancelorCorrectReturnBitfield9.value[1] % 2 > 0), ReadBytes(subLiquidityIndicator.rest, 2), subLiquidityIndicator.rest) IN IF ~marketingFeeCode.ok THEN Fail ELSE
    LET targetPartyId == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (tradeCancelorCorrectReturnBitfield9.value # << >> /\ (tradeCancelorCorrectReturnBitfield9.value[1] \div 2) % 2 > 0), ReadBytes(marketingFeeCode.rest, 4), marketingFeeCode.rest) IN IF ~targetPartyId.ok THEN Fail ELSE
    LET auctionId == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (tradeCancelorCorrectReturnBitfield9.value # << >> /\ (tradeCancelorCorrectReturnBitfield9.value[1] \div 4) % 2 > 0), ReadBytes(targetPartyId.rest, 8), targetPartyId.rest) IN IF ~auctionId.ok THEN Fail ELSE
    LET cmtaNumber == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (tradeCancelorCorrectReturnBitfield9.value # << >> /\ (tradeCancelorCorrectReturnBitfield9.value[1] \div 32) % 2 > 0), ReadBytes(auctionId.rest, 4), auctionId.rest) IN IF ~cmtaNumber.ok THEN Fail ELSE
    LET crossId == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (tradeCancelorCorrectReturnBitfield10.value # << >> /\ tradeCancelorCorrectReturnBitfield10.value[1] % 2 > 0), ReadBytes(cmtaNumber.rest, 20), cmtaNumber.rest) IN IF ~crossId.ok THEN Fail ELSE
    LET giveUpFirmId == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (tradeCancelorCorrectReturnBitfield10.value # << >> /\ (tradeCancelorCorrectReturnBitfield10.value[1] \div 4) % 2 > 0), ReadBytes(crossId.rest, 4), crossId.rest) IN IF ~giveUpFirmId.ok THEN Fail ELSE
    LET routingFirmId == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (tradeCancelorCorrectReturnBitfield10.value # << >> /\ (tradeCancelorCorrectReturnBitfield10.value[1] \div 8) % 2 > 0), ReadBytes(giveUpFirmId.rest, 4), giveUpFirmId.rest) IN IF ~routingFirmId.ok THEN Fail ELSE
    LET crossExclusionIndicator == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (tradeCancelorCorrectReturnBitfield10.value # << >> /\ (tradeCancelorCorrectReturnBitfield10.value[1] \div 32) % 2 > 0), ReadBytes(routingFirmId.rest, 1), routingFirmId.rest) IN IF ~crossExclusionIndicator.ok THEN Fail ELSE
    Ok([ transactionTime                      |-> transactionTime.value,
         clOrdId                              |-> clOrdId.value,
         orderId                              |-> orderId.value,
         execRefId                            |-> execRefId.value,
         side                                 |-> side.value,
         baseLiquidityIndicator               |-> baseLiquidityIndicator.value,
         clearingFirm                         |-> clearingFirm.value,
         clearingAccount                      |-> clearingAccount.value,
         lastShares                           |-> lastShares.value,
         lastPx                               |-> lastPx.value,
         correctedPrice                       |-> correctedPrice.value,
         origTime                             |-> origTime.value,
         reserved1                            |-> reserved1.value,
         numberOfReturnBitf                   |-> numberOfReturnBitf.value,
         numberOfReturnBitfields              |-> numberOfReturnBitfields.value,
         tradeCancelorCorrectReturnBitfield1  |-> tradeCancelorCorrectReturnBitfield1.value,
         tradeCancelorCorrectReturnBitfield2  |-> tradeCancelorCorrectReturnBitfield2.value,
         tradeCancelorCorrectReturnBitfield3  |-> tradeCancelorCorrectReturnBitfield3.value,
         tradeCancelorCorrectReturnBitfield4  |-> tradeCancelorCorrectReturnBitfield4.value,
         tradeCancelorCorrectReturnBitfield5  |-> tradeCancelorCorrectReturnBitfield5.value,
         tradeCancelorCorrectReturnBitfield6  |-> tradeCancelorCorrectReturnBitfield6.value,
         tradeCancelorCorrectReturnBitfield7  |-> tradeCancelorCorrectReturnBitfield7.value,
         tradeCancelorCorrectReturnBitfield8  |-> tradeCancelorCorrectReturnBitfield8.value,
         tradeCancelorCorrectReturnBitfield9  |-> tradeCancelorCorrectReturnBitfield9.value,
         tradeCancelorCorrectReturnBitfield10 |-> tradeCancelorCorrectReturnBitfield10.value,
         tradeCancelorCorrectReturnBitfield11 |-> tradeCancelorCorrectReturnBitfield11.value,
         tradeCancelorCorrectReturnBitfield12 |-> tradeCancelorCorrectReturnBitfield12.value,
         tradeCancelorCorrectReturnBitfield13 |-> tradeCancelorCorrectReturnBitfield13.value,
         tradeCancelorCorrectReturnBitfield14 |-> tradeCancelorCorrectReturnBitfield14.value,
         tradeCancelorCorrectReturnBitfield15 |-> tradeCancelorCorrectReturnBitfield15.value,
         tradeCancelorCorrectReturnBitfield16 |-> tradeCancelorCorrectReturnBitfield16.value,
         tradeCancelorCorrectReturnBitfield17 |-> tradeCancelorCorrectReturnBitfield17.value,
         tradeCancelorCorrectReturnBitfield18 |-> tradeCancelorCorrectReturnBitfield18.value,
         tradeCancelorCorrectReturnBitfield19 |-> tradeCancelorCorrectReturnBitfield19.value,
         tradeCancelorCorrectReturnBitfield20 |-> tradeCancelorCorrectReturnBitfield20.value,
         tradeCancelorCorrectReturnBitfield21 |-> tradeCancelorCorrectReturnBitfield21.value,
         symbolLong                           |-> symbolLong.value,
         capacity                             |-> capacity.value,
         maturityDate                         |-> maturityDate.value,
         strikePrice                          |-> strikePrice.value,
         putOrCall                            |-> putOrCall.value,
         openClose                            |-> openClose.value,
         correctedSize                        |-> correctedSize.value,
         subLiquidityIndicator                |-> subLiquidityIndicator.value,
         marketingFeeCode                     |-> marketingFeeCode.value,
         targetPartyId                        |-> targetPartyId.value,
         auctionId                            |-> auctionId.value,
         cmtaNumber                           |-> cmtaNumber.value,
         crossId                              |-> crossId.value,
         giveUpFirmId                         |-> giveUpFirmId.value,
         routingFirmId                        |-> routingFirmId.value,
         crossExclusionIndicator              |-> crossExclusionIndicator.value ], crossExclusionIndicator.rest)

(* Trade Cancel Or Correct Message with each field marked present by fields before it there exactly where they say *)
SettleTradeCancelOrCorrectMessage(message) ==
    LET settled1 == [message EXCEPT !.tradeCancelorCorrectReturnBitfield1 = IF message.numberOfReturnBitfields >= 1 THEN (IF message.tradeCancelorCorrectReturnBitfield1 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE message.tradeCancelorCorrectReturnBitfield1) ELSE << >>]
        settled2 == [settled1 EXCEPT !.tradeCancelorCorrectReturnBitfield2 = IF settled1.numberOfReturnBitfields >= 2 THEN (IF settled1.tradeCancelorCorrectReturnBitfield2 = << >> THEN <<0>> ELSE settled1.tradeCancelorCorrectReturnBitfield2) ELSE << >>]
        settled3 == [settled2 EXCEPT !.tradeCancelorCorrectReturnBitfield3 = IF settled2.numberOfReturnBitfields >= 3 THEN (IF settled2.tradeCancelorCorrectReturnBitfield3 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled2.tradeCancelorCorrectReturnBitfield3) ELSE << >>]
        settled4 == [settled3 EXCEPT !.tradeCancelorCorrectReturnBitfield4 = IF settled3.numberOfReturnBitfields >= 4 THEN (IF settled3.tradeCancelorCorrectReturnBitfield4 = << >> THEN <<0>> ELSE settled3.tradeCancelorCorrectReturnBitfield4) ELSE << >>]
        settled5 == [settled4 EXCEPT !.tradeCancelorCorrectReturnBitfield5 = IF settled4.numberOfReturnBitfields >= 5 THEN (IF settled4.tradeCancelorCorrectReturnBitfield5 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled4.tradeCancelorCorrectReturnBitfield5) ELSE << >>]
        settled6 == [settled5 EXCEPT !.tradeCancelorCorrectReturnBitfield6 = IF settled5.numberOfReturnBitfields >= 6 THEN (IF settled5.tradeCancelorCorrectReturnBitfield6 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled5.tradeCancelorCorrectReturnBitfield6) ELSE << >>]
        settled7 == [settled6 EXCEPT !.tradeCancelorCorrectReturnBitfield7 = IF settled6.numberOfReturnBitfields >= 7 THEN (IF settled6.tradeCancelorCorrectReturnBitfield7 = << >> THEN <<0>> ELSE settled6.tradeCancelorCorrectReturnBitfield7) ELSE << >>]
        settled8 == [settled7 EXCEPT !.tradeCancelorCorrectReturnBitfield8 = IF settled7.numberOfReturnBitfields >= 8 THEN (IF settled7.tradeCancelorCorrectReturnBitfield8 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled7.tradeCancelorCorrectReturnBitfield8) ELSE << >>]
        settled9 == [settled8 EXCEPT !.tradeCancelorCorrectReturnBitfield9 = IF settled8.numberOfReturnBitfields >= 9 THEN (IF settled8.tradeCancelorCorrectReturnBitfield9 = << >> THEN <<0>> ELSE settled8.tradeCancelorCorrectReturnBitfield9) ELSE << >>]
        settled10 == [settled9 EXCEPT !.tradeCancelorCorrectReturnBitfield10 = IF settled9.numberOfReturnBitfields >= 10 THEN (IF settled9.tradeCancelorCorrectReturnBitfield10 = << >> THEN <<0>> ELSE settled9.tradeCancelorCorrectReturnBitfield10) ELSE << >>]
        settled11 == [settled10 EXCEPT !.tradeCancelorCorrectReturnBitfield11 = IF settled10.numberOfReturnBitfields >= 11 THEN (IF settled10.tradeCancelorCorrectReturnBitfield11 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled10.tradeCancelorCorrectReturnBitfield11) ELSE << >>]
        settled12 == [settled11 EXCEPT !.tradeCancelorCorrectReturnBitfield12 = IF settled11.numberOfReturnBitfields >= 12 THEN (IF settled11.tradeCancelorCorrectReturnBitfield12 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled11.tradeCancelorCorrectReturnBitfield12) ELSE << >>]
        settled13 == [settled12 EXCEPT !.tradeCancelorCorrectReturnBitfield13 = IF settled12.numberOfReturnBitfields >= 13 THEN (IF settled12.tradeCancelorCorrectReturnBitfield13 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled12.tradeCancelorCorrectReturnBitfield13) ELSE << >>]
        settled14 == [settled13 EXCEPT !.tradeCancelorCorrectReturnBitfield14 = IF settled13.numberOfReturnBitfields >= 14 THEN (IF settled13.tradeCancelorCorrectReturnBitfield14 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled13.tradeCancelorCorrectReturnBitfield14) ELSE << >>]
        settled15 == [settled14 EXCEPT !.tradeCancelorCorrectReturnBitfield15 = IF settled14.numberOfReturnBitfields >= 15 THEN (IF settled14.tradeCancelorCorrectReturnBitfield15 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled14.tradeCancelorCorrectReturnBitfield15) ELSE << >>]
        settled16 == [settled15 EXCEPT !.tradeCancelorCorrectReturnBitfield16 = IF settled15.numberOfReturnBitfields >= 16 THEN (IF settled15.tradeCancelorCorrectReturnBitfield16 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled15.tradeCancelorCorrectReturnBitfield16) ELSE << >>]
        settled17 == [settled16 EXCEPT !.tradeCancelorCorrectReturnBitfield17 = IF settled16.numberOfReturnBitfields >= 17 THEN (IF settled16.tradeCancelorCorrectReturnBitfield17 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled16.tradeCancelorCorrectReturnBitfield17) ELSE << >>]
        settled18 == [settled17 EXCEPT !.tradeCancelorCorrectReturnBitfield18 = IF settled17.numberOfReturnBitfields >= 18 THEN (IF settled17.tradeCancelorCorrectReturnBitfield18 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled17.tradeCancelorCorrectReturnBitfield18) ELSE << >>]
        settled19 == [settled18 EXCEPT !.tradeCancelorCorrectReturnBitfield19 = IF settled18.numberOfReturnBitfields >= 19 THEN (IF settled18.tradeCancelorCorrectReturnBitfield19 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled18.tradeCancelorCorrectReturnBitfield19) ELSE << >>]
        settled20 == [settled19 EXCEPT !.tradeCancelorCorrectReturnBitfield20 = IF settled19.numberOfReturnBitfields >= 20 THEN (IF settled19.tradeCancelorCorrectReturnBitfield20 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled19.tradeCancelorCorrectReturnBitfield20) ELSE << >>]
        settled21 == [settled20 EXCEPT !.tradeCancelorCorrectReturnBitfield21 = IF settled20.numberOfReturnBitfields >= 21 THEN (IF settled20.tradeCancelorCorrectReturnBitfield21 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled20.tradeCancelorCorrectReturnBitfield21) ELSE << >>]
        settled22 == [settled21 EXCEPT !.symbolLong = IF settled21.numberOfReturnBitfields >= 2 /\ (settled21.tradeCancelorCorrectReturnBitfield2 # << >> /\ settled21.tradeCancelorCorrectReturnBitfield2[1] % 2 > 0) THEN (IF settled21.symbolLong = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled21.symbolLong) ELSE << >>]
        settled23 == [settled22 EXCEPT !.capacity = IF settled22.numberOfReturnBitfields >= 2 /\ (settled22.tradeCancelorCorrectReturnBitfield2 # << >> /\ (settled22.tradeCancelorCorrectReturnBitfield2[1] \div 64) % 2 > 0) THEN (IF settled22.capacity = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled22.capacity) ELSE << >>]
        settled24 == [settled23 EXCEPT !.maturityDate = IF settled23.numberOfReturnBitfields >= 4 /\ (settled23.tradeCancelorCorrectReturnBitfield4 # << >> /\ settled23.tradeCancelorCorrectReturnBitfield4[1] % 2 > 0) THEN (IF settled23.maturityDate = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled23.maturityDate) ELSE << >>]
        settled25 == [settled24 EXCEPT !.strikePrice = IF settled24.numberOfReturnBitfields >= 4 /\ (settled24.tradeCancelorCorrectReturnBitfield4 # << >> /\ (settled24.tradeCancelorCorrectReturnBitfield4[1] \div 2) % 2 > 0) THEN (IF settled24.strikePrice = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled24.strikePrice) ELSE << >>]
        settled26 == [settled25 EXCEPT !.putOrCall = IF settled25.numberOfReturnBitfields >= 4 /\ (settled25.tradeCancelorCorrectReturnBitfield4 # << >> /\ (settled25.tradeCancelorCorrectReturnBitfield4[1] \div 4) % 2 > 0) THEN (IF settled25.putOrCall = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled25.putOrCall) ELSE << >>]
        settled27 == [settled26 EXCEPT !.openClose = IF settled26.numberOfReturnBitfields >= 4 /\ (settled26.tradeCancelorCorrectReturnBitfield4 # << >> /\ (settled26.tradeCancelorCorrectReturnBitfield4[1] \div 8) % 2 > 0) THEN (IF settled26.openClose = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled26.openClose) ELSE << >>]
        settled28 == [settled27 EXCEPT !.correctedSize = IF settled27.numberOfReturnBitfields >= 4 /\ (settled27.tradeCancelorCorrectReturnBitfield4 # << >> /\ (settled27.tradeCancelorCorrectReturnBitfield4[1] \div 32) % 2 > 0) THEN (IF settled27.correctedSize = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled27.correctedSize) ELSE << >>]
        settled29 == [settled28 EXCEPT !.subLiquidityIndicator = IF settled28.numberOfReturnBitfields >= 7 /\ (settled28.tradeCancelorCorrectReturnBitfield7 # << >> /\ settled28.tradeCancelorCorrectReturnBitfield7[1] % 2 > 0) THEN (IF settled28.subLiquidityIndicator = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled28.subLiquidityIndicator) ELSE << >>]
        settled30 == [settled29 EXCEPT !.marketingFeeCode = IF settled29.numberOfReturnBitfields >= 9 /\ (settled29.tradeCancelorCorrectReturnBitfield9 # << >> /\ settled29.tradeCancelorCorrectReturnBitfield9[1] % 2 > 0) THEN (IF settled29.marketingFeeCode = << >> THEN <<[i \in 1 .. 2 |-> 0]>> ELSE settled29.marketingFeeCode) ELSE << >>]
        settled31 == [settled30 EXCEPT !.targetPartyId = IF settled30.numberOfReturnBitfields >= 9 /\ (settled30.tradeCancelorCorrectReturnBitfield9 # << >> /\ (settled30.tradeCancelorCorrectReturnBitfield9[1] \div 2) % 2 > 0) THEN (IF settled30.targetPartyId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled30.targetPartyId) ELSE << >>]
        settled32 == [settled31 EXCEPT !.auctionId = IF settled31.numberOfReturnBitfields >= 9 /\ (settled31.tradeCancelorCorrectReturnBitfield9 # << >> /\ (settled31.tradeCancelorCorrectReturnBitfield9[1] \div 4) % 2 > 0) THEN (IF settled31.auctionId = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled31.auctionId) ELSE << >>]
        settled33 == [settled32 EXCEPT !.cmtaNumber = IF settled32.numberOfReturnBitfields >= 9 /\ (settled32.tradeCancelorCorrectReturnBitfield9 # << >> /\ (settled32.tradeCancelorCorrectReturnBitfield9[1] \div 32) % 2 > 0) THEN (IF settled32.cmtaNumber = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled32.cmtaNumber) ELSE << >>]
        settled34 == [settled33 EXCEPT !.crossId = IF settled33.numberOfReturnBitfields >= 10 /\ (settled33.tradeCancelorCorrectReturnBitfield10 # << >> /\ settled33.tradeCancelorCorrectReturnBitfield10[1] % 2 > 0) THEN (IF settled33.crossId = << >> THEN <<[i \in 1 .. 20 |-> 0]>> ELSE settled33.crossId) ELSE << >>]
        settled35 == [settled34 EXCEPT !.giveUpFirmId = IF settled34.numberOfReturnBitfields >= 10 /\ (settled34.tradeCancelorCorrectReturnBitfield10 # << >> /\ (settled34.tradeCancelorCorrectReturnBitfield10[1] \div 4) % 2 > 0) THEN (IF settled34.giveUpFirmId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled34.giveUpFirmId) ELSE << >>]
        settled36 == [settled35 EXCEPT !.routingFirmId = IF settled35.numberOfReturnBitfields >= 10 /\ (settled35.tradeCancelorCorrectReturnBitfield10 # << >> /\ (settled35.tradeCancelorCorrectReturnBitfield10[1] \div 8) % 2 > 0) THEN (IF settled35.routingFirmId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled35.routingFirmId) ELSE << >>]
        settled37 == [settled36 EXCEPT !.crossExclusionIndicator = IF settled36.numberOfReturnBitfields >= 10 /\ (settled36.tradeCancelorCorrectReturnBitfield10 # << >> /\ (settled36.tradeCancelorCorrectReturnBitfield10[1] \div 32) % 2 > 0) THEN (IF settled36.crossExclusionIndicator = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled36.crossExclusionIndicator) ELSE << >>]
    IN  settled37

ZeroTradeCancelOrCorrectMessage ==
    SettleTradeCancelOrCorrectMessage([ transactionTime                      |-> [i \in 1 .. 8 |-> 0],
                                        clOrdId                              |-> [i \in 1 .. 20 |-> 0],
                                        orderId                              |-> [i \in 1 .. 8 |-> 0],
                                        execRefId                            |-> [i \in 1 .. 8 |-> 0],
                                        side                                 |-> [i \in 1 .. 1 |-> 0],
                                        baseLiquidityIndicator               |-> [i \in 1 .. 1 |-> 0],
                                        clearingFirm                         |-> [i \in 1 .. 4 |-> 0],
                                        clearingAccount                      |-> [i \in 1 .. 4 |-> 0],
                                        lastShares                           |-> [i \in 1 .. 4 |-> 0],
                                        lastPx                               |-> [i \in 1 .. 8 |-> 0],
                                        correctedPrice                       |-> [i \in 1 .. 8 |-> 0],
                                        origTime                             |-> [i \in 1 .. 8 |-> 0],
                                        reserved1                            |-> [i \in 1 .. 1 |-> 0],
                                        numberOfReturnBitf                   |-> [i \in 1 .. 1 |-> 0],
                                        numberOfReturnBitfields              |-> 0,
                                        tradeCancelorCorrectReturnBitfield1  |-> << >>,
                                        tradeCancelorCorrectReturnBitfield2  |-> << >>,
                                        tradeCancelorCorrectReturnBitfield3  |-> << >>,
                                        tradeCancelorCorrectReturnBitfield4  |-> << >>,
                                        tradeCancelorCorrectReturnBitfield5  |-> << >>,
                                        tradeCancelorCorrectReturnBitfield6  |-> << >>,
                                        tradeCancelorCorrectReturnBitfield7  |-> << >>,
                                        tradeCancelorCorrectReturnBitfield8  |-> << >>,
                                        tradeCancelorCorrectReturnBitfield9  |-> << >>,
                                        tradeCancelorCorrectReturnBitfield10 |-> << >>,
                                        tradeCancelorCorrectReturnBitfield11 |-> << >>,
                                        tradeCancelorCorrectReturnBitfield12 |-> << >>,
                                        tradeCancelorCorrectReturnBitfield13 |-> << >>,
                                        tradeCancelorCorrectReturnBitfield14 |-> << >>,
                                        tradeCancelorCorrectReturnBitfield15 |-> << >>,
                                        tradeCancelorCorrectReturnBitfield16 |-> << >>,
                                        tradeCancelorCorrectReturnBitfield17 |-> << >>,
                                        tradeCancelorCorrectReturnBitfield18 |-> << >>,
                                        tradeCancelorCorrectReturnBitfield19 |-> << >>,
                                        tradeCancelorCorrectReturnBitfield20 |-> << >>,
                                        tradeCancelorCorrectReturnBitfield21 |-> << >>,
                                        symbolLong                           |-> << >>,
                                        capacity                             |-> << >>,
                                        maturityDate                         |-> << >>,
                                        strikePrice                          |-> << >>,
                                        putOrCall                            |-> << >>,
                                        openClose                            |-> << >>,
                                        correctedSize                        |-> << >>,
                                        subLiquidityIndicator                |-> << >>,
                                        marketingFeeCode                     |-> << >>,
                                        targetPartyId                        |-> << >>,
                                        auctionId                            |-> << >>,
                                        cmtaNumber                           |-> << >>,
                                        crossId                              |-> << >>,
                                        giveUpFirmId                         |-> << >>,
                                        routingFirmId                        |-> << >>,
                                        crossExclusionIndicator              |-> << >> ])

(* Trade Cancel Or Correct Message at zero, then each field in turn at the values it is checked at *)
CheckedTradeCancelOrCorrectMessage ==
    { ZeroTradeCancelOrCorrectMessage }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.transactionTime = one]) : one \in Sample(8) }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.clOrdId = one]) : one \in Sample(20) }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.orderId = one]) : one \in Sample(8) }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.execRefId = one]) : one \in Sample(8) }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.side = one]) : one \in Sample(1) }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.baseLiquidityIndicator = one]) : one \in Sample(1) }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.clearingFirm = one]) : one \in Sample(4) }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.clearingAccount = one]) : one \in Sample(4) }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.lastShares = one]) : one \in Sample(4) }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.lastPx = one]) : one \in Sample(8) }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.correctedPrice = one]) : one \in Sample(8) }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.origTime = one]) : one \in Sample(8) }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.reserved1 = one]) : one \in Sample(1) }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.numberOfReturnBitf = one]) : one \in Sample(1) }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.numberOfReturnBitfields = one]) : one \in {0, 1, 255} }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.numberOfReturnBitfields = 1, !.tradeCancelorCorrectReturnBitfield1 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.numberOfReturnBitfields = 2, !.tradeCancelorCorrectReturnBitfield2 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.numberOfReturnBitfields = 3, !.tradeCancelorCorrectReturnBitfield3 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.numberOfReturnBitfields = 4, !.tradeCancelorCorrectReturnBitfield4 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.numberOfReturnBitfields = 5, !.tradeCancelorCorrectReturnBitfield5 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.numberOfReturnBitfields = 6, !.tradeCancelorCorrectReturnBitfield6 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.numberOfReturnBitfields = 7, !.tradeCancelorCorrectReturnBitfield7 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.numberOfReturnBitfields = 8, !.tradeCancelorCorrectReturnBitfield8 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.numberOfReturnBitfields = 9, !.tradeCancelorCorrectReturnBitfield9 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.numberOfReturnBitfields = 10, !.tradeCancelorCorrectReturnBitfield10 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.numberOfReturnBitfields = 11, !.tradeCancelorCorrectReturnBitfield11 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.numberOfReturnBitfields = 12, !.tradeCancelorCorrectReturnBitfield12 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.numberOfReturnBitfields = 13, !.tradeCancelorCorrectReturnBitfield13 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.numberOfReturnBitfields = 14, !.tradeCancelorCorrectReturnBitfield14 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.numberOfReturnBitfields = 15, !.tradeCancelorCorrectReturnBitfield15 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.numberOfReturnBitfields = 16, !.tradeCancelorCorrectReturnBitfield16 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.numberOfReturnBitfields = 17, !.tradeCancelorCorrectReturnBitfield17 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.numberOfReturnBitfields = 18, !.tradeCancelorCorrectReturnBitfield18 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.numberOfReturnBitfields = 19, !.tradeCancelorCorrectReturnBitfield19 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.numberOfReturnBitfields = 20, !.tradeCancelorCorrectReturnBitfield20 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.numberOfReturnBitfields = 21, !.tradeCancelorCorrectReturnBitfield21 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.numberOfReturnBitfields = 2, !.tradeCancelorCorrectReturnBitfield2 = <<1>>, !.symbolLong = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.numberOfReturnBitfields = 2, !.tradeCancelorCorrectReturnBitfield2 = <<64>>, !.capacity = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.numberOfReturnBitfields = 4, !.tradeCancelorCorrectReturnBitfield4 = <<1>>, !.maturityDate = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.numberOfReturnBitfields = 4, !.tradeCancelorCorrectReturnBitfield4 = <<2>>, !.strikePrice = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.numberOfReturnBitfields = 4, !.tradeCancelorCorrectReturnBitfield4 = <<4>>, !.putOrCall = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.numberOfReturnBitfields = 4, !.tradeCancelorCorrectReturnBitfield4 = <<8>>, !.openClose = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.numberOfReturnBitfields = 4, !.tradeCancelorCorrectReturnBitfield4 = <<32>>, !.correctedSize = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.numberOfReturnBitfields = 7, !.tradeCancelorCorrectReturnBitfield7 = <<1>>, !.subLiquidityIndicator = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.numberOfReturnBitfields = 9, !.tradeCancelorCorrectReturnBitfield9 = <<1>>, !.marketingFeeCode = one]) : one \in { <<held>> : held \in Sample(2) } }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.numberOfReturnBitfields = 9, !.tradeCancelorCorrectReturnBitfield9 = <<2>>, !.targetPartyId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.numberOfReturnBitfields = 9, !.tradeCancelorCorrectReturnBitfield9 = <<4>>, !.auctionId = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.numberOfReturnBitfields = 9, !.tradeCancelorCorrectReturnBitfield9 = <<32>>, !.cmtaNumber = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.numberOfReturnBitfields = 10, !.tradeCancelorCorrectReturnBitfield10 = <<1>>, !.crossId = one]) : one \in { <<held>> : held \in Sample(20) } }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.numberOfReturnBitfields = 10, !.tradeCancelorCorrectReturnBitfield10 = <<4>>, !.giveUpFirmId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.numberOfReturnBitfields = 10, !.tradeCancelorCorrectReturnBitfield10 = <<8>>, !.routingFirmId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleTradeCancelOrCorrectMessage([ZeroTradeCancelOrCorrectMessage EXCEPT !.numberOfReturnBitfields = 10, !.tradeCancelorCorrectReturnBitfield10 = <<32>>, !.crossExclusionIndicator = one]) : one \in { <<held>> : held \in Sample(1) } }

(***************************************************************************)
(* Purge Rejected Message                                                  *)
(***************************************************************************)

PurgeRejectedMessage ==
    [ transactionTime               : Sample(8),
      purgeRejectReason             : Sample(1),
      text                          : Sample(60),
      reserved1                     : Sample(1),
      numberOfReturnBitfields       : 0 .. 255,
      purgeRejectedReturnBitfield1  : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeRejectedReturnBitfield2  : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeRejectedReturnBitfield3  : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeRejectedReturnBitfield4  : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeRejectedReturnBitfield5  : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeRejectedReturnBitfield6  : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeRejectedReturnBitfield7  : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeRejectedReturnBitfield8  : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeRejectedReturnBitfield9  : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeRejectedReturnBitfield10 : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeRejectedReturnBitfield11 : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeRejectedReturnBitfield12 : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeRejectedReturnBitfield13 : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeRejectedReturnBitfield14 : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeRejectedReturnBitfield15 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      purgeRejectedReturnBitfield16 : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeRejectedReturnBitfield17 : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeRejectedReturnBitfield18 : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeRejectedReturnBitfield19 : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeRejectedReturnBitfield20 : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeRejectedReturnBitfield21 : { << >> } \cup { <<held>> : held \in Sample(1) },
      massCancelId                  : { << >> } \cup { <<held>> : held \in Sample(20) } ]

EncodePurgeRejectedMessage(message) ==
    message.transactionTime
        \o message.purgeRejectReason
        \o message.text
        \o message.reserved1
        \o EncodeUIntBE(message.numberOfReturnBitfields, 1)
        \o (IF message.purgeRejectedReturnBitfield1 = << >> THEN << >> ELSE message.purgeRejectedReturnBitfield1[1])
        \o (IF message.purgeRejectedReturnBitfield2 = << >> THEN << >> ELSE message.purgeRejectedReturnBitfield2[1])
        \o (IF message.purgeRejectedReturnBitfield3 = << >> THEN << >> ELSE message.purgeRejectedReturnBitfield3[1])
        \o (IF message.purgeRejectedReturnBitfield4 = << >> THEN << >> ELSE message.purgeRejectedReturnBitfield4[1])
        \o (IF message.purgeRejectedReturnBitfield5 = << >> THEN << >> ELSE message.purgeRejectedReturnBitfield5[1])
        \o (IF message.purgeRejectedReturnBitfield6 = << >> THEN << >> ELSE message.purgeRejectedReturnBitfield6[1])
        \o (IF message.purgeRejectedReturnBitfield7 = << >> THEN << >> ELSE message.purgeRejectedReturnBitfield7[1])
        \o (IF message.purgeRejectedReturnBitfield8 = << >> THEN << >> ELSE message.purgeRejectedReturnBitfield8[1])
        \o (IF message.purgeRejectedReturnBitfield9 = << >> THEN << >> ELSE message.purgeRejectedReturnBitfield9[1])
        \o (IF message.purgeRejectedReturnBitfield10 = << >> THEN << >> ELSE message.purgeRejectedReturnBitfield10[1])
        \o (IF message.purgeRejectedReturnBitfield11 = << >> THEN << >> ELSE message.purgeRejectedReturnBitfield11[1])
        \o (IF message.purgeRejectedReturnBitfield12 = << >> THEN << >> ELSE message.purgeRejectedReturnBitfield12[1])
        \o (IF message.purgeRejectedReturnBitfield13 = << >> THEN << >> ELSE message.purgeRejectedReturnBitfield13[1])
        \o (IF message.purgeRejectedReturnBitfield14 = << >> THEN << >> ELSE message.purgeRejectedReturnBitfield14[1])
        \o (IF message.purgeRejectedReturnBitfield15 = << >> THEN << >> ELSE EncodeUIntLE(message.purgeRejectedReturnBitfield15[1], 1))
        \o (IF message.purgeRejectedReturnBitfield16 = << >> THEN << >> ELSE message.purgeRejectedReturnBitfield16[1])
        \o (IF message.purgeRejectedReturnBitfield17 = << >> THEN << >> ELSE message.purgeRejectedReturnBitfield17[1])
        \o (IF message.purgeRejectedReturnBitfield18 = << >> THEN << >> ELSE message.purgeRejectedReturnBitfield18[1])
        \o (IF message.purgeRejectedReturnBitfield19 = << >> THEN << >> ELSE message.purgeRejectedReturnBitfield19[1])
        \o (IF message.purgeRejectedReturnBitfield20 = << >> THEN << >> ELSE message.purgeRejectedReturnBitfield20[1])
        \o (IF message.purgeRejectedReturnBitfield21 = << >> THEN << >> ELSE message.purgeRejectedReturnBitfield21[1])
        \o (IF message.massCancelId = << >> THEN << >> ELSE message.massCancelId[1])

DecodePurgeRejectedMessage(bytes) ==
    LET transactionTime == ReadBytes(bytes, 8) IN IF ~transactionTime.ok THEN Fail ELSE
    LET purgeRejectReason == ReadBytes(transactionTime.rest, 1) IN IF ~purgeRejectReason.ok THEN Fail ELSE
    LET text == ReadBytes(purgeRejectReason.rest, 60) IN IF ~text.ok THEN Fail ELSE
    LET reserved1 == ReadBytes(text.rest, 1) IN IF ~reserved1.ok THEN Fail ELSE
    LET numberOfReturnBitfields == ReadUIntBE(reserved1.rest, 1) IN IF ~numberOfReturnBitfields.ok THEN Fail ELSE
    LET purgeRejectedReturnBitfield1 == ReadWhen(numberOfReturnBitfields.value >= 1, ReadBytes(numberOfReturnBitfields.rest, 1), numberOfReturnBitfields.rest) IN IF ~purgeRejectedReturnBitfield1.ok THEN Fail ELSE
    LET purgeRejectedReturnBitfield2 == ReadWhen(numberOfReturnBitfields.value >= 2, ReadBytes(purgeRejectedReturnBitfield1.rest, 1), purgeRejectedReturnBitfield1.rest) IN IF ~purgeRejectedReturnBitfield2.ok THEN Fail ELSE
    LET purgeRejectedReturnBitfield3 == ReadWhen(numberOfReturnBitfields.value >= 3, ReadBytes(purgeRejectedReturnBitfield2.rest, 1), purgeRejectedReturnBitfield2.rest) IN IF ~purgeRejectedReturnBitfield3.ok THEN Fail ELSE
    LET purgeRejectedReturnBitfield4 == ReadWhen(numberOfReturnBitfields.value >= 4, ReadBytes(purgeRejectedReturnBitfield3.rest, 1), purgeRejectedReturnBitfield3.rest) IN IF ~purgeRejectedReturnBitfield4.ok THEN Fail ELSE
    LET purgeRejectedReturnBitfield5 == ReadWhen(numberOfReturnBitfields.value >= 5, ReadBytes(purgeRejectedReturnBitfield4.rest, 1), purgeRejectedReturnBitfield4.rest) IN IF ~purgeRejectedReturnBitfield5.ok THEN Fail ELSE
    LET purgeRejectedReturnBitfield6 == ReadWhen(numberOfReturnBitfields.value >= 6, ReadBytes(purgeRejectedReturnBitfield5.rest, 1), purgeRejectedReturnBitfield5.rest) IN IF ~purgeRejectedReturnBitfield6.ok THEN Fail ELSE
    LET purgeRejectedReturnBitfield7 == ReadWhen(numberOfReturnBitfields.value >= 7, ReadBytes(purgeRejectedReturnBitfield6.rest, 1), purgeRejectedReturnBitfield6.rest) IN IF ~purgeRejectedReturnBitfield7.ok THEN Fail ELSE
    LET purgeRejectedReturnBitfield8 == ReadWhen(numberOfReturnBitfields.value >= 8, ReadBytes(purgeRejectedReturnBitfield7.rest, 1), purgeRejectedReturnBitfield7.rest) IN IF ~purgeRejectedReturnBitfield8.ok THEN Fail ELSE
    LET purgeRejectedReturnBitfield9 == ReadWhen(numberOfReturnBitfields.value >= 9, ReadBytes(purgeRejectedReturnBitfield8.rest, 1), purgeRejectedReturnBitfield8.rest) IN IF ~purgeRejectedReturnBitfield9.ok THEN Fail ELSE
    LET purgeRejectedReturnBitfield10 == ReadWhen(numberOfReturnBitfields.value >= 10, ReadBytes(purgeRejectedReturnBitfield9.rest, 1), purgeRejectedReturnBitfield9.rest) IN IF ~purgeRejectedReturnBitfield10.ok THEN Fail ELSE
    LET purgeRejectedReturnBitfield11 == ReadWhen(numberOfReturnBitfields.value >= 11, ReadBytes(purgeRejectedReturnBitfield10.rest, 1), purgeRejectedReturnBitfield10.rest) IN IF ~purgeRejectedReturnBitfield11.ok THEN Fail ELSE
    LET purgeRejectedReturnBitfield12 == ReadWhen(numberOfReturnBitfields.value >= 12, ReadBytes(purgeRejectedReturnBitfield11.rest, 1), purgeRejectedReturnBitfield11.rest) IN IF ~purgeRejectedReturnBitfield12.ok THEN Fail ELSE
    LET purgeRejectedReturnBitfield13 == ReadWhen(numberOfReturnBitfields.value >= 13, ReadBytes(purgeRejectedReturnBitfield12.rest, 1), purgeRejectedReturnBitfield12.rest) IN IF ~purgeRejectedReturnBitfield13.ok THEN Fail ELSE
    LET purgeRejectedReturnBitfield14 == ReadWhen(numberOfReturnBitfields.value >= 14, ReadBytes(purgeRejectedReturnBitfield13.rest, 1), purgeRejectedReturnBitfield13.rest) IN IF ~purgeRejectedReturnBitfield14.ok THEN Fail ELSE
    LET purgeRejectedReturnBitfield15 == ReadWhen(numberOfReturnBitfields.value >= 15, ReadUIntLE(purgeRejectedReturnBitfield14.rest, 1), purgeRejectedReturnBitfield14.rest) IN IF ~purgeRejectedReturnBitfield15.ok THEN Fail ELSE
    LET purgeRejectedReturnBitfield16 == ReadWhen(numberOfReturnBitfields.value >= 16, ReadBytes(purgeRejectedReturnBitfield15.rest, 1), purgeRejectedReturnBitfield15.rest) IN IF ~purgeRejectedReturnBitfield16.ok THEN Fail ELSE
    LET purgeRejectedReturnBitfield17 == ReadWhen(numberOfReturnBitfields.value >= 17, ReadBytes(purgeRejectedReturnBitfield16.rest, 1), purgeRejectedReturnBitfield16.rest) IN IF ~purgeRejectedReturnBitfield17.ok THEN Fail ELSE
    LET purgeRejectedReturnBitfield18 == ReadWhen(numberOfReturnBitfields.value >= 18, ReadBytes(purgeRejectedReturnBitfield17.rest, 1), purgeRejectedReturnBitfield17.rest) IN IF ~purgeRejectedReturnBitfield18.ok THEN Fail ELSE
    LET purgeRejectedReturnBitfield19 == ReadWhen(numberOfReturnBitfields.value >= 19, ReadBytes(purgeRejectedReturnBitfield18.rest, 1), purgeRejectedReturnBitfield18.rest) IN IF ~purgeRejectedReturnBitfield19.ok THEN Fail ELSE
    LET purgeRejectedReturnBitfield20 == ReadWhen(numberOfReturnBitfields.value >= 20, ReadBytes(purgeRejectedReturnBitfield19.rest, 1), purgeRejectedReturnBitfield19.rest) IN IF ~purgeRejectedReturnBitfield20.ok THEN Fail ELSE
    LET purgeRejectedReturnBitfield21 == ReadWhen(numberOfReturnBitfields.value >= 21, ReadBytes(purgeRejectedReturnBitfield20.rest, 1), purgeRejectedReturnBitfield20.rest) IN IF ~purgeRejectedReturnBitfield21.ok THEN Fail ELSE
    LET massCancelId == ReadWhen(numberOfReturnBitfields.value >= 15 /\ (purgeRejectedReturnBitfield15.value # << >> /\ (purgeRejectedReturnBitfield15.value[1] \div 8) % 2 > 0), ReadBytes(purgeRejectedReturnBitfield21.rest, 20), purgeRejectedReturnBitfield21.rest) IN IF ~massCancelId.ok THEN Fail ELSE
    Ok([ transactionTime               |-> transactionTime.value,
         purgeRejectReason             |-> purgeRejectReason.value,
         text                          |-> text.value,
         reserved1                     |-> reserved1.value,
         numberOfReturnBitfields       |-> numberOfReturnBitfields.value,
         purgeRejectedReturnBitfield1  |-> purgeRejectedReturnBitfield1.value,
         purgeRejectedReturnBitfield2  |-> purgeRejectedReturnBitfield2.value,
         purgeRejectedReturnBitfield3  |-> purgeRejectedReturnBitfield3.value,
         purgeRejectedReturnBitfield4  |-> purgeRejectedReturnBitfield4.value,
         purgeRejectedReturnBitfield5  |-> purgeRejectedReturnBitfield5.value,
         purgeRejectedReturnBitfield6  |-> purgeRejectedReturnBitfield6.value,
         purgeRejectedReturnBitfield7  |-> purgeRejectedReturnBitfield7.value,
         purgeRejectedReturnBitfield8  |-> purgeRejectedReturnBitfield8.value,
         purgeRejectedReturnBitfield9  |-> purgeRejectedReturnBitfield9.value,
         purgeRejectedReturnBitfield10 |-> purgeRejectedReturnBitfield10.value,
         purgeRejectedReturnBitfield11 |-> purgeRejectedReturnBitfield11.value,
         purgeRejectedReturnBitfield12 |-> purgeRejectedReturnBitfield12.value,
         purgeRejectedReturnBitfield13 |-> purgeRejectedReturnBitfield13.value,
         purgeRejectedReturnBitfield14 |-> purgeRejectedReturnBitfield14.value,
         purgeRejectedReturnBitfield15 |-> purgeRejectedReturnBitfield15.value,
         purgeRejectedReturnBitfield16 |-> purgeRejectedReturnBitfield16.value,
         purgeRejectedReturnBitfield17 |-> purgeRejectedReturnBitfield17.value,
         purgeRejectedReturnBitfield18 |-> purgeRejectedReturnBitfield18.value,
         purgeRejectedReturnBitfield19 |-> purgeRejectedReturnBitfield19.value,
         purgeRejectedReturnBitfield20 |-> purgeRejectedReturnBitfield20.value,
         purgeRejectedReturnBitfield21 |-> purgeRejectedReturnBitfield21.value,
         massCancelId                  |-> massCancelId.value ], massCancelId.rest)

(* Purge Rejected Message with each field marked present by fields before it there exactly where they say *)
SettlePurgeRejectedMessage(message) ==
    LET settled1 == [message EXCEPT !.purgeRejectedReturnBitfield1 = IF message.numberOfReturnBitfields >= 1 THEN (IF message.purgeRejectedReturnBitfield1 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE message.purgeRejectedReturnBitfield1) ELSE << >>]
        settled2 == [settled1 EXCEPT !.purgeRejectedReturnBitfield2 = IF settled1.numberOfReturnBitfields >= 2 THEN (IF settled1.purgeRejectedReturnBitfield2 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled1.purgeRejectedReturnBitfield2) ELSE << >>]
        settled3 == [settled2 EXCEPT !.purgeRejectedReturnBitfield3 = IF settled2.numberOfReturnBitfields >= 3 THEN (IF settled2.purgeRejectedReturnBitfield3 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled2.purgeRejectedReturnBitfield3) ELSE << >>]
        settled4 == [settled3 EXCEPT !.purgeRejectedReturnBitfield4 = IF settled3.numberOfReturnBitfields >= 4 THEN (IF settled3.purgeRejectedReturnBitfield4 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled3.purgeRejectedReturnBitfield4) ELSE << >>]
        settled5 == [settled4 EXCEPT !.purgeRejectedReturnBitfield5 = IF settled4.numberOfReturnBitfields >= 5 THEN (IF settled4.purgeRejectedReturnBitfield5 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled4.purgeRejectedReturnBitfield5) ELSE << >>]
        settled6 == [settled5 EXCEPT !.purgeRejectedReturnBitfield6 = IF settled5.numberOfReturnBitfields >= 6 THEN (IF settled5.purgeRejectedReturnBitfield6 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled5.purgeRejectedReturnBitfield6) ELSE << >>]
        settled7 == [settled6 EXCEPT !.purgeRejectedReturnBitfield7 = IF settled6.numberOfReturnBitfields >= 7 THEN (IF settled6.purgeRejectedReturnBitfield7 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled6.purgeRejectedReturnBitfield7) ELSE << >>]
        settled8 == [settled7 EXCEPT !.purgeRejectedReturnBitfield8 = IF settled7.numberOfReturnBitfields >= 8 THEN (IF settled7.purgeRejectedReturnBitfield8 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled7.purgeRejectedReturnBitfield8) ELSE << >>]
        settled9 == [settled8 EXCEPT !.purgeRejectedReturnBitfield9 = IF settled8.numberOfReturnBitfields >= 9 THEN (IF settled8.purgeRejectedReturnBitfield9 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled8.purgeRejectedReturnBitfield9) ELSE << >>]
        settled10 == [settled9 EXCEPT !.purgeRejectedReturnBitfield10 = IF settled9.numberOfReturnBitfields >= 10 THEN (IF settled9.purgeRejectedReturnBitfield10 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled9.purgeRejectedReturnBitfield10) ELSE << >>]
        settled11 == [settled10 EXCEPT !.purgeRejectedReturnBitfield11 = IF settled10.numberOfReturnBitfields >= 11 THEN (IF settled10.purgeRejectedReturnBitfield11 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled10.purgeRejectedReturnBitfield11) ELSE << >>]
        settled12 == [settled11 EXCEPT !.purgeRejectedReturnBitfield12 = IF settled11.numberOfReturnBitfields >= 12 THEN (IF settled11.purgeRejectedReturnBitfield12 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled11.purgeRejectedReturnBitfield12) ELSE << >>]
        settled13 == [settled12 EXCEPT !.purgeRejectedReturnBitfield13 = IF settled12.numberOfReturnBitfields >= 13 THEN (IF settled12.purgeRejectedReturnBitfield13 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled12.purgeRejectedReturnBitfield13) ELSE << >>]
        settled14 == [settled13 EXCEPT !.purgeRejectedReturnBitfield14 = IF settled13.numberOfReturnBitfields >= 14 THEN (IF settled13.purgeRejectedReturnBitfield14 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled13.purgeRejectedReturnBitfield14) ELSE << >>]
        settled15 == [settled14 EXCEPT !.purgeRejectedReturnBitfield15 = IF settled14.numberOfReturnBitfields >= 15 THEN (IF settled14.purgeRejectedReturnBitfield15 = << >> THEN <<0>> ELSE settled14.purgeRejectedReturnBitfield15) ELSE << >>]
        settled16 == [settled15 EXCEPT !.purgeRejectedReturnBitfield16 = IF settled15.numberOfReturnBitfields >= 16 THEN (IF settled15.purgeRejectedReturnBitfield16 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled15.purgeRejectedReturnBitfield16) ELSE << >>]
        settled17 == [settled16 EXCEPT !.purgeRejectedReturnBitfield17 = IF settled16.numberOfReturnBitfields >= 17 THEN (IF settled16.purgeRejectedReturnBitfield17 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled16.purgeRejectedReturnBitfield17) ELSE << >>]
        settled18 == [settled17 EXCEPT !.purgeRejectedReturnBitfield18 = IF settled17.numberOfReturnBitfields >= 18 THEN (IF settled17.purgeRejectedReturnBitfield18 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled17.purgeRejectedReturnBitfield18) ELSE << >>]
        settled19 == [settled18 EXCEPT !.purgeRejectedReturnBitfield19 = IF settled18.numberOfReturnBitfields >= 19 THEN (IF settled18.purgeRejectedReturnBitfield19 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled18.purgeRejectedReturnBitfield19) ELSE << >>]
        settled20 == [settled19 EXCEPT !.purgeRejectedReturnBitfield20 = IF settled19.numberOfReturnBitfields >= 20 THEN (IF settled19.purgeRejectedReturnBitfield20 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled19.purgeRejectedReturnBitfield20) ELSE << >>]
        settled21 == [settled20 EXCEPT !.purgeRejectedReturnBitfield21 = IF settled20.numberOfReturnBitfields >= 21 THEN (IF settled20.purgeRejectedReturnBitfield21 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled20.purgeRejectedReturnBitfield21) ELSE << >>]
        settled22 == [settled21 EXCEPT !.massCancelId = IF settled21.numberOfReturnBitfields >= 15 /\ (settled21.purgeRejectedReturnBitfield15 # << >> /\ (settled21.purgeRejectedReturnBitfield15[1] \div 8) % 2 > 0) THEN (IF settled21.massCancelId = << >> THEN <<[i \in 1 .. 20 |-> 0]>> ELSE settled21.massCancelId) ELSE << >>]
    IN  settled22

ZeroPurgeRejectedMessage ==
    SettlePurgeRejectedMessage([ transactionTime               |-> [i \in 1 .. 8 |-> 0],
                                 purgeRejectReason             |-> [i \in 1 .. 1 |-> 0],
                                 text                          |-> [i \in 1 .. 60 |-> 0],
                                 reserved1                     |-> [i \in 1 .. 1 |-> 0],
                                 numberOfReturnBitfields       |-> 0,
                                 purgeRejectedReturnBitfield1  |-> << >>,
                                 purgeRejectedReturnBitfield2  |-> << >>,
                                 purgeRejectedReturnBitfield3  |-> << >>,
                                 purgeRejectedReturnBitfield4  |-> << >>,
                                 purgeRejectedReturnBitfield5  |-> << >>,
                                 purgeRejectedReturnBitfield6  |-> << >>,
                                 purgeRejectedReturnBitfield7  |-> << >>,
                                 purgeRejectedReturnBitfield8  |-> << >>,
                                 purgeRejectedReturnBitfield9  |-> << >>,
                                 purgeRejectedReturnBitfield10 |-> << >>,
                                 purgeRejectedReturnBitfield11 |-> << >>,
                                 purgeRejectedReturnBitfield12 |-> << >>,
                                 purgeRejectedReturnBitfield13 |-> << >>,
                                 purgeRejectedReturnBitfield14 |-> << >>,
                                 purgeRejectedReturnBitfield15 |-> << >>,
                                 purgeRejectedReturnBitfield16 |-> << >>,
                                 purgeRejectedReturnBitfield17 |-> << >>,
                                 purgeRejectedReturnBitfield18 |-> << >>,
                                 purgeRejectedReturnBitfield19 |-> << >>,
                                 purgeRejectedReturnBitfield20 |-> << >>,
                                 purgeRejectedReturnBitfield21 |-> << >>,
                                 massCancelId                  |-> << >> ])

(* Purge Rejected Message at zero, then each field in turn at the values it is checked at *)
CheckedPurgeRejectedMessage ==
    { ZeroPurgeRejectedMessage }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.transactionTime = one]) : one \in Sample(8) }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.purgeRejectReason = one]) : one \in Sample(1) }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.text = one]) : one \in Sample(60) }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.reserved1 = one]) : one \in Sample(1) }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.numberOfReturnBitfields = one]) : one \in {0, 1, 255} }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.numberOfReturnBitfields = 1, !.purgeRejectedReturnBitfield1 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.numberOfReturnBitfields = 2, !.purgeRejectedReturnBitfield2 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.numberOfReturnBitfields = 3, !.purgeRejectedReturnBitfield3 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.numberOfReturnBitfields = 4, !.purgeRejectedReturnBitfield4 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.numberOfReturnBitfields = 5, !.purgeRejectedReturnBitfield5 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.numberOfReturnBitfields = 6, !.purgeRejectedReturnBitfield6 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.numberOfReturnBitfields = 7, !.purgeRejectedReturnBitfield7 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.numberOfReturnBitfields = 8, !.purgeRejectedReturnBitfield8 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.numberOfReturnBitfields = 9, !.purgeRejectedReturnBitfield9 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.numberOfReturnBitfields = 10, !.purgeRejectedReturnBitfield10 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.numberOfReturnBitfields = 11, !.purgeRejectedReturnBitfield11 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.numberOfReturnBitfields = 12, !.purgeRejectedReturnBitfield12 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.numberOfReturnBitfields = 13, !.purgeRejectedReturnBitfield13 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.numberOfReturnBitfields = 14, !.purgeRejectedReturnBitfield14 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.numberOfReturnBitfields = 15, !.purgeRejectedReturnBitfield15 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.numberOfReturnBitfields = 16, !.purgeRejectedReturnBitfield16 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.numberOfReturnBitfields = 17, !.purgeRejectedReturnBitfield17 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.numberOfReturnBitfields = 18, !.purgeRejectedReturnBitfield18 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.numberOfReturnBitfields = 19, !.purgeRejectedReturnBitfield19 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.numberOfReturnBitfields = 20, !.purgeRejectedReturnBitfield20 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.numberOfReturnBitfields = 21, !.purgeRejectedReturnBitfield21 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.numberOfReturnBitfields = 15, !.purgeRejectedReturnBitfield15 = <<8>>, !.massCancelId = one]) : one \in { <<held>> : held \in Sample(20) } }

(***************************************************************************)
(* Reset Risk Acknowledgment Message: 17 bytes                             *)
(***************************************************************************)

ResetRiskAcknowledgmentMessage ==
    [ riskStatusId    : Sample(16),
      riskResetResult : Sample(1) ]

EncodeResetRiskAcknowledgmentMessage(message) ==
    message.riskStatusId
        \o message.riskResetResult

DecodeResetRiskAcknowledgmentMessage(bytes) ==
    LET riskStatusId == ReadBytes(bytes, 16) IN IF ~riskStatusId.ok THEN Fail ELSE
    LET riskResetResult == ReadBytes(riskStatusId.rest, 1) IN IF ~riskResetResult.ok THEN Fail ELSE
    Ok([ riskStatusId    |-> riskStatusId.value,
         riskResetResult |-> riskResetResult.value ], riskResetResult.rest)

ZeroResetRiskAcknowledgmentMessage ==
    [ riskStatusId    |-> [i \in 1 .. 16 |-> 0],
      riskResetResult |-> [i \in 1 .. 1 |-> 0] ]

(* Reset Risk Acknowledgment Message at zero, then each field in turn at the values it is checked at *)
CheckedResetRiskAcknowledgmentMessage ==
    { ZeroResetRiskAcknowledgmentMessage }
        \cup { [ZeroResetRiskAcknowledgmentMessage EXCEPT !.riskStatusId = one] : one \in Sample(16) }
        \cup { [ZeroResetRiskAcknowledgmentMessage EXCEPT !.riskResetResult = one] : one \in Sample(1) }

(***************************************************************************)
(* Mass Cancel Acknowledgment Message: 34 bytes                            *)
(***************************************************************************)

MassCancelAcknowledgmentMessage ==
    [ transactionTime     : Sample(8),
      massCancelId        : Sample(20),
      cancelledOrderCount : Sample(4),
      reserved1           : Sample(1),
      sourceMatchingUnit  : Sample(1) ]

EncodeMassCancelAcknowledgmentMessage(message) ==
    message.transactionTime
        \o message.massCancelId
        \o message.cancelledOrderCount
        \o message.reserved1
        \o message.sourceMatchingUnit

DecodeMassCancelAcknowledgmentMessage(bytes) ==
    LET transactionTime == ReadBytes(bytes, 8) IN IF ~transactionTime.ok THEN Fail ELSE
    LET massCancelId == ReadBytes(transactionTime.rest, 20) IN IF ~massCancelId.ok THEN Fail ELSE
    LET cancelledOrderCount == ReadBytes(massCancelId.rest, 4) IN IF ~cancelledOrderCount.ok THEN Fail ELSE
    LET reserved1 == ReadBytes(cancelledOrderCount.rest, 1) IN IF ~reserved1.ok THEN Fail ELSE
    LET sourceMatchingUnit == ReadBytes(reserved1.rest, 1) IN IF ~sourceMatchingUnit.ok THEN Fail ELSE
    Ok([ transactionTime     |-> transactionTime.value,
         massCancelId        |-> massCancelId.value,
         cancelledOrderCount |-> cancelledOrderCount.value,
         reserved1           |-> reserved1.value,
         sourceMatchingUnit  |-> sourceMatchingUnit.value ], sourceMatchingUnit.rest)

ZeroMassCancelAcknowledgmentMessage ==
    [ transactionTime     |-> [i \in 1 .. 8 |-> 0],
      massCancelId        |-> [i \in 1 .. 20 |-> 0],
      cancelledOrderCount |-> [i \in 1 .. 4 |-> 0],
      reserved1           |-> [i \in 1 .. 1 |-> 0],
      sourceMatchingUnit  |-> [i \in 1 .. 1 |-> 0] ]

(* Mass Cancel Acknowledgment Message at zero, then each field in turn at the values it is checked at *)
CheckedMassCancelAcknowledgmentMessage ==
    { ZeroMassCancelAcknowledgmentMessage }
        \cup { [ZeroMassCancelAcknowledgmentMessage EXCEPT !.transactionTime = one] : one \in Sample(8) }
        \cup { [ZeroMassCancelAcknowledgmentMessage EXCEPT !.massCancelId = one] : one \in Sample(20) }
        \cup { [ZeroMassCancelAcknowledgmentMessage EXCEPT !.cancelledOrderCount = one] : one \in Sample(4) }
        \cup { [ZeroMassCancelAcknowledgmentMessage EXCEPT !.reserved1 = one] : one \in Sample(1) }
        \cup { [ZeroMassCancelAcknowledgmentMessage EXCEPT !.sourceMatchingUnit = one] : one \in Sample(1) }

(***************************************************************************)
(* Purge Notification Message                                              *)
(***************************************************************************)

PurgeNotificationMessage ==
    [ transactionTime                   : Sample(8),
      massCancelId                      : Sample(20),
      cancelledOrderCount               : Sample(4),
      sourceMatchingUnit                : Sample(1),
      clearingFirm                      : Sample(4),
      riskRoot                          : Sample(6),
      massCancelLockOut                 : Sample(1),
      reserved1                         : Sample(1),
      numberOfReturnBitf                : Sample(1),
      numberOfReturnBitfields           : 0 .. 255,
      purgeNotificationReturnBitfield1  : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeNotificationReturnBitfield2  : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeNotificationReturnBitfield3  : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeNotificationReturnBitfield4  : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeNotificationReturnBitfield5  : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeNotificationReturnBitfield6  : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeNotificationReturnBitfield7  : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeNotificationReturnBitfield8  : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeNotificationReturnBitfield9  : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeNotificationReturnBitfield10 : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeNotificationReturnBitfield11 : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeNotificationReturnBitfield12 : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeNotificationReturnBitfield13 : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeNotificationReturnBitfield14 : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeNotificationReturnBitfield15 : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeNotificationReturnBitfield16 : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeNotificationReturnBitfield17 : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeNotificationReturnBitfield18 : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeNotificationReturnBitfield19 : { << >> } \cup { <<held>> : held \in Sample(1) } ]

EncodePurgeNotificationMessage(message) ==
    message.transactionTime
        \o message.massCancelId
        \o message.cancelledOrderCount
        \o message.sourceMatchingUnit
        \o message.clearingFirm
        \o message.riskRoot
        \o message.massCancelLockOut
        \o message.reserved1
        \o message.numberOfReturnBitf
        \o EncodeUIntBE(message.numberOfReturnBitfields, 1)
        \o (IF message.purgeNotificationReturnBitfield1 = << >> THEN << >> ELSE message.purgeNotificationReturnBitfield1[1])
        \o (IF message.purgeNotificationReturnBitfield2 = << >> THEN << >> ELSE message.purgeNotificationReturnBitfield2[1])
        \o (IF message.purgeNotificationReturnBitfield3 = << >> THEN << >> ELSE message.purgeNotificationReturnBitfield3[1])
        \o (IF message.purgeNotificationReturnBitfield4 = << >> THEN << >> ELSE message.purgeNotificationReturnBitfield4[1])
        \o (IF message.purgeNotificationReturnBitfield5 = << >> THEN << >> ELSE message.purgeNotificationReturnBitfield5[1])
        \o (IF message.purgeNotificationReturnBitfield6 = << >> THEN << >> ELSE message.purgeNotificationReturnBitfield6[1])
        \o (IF message.purgeNotificationReturnBitfield7 = << >> THEN << >> ELSE message.purgeNotificationReturnBitfield7[1])
        \o (IF message.purgeNotificationReturnBitfield8 = << >> THEN << >> ELSE message.purgeNotificationReturnBitfield8[1])
        \o (IF message.purgeNotificationReturnBitfield9 = << >> THEN << >> ELSE message.purgeNotificationReturnBitfield9[1])
        \o (IF message.purgeNotificationReturnBitfield10 = << >> THEN << >> ELSE message.purgeNotificationReturnBitfield10[1])
        \o (IF message.purgeNotificationReturnBitfield11 = << >> THEN << >> ELSE message.purgeNotificationReturnBitfield11[1])
        \o (IF message.purgeNotificationReturnBitfield12 = << >> THEN << >> ELSE message.purgeNotificationReturnBitfield12[1])
        \o (IF message.purgeNotificationReturnBitfield13 = << >> THEN << >> ELSE message.purgeNotificationReturnBitfield13[1])
        \o (IF message.purgeNotificationReturnBitfield14 = << >> THEN << >> ELSE message.purgeNotificationReturnBitfield14[1])
        \o (IF message.purgeNotificationReturnBitfield15 = << >> THEN << >> ELSE message.purgeNotificationReturnBitfield15[1])
        \o (IF message.purgeNotificationReturnBitfield16 = << >> THEN << >> ELSE message.purgeNotificationReturnBitfield16[1])
        \o (IF message.purgeNotificationReturnBitfield17 = << >> THEN << >> ELSE message.purgeNotificationReturnBitfield17[1])
        \o (IF message.purgeNotificationReturnBitfield18 = << >> THEN << >> ELSE message.purgeNotificationReturnBitfield18[1])
        \o (IF message.purgeNotificationReturnBitfield19 = << >> THEN << >> ELSE message.purgeNotificationReturnBitfield19[1])

DecodePurgeNotificationMessage(bytes) ==
    LET transactionTime == ReadBytes(bytes, 8) IN IF ~transactionTime.ok THEN Fail ELSE
    LET massCancelId == ReadBytes(transactionTime.rest, 20) IN IF ~massCancelId.ok THEN Fail ELSE
    LET cancelledOrderCount == ReadBytes(massCancelId.rest, 4) IN IF ~cancelledOrderCount.ok THEN Fail ELSE
    LET sourceMatchingUnit == ReadBytes(cancelledOrderCount.rest, 1) IN IF ~sourceMatchingUnit.ok THEN Fail ELSE
    LET clearingFirm == ReadBytes(sourceMatchingUnit.rest, 4) IN IF ~clearingFirm.ok THEN Fail ELSE
    LET riskRoot == ReadBytes(clearingFirm.rest, 6) IN IF ~riskRoot.ok THEN Fail ELSE
    LET massCancelLockOut == ReadBytes(riskRoot.rest, 1) IN IF ~massCancelLockOut.ok THEN Fail ELSE
    LET reserved1 == ReadBytes(massCancelLockOut.rest, 1) IN IF ~reserved1.ok THEN Fail ELSE
    LET numberOfReturnBitf == ReadBytes(reserved1.rest, 1) IN IF ~numberOfReturnBitf.ok THEN Fail ELSE
    LET numberOfReturnBitfields == ReadUIntBE(numberOfReturnBitf.rest, 1) IN IF ~numberOfReturnBitfields.ok THEN Fail ELSE
    LET purgeNotificationReturnBitfield1 == ReadWhen(numberOfReturnBitfields.value >= 1, ReadBytes(numberOfReturnBitfields.rest, 1), numberOfReturnBitfields.rest) IN IF ~purgeNotificationReturnBitfield1.ok THEN Fail ELSE
    LET purgeNotificationReturnBitfield2 == ReadWhen(numberOfReturnBitfields.value >= 2, ReadBytes(purgeNotificationReturnBitfield1.rest, 1), purgeNotificationReturnBitfield1.rest) IN IF ~purgeNotificationReturnBitfield2.ok THEN Fail ELSE
    LET purgeNotificationReturnBitfield3 == ReadWhen(numberOfReturnBitfields.value >= 3, ReadBytes(purgeNotificationReturnBitfield2.rest, 1), purgeNotificationReturnBitfield2.rest) IN IF ~purgeNotificationReturnBitfield3.ok THEN Fail ELSE
    LET purgeNotificationReturnBitfield4 == ReadWhen(numberOfReturnBitfields.value >= 4, ReadBytes(purgeNotificationReturnBitfield3.rest, 1), purgeNotificationReturnBitfield3.rest) IN IF ~purgeNotificationReturnBitfield4.ok THEN Fail ELSE
    LET purgeNotificationReturnBitfield5 == ReadWhen(numberOfReturnBitfields.value >= 5, ReadBytes(purgeNotificationReturnBitfield4.rest, 1), purgeNotificationReturnBitfield4.rest) IN IF ~purgeNotificationReturnBitfield5.ok THEN Fail ELSE
    LET purgeNotificationReturnBitfield6 == ReadWhen(numberOfReturnBitfields.value >= 6, ReadBytes(purgeNotificationReturnBitfield5.rest, 1), purgeNotificationReturnBitfield5.rest) IN IF ~purgeNotificationReturnBitfield6.ok THEN Fail ELSE
    LET purgeNotificationReturnBitfield7 == ReadWhen(numberOfReturnBitfields.value >= 7, ReadBytes(purgeNotificationReturnBitfield6.rest, 1), purgeNotificationReturnBitfield6.rest) IN IF ~purgeNotificationReturnBitfield7.ok THEN Fail ELSE
    LET purgeNotificationReturnBitfield8 == ReadWhen(numberOfReturnBitfields.value >= 8, ReadBytes(purgeNotificationReturnBitfield7.rest, 1), purgeNotificationReturnBitfield7.rest) IN IF ~purgeNotificationReturnBitfield8.ok THEN Fail ELSE
    LET purgeNotificationReturnBitfield9 == ReadWhen(numberOfReturnBitfields.value >= 9, ReadBytes(purgeNotificationReturnBitfield8.rest, 1), purgeNotificationReturnBitfield8.rest) IN IF ~purgeNotificationReturnBitfield9.ok THEN Fail ELSE
    LET purgeNotificationReturnBitfield10 == ReadWhen(numberOfReturnBitfields.value >= 10, ReadBytes(purgeNotificationReturnBitfield9.rest, 1), purgeNotificationReturnBitfield9.rest) IN IF ~purgeNotificationReturnBitfield10.ok THEN Fail ELSE
    LET purgeNotificationReturnBitfield11 == ReadWhen(numberOfReturnBitfields.value >= 11, ReadBytes(purgeNotificationReturnBitfield10.rest, 1), purgeNotificationReturnBitfield10.rest) IN IF ~purgeNotificationReturnBitfield11.ok THEN Fail ELSE
    LET purgeNotificationReturnBitfield12 == ReadWhen(numberOfReturnBitfields.value >= 12, ReadBytes(purgeNotificationReturnBitfield11.rest, 1), purgeNotificationReturnBitfield11.rest) IN IF ~purgeNotificationReturnBitfield12.ok THEN Fail ELSE
    LET purgeNotificationReturnBitfield13 == ReadWhen(numberOfReturnBitfields.value >= 13, ReadBytes(purgeNotificationReturnBitfield12.rest, 1), purgeNotificationReturnBitfield12.rest) IN IF ~purgeNotificationReturnBitfield13.ok THEN Fail ELSE
    LET purgeNotificationReturnBitfield14 == ReadWhen(numberOfReturnBitfields.value >= 14, ReadBytes(purgeNotificationReturnBitfield13.rest, 1), purgeNotificationReturnBitfield13.rest) IN IF ~purgeNotificationReturnBitfield14.ok THEN Fail ELSE
    LET purgeNotificationReturnBitfield15 == ReadWhen(numberOfReturnBitfields.value >= 15, ReadBytes(purgeNotificationReturnBitfield14.rest, 1), purgeNotificationReturnBitfield14.rest) IN IF ~purgeNotificationReturnBitfield15.ok THEN Fail ELSE
    LET purgeNotificationReturnBitfield16 == ReadWhen(numberOfReturnBitfields.value >= 16, ReadBytes(purgeNotificationReturnBitfield15.rest, 1), purgeNotificationReturnBitfield15.rest) IN IF ~purgeNotificationReturnBitfield16.ok THEN Fail ELSE
    LET purgeNotificationReturnBitfield17 == ReadWhen(numberOfReturnBitfields.value >= 17, ReadBytes(purgeNotificationReturnBitfield16.rest, 1), purgeNotificationReturnBitfield16.rest) IN IF ~purgeNotificationReturnBitfield17.ok THEN Fail ELSE
    LET purgeNotificationReturnBitfield18 == ReadWhen(numberOfReturnBitfields.value >= 18, ReadBytes(purgeNotificationReturnBitfield17.rest, 1), purgeNotificationReturnBitfield17.rest) IN IF ~purgeNotificationReturnBitfield18.ok THEN Fail ELSE
    LET purgeNotificationReturnBitfield19 == ReadWhen(numberOfReturnBitfields.value >= 19, ReadBytes(purgeNotificationReturnBitfield18.rest, 1), purgeNotificationReturnBitfield18.rest) IN IF ~purgeNotificationReturnBitfield19.ok THEN Fail ELSE
    Ok([ transactionTime                   |-> transactionTime.value,
         massCancelId                      |-> massCancelId.value,
         cancelledOrderCount               |-> cancelledOrderCount.value,
         sourceMatchingUnit                |-> sourceMatchingUnit.value,
         clearingFirm                      |-> clearingFirm.value,
         riskRoot                          |-> riskRoot.value,
         massCancelLockOut                 |-> massCancelLockOut.value,
         reserved1                         |-> reserved1.value,
         numberOfReturnBitf                |-> numberOfReturnBitf.value,
         numberOfReturnBitfields           |-> numberOfReturnBitfields.value,
         purgeNotificationReturnBitfield1  |-> purgeNotificationReturnBitfield1.value,
         purgeNotificationReturnBitfield2  |-> purgeNotificationReturnBitfield2.value,
         purgeNotificationReturnBitfield3  |-> purgeNotificationReturnBitfield3.value,
         purgeNotificationReturnBitfield4  |-> purgeNotificationReturnBitfield4.value,
         purgeNotificationReturnBitfield5  |-> purgeNotificationReturnBitfield5.value,
         purgeNotificationReturnBitfield6  |-> purgeNotificationReturnBitfield6.value,
         purgeNotificationReturnBitfield7  |-> purgeNotificationReturnBitfield7.value,
         purgeNotificationReturnBitfield8  |-> purgeNotificationReturnBitfield8.value,
         purgeNotificationReturnBitfield9  |-> purgeNotificationReturnBitfield9.value,
         purgeNotificationReturnBitfield10 |-> purgeNotificationReturnBitfield10.value,
         purgeNotificationReturnBitfield11 |-> purgeNotificationReturnBitfield11.value,
         purgeNotificationReturnBitfield12 |-> purgeNotificationReturnBitfield12.value,
         purgeNotificationReturnBitfield13 |-> purgeNotificationReturnBitfield13.value,
         purgeNotificationReturnBitfield14 |-> purgeNotificationReturnBitfield14.value,
         purgeNotificationReturnBitfield15 |-> purgeNotificationReturnBitfield15.value,
         purgeNotificationReturnBitfield16 |-> purgeNotificationReturnBitfield16.value,
         purgeNotificationReturnBitfield17 |-> purgeNotificationReturnBitfield17.value,
         purgeNotificationReturnBitfield18 |-> purgeNotificationReturnBitfield18.value,
         purgeNotificationReturnBitfield19 |-> purgeNotificationReturnBitfield19.value ], purgeNotificationReturnBitfield19.rest)

(* Purge Notification Message with each field marked present by fields before it there exactly where they say *)
SettlePurgeNotificationMessage(message) ==
    LET settled1 == [message EXCEPT !.purgeNotificationReturnBitfield1 = IF message.numberOfReturnBitfields >= 1 THEN (IF message.purgeNotificationReturnBitfield1 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE message.purgeNotificationReturnBitfield1) ELSE << >>]
        settled2 == [settled1 EXCEPT !.purgeNotificationReturnBitfield2 = IF settled1.numberOfReturnBitfields >= 2 THEN (IF settled1.purgeNotificationReturnBitfield2 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled1.purgeNotificationReturnBitfield2) ELSE << >>]
        settled3 == [settled2 EXCEPT !.purgeNotificationReturnBitfield3 = IF settled2.numberOfReturnBitfields >= 3 THEN (IF settled2.purgeNotificationReturnBitfield3 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled2.purgeNotificationReturnBitfield3) ELSE << >>]
        settled4 == [settled3 EXCEPT !.purgeNotificationReturnBitfield4 = IF settled3.numberOfReturnBitfields >= 4 THEN (IF settled3.purgeNotificationReturnBitfield4 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled3.purgeNotificationReturnBitfield4) ELSE << >>]
        settled5 == [settled4 EXCEPT !.purgeNotificationReturnBitfield5 = IF settled4.numberOfReturnBitfields >= 5 THEN (IF settled4.purgeNotificationReturnBitfield5 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled4.purgeNotificationReturnBitfield5) ELSE << >>]
        settled6 == [settled5 EXCEPT !.purgeNotificationReturnBitfield6 = IF settled5.numberOfReturnBitfields >= 6 THEN (IF settled5.purgeNotificationReturnBitfield6 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled5.purgeNotificationReturnBitfield6) ELSE << >>]
        settled7 == [settled6 EXCEPT !.purgeNotificationReturnBitfield7 = IF settled6.numberOfReturnBitfields >= 7 THEN (IF settled6.purgeNotificationReturnBitfield7 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled6.purgeNotificationReturnBitfield7) ELSE << >>]
        settled8 == [settled7 EXCEPT !.purgeNotificationReturnBitfield8 = IF settled7.numberOfReturnBitfields >= 8 THEN (IF settled7.purgeNotificationReturnBitfield8 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled7.purgeNotificationReturnBitfield8) ELSE << >>]
        settled9 == [settled8 EXCEPT !.purgeNotificationReturnBitfield9 = IF settled8.numberOfReturnBitfields >= 9 THEN (IF settled8.purgeNotificationReturnBitfield9 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled8.purgeNotificationReturnBitfield9) ELSE << >>]
        settled10 == [settled9 EXCEPT !.purgeNotificationReturnBitfield10 = IF settled9.numberOfReturnBitfields >= 10 THEN (IF settled9.purgeNotificationReturnBitfield10 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled9.purgeNotificationReturnBitfield10) ELSE << >>]
        settled11 == [settled10 EXCEPT !.purgeNotificationReturnBitfield11 = IF settled10.numberOfReturnBitfields >= 11 THEN (IF settled10.purgeNotificationReturnBitfield11 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled10.purgeNotificationReturnBitfield11) ELSE << >>]
        settled12 == [settled11 EXCEPT !.purgeNotificationReturnBitfield12 = IF settled11.numberOfReturnBitfields >= 12 THEN (IF settled11.purgeNotificationReturnBitfield12 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled11.purgeNotificationReturnBitfield12) ELSE << >>]
        settled13 == [settled12 EXCEPT !.purgeNotificationReturnBitfield13 = IF settled12.numberOfReturnBitfields >= 13 THEN (IF settled12.purgeNotificationReturnBitfield13 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled12.purgeNotificationReturnBitfield13) ELSE << >>]
        settled14 == [settled13 EXCEPT !.purgeNotificationReturnBitfield14 = IF settled13.numberOfReturnBitfields >= 14 THEN (IF settled13.purgeNotificationReturnBitfield14 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled13.purgeNotificationReturnBitfield14) ELSE << >>]
        settled15 == [settled14 EXCEPT !.purgeNotificationReturnBitfield15 = IF settled14.numberOfReturnBitfields >= 15 THEN (IF settled14.purgeNotificationReturnBitfield15 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled14.purgeNotificationReturnBitfield15) ELSE << >>]
        settled16 == [settled15 EXCEPT !.purgeNotificationReturnBitfield16 = IF settled15.numberOfReturnBitfields >= 16 THEN (IF settled15.purgeNotificationReturnBitfield16 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled15.purgeNotificationReturnBitfield16) ELSE << >>]
        settled17 == [settled16 EXCEPT !.purgeNotificationReturnBitfield17 = IF settled16.numberOfReturnBitfields >= 17 THEN (IF settled16.purgeNotificationReturnBitfield17 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled16.purgeNotificationReturnBitfield17) ELSE << >>]
        settled18 == [settled17 EXCEPT !.purgeNotificationReturnBitfield18 = IF settled17.numberOfReturnBitfields >= 18 THEN (IF settled17.purgeNotificationReturnBitfield18 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled17.purgeNotificationReturnBitfield18) ELSE << >>]
        settled19 == [settled18 EXCEPT !.purgeNotificationReturnBitfield19 = IF settled18.numberOfReturnBitfields >= 19 THEN (IF settled18.purgeNotificationReturnBitfield19 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled18.purgeNotificationReturnBitfield19) ELSE << >>]
    IN  settled19

ZeroPurgeNotificationMessage ==
    SettlePurgeNotificationMessage([ transactionTime                   |-> [i \in 1 .. 8 |-> 0],
                                     massCancelId                      |-> [i \in 1 .. 20 |-> 0],
                                     cancelledOrderCount               |-> [i \in 1 .. 4 |-> 0],
                                     sourceMatchingUnit                |-> [i \in 1 .. 1 |-> 0],
                                     clearingFirm                      |-> [i \in 1 .. 4 |-> 0],
                                     riskRoot                          |-> [i \in 1 .. 6 |-> 0],
                                     massCancelLockOut                 |-> [i \in 1 .. 1 |-> 0],
                                     reserved1                         |-> [i \in 1 .. 1 |-> 0],
                                     numberOfReturnBitf                |-> [i \in 1 .. 1 |-> 0],
                                     numberOfReturnBitfields           |-> 0,
                                     purgeNotificationReturnBitfield1  |-> << >>,
                                     purgeNotificationReturnBitfield2  |-> << >>,
                                     purgeNotificationReturnBitfield3  |-> << >>,
                                     purgeNotificationReturnBitfield4  |-> << >>,
                                     purgeNotificationReturnBitfield5  |-> << >>,
                                     purgeNotificationReturnBitfield6  |-> << >>,
                                     purgeNotificationReturnBitfield7  |-> << >>,
                                     purgeNotificationReturnBitfield8  |-> << >>,
                                     purgeNotificationReturnBitfield9  |-> << >>,
                                     purgeNotificationReturnBitfield10 |-> << >>,
                                     purgeNotificationReturnBitfield11 |-> << >>,
                                     purgeNotificationReturnBitfield12 |-> << >>,
                                     purgeNotificationReturnBitfield13 |-> << >>,
                                     purgeNotificationReturnBitfield14 |-> << >>,
                                     purgeNotificationReturnBitfield15 |-> << >>,
                                     purgeNotificationReturnBitfield16 |-> << >>,
                                     purgeNotificationReturnBitfield17 |-> << >>,
                                     purgeNotificationReturnBitfield18 |-> << >>,
                                     purgeNotificationReturnBitfield19 |-> << >> ])

(* Purge Notification Message at zero, then each field in turn at the values it is checked at *)
CheckedPurgeNotificationMessage ==
    { ZeroPurgeNotificationMessage }
        \cup { SettlePurgeNotificationMessage([ZeroPurgeNotificationMessage EXCEPT !.transactionTime = one]) : one \in Sample(8) }
        \cup { SettlePurgeNotificationMessage([ZeroPurgeNotificationMessage EXCEPT !.massCancelId = one]) : one \in Sample(20) }
        \cup { SettlePurgeNotificationMessage([ZeroPurgeNotificationMessage EXCEPT !.cancelledOrderCount = one]) : one \in Sample(4) }
        \cup { SettlePurgeNotificationMessage([ZeroPurgeNotificationMessage EXCEPT !.sourceMatchingUnit = one]) : one \in Sample(1) }
        \cup { SettlePurgeNotificationMessage([ZeroPurgeNotificationMessage EXCEPT !.clearingFirm = one]) : one \in Sample(4) }
        \cup { SettlePurgeNotificationMessage([ZeroPurgeNotificationMessage EXCEPT !.riskRoot = one]) : one \in Sample(6) }
        \cup { SettlePurgeNotificationMessage([ZeroPurgeNotificationMessage EXCEPT !.massCancelLockOut = one]) : one \in Sample(1) }
        \cup { SettlePurgeNotificationMessage([ZeroPurgeNotificationMessage EXCEPT !.reserved1 = one]) : one \in Sample(1) }
        \cup { SettlePurgeNotificationMessage([ZeroPurgeNotificationMessage EXCEPT !.numberOfReturnBitf = one]) : one \in Sample(1) }
        \cup { SettlePurgeNotificationMessage([ZeroPurgeNotificationMessage EXCEPT !.numberOfReturnBitfields = one]) : one \in {0, 1, 255} }
        \cup { SettlePurgeNotificationMessage([ZeroPurgeNotificationMessage EXCEPT !.numberOfReturnBitfields = 1, !.purgeNotificationReturnBitfield1 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeNotificationMessage([ZeroPurgeNotificationMessage EXCEPT !.numberOfReturnBitfields = 2, !.purgeNotificationReturnBitfield2 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeNotificationMessage([ZeroPurgeNotificationMessage EXCEPT !.numberOfReturnBitfields = 3, !.purgeNotificationReturnBitfield3 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeNotificationMessage([ZeroPurgeNotificationMessage EXCEPT !.numberOfReturnBitfields = 4, !.purgeNotificationReturnBitfield4 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeNotificationMessage([ZeroPurgeNotificationMessage EXCEPT !.numberOfReturnBitfields = 5, !.purgeNotificationReturnBitfield5 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeNotificationMessage([ZeroPurgeNotificationMessage EXCEPT !.numberOfReturnBitfields = 6, !.purgeNotificationReturnBitfield6 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeNotificationMessage([ZeroPurgeNotificationMessage EXCEPT !.numberOfReturnBitfields = 7, !.purgeNotificationReturnBitfield7 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeNotificationMessage([ZeroPurgeNotificationMessage EXCEPT !.numberOfReturnBitfields = 8, !.purgeNotificationReturnBitfield8 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeNotificationMessage([ZeroPurgeNotificationMessage EXCEPT !.numberOfReturnBitfields = 9, !.purgeNotificationReturnBitfield9 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeNotificationMessage([ZeroPurgeNotificationMessage EXCEPT !.numberOfReturnBitfields = 10, !.purgeNotificationReturnBitfield10 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeNotificationMessage([ZeroPurgeNotificationMessage EXCEPT !.numberOfReturnBitfields = 11, !.purgeNotificationReturnBitfield11 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeNotificationMessage([ZeroPurgeNotificationMessage EXCEPT !.numberOfReturnBitfields = 12, !.purgeNotificationReturnBitfield12 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeNotificationMessage([ZeroPurgeNotificationMessage EXCEPT !.numberOfReturnBitfields = 13, !.purgeNotificationReturnBitfield13 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeNotificationMessage([ZeroPurgeNotificationMessage EXCEPT !.numberOfReturnBitfields = 14, !.purgeNotificationReturnBitfield14 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeNotificationMessage([ZeroPurgeNotificationMessage EXCEPT !.numberOfReturnBitfields = 15, !.purgeNotificationReturnBitfield15 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeNotificationMessage([ZeroPurgeNotificationMessage EXCEPT !.numberOfReturnBitfields = 16, !.purgeNotificationReturnBitfield16 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeNotificationMessage([ZeroPurgeNotificationMessage EXCEPT !.numberOfReturnBitfields = 17, !.purgeNotificationReturnBitfield17 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeNotificationMessage([ZeroPurgeNotificationMessage EXCEPT !.numberOfReturnBitfields = 18, !.purgeNotificationReturnBitfield18 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeNotificationMessage([ZeroPurgeNotificationMessage EXCEPT !.numberOfReturnBitfields = 19, !.purgeNotificationReturnBitfield19 = one]) : one \in { <<held>> : held \in Sample(1) } }

(***************************************************************************)
(* Complex Leg: 31 bytes                                                   *)
(***************************************************************************)

ComplexLeg2 ==
    [ legSymbol       : Sample(8),
      legCfiCode      : Sample(6),
      legMaturityDate : Sample(4),
      legStrikePrice  : Sample(8),
      legRatioQty     : Sample(4),
      legSide         : Sample(1) ]

EncodeComplexLeg2(message) ==
    message.legSymbol
        \o message.legCfiCode
        \o message.legMaturityDate
        \o message.legStrikePrice
        \o message.legRatioQty
        \o message.legSide

DecodeComplexLeg2(bytes) ==
    LET legSymbol == ReadBytes(bytes, 8) IN IF ~legSymbol.ok THEN Fail ELSE
    LET legCfiCode == ReadBytes(legSymbol.rest, 6) IN IF ~legCfiCode.ok THEN Fail ELSE
    LET legMaturityDate == ReadBytes(legCfiCode.rest, 4) IN IF ~legMaturityDate.ok THEN Fail ELSE
    LET legStrikePrice == ReadBytes(legMaturityDate.rest, 8) IN IF ~legStrikePrice.ok THEN Fail ELSE
    LET legRatioQty == ReadBytes(legStrikePrice.rest, 4) IN IF ~legRatioQty.ok THEN Fail ELSE
    LET legSide == ReadBytes(legRatioQty.rest, 1) IN IF ~legSide.ok THEN Fail ELSE
    Ok([ legSymbol       |-> legSymbol.value,
         legCfiCode      |-> legCfiCode.value,
         legMaturityDate |-> legMaturityDate.value,
         legStrikePrice  |-> legStrikePrice.value,
         legRatioQty     |-> legRatioQty.value,
         legSide         |-> legSide.value ], legSide.rest)

ZeroComplexLeg2 ==
    [ legSymbol       |-> [i \in 1 .. 8 |-> 0],
      legCfiCode      |-> [i \in 1 .. 6 |-> 0],
      legMaturityDate |-> [i \in 1 .. 4 |-> 0],
      legStrikePrice  |-> [i \in 1 .. 8 |-> 0],
      legRatioQty     |-> [i \in 1 .. 4 |-> 0],
      legSide         |-> [i \in 1 .. 1 |-> 0] ]

(* Complex Leg at zero, then each field in turn at the values it is checked at *)
CheckedComplexLeg2 ==
    { ZeroComplexLeg2 }
        \cup { [ZeroComplexLeg2 EXCEPT !.legSymbol = one] : one \in Sample(8) }
        \cup { [ZeroComplexLeg2 EXCEPT !.legCfiCode = one] : one \in Sample(6) }
        \cup { [ZeroComplexLeg2 EXCEPT !.legMaturityDate = one] : one \in Sample(4) }
        \cup { [ZeroComplexLeg2 EXCEPT !.legStrikePrice = one] : one \in Sample(8) }
        \cup { [ZeroComplexLeg2 EXCEPT !.legRatioQty = one] : one \in Sample(4) }
        \cup { [ZeroComplexLeg2 EXCEPT !.legSide = one] : one \in Sample(1) }

(* A run of Complex Leg, written one after another *)
RECURSIVE EncodeComplexLeg2List(_)
EncodeComplexLeg2List(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeComplexLeg2(Head(messages)) \o EncodeComplexLeg2List(Tail(messages))

(* As many Complex Leg as the field that counts them says *)
RECURSIVE ReadComplexLeg2List(_, _)
ReadComplexLeg2List(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeComplexLeg2(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadComplexLeg2List(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Complex Leg of each kind, for the lists that carry them *)
OneComplexLeg2 == { ZeroComplexLeg2 }

(***************************************************************************)
(* Complex Instrument Accepted Message                                     *)
(***************************************************************************)

ComplexInstrumentAcceptedMessage ==
    [ transactionTime                           : Sample(8),
      clOrdId                                   : Sample(20),
      symbolLong                                : Sample(8),
      revisedLegs                               : Sample(1),
      noOfSecurities                            : Sample(4),
      reserved1                                 : Sample(1),
      numberOfReturnBitf                        : Sample(1),
      numberOfReturnBitfields                   : 0 .. 255,
      complexInstrumentAcceptedReturnBitfield1  : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentAcceptedReturnBitfield2  : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentAcceptedReturnBitfield3  : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentAcceptedReturnBitfield4  : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentAcceptedReturnBitfield5  : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentAcceptedReturnBitfield6  : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentAcceptedReturnBitfield7  : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentAcceptedReturnBitfield8  : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentAcceptedReturnBitfield9  : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentAcceptedReturnBitfield10 : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentAcceptedReturnBitfield11 : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentAcceptedReturnBitfield12 : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentAcceptedReturnBitfield13 : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentAcceptedReturnBitfield14 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      complexInstrumentAcceptedReturnBitfield15 : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentAcceptedReturnBitfield16 : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentAcceptedReturnBitfield17 : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentAcceptedReturnBitfield18 : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentAcceptedReturnBitfield19 : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentAcceptedReturnBitfield20 : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentAcceptedReturnBitfield21 : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexLeg                                : SampleLists(OneComplexLeg2),
      legCfiCode                                : { << >> } \cup { <<held>> : held \in Sample(6) },
      legMaturityDate                           : { << >> } \cup { <<held>> : held \in Sample(4) },
      legStrikePrice                            : { << >> } \cup { <<held>> : held \in Sample(8) } ]

EncodeComplexInstrumentAcceptedMessage(message) ==
    message.transactionTime
        \o message.clOrdId
        \o message.symbolLong
        \o message.revisedLegs
        \o message.noOfSecurities
        \o message.reserved1
        \o message.numberOfReturnBitf
        \o EncodeUIntBE(message.numberOfReturnBitfields, 1)
        \o (IF message.complexInstrumentAcceptedReturnBitfield1 = << >> THEN << >> ELSE message.complexInstrumentAcceptedReturnBitfield1[1])
        \o (IF message.complexInstrumentAcceptedReturnBitfield2 = << >> THEN << >> ELSE message.complexInstrumentAcceptedReturnBitfield2[1])
        \o (IF message.complexInstrumentAcceptedReturnBitfield3 = << >> THEN << >> ELSE message.complexInstrumentAcceptedReturnBitfield3[1])
        \o (IF message.complexInstrumentAcceptedReturnBitfield4 = << >> THEN << >> ELSE message.complexInstrumentAcceptedReturnBitfield4[1])
        \o (IF message.complexInstrumentAcceptedReturnBitfield5 = << >> THEN << >> ELSE message.complexInstrumentAcceptedReturnBitfield5[1])
        \o (IF message.complexInstrumentAcceptedReturnBitfield6 = << >> THEN << >> ELSE message.complexInstrumentAcceptedReturnBitfield6[1])
        \o (IF message.complexInstrumentAcceptedReturnBitfield7 = << >> THEN << >> ELSE message.complexInstrumentAcceptedReturnBitfield7[1])
        \o (IF message.complexInstrumentAcceptedReturnBitfield8 = << >> THEN << >> ELSE message.complexInstrumentAcceptedReturnBitfield8[1])
        \o (IF message.complexInstrumentAcceptedReturnBitfield9 = << >> THEN << >> ELSE message.complexInstrumentAcceptedReturnBitfield9[1])
        \o (IF message.complexInstrumentAcceptedReturnBitfield10 = << >> THEN << >> ELSE message.complexInstrumentAcceptedReturnBitfield10[1])
        \o (IF message.complexInstrumentAcceptedReturnBitfield11 = << >> THEN << >> ELSE message.complexInstrumentAcceptedReturnBitfield11[1])
        \o (IF message.complexInstrumentAcceptedReturnBitfield12 = << >> THEN << >> ELSE message.complexInstrumentAcceptedReturnBitfield12[1])
        \o (IF message.complexInstrumentAcceptedReturnBitfield13 = << >> THEN << >> ELSE message.complexInstrumentAcceptedReturnBitfield13[1])
        \o (IF message.complexInstrumentAcceptedReturnBitfield14 = << >> THEN << >> ELSE EncodeUIntLE(message.complexInstrumentAcceptedReturnBitfield14[1], 1))
        \o (IF message.complexInstrumentAcceptedReturnBitfield15 = << >> THEN << >> ELSE message.complexInstrumentAcceptedReturnBitfield15[1])
        \o (IF message.complexInstrumentAcceptedReturnBitfield16 = << >> THEN << >> ELSE message.complexInstrumentAcceptedReturnBitfield16[1])
        \o (IF message.complexInstrumentAcceptedReturnBitfield17 = << >> THEN << >> ELSE message.complexInstrumentAcceptedReturnBitfield17[1])
        \o (IF message.complexInstrumentAcceptedReturnBitfield18 = << >> THEN << >> ELSE message.complexInstrumentAcceptedReturnBitfield18[1])
        \o (IF message.complexInstrumentAcceptedReturnBitfield19 = << >> THEN << >> ELSE message.complexInstrumentAcceptedReturnBitfield19[1])
        \o (IF message.complexInstrumentAcceptedReturnBitfield20 = << >> THEN << >> ELSE message.complexInstrumentAcceptedReturnBitfield20[1])
        \o (IF message.complexInstrumentAcceptedReturnBitfield21 = << >> THEN << >> ELSE message.complexInstrumentAcceptedReturnBitfield21[1])
        \o EncodeUIntBE(Len(message.complexLeg), 1)
        \o EncodeComplexLeg2List(message.complexLeg)
        \o (IF message.legCfiCode = << >> THEN << >> ELSE message.legCfiCode[1])
        \o (IF message.legMaturityDate = << >> THEN << >> ELSE message.legMaturityDate[1])
        \o (IF message.legStrikePrice = << >> THEN << >> ELSE message.legStrikePrice[1])

DecodeComplexInstrumentAcceptedMessage(bytes) ==
    LET transactionTime == ReadBytes(bytes, 8) IN IF ~transactionTime.ok THEN Fail ELSE
    LET clOrdId == ReadBytes(transactionTime.rest, 20) IN IF ~clOrdId.ok THEN Fail ELSE
    LET symbolLong == ReadBytes(clOrdId.rest, 8) IN IF ~symbolLong.ok THEN Fail ELSE
    LET revisedLegs == ReadBytes(symbolLong.rest, 1) IN IF ~revisedLegs.ok THEN Fail ELSE
    LET noOfSecurities == ReadBytes(revisedLegs.rest, 4) IN IF ~noOfSecurities.ok THEN Fail ELSE
    LET reserved1 == ReadBytes(noOfSecurities.rest, 1) IN IF ~reserved1.ok THEN Fail ELSE
    LET numberOfReturnBitf == ReadBytes(reserved1.rest, 1) IN IF ~numberOfReturnBitf.ok THEN Fail ELSE
    LET numberOfReturnBitfields == ReadUIntBE(numberOfReturnBitf.rest, 1) IN IF ~numberOfReturnBitfields.ok THEN Fail ELSE
    LET complexInstrumentAcceptedReturnBitfield1 == ReadWhen(numberOfReturnBitfields.value >= 1, ReadBytes(numberOfReturnBitfields.rest, 1), numberOfReturnBitfields.rest) IN IF ~complexInstrumentAcceptedReturnBitfield1.ok THEN Fail ELSE
    LET complexInstrumentAcceptedReturnBitfield2 == ReadWhen(numberOfReturnBitfields.value >= 2, ReadBytes(complexInstrumentAcceptedReturnBitfield1.rest, 1), complexInstrumentAcceptedReturnBitfield1.rest) IN IF ~complexInstrumentAcceptedReturnBitfield2.ok THEN Fail ELSE
    LET complexInstrumentAcceptedReturnBitfield3 == ReadWhen(numberOfReturnBitfields.value >= 3, ReadBytes(complexInstrumentAcceptedReturnBitfield2.rest, 1), complexInstrumentAcceptedReturnBitfield2.rest) IN IF ~complexInstrumentAcceptedReturnBitfield3.ok THEN Fail ELSE
    LET complexInstrumentAcceptedReturnBitfield4 == ReadWhen(numberOfReturnBitfields.value >= 4, ReadBytes(complexInstrumentAcceptedReturnBitfield3.rest, 1), complexInstrumentAcceptedReturnBitfield3.rest) IN IF ~complexInstrumentAcceptedReturnBitfield4.ok THEN Fail ELSE
    LET complexInstrumentAcceptedReturnBitfield5 == ReadWhen(numberOfReturnBitfields.value >= 5, ReadBytes(complexInstrumentAcceptedReturnBitfield4.rest, 1), complexInstrumentAcceptedReturnBitfield4.rest) IN IF ~complexInstrumentAcceptedReturnBitfield5.ok THEN Fail ELSE
    LET complexInstrumentAcceptedReturnBitfield6 == ReadWhen(numberOfReturnBitfields.value >= 6, ReadBytes(complexInstrumentAcceptedReturnBitfield5.rest, 1), complexInstrumentAcceptedReturnBitfield5.rest) IN IF ~complexInstrumentAcceptedReturnBitfield6.ok THEN Fail ELSE
    LET complexInstrumentAcceptedReturnBitfield7 == ReadWhen(numberOfReturnBitfields.value >= 7, ReadBytes(complexInstrumentAcceptedReturnBitfield6.rest, 1), complexInstrumentAcceptedReturnBitfield6.rest) IN IF ~complexInstrumentAcceptedReturnBitfield7.ok THEN Fail ELSE
    LET complexInstrumentAcceptedReturnBitfield8 == ReadWhen(numberOfReturnBitfields.value >= 8, ReadBytes(complexInstrumentAcceptedReturnBitfield7.rest, 1), complexInstrumentAcceptedReturnBitfield7.rest) IN IF ~complexInstrumentAcceptedReturnBitfield8.ok THEN Fail ELSE
    LET complexInstrumentAcceptedReturnBitfield9 == ReadWhen(numberOfReturnBitfields.value >= 9, ReadBytes(complexInstrumentAcceptedReturnBitfield8.rest, 1), complexInstrumentAcceptedReturnBitfield8.rest) IN IF ~complexInstrumentAcceptedReturnBitfield9.ok THEN Fail ELSE
    LET complexInstrumentAcceptedReturnBitfield10 == ReadWhen(numberOfReturnBitfields.value >= 10, ReadBytes(complexInstrumentAcceptedReturnBitfield9.rest, 1), complexInstrumentAcceptedReturnBitfield9.rest) IN IF ~complexInstrumentAcceptedReturnBitfield10.ok THEN Fail ELSE
    LET complexInstrumentAcceptedReturnBitfield11 == ReadWhen(numberOfReturnBitfields.value >= 11, ReadBytes(complexInstrumentAcceptedReturnBitfield10.rest, 1), complexInstrumentAcceptedReturnBitfield10.rest) IN IF ~complexInstrumentAcceptedReturnBitfield11.ok THEN Fail ELSE
    LET complexInstrumentAcceptedReturnBitfield12 == ReadWhen(numberOfReturnBitfields.value >= 12, ReadBytes(complexInstrumentAcceptedReturnBitfield11.rest, 1), complexInstrumentAcceptedReturnBitfield11.rest) IN IF ~complexInstrumentAcceptedReturnBitfield12.ok THEN Fail ELSE
    LET complexInstrumentAcceptedReturnBitfield13 == ReadWhen(numberOfReturnBitfields.value >= 13, ReadBytes(complexInstrumentAcceptedReturnBitfield12.rest, 1), complexInstrumentAcceptedReturnBitfield12.rest) IN IF ~complexInstrumentAcceptedReturnBitfield13.ok THEN Fail ELSE
    LET complexInstrumentAcceptedReturnBitfield14 == ReadWhen(numberOfReturnBitfields.value >= 14, ReadUIntLE(complexInstrumentAcceptedReturnBitfield13.rest, 1), complexInstrumentAcceptedReturnBitfield13.rest) IN IF ~complexInstrumentAcceptedReturnBitfield14.ok THEN Fail ELSE
    LET complexInstrumentAcceptedReturnBitfield15 == ReadWhen(numberOfReturnBitfields.value >= 15, ReadBytes(complexInstrumentAcceptedReturnBitfield14.rest, 1), complexInstrumentAcceptedReturnBitfield14.rest) IN IF ~complexInstrumentAcceptedReturnBitfield15.ok THEN Fail ELSE
    LET complexInstrumentAcceptedReturnBitfield16 == ReadWhen(numberOfReturnBitfields.value >= 16, ReadBytes(complexInstrumentAcceptedReturnBitfield15.rest, 1), complexInstrumentAcceptedReturnBitfield15.rest) IN IF ~complexInstrumentAcceptedReturnBitfield16.ok THEN Fail ELSE
    LET complexInstrumentAcceptedReturnBitfield17 == ReadWhen(numberOfReturnBitfields.value >= 17, ReadBytes(complexInstrumentAcceptedReturnBitfield16.rest, 1), complexInstrumentAcceptedReturnBitfield16.rest) IN IF ~complexInstrumentAcceptedReturnBitfield17.ok THEN Fail ELSE
    LET complexInstrumentAcceptedReturnBitfield18 == ReadWhen(numberOfReturnBitfields.value >= 18, ReadBytes(complexInstrumentAcceptedReturnBitfield17.rest, 1), complexInstrumentAcceptedReturnBitfield17.rest) IN IF ~complexInstrumentAcceptedReturnBitfield18.ok THEN Fail ELSE
    LET complexInstrumentAcceptedReturnBitfield19 == ReadWhen(numberOfReturnBitfields.value >= 19, ReadBytes(complexInstrumentAcceptedReturnBitfield18.rest, 1), complexInstrumentAcceptedReturnBitfield18.rest) IN IF ~complexInstrumentAcceptedReturnBitfield19.ok THEN Fail ELSE
    LET complexInstrumentAcceptedReturnBitfield20 == ReadWhen(numberOfReturnBitfields.value >= 20, ReadBytes(complexInstrumentAcceptedReturnBitfield19.rest, 1), complexInstrumentAcceptedReturnBitfield19.rest) IN IF ~complexInstrumentAcceptedReturnBitfield20.ok THEN Fail ELSE
    LET complexInstrumentAcceptedReturnBitfield21 == ReadWhen(numberOfReturnBitfields.value >= 21, ReadBytes(complexInstrumentAcceptedReturnBitfield20.rest, 1), complexInstrumentAcceptedReturnBitfield20.rest) IN IF ~complexInstrumentAcceptedReturnBitfield21.ok THEN Fail ELSE
    LET noLegs == ReadUIntBE(complexInstrumentAcceptedReturnBitfield21.rest, 1) IN IF ~noLegs.ok THEN Fail ELSE
    LET complexLeg == ReadComplexLeg2List(noLegs.rest, noLegs.value) IN IF ~complexLeg.ok THEN Fail ELSE
    LET legCfiCode == ReadWhen(numberOfReturnBitfields.value >= 14 /\ (complexInstrumentAcceptedReturnBitfield14.value # << >> /\ complexInstrumentAcceptedReturnBitfield14.value[1] % 2 > 0), ReadBytes(complexLeg.rest, 6), complexLeg.rest) IN IF ~legCfiCode.ok THEN Fail ELSE
    LET legMaturityDate == ReadWhen(numberOfReturnBitfields.value >= 14 /\ (complexInstrumentAcceptedReturnBitfield14.value # << >> /\ (complexInstrumentAcceptedReturnBitfield14.value[1] \div 2) % 2 > 0), ReadBytes(legCfiCode.rest, 4), legCfiCode.rest) IN IF ~legMaturityDate.ok THEN Fail ELSE
    LET legStrikePrice == ReadWhen(numberOfReturnBitfields.value >= 14 /\ (complexInstrumentAcceptedReturnBitfield14.value # << >> /\ (complexInstrumentAcceptedReturnBitfield14.value[1] \div 4) % 2 > 0), ReadBytes(legMaturityDate.rest, 8), legMaturityDate.rest) IN IF ~legStrikePrice.ok THEN Fail ELSE
    Ok([ transactionTime                           |-> transactionTime.value,
         clOrdId                                   |-> clOrdId.value,
         symbolLong                                |-> symbolLong.value,
         revisedLegs                               |-> revisedLegs.value,
         noOfSecurities                            |-> noOfSecurities.value,
         reserved1                                 |-> reserved1.value,
         numberOfReturnBitf                        |-> numberOfReturnBitf.value,
         numberOfReturnBitfields                   |-> numberOfReturnBitfields.value,
         complexInstrumentAcceptedReturnBitfield1  |-> complexInstrumentAcceptedReturnBitfield1.value,
         complexInstrumentAcceptedReturnBitfield2  |-> complexInstrumentAcceptedReturnBitfield2.value,
         complexInstrumentAcceptedReturnBitfield3  |-> complexInstrumentAcceptedReturnBitfield3.value,
         complexInstrumentAcceptedReturnBitfield4  |-> complexInstrumentAcceptedReturnBitfield4.value,
         complexInstrumentAcceptedReturnBitfield5  |-> complexInstrumentAcceptedReturnBitfield5.value,
         complexInstrumentAcceptedReturnBitfield6  |-> complexInstrumentAcceptedReturnBitfield6.value,
         complexInstrumentAcceptedReturnBitfield7  |-> complexInstrumentAcceptedReturnBitfield7.value,
         complexInstrumentAcceptedReturnBitfield8  |-> complexInstrumentAcceptedReturnBitfield8.value,
         complexInstrumentAcceptedReturnBitfield9  |-> complexInstrumentAcceptedReturnBitfield9.value,
         complexInstrumentAcceptedReturnBitfield10 |-> complexInstrumentAcceptedReturnBitfield10.value,
         complexInstrumentAcceptedReturnBitfield11 |-> complexInstrumentAcceptedReturnBitfield11.value,
         complexInstrumentAcceptedReturnBitfield12 |-> complexInstrumentAcceptedReturnBitfield12.value,
         complexInstrumentAcceptedReturnBitfield13 |-> complexInstrumentAcceptedReturnBitfield13.value,
         complexInstrumentAcceptedReturnBitfield14 |-> complexInstrumentAcceptedReturnBitfield14.value,
         complexInstrumentAcceptedReturnBitfield15 |-> complexInstrumentAcceptedReturnBitfield15.value,
         complexInstrumentAcceptedReturnBitfield16 |-> complexInstrumentAcceptedReturnBitfield16.value,
         complexInstrumentAcceptedReturnBitfield17 |-> complexInstrumentAcceptedReturnBitfield17.value,
         complexInstrumentAcceptedReturnBitfield18 |-> complexInstrumentAcceptedReturnBitfield18.value,
         complexInstrumentAcceptedReturnBitfield19 |-> complexInstrumentAcceptedReturnBitfield19.value,
         complexInstrumentAcceptedReturnBitfield20 |-> complexInstrumentAcceptedReturnBitfield20.value,
         complexInstrumentAcceptedReturnBitfield21 |-> complexInstrumentAcceptedReturnBitfield21.value,
         complexLeg                                |-> complexLeg.value,
         legCfiCode                                |-> legCfiCode.value,
         legMaturityDate                           |-> legMaturityDate.value,
         legStrikePrice                            |-> legStrikePrice.value ], legStrikePrice.rest)

(* Complex Instrument Accepted Message with each field marked present by fields before it there exactly where they say *)
SettleComplexInstrumentAcceptedMessage(message) ==
    LET settled1 == [message EXCEPT !.complexInstrumentAcceptedReturnBitfield1 = IF message.numberOfReturnBitfields >= 1 THEN (IF message.complexInstrumentAcceptedReturnBitfield1 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE message.complexInstrumentAcceptedReturnBitfield1) ELSE << >>]
        settled2 == [settled1 EXCEPT !.complexInstrumentAcceptedReturnBitfield2 = IF settled1.numberOfReturnBitfields >= 2 THEN (IF settled1.complexInstrumentAcceptedReturnBitfield2 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled1.complexInstrumentAcceptedReturnBitfield2) ELSE << >>]
        settled3 == [settled2 EXCEPT !.complexInstrumentAcceptedReturnBitfield3 = IF settled2.numberOfReturnBitfields >= 3 THEN (IF settled2.complexInstrumentAcceptedReturnBitfield3 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled2.complexInstrumentAcceptedReturnBitfield3) ELSE << >>]
        settled4 == [settled3 EXCEPT !.complexInstrumentAcceptedReturnBitfield4 = IF settled3.numberOfReturnBitfields >= 4 THEN (IF settled3.complexInstrumentAcceptedReturnBitfield4 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled3.complexInstrumentAcceptedReturnBitfield4) ELSE << >>]
        settled5 == [settled4 EXCEPT !.complexInstrumentAcceptedReturnBitfield5 = IF settled4.numberOfReturnBitfields >= 5 THEN (IF settled4.complexInstrumentAcceptedReturnBitfield5 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled4.complexInstrumentAcceptedReturnBitfield5) ELSE << >>]
        settled6 == [settled5 EXCEPT !.complexInstrumentAcceptedReturnBitfield6 = IF settled5.numberOfReturnBitfields >= 6 THEN (IF settled5.complexInstrumentAcceptedReturnBitfield6 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled5.complexInstrumentAcceptedReturnBitfield6) ELSE << >>]
        settled7 == [settled6 EXCEPT !.complexInstrumentAcceptedReturnBitfield7 = IF settled6.numberOfReturnBitfields >= 7 THEN (IF settled6.complexInstrumentAcceptedReturnBitfield7 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled6.complexInstrumentAcceptedReturnBitfield7) ELSE << >>]
        settled8 == [settled7 EXCEPT !.complexInstrumentAcceptedReturnBitfield8 = IF settled7.numberOfReturnBitfields >= 8 THEN (IF settled7.complexInstrumentAcceptedReturnBitfield8 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled7.complexInstrumentAcceptedReturnBitfield8) ELSE << >>]
        settled9 == [settled8 EXCEPT !.complexInstrumentAcceptedReturnBitfield9 = IF settled8.numberOfReturnBitfields >= 9 THEN (IF settled8.complexInstrumentAcceptedReturnBitfield9 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled8.complexInstrumentAcceptedReturnBitfield9) ELSE << >>]
        settled10 == [settled9 EXCEPT !.complexInstrumentAcceptedReturnBitfield10 = IF settled9.numberOfReturnBitfields >= 10 THEN (IF settled9.complexInstrumentAcceptedReturnBitfield10 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled9.complexInstrumentAcceptedReturnBitfield10) ELSE << >>]
        settled11 == [settled10 EXCEPT !.complexInstrumentAcceptedReturnBitfield11 = IF settled10.numberOfReturnBitfields >= 11 THEN (IF settled10.complexInstrumentAcceptedReturnBitfield11 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled10.complexInstrumentAcceptedReturnBitfield11) ELSE << >>]
        settled12 == [settled11 EXCEPT !.complexInstrumentAcceptedReturnBitfield12 = IF settled11.numberOfReturnBitfields >= 12 THEN (IF settled11.complexInstrumentAcceptedReturnBitfield12 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled11.complexInstrumentAcceptedReturnBitfield12) ELSE << >>]
        settled13 == [settled12 EXCEPT !.complexInstrumentAcceptedReturnBitfield13 = IF settled12.numberOfReturnBitfields >= 13 THEN (IF settled12.complexInstrumentAcceptedReturnBitfield13 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled12.complexInstrumentAcceptedReturnBitfield13) ELSE << >>]
        settled14 == [settled13 EXCEPT !.complexInstrumentAcceptedReturnBitfield14 = IF settled13.numberOfReturnBitfields >= 14 THEN (IF settled13.complexInstrumentAcceptedReturnBitfield14 = << >> THEN <<0>> ELSE settled13.complexInstrumentAcceptedReturnBitfield14) ELSE << >>]
        settled15 == [settled14 EXCEPT !.complexInstrumentAcceptedReturnBitfield15 = IF settled14.numberOfReturnBitfields >= 15 THEN (IF settled14.complexInstrumentAcceptedReturnBitfield15 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled14.complexInstrumentAcceptedReturnBitfield15) ELSE << >>]
        settled16 == [settled15 EXCEPT !.complexInstrumentAcceptedReturnBitfield16 = IF settled15.numberOfReturnBitfields >= 16 THEN (IF settled15.complexInstrumentAcceptedReturnBitfield16 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled15.complexInstrumentAcceptedReturnBitfield16) ELSE << >>]
        settled17 == [settled16 EXCEPT !.complexInstrumentAcceptedReturnBitfield17 = IF settled16.numberOfReturnBitfields >= 17 THEN (IF settled16.complexInstrumentAcceptedReturnBitfield17 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled16.complexInstrumentAcceptedReturnBitfield17) ELSE << >>]
        settled18 == [settled17 EXCEPT !.complexInstrumentAcceptedReturnBitfield18 = IF settled17.numberOfReturnBitfields >= 18 THEN (IF settled17.complexInstrumentAcceptedReturnBitfield18 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled17.complexInstrumentAcceptedReturnBitfield18) ELSE << >>]
        settled19 == [settled18 EXCEPT !.complexInstrumentAcceptedReturnBitfield19 = IF settled18.numberOfReturnBitfields >= 19 THEN (IF settled18.complexInstrumentAcceptedReturnBitfield19 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled18.complexInstrumentAcceptedReturnBitfield19) ELSE << >>]
        settled20 == [settled19 EXCEPT !.complexInstrumentAcceptedReturnBitfield20 = IF settled19.numberOfReturnBitfields >= 20 THEN (IF settled19.complexInstrumentAcceptedReturnBitfield20 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled19.complexInstrumentAcceptedReturnBitfield20) ELSE << >>]
        settled21 == [settled20 EXCEPT !.complexInstrumentAcceptedReturnBitfield21 = IF settled20.numberOfReturnBitfields >= 21 THEN (IF settled20.complexInstrumentAcceptedReturnBitfield21 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled20.complexInstrumentAcceptedReturnBitfield21) ELSE << >>]
        settled22 == [settled21 EXCEPT !.legCfiCode = IF settled21.numberOfReturnBitfields >= 14 /\ (settled21.complexInstrumentAcceptedReturnBitfield14 # << >> /\ settled21.complexInstrumentAcceptedReturnBitfield14[1] % 2 > 0) THEN (IF settled21.legCfiCode = << >> THEN <<[i \in 1 .. 6 |-> 0]>> ELSE settled21.legCfiCode) ELSE << >>]
        settled23 == [settled22 EXCEPT !.legMaturityDate = IF settled22.numberOfReturnBitfields >= 14 /\ (settled22.complexInstrumentAcceptedReturnBitfield14 # << >> /\ (settled22.complexInstrumentAcceptedReturnBitfield14[1] \div 2) % 2 > 0) THEN (IF settled22.legMaturityDate = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled22.legMaturityDate) ELSE << >>]
        settled24 == [settled23 EXCEPT !.legStrikePrice = IF settled23.numberOfReturnBitfields >= 14 /\ (settled23.complexInstrumentAcceptedReturnBitfield14 # << >> /\ (settled23.complexInstrumentAcceptedReturnBitfield14[1] \div 4) % 2 > 0) THEN (IF settled23.legStrikePrice = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled23.legStrikePrice) ELSE << >>]
    IN  settled24

ZeroComplexInstrumentAcceptedMessage ==
    SettleComplexInstrumentAcceptedMessage([ transactionTime                           |-> [i \in 1 .. 8 |-> 0],
                                             clOrdId                                   |-> [i \in 1 .. 20 |-> 0],
                                             symbolLong                                |-> [i \in 1 .. 8 |-> 0],
                                             revisedLegs                               |-> [i \in 1 .. 1 |-> 0],
                                             noOfSecurities                            |-> [i \in 1 .. 4 |-> 0],
                                             reserved1                                 |-> [i \in 1 .. 1 |-> 0],
                                             numberOfReturnBitf                        |-> [i \in 1 .. 1 |-> 0],
                                             numberOfReturnBitfields                   |-> 0,
                                             complexInstrumentAcceptedReturnBitfield1  |-> << >>,
                                             complexInstrumentAcceptedReturnBitfield2  |-> << >>,
                                             complexInstrumentAcceptedReturnBitfield3  |-> << >>,
                                             complexInstrumentAcceptedReturnBitfield4  |-> << >>,
                                             complexInstrumentAcceptedReturnBitfield5  |-> << >>,
                                             complexInstrumentAcceptedReturnBitfield6  |-> << >>,
                                             complexInstrumentAcceptedReturnBitfield7  |-> << >>,
                                             complexInstrumentAcceptedReturnBitfield8  |-> << >>,
                                             complexInstrumentAcceptedReturnBitfield9  |-> << >>,
                                             complexInstrumentAcceptedReturnBitfield10 |-> << >>,
                                             complexInstrumentAcceptedReturnBitfield11 |-> << >>,
                                             complexInstrumentAcceptedReturnBitfield12 |-> << >>,
                                             complexInstrumentAcceptedReturnBitfield13 |-> << >>,
                                             complexInstrumentAcceptedReturnBitfield14 |-> << >>,
                                             complexInstrumentAcceptedReturnBitfield15 |-> << >>,
                                             complexInstrumentAcceptedReturnBitfield16 |-> << >>,
                                             complexInstrumentAcceptedReturnBitfield17 |-> << >>,
                                             complexInstrumentAcceptedReturnBitfield18 |-> << >>,
                                             complexInstrumentAcceptedReturnBitfield19 |-> << >>,
                                             complexInstrumentAcceptedReturnBitfield20 |-> << >>,
                                             complexInstrumentAcceptedReturnBitfield21 |-> << >>,
                                             complexLeg                                |-> << >>,
                                             legCfiCode                                |-> << >>,
                                             legMaturityDate                           |-> << >>,
                                             legStrikePrice                            |-> << >> ])

(* Complex Instrument Accepted Message at zero, then each field in turn at the values it is checked at *)
CheckedComplexInstrumentAcceptedMessage ==
    { ZeroComplexInstrumentAcceptedMessage }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.transactionTime = one]) : one \in Sample(8) }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.clOrdId = one]) : one \in Sample(20) }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.symbolLong = one]) : one \in Sample(8) }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.revisedLegs = one]) : one \in Sample(1) }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.noOfSecurities = one]) : one \in Sample(4) }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.reserved1 = one]) : one \in Sample(1) }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.numberOfReturnBitf = one]) : one \in Sample(1) }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.numberOfReturnBitfields = one]) : one \in {0, 1, 255} }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.numberOfReturnBitfields = 1, !.complexInstrumentAcceptedReturnBitfield1 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.numberOfReturnBitfields = 2, !.complexInstrumentAcceptedReturnBitfield2 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.numberOfReturnBitfields = 3, !.complexInstrumentAcceptedReturnBitfield3 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.numberOfReturnBitfields = 4, !.complexInstrumentAcceptedReturnBitfield4 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.numberOfReturnBitfields = 5, !.complexInstrumentAcceptedReturnBitfield5 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.numberOfReturnBitfields = 6, !.complexInstrumentAcceptedReturnBitfield6 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.numberOfReturnBitfields = 7, !.complexInstrumentAcceptedReturnBitfield7 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.numberOfReturnBitfields = 8, !.complexInstrumentAcceptedReturnBitfield8 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.numberOfReturnBitfields = 9, !.complexInstrumentAcceptedReturnBitfield9 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.numberOfReturnBitfields = 10, !.complexInstrumentAcceptedReturnBitfield10 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.numberOfReturnBitfields = 11, !.complexInstrumentAcceptedReturnBitfield11 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.numberOfReturnBitfields = 12, !.complexInstrumentAcceptedReturnBitfield12 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.numberOfReturnBitfields = 13, !.complexInstrumentAcceptedReturnBitfield13 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.numberOfReturnBitfields = 14, !.complexInstrumentAcceptedReturnBitfield14 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.numberOfReturnBitfields = 15, !.complexInstrumentAcceptedReturnBitfield15 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.numberOfReturnBitfields = 16, !.complexInstrumentAcceptedReturnBitfield16 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.numberOfReturnBitfields = 17, !.complexInstrumentAcceptedReturnBitfield17 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.numberOfReturnBitfields = 18, !.complexInstrumentAcceptedReturnBitfield18 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.numberOfReturnBitfields = 19, !.complexInstrumentAcceptedReturnBitfield19 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.numberOfReturnBitfields = 20, !.complexInstrumentAcceptedReturnBitfield20 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.numberOfReturnBitfields = 21, !.complexInstrumentAcceptedReturnBitfield21 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.complexLeg = one]) : one \in SampleLists(OneComplexLeg2) }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.numberOfReturnBitfields = 14, !.complexInstrumentAcceptedReturnBitfield14 = <<1>>, !.legCfiCode = one]) : one \in { <<held>> : held \in Sample(6) } }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.numberOfReturnBitfields = 14, !.complexInstrumentAcceptedReturnBitfield14 = <<2>>, !.legMaturityDate = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.numberOfReturnBitfields = 14, !.complexInstrumentAcceptedReturnBitfield14 = <<4>>, !.legStrikePrice = one]) : one \in { <<held>> : held \in Sample(8) } }

(***************************************************************************)
(* Complex Instrument Rejected Message                                     *)
(***************************************************************************)

ComplexInstrumentRejectedMessage ==
    [ transactionTime                           : Sample(8),
      clOrdId                                   : Sample(20),
      orderRejectReason                         : Sample(1),
      text                                      : Sample(60),
      noOfSecurities                            : Sample(4),
      reserved1                                 : Sample(1),
      numberOfReturnBitfields                   : 0 .. 255,
      complexInstrumentRejectedReturnBitfield1  : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentRejectedReturnBitfield2  : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentRejectedReturnBitfield3  : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentRejectedReturnBitfield4  : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentRejectedReturnBitfield5  : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentRejectedReturnBitfield6  : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentRejectedReturnBitfield7  : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentRejectedReturnBitfield8  : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentRejectedReturnBitfield9  : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentRejectedReturnBitfield10 : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentRejectedReturnBitfield11 : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentRejectedReturnBitfield12 : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentRejectedReturnBitfield13 : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentRejectedReturnBitfield14 : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentRejectedReturnBitfield15 : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentRejectedReturnBitfield16 : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentRejectedReturnBitfield17 : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentRejectedReturnBitfield18 : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentRejectedReturnBitfield19 : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentRejectedReturnBitfield20 : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentRejectedReturnBitfield21 : { << >> } \cup { <<held>> : held \in Sample(1) } ]

EncodeComplexInstrumentRejectedMessage(message) ==
    message.transactionTime
        \o message.clOrdId
        \o message.orderRejectReason
        \o message.text
        \o message.noOfSecurities
        \o message.reserved1
        \o EncodeUIntBE(message.numberOfReturnBitfields, 1)
        \o (IF message.complexInstrumentRejectedReturnBitfield1 = << >> THEN << >> ELSE message.complexInstrumentRejectedReturnBitfield1[1])
        \o (IF message.complexInstrumentRejectedReturnBitfield2 = << >> THEN << >> ELSE message.complexInstrumentRejectedReturnBitfield2[1])
        \o (IF message.complexInstrumentRejectedReturnBitfield3 = << >> THEN << >> ELSE message.complexInstrumentRejectedReturnBitfield3[1])
        \o (IF message.complexInstrumentRejectedReturnBitfield4 = << >> THEN << >> ELSE message.complexInstrumentRejectedReturnBitfield4[1])
        \o (IF message.complexInstrumentRejectedReturnBitfield5 = << >> THEN << >> ELSE message.complexInstrumentRejectedReturnBitfield5[1])
        \o (IF message.complexInstrumentRejectedReturnBitfield6 = << >> THEN << >> ELSE message.complexInstrumentRejectedReturnBitfield6[1])
        \o (IF message.complexInstrumentRejectedReturnBitfield7 = << >> THEN << >> ELSE message.complexInstrumentRejectedReturnBitfield7[1])
        \o (IF message.complexInstrumentRejectedReturnBitfield8 = << >> THEN << >> ELSE message.complexInstrumentRejectedReturnBitfield8[1])
        \o (IF message.complexInstrumentRejectedReturnBitfield9 = << >> THEN << >> ELSE message.complexInstrumentRejectedReturnBitfield9[1])
        \o (IF message.complexInstrumentRejectedReturnBitfield10 = << >> THEN << >> ELSE message.complexInstrumentRejectedReturnBitfield10[1])
        \o (IF message.complexInstrumentRejectedReturnBitfield11 = << >> THEN << >> ELSE message.complexInstrumentRejectedReturnBitfield11[1])
        \o (IF message.complexInstrumentRejectedReturnBitfield12 = << >> THEN << >> ELSE message.complexInstrumentRejectedReturnBitfield12[1])
        \o (IF message.complexInstrumentRejectedReturnBitfield13 = << >> THEN << >> ELSE message.complexInstrumentRejectedReturnBitfield13[1])
        \o (IF message.complexInstrumentRejectedReturnBitfield14 = << >> THEN << >> ELSE message.complexInstrumentRejectedReturnBitfield14[1])
        \o (IF message.complexInstrumentRejectedReturnBitfield15 = << >> THEN << >> ELSE message.complexInstrumentRejectedReturnBitfield15[1])
        \o (IF message.complexInstrumentRejectedReturnBitfield16 = << >> THEN << >> ELSE message.complexInstrumentRejectedReturnBitfield16[1])
        \o (IF message.complexInstrumentRejectedReturnBitfield17 = << >> THEN << >> ELSE message.complexInstrumentRejectedReturnBitfield17[1])
        \o (IF message.complexInstrumentRejectedReturnBitfield18 = << >> THEN << >> ELSE message.complexInstrumentRejectedReturnBitfield18[1])
        \o (IF message.complexInstrumentRejectedReturnBitfield19 = << >> THEN << >> ELSE message.complexInstrumentRejectedReturnBitfield19[1])
        \o (IF message.complexInstrumentRejectedReturnBitfield20 = << >> THEN << >> ELSE message.complexInstrumentRejectedReturnBitfield20[1])
        \o (IF message.complexInstrumentRejectedReturnBitfield21 = << >> THEN << >> ELSE message.complexInstrumentRejectedReturnBitfield21[1])

DecodeComplexInstrumentRejectedMessage(bytes) ==
    LET transactionTime == ReadBytes(bytes, 8) IN IF ~transactionTime.ok THEN Fail ELSE
    LET clOrdId == ReadBytes(transactionTime.rest, 20) IN IF ~clOrdId.ok THEN Fail ELSE
    LET orderRejectReason == ReadBytes(clOrdId.rest, 1) IN IF ~orderRejectReason.ok THEN Fail ELSE
    LET text == ReadBytes(orderRejectReason.rest, 60) IN IF ~text.ok THEN Fail ELSE
    LET noOfSecurities == ReadBytes(text.rest, 4) IN IF ~noOfSecurities.ok THEN Fail ELSE
    LET reserved1 == ReadBytes(noOfSecurities.rest, 1) IN IF ~reserved1.ok THEN Fail ELSE
    LET numberOfReturnBitfields == ReadUIntBE(reserved1.rest, 1) IN IF ~numberOfReturnBitfields.ok THEN Fail ELSE
    LET complexInstrumentRejectedReturnBitfield1 == ReadWhen(numberOfReturnBitfields.value >= 1, ReadBytes(numberOfReturnBitfields.rest, 1), numberOfReturnBitfields.rest) IN IF ~complexInstrumentRejectedReturnBitfield1.ok THEN Fail ELSE
    LET complexInstrumentRejectedReturnBitfield2 == ReadWhen(numberOfReturnBitfields.value >= 2, ReadBytes(complexInstrumentRejectedReturnBitfield1.rest, 1), complexInstrumentRejectedReturnBitfield1.rest) IN IF ~complexInstrumentRejectedReturnBitfield2.ok THEN Fail ELSE
    LET complexInstrumentRejectedReturnBitfield3 == ReadWhen(numberOfReturnBitfields.value >= 3, ReadBytes(complexInstrumentRejectedReturnBitfield2.rest, 1), complexInstrumentRejectedReturnBitfield2.rest) IN IF ~complexInstrumentRejectedReturnBitfield3.ok THEN Fail ELSE
    LET complexInstrumentRejectedReturnBitfield4 == ReadWhen(numberOfReturnBitfields.value >= 4, ReadBytes(complexInstrumentRejectedReturnBitfield3.rest, 1), complexInstrumentRejectedReturnBitfield3.rest) IN IF ~complexInstrumentRejectedReturnBitfield4.ok THEN Fail ELSE
    LET complexInstrumentRejectedReturnBitfield5 == ReadWhen(numberOfReturnBitfields.value >= 5, ReadBytes(complexInstrumentRejectedReturnBitfield4.rest, 1), complexInstrumentRejectedReturnBitfield4.rest) IN IF ~complexInstrumentRejectedReturnBitfield5.ok THEN Fail ELSE
    LET complexInstrumentRejectedReturnBitfield6 == ReadWhen(numberOfReturnBitfields.value >= 6, ReadBytes(complexInstrumentRejectedReturnBitfield5.rest, 1), complexInstrumentRejectedReturnBitfield5.rest) IN IF ~complexInstrumentRejectedReturnBitfield6.ok THEN Fail ELSE
    LET complexInstrumentRejectedReturnBitfield7 == ReadWhen(numberOfReturnBitfields.value >= 7, ReadBytes(complexInstrumentRejectedReturnBitfield6.rest, 1), complexInstrumentRejectedReturnBitfield6.rest) IN IF ~complexInstrumentRejectedReturnBitfield7.ok THEN Fail ELSE
    LET complexInstrumentRejectedReturnBitfield8 == ReadWhen(numberOfReturnBitfields.value >= 8, ReadBytes(complexInstrumentRejectedReturnBitfield7.rest, 1), complexInstrumentRejectedReturnBitfield7.rest) IN IF ~complexInstrumentRejectedReturnBitfield8.ok THEN Fail ELSE
    LET complexInstrumentRejectedReturnBitfield9 == ReadWhen(numberOfReturnBitfields.value >= 9, ReadBytes(complexInstrumentRejectedReturnBitfield8.rest, 1), complexInstrumentRejectedReturnBitfield8.rest) IN IF ~complexInstrumentRejectedReturnBitfield9.ok THEN Fail ELSE
    LET complexInstrumentRejectedReturnBitfield10 == ReadWhen(numberOfReturnBitfields.value >= 10, ReadBytes(complexInstrumentRejectedReturnBitfield9.rest, 1), complexInstrumentRejectedReturnBitfield9.rest) IN IF ~complexInstrumentRejectedReturnBitfield10.ok THEN Fail ELSE
    LET complexInstrumentRejectedReturnBitfield11 == ReadWhen(numberOfReturnBitfields.value >= 11, ReadBytes(complexInstrumentRejectedReturnBitfield10.rest, 1), complexInstrumentRejectedReturnBitfield10.rest) IN IF ~complexInstrumentRejectedReturnBitfield11.ok THEN Fail ELSE
    LET complexInstrumentRejectedReturnBitfield12 == ReadWhen(numberOfReturnBitfields.value >= 12, ReadBytes(complexInstrumentRejectedReturnBitfield11.rest, 1), complexInstrumentRejectedReturnBitfield11.rest) IN IF ~complexInstrumentRejectedReturnBitfield12.ok THEN Fail ELSE
    LET complexInstrumentRejectedReturnBitfield13 == ReadWhen(numberOfReturnBitfields.value >= 13, ReadBytes(complexInstrumentRejectedReturnBitfield12.rest, 1), complexInstrumentRejectedReturnBitfield12.rest) IN IF ~complexInstrumentRejectedReturnBitfield13.ok THEN Fail ELSE
    LET complexInstrumentRejectedReturnBitfield14 == ReadWhen(numberOfReturnBitfields.value >= 14, ReadBytes(complexInstrumentRejectedReturnBitfield13.rest, 1), complexInstrumentRejectedReturnBitfield13.rest) IN IF ~complexInstrumentRejectedReturnBitfield14.ok THEN Fail ELSE
    LET complexInstrumentRejectedReturnBitfield15 == ReadWhen(numberOfReturnBitfields.value >= 15, ReadBytes(complexInstrumentRejectedReturnBitfield14.rest, 1), complexInstrumentRejectedReturnBitfield14.rest) IN IF ~complexInstrumentRejectedReturnBitfield15.ok THEN Fail ELSE
    LET complexInstrumentRejectedReturnBitfield16 == ReadWhen(numberOfReturnBitfields.value >= 16, ReadBytes(complexInstrumentRejectedReturnBitfield15.rest, 1), complexInstrumentRejectedReturnBitfield15.rest) IN IF ~complexInstrumentRejectedReturnBitfield16.ok THEN Fail ELSE
    LET complexInstrumentRejectedReturnBitfield17 == ReadWhen(numberOfReturnBitfields.value >= 17, ReadBytes(complexInstrumentRejectedReturnBitfield16.rest, 1), complexInstrumentRejectedReturnBitfield16.rest) IN IF ~complexInstrumentRejectedReturnBitfield17.ok THEN Fail ELSE
    LET complexInstrumentRejectedReturnBitfield18 == ReadWhen(numberOfReturnBitfields.value >= 18, ReadBytes(complexInstrumentRejectedReturnBitfield17.rest, 1), complexInstrumentRejectedReturnBitfield17.rest) IN IF ~complexInstrumentRejectedReturnBitfield18.ok THEN Fail ELSE
    LET complexInstrumentRejectedReturnBitfield19 == ReadWhen(numberOfReturnBitfields.value >= 19, ReadBytes(complexInstrumentRejectedReturnBitfield18.rest, 1), complexInstrumentRejectedReturnBitfield18.rest) IN IF ~complexInstrumentRejectedReturnBitfield19.ok THEN Fail ELSE
    LET complexInstrumentRejectedReturnBitfield20 == ReadWhen(numberOfReturnBitfields.value >= 20, ReadBytes(complexInstrumentRejectedReturnBitfield19.rest, 1), complexInstrumentRejectedReturnBitfield19.rest) IN IF ~complexInstrumentRejectedReturnBitfield20.ok THEN Fail ELSE
    LET complexInstrumentRejectedReturnBitfield21 == ReadWhen(numberOfReturnBitfields.value >= 21, ReadBytes(complexInstrumentRejectedReturnBitfield20.rest, 1), complexInstrumentRejectedReturnBitfield20.rest) IN IF ~complexInstrumentRejectedReturnBitfield21.ok THEN Fail ELSE
    Ok([ transactionTime                           |-> transactionTime.value,
         clOrdId                                   |-> clOrdId.value,
         orderRejectReason                         |-> orderRejectReason.value,
         text                                      |-> text.value,
         noOfSecurities                            |-> noOfSecurities.value,
         reserved1                                 |-> reserved1.value,
         numberOfReturnBitfields                   |-> numberOfReturnBitfields.value,
         complexInstrumentRejectedReturnBitfield1  |-> complexInstrumentRejectedReturnBitfield1.value,
         complexInstrumentRejectedReturnBitfield2  |-> complexInstrumentRejectedReturnBitfield2.value,
         complexInstrumentRejectedReturnBitfield3  |-> complexInstrumentRejectedReturnBitfield3.value,
         complexInstrumentRejectedReturnBitfield4  |-> complexInstrumentRejectedReturnBitfield4.value,
         complexInstrumentRejectedReturnBitfield5  |-> complexInstrumentRejectedReturnBitfield5.value,
         complexInstrumentRejectedReturnBitfield6  |-> complexInstrumentRejectedReturnBitfield6.value,
         complexInstrumentRejectedReturnBitfield7  |-> complexInstrumentRejectedReturnBitfield7.value,
         complexInstrumentRejectedReturnBitfield8  |-> complexInstrumentRejectedReturnBitfield8.value,
         complexInstrumentRejectedReturnBitfield9  |-> complexInstrumentRejectedReturnBitfield9.value,
         complexInstrumentRejectedReturnBitfield10 |-> complexInstrumentRejectedReturnBitfield10.value,
         complexInstrumentRejectedReturnBitfield11 |-> complexInstrumentRejectedReturnBitfield11.value,
         complexInstrumentRejectedReturnBitfield12 |-> complexInstrumentRejectedReturnBitfield12.value,
         complexInstrumentRejectedReturnBitfield13 |-> complexInstrumentRejectedReturnBitfield13.value,
         complexInstrumentRejectedReturnBitfield14 |-> complexInstrumentRejectedReturnBitfield14.value,
         complexInstrumentRejectedReturnBitfield15 |-> complexInstrumentRejectedReturnBitfield15.value,
         complexInstrumentRejectedReturnBitfield16 |-> complexInstrumentRejectedReturnBitfield16.value,
         complexInstrumentRejectedReturnBitfield17 |-> complexInstrumentRejectedReturnBitfield17.value,
         complexInstrumentRejectedReturnBitfield18 |-> complexInstrumentRejectedReturnBitfield18.value,
         complexInstrumentRejectedReturnBitfield19 |-> complexInstrumentRejectedReturnBitfield19.value,
         complexInstrumentRejectedReturnBitfield20 |-> complexInstrumentRejectedReturnBitfield20.value,
         complexInstrumentRejectedReturnBitfield21 |-> complexInstrumentRejectedReturnBitfield21.value ], complexInstrumentRejectedReturnBitfield21.rest)

(* Complex Instrument Rejected Message with each field marked present by fields before it there exactly where they say *)
SettleComplexInstrumentRejectedMessage(message) ==
    LET settled1 == [message EXCEPT !.complexInstrumentRejectedReturnBitfield1 = IF message.numberOfReturnBitfields >= 1 THEN (IF message.complexInstrumentRejectedReturnBitfield1 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE message.complexInstrumentRejectedReturnBitfield1) ELSE << >>]
        settled2 == [settled1 EXCEPT !.complexInstrumentRejectedReturnBitfield2 = IF settled1.numberOfReturnBitfields >= 2 THEN (IF settled1.complexInstrumentRejectedReturnBitfield2 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled1.complexInstrumentRejectedReturnBitfield2) ELSE << >>]
        settled3 == [settled2 EXCEPT !.complexInstrumentRejectedReturnBitfield3 = IF settled2.numberOfReturnBitfields >= 3 THEN (IF settled2.complexInstrumentRejectedReturnBitfield3 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled2.complexInstrumentRejectedReturnBitfield3) ELSE << >>]
        settled4 == [settled3 EXCEPT !.complexInstrumentRejectedReturnBitfield4 = IF settled3.numberOfReturnBitfields >= 4 THEN (IF settled3.complexInstrumentRejectedReturnBitfield4 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled3.complexInstrumentRejectedReturnBitfield4) ELSE << >>]
        settled5 == [settled4 EXCEPT !.complexInstrumentRejectedReturnBitfield5 = IF settled4.numberOfReturnBitfields >= 5 THEN (IF settled4.complexInstrumentRejectedReturnBitfield5 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled4.complexInstrumentRejectedReturnBitfield5) ELSE << >>]
        settled6 == [settled5 EXCEPT !.complexInstrumentRejectedReturnBitfield6 = IF settled5.numberOfReturnBitfields >= 6 THEN (IF settled5.complexInstrumentRejectedReturnBitfield6 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled5.complexInstrumentRejectedReturnBitfield6) ELSE << >>]
        settled7 == [settled6 EXCEPT !.complexInstrumentRejectedReturnBitfield7 = IF settled6.numberOfReturnBitfields >= 7 THEN (IF settled6.complexInstrumentRejectedReturnBitfield7 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled6.complexInstrumentRejectedReturnBitfield7) ELSE << >>]
        settled8 == [settled7 EXCEPT !.complexInstrumentRejectedReturnBitfield8 = IF settled7.numberOfReturnBitfields >= 8 THEN (IF settled7.complexInstrumentRejectedReturnBitfield8 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled7.complexInstrumentRejectedReturnBitfield8) ELSE << >>]
        settled9 == [settled8 EXCEPT !.complexInstrumentRejectedReturnBitfield9 = IF settled8.numberOfReturnBitfields >= 9 THEN (IF settled8.complexInstrumentRejectedReturnBitfield9 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled8.complexInstrumentRejectedReturnBitfield9) ELSE << >>]
        settled10 == [settled9 EXCEPT !.complexInstrumentRejectedReturnBitfield10 = IF settled9.numberOfReturnBitfields >= 10 THEN (IF settled9.complexInstrumentRejectedReturnBitfield10 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled9.complexInstrumentRejectedReturnBitfield10) ELSE << >>]
        settled11 == [settled10 EXCEPT !.complexInstrumentRejectedReturnBitfield11 = IF settled10.numberOfReturnBitfields >= 11 THEN (IF settled10.complexInstrumentRejectedReturnBitfield11 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled10.complexInstrumentRejectedReturnBitfield11) ELSE << >>]
        settled12 == [settled11 EXCEPT !.complexInstrumentRejectedReturnBitfield12 = IF settled11.numberOfReturnBitfields >= 12 THEN (IF settled11.complexInstrumentRejectedReturnBitfield12 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled11.complexInstrumentRejectedReturnBitfield12) ELSE << >>]
        settled13 == [settled12 EXCEPT !.complexInstrumentRejectedReturnBitfield13 = IF settled12.numberOfReturnBitfields >= 13 THEN (IF settled12.complexInstrumentRejectedReturnBitfield13 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled12.complexInstrumentRejectedReturnBitfield13) ELSE << >>]
        settled14 == [settled13 EXCEPT !.complexInstrumentRejectedReturnBitfield14 = IF settled13.numberOfReturnBitfields >= 14 THEN (IF settled13.complexInstrumentRejectedReturnBitfield14 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled13.complexInstrumentRejectedReturnBitfield14) ELSE << >>]
        settled15 == [settled14 EXCEPT !.complexInstrumentRejectedReturnBitfield15 = IF settled14.numberOfReturnBitfields >= 15 THEN (IF settled14.complexInstrumentRejectedReturnBitfield15 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled14.complexInstrumentRejectedReturnBitfield15) ELSE << >>]
        settled16 == [settled15 EXCEPT !.complexInstrumentRejectedReturnBitfield16 = IF settled15.numberOfReturnBitfields >= 16 THEN (IF settled15.complexInstrumentRejectedReturnBitfield16 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled15.complexInstrumentRejectedReturnBitfield16) ELSE << >>]
        settled17 == [settled16 EXCEPT !.complexInstrumentRejectedReturnBitfield17 = IF settled16.numberOfReturnBitfields >= 17 THEN (IF settled16.complexInstrumentRejectedReturnBitfield17 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled16.complexInstrumentRejectedReturnBitfield17) ELSE << >>]
        settled18 == [settled17 EXCEPT !.complexInstrumentRejectedReturnBitfield18 = IF settled17.numberOfReturnBitfields >= 18 THEN (IF settled17.complexInstrumentRejectedReturnBitfield18 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled17.complexInstrumentRejectedReturnBitfield18) ELSE << >>]
        settled19 == [settled18 EXCEPT !.complexInstrumentRejectedReturnBitfield19 = IF settled18.numberOfReturnBitfields >= 19 THEN (IF settled18.complexInstrumentRejectedReturnBitfield19 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled18.complexInstrumentRejectedReturnBitfield19) ELSE << >>]
        settled20 == [settled19 EXCEPT !.complexInstrumentRejectedReturnBitfield20 = IF settled19.numberOfReturnBitfields >= 20 THEN (IF settled19.complexInstrumentRejectedReturnBitfield20 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled19.complexInstrumentRejectedReturnBitfield20) ELSE << >>]
        settled21 == [settled20 EXCEPT !.complexInstrumentRejectedReturnBitfield21 = IF settled20.numberOfReturnBitfields >= 21 THEN (IF settled20.complexInstrumentRejectedReturnBitfield21 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled20.complexInstrumentRejectedReturnBitfield21) ELSE << >>]
    IN  settled21

ZeroComplexInstrumentRejectedMessage ==
    SettleComplexInstrumentRejectedMessage([ transactionTime                           |-> [i \in 1 .. 8 |-> 0],
                                             clOrdId                                   |-> [i \in 1 .. 20 |-> 0],
                                             orderRejectReason                         |-> [i \in 1 .. 1 |-> 0],
                                             text                                      |-> [i \in 1 .. 60 |-> 0],
                                             noOfSecurities                            |-> [i \in 1 .. 4 |-> 0],
                                             reserved1                                 |-> [i \in 1 .. 1 |-> 0],
                                             numberOfReturnBitfields                   |-> 0,
                                             complexInstrumentRejectedReturnBitfield1  |-> << >>,
                                             complexInstrumentRejectedReturnBitfield2  |-> << >>,
                                             complexInstrumentRejectedReturnBitfield3  |-> << >>,
                                             complexInstrumentRejectedReturnBitfield4  |-> << >>,
                                             complexInstrumentRejectedReturnBitfield5  |-> << >>,
                                             complexInstrumentRejectedReturnBitfield6  |-> << >>,
                                             complexInstrumentRejectedReturnBitfield7  |-> << >>,
                                             complexInstrumentRejectedReturnBitfield8  |-> << >>,
                                             complexInstrumentRejectedReturnBitfield9  |-> << >>,
                                             complexInstrumentRejectedReturnBitfield10 |-> << >>,
                                             complexInstrumentRejectedReturnBitfield11 |-> << >>,
                                             complexInstrumentRejectedReturnBitfield12 |-> << >>,
                                             complexInstrumentRejectedReturnBitfield13 |-> << >>,
                                             complexInstrumentRejectedReturnBitfield14 |-> << >>,
                                             complexInstrumentRejectedReturnBitfield15 |-> << >>,
                                             complexInstrumentRejectedReturnBitfield16 |-> << >>,
                                             complexInstrumentRejectedReturnBitfield17 |-> << >>,
                                             complexInstrumentRejectedReturnBitfield18 |-> << >>,
                                             complexInstrumentRejectedReturnBitfield19 |-> << >>,
                                             complexInstrumentRejectedReturnBitfield20 |-> << >>,
                                             complexInstrumentRejectedReturnBitfield21 |-> << >> ])

(* Complex Instrument Rejected Message at zero, then each field in turn at the values it is checked at *)
CheckedComplexInstrumentRejectedMessage ==
    { ZeroComplexInstrumentRejectedMessage }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.transactionTime = one]) : one \in Sample(8) }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.clOrdId = one]) : one \in Sample(20) }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.orderRejectReason = one]) : one \in Sample(1) }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.text = one]) : one \in Sample(60) }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.noOfSecurities = one]) : one \in Sample(4) }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.reserved1 = one]) : one \in Sample(1) }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.numberOfReturnBitfields = one]) : one \in {0, 1, 255} }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.numberOfReturnBitfields = 1, !.complexInstrumentRejectedReturnBitfield1 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.numberOfReturnBitfields = 2, !.complexInstrumentRejectedReturnBitfield2 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.numberOfReturnBitfields = 3, !.complexInstrumentRejectedReturnBitfield3 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.numberOfReturnBitfields = 4, !.complexInstrumentRejectedReturnBitfield4 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.numberOfReturnBitfields = 5, !.complexInstrumentRejectedReturnBitfield5 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.numberOfReturnBitfields = 6, !.complexInstrumentRejectedReturnBitfield6 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.numberOfReturnBitfields = 7, !.complexInstrumentRejectedReturnBitfield7 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.numberOfReturnBitfields = 8, !.complexInstrumentRejectedReturnBitfield8 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.numberOfReturnBitfields = 9, !.complexInstrumentRejectedReturnBitfield9 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.numberOfReturnBitfields = 10, !.complexInstrumentRejectedReturnBitfield10 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.numberOfReturnBitfields = 11, !.complexInstrumentRejectedReturnBitfield11 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.numberOfReturnBitfields = 12, !.complexInstrumentRejectedReturnBitfield12 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.numberOfReturnBitfields = 13, !.complexInstrumentRejectedReturnBitfield13 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.numberOfReturnBitfields = 14, !.complexInstrumentRejectedReturnBitfield14 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.numberOfReturnBitfields = 15, !.complexInstrumentRejectedReturnBitfield15 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.numberOfReturnBitfields = 16, !.complexInstrumentRejectedReturnBitfield16 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.numberOfReturnBitfields = 17, !.complexInstrumentRejectedReturnBitfield17 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.numberOfReturnBitfields = 18, !.complexInstrumentRejectedReturnBitfield18 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.numberOfReturnBitfields = 19, !.complexInstrumentRejectedReturnBitfield19 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.numberOfReturnBitfields = 20, !.complexInstrumentRejectedReturnBitfield20 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.numberOfReturnBitfields = 21, !.complexInstrumentRejectedReturnBitfield21 = one]) : one \in { <<held>> : held \in Sample(1) } }

(***************************************************************************)
(* Floor Trade Notification Message: 74 bytes                              *)
(***************************************************************************)

FloorTradeNotificationMessage ==
    [ execId                : Sample(8),
      symbolLong            : Sample(8),
      putOrCall             : Sample(1),
      strikePrice           : Sample(8),
      maturityDate          : Sample(4),
      orderQtyLong          : Sample(4),
      priceLong             : Sample(8),
      side                  : Sample(1),
      contraTrader          : Sample(4),
      floorTraderAcronym    : Sample(3),
      floorTradeTime        : Sample(8),
      tradeThroughAlertType : Sample(1),
      priceType             : Sample(1),
      reserved15            : Sample(15) ]

EncodeFloorTradeNotificationMessage(message) ==
    message.execId
        \o message.symbolLong
        \o message.putOrCall
        \o message.strikePrice
        \o message.maturityDate
        \o message.orderQtyLong
        \o message.priceLong
        \o message.side
        \o message.contraTrader
        \o message.floorTraderAcronym
        \o message.floorTradeTime
        \o message.tradeThroughAlertType
        \o message.priceType
        \o message.reserved15

DecodeFloorTradeNotificationMessage(bytes) ==
    LET execId == ReadBytes(bytes, 8) IN IF ~execId.ok THEN Fail ELSE
    LET symbolLong == ReadBytes(execId.rest, 8) IN IF ~symbolLong.ok THEN Fail ELSE
    LET putOrCall == ReadBytes(symbolLong.rest, 1) IN IF ~putOrCall.ok THEN Fail ELSE
    LET strikePrice == ReadBytes(putOrCall.rest, 8) IN IF ~strikePrice.ok THEN Fail ELSE
    LET maturityDate == ReadBytes(strikePrice.rest, 4) IN IF ~maturityDate.ok THEN Fail ELSE
    LET orderQtyLong == ReadBytes(maturityDate.rest, 4) IN IF ~orderQtyLong.ok THEN Fail ELSE
    LET priceLong == ReadBytes(orderQtyLong.rest, 8) IN IF ~priceLong.ok THEN Fail ELSE
    LET side == ReadBytes(priceLong.rest, 1) IN IF ~side.ok THEN Fail ELSE
    LET contraTrader == ReadBytes(side.rest, 4) IN IF ~contraTrader.ok THEN Fail ELSE
    LET floorTraderAcronym == ReadBytes(contraTrader.rest, 3) IN IF ~floorTraderAcronym.ok THEN Fail ELSE
    LET floorTradeTime == ReadBytes(floorTraderAcronym.rest, 8) IN IF ~floorTradeTime.ok THEN Fail ELSE
    LET tradeThroughAlertType == ReadBytes(floorTradeTime.rest, 1) IN IF ~tradeThroughAlertType.ok THEN Fail ELSE
    LET priceType == ReadBytes(tradeThroughAlertType.rest, 1) IN IF ~priceType.ok THEN Fail ELSE
    LET reserved15 == ReadBytes(priceType.rest, 15) IN IF ~reserved15.ok THEN Fail ELSE
    Ok([ execId                |-> execId.value,
         symbolLong            |-> symbolLong.value,
         putOrCall             |-> putOrCall.value,
         strikePrice           |-> strikePrice.value,
         maturityDate          |-> maturityDate.value,
         orderQtyLong          |-> orderQtyLong.value,
         priceLong             |-> priceLong.value,
         side                  |-> side.value,
         contraTrader          |-> contraTrader.value,
         floorTraderAcronym    |-> floorTraderAcronym.value,
         floorTradeTime        |-> floorTradeTime.value,
         tradeThroughAlertType |-> tradeThroughAlertType.value,
         priceType             |-> priceType.value,
         reserved15            |-> reserved15.value ], reserved15.rest)

ZeroFloorTradeNotificationMessage ==
    [ execId                |-> [i \in 1 .. 8 |-> 0],
      symbolLong            |-> [i \in 1 .. 8 |-> 0],
      putOrCall             |-> [i \in 1 .. 1 |-> 0],
      strikePrice           |-> [i \in 1 .. 8 |-> 0],
      maturityDate          |-> [i \in 1 .. 4 |-> 0],
      orderQtyLong          |-> [i \in 1 .. 4 |-> 0],
      priceLong             |-> [i \in 1 .. 8 |-> 0],
      side                  |-> [i \in 1 .. 1 |-> 0],
      contraTrader          |-> [i \in 1 .. 4 |-> 0],
      floorTraderAcronym    |-> [i \in 1 .. 3 |-> 0],
      floorTradeTime        |-> [i \in 1 .. 8 |-> 0],
      tradeThroughAlertType |-> [i \in 1 .. 1 |-> 0],
      priceType             |-> [i \in 1 .. 1 |-> 0],
      reserved15            |-> [i \in 1 .. 15 |-> 0] ]

(* Floor Trade Notification Message at zero, then each field in turn at the values it is checked at *)
CheckedFloorTradeNotificationMessage ==
    { ZeroFloorTradeNotificationMessage }
        \cup { [ZeroFloorTradeNotificationMessage EXCEPT !.execId = one] : one \in Sample(8) }
        \cup { [ZeroFloorTradeNotificationMessage EXCEPT !.symbolLong = one] : one \in Sample(8) }
        \cup { [ZeroFloorTradeNotificationMessage EXCEPT !.putOrCall = one] : one \in Sample(1) }
        \cup { [ZeroFloorTradeNotificationMessage EXCEPT !.strikePrice = one] : one \in Sample(8) }
        \cup { [ZeroFloorTradeNotificationMessage EXCEPT !.maturityDate = one] : one \in Sample(4) }
        \cup { [ZeroFloorTradeNotificationMessage EXCEPT !.orderQtyLong = one] : one \in Sample(4) }
        \cup { [ZeroFloorTradeNotificationMessage EXCEPT !.priceLong = one] : one \in Sample(8) }
        \cup { [ZeroFloorTradeNotificationMessage EXCEPT !.side = one] : one \in Sample(1) }
        \cup { [ZeroFloorTradeNotificationMessage EXCEPT !.contraTrader = one] : one \in Sample(4) }
        \cup { [ZeroFloorTradeNotificationMessage EXCEPT !.floorTraderAcronym = one] : one \in Sample(3) }
        \cup { [ZeroFloorTradeNotificationMessage EXCEPT !.floorTradeTime = one] : one \in Sample(8) }
        \cup { [ZeroFloorTradeNotificationMessage EXCEPT !.tradeThroughAlertType = one] : one \in Sample(1) }
        \cup { [ZeroFloorTradeNotificationMessage EXCEPT !.priceType = one] : one \in Sample(1) }
        \cup { [ZeroFloorTradeNotificationMessage EXCEPT !.reserved15 = one] : one \in Sample(15) }

(***************************************************************************)
(* Add Floor Trade Rejected Message: 196 bytes                             *)
(***************************************************************************)

AddFloorTradeRejectedMessage ==
    [ clOrdId               : Sample(20),
      symbolLong            : Sample(8),
      putOrCall             : Sample(1),
      strikePrice           : Sample(8),
      maturityDate          : Sample(4),
      multilegReportingType : Sample(1),
      comboOrder            : Sample(1),
      account               : Sample(16),
      clearingOptionalData  : Sample(16),
      clearingAccount       : Sample(4),
      cmtaNumber            : Sample(4),
      floorTraderAcronym    : Sample(3),
      side                  : Sample(1),
      orderQtyLong          : Sample(4),
      priceLong             : Sample(8),
      transactionTime       : Sample(8),
      openClose             : Sample(1),
      floorTradeTime        : Sample(8),
      contraTrader          : Sample(4),
      reserved16            : Sample(16),
      rejectText            : Sample(60) ]

EncodeAddFloorTradeRejectedMessage(message) ==
    message.clOrdId
        \o message.symbolLong
        \o message.putOrCall
        \o message.strikePrice
        \o message.maturityDate
        \o message.multilegReportingType
        \o message.comboOrder
        \o message.account
        \o message.clearingOptionalData
        \o message.clearingAccount
        \o message.cmtaNumber
        \o message.floorTraderAcronym
        \o message.side
        \o message.orderQtyLong
        \o message.priceLong
        \o message.transactionTime
        \o message.openClose
        \o message.floorTradeTime
        \o message.contraTrader
        \o message.reserved16
        \o message.rejectText

DecodeAddFloorTradeRejectedMessage(bytes) ==
    LET clOrdId == ReadBytes(bytes, 20) IN IF ~clOrdId.ok THEN Fail ELSE
    LET symbolLong == ReadBytes(clOrdId.rest, 8) IN IF ~symbolLong.ok THEN Fail ELSE
    LET putOrCall == ReadBytes(symbolLong.rest, 1) IN IF ~putOrCall.ok THEN Fail ELSE
    LET strikePrice == ReadBytes(putOrCall.rest, 8) IN IF ~strikePrice.ok THEN Fail ELSE
    LET maturityDate == ReadBytes(strikePrice.rest, 4) IN IF ~maturityDate.ok THEN Fail ELSE
    LET multilegReportingType == ReadBytes(maturityDate.rest, 1) IN IF ~multilegReportingType.ok THEN Fail ELSE
    LET comboOrder == ReadBytes(multilegReportingType.rest, 1) IN IF ~comboOrder.ok THEN Fail ELSE
    LET account == ReadBytes(comboOrder.rest, 16) IN IF ~account.ok THEN Fail ELSE
    LET clearingOptionalData == ReadBytes(account.rest, 16) IN IF ~clearingOptionalData.ok THEN Fail ELSE
    LET clearingAccount == ReadBytes(clearingOptionalData.rest, 4) IN IF ~clearingAccount.ok THEN Fail ELSE
    LET cmtaNumber == ReadBytes(clearingAccount.rest, 4) IN IF ~cmtaNumber.ok THEN Fail ELSE
    LET floorTraderAcronym == ReadBytes(cmtaNumber.rest, 3) IN IF ~floorTraderAcronym.ok THEN Fail ELSE
    LET side == ReadBytes(floorTraderAcronym.rest, 1) IN IF ~side.ok THEN Fail ELSE
