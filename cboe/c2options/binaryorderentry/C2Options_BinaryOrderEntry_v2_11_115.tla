        settled31 == [settled30 EXCEPT !.openClose = IF settled30.numberOfReturnBitfields >= 4 /\ (settled30.cancelRejectedReturnBitfield4 # << >> /\ (settled30.cancelRejectedReturnBitfield4[1] \div 8) % 2 > 0) THEN (IF settled30.openClose = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled30.openClose) ELSE << >>]
        settled32 == [settled31 EXCEPT !.correctedSize = IF settled31.numberOfReturnBitfields >= 4 /\ (settled31.cancelRejectedReturnBitfield4 # << >> /\ (settled31.cancelRejectedReturnBitfield4[1] \div 32) % 2 > 0) THEN (IF settled31.correctedSize = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled31.correctedSize) ELSE << >>]
        settled33 == [settled32 EXCEPT !.echoText = IF settled32.numberOfReturnBitfields >= 8 /\ (settled32.cancelRejectedReturnBitfield8 # << >> /\ (settled32.cancelRejectedReturnBitfield8[1] \div 2) % 2 > 0) THEN (IF settled32.echoText = << >> THEN <<[i \in 1 .. 64 |-> 0]>> ELSE settled32.echoText) ELSE << >>]
        settled34 == [settled33 EXCEPT !.stopPx = IF settled33.numberOfReturnBitfields >= 8 /\ (settled33.cancelRejectedReturnBitfield8 # << >> /\ (settled33.cancelRejectedReturnBitfield8[1] \div 4) % 2 > 0) THEN (IF settled33.stopPx = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled33.stopPx) ELSE << >>]
        settled35 == [settled34 EXCEPT !.marketingFeeCode = IF settled34.numberOfReturnBitfields >= 9 /\ (settled34.cancelRejectedReturnBitfield9 # << >> /\ settled34.cancelRejectedReturnBitfield9[1] % 2 > 0) THEN (IF settled34.marketingFeeCode = << >> THEN <<[i \in 1 .. 2 |-> 0]>> ELSE settled34.marketingFeeCode) ELSE << >>]
        settled36 == [settled35 EXCEPT !.targetPartyId = IF settled35.numberOfReturnBitfields >= 9 /\ (settled35.cancelRejectedReturnBitfield9 # << >> /\ (settled35.cancelRejectedReturnBitfield9[1] \div 2) % 2 > 0) THEN (IF settled35.targetPartyId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled35.targetPartyId) ELSE << >>]
        settled37 == [settled36 EXCEPT !.auctionId = IF settled36.numberOfReturnBitfields >= 9 /\ (settled36.cancelRejectedReturnBitfield9 # << >> /\ (settled36.cancelRejectedReturnBitfield9[1] \div 4) % 2 > 0) THEN (IF settled36.auctionId = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled36.auctionId) ELSE << >>]
        settled38 == [settled37 EXCEPT !.cmtaNumber = IF settled37.numberOfReturnBitfields >= 9 /\ (settled37.cancelRejectedReturnBitfield9 # << >> /\ (settled37.cancelRejectedReturnBitfield9[1] \div 32) % 2 > 0) THEN (IF settled37.cmtaNumber = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled37.cmtaNumber) ELSE << >>]
        settled39 == [settled38 EXCEPT !.crossId = IF settled38.numberOfReturnBitfields >= 10 /\ (settled38.cancelRejectedReturnBitfield10 # << >> /\ settled38.cancelRejectedReturnBitfield10[1] % 2 > 0) THEN (IF settled38.crossId = << >> THEN <<[i \in 1 .. 20 |-> 0]>> ELSE settled38.crossId) ELSE << >>]
        settled40 == [settled39 EXCEPT !.allocQty = IF settled39.numberOfReturnBitfields >= 10 /\ (settled39.cancelRejectedReturnBitfield10 # << >> /\ (settled39.cancelRejectedReturnBitfield10[1] \div 2) % 2 > 0) THEN (IF settled39.allocQty = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled39.allocQty) ELSE << >>]
