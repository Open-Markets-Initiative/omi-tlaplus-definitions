        \cup { SettleOrderCancelledMessage([ZeroOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 3, !.orderCancelledReturnBitfield3 = <<64>>, !.orderQtyLong = one]) : one \in { <<held>> : held \in Sample(4) } }
