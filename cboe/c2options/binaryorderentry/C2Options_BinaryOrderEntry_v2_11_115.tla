        \cup { SettleCancelRejectedMessage([ZeroCancelRejectedMessage EXCEPT !.numberOfReturnBitfields = 10, !.cancelRejectedReturnBitfield10 = <<8>>, !.routingFirmId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleCancelRejectedMessage([ZeroCancelRejectedMessage EXCEPT !.numberOfReturnBitfields = 10, !.cancelRejectedReturnBitfield10 = <<32>>, !.crossExclusionIndicator = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCancelRejectedMessage([ZeroCancelRejectedMessage EXCEPT !.numberOfReturnBitfields = 12, !.cancelRejectedReturnBitfield12 = <<128>>, !.clearingOptionalData = one]) : one \in { <<held>> : held \in Sample(16) } }
        \cup { SettleCancelRejectedMessage([ZeroCancelRejectedMessage EXCEPT !.numberOfReturnBitfields = 15, !.cancelRejectedReturnBitfield15 = <<8>>, !.massCancelId = one]) : one \in { <<held>> : held \in Sample(20) } }
        \cup { SettleCancelRejectedMessage([ZeroCancelRejectedMessage EXCEPT !.numberOfReturnBitfields = 19, !.cancelRejectedReturnBitfield19 = <<64>>, !.stopPxType = one]) : one \in { <<held>> : held \in Sample(1) } }

(***************************************************************************)
(* Order Execution Message                                                 *)
(***************************************************************************)

OrderExecutionMessage ==
    [ transactionTime                : Sample(8),
      clOrdId                        : Sample(20),
      execId                         : Sample(8),
      lastShares                     : Sample(4),
      lastPx                         : Sample(8),
      leavesQty                      : Sample(4),
      baseLiquidityIndicator         : Sample(1),
      subLiquidityIndicator          : Sample(1),
      contraBroker                   : Sample(4),
      reserved1                      : Sample(1),
      numberOfReturnBitfields        : 0 .. 255,
      orderExecutionReturnBitfield1  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderExecutionReturnBitfield2  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderExecutionReturnBitfield3  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderExecutionReturnBitfield4  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderExecutionReturnBitfield5  : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderExecutionReturnBitfield6  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderExecutionReturnBitfield7  : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderExecutionReturnBitfield8  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderExecutionReturnBitfield9  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderExecutionReturnBitfield10 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderExecutionReturnBitfield11 : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderExecutionReturnBitfield12 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderExecutionReturnBitfield13 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderExecutionReturnBitfield14 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderExecutionReturnBitfield15 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderExecutionReturnBitfield16 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderExecutionReturnBitfield17 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderExecutionReturnBitfield18 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderExecutionReturnBitfield19 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderExecutionReturnBitfield20 : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderExecutionReturnBitfield21 : { << >> } \cup { <<held>> : held \in Sample(1) },
      side                           : { << >> } \cup { <<held>> : held \in Sample(1) },
      priceLong                      : { << >> } \cup { <<held>> : held \in Sample(8) },
      execInst                       : { << >> } \cup { <<held>> : held \in Sample(1) },
      ordType                        : { << >> } \cup { <<held>> : held \in Sample(1) },
      timeInForce                    : { << >> } \cup { <<held>> : held \in Sample(1) },
      minQty                         : { << >> } \cup { <<held>> : held \in Sample(4) },
      symbolLong                     : { << >> } \cup { <<held>> : held \in Sample(8) },
      capacity                       : { << >> } \cup { <<held>> : held \in Sample(1) },
      contraTrader                   : { << >> } \cup { <<held>> : held \in Sample(4) },
      account                        : { << >> } \cup { <<held>> : held \in Sample(16) },
      clearingFirm                   : { << >> } \cup { <<held>> : held \in Sample(4) },
      clearingAccount                : { << >> } \cup { <<held>> : held \in Sample(4) },
      displayIndicator               : { << >> } \cup { <<held>> : held \in Sample(1) },
      maxFloor                       : { << >> } \cup { <<held>> : held \in Sample(4) },
      orderQtyLong                   : { << >> } \cup { <<held>> : held \in Sample(4) },
      preventMatch                   : { << >> } \cup { <<held>> : held \in Sample(3) },
      maturityDate                   : { << >> } \cup { <<held>> : held \in Sample(4) },
      strikePrice                    : { << >> } \cup { <<held>> : held \in Sample(8) },
      putOrCall                      : { << >> } \cup { <<held>> : held \in Sample(1) },
      openClose                      : { << >> } \cup { <<held>> : held \in Sample(1) },
      correctedSize                  : { << >> } \cup { <<held>> : held \in Sample(4) },
      contraCapacity                 : { << >> } \cup { <<held>> : held \in Sample(1) },
      attributedQuote                : { << >> } \cup { <<held>> : held \in Sample(1) },
      feeCode                        : { << >> } \cup { <<held>> : held \in Sample(2) },
      echoText                       : { << >> } \cup { <<held>> : held \in Sample(64) },
      stopPx                         : { << >> } \cup { <<held>> : held \in Sample(8) },
      routingInst                    : { << >> } \cup { <<held>> : held \in Sample(4) },
      routStrategy                   : { << >> } \cup { <<held>> : held \in Sample(6) },
      routeDeliveryMethod            : { << >> } \cup { <<held>> : held \in Sample(3) },
      exDestination                  : { << >> } \cup { <<held>> : held \in Sample(1) },
      marketingFeeCode               : { << >> } \cup { <<held>> : held \in Sample(2) },
      targetPartyId                  : { << >> } \cup { <<held>> : held \in Sample(4) },
      auctionId                      : { << >> } \cup { <<held>> : held \in Sample(8) },
      cmtaNumber                     : { << >> } \cup { <<held>> : held \in Sample(4) },
      crossType                      : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossPrioritization            : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossId                        : { << >> } \cup { <<held>> : held \in Sample(20) },
      allocQty                       : { << >> } \cup { <<held>> : held \in Sample(4) },
      giveUpFirmId                   : { << >> } \cup { <<held>> : held \in Sample(4) },
      routingFirmId                  : { << >> } \cup { <<held>> : held \in Sample(4) },
      crossExclusionIndicator        : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeDate                      : { << >> } \cup { <<held>> : held \in Sample(4) },
      clearingOptionalData           : { << >> } \cup { <<held>> : held \in Sample(16) },
      cumQty                         : { << >> } \cup { <<held>> : held \in Sample(4) },
      dayOrderQty                    : { << >> } \cup { <<held>> : held \in Sample(4) },
      dayCumQty                      : { << >> } \cup { <<held>> : held \in Sample(4) },
      avgPx                          : { << >> } \cup { <<held>> : held \in Sample(8) },
      dayAvgPx                       : { << >> } \cup { <<held>> : held \in Sample(8) },
      multilegReportingType          : { << >> } \cup { <<held>> : held \in Sample(1) },
      secondaryExecId                : { << >> } \cup { <<held>> : held \in Sample(8) },
      equityPartyId                  : { << >> } \cup { <<held>> : held \in Sample(4) },
      clientIdAttr                   : { << >> } \cup { <<held>> : held \in Sample(4) },
      frequentTraderId               : { << >> } \cup { <<held>> : held \in Sample(6) },
      comboOrder                     : { << >> } \cup { <<held>> : held \in Sample(1) },
      compression                    : { << >> } \cup { <<held>> : held \in Sample(1) },
      floorDestination               : { << >> } \cup { <<held>> : held \in Sample(4) },
      floorRoutingInst               : { << >> } \cup { <<held>> : held \in Sample(1) },
      multiClassSprd                 : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderOrigin                    : { << >> } \cup { <<held>> : held \in Sample(3) },
      priceType                      : { << >> } \cup { <<held>> : held \in Sample(1) },
      strategyId                     : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeThroughAlertType          : { << >> } \cup { <<held>> : held \in Sample(1) },
      senderLocationId               : { << >> } \cup { <<held>> : held \in Sample(1) },
      execLegCfiCode                 : { << >> } \cup { <<held>> : held \in Sample(6) },
      crossInitiator                 : { << >> } \cup { <<held>> : held \in Sample(4) },
      held                           : { << >> } \cup { <<held>> : held \in Sample(1) },
      floorTradeTime                 : { << >> } \cup { <<held>> : held \in Sample(8) },
      crossOnBehalfOfId              : { << >> } \cup { <<held>> : held \in Sample(4) },
      stopPxType                     : { << >> } \cup { <<held>> : held \in Sample(1) } ]

EncodeOrderExecutionMessage(message) ==
    message.transactionTime
        \o message.clOrdId
        \o message.execId
        \o message.lastShares
        \o message.lastPx
        \o message.leavesQty
        \o message.baseLiquidityIndicator
        \o message.subLiquidityIndicator
        \o message.contraBroker
        \o message.reserved1
        \o EncodeUIntBE(message.numberOfReturnBitfields, 1)
        \o (IF message.orderExecutionReturnBitfield1 = << >> THEN << >> ELSE EncodeUIntLE(message.orderExecutionReturnBitfield1[1], 1))
        \o (IF message.orderExecutionReturnBitfield2 = << >> THEN << >> ELSE EncodeUIntLE(message.orderExecutionReturnBitfield2[1], 1))
        \o (IF message.orderExecutionReturnBitfield3 = << >> THEN << >> ELSE EncodeUIntLE(message.orderExecutionReturnBitfield3[1], 1))
        \o (IF message.orderExecutionReturnBitfield4 = << >> THEN << >> ELSE EncodeUIntLE(message.orderExecutionReturnBitfield4[1], 1))
        \o (IF message.orderExecutionReturnBitfield5 = << >> THEN << >> ELSE message.orderExecutionReturnBitfield5[1])
        \o (IF message.orderExecutionReturnBitfield6 = << >> THEN << >> ELSE EncodeUIntLE(message.orderExecutionReturnBitfield6[1], 1))
        \o (IF message.orderExecutionReturnBitfield7 = << >> THEN << >> ELSE message.orderExecutionReturnBitfield7[1])
        \o (IF message.orderExecutionReturnBitfield8 = << >> THEN << >> ELSE EncodeUIntLE(message.orderExecutionReturnBitfield8[1], 1))
        \o (IF message.orderExecutionReturnBitfield9 = << >> THEN << >> ELSE EncodeUIntLE(message.orderExecutionReturnBitfield9[1], 1))
        \o (IF message.orderExecutionReturnBitfield10 = << >> THEN << >> ELSE EncodeUIntLE(message.orderExecutionReturnBitfield10[1], 1))
        \o (IF message.orderExecutionReturnBitfield11 = << >> THEN << >> ELSE message.orderExecutionReturnBitfield11[1])
        \o (IF message.orderExecutionReturnBitfield12 = << >> THEN << >> ELSE EncodeUIntLE(message.orderExecutionReturnBitfield12[1], 1))
        \o (IF message.orderExecutionReturnBitfield13 = << >> THEN << >> ELSE EncodeUIntLE(message.orderExecutionReturnBitfield13[1], 1))
        \o (IF message.orderExecutionReturnBitfield14 = << >> THEN << >> ELSE EncodeUIntLE(message.orderExecutionReturnBitfield14[1], 1))
        \o (IF message.orderExecutionReturnBitfield15 = << >> THEN << >> ELSE EncodeUIntLE(message.orderExecutionReturnBitfield15[1], 1))
        \o (IF message.orderExecutionReturnBitfield16 = << >> THEN << >> ELSE EncodeUIntLE(message.orderExecutionReturnBitfield16[1], 1))
        \o (IF message.orderExecutionReturnBitfield17 = << >> THEN << >> ELSE EncodeUIntLE(message.orderExecutionReturnBitfield17[1], 1))
        \o (IF message.orderExecutionReturnBitfield18 = << >> THEN << >> ELSE EncodeUIntLE(message.orderExecutionReturnBitfield18[1], 1))
        \o (IF message.orderExecutionReturnBitfield19 = << >> THEN << >> ELSE EncodeUIntLE(message.orderExecutionReturnBitfield19[1], 1))
        \o (IF message.orderExecutionReturnBitfield20 = << >> THEN << >> ELSE message.orderExecutionReturnBitfield20[1])
        \o (IF message.orderExecutionReturnBitfield21 = << >> THEN << >> ELSE message.orderExecutionReturnBitfield21[1])
        \o (IF message.side = << >> THEN << >> ELSE message.side[1])
        \o (IF message.priceLong = << >> THEN << >> ELSE message.priceLong[1])
        \o (IF message.execInst = << >> THEN << >> ELSE message.execInst[1])
        \o (IF message.ordType = << >> THEN << >> ELSE message.ordType[1])
        \o (IF message.timeInForce = << >> THEN << >> ELSE message.timeInForce[1])
        \o (IF message.minQty = << >> THEN << >> ELSE message.minQty[1])
        \o (IF message.symbolLong = << >> THEN << >> ELSE message.symbolLong[1])
        \o (IF message.capacity = << >> THEN << >> ELSE message.capacity[1])
        \o (IF message.contraTrader = << >> THEN << >> ELSE message.contraTrader[1])
        \o (IF message.account = << >> THEN << >> ELSE message.account[1])
        \o (IF message.clearingFirm = << >> THEN << >> ELSE message.clearingFirm[1])
        \o (IF message.clearingAccount = << >> THEN << >> ELSE message.clearingAccount[1])
        \o (IF message.displayIndicator = << >> THEN << >> ELSE message.displayIndicator[1])
        \o (IF message.maxFloor = << >> THEN << >> ELSE message.maxFloor[1])
        \o (IF message.orderQtyLong = << >> THEN << >> ELSE message.orderQtyLong[1])
        \o (IF message.preventMatch = << >> THEN << >> ELSE message.preventMatch[1])
        \o (IF message.maturityDate = << >> THEN << >> ELSE message.maturityDate[1])
        \o (IF message.strikePrice = << >> THEN << >> ELSE message.strikePrice[1])
        \o (IF message.putOrCall = << >> THEN << >> ELSE message.putOrCall[1])
        \o (IF message.openClose = << >> THEN << >> ELSE message.openClose[1])
        \o (IF message.correctedSize = << >> THEN << >> ELSE message.correctedSize[1])
        \o (IF message.contraCapacity = << >> THEN << >> ELSE message.contraCapacity[1])
        \o (IF message.attributedQuote = << >> THEN << >> ELSE message.attributedQuote[1])
        \o (IF message.feeCode = << >> THEN << >> ELSE message.feeCode[1])
        \o (IF message.echoText = << >> THEN << >> ELSE message.echoText[1])
        \o (IF message.stopPx = << >> THEN << >> ELSE message.stopPx[1])
        \o (IF message.routingInst = << >> THEN << >> ELSE message.routingInst[1])
        \o (IF message.routStrategy = << >> THEN << >> ELSE message.routStrategy[1])
        \o (IF message.routeDeliveryMethod = << >> THEN << >> ELSE message.routeDeliveryMethod[1])
        \o (IF message.exDestination = << >> THEN << >> ELSE message.exDestination[1])
        \o (IF message.marketingFeeCode = << >> THEN << >> ELSE message.marketingFeeCode[1])
        \o (IF message.targetPartyId = << >> THEN << >> ELSE message.targetPartyId[1])
        \o (IF message.auctionId = << >> THEN << >> ELSE message.auctionId[1])
        \o (IF message.cmtaNumber = << >> THEN << >> ELSE message.cmtaNumber[1])
        \o (IF message.crossType = << >> THEN << >> ELSE message.crossType[1])
        \o (IF message.crossPrioritization = << >> THEN << >> ELSE message.crossPrioritization[1])
        \o (IF message.crossId = << >> THEN << >> ELSE message.crossId[1])
        \o (IF message.allocQty = << >> THEN << >> ELSE message.allocQty[1])
        \o (IF message.giveUpFirmId = << >> THEN << >> ELSE message.giveUpFirmId[1])
        \o (IF message.routingFirmId = << >> THEN << >> ELSE message.routingFirmId[1])
        \o (IF message.crossExclusionIndicator = << >> THEN << >> ELSE message.crossExclusionIndicator[1])
        \o (IF message.tradeDate = << >> THEN << >> ELSE message.tradeDate[1])
        \o (IF message.clearingOptionalData = << >> THEN << >> ELSE message.clearingOptionalData[1])
        \o (IF message.cumQty = << >> THEN << >> ELSE message.cumQty[1])
        \o (IF message.dayOrderQty = << >> THEN << >> ELSE message.dayOrderQty[1])
        \o (IF message.dayCumQty = << >> THEN << >> ELSE message.dayCumQty[1])
        \o (IF message.avgPx = << >> THEN << >> ELSE message.avgPx[1])
        \o (IF message.dayAvgPx = << >> THEN << >> ELSE message.dayAvgPx[1])
        \o (IF message.multilegReportingType = << >> THEN << >> ELSE message.multilegReportingType[1])
        \o (IF message.secondaryExecId = << >> THEN << >> ELSE message.secondaryExecId[1])
        \o (IF message.equityPartyId = << >> THEN << >> ELSE message.equityPartyId[1])
        \o (IF message.clientIdAttr = << >> THEN << >> ELSE message.clientIdAttr[1])
        \o (IF message.frequentTraderId = << >> THEN << >> ELSE message.frequentTraderId[1])
        \o (IF message.comboOrder = << >> THEN << >> ELSE message.comboOrder[1])
        \o (IF message.compression = << >> THEN << >> ELSE message.compression[1])
        \o (IF message.floorDestination = << >> THEN << >> ELSE message.floorDestination[1])
        \o (IF message.floorRoutingInst = << >> THEN << >> ELSE message.floorRoutingInst[1])
        \o (IF message.multiClassSprd = << >> THEN << >> ELSE message.multiClassSprd[1])
        \o (IF message.orderOrigin = << >> THEN << >> ELSE message.orderOrigin[1])
        \o (IF message.priceType = << >> THEN << >> ELSE message.priceType[1])
        \o (IF message.strategyId = << >> THEN << >> ELSE message.strategyId[1])
        \o (IF message.tradeThroughAlertType = << >> THEN << >> ELSE message.tradeThroughAlertType[1])
        \o (IF message.senderLocationId = << >> THEN << >> ELSE message.senderLocationId[1])
        \o (IF message.execLegCfiCode = << >> THEN << >> ELSE message.execLegCfiCode[1])
        \o (IF message.crossInitiator = << >> THEN << >> ELSE message.crossInitiator[1])
        \o (IF message.held = << >> THEN << >> ELSE message.held[1])
        \o (IF message.floorTradeTime = << >> THEN << >> ELSE message.floorTradeTime[1])
        \o (IF message.crossOnBehalfOfId = << >> THEN << >> ELSE message.crossOnBehalfOfId[1])
        \o (IF message.stopPxType = << >> THEN << >> ELSE message.stopPxType[1])

DecodeOrderExecutionMessage(bytes) ==
    LET transactionTime == ReadBytes(bytes, 8) IN IF ~transactionTime.ok THEN Fail ELSE
    LET clOrdId == ReadBytes(transactionTime.rest, 20) IN IF ~clOrdId.ok THEN Fail ELSE
    LET execId == ReadBytes(clOrdId.rest, 8) IN IF ~execId.ok THEN Fail ELSE
    LET lastShares == ReadBytes(execId.rest, 4) IN IF ~lastShares.ok THEN Fail ELSE
    LET lastPx == ReadBytes(lastShares.rest, 8) IN IF ~lastPx.ok THEN Fail ELSE
    LET leavesQty == ReadBytes(lastPx.rest, 4) IN IF ~leavesQty.ok THEN Fail ELSE
    LET baseLiquidityIndicator == ReadBytes(leavesQty.rest, 1) IN IF ~baseLiquidityIndicator.ok THEN Fail ELSE
    LET subLiquidityIndicator == ReadBytes(baseLiquidityIndicator.rest, 1) IN IF ~subLiquidityIndicator.ok THEN Fail ELSE
    LET contraBroker == ReadBytes(subLiquidityIndicator.rest, 4) IN IF ~contraBroker.ok THEN Fail ELSE
    LET reserved1 == ReadBytes(contraBroker.rest, 1) IN IF ~reserved1.ok THEN Fail ELSE
    LET numberOfReturnBitfields == ReadUIntBE(reserved1.rest, 1) IN IF ~numberOfReturnBitfields.ok THEN Fail ELSE
    LET orderExecutionReturnBitfield1 == ReadWhen(numberOfReturnBitfields.value >= 1, ReadUIntLE(numberOfReturnBitfields.rest, 1), numberOfReturnBitfields.rest) IN IF ~orderExecutionReturnBitfield1.ok THEN Fail ELSE
    LET orderExecutionReturnBitfield2 == ReadWhen(numberOfReturnBitfields.value >= 2, ReadUIntLE(orderExecutionReturnBitfield1.rest, 1), orderExecutionReturnBitfield1.rest) IN IF ~orderExecutionReturnBitfield2.ok THEN Fail ELSE
    LET orderExecutionReturnBitfield3 == ReadWhen(numberOfReturnBitfields.value >= 3, ReadUIntLE(orderExecutionReturnBitfield2.rest, 1), orderExecutionReturnBitfield2.rest) IN IF ~orderExecutionReturnBitfield3.ok THEN Fail ELSE
    LET orderExecutionReturnBitfield4 == ReadWhen(numberOfReturnBitfields.value >= 4, ReadUIntLE(orderExecutionReturnBitfield3.rest, 1), orderExecutionReturnBitfield3.rest) IN IF ~orderExecutionReturnBitfield4.ok THEN Fail ELSE
    LET orderExecutionReturnBitfield5 == ReadWhen(numberOfReturnBitfields.value >= 5, ReadBytes(orderExecutionReturnBitfield4.rest, 1), orderExecutionReturnBitfield4.rest) IN IF ~orderExecutionReturnBitfield5.ok THEN Fail ELSE
    LET orderExecutionReturnBitfield6 == ReadWhen(numberOfReturnBitfields.value >= 6, ReadUIntLE(orderExecutionReturnBitfield5.rest, 1), orderExecutionReturnBitfield5.rest) IN IF ~orderExecutionReturnBitfield6.ok THEN Fail ELSE
    LET orderExecutionReturnBitfield7 == ReadWhen(numberOfReturnBitfields.value >= 7, ReadBytes(orderExecutionReturnBitfield6.rest, 1), orderExecutionReturnBitfield6.rest) IN IF ~orderExecutionReturnBitfield7.ok THEN Fail ELSE
    LET orderExecutionReturnBitfield8 == ReadWhen(numberOfReturnBitfields.value >= 8, ReadUIntLE(orderExecutionReturnBitfield7.rest, 1), orderExecutionReturnBitfield7.rest) IN IF ~orderExecutionReturnBitfield8.ok THEN Fail ELSE
    LET orderExecutionReturnBitfield9 == ReadWhen(numberOfReturnBitfields.value >= 9, ReadUIntLE(orderExecutionReturnBitfield8.rest, 1), orderExecutionReturnBitfield8.rest) IN IF ~orderExecutionReturnBitfield9.ok THEN Fail ELSE
    LET orderExecutionReturnBitfield10 == ReadWhen(numberOfReturnBitfields.value >= 10, ReadUIntLE(orderExecutionReturnBitfield9.rest, 1), orderExecutionReturnBitfield9.rest) IN IF ~orderExecutionReturnBitfield10.ok THEN Fail ELSE
    LET orderExecutionReturnBitfield11 == ReadWhen(numberOfReturnBitfields.value >= 11, ReadBytes(orderExecutionReturnBitfield10.rest, 1), orderExecutionReturnBitfield10.rest) IN IF ~orderExecutionReturnBitfield11.ok THEN Fail ELSE
    LET orderExecutionReturnBitfield12 == ReadWhen(numberOfReturnBitfields.value >= 12, ReadUIntLE(orderExecutionReturnBitfield11.rest, 1), orderExecutionReturnBitfield11.rest) IN IF ~orderExecutionReturnBitfield12.ok THEN Fail ELSE
    LET orderExecutionReturnBitfield13 == ReadWhen(numberOfReturnBitfields.value >= 13, ReadUIntLE(orderExecutionReturnBitfield12.rest, 1), orderExecutionReturnBitfield12.rest) IN IF ~orderExecutionReturnBitfield13.ok THEN Fail ELSE
    LET orderExecutionReturnBitfield14 == ReadWhen(numberOfReturnBitfields.value >= 14, ReadUIntLE(orderExecutionReturnBitfield13.rest, 1), orderExecutionReturnBitfield13.rest) IN IF ~orderExecutionReturnBitfield14.ok THEN Fail ELSE
    LET orderExecutionReturnBitfield15 == ReadWhen(numberOfReturnBitfields.value >= 15, ReadUIntLE(orderExecutionReturnBitfield14.rest, 1), orderExecutionReturnBitfield14.rest) IN IF ~orderExecutionReturnBitfield15.ok THEN Fail ELSE
    LET orderExecutionReturnBitfield16 == ReadWhen(numberOfReturnBitfields.value >= 16, ReadUIntLE(orderExecutionReturnBitfield15.rest, 1), orderExecutionReturnBitfield15.rest) IN IF ~orderExecutionReturnBitfield16.ok THEN Fail ELSE
    LET orderExecutionReturnBitfield17 == ReadWhen(numberOfReturnBitfields.value >= 17, ReadUIntLE(orderExecutionReturnBitfield16.rest, 1), orderExecutionReturnBitfield16.rest) IN IF ~orderExecutionReturnBitfield17.ok THEN Fail ELSE
    LET orderExecutionReturnBitfield18 == ReadWhen(numberOfReturnBitfields.value >= 18, ReadUIntLE(orderExecutionReturnBitfield17.rest, 1), orderExecutionReturnBitfield17.rest) IN IF ~orderExecutionReturnBitfield18.ok THEN Fail ELSE
    LET orderExecutionReturnBitfield19 == ReadWhen(numberOfReturnBitfields.value >= 19, ReadUIntLE(orderExecutionReturnBitfield18.rest, 1), orderExecutionReturnBitfield18.rest) IN IF ~orderExecutionReturnBitfield19.ok THEN Fail ELSE
    LET orderExecutionReturnBitfield20 == ReadWhen(numberOfReturnBitfields.value >= 20, ReadBytes(orderExecutionReturnBitfield19.rest, 1), orderExecutionReturnBitfield19.rest) IN IF ~orderExecutionReturnBitfield20.ok THEN Fail ELSE
    LET orderExecutionReturnBitfield21 == ReadWhen(numberOfReturnBitfields.value >= 21, ReadBytes(orderExecutionReturnBitfield20.rest, 1), orderExecutionReturnBitfield20.rest) IN IF ~orderExecutionReturnBitfield21.ok THEN Fail ELSE
    LET side == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderExecutionReturnBitfield1.value # << >> /\ orderExecutionReturnBitfield1.value[1] % 2 > 0), ReadBytes(orderExecutionReturnBitfield21.rest, 1), orderExecutionReturnBitfield21.rest) IN IF ~side.ok THEN Fail ELSE
    LET priceLong == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderExecutionReturnBitfield1.value # << >> /\ (orderExecutionReturnBitfield1.value[1] \div 4) % 2 > 0), ReadBytes(side.rest, 8), side.rest) IN IF ~priceLong.ok THEN Fail ELSE
    LET execInst == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderExecutionReturnBitfield1.value # << >> /\ (orderExecutionReturnBitfield1.value[1] \div 8) % 2 > 0), ReadBytes(priceLong.rest, 1), priceLong.rest) IN IF ~execInst.ok THEN Fail ELSE
    LET ordType == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderExecutionReturnBitfield1.value # << >> /\ (orderExecutionReturnBitfield1.value[1] \div 16) % 2 > 0), ReadBytes(execInst.rest, 1), execInst.rest) IN IF ~ordType.ok THEN Fail ELSE
    LET timeInForce == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderExecutionReturnBitfield1.value # << >> /\ (orderExecutionReturnBitfield1.value[1] \div 32) % 2 > 0), ReadBytes(ordType.rest, 1), ordType.rest) IN IF ~timeInForce.ok THEN Fail ELSE
    LET minQty == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderExecutionReturnBitfield1.value # << >> /\ (orderExecutionReturnBitfield1.value[1] \div 64) % 2 > 0), ReadBytes(timeInForce.rest, 4), timeInForce.rest) IN IF ~minQty.ok THEN Fail ELSE
    LET symbolLong == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (orderExecutionReturnBitfield2.value # << >> /\ orderExecutionReturnBitfield2.value[1] % 2 > 0), ReadBytes(minQty.rest, 8), minQty.rest) IN IF ~symbolLong.ok THEN Fail ELSE
    LET capacity == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (orderExecutionReturnBitfield2.value # << >> /\ (orderExecutionReturnBitfield2.value[1] \div 64) % 2 > 0), ReadBytes(symbolLong.rest, 1), symbolLong.rest) IN IF ~capacity.ok THEN Fail ELSE
    LET contraTrader == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (orderExecutionReturnBitfield2.value # << >> /\ (orderExecutionReturnBitfield2.value[1] \div 128) % 2 > 0), ReadBytes(capacity.rest, 4), capacity.rest) IN IF ~contraTrader.ok THEN Fail ELSE
    LET account == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderExecutionReturnBitfield3.value # << >> /\ orderExecutionReturnBitfield3.value[1] % 2 > 0), ReadBytes(contraTrader.rest, 16), contraTrader.rest) IN IF ~account.ok THEN Fail ELSE
    LET clearingFirm == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderExecutionReturnBitfield3.value # << >> /\ (orderExecutionReturnBitfield3.value[1] \div 2) % 2 > 0), ReadBytes(account.rest, 4), account.rest) IN IF ~clearingFirm.ok THEN Fail ELSE
    LET clearingAccount == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderExecutionReturnBitfield3.value # << >> /\ (orderExecutionReturnBitfield3.value[1] \div 4) % 2 > 0), ReadBytes(clearingFirm.rest, 4), clearingFirm.rest) IN IF ~clearingAccount.ok THEN Fail ELSE
    LET displayIndicator == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderExecutionReturnBitfield3.value # << >> /\ (orderExecutionReturnBitfield3.value[1] \div 8) % 2 > 0), ReadBytes(clearingAccount.rest, 1), clearingAccount.rest) IN IF ~displayIndicator.ok THEN Fail ELSE
    LET maxFloor == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderExecutionReturnBitfield3.value # << >> /\ (orderExecutionReturnBitfield3.value[1] \div 16) % 2 > 0), ReadBytes(displayIndicator.rest, 4), displayIndicator.rest) IN IF ~maxFloor.ok THEN Fail ELSE
    LET orderQtyLong == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderExecutionReturnBitfield3.value # << >> /\ (orderExecutionReturnBitfield3.value[1] \div 64) % 2 > 0), ReadBytes(maxFloor.rest, 4), maxFloor.rest) IN IF ~orderQtyLong.ok THEN Fail ELSE
    LET preventMatch == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderExecutionReturnBitfield3.value # << >> /\ (orderExecutionReturnBitfield3.value[1] \div 128) % 2 > 0), ReadBytes(orderQtyLong.rest, 3), orderQtyLong.rest) IN IF ~preventMatch.ok THEN Fail ELSE
    LET maturityDate == ReadWhen(numberOfReturnBitfields.value >= 4 /\ (orderExecutionReturnBitfield4.value # << >> /\ orderExecutionReturnBitfield4.value[1] % 2 > 0), ReadBytes(preventMatch.rest, 4), preventMatch.rest) IN IF ~maturityDate.ok THEN Fail ELSE
    LET strikePrice == ReadWhen(numberOfReturnBitfields.value >= 4 /\ (orderExecutionReturnBitfield4.value # << >> /\ (orderExecutionReturnBitfield4.value[1] \div 2) % 2 > 0), ReadBytes(maturityDate.rest, 8), maturityDate.rest) IN IF ~strikePrice.ok THEN Fail ELSE
    LET putOrCall == ReadWhen(numberOfReturnBitfields.value >= 4 /\ (orderExecutionReturnBitfield4.value # << >> /\ (orderExecutionReturnBitfield4.value[1] \div 4) % 2 > 0), ReadBytes(strikePrice.rest, 1), strikePrice.rest) IN IF ~putOrCall.ok THEN Fail ELSE
    LET openClose == ReadWhen(numberOfReturnBitfields.value >= 4 /\ (orderExecutionReturnBitfield4.value # << >> /\ (orderExecutionReturnBitfield4.value[1] \div 8) % 2 > 0), ReadBytes(putOrCall.rest, 1), putOrCall.rest) IN IF ~openClose.ok THEN Fail ELSE
    LET correctedSize == ReadWhen(numberOfReturnBitfields.value >= 4 /\ (orderExecutionReturnBitfield4.value # << >> /\ (orderExecutionReturnBitfield4.value[1] \div 32) % 2 > 0), ReadBytes(openClose.rest, 4), openClose.rest) IN IF ~correctedSize.ok THEN Fail ELSE
    LET contraCapacity == ReadWhen(numberOfReturnBitfields.value >= 6 /\ (orderExecutionReturnBitfield6.value # << >> /\ (orderExecutionReturnBitfield6.value[1] \div 4) % 2 > 0), ReadBytes(correctedSize.rest, 1), correctedSize.rest) IN IF ~contraCapacity.ok THEN Fail ELSE
    LET attributedQuote == ReadWhen(numberOfReturnBitfields.value >= 6 /\ (orderExecutionReturnBitfield6.value # << >> /\ (orderExecutionReturnBitfield6.value[1] \div 8) % 2 > 0), ReadBytes(contraCapacity.rest, 1), contraCapacity.rest) IN IF ~attributedQuote.ok THEN Fail ELSE
    LET feeCode == ReadWhen(numberOfReturnBitfields.value >= 8 /\ (orderExecutionReturnBitfield8.value # << >> /\ orderExecutionReturnBitfield8.value[1] % 2 > 0), ReadBytes(attributedQuote.rest, 2), attributedQuote.rest) IN IF ~feeCode.ok THEN Fail ELSE
    LET echoText == ReadWhen(numberOfReturnBitfields.value >= 8 /\ (orderExecutionReturnBitfield8.value # << >> /\ (orderExecutionReturnBitfield8.value[1] \div 2) % 2 > 0), ReadBytes(feeCode.rest, 64), feeCode.rest) IN IF ~echoText.ok THEN Fail ELSE
    LET stopPx == ReadWhen(numberOfReturnBitfields.value >= 8 /\ (orderExecutionReturnBitfield8.value # << >> /\ (orderExecutionReturnBitfield8.value[1] \div 4) % 2 > 0), ReadBytes(echoText.rest, 8), echoText.rest) IN IF ~stopPx.ok THEN Fail ELSE
    LET routingInst == ReadWhen(numberOfReturnBitfields.value >= 8 /\ (orderExecutionReturnBitfield8.value # << >> /\ (orderExecutionReturnBitfield8.value[1] \div 8) % 2 > 0), ReadBytes(stopPx.rest, 4), stopPx.rest) IN IF ~routingInst.ok THEN Fail ELSE
    LET routStrategy == ReadWhen(numberOfReturnBitfields.value >= 8 /\ (orderExecutionReturnBitfield8.value # << >> /\ (orderExecutionReturnBitfield8.value[1] \div 16) % 2 > 0), ReadBytes(routingInst.rest, 6), routingInst.rest) IN IF ~routStrategy.ok THEN Fail ELSE
    LET routeDeliveryMethod == ReadWhen(numberOfReturnBitfields.value >= 8 /\ (orderExecutionReturnBitfield8.value # << >> /\ (orderExecutionReturnBitfield8.value[1] \div 32) % 2 > 0), ReadBytes(routStrategy.rest, 3), routStrategy.rest) IN IF ~routeDeliveryMethod.ok THEN Fail ELSE
    LET exDestination == ReadWhen(numberOfReturnBitfields.value >= 8 /\ (orderExecutionReturnBitfield8.value # << >> /\ (orderExecutionReturnBitfield8.value[1] \div 64) % 2 > 0), ReadBytes(routeDeliveryMethod.rest, 1), routeDeliveryMethod.rest) IN IF ~exDestination.ok THEN Fail ELSE
    LET marketingFeeCode == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (orderExecutionReturnBitfield9.value # << >> /\ orderExecutionReturnBitfield9.value[1] % 2 > 0), ReadBytes(exDestination.rest, 2), exDestination.rest) IN IF ~marketingFeeCode.ok THEN Fail ELSE
    LET targetPartyId == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (orderExecutionReturnBitfield9.value # << >> /\ (orderExecutionReturnBitfield9.value[1] \div 2) % 2 > 0), ReadBytes(marketingFeeCode.rest, 4), marketingFeeCode.rest) IN IF ~targetPartyId.ok THEN Fail ELSE
    LET auctionId == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (orderExecutionReturnBitfield9.value # << >> /\ (orderExecutionReturnBitfield9.value[1] \div 4) % 2 > 0), ReadBytes(targetPartyId.rest, 8), targetPartyId.rest) IN IF ~auctionId.ok THEN Fail ELSE
    LET cmtaNumber == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (orderExecutionReturnBitfield9.value # << >> /\ (orderExecutionReturnBitfield9.value[1] \div 32) % 2 > 0), ReadBytes(auctionId.rest, 4), auctionId.rest) IN IF ~cmtaNumber.ok THEN Fail ELSE
    LET crossType == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (orderExecutionReturnBitfield9.value # << >> /\ (orderExecutionReturnBitfield9.value[1] \div 64) % 2 > 0), ReadBytes(cmtaNumber.rest, 1), cmtaNumber.rest) IN IF ~crossType.ok THEN Fail ELSE
    LET crossPrioritization == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (orderExecutionReturnBitfield9.value # << >> /\ (orderExecutionReturnBitfield9.value[1] \div 128) % 2 > 0), ReadBytes(crossType.rest, 1), crossType.rest) IN IF ~crossPrioritization.ok THEN Fail ELSE
    LET crossId == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (orderExecutionReturnBitfield10.value # << >> /\ orderExecutionReturnBitfield10.value[1] % 2 > 0), ReadBytes(crossPrioritization.rest, 20), crossPrioritization.rest) IN IF ~crossId.ok THEN Fail ELSE
    LET allocQty == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (orderExecutionReturnBitfield10.value # << >> /\ (orderExecutionReturnBitfield10.value[1] \div 2) % 2 > 0), ReadBytes(crossId.rest, 4), crossId.rest) IN IF ~allocQty.ok THEN Fail ELSE
    LET giveUpFirmId == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (orderExecutionReturnBitfield10.value # << >> /\ (orderExecutionReturnBitfield10.value[1] \div 4) % 2 > 0), ReadBytes(allocQty.rest, 4), allocQty.rest) IN IF ~giveUpFirmId.ok THEN Fail ELSE
    LET routingFirmId == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (orderExecutionReturnBitfield10.value # << >> /\ (orderExecutionReturnBitfield10.value[1] \div 8) % 2 > 0), ReadBytes(giveUpFirmId.rest, 4), giveUpFirmId.rest) IN IF ~routingFirmId.ok THEN Fail ELSE
    LET crossExclusionIndicator == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (orderExecutionReturnBitfield10.value # << >> /\ (orderExecutionReturnBitfield10.value[1] \div 32) % 2 > 0), ReadBytes(routingFirmId.rest, 1), routingFirmId.rest) IN IF ~crossExclusionIndicator.ok THEN Fail ELSE
    LET tradeDate == ReadWhen(numberOfReturnBitfields.value >= 12 /\ (orderExecutionReturnBitfield12.value # << >> /\ (orderExecutionReturnBitfield12.value[1] \div 8) % 2 > 0), ReadBytes(crossExclusionIndicator.rest, 4), crossExclusionIndicator.rest) IN IF ~tradeDate.ok THEN Fail ELSE
    LET clearingOptionalData == ReadWhen(numberOfReturnBitfields.value >= 12 /\ (orderExecutionReturnBitfield12.value # << >> /\ (orderExecutionReturnBitfield12.value[1] \div 128) % 2 > 0), ReadBytes(tradeDate.rest, 16), tradeDate.rest) IN IF ~clearingOptionalData.ok THEN Fail ELSE
    LET cumQty == ReadWhen(numberOfReturnBitfields.value >= 13 /\ (orderExecutionReturnBitfield13.value # << >> /\ orderExecutionReturnBitfield13.value[1] % 2 > 0), ReadBytes(clearingOptionalData.rest, 4), clearingOptionalData.rest) IN IF ~cumQty.ok THEN Fail ELSE
    LET dayOrderQty == ReadWhen(numberOfReturnBitfields.value >= 13 /\ (orderExecutionReturnBitfield13.value # << >> /\ (orderExecutionReturnBitfield13.value[1] \div 2) % 2 > 0), ReadBytes(cumQty.rest, 4), cumQty.rest) IN IF ~dayOrderQty.ok THEN Fail ELSE
    LET dayCumQty == ReadWhen(numberOfReturnBitfields.value >= 13 /\ (orderExecutionReturnBitfield13.value # << >> /\ (orderExecutionReturnBitfield13.value[1] \div 4) % 2 > 0), ReadBytes(dayOrderQty.rest, 4), dayOrderQty.rest) IN IF ~dayCumQty.ok THEN Fail ELSE
    LET avgPx == ReadWhen(numberOfReturnBitfields.value >= 13 /\ (orderExecutionReturnBitfield13.value # << >> /\ (orderExecutionReturnBitfield13.value[1] \div 8) % 2 > 0), ReadBytes(dayCumQty.rest, 8), dayCumQty.rest) IN IF ~avgPx.ok THEN Fail ELSE
    LET dayAvgPx == ReadWhen(numberOfReturnBitfields.value >= 13 /\ (orderExecutionReturnBitfield13.value # << >> /\ (orderExecutionReturnBitfield13.value[1] \div 16) % 2 > 0), ReadBytes(avgPx.rest, 8), avgPx.rest) IN IF ~dayAvgPx.ok THEN Fail ELSE
    LET multilegReportingType == ReadWhen(numberOfReturnBitfields.value >= 13 /\ (orderExecutionReturnBitfield13.value # << >> /\ (orderExecutionReturnBitfield13.value[1] \div 128) % 2 > 0), ReadBytes(dayAvgPx.rest, 1), dayAvgPx.rest) IN IF ~multilegReportingType.ok THEN Fail ELSE
    LET secondaryExecId == ReadWhen(numberOfReturnBitfields.value >= 14 /\ (orderExecutionReturnBitfield14.value # << >> /\ (orderExecutionReturnBitfield14.value[1] \div 16) % 2 > 0), ReadBytes(multilegReportingType.rest, 8), multilegReportingType.rest) IN IF ~secondaryExecId.ok THEN Fail ELSE
    LET equityPartyId == ReadWhen(numberOfReturnBitfields.value >= 15 /\ (orderExecutionReturnBitfield15.value # << >> /\ (orderExecutionReturnBitfield15.value[1] \div 2) % 2 > 0), ReadBytes(secondaryExecId.rest, 4), secondaryExecId.rest) IN IF ~equityPartyId.ok THEN Fail ELSE
    LET clientIdAttr == ReadWhen(numberOfReturnBitfields.value >= 15 /\ (orderExecutionReturnBitfield15.value # << >> /\ (orderExecutionReturnBitfield15.value[1] \div 128) % 2 > 0), ReadBytes(equityPartyId.rest, 4), equityPartyId.rest) IN IF ~clientIdAttr.ok THEN Fail ELSE
    LET frequentTraderId == ReadWhen(numberOfReturnBitfields.value >= 16 /\ (orderExecutionReturnBitfield16.value # << >> /\ orderExecutionReturnBitfield16.value[1] % 2 > 0), ReadBytes(clientIdAttr.rest, 6), clientIdAttr.rest) IN IF ~frequentTraderId.ok THEN Fail ELSE
    LET comboOrder == ReadWhen(numberOfReturnBitfields.value >= 16 /\ (orderExecutionReturnBitfield16.value # << >> /\ (orderExecutionReturnBitfield16.value[1] \div 4) % 2 > 0), ReadBytes(frequentTraderId.rest, 1), frequentTraderId.rest) IN IF ~comboOrder.ok THEN Fail ELSE
    LET compression == ReadWhen(numberOfReturnBitfields.value >= 16 /\ (orderExecutionReturnBitfield16.value # << >> /\ (orderExecutionReturnBitfield16.value[1] \div 8) % 2 > 0), ReadBytes(comboOrder.rest, 1), comboOrder.rest) IN IF ~compression.ok THEN Fail ELSE
    LET floorDestination == ReadWhen(numberOfReturnBitfields.value >= 16 /\ (orderExecutionReturnBitfield16.value # << >> /\ (orderExecutionReturnBitfield16.value[1] \div 16) % 2 > 0), ReadBytes(compression.rest, 4), compression.rest) IN IF ~floorDestination.ok THEN Fail ELSE
    LET floorRoutingInst == ReadWhen(numberOfReturnBitfields.value >= 16 /\ (orderExecutionReturnBitfield16.value # << >> /\ (orderExecutionReturnBitfield16.value[1] \div 32) % 2 > 0), ReadBytes(floorDestination.rest, 1), floorDestination.rest) IN IF ~floorRoutingInst.ok THEN Fail ELSE
    LET multiClassSprd == ReadWhen(numberOfReturnBitfields.value >= 16 /\ (orderExecutionReturnBitfield16.value # << >> /\ (orderExecutionReturnBitfield16.value[1] \div 64) % 2 > 0), ReadBytes(floorRoutingInst.rest, 1), floorRoutingInst.rest) IN IF ~multiClassSprd.ok THEN Fail ELSE
    LET orderOrigin == ReadWhen(numberOfReturnBitfields.value >= 16 /\ (orderExecutionReturnBitfield16.value # << >> /\ (orderExecutionReturnBitfield16.value[1] \div 128) % 2 > 0), ReadBytes(multiClassSprd.rest, 3), multiClassSprd.rest) IN IF ~orderOrigin.ok THEN Fail ELSE
    LET priceType == ReadWhen(numberOfReturnBitfields.value >= 17 /\ (orderExecutionReturnBitfield17.value # << >> /\ orderExecutionReturnBitfield17.value[1] % 2 > 0), ReadBytes(orderOrigin.rest, 1), orderOrigin.rest) IN IF ~priceType.ok THEN Fail ELSE
    LET strategyId == ReadWhen(numberOfReturnBitfields.value >= 17 /\ (orderExecutionReturnBitfield17.value # << >> /\ (orderExecutionReturnBitfield17.value[1] \div 2) % 2 > 0), ReadBytes(priceType.rest, 1), priceType.rest) IN IF ~strategyId.ok THEN Fail ELSE
    LET tradeThroughAlertType == ReadWhen(numberOfReturnBitfields.value >= 17 /\ (orderExecutionReturnBitfield17.value # << >> /\ (orderExecutionReturnBitfield17.value[1] \div 8) % 2 > 0), ReadBytes(strategyId.rest, 1), strategyId.rest) IN IF ~tradeThroughAlertType.ok THEN Fail ELSE
    LET senderLocationId == ReadWhen(numberOfReturnBitfields.value >= 17 /\ (orderExecutionReturnBitfield17.value # << >> /\ (orderExecutionReturnBitfield17.value[1] \div 16) % 2 > 0), ReadBytes(tradeThroughAlertType.rest, 1), tradeThroughAlertType.rest) IN IF ~senderLocationId.ok THEN Fail ELSE
    LET execLegCfiCode == ReadWhen(numberOfReturnBitfields.value >= 17 /\ (orderExecutionReturnBitfield17.value # << >> /\ (orderExecutionReturnBitfield17.value[1] \div 64) % 2 > 0), ReadBytes(senderLocationId.rest, 6), senderLocationId.rest) IN IF ~execLegCfiCode.ok THEN Fail ELSE
    LET crossInitiator == ReadWhen(numberOfReturnBitfields.value >= 18 /\ (orderExecutionReturnBitfield18.value # << >> /\ (orderExecutionReturnBitfield18.value[1] \div 2) % 2 > 0), ReadBytes(execLegCfiCode.rest, 4), execLegCfiCode.rest) IN IF ~crossInitiator.ok THEN Fail ELSE
    LET held == ReadWhen(numberOfReturnBitfields.value >= 18 /\ (orderExecutionReturnBitfield18.value # << >> /\ (orderExecutionReturnBitfield18.value[1] \div 32) % 2 > 0), ReadBytes(crossInitiator.rest, 1), crossInitiator.rest) IN IF ~held.ok THEN Fail ELSE
    LET floorTradeTime == ReadWhen(numberOfReturnBitfields.value >= 19 /\ (orderExecutionReturnBitfield19.value # << >> /\ orderExecutionReturnBitfield19.value[1] % 2 > 0), ReadBytes(held.rest, 8), held.rest) IN IF ~floorTradeTime.ok THEN Fail ELSE
    LET crossOnBehalfOfId == ReadWhen(numberOfReturnBitfields.value >= 19 /\ (orderExecutionReturnBitfield19.value # << >> /\ (orderExecutionReturnBitfield19.value[1] \div 4) % 2 > 0), ReadBytes(floorTradeTime.rest, 4), floorTradeTime.rest) IN IF ~crossOnBehalfOfId.ok THEN Fail ELSE
    LET stopPxType == ReadWhen(numberOfReturnBitfields.value >= 19 /\ (orderExecutionReturnBitfield19.value # << >> /\ (orderExecutionReturnBitfield19.value[1] \div 64) % 2 > 0), ReadBytes(crossOnBehalfOfId.rest, 1), crossOnBehalfOfId.rest) IN IF ~stopPxType.ok THEN Fail ELSE
    Ok([ transactionTime                |-> transactionTime.value,
         clOrdId                        |-> clOrdId.value,
         execId                         |-> execId.value,
         lastShares                     |-> lastShares.value,
         lastPx                         |-> lastPx.value,
         leavesQty                      |-> leavesQty.value,
         baseLiquidityIndicator         |-> baseLiquidityIndicator.value,
         subLiquidityIndicator          |-> subLiquidityIndicator.value,
         contraBroker                   |-> contraBroker.value,
         reserved1                      |-> reserved1.value,
         numberOfReturnBitfields        |-> numberOfReturnBitfields.value,
         orderExecutionReturnBitfield1  |-> orderExecutionReturnBitfield1.value,
         orderExecutionReturnBitfield2  |-> orderExecutionReturnBitfield2.value,
         orderExecutionReturnBitfield3  |-> orderExecutionReturnBitfield3.value,
         orderExecutionReturnBitfield4  |-> orderExecutionReturnBitfield4.value,
         orderExecutionReturnBitfield5  |-> orderExecutionReturnBitfield5.value,
         orderExecutionReturnBitfield6  |-> orderExecutionReturnBitfield6.value,
         orderExecutionReturnBitfield7  |-> orderExecutionReturnBitfield7.value,
         orderExecutionReturnBitfield8  |-> orderExecutionReturnBitfield8.value,
         orderExecutionReturnBitfield9  |-> orderExecutionReturnBitfield9.value,
         orderExecutionReturnBitfield10 |-> orderExecutionReturnBitfield10.value,
         orderExecutionReturnBitfield11 |-> orderExecutionReturnBitfield11.value,
         orderExecutionReturnBitfield12 |-> orderExecutionReturnBitfield12.value,
         orderExecutionReturnBitfield13 |-> orderExecutionReturnBitfield13.value,
         orderExecutionReturnBitfield14 |-> orderExecutionReturnBitfield14.value,
         orderExecutionReturnBitfield15 |-> orderExecutionReturnBitfield15.value,
         orderExecutionReturnBitfield16 |-> orderExecutionReturnBitfield16.value,
         orderExecutionReturnBitfield17 |-> orderExecutionReturnBitfield17.value,
         orderExecutionReturnBitfield18 |-> orderExecutionReturnBitfield18.value,
         orderExecutionReturnBitfield19 |-> orderExecutionReturnBitfield19.value,
         orderExecutionReturnBitfield20 |-> orderExecutionReturnBitfield20.value,
         orderExecutionReturnBitfield21 |-> orderExecutionReturnBitfield21.value,
         side                           |-> side.value,
         priceLong                      |-> priceLong.value,
         execInst                       |-> execInst.value,
         ordType                        |-> ordType.value,
         timeInForce                    |-> timeInForce.value,
         minQty                         |-> minQty.value,
         symbolLong                     |-> symbolLong.value,
         capacity                       |-> capacity.value,
         contraTrader                   |-> contraTrader.value,
         account                        |-> account.value,
         clearingFirm                   |-> clearingFirm.value,
         clearingAccount                |-> clearingAccount.value,
         displayIndicator               |-> displayIndicator.value,
         maxFloor                       |-> maxFloor.value,
         orderQtyLong                   |-> orderQtyLong.value,
         preventMatch                   |-> preventMatch.value,
         maturityDate                   |-> maturityDate.value,
         strikePrice                    |-> strikePrice.value,
         putOrCall                      |-> putOrCall.value,
         openClose                      |-> openClose.value,
         correctedSize                  |-> correctedSize.value,
         contraCapacity                 |-> contraCapacity.value,
         attributedQuote                |-> attributedQuote.value,
         feeCode                        |-> feeCode.value,
         echoText                       |-> echoText.value,
         stopPx                         |-> stopPx.value,
         routingInst                    |-> routingInst.value,
         routStrategy                   |-> routStrategy.value,
         routeDeliveryMethod            |-> routeDeliveryMethod.value,
         exDestination                  |-> exDestination.value,
         marketingFeeCode               |-> marketingFeeCode.value,
         targetPartyId                  |-> targetPartyId.value,
         auctionId                      |-> auctionId.value,
         cmtaNumber                     |-> cmtaNumber.value,
         crossType                      |-> crossType.value,
         crossPrioritization            |-> crossPrioritization.value,
         crossId                        |-> crossId.value,
         allocQty                       |-> allocQty.value,
         giveUpFirmId                   |-> giveUpFirmId.value,
         routingFirmId                  |-> routingFirmId.value,
         crossExclusionIndicator        |-> crossExclusionIndicator.value,
         tradeDate                      |-> tradeDate.value,
         clearingOptionalData           |-> clearingOptionalData.value,
         cumQty                         |-> cumQty.value,
         dayOrderQty                    |-> dayOrderQty.value,
         dayCumQty                      |-> dayCumQty.value,
         avgPx                          |-> avgPx.value,
         dayAvgPx                       |-> dayAvgPx.value,
         multilegReportingType          |-> multilegReportingType.value,
         secondaryExecId                |-> secondaryExecId.value,
         equityPartyId                  |-> equityPartyId.value,
         clientIdAttr                   |-> clientIdAttr.value,
         frequentTraderId               |-> frequentTraderId.value,
         comboOrder                     |-> comboOrder.value,
         compression                    |-> compression.value,
         floorDestination               |-> floorDestination.value,
         floorRoutingInst               |-> floorRoutingInst.value,
         multiClassSprd                 |-> multiClassSprd.value,
         orderOrigin                    |-> orderOrigin.value,
         priceType                      |-> priceType.value,
         strategyId                     |-> strategyId.value,
         tradeThroughAlertType          |-> tradeThroughAlertType.value,
         senderLocationId               |-> senderLocationId.value,
         execLegCfiCode                 |-> execLegCfiCode.value,
         crossInitiator                 |-> crossInitiator.value,
         held                           |-> held.value,
         floorTradeTime                 |-> floorTradeTime.value,
         crossOnBehalfOfId              |-> crossOnBehalfOfId.value,
         stopPxType                     |-> stopPxType.value ], stopPxType.rest)

(* Order Execution Message with each field marked present by fields before it there exactly where they say *)
SettleOrderExecutionMessage(message) ==
    LET settled1 == [message EXCEPT !.orderExecutionReturnBitfield1 = IF message.numberOfReturnBitfields >= 1 THEN (IF message.orderExecutionReturnBitfield1 = << >> THEN <<0>> ELSE message.orderExecutionReturnBitfield1) ELSE << >>]
        settled2 == [settled1 EXCEPT !.orderExecutionReturnBitfield2 = IF settled1.numberOfReturnBitfields >= 2 THEN (IF settled1.orderExecutionReturnBitfield2 = << >> THEN <<0>> ELSE settled1.orderExecutionReturnBitfield2) ELSE << >>]
        settled3 == [settled2 EXCEPT !.orderExecutionReturnBitfield3 = IF settled2.numberOfReturnBitfields >= 3 THEN (IF settled2.orderExecutionReturnBitfield3 = << >> THEN <<0>> ELSE settled2.orderExecutionReturnBitfield3) ELSE << >>]
        settled4 == [settled3 EXCEPT !.orderExecutionReturnBitfield4 = IF settled3.numberOfReturnBitfields >= 4 THEN (IF settled3.orderExecutionReturnBitfield4 = << >> THEN <<0>> ELSE settled3.orderExecutionReturnBitfield4) ELSE << >>]
        settled5 == [settled4 EXCEPT !.orderExecutionReturnBitfield5 = IF settled4.numberOfReturnBitfields >= 5 THEN (IF settled4.orderExecutionReturnBitfield5 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled4.orderExecutionReturnBitfield5) ELSE << >>]
        settled6 == [settled5 EXCEPT !.orderExecutionReturnBitfield6 = IF settled5.numberOfReturnBitfields >= 6 THEN (IF settled5.orderExecutionReturnBitfield6 = << >> THEN <<0>> ELSE settled5.orderExecutionReturnBitfield6) ELSE << >>]
        settled7 == [settled6 EXCEPT !.orderExecutionReturnBitfield7 = IF settled6.numberOfReturnBitfields >= 7 THEN (IF settled6.orderExecutionReturnBitfield7 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled6.orderExecutionReturnBitfield7) ELSE << >>]
        settled8 == [settled7 EXCEPT !.orderExecutionReturnBitfield8 = IF settled7.numberOfReturnBitfields >= 8 THEN (IF settled7.orderExecutionReturnBitfield8 = << >> THEN <<0>> ELSE settled7.orderExecutionReturnBitfield8) ELSE << >>]
        settled9 == [settled8 EXCEPT !.orderExecutionReturnBitfield9 = IF settled8.numberOfReturnBitfields >= 9 THEN (IF settled8.orderExecutionReturnBitfield9 = << >> THEN <<0>> ELSE settled8.orderExecutionReturnBitfield9) ELSE << >>]
        settled10 == [settled9 EXCEPT !.orderExecutionReturnBitfield10 = IF settled9.numberOfReturnBitfields >= 10 THEN (IF settled9.orderExecutionReturnBitfield10 = << >> THEN <<0>> ELSE settled9.orderExecutionReturnBitfield10) ELSE << >>]
        settled11 == [settled10 EXCEPT !.orderExecutionReturnBitfield11 = IF settled10.numberOfReturnBitfields >= 11 THEN (IF settled10.orderExecutionReturnBitfield11 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled10.orderExecutionReturnBitfield11) ELSE << >>]
        settled12 == [settled11 EXCEPT !.orderExecutionReturnBitfield12 = IF settled11.numberOfReturnBitfields >= 12 THEN (IF settled11.orderExecutionReturnBitfield12 = << >> THEN <<0>> ELSE settled11.orderExecutionReturnBitfield12) ELSE << >>]
        settled13 == [settled12 EXCEPT !.orderExecutionReturnBitfield13 = IF settled12.numberOfReturnBitfields >= 13 THEN (IF settled12.orderExecutionReturnBitfield13 = << >> THEN <<0>> ELSE settled12.orderExecutionReturnBitfield13) ELSE << >>]
        settled14 == [settled13 EXCEPT !.orderExecutionReturnBitfield14 = IF settled13.numberOfReturnBitfields >= 14 THEN (IF settled13.orderExecutionReturnBitfield14 = << >> THEN <<0>> ELSE settled13.orderExecutionReturnBitfield14) ELSE << >>]
        settled15 == [settled14 EXCEPT !.orderExecutionReturnBitfield15 = IF settled14.numberOfReturnBitfields >= 15 THEN (IF settled14.orderExecutionReturnBitfield15 = << >> THEN <<0>> ELSE settled14.orderExecutionReturnBitfield15) ELSE << >>]
