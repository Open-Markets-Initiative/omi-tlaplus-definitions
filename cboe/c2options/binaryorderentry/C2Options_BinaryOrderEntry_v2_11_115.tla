        \cup { SettleOrderRestatedMessage([ZeroOrderRestatedMessage EXCEPT !.numberOfReturnBitfields = 8, !.orderRestatedReturnBitfield8 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
