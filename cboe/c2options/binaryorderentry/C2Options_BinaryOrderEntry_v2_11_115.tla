        \cup { SettleOrderCancelledMessage([ZeroOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 4, !.orderCancelledReturnBitfield4 = <<4>>, !.putOrCall = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderCancelledMessage([ZeroOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 4, !.orderCancelledReturnBitfield4 = <<8>>, !.openClose = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderCancelledMessage([ZeroOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 4, !.orderCancelledReturnBitfield4 = <<32>>, !.correctedSize = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderCancelledMessage([ZeroOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 5, !.orderCancelledReturnBitfield5 = <<1>>, !.origClOrdId = one]) : one \in { <<held>> : held \in Sample(20) } }
        \cup { SettleOrderCancelledMessage([ZeroOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 5, !.orderCancelledReturnBitfield5 = <<2>>, !.leavesQty = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderCancelledMessage([ZeroOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 5, !.orderCancelledReturnBitfield5 = <<4>>, !.lastShares = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderCancelledMessage([ZeroOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 5, !.orderCancelledReturnBitfield5 = <<8>>, !.lastPx = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleOrderCancelledMessage([ZeroOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 5, !.orderCancelledReturnBitfield5 = <<16>>, !.displayPrice = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleOrderCancelledMessage([ZeroOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 5, !.orderCancelledReturnBitfield5 = <<32>>, !.workingPrice = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleOrderCancelledMessage([ZeroOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 5, !.orderCancelledReturnBitfield5 = <<64>>, !.baseLiquidityIndicator = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderCancelledMessage([ZeroOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 5, !.orderCancelledReturnBitfield5 = <<128>>, !.expireTime = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleOrderCancelledMessage([ZeroOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 6, !.orderCancelledReturnBitfield6 = <<1>>, !.secondaryOrderId = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleOrderCancelledMessage([ZeroOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 6, !.orderCancelledReturnBitfield6 = <<4>>, !.contraCapacity = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderCancelledMessage([ZeroOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 6, !.orderCancelledReturnBitfield6 = <<8>>, !.attributedQuote = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderCancelledMessage([ZeroOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 8, !.orderCancelledReturnBitfield8 = <<2>>, !.echoText = one]) : one \in { <<held>> : held \in Sample(64) } }
        \cup { SettleOrderCancelledMessage([ZeroOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 8, !.orderCancelledReturnBitfield8 = <<4>>, !.stopPx = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleOrderCancelledMessage([ZeroOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 8, !.orderCancelledReturnBitfield8 = <<8>>, !.routingInst = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderCancelledMessage([ZeroOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 8, !.orderCancelledReturnBitfield8 = <<16>>, !.routStrategy = one]) : one \in { <<held>> : held \in Sample(6) } }
        \cup { SettleOrderCancelledMessage([ZeroOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 8, !.orderCancelledReturnBitfield8 = <<32>>, !.routeDeliveryMethod = one]) : one \in { <<held>> : held \in Sample(3) } }
        \cup { SettleOrderCancelledMessage([ZeroOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 8, !.orderCancelledReturnBitfield8 = <<64>>, !.exDestination = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderCancelledMessage([ZeroOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 9, !.orderCancelledReturnBitfield9 = <<1>>, !.marketingFeeCode = one]) : one \in { <<held>> : held \in Sample(2) } }
        \cup { SettleOrderCancelledMessage([ZeroOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 9, !.orderCancelledReturnBitfield9 = <<2>>, !.targetPartyId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderCancelledMessage([ZeroOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 9, !.orderCancelledReturnBitfield9 = <<4>>, !.auctionId = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleOrderCancelledMessage([ZeroOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 9, !.orderCancelledReturnBitfield9 = <<32>>, !.cmtaNumber = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderCancelledMessage([ZeroOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 10, !.orderCancelledReturnBitfield10 = <<1>>, !.crossId = one]) : one \in { <<held>> : held \in Sample(20) } }
        \cup { SettleOrderCancelledMessage([ZeroOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 10, !.orderCancelledReturnBitfield10 = <<2>>, !.allocQty = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderCancelledMessage([ZeroOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 10, !.orderCancelledReturnBitfield10 = <<4>>, !.giveUpFirmId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderCancelledMessage([ZeroOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 10, !.orderCancelledReturnBitfield10 = <<8>>, !.routingFirmId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderCancelledMessage([ZeroOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 10, !.orderCancelledReturnBitfield10 = <<32>>, !.crossExclusionIndicator = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderCancelledMessage([ZeroOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 12, !.orderCancelledReturnBitfield12 = <<128>>, !.clearingOptionalData = one]) : one \in { <<held>> : held \in Sample(16) } }
        \cup { SettleOrderCancelledMessage([ZeroOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 15, !.orderCancelledReturnBitfield15 = <<2>>, !.equityPartyId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderCancelledMessage([ZeroOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 16, !.orderCancelledReturnBitfield16 = <<1>>, !.frequentTraderId = one]) : one \in { <<held>> : held \in Sample(6) } }
        \cup { SettleOrderCancelledMessage([ZeroOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 16, !.orderCancelledReturnBitfield16 = <<4>>, !.comboOrder = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderCancelledMessage([ZeroOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 16, !.orderCancelledReturnBitfield16 = <<8>>, !.compression = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderCancelledMessage([ZeroOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 16, !.orderCancelledReturnBitfield16 = <<16>>, !.floorDestination = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderCancelledMessage([ZeroOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 16, !.orderCancelledReturnBitfield16 = <<32>>, !.floorRoutingInst = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderCancelledMessage([ZeroOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 16, !.orderCancelledReturnBitfield16 = <<64>>, !.multiClassSprd = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderCancelledMessage([ZeroOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 16, !.orderCancelledReturnBitfield16 = <<128>>, !.orderOrigin = one]) : one \in { <<held>> : held \in Sample(3) } }
        \cup { SettleOrderCancelledMessage([ZeroOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 17, !.orderCancelledReturnBitfield17 = <<1>>, !.priceType = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderCancelledMessage([ZeroOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 17, !.orderCancelledReturnBitfield17 = <<2>>, !.strategyId = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderCancelledMessage([ZeroOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 18, !.orderCancelledReturnBitfield18 = <<2>>, !.crossInitiator = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderCancelledMessage([ZeroOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 18, !.orderCancelledReturnBitfield18 = <<4>>, !.subreason = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderCancelledMessage([ZeroOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 18, !.orderCancelledReturnBitfield18 = <<32>>, !.held = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderCancelledMessage([ZeroOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 19, !.orderCancelledReturnBitfield19 = <<4>>, !.crossOnBehalfOfId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderCancelledMessage([ZeroOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 19, !.orderCancelledReturnBitfield19 = <<64>>, !.stopPxType = one]) : one \in { <<held>> : held \in Sample(1) } }

(***************************************************************************)
(* Quote Cancelled Message: 41 bytes                                       *)
(***************************************************************************)

QuoteCancelledMessage ==
    [ transactionTime : Sample(8),
      quoteUpdateId   : Sample(16),
      orderId         : Sample(8),
      symbolShort     : Sample(6),
      side            : Sample(1),
      cancelReason    : Sample(1),
      cancelSubreason : Sample(1) ]

EncodeQuoteCancelledMessage(message) ==
    message.transactionTime
        \o message.quoteUpdateId
        \o message.orderId
        \o message.symbolShort
        \o message.side
        \o message.cancelReason
        \o message.cancelSubreason

DecodeQuoteCancelledMessage(bytes) ==
    LET transactionTime == ReadBytes(bytes, 8) IN IF ~transactionTime.ok THEN Fail ELSE
    LET quoteUpdateId == ReadBytes(transactionTime.rest, 16) IN IF ~quoteUpdateId.ok THEN Fail ELSE
    LET orderId == ReadBytes(quoteUpdateId.rest, 8) IN IF ~orderId.ok THEN Fail ELSE
    LET symbolShort == ReadBytes(orderId.rest, 6) IN IF ~symbolShort.ok THEN Fail ELSE
    LET side == ReadBytes(symbolShort.rest, 1) IN IF ~side.ok THEN Fail ELSE
    LET cancelReason == ReadBytes(side.rest, 1) IN IF ~cancelReason.ok THEN Fail ELSE
    LET cancelSubreason == ReadBytes(cancelReason.rest, 1) IN IF ~cancelSubreason.ok THEN Fail ELSE
    Ok([ transactionTime |-> transactionTime.value,
         quoteUpdateId   |-> quoteUpdateId.value,
         orderId         |-> orderId.value,
         symbolShort     |-> symbolShort.value,
         side            |-> side.value,
         cancelReason    |-> cancelReason.value,
         cancelSubreason |-> cancelSubreason.value ], cancelSubreason.rest)

ZeroQuoteCancelledMessage ==
    [ transactionTime |-> [i \in 1 .. 8 |-> 0],
      quoteUpdateId   |-> [i \in 1 .. 16 |-> 0],
      orderId         |-> [i \in 1 .. 8 |-> 0],
      symbolShort     |-> [i \in 1 .. 6 |-> 0],
      side            |-> [i \in 1 .. 1 |-> 0],
      cancelReason    |-> [i \in 1 .. 1 |-> 0],
      cancelSubreason |-> [i \in 1 .. 1 |-> 0] ]

(* Quote Cancelled Message at zero, then each field in turn at the values it is checked at *)
CheckedQuoteCancelledMessage ==
    { ZeroQuoteCancelledMessage }
        \cup { [ZeroQuoteCancelledMessage EXCEPT !.transactionTime = one] : one \in Sample(8) }
        \cup { [ZeroQuoteCancelledMessage EXCEPT !.quoteUpdateId = one] : one \in Sample(16) }
        \cup { [ZeroQuoteCancelledMessage EXCEPT !.orderId = one] : one \in Sample(8) }
        \cup { [ZeroQuoteCancelledMessage EXCEPT !.symbolShort = one] : one \in Sample(6) }
        \cup { [ZeroQuoteCancelledMessage EXCEPT !.side = one] : one \in Sample(1) }
        \cup { [ZeroQuoteCancelledMessage EXCEPT !.cancelReason = one] : one \in Sample(1) }
        \cup { [ZeroQuoteCancelledMessage EXCEPT !.cancelSubreason = one] : one \in Sample(1) }

(***************************************************************************)
(* Cross Order Cancelled Order Allocations                                 *)
(***************************************************************************)

CrossOrderCancelledOrderAllocations ==
    [ clOrdId         : Sample(20),
      orderId         : Sample(8),
      side            : { << >> } \cup { <<held>> : held \in Sample(1) },
      allocQty        : { << >> } \cup { <<held>> : held \in Sample(4) },
      capacity        : { << >> } \cup { <<held>> : held \in Sample(1) },
      openClose       : { << >> } \cup { <<held>> : held \in Sample(1) },
      giveUpFirmId    : { << >> } \cup { <<held>> : held \in Sample(4) },
      account         : { << >> } \cup { <<held>> : held \in Sample(16) },
      cmtaNumber      : { << >> } \cup { <<held>> : held \in Sample(4) },
      clearingAccount : Sample(4) ]

EncodeCrossOrderCancelledOrderAllocations(message) ==
    message.clOrdId
        \o message.orderId
        \o (IF message.side = << >> THEN << >> ELSE message.side[1])
        \o (IF message.allocQty = << >> THEN << >> ELSE message.allocQty[1])
        \o (IF message.capacity = << >> THEN << >> ELSE message.capacity[1])
        \o (IF message.openClose = << >> THEN << >> ELSE message.openClose[1])
        \o (IF message.giveUpFirmId = << >> THEN << >> ELSE message.giveUpFirmId[1])
        \o (IF message.account = << >> THEN << >> ELSE message.account[1])
        \o (IF message.cmtaNumber = << >> THEN << >> ELSE message.cmtaNumber[1])
        \o message.clearingAccount

DecodeCrossOrderCancelledOrderAllocations(bytes, handedNumberOfReturnBitfields, handedCrossOrderCancelledReturnBitfield1, handedCrossOrderCancelledReturnBitfield2, handedCrossOrderCancelledReturnBitfield3, handedCrossOrderCancelledReturnBitfield4, handedCrossOrderCancelledReturnBitfield9, handedCrossOrderCancelledReturnBitfield10) ==
    LET clOrdId == ReadBytes(bytes, 20) IN IF ~clOrdId.ok THEN Fail ELSE
    LET orderId == ReadBytes(clOrdId.rest, 8) IN IF ~orderId.ok THEN Fail ELSE
    LET side == ReadWhen(handedNumberOfReturnBitfields >= 1 /\ (handedCrossOrderCancelledReturnBitfield1 # << >> /\ handedCrossOrderCancelledReturnBitfield1[1] % 2 > 0), ReadBytes(orderId.rest, 1), orderId.rest) IN IF ~side.ok THEN Fail ELSE
    LET allocQty == ReadWhen(handedNumberOfReturnBitfields >= 10 /\ (handedCrossOrderCancelledReturnBitfield10 # << >> /\ (handedCrossOrderCancelledReturnBitfield10[1] \div 2) % 2 > 0), ReadBytes(side.rest, 4), side.rest) IN IF ~allocQty.ok THEN Fail ELSE
    LET capacity == ReadWhen(handedNumberOfReturnBitfields >= 2 /\ (handedCrossOrderCancelledReturnBitfield2 # << >> /\ (handedCrossOrderCancelledReturnBitfield2[1] \div 64) % 2 > 0), ReadBytes(allocQty.rest, 1), allocQty.rest) IN IF ~capacity.ok THEN Fail ELSE
    LET openClose == ReadWhen(handedNumberOfReturnBitfields >= 4 /\ (handedCrossOrderCancelledReturnBitfield4 # << >> /\ (handedCrossOrderCancelledReturnBitfield4[1] \div 8) % 2 > 0), ReadBytes(capacity.rest, 1), capacity.rest) IN IF ~openClose.ok THEN Fail ELSE
    LET giveUpFirmId == ReadWhen(handedNumberOfReturnBitfields >= 10 /\ (handedCrossOrderCancelledReturnBitfield10 # << >> /\ (handedCrossOrderCancelledReturnBitfield10[1] \div 4) % 2 > 0), ReadBytes(openClose.rest, 4), openClose.rest) IN IF ~giveUpFirmId.ok THEN Fail ELSE
    LET account == ReadWhen(handedNumberOfReturnBitfields >= 3 /\ (handedCrossOrderCancelledReturnBitfield3 # << >> /\ handedCrossOrderCancelledReturnBitfield3[1] % 2 > 0), ReadBytes(giveUpFirmId.rest, 16), giveUpFirmId.rest) IN IF ~account.ok THEN Fail ELSE
    LET cmtaNumber == ReadWhen(handedNumberOfReturnBitfields >= 9 /\ (handedCrossOrderCancelledReturnBitfield9 # << >> /\ (handedCrossOrderCancelledReturnBitfield9[1] \div 32) % 2 > 0), ReadBytes(account.rest, 4), account.rest) IN IF ~cmtaNumber.ok THEN Fail ELSE
    LET clearingAccount == ReadBytes(cmtaNumber.rest, 4) IN IF ~clearingAccount.ok THEN Fail ELSE
    Ok([ clOrdId         |-> clOrdId.value,
         orderId         |-> orderId.value,
         side            |-> side.value,
         allocQty        |-> allocQty.value,
         capacity        |-> capacity.value,
         openClose       |-> openClose.value,
         giveUpFirmId    |-> giveUpFirmId.value,
         account         |-> account.value,
         cmtaNumber      |-> cmtaNumber.value,
         clearingAccount |-> clearingAccount.value ], clearingAccount.rest)

(* Cross Order Cancelled Order Allocations with each field marked present by fields before it there exactly where they say *)
SettleCrossOrderCancelledOrderAllocations(message, handedNumberOfReturnBitfields, handedCrossOrderCancelledReturnBitfield1, handedCrossOrderCancelledReturnBitfield2, handedCrossOrderCancelledReturnBitfield3, handedCrossOrderCancelledReturnBitfield4, handedCrossOrderCancelledReturnBitfield9, handedCrossOrderCancelledReturnBitfield10) ==
    LET settled1 == [message EXCEPT !.side = IF handedNumberOfReturnBitfields >= 1 /\ (handedCrossOrderCancelledReturnBitfield1 # << >> /\ handedCrossOrderCancelledReturnBitfield1[1] % 2 > 0) THEN (IF message.side = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE message.side) ELSE << >>]
        settled2 == [settled1 EXCEPT !.allocQty = IF handedNumberOfReturnBitfields >= 10 /\ (handedCrossOrderCancelledReturnBitfield10 # << >> /\ (handedCrossOrderCancelledReturnBitfield10[1] \div 2) % 2 > 0) THEN (IF settled1.allocQty = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled1.allocQty) ELSE << >>]
        settled3 == [settled2 EXCEPT !.capacity = IF handedNumberOfReturnBitfields >= 2 /\ (handedCrossOrderCancelledReturnBitfield2 # << >> /\ (handedCrossOrderCancelledReturnBitfield2[1] \div 64) % 2 > 0) THEN (IF settled2.capacity = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled2.capacity) ELSE << >>]
        settled4 == [settled3 EXCEPT !.openClose = IF handedNumberOfReturnBitfields >= 4 /\ (handedCrossOrderCancelledReturnBitfield4 # << >> /\ (handedCrossOrderCancelledReturnBitfield4[1] \div 8) % 2 > 0) THEN (IF settled3.openClose = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled3.openClose) ELSE << >>]
        settled5 == [settled4 EXCEPT !.giveUpFirmId = IF handedNumberOfReturnBitfields >= 10 /\ (handedCrossOrderCancelledReturnBitfield10 # << >> /\ (handedCrossOrderCancelledReturnBitfield10[1] \div 4) % 2 > 0) THEN (IF settled4.giveUpFirmId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled4.giveUpFirmId) ELSE << >>]
        settled6 == [settled5 EXCEPT !.account = IF handedNumberOfReturnBitfields >= 3 /\ (handedCrossOrderCancelledReturnBitfield3 # << >> /\ handedCrossOrderCancelledReturnBitfield3[1] % 2 > 0) THEN (IF settled5.account = << >> THEN <<[i \in 1 .. 16 |-> 0]>> ELSE settled5.account) ELSE << >>]
        settled7 == [settled6 EXCEPT !.cmtaNumber = IF handedNumberOfReturnBitfields >= 9 /\ (handedCrossOrderCancelledReturnBitfield9 # << >> /\ (handedCrossOrderCancelledReturnBitfield9[1] \div 32) % 2 > 0) THEN (IF settled6.cmtaNumber = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled6.cmtaNumber) ELSE << >>]
    IN  settled7

ZeroCrossOrderCancelledOrderAllocations ==
    SettleCrossOrderCancelledOrderAllocations([ clOrdId         |-> [i \in 1 .. 20 |-> 0],
                                                orderId         |-> [i \in 1 .. 8 |-> 0],
                                                side            |-> << >>,
                                                allocQty        |-> << >>,
                                                capacity        |-> << >>,
                                                openClose       |-> << >>,
                                                giveUpFirmId    |-> << >>,
                                                account         |-> << >>,
                                                cmtaNumber      |-> << >>,
                                                clearingAccount |-> [i \in 1 .. 4 |-> 0] ], 0, << >>, << >>, << >>, << >>, << >>, << >>)

(* Cross Order Cancelled Order Allocations at zero, then each field in turn at the values it is checked at *)
CheckedCrossOrderCancelledOrderAllocations ==
    { [given |-> <<0, << >>, << >>, << >>, << >>, << >>, << >>>>, message |-> ZeroCrossOrderCancelledOrderAllocations] }
        \cup { [given |-> <<0, << >>, << >>, << >>, << >>, << >>, << >>>>, message |-> SettleCrossOrderCancelledOrderAllocations([ZeroCrossOrderCancelledOrderAllocations EXCEPT !.clOrdId = one], 0, << >>, << >>, << >>, << >>, << >>, << >>)] : one \in Sample(20) }
        \cup { [given |-> <<0, << >>, << >>, << >>, << >>, << >>, << >>>>, message |-> SettleCrossOrderCancelledOrderAllocations([ZeroCrossOrderCancelledOrderAllocations EXCEPT !.orderId = one], 0, << >>, << >>, << >>, << >>, << >>, << >>)] : one \in Sample(8) }
        \cup { [given |-> <<1, <<1>>, << >>, << >>, << >>, << >>, << >>>>, message |-> SettleCrossOrderCancelledOrderAllocations([ZeroCrossOrderCancelledOrderAllocations EXCEPT !.side = one], 1, <<1>>, << >>, << >>, << >>, << >>, << >>)] : one \in { <<held>> : held \in Sample(1) } }
        \cup { [given |-> <<10, << >>, << >>, << >>, << >>, << >>, <<2>>>>, message |-> SettleCrossOrderCancelledOrderAllocations([ZeroCrossOrderCancelledOrderAllocations EXCEPT !.allocQty = one], 10, << >>, << >>, << >>, << >>, << >>, <<2>>)] : one \in { <<held>> : held \in Sample(4) } }
        \cup { [given |-> <<2, << >>, <<64>>, << >>, << >>, << >>, << >>>>, message |-> SettleCrossOrderCancelledOrderAllocations([ZeroCrossOrderCancelledOrderAllocations EXCEPT !.capacity = one], 2, << >>, <<64>>, << >>, << >>, << >>, << >>)] : one \in { <<held>> : held \in Sample(1) } }
        \cup { [given |-> <<4, << >>, << >>, << >>, <<8>>, << >>, << >>>>, message |-> SettleCrossOrderCancelledOrderAllocations([ZeroCrossOrderCancelledOrderAllocations EXCEPT !.openClose = one], 4, << >>, << >>, << >>, <<8>>, << >>, << >>)] : one \in { <<held>> : held \in Sample(1) } }
        \cup { [given |-> <<10, << >>, << >>, << >>, << >>, << >>, <<4>>>>, message |-> SettleCrossOrderCancelledOrderAllocations([ZeroCrossOrderCancelledOrderAllocations EXCEPT !.giveUpFirmId = one], 10, << >>, << >>, << >>, << >>, << >>, <<4>>)] : one \in { <<held>> : held \in Sample(4) } }
        \cup { [given |-> <<3, << >>, << >>, <<1>>, << >>, << >>, << >>>>, message |-> SettleCrossOrderCancelledOrderAllocations([ZeroCrossOrderCancelledOrderAllocations EXCEPT !.account = one], 3, << >>, << >>, <<1>>, << >>, << >>, << >>)] : one \in { <<held>> : held \in Sample(16) } }
        \cup { [given |-> <<9, << >>, << >>, << >>, << >>, <<32>>, << >>>>, message |-> SettleCrossOrderCancelledOrderAllocations([ZeroCrossOrderCancelledOrderAllocations EXCEPT !.cmtaNumber = one], 9, << >>, << >>, << >>, << >>, <<32>>, << >>)] : one \in { <<held>> : held \in Sample(4) } }
        \cup { [given |-> <<0, << >>, << >>, << >>, << >>, << >>, << >>>>, message |-> SettleCrossOrderCancelledOrderAllocations([ZeroCrossOrderCancelledOrderAllocations EXCEPT !.clearingAccount = one], 0, << >>, << >>, << >>, << >>, << >>, << >>)] : one \in Sample(4) }

(* A run of Cross Order Cancelled Order Allocations, written one after another *)
RECURSIVE EncodeCrossOrderCancelledOrderAllocationsList(_)
EncodeCrossOrderCancelledOrderAllocationsList(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeCrossOrderCancelledOrderAllocations(Head(messages)) \o EncodeCrossOrderCancelledOrderAllocationsList(Tail(messages))

(* As many Cross Order Cancelled Order Allocations as the field that counts them says *)
RECURSIVE ReadCrossOrderCancelledOrderAllocationsList(_, _, _, _, _, _, _, _, _)
ReadCrossOrderCancelledOrderAllocationsList(bytes, count, handedNumberOfReturnBitfields, handedCrossOrderCancelledReturnBitfield1, handedCrossOrderCancelledReturnBitfield2, handedCrossOrderCancelledReturnBitfield3, handedCrossOrderCancelledReturnBitfield4, handedCrossOrderCancelledReturnBitfield9, handedCrossOrderCancelledReturnBitfield10) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeCrossOrderCancelledOrderAllocations(bytes, handedNumberOfReturnBitfields, handedCrossOrderCancelledReturnBitfield1, handedCrossOrderCancelledReturnBitfield2, handedCrossOrderCancelledReturnBitfield3, handedCrossOrderCancelledReturnBitfield4, handedCrossOrderCancelledReturnBitfield9, handedCrossOrderCancelledReturnBitfield10)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadCrossOrderCancelledOrderAllocationsList(one.rest, count - 1, handedNumberOfReturnBitfields, handedCrossOrderCancelledReturnBitfield1, handedCrossOrderCancelledReturnBitfield2, handedCrossOrderCancelledReturnBitfield3, handedCrossOrderCancelledReturnBitfield4, handedCrossOrderCancelledReturnBitfield9, handedCrossOrderCancelledReturnBitfield10)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Cross Order Cancelled Order Allocations of each kind, for the lists that carry them *)
OneCrossOrderCancelledOrderAllocations == { ZeroCrossOrderCancelledOrderAllocations }

(***************************************************************************)
(* Cross Order Cancelled Message                                           *)
(***************************************************************************)

CrossOrderCancelledMessage ==
    [ transactionTime                     : Sample(8),
      crossId                             : Sample(20),
      cancelReason                        : Sample(1),
      reserved1                           : Sample(1),
      numberOfReturnBitfields             : 0 .. 255,
      crossOrderCancelledReturnBitfield1  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderCancelledReturnBitfield2  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderCancelledReturnBitfield3  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderCancelledReturnBitfield4  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderCancelledReturnBitfield5  : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderCancelledReturnBitfield6  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderCancelledReturnBitfield7  : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderCancelledReturnBitfield8  : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderCancelledReturnBitfield9  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderCancelledReturnBitfield10 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderCancelledReturnBitfield11 : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderCancelledReturnBitfield12 : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderCancelledReturnBitfield13 : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderCancelledReturnBitfield14 : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderCancelledReturnBitfield15 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderCancelledReturnBitfield16 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderCancelledReturnBitfield17 : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderCancelledReturnBitfield18 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderCancelledReturnBitfield19 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderCancelledReturnBitfield20 : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderCancelledReturnBitfield21 : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderCancelledOrderAllocations : SampleLists(OneCrossOrderCancelledOrderAllocations),
      priceLong                           : { << >> } \cup { <<held>> : held \in Sample(8) },
      execInst                            : { << >> } \cup { <<held>> : held \in Sample(1) },
      symbolLong                          : { << >> } \cup { <<held>> : held \in Sample(8) },
      clearingFirm                        : { << >> } \cup { <<held>> : held \in Sample(4) },
      orderQtyLong                        : { << >> } \cup { <<held>> : held \in Sample(4) },
      preventMatch                        : { << >> } \cup { <<held>> : held \in Sample(3) },
      maturityDate                        : { << >> } \cup { <<held>> : held \in Sample(4) },
      strikePrice                         : { << >> } \cup { <<held>> : held \in Sample(8) },
      putOrCall                           : { << >> } \cup { <<held>> : held \in Sample(1) },
      attributedQuote                     : { << >> } \cup { <<held>> : held \in Sample(1) },
      targetPartyId                       : { << >> } \cup { <<held>> : held \in Sample(4) },
      auctionId                           : { << >> } \cup { <<held>> : held \in Sample(8) },
      crossType                           : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossPrioritization                 : { << >> } \cup { <<held>> : held \in Sample(1) },
      routingFirmId                       : { << >> } \cup { <<held>> : held \in Sample(4) },
      equityPartyId                       : { << >> } \cup { <<held>> : held \in Sample(4) },
      frequentTraderId                    : { << >> } \cup { <<held>> : held \in Sample(6) },
      compression                         : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossInitiator                      : { << >> } \cup { <<held>> : held \in Sample(4) },
      crossOnBehalfOfId                   : { << >> } \cup { <<held>> : held \in Sample(4) } ]

EncodeCrossOrderCancelledMessage(message) ==
    message.transactionTime
        \o message.crossId
        \o message.cancelReason
        \o message.reserved1
        \o EncodeUIntBE(message.numberOfReturnBitfields, 1)
        \o (IF message.crossOrderCancelledReturnBitfield1 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderCancelledReturnBitfield1[1], 1))
        \o (IF message.crossOrderCancelledReturnBitfield2 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderCancelledReturnBitfield2[1], 1))
        \o (IF message.crossOrderCancelledReturnBitfield3 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderCancelledReturnBitfield3[1], 1))
        \o (IF message.crossOrderCancelledReturnBitfield4 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderCancelledReturnBitfield4[1], 1))
        \o (IF message.crossOrderCancelledReturnBitfield5 = << >> THEN << >> ELSE message.crossOrderCancelledReturnBitfield5[1])
        \o (IF message.crossOrderCancelledReturnBitfield6 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderCancelledReturnBitfield6[1], 1))
        \o (IF message.crossOrderCancelledReturnBitfield7 = << >> THEN << >> ELSE message.crossOrderCancelledReturnBitfield7[1])
        \o (IF message.crossOrderCancelledReturnBitfield8 = << >> THEN << >> ELSE message.crossOrderCancelledReturnBitfield8[1])
        \o (IF message.crossOrderCancelledReturnBitfield9 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderCancelledReturnBitfield9[1], 1))
        \o (IF message.crossOrderCancelledReturnBitfield10 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderCancelledReturnBitfield10[1], 1))
        \o (IF message.crossOrderCancelledReturnBitfield11 = << >> THEN << >> ELSE message.crossOrderCancelledReturnBitfield11[1])
        \o (IF message.crossOrderCancelledReturnBitfield12 = << >> THEN << >> ELSE message.crossOrderCancelledReturnBitfield12[1])
        \o (IF message.crossOrderCancelledReturnBitfield13 = << >> THEN << >> ELSE message.crossOrderCancelledReturnBitfield13[1])
        \o (IF message.crossOrderCancelledReturnBitfield14 = << >> THEN << >> ELSE message.crossOrderCancelledReturnBitfield14[1])
        \o (IF message.crossOrderCancelledReturnBitfield15 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderCancelledReturnBitfield15[1], 1))
        \o (IF message.crossOrderCancelledReturnBitfield16 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderCancelledReturnBitfield16[1], 1))
        \o (IF message.crossOrderCancelledReturnBitfield17 = << >> THEN << >> ELSE message.crossOrderCancelledReturnBitfield17[1])
        \o (IF message.crossOrderCancelledReturnBitfield18 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderCancelledReturnBitfield18[1], 1))
        \o (IF message.crossOrderCancelledReturnBitfield19 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderCancelledReturnBitfield19[1], 1))
        \o (IF message.crossOrderCancelledReturnBitfield20 = << >> THEN << >> ELSE message.crossOrderCancelledReturnBitfield20[1])
        \o (IF message.crossOrderCancelledReturnBitfield21 = << >> THEN << >> ELSE message.crossOrderCancelledReturnBitfield21[1])
        \o EncodeUIntLE(Len(message.crossOrderCancelledOrderAllocations), 2)
        \o EncodeCrossOrderCancelledOrderAllocationsList(message.crossOrderCancelledOrderAllocations)
        \o (IF message.priceLong = << >> THEN << >> ELSE message.priceLong[1])
        \o (IF message.execInst = << >> THEN << >> ELSE message.execInst[1])
        \o (IF message.symbolLong = << >> THEN << >> ELSE message.symbolLong[1])
        \o (IF message.clearingFirm = << >> THEN << >> ELSE message.clearingFirm[1])
        \o (IF message.orderQtyLong = << >> THEN << >> ELSE message.orderQtyLong[1])
        \o (IF message.preventMatch = << >> THEN << >> ELSE message.preventMatch[1])
        \o (IF message.maturityDate = << >> THEN << >> ELSE message.maturityDate[1])
        \o (IF message.strikePrice = << >> THEN << >> ELSE message.strikePrice[1])
        \o (IF message.putOrCall = << >> THEN << >> ELSE message.putOrCall[1])
        \o (IF message.attributedQuote = << >> THEN << >> ELSE message.attributedQuote[1])
        \o (IF message.targetPartyId = << >> THEN << >> ELSE message.targetPartyId[1])
        \o (IF message.auctionId = << >> THEN << >> ELSE message.auctionId[1])
        \o (IF message.crossType = << >> THEN << >> ELSE message.crossType[1])
        \o (IF message.crossPrioritization = << >> THEN << >> ELSE message.crossPrioritization[1])
        \o (IF message.routingFirmId = << >> THEN << >> ELSE message.routingFirmId[1])
        \o (IF message.equityPartyId = << >> THEN << >> ELSE message.equityPartyId[1])
        \o (IF message.frequentTraderId = << >> THEN << >> ELSE message.frequentTraderId[1])
        \o (IF message.compression = << >> THEN << >> ELSE message.compression[1])
        \o (IF message.crossInitiator = << >> THEN << >> ELSE message.crossInitiator[1])
        \o (IF message.crossOnBehalfOfId = << >> THEN << >> ELSE message.crossOnBehalfOfId[1])

DecodeCrossOrderCancelledMessage(bytes) ==
    LET transactionTime == ReadBytes(bytes, 8) IN IF ~transactionTime.ok THEN Fail ELSE
    LET crossId == ReadBytes(transactionTime.rest, 20) IN IF ~crossId.ok THEN Fail ELSE
    LET cancelReason == ReadBytes(crossId.rest, 1) IN IF ~cancelReason.ok THEN Fail ELSE
    LET reserved1 == ReadBytes(cancelReason.rest, 1) IN IF ~reserved1.ok THEN Fail ELSE
    LET numberOfReturnBitfields == ReadUIntBE(reserved1.rest, 1) IN IF ~numberOfReturnBitfields.ok THEN Fail ELSE
    LET crossOrderCancelledReturnBitfield1 == ReadWhen(numberOfReturnBitfields.value >= 1, ReadUIntLE(numberOfReturnBitfields.rest, 1), numberOfReturnBitfields.rest) IN IF ~crossOrderCancelledReturnBitfield1.ok THEN Fail ELSE
    LET crossOrderCancelledReturnBitfield2 == ReadWhen(numberOfReturnBitfields.value >= 2, ReadUIntLE(crossOrderCancelledReturnBitfield1.rest, 1), crossOrderCancelledReturnBitfield1.rest) IN IF ~crossOrderCancelledReturnBitfield2.ok THEN Fail ELSE
    LET crossOrderCancelledReturnBitfield3 == ReadWhen(numberOfReturnBitfields.value >= 3, ReadUIntLE(crossOrderCancelledReturnBitfield2.rest, 1), crossOrderCancelledReturnBitfield2.rest) IN IF ~crossOrderCancelledReturnBitfield3.ok THEN Fail ELSE
    LET crossOrderCancelledReturnBitfield4 == ReadWhen(numberOfReturnBitfields.value >= 4, ReadUIntLE(crossOrderCancelledReturnBitfield3.rest, 1), crossOrderCancelledReturnBitfield3.rest) IN IF ~crossOrderCancelledReturnBitfield4.ok THEN Fail ELSE
    LET crossOrderCancelledReturnBitfield5 == ReadWhen(numberOfReturnBitfields.value >= 5, ReadBytes(crossOrderCancelledReturnBitfield4.rest, 1), crossOrderCancelledReturnBitfield4.rest) IN IF ~crossOrderCancelledReturnBitfield5.ok THEN Fail ELSE
    LET crossOrderCancelledReturnBitfield6 == ReadWhen(numberOfReturnBitfields.value >= 6, ReadUIntLE(crossOrderCancelledReturnBitfield5.rest, 1), crossOrderCancelledReturnBitfield5.rest) IN IF ~crossOrderCancelledReturnBitfield6.ok THEN Fail ELSE
    LET crossOrderCancelledReturnBitfield7 == ReadWhen(numberOfReturnBitfields.value >= 7, ReadBytes(crossOrderCancelledReturnBitfield6.rest, 1), crossOrderCancelledReturnBitfield6.rest) IN IF ~crossOrderCancelledReturnBitfield7.ok THEN Fail ELSE
    LET crossOrderCancelledReturnBitfield8 == ReadWhen(numberOfReturnBitfields.value >= 8, ReadBytes(crossOrderCancelledReturnBitfield7.rest, 1), crossOrderCancelledReturnBitfield7.rest) IN IF ~crossOrderCancelledReturnBitfield8.ok THEN Fail ELSE
    LET crossOrderCancelledReturnBitfield9 == ReadWhen(numberOfReturnBitfields.value >= 9, ReadUIntLE(crossOrderCancelledReturnBitfield8.rest, 1), crossOrderCancelledReturnBitfield8.rest) IN IF ~crossOrderCancelledReturnBitfield9.ok THEN Fail ELSE
    LET crossOrderCancelledReturnBitfield10 == ReadWhen(numberOfReturnBitfields.value >= 10, ReadUIntLE(crossOrderCancelledReturnBitfield9.rest, 1), crossOrderCancelledReturnBitfield9.rest) IN IF ~crossOrderCancelledReturnBitfield10.ok THEN Fail ELSE
    LET crossOrderCancelledReturnBitfield11 == ReadWhen(numberOfReturnBitfields.value >= 11, ReadBytes(crossOrderCancelledReturnBitfield10.rest, 1), crossOrderCancelledReturnBitfield10.rest) IN IF ~crossOrderCancelledReturnBitfield11.ok THEN Fail ELSE
    LET crossOrderCancelledReturnBitfield12 == ReadWhen(numberOfReturnBitfields.value >= 12, ReadBytes(crossOrderCancelledReturnBitfield11.rest, 1), crossOrderCancelledReturnBitfield11.rest) IN IF ~crossOrderCancelledReturnBitfield12.ok THEN Fail ELSE
    LET crossOrderCancelledReturnBitfield13 == ReadWhen(numberOfReturnBitfields.value >= 13, ReadBytes(crossOrderCancelledReturnBitfield12.rest, 1), crossOrderCancelledReturnBitfield12.rest) IN IF ~crossOrderCancelledReturnBitfield13.ok THEN Fail ELSE
    LET crossOrderCancelledReturnBitfield14 == ReadWhen(numberOfReturnBitfields.value >= 14, ReadBytes(crossOrderCancelledReturnBitfield13.rest, 1), crossOrderCancelledReturnBitfield13.rest) IN IF ~crossOrderCancelledReturnBitfield14.ok THEN Fail ELSE
    LET crossOrderCancelledReturnBitfield15 == ReadWhen(numberOfReturnBitfields.value >= 15, ReadUIntLE(crossOrderCancelledReturnBitfield14.rest, 1), crossOrderCancelledReturnBitfield14.rest) IN IF ~crossOrderCancelledReturnBitfield15.ok THEN Fail ELSE
    LET crossOrderCancelledReturnBitfield16 == ReadWhen(numberOfReturnBitfields.value >= 16, ReadUIntLE(crossOrderCancelledReturnBitfield15.rest, 1), crossOrderCancelledReturnBitfield15.rest) IN IF ~crossOrderCancelledReturnBitfield16.ok THEN Fail ELSE
    LET crossOrderCancelledReturnBitfield17 == ReadWhen(numberOfReturnBitfields.value >= 17, ReadBytes(crossOrderCancelledReturnBitfield16.rest, 1), crossOrderCancelledReturnBitfield16.rest) IN IF ~crossOrderCancelledReturnBitfield17.ok THEN Fail ELSE
    LET crossOrderCancelledReturnBitfield18 == ReadWhen(numberOfReturnBitfields.value >= 18, ReadUIntLE(crossOrderCancelledReturnBitfield17.rest, 1), crossOrderCancelledReturnBitfield17.rest) IN IF ~crossOrderCancelledReturnBitfield18.ok THEN Fail ELSE
    LET crossOrderCancelledReturnBitfield19 == ReadWhen(numberOfReturnBitfields.value >= 19, ReadUIntLE(crossOrderCancelledReturnBitfield18.rest, 1), crossOrderCancelledReturnBitfield18.rest) IN IF ~crossOrderCancelledReturnBitfield19.ok THEN Fail ELSE
    LET crossOrderCancelledReturnBitfield20 == ReadWhen(numberOfReturnBitfields.value >= 20, ReadBytes(crossOrderCancelledReturnBitfield19.rest, 1), crossOrderCancelledReturnBitfield19.rest) IN IF ~crossOrderCancelledReturnBitfield20.ok THEN Fail ELSE
    LET crossOrderCancelledReturnBitfield21 == ReadWhen(numberOfReturnBitfields.value >= 21, ReadBytes(crossOrderCancelledReturnBitfield20.rest, 1), crossOrderCancelledReturnBitfield20.rest) IN IF ~crossOrderCancelledReturnBitfield21.ok THEN Fail ELSE
    LET groupCnt == ReadUIntLE(crossOrderCancelledReturnBitfield21.rest, 2) IN IF ~groupCnt.ok THEN Fail ELSE
    LET crossOrderCancelledOrderAllocations == ReadCrossOrderCancelledOrderAllocationsList(groupCnt.rest, groupCnt.value, numberOfReturnBitfields.value, crossOrderCancelledReturnBitfield1.value, crossOrderCancelledReturnBitfield2.value, crossOrderCancelledReturnBitfield3.value, crossOrderCancelledReturnBitfield4.value, crossOrderCancelledReturnBitfield9.value, crossOrderCancelledReturnBitfield10.value) IN IF ~crossOrderCancelledOrderAllocations.ok THEN Fail ELSE
    LET priceLong == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (crossOrderCancelledReturnBitfield1.value # << >> /\ (crossOrderCancelledReturnBitfield1.value[1] \div 4) % 2 > 0), ReadBytes(crossOrderCancelledOrderAllocations.rest, 8), crossOrderCancelledOrderAllocations.rest) IN IF ~priceLong.ok THEN Fail ELSE
    LET execInst == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (crossOrderCancelledReturnBitfield1.value # << >> /\ (crossOrderCancelledReturnBitfield1.value[1] \div 8) % 2 > 0), ReadBytes(priceLong.rest, 1), priceLong.rest) IN IF ~execInst.ok THEN Fail ELSE
    LET symbolLong == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (crossOrderCancelledReturnBitfield2.value # << >> /\ crossOrderCancelledReturnBitfield2.value[1] % 2 > 0), ReadBytes(execInst.rest, 8), execInst.rest) IN IF ~symbolLong.ok THEN Fail ELSE
    LET clearingFirm == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (crossOrderCancelledReturnBitfield3.value # << >> /\ (crossOrderCancelledReturnBitfield3.value[1] \div 2) % 2 > 0), ReadBytes(symbolLong.rest, 4), symbolLong.rest) IN IF ~clearingFirm.ok THEN Fail ELSE
    LET orderQtyLong == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (crossOrderCancelledReturnBitfield3.value # << >> /\ (crossOrderCancelledReturnBitfield3.value[1] \div 64) % 2 > 0), ReadBytes(clearingFirm.rest, 4), clearingFirm.rest) IN IF ~orderQtyLong.ok THEN Fail ELSE
    LET preventMatch == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (crossOrderCancelledReturnBitfield3.value # << >> /\ (crossOrderCancelledReturnBitfield3.value[1] \div 128) % 2 > 0), ReadBytes(orderQtyLong.rest, 3), orderQtyLong.rest) IN IF ~preventMatch.ok THEN Fail ELSE
    LET maturityDate == ReadWhen(numberOfReturnBitfields.value >= 4 /\ (crossOrderCancelledReturnBitfield4.value # << >> /\ crossOrderCancelledReturnBitfield4.value[1] % 2 > 0), ReadBytes(preventMatch.rest, 4), preventMatch.rest) IN IF ~maturityDate.ok THEN Fail ELSE
    LET strikePrice == ReadWhen(numberOfReturnBitfields.value >= 4 /\ (crossOrderCancelledReturnBitfield4.value # << >> /\ (crossOrderCancelledReturnBitfield4.value[1] \div 2) % 2 > 0), ReadBytes(maturityDate.rest, 8), maturityDate.rest) IN IF ~strikePrice.ok THEN Fail ELSE
    LET putOrCall == ReadWhen(numberOfReturnBitfields.value >= 4 /\ (crossOrderCancelledReturnBitfield4.value # << >> /\ (crossOrderCancelledReturnBitfield4.value[1] \div 4) % 2 > 0), ReadBytes(strikePrice.rest, 1), strikePrice.rest) IN IF ~putOrCall.ok THEN Fail ELSE
    LET attributedQuote == ReadWhen(numberOfReturnBitfields.value >= 6 /\ (crossOrderCancelledReturnBitfield6.value # << >> /\ (crossOrderCancelledReturnBitfield6.value[1] \div 8) % 2 > 0), ReadBytes(putOrCall.rest, 1), putOrCall.rest) IN IF ~attributedQuote.ok THEN Fail ELSE
    LET targetPartyId == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (crossOrderCancelledReturnBitfield9.value # << >> /\ (crossOrderCancelledReturnBitfield9.value[1] \div 2) % 2 > 0), ReadBytes(attributedQuote.rest, 4), attributedQuote.rest) IN IF ~targetPartyId.ok THEN Fail ELSE
    LET auctionId == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (crossOrderCancelledReturnBitfield9.value # << >> /\ (crossOrderCancelledReturnBitfield9.value[1] \div 4) % 2 > 0), ReadBytes(targetPartyId.rest, 8), targetPartyId.rest) IN IF ~auctionId.ok THEN Fail ELSE
    LET crossType == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (crossOrderCancelledReturnBitfield9.value # << >> /\ (crossOrderCancelledReturnBitfield9.value[1] \div 64) % 2 > 0), ReadBytes(auctionId.rest, 1), auctionId.rest) IN IF ~crossType.ok THEN Fail ELSE
    LET crossPrioritization == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (crossOrderCancelledReturnBitfield9.value # << >> /\ (crossOrderCancelledReturnBitfield9.value[1] \div 128) % 2 > 0), ReadBytes(crossType.rest, 1), crossType.rest) IN IF ~crossPrioritization.ok THEN Fail ELSE
    LET routingFirmId == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (crossOrderCancelledReturnBitfield10.value # << >> /\ (crossOrderCancelledReturnBitfield10.value[1] \div 8) % 2 > 0), ReadBytes(crossPrioritization.rest, 4), crossPrioritization.rest) IN IF ~routingFirmId.ok THEN Fail ELSE
    LET equityPartyId == ReadWhen(numberOfReturnBitfields.value >= 15 /\ (crossOrderCancelledReturnBitfield15.value # << >> /\ (crossOrderCancelledReturnBitfield15.value[1] \div 2) % 2 > 0), ReadBytes(routingFirmId.rest, 4), routingFirmId.rest) IN IF ~equityPartyId.ok THEN Fail ELSE
    LET frequentTraderId == ReadWhen(numberOfReturnBitfields.value >= 16 /\ (crossOrderCancelledReturnBitfield16.value # << >> /\ crossOrderCancelledReturnBitfield16.value[1] % 2 > 0), ReadBytes(equityPartyId.rest, 6), equityPartyId.rest) IN IF ~frequentTraderId.ok THEN Fail ELSE
    LET compression == ReadWhen(numberOfReturnBitfields.value >= 16 /\ (crossOrderCancelledReturnBitfield16.value # << >> /\ (crossOrderCancelledReturnBitfield16.value[1] \div 8) % 2 > 0), ReadBytes(frequentTraderId.rest, 1), frequentTraderId.rest) IN IF ~compression.ok THEN Fail ELSE
    LET crossInitiator == ReadWhen(numberOfReturnBitfields.value >= 18 /\ (crossOrderCancelledReturnBitfield18.value # << >> /\ (crossOrderCancelledReturnBitfield18.value[1] \div 2) % 2 > 0), ReadBytes(compression.rest, 4), compression.rest) IN IF ~crossInitiator.ok THEN Fail ELSE
    LET crossOnBehalfOfId == ReadWhen(numberOfReturnBitfields.value >= 19 /\ (crossOrderCancelledReturnBitfield19.value # << >> /\ (crossOrderCancelledReturnBitfield19.value[1] \div 4) % 2 > 0), ReadBytes(crossInitiator.rest, 4), crossInitiator.rest) IN IF ~crossOnBehalfOfId.ok THEN Fail ELSE
    Ok([ transactionTime                     |-> transactionTime.value,
         crossId                             |-> crossId.value,
         cancelReason                        |-> cancelReason.value,
         reserved1                           |-> reserved1.value,
         numberOfReturnBitfields             |-> numberOfReturnBitfields.value,
         crossOrderCancelledReturnBitfield1  |-> crossOrderCancelledReturnBitfield1.value,
         crossOrderCancelledReturnBitfield2  |-> crossOrderCancelledReturnBitfield2.value,
         crossOrderCancelledReturnBitfield3  |-> crossOrderCancelledReturnBitfield3.value,
         crossOrderCancelledReturnBitfield4  |-> crossOrderCancelledReturnBitfield4.value,
         crossOrderCancelledReturnBitfield5  |-> crossOrderCancelledReturnBitfield5.value,
         crossOrderCancelledReturnBitfield6  |-> crossOrderCancelledReturnBitfield6.value,
         crossOrderCancelledReturnBitfield7  |-> crossOrderCancelledReturnBitfield7.value,
         crossOrderCancelledReturnBitfield8  |-> crossOrderCancelledReturnBitfield8.value,
         crossOrderCancelledReturnBitfield9  |-> crossOrderCancelledReturnBitfield9.value,
         crossOrderCancelledReturnBitfield10 |-> crossOrderCancelledReturnBitfield10.value,
         crossOrderCancelledReturnBitfield11 |-> crossOrderCancelledReturnBitfield11.value,
         crossOrderCancelledReturnBitfield12 |-> crossOrderCancelledReturnBitfield12.value,
         crossOrderCancelledReturnBitfield13 |-> crossOrderCancelledReturnBitfield13.value,
         crossOrderCancelledReturnBitfield14 |-> crossOrderCancelledReturnBitfield14.value,
         crossOrderCancelledReturnBitfield15 |-> crossOrderCancelledReturnBitfield15.value,
         crossOrderCancelledReturnBitfield16 |-> crossOrderCancelledReturnBitfield16.value,
         crossOrderCancelledReturnBitfield17 |-> crossOrderCancelledReturnBitfield17.value,
         crossOrderCancelledReturnBitfield18 |-> crossOrderCancelledReturnBitfield18.value,
         crossOrderCancelledReturnBitfield19 |-> crossOrderCancelledReturnBitfield19.value,
         crossOrderCancelledReturnBitfield20 |-> crossOrderCancelledReturnBitfield20.value,
         crossOrderCancelledReturnBitfield21 |-> crossOrderCancelledReturnBitfield21.value,
         crossOrderCancelledOrderAllocations |-> crossOrderCancelledOrderAllocations.value,
         priceLong                           |-> priceLong.value,
         execInst                            |-> execInst.value,
         symbolLong                          |-> symbolLong.value,
         clearingFirm                        |-> clearingFirm.value,
         orderQtyLong                        |-> orderQtyLong.value,
         preventMatch                        |-> preventMatch.value,
         maturityDate                        |-> maturityDate.value,
         strikePrice                         |-> strikePrice.value,
         putOrCall                           |-> putOrCall.value,
         attributedQuote                     |-> attributedQuote.value,
         targetPartyId                       |-> targetPartyId.value,
         auctionId                           |-> auctionId.value,
         crossType                           |-> crossType.value,
         crossPrioritization                 |-> crossPrioritization.value,
         routingFirmId                       |-> routingFirmId.value,
         equityPartyId                       |-> equityPartyId.value,
         frequentTraderId                    |-> frequentTraderId.value,
         compression                         |-> compression.value,
         crossInitiator                      |-> crossInitiator.value,
         crossOnBehalfOfId                   |-> crossOnBehalfOfId.value ], crossOnBehalfOfId.rest)

(* Cross Order Cancelled Message with each field marked present by fields before it there exactly where they say *)
SettleCrossOrderCancelledMessage(message) ==
    LET settled1 == [message EXCEPT !.crossOrderCancelledReturnBitfield1 = IF message.numberOfReturnBitfields >= 1 THEN (IF message.crossOrderCancelledReturnBitfield1 = << >> THEN <<0>> ELSE message.crossOrderCancelledReturnBitfield1) ELSE << >>]
        settled2 == [settled1 EXCEPT !.crossOrderCancelledReturnBitfield2 = IF settled1.numberOfReturnBitfields >= 2 THEN (IF settled1.crossOrderCancelledReturnBitfield2 = << >> THEN <<0>> ELSE settled1.crossOrderCancelledReturnBitfield2) ELSE << >>]
        settled3 == [settled2 EXCEPT !.crossOrderCancelledReturnBitfield3 = IF settled2.numberOfReturnBitfields >= 3 THEN (IF settled2.crossOrderCancelledReturnBitfield3 = << >> THEN <<0>> ELSE settled2.crossOrderCancelledReturnBitfield3) ELSE << >>]
        settled4 == [settled3 EXCEPT !.crossOrderCancelledReturnBitfield4 = IF settled3.numberOfReturnBitfields >= 4 THEN (IF settled3.crossOrderCancelledReturnBitfield4 = << >> THEN <<0>> ELSE settled3.crossOrderCancelledReturnBitfield4) ELSE << >>]
        settled5 == [settled4 EXCEPT !.crossOrderCancelledReturnBitfield5 = IF settled4.numberOfReturnBitfields >= 5 THEN (IF settled4.crossOrderCancelledReturnBitfield5 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled4.crossOrderCancelledReturnBitfield5) ELSE << >>]
        settled6 == [settled5 EXCEPT !.crossOrderCancelledReturnBitfield6 = IF settled5.numberOfReturnBitfields >= 6 THEN (IF settled5.crossOrderCancelledReturnBitfield6 = << >> THEN <<0>> ELSE settled5.crossOrderCancelledReturnBitfield6) ELSE << >>]
        settled7 == [settled6 EXCEPT !.crossOrderCancelledReturnBitfield7 = IF settled6.numberOfReturnBitfields >= 7 THEN (IF settled6.crossOrderCancelledReturnBitfield7 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled6.crossOrderCancelledReturnBitfield7) ELSE << >>]
        settled8 == [settled7 EXCEPT !.crossOrderCancelledReturnBitfield8 = IF settled7.numberOfReturnBitfields >= 8 THEN (IF settled7.crossOrderCancelledReturnBitfield8 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled7.crossOrderCancelledReturnBitfield8) ELSE << >>]
        settled9 == [settled8 EXCEPT !.crossOrderCancelledReturnBitfield9 = IF settled8.numberOfReturnBitfields >= 9 THEN (IF settled8.crossOrderCancelledReturnBitfield9 = << >> THEN <<0>> ELSE settled8.crossOrderCancelledReturnBitfield9) ELSE << >>]
        settled10 == [settled9 EXCEPT !.crossOrderCancelledReturnBitfield10 = IF settled9.numberOfReturnBitfields >= 10 THEN (IF settled9.crossOrderCancelledReturnBitfield10 = << >> THEN <<0>> ELSE settled9.crossOrderCancelledReturnBitfield10) ELSE << >>]
        settled11 == [settled10 EXCEPT !.crossOrderCancelledReturnBitfield11 = IF settled10.numberOfReturnBitfields >= 11 THEN (IF settled10.crossOrderCancelledReturnBitfield11 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled10.crossOrderCancelledReturnBitfield11) ELSE << >>]
        settled12 == [settled11 EXCEPT !.crossOrderCancelledReturnBitfield12 = IF settled11.numberOfReturnBitfields >= 12 THEN (IF settled11.crossOrderCancelledReturnBitfield12 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled11.crossOrderCancelledReturnBitfield12) ELSE << >>]
        settled13 == [settled12 EXCEPT !.crossOrderCancelledReturnBitfield13 = IF settled12.numberOfReturnBitfields >= 13 THEN (IF settled12.crossOrderCancelledReturnBitfield13 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled12.crossOrderCancelledReturnBitfield13) ELSE << >>]
        settled14 == [settled13 EXCEPT !.crossOrderCancelledReturnBitfield14 = IF settled13.numberOfReturnBitfields >= 14 THEN (IF settled13.crossOrderCancelledReturnBitfield14 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled13.crossOrderCancelledReturnBitfield14) ELSE << >>]
        settled15 == [settled14 EXCEPT !.crossOrderCancelledReturnBitfield15 = IF settled14.numberOfReturnBitfields >= 15 THEN (IF settled14.crossOrderCancelledReturnBitfield15 = << >> THEN <<0>> ELSE settled14.crossOrderCancelledReturnBitfield15) ELSE << >>]
        settled16 == [settled15 EXCEPT !.crossOrderCancelledReturnBitfield16 = IF settled15.numberOfReturnBitfields >= 16 THEN (IF settled15.crossOrderCancelledReturnBitfield16 = << >> THEN <<0>> ELSE settled15.crossOrderCancelledReturnBitfield16) ELSE << >>]
        settled17 == [settled16 EXCEPT !.crossOrderCancelledReturnBitfield17 = IF settled16.numberOfReturnBitfields >= 17 THEN (IF settled16.crossOrderCancelledReturnBitfield17 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled16.crossOrderCancelledReturnBitfield17) ELSE << >>]
        settled18 == [settled17 EXCEPT !.crossOrderCancelledReturnBitfield18 = IF settled17.numberOfReturnBitfields >= 18 THEN (IF settled17.crossOrderCancelledReturnBitfield18 = << >> THEN <<0>> ELSE settled17.crossOrderCancelledReturnBitfield18) ELSE << >>]
        settled19 == [settled18 EXCEPT !.crossOrderCancelledReturnBitfield19 = IF settled18.numberOfReturnBitfields >= 19 THEN (IF settled18.crossOrderCancelledReturnBitfield19 = << >> THEN <<0>> ELSE settled18.crossOrderCancelledReturnBitfield19) ELSE << >>]
        settled20 == [settled19 EXCEPT !.crossOrderCancelledReturnBitfield20 = IF settled19.numberOfReturnBitfields >= 20 THEN (IF settled19.crossOrderCancelledReturnBitfield20 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled19.crossOrderCancelledReturnBitfield20) ELSE << >>]
        settled21 == [settled20 EXCEPT !.crossOrderCancelledReturnBitfield21 = IF settled20.numberOfReturnBitfields >= 21 THEN (IF settled20.crossOrderCancelledReturnBitfield21 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled20.crossOrderCancelledReturnBitfield21) ELSE << >>]
        settled22 == [settled21 EXCEPT !.crossOrderCancelledOrderAllocations = [i \in DOMAIN settled21.crossOrderCancelledOrderAllocations |-> SettleCrossOrderCancelledOrderAllocations(settled21.crossOrderCancelledOrderAllocations[i], settled21.numberOfReturnBitfields, settled21.crossOrderCancelledReturnBitfield1, settled21.crossOrderCancelledReturnBitfield2, settled21.crossOrderCancelledReturnBitfield3, settled21.crossOrderCancelledReturnBitfield4, settled21.crossOrderCancelledReturnBitfield9, settled21.crossOrderCancelledReturnBitfield10)]]
        settled23 == [settled22 EXCEPT !.priceLong = IF settled22.numberOfReturnBitfields >= 1 /\ (settled22.crossOrderCancelledReturnBitfield1 # << >> /\ (settled22.crossOrderCancelledReturnBitfield1[1] \div 4) % 2 > 0) THEN (IF settled22.priceLong = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled22.priceLong) ELSE << >>]
        settled24 == [settled23 EXCEPT !.execInst = IF settled23.numberOfReturnBitfields >= 1 /\ (settled23.crossOrderCancelledReturnBitfield1 # << >> /\ (settled23.crossOrderCancelledReturnBitfield1[1] \div 8) % 2 > 0) THEN (IF settled23.execInst = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled23.execInst) ELSE << >>]
        settled25 == [settled24 EXCEPT !.symbolLong = IF settled24.numberOfReturnBitfields >= 2 /\ (settled24.crossOrderCancelledReturnBitfield2 # << >> /\ settled24.crossOrderCancelledReturnBitfield2[1] % 2 > 0) THEN (IF settled24.symbolLong = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled24.symbolLong) ELSE << >>]
        settled26 == [settled25 EXCEPT !.clearingFirm = IF settled25.numberOfReturnBitfields >= 3 /\ (settled25.crossOrderCancelledReturnBitfield3 # << >> /\ (settled25.crossOrderCancelledReturnBitfield3[1] \div 2) % 2 > 0) THEN (IF settled25.clearingFirm = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled25.clearingFirm) ELSE << >>]
        settled27 == [settled26 EXCEPT !.orderQtyLong = IF settled26.numberOfReturnBitfields >= 3 /\ (settled26.crossOrderCancelledReturnBitfield3 # << >> /\ (settled26.crossOrderCancelledReturnBitfield3[1] \div 64) % 2 > 0) THEN (IF settled26.orderQtyLong = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled26.orderQtyLong) ELSE << >>]
        settled28 == [settled27 EXCEPT !.preventMatch = IF settled27.numberOfReturnBitfields >= 3 /\ (settled27.crossOrderCancelledReturnBitfield3 # << >> /\ (settled27.crossOrderCancelledReturnBitfield3[1] \div 128) % 2 > 0) THEN (IF settled27.preventMatch = << >> THEN <<[i \in 1 .. 3 |-> 0]>> ELSE settled27.preventMatch) ELSE << >>]
        settled29 == [settled28 EXCEPT !.maturityDate = IF settled28.numberOfReturnBitfields >= 4 /\ (settled28.crossOrderCancelledReturnBitfield4 # << >> /\ settled28.crossOrderCancelledReturnBitfield4[1] % 2 > 0) THEN (IF settled28.maturityDate = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled28.maturityDate) ELSE << >>]
        settled30 == [settled29 EXCEPT !.strikePrice = IF settled29.numberOfReturnBitfields >= 4 /\ (settled29.crossOrderCancelledReturnBitfield4 # << >> /\ (settled29.crossOrderCancelledReturnBitfield4[1] \div 2) % 2 > 0) THEN (IF settled29.strikePrice = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled29.strikePrice) ELSE << >>]
        settled31 == [settled30 EXCEPT !.putOrCall = IF settled30.numberOfReturnBitfields >= 4 /\ (settled30.crossOrderCancelledReturnBitfield4 # << >> /\ (settled30.crossOrderCancelledReturnBitfield4[1] \div 4) % 2 > 0) THEN (IF settled30.putOrCall = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled30.putOrCall) ELSE << >>]
        settled32 == [settled31 EXCEPT !.attributedQuote = IF settled31.numberOfReturnBitfields >= 6 /\ (settled31.crossOrderCancelledReturnBitfield6 # << >> /\ (settled31.crossOrderCancelledReturnBitfield6[1] \div 8) % 2 > 0) THEN (IF settled31.attributedQuote = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled31.attributedQuote) ELSE << >>]
        settled33 == [settled32 EXCEPT !.targetPartyId = IF settled32.numberOfReturnBitfields >= 9 /\ (settled32.crossOrderCancelledReturnBitfield9 # << >> /\ (settled32.crossOrderCancelledReturnBitfield9[1] \div 2) % 2 > 0) THEN (IF settled32.targetPartyId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled32.targetPartyId) ELSE << >>]
        settled34 == [settled33 EXCEPT !.auctionId = IF settled33.numberOfReturnBitfields >= 9 /\ (settled33.crossOrderCancelledReturnBitfield9 # << >> /\ (settled33.crossOrderCancelledReturnBitfield9[1] \div 4) % 2 > 0) THEN (IF settled33.auctionId = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled33.auctionId) ELSE << >>]
        settled35 == [settled34 EXCEPT !.crossType = IF settled34.numberOfReturnBitfields >= 9 /\ (settled34.crossOrderCancelledReturnBitfield9 # << >> /\ (settled34.crossOrderCancelledReturnBitfield9[1] \div 64) % 2 > 0) THEN (IF settled34.crossType = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled34.crossType) ELSE << >>]
        settled36 == [settled35 EXCEPT !.crossPrioritization = IF settled35.numberOfReturnBitfields >= 9 /\ (settled35.crossOrderCancelledReturnBitfield9 # << >> /\ (settled35.crossOrderCancelledReturnBitfield9[1] \div 128) % 2 > 0) THEN (IF settled35.crossPrioritization = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled35.crossPrioritization) ELSE << >>]
        settled37 == [settled36 EXCEPT !.routingFirmId = IF settled36.numberOfReturnBitfields >= 10 /\ (settled36.crossOrderCancelledReturnBitfield10 # << >> /\ (settled36.crossOrderCancelledReturnBitfield10[1] \div 8) % 2 > 0) THEN (IF settled36.routingFirmId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled36.routingFirmId) ELSE << >>]
        settled38 == [settled37 EXCEPT !.equityPartyId = IF settled37.numberOfReturnBitfields >= 15 /\ (settled37.crossOrderCancelledReturnBitfield15 # << >> /\ (settled37.crossOrderCancelledReturnBitfield15[1] \div 2) % 2 > 0) THEN (IF settled37.equityPartyId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled37.equityPartyId) ELSE << >>]
        settled39 == [settled38 EXCEPT !.frequentTraderId = IF settled38.numberOfReturnBitfields >= 16 /\ (settled38.crossOrderCancelledReturnBitfield16 # << >> /\ settled38.crossOrderCancelledReturnBitfield16[1] % 2 > 0) THEN (IF settled38.frequentTraderId = << >> THEN <<[i \in 1 .. 6 |-> 0]>> ELSE settled38.frequentTraderId) ELSE << >>]
        settled40 == [settled39 EXCEPT !.compression = IF settled39.numberOfReturnBitfields >= 16 /\ (settled39.crossOrderCancelledReturnBitfield16 # << >> /\ (settled39.crossOrderCancelledReturnBitfield16[1] \div 8) % 2 > 0) THEN (IF settled39.compression = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled39.compression) ELSE << >>]
        settled41 == [settled40 EXCEPT !.crossInitiator = IF settled40.numberOfReturnBitfields >= 18 /\ (settled40.crossOrderCancelledReturnBitfield18 # << >> /\ (settled40.crossOrderCancelledReturnBitfield18[1] \div 2) % 2 > 0) THEN (IF settled40.crossInitiator = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled40.crossInitiator) ELSE << >>]
        settled42 == [settled41 EXCEPT !.crossOnBehalfOfId = IF settled41.numberOfReturnBitfields >= 19 /\ (settled41.crossOrderCancelledReturnBitfield19 # << >> /\ (settled41.crossOrderCancelledReturnBitfield19[1] \div 4) % 2 > 0) THEN (IF settled41.crossOnBehalfOfId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled41.crossOnBehalfOfId) ELSE << >>]
    IN  settled42

ZeroCrossOrderCancelledMessage ==
    SettleCrossOrderCancelledMessage([ transactionTime                     |-> [i \in 1 .. 8 |-> 0],
                                       crossId                             |-> [i \in 1 .. 20 |-> 0],
                                       cancelReason                        |-> [i \in 1 .. 1 |-> 0],
                                       reserved1                           |-> [i \in 1 .. 1 |-> 0],
                                       numberOfReturnBitfields             |-> 0,
                                       crossOrderCancelledReturnBitfield1  |-> << >>,
                                       crossOrderCancelledReturnBitfield2  |-> << >>,
                                       crossOrderCancelledReturnBitfield3  |-> << >>,
                                       crossOrderCancelledReturnBitfield4  |-> << >>,
                                       crossOrderCancelledReturnBitfield5  |-> << >>,
                                       crossOrderCancelledReturnBitfield6  |-> << >>,
                                       crossOrderCancelledReturnBitfield7  |-> << >>,
                                       crossOrderCancelledReturnBitfield8  |-> << >>,
                                       crossOrderCancelledReturnBitfield9  |-> << >>,
                                       crossOrderCancelledReturnBitfield10 |-> << >>,
                                       crossOrderCancelledReturnBitfield11 |-> << >>,
                                       crossOrderCancelledReturnBitfield12 |-> << >>,
                                       crossOrderCancelledReturnBitfield13 |-> << >>,
                                       crossOrderCancelledReturnBitfield14 |-> << >>,
                                       crossOrderCancelledReturnBitfield15 |-> << >>,
                                       crossOrderCancelledReturnBitfield16 |-> << >>,
                                       crossOrderCancelledReturnBitfield17 |-> << >>,
                                       crossOrderCancelledReturnBitfield18 |-> << >>,
                                       crossOrderCancelledReturnBitfield19 |-> << >>,
                                       crossOrderCancelledReturnBitfield20 |-> << >>,
                                       crossOrderCancelledReturnBitfield21 |-> << >>,
                                       crossOrderCancelledOrderAllocations |-> << >>,
                                       priceLong                           |-> << >>,
                                       execInst                            |-> << >>,
                                       symbolLong                          |-> << >>,
                                       clearingFirm                        |-> << >>,
                                       orderQtyLong                        |-> << >>,
                                       preventMatch                        |-> << >>,
                                       maturityDate                        |-> << >>,
                                       strikePrice                         |-> << >>,
                                       putOrCall                           |-> << >>,
                                       attributedQuote                     |-> << >>,
                                       targetPartyId                       |-> << >>,
                                       auctionId                           |-> << >>,
                                       crossType                           |-> << >>,
                                       crossPrioritization                 |-> << >>,
                                       routingFirmId                       |-> << >>,
                                       equityPartyId                       |-> << >>,
                                       frequentTraderId                    |-> << >>,
                                       compression                         |-> << >>,
                                       crossInitiator                      |-> << >>,
                                       crossOnBehalfOfId                   |-> << >> ])

(* Cross Order Cancelled Message at zero, then each field in turn at the values it is checked at *)
CheckedCrossOrderCancelledMessage ==
    { ZeroCrossOrderCancelledMessage }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.transactionTime = one]) : one \in Sample(8) }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.crossId = one]) : one \in Sample(20) }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.cancelReason = one]) : one \in Sample(1) }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.reserved1 = one]) : one \in Sample(1) }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = one]) : one \in {0, 1, 255} }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 1, !.crossOrderCancelledReturnBitfield1 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 2, !.crossOrderCancelledReturnBitfield2 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 3, !.crossOrderCancelledReturnBitfield3 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 4, !.crossOrderCancelledReturnBitfield4 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 5, !.crossOrderCancelledReturnBitfield5 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 6, !.crossOrderCancelledReturnBitfield6 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 7, !.crossOrderCancelledReturnBitfield7 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 8, !.crossOrderCancelledReturnBitfield8 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 9, !.crossOrderCancelledReturnBitfield9 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 10, !.crossOrderCancelledReturnBitfield10 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 11, !.crossOrderCancelledReturnBitfield11 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 12, !.crossOrderCancelledReturnBitfield12 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 13, !.crossOrderCancelledReturnBitfield13 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 14, !.crossOrderCancelledReturnBitfield14 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 15, !.crossOrderCancelledReturnBitfield15 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 16, !.crossOrderCancelledReturnBitfield16 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 17, !.crossOrderCancelledReturnBitfield17 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 18, !.crossOrderCancelledReturnBitfield18 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 19, !.crossOrderCancelledReturnBitfield19 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 20, !.crossOrderCancelledReturnBitfield20 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 21, !.crossOrderCancelledReturnBitfield21 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.crossOrderCancelledOrderAllocations = one]) : one \in SampleLists(OneCrossOrderCancelledOrderAllocations) }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 1, !.crossOrderCancelledReturnBitfield1 = <<1>>, !.crossOrderCancelledOrderAllocations = one]) : one \in SampleLists(OneCrossOrderCancelledOrderAllocations) }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 10, !.crossOrderCancelledReturnBitfield10 = <<2>>, !.crossOrderCancelledOrderAllocations = one]) : one \in SampleLists(OneCrossOrderCancelledOrderAllocations) }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 2, !.crossOrderCancelledReturnBitfield2 = <<64>>, !.crossOrderCancelledOrderAllocations = one]) : one \in SampleLists(OneCrossOrderCancelledOrderAllocations) }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 4, !.crossOrderCancelledReturnBitfield4 = <<8>>, !.crossOrderCancelledOrderAllocations = one]) : one \in SampleLists(OneCrossOrderCancelledOrderAllocations) }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 10, !.crossOrderCancelledReturnBitfield10 = <<4>>, !.crossOrderCancelledOrderAllocations = one]) : one \in SampleLists(OneCrossOrderCancelledOrderAllocations) }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 3, !.crossOrderCancelledReturnBitfield3 = <<1>>, !.crossOrderCancelledOrderAllocations = one]) : one \in SampleLists(OneCrossOrderCancelledOrderAllocations) }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 9, !.crossOrderCancelledReturnBitfield9 = <<32>>, !.crossOrderCancelledOrderAllocations = one]) : one \in SampleLists(OneCrossOrderCancelledOrderAllocations) }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 1, !.crossOrderCancelledReturnBitfield1 = <<4>>, !.priceLong = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 1, !.crossOrderCancelledReturnBitfield1 = <<8>>, !.execInst = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 2, !.crossOrderCancelledReturnBitfield2 = <<1>>, !.symbolLong = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 3, !.crossOrderCancelledReturnBitfield3 = <<2>>, !.clearingFirm = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 3, !.crossOrderCancelledReturnBitfield3 = <<64>>, !.orderQtyLong = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 3, !.crossOrderCancelledReturnBitfield3 = <<128>>, !.preventMatch = one]) : one \in { <<held>> : held \in Sample(3) } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 4, !.crossOrderCancelledReturnBitfield4 = <<1>>, !.maturityDate = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 4, !.crossOrderCancelledReturnBitfield4 = <<2>>, !.strikePrice = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 4, !.crossOrderCancelledReturnBitfield4 = <<4>>, !.putOrCall = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 6, !.crossOrderCancelledReturnBitfield6 = <<8>>, !.attributedQuote = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 9, !.crossOrderCancelledReturnBitfield9 = <<2>>, !.targetPartyId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 9, !.crossOrderCancelledReturnBitfield9 = <<4>>, !.auctionId = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 9, !.crossOrderCancelledReturnBitfield9 = <<64>>, !.crossType = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 9, !.crossOrderCancelledReturnBitfield9 = <<128>>, !.crossPrioritization = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 10, !.crossOrderCancelledReturnBitfield10 = <<8>>, !.routingFirmId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 15, !.crossOrderCancelledReturnBitfield15 = <<2>>, !.equityPartyId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 16, !.crossOrderCancelledReturnBitfield16 = <<1>>, !.frequentTraderId = one]) : one \in { <<held>> : held \in Sample(6) } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 16, !.crossOrderCancelledReturnBitfield16 = <<8>>, !.compression = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 18, !.crossOrderCancelledReturnBitfield18 = <<2>>, !.crossInitiator = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 19, !.crossOrderCancelledReturnBitfield19 = <<4>>, !.crossOnBehalfOfId = one]) : one \in { <<held>> : held \in Sample(4) } }

(***************************************************************************)
(* Cancel Rejected Message                                                 *)
(***************************************************************************)

CancelRejectedMessage ==
    [ transactionTime                : Sample(8),
      clOrdId                        : Sample(20),
      cancelRejectReason             : Sample(1),
      text                           : Sample(60),
      reserved1                      : Sample(1),
      numberOfReturnBitfields        : 0 .. 255,
      cancelRejectedReturnBitfield1  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      cancelRejectedReturnBitfield2  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      cancelRejectedReturnBitfield3  : { << >> } \cup { <<held>> : held \in Sample(1) },
      cancelRejectedReturnBitfield4  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      cancelRejectedReturnBitfield5  : { << >> } \cup { <<held>> : held \in Sample(1) },
      cancelRejectedReturnBitfield6  : { << >> } \cup { <<held>> : held \in Sample(1) },
      cancelRejectedReturnBitfield7  : { << >> } \cup { <<held>> : held \in Sample(1) },
      cancelRejectedReturnBitfield8  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      cancelRejectedReturnBitfield9  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      cancelRejectedReturnBitfield10 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      cancelRejectedReturnBitfield11 : { << >> } \cup { <<held>> : held \in Sample(1) },
      cancelRejectedReturnBitfield12 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      cancelRejectedReturnBitfield13 : { << >> } \cup { <<held>> : held \in Sample(1) },
      cancelRejectedReturnBitfield14 : { << >> } \cup { <<held>> : held \in Sample(1) },
      cancelRejectedReturnBitfield15 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      cancelRejectedReturnBitfield16 : { << >> } \cup { <<held>> : held \in Sample(1) },
      cancelRejectedReturnBitfield17 : { << >> } \cup { <<held>> : held \in Sample(1) },
      cancelRejectedReturnBitfield18 : { << >> } \cup { <<held>> : held \in Sample(1) },
      cancelRejectedReturnBitfield19 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      side                           : { << >> } \cup { <<held>> : held \in Sample(1) },
      priceLong                      : { << >> } \cup { <<held>> : held \in Sample(8) },
      execInst                       : { << >> } \cup { <<held>> : held \in Sample(1) },
      ordType                        : { << >> } \cup { <<held>> : held \in Sample(1) },
      timeInForce                    : { << >> } \cup { <<held>> : held \in Sample(1) },
      minQty                         : { << >> } \cup { <<held>> : held \in Sample(4) },
      symbolLong                     : { << >> } \cup { <<held>> : held \in Sample(8) },
      capacity                       : { << >> } \cup { <<held>> : held \in Sample(1) },
      maturityDate                   : { << >> } \cup { <<held>> : held \in Sample(4) },
      strikePrice                    : { << >> } \cup { <<held>> : held \in Sample(8) },
      putOrCall                      : { << >> } \cup { <<held>> : held \in Sample(1) },
      openClose                      : { << >> } \cup { <<held>> : held \in Sample(1) },
      correctedSize                  : { << >> } \cup { <<held>> : held \in Sample(4) },
      echoText                       : { << >> } \cup { <<held>> : held \in Sample(64) },
      stopPx                         : { << >> } \cup { <<held>> : held \in Sample(8) },
      marketingFeeCode               : { << >> } \cup { <<held>> : held \in Sample(2) },
      targetPartyId                  : { << >> } \cup { <<held>> : held \in Sample(4) },
      auctionId                      : { << >> } \cup { <<held>> : held \in Sample(8) },
      cmtaNumber                     : { << >> } \cup { <<held>> : held \in Sample(4) },
      crossId                        : { << >> } \cup { <<held>> : held \in Sample(20) },
      allocQty                       : { << >> } \cup { <<held>> : held \in Sample(4) },
      giveUpFirmId                   : { << >> } \cup { <<held>> : held \in Sample(4) },
      routingFirmId                  : { << >> } \cup { <<held>> : held \in Sample(4) },
      crossExclusionIndicator        : { << >> } \cup { <<held>> : held \in Sample(1) },
      clearingOptionalData           : { << >> } \cup { <<held>> : held \in Sample(16) },
      massCancelId                   : { << >> } \cup { <<held>> : held \in Sample(20) },
      stopPxType                     : { << >> } \cup { <<held>> : held \in Sample(1) } ]

EncodeCancelRejectedMessage(message) ==
    message.transactionTime
        \o message.clOrdId
        \o message.cancelRejectReason
        \o message.text
        \o message.reserved1
        \o EncodeUIntBE(message.numberOfReturnBitfields, 1)
        \o (IF message.cancelRejectedReturnBitfield1 = << >> THEN << >> ELSE EncodeUIntLE(message.cancelRejectedReturnBitfield1[1], 1))
        \o (IF message.cancelRejectedReturnBitfield2 = << >> THEN << >> ELSE EncodeUIntLE(message.cancelRejectedReturnBitfield2[1], 1))
        \o (IF message.cancelRejectedReturnBitfield3 = << >> THEN << >> ELSE message.cancelRejectedReturnBitfield3[1])
        \o (IF message.cancelRejectedReturnBitfield4 = << >> THEN << >> ELSE EncodeUIntLE(message.cancelRejectedReturnBitfield4[1], 1))
        \o (IF message.cancelRejectedReturnBitfield5 = << >> THEN << >> ELSE message.cancelRejectedReturnBitfield5[1])
        \o (IF message.cancelRejectedReturnBitfield6 = << >> THEN << >> ELSE message.cancelRejectedReturnBitfield6[1])
        \o (IF message.cancelRejectedReturnBitfield7 = << >> THEN << >> ELSE message.cancelRejectedReturnBitfield7[1])
        \o (IF message.cancelRejectedReturnBitfield8 = << >> THEN << >> ELSE EncodeUIntLE(message.cancelRejectedReturnBitfield8[1], 1))
        \o (IF message.cancelRejectedReturnBitfield9 = << >> THEN << >> ELSE EncodeUIntLE(message.cancelRejectedReturnBitfield9[1], 1))
        \o (IF message.cancelRejectedReturnBitfield10 = << >> THEN << >> ELSE EncodeUIntLE(message.cancelRejectedReturnBitfield10[1], 1))
        \o (IF message.cancelRejectedReturnBitfield11 = << >> THEN << >> ELSE message.cancelRejectedReturnBitfield11[1])
        \o (IF message.cancelRejectedReturnBitfield12 = << >> THEN << >> ELSE EncodeUIntLE(message.cancelRejectedReturnBitfield12[1], 1))
        \o (IF message.cancelRejectedReturnBitfield13 = << >> THEN << >> ELSE message.cancelRejectedReturnBitfield13[1])
        \o (IF message.cancelRejectedReturnBitfield14 = << >> THEN << >> ELSE message.cancelRejectedReturnBitfield14[1])
        \o (IF message.cancelRejectedReturnBitfield15 = << >> THEN << >> ELSE EncodeUIntLE(message.cancelRejectedReturnBitfield15[1], 1))
        \o (IF message.cancelRejectedReturnBitfield16 = << >> THEN << >> ELSE message.cancelRejectedReturnBitfield16[1])
        \o (IF message.cancelRejectedReturnBitfield17 = << >> THEN << >> ELSE message.cancelRejectedReturnBitfield17[1])
        \o (IF message.cancelRejectedReturnBitfield18 = << >> THEN << >> ELSE message.cancelRejectedReturnBitfield18[1])
        \o (IF message.cancelRejectedReturnBitfield19 = << >> THEN << >> ELSE EncodeUIntLE(message.cancelRejectedReturnBitfield19[1], 1))
        \o (IF message.side = << >> THEN << >> ELSE message.side[1])
        \o (IF message.priceLong = << >> THEN << >> ELSE message.priceLong[1])
        \o (IF message.execInst = << >> THEN << >> ELSE message.execInst[1])
        \o (IF message.ordType = << >> THEN << >> ELSE message.ordType[1])
        \o (IF message.timeInForce = << >> THEN << >> ELSE message.timeInForce[1])
        \o (IF message.minQty = << >> THEN << >> ELSE message.minQty[1])
        \o (IF message.symbolLong = << >> THEN << >> ELSE message.symbolLong[1])
        \o (IF message.capacity = << >> THEN << >> ELSE message.capacity[1])
        \o (IF message.maturityDate = << >> THEN << >> ELSE message.maturityDate[1])
        \o (IF message.strikePrice = << >> THEN << >> ELSE message.strikePrice[1])
        \o (IF message.putOrCall = << >> THEN << >> ELSE message.putOrCall[1])
        \o (IF message.openClose = << >> THEN << >> ELSE message.openClose[1])
        \o (IF message.correctedSize = << >> THEN << >> ELSE message.correctedSize[1])
        \o (IF message.echoText = << >> THEN << >> ELSE message.echoText[1])
        \o (IF message.stopPx = << >> THEN << >> ELSE message.stopPx[1])
        \o (IF message.marketingFeeCode = << >> THEN << >> ELSE message.marketingFeeCode[1])
        \o (IF message.targetPartyId = << >> THEN << >> ELSE message.targetPartyId[1])
        \o (IF message.auctionId = << >> THEN << >> ELSE message.auctionId[1])
        \o (IF message.cmtaNumber = << >> THEN << >> ELSE message.cmtaNumber[1])
        \o (IF message.crossId = << >> THEN << >> ELSE message.crossId[1])
        \o (IF message.allocQty = << >> THEN << >> ELSE message.allocQty[1])
        \o (IF message.giveUpFirmId = << >> THEN << >> ELSE message.giveUpFirmId[1])
        \o (IF message.routingFirmId = << >> THEN << >> ELSE message.routingFirmId[1])
        \o (IF message.crossExclusionIndicator = << >> THEN << >> ELSE message.crossExclusionIndicator[1])
        \o (IF message.clearingOptionalData = << >> THEN << >> ELSE message.clearingOptionalData[1])
        \o (IF message.massCancelId = << >> THEN << >> ELSE message.massCancelId[1])
        \o (IF message.stopPxType = << >> THEN << >> ELSE message.stopPxType[1])

DecodeCancelRejectedMessage(bytes) ==
    LET transactionTime == ReadBytes(bytes, 8) IN IF ~transactionTime.ok THEN Fail ELSE
    LET clOrdId == ReadBytes(transactionTime.rest, 20) IN IF ~clOrdId.ok THEN Fail ELSE
    LET cancelRejectReason == ReadBytes(clOrdId.rest, 1) IN IF ~cancelRejectReason.ok THEN Fail ELSE
    LET text == ReadBytes(cancelRejectReason.rest, 60) IN IF ~text.ok THEN Fail ELSE
    LET reserved1 == ReadBytes(text.rest, 1) IN IF ~reserved1.ok THEN Fail ELSE
    LET numberOfReturnBitfields == ReadUIntBE(reserved1.rest, 1) IN IF ~numberOfReturnBitfields.ok THEN Fail ELSE
    LET cancelRejectedReturnBitfield1 == ReadWhen(numberOfReturnBitfields.value >= 1, ReadUIntLE(numberOfReturnBitfields.rest, 1), numberOfReturnBitfields.rest) IN IF ~cancelRejectedReturnBitfield1.ok THEN Fail ELSE
    LET cancelRejectedReturnBitfield2 == ReadWhen(numberOfReturnBitfields.value >= 2, ReadUIntLE(cancelRejectedReturnBitfield1.rest, 1), cancelRejectedReturnBitfield1.rest) IN IF ~cancelRejectedReturnBitfield2.ok THEN Fail ELSE
    LET cancelRejectedReturnBitfield3 == ReadWhen(numberOfReturnBitfields.value >= 3, ReadBytes(cancelRejectedReturnBitfield2.rest, 1), cancelRejectedReturnBitfield2.rest) IN IF ~cancelRejectedReturnBitfield3.ok THEN Fail ELSE
    LET cancelRejectedReturnBitfield4 == ReadWhen(numberOfReturnBitfields.value >= 4, ReadUIntLE(cancelRejectedReturnBitfield3.rest, 1), cancelRejectedReturnBitfield3.rest) IN IF ~cancelRejectedReturnBitfield4.ok THEN Fail ELSE
    LET cancelRejectedReturnBitfield5 == ReadWhen(numberOfReturnBitfields.value >= 5, ReadBytes(cancelRejectedReturnBitfield4.rest, 1), cancelRejectedReturnBitfield4.rest) IN IF ~cancelRejectedReturnBitfield5.ok THEN Fail ELSE
    LET cancelRejectedReturnBitfield6 == ReadWhen(numberOfReturnBitfields.value >= 6, ReadBytes(cancelRejectedReturnBitfield5.rest, 1), cancelRejectedReturnBitfield5.rest) IN IF ~cancelRejectedReturnBitfield6.ok THEN Fail ELSE
    LET cancelRejectedReturnBitfield7 == ReadWhen(numberOfReturnBitfields.value >= 7, ReadBytes(cancelRejectedReturnBitfield6.rest, 1), cancelRejectedReturnBitfield6.rest) IN IF ~cancelRejectedReturnBitfield7.ok THEN Fail ELSE
    LET cancelRejectedReturnBitfield8 == ReadWhen(numberOfReturnBitfields.value >= 8, ReadUIntLE(cancelRejectedReturnBitfield7.rest, 1), cancelRejectedReturnBitfield7.rest) IN IF ~cancelRejectedReturnBitfield8.ok THEN Fail ELSE
    LET cancelRejectedReturnBitfield9 == ReadWhen(numberOfReturnBitfields.value >= 9, ReadUIntLE(cancelRejectedReturnBitfield8.rest, 1), cancelRejectedReturnBitfield8.rest) IN IF ~cancelRejectedReturnBitfield9.ok THEN Fail ELSE
    LET cancelRejectedReturnBitfield10 == ReadWhen(numberOfReturnBitfields.value >= 10, ReadUIntLE(cancelRejectedReturnBitfield9.rest, 1), cancelRejectedReturnBitfield9.rest) IN IF ~cancelRejectedReturnBitfield10.ok THEN Fail ELSE
    LET cancelRejectedReturnBitfield11 == ReadWhen(numberOfReturnBitfields.value >= 11, ReadBytes(cancelRejectedReturnBitfield10.rest, 1), cancelRejectedReturnBitfield10.rest) IN IF ~cancelRejectedReturnBitfield11.ok THEN Fail ELSE
    LET cancelRejectedReturnBitfield12 == ReadWhen(numberOfReturnBitfields.value >= 12, ReadUIntLE(cancelRejectedReturnBitfield11.rest, 1), cancelRejectedReturnBitfield11.rest) IN IF ~cancelRejectedReturnBitfield12.ok THEN Fail ELSE
    LET cancelRejectedReturnBitfield13 == ReadWhen(numberOfReturnBitfields.value >= 13, ReadBytes(cancelRejectedReturnBitfield12.rest, 1), cancelRejectedReturnBitfield12.rest) IN IF ~cancelRejectedReturnBitfield13.ok THEN Fail ELSE
    LET cancelRejectedReturnBitfield14 == ReadWhen(numberOfReturnBitfields.value >= 14, ReadBytes(cancelRejectedReturnBitfield13.rest, 1), cancelRejectedReturnBitfield13.rest) IN IF ~cancelRejectedReturnBitfield14.ok THEN Fail ELSE
    LET cancelRejectedReturnBitfield15 == ReadWhen(numberOfReturnBitfields.value >= 15, ReadUIntLE(cancelRejectedReturnBitfield14.rest, 1), cancelRejectedReturnBitfield14.rest) IN IF ~cancelRejectedReturnBitfield15.ok THEN Fail ELSE
    LET cancelRejectedReturnBitfield16 == ReadWhen(numberOfReturnBitfields.value >= 16, ReadBytes(cancelRejectedReturnBitfield15.rest, 1), cancelRejectedReturnBitfield15.rest) IN IF ~cancelRejectedReturnBitfield16.ok THEN Fail ELSE
    LET cancelRejectedReturnBitfield17 == ReadWhen(numberOfReturnBitfields.value >= 17, ReadBytes(cancelRejectedReturnBitfield16.rest, 1), cancelRejectedReturnBitfield16.rest) IN IF ~cancelRejectedReturnBitfield17.ok THEN Fail ELSE
    LET cancelRejectedReturnBitfield18 == ReadWhen(numberOfReturnBitfields.value >= 18, ReadBytes(cancelRejectedReturnBitfield17.rest, 1), cancelRejectedReturnBitfield17.rest) IN IF ~cancelRejectedReturnBitfield18.ok THEN Fail ELSE
    LET cancelRejectedReturnBitfield19 == ReadWhen(numberOfReturnBitfields.value >= 19, ReadUIntLE(cancelRejectedReturnBitfield18.rest, 1), cancelRejectedReturnBitfield18.rest) IN IF ~cancelRejectedReturnBitfield19.ok THEN Fail ELSE
    LET side == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (cancelRejectedReturnBitfield1.value # << >> /\ cancelRejectedReturnBitfield1.value[1] % 2 > 0), ReadBytes(cancelRejectedReturnBitfield19.rest, 1), cancelRejectedReturnBitfield19.rest) IN IF ~side.ok THEN Fail ELSE
    LET priceLong == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (cancelRejectedReturnBitfield1.value # << >> /\ (cancelRejectedReturnBitfield1.value[1] \div 4) % 2 > 0), ReadBytes(side.rest, 8), side.rest) IN IF ~priceLong.ok THEN Fail ELSE
    LET execInst == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (cancelRejectedReturnBitfield1.value # << >> /\ (cancelRejectedReturnBitfield1.value[1] \div 8) % 2 > 0), ReadBytes(priceLong.rest, 1), priceLong.rest) IN IF ~execInst.ok THEN Fail ELSE
    LET ordType == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (cancelRejectedReturnBitfield1.value # << >> /\ (cancelRejectedReturnBitfield1.value[1] \div 16) % 2 > 0), ReadBytes(execInst.rest, 1), execInst.rest) IN IF ~ordType.ok THEN Fail ELSE
    LET timeInForce == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (cancelRejectedReturnBitfield1.value # << >> /\ (cancelRejectedReturnBitfield1.value[1] \div 32) % 2 > 0), ReadBytes(ordType.rest, 1), ordType.rest) IN IF ~timeInForce.ok THEN Fail ELSE
    LET minQty == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (cancelRejectedReturnBitfield1.value # << >> /\ (cancelRejectedReturnBitfield1.value[1] \div 64) % 2 > 0), ReadBytes(timeInForce.rest, 4), timeInForce.rest) IN IF ~minQty.ok THEN Fail ELSE
    LET symbolLong == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (cancelRejectedReturnBitfield2.value # << >> /\ cancelRejectedReturnBitfield2.value[1] % 2 > 0), ReadBytes(minQty.rest, 8), minQty.rest) IN IF ~symbolLong.ok THEN Fail ELSE
    LET capacity == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (cancelRejectedReturnBitfield2.value # << >> /\ (cancelRejectedReturnBitfield2.value[1] \div 64) % 2 > 0), ReadBytes(symbolLong.rest, 1), symbolLong.rest) IN IF ~capacity.ok THEN Fail ELSE
    LET maturityDate == ReadWhen(numberOfReturnBitfields.value >= 4 /\ (cancelRejectedReturnBitfield4.value # << >> /\ cancelRejectedReturnBitfield4.value[1] % 2 > 0), ReadBytes(capacity.rest, 4), capacity.rest) IN IF ~maturityDate.ok THEN Fail ELSE
    LET strikePrice == ReadWhen(numberOfReturnBitfields.value >= 4 /\ (cancelRejectedReturnBitfield4.value # << >> /\ (cancelRejectedReturnBitfield4.value[1] \div 2) % 2 > 0), ReadBytes(maturityDate.rest, 8), maturityDate.rest) IN IF ~strikePrice.ok THEN Fail ELSE
    LET putOrCall == ReadWhen(numberOfReturnBitfields.value >= 4 /\ (cancelRejectedReturnBitfield4.value # << >> /\ (cancelRejectedReturnBitfield4.value[1] \div 4) % 2 > 0), ReadBytes(strikePrice.rest, 1), strikePrice.rest) IN IF ~putOrCall.ok THEN Fail ELSE
    LET openClose == ReadWhen(numberOfReturnBitfields.value >= 4 /\ (cancelRejectedReturnBitfield4.value # << >> /\ (cancelRejectedReturnBitfield4.value[1] \div 8) % 2 > 0), ReadBytes(putOrCall.rest, 1), putOrCall.rest) IN IF ~openClose.ok THEN Fail ELSE
    LET correctedSize == ReadWhen(numberOfReturnBitfields.value >= 4 /\ (cancelRejectedReturnBitfield4.value # << >> /\ (cancelRejectedReturnBitfield4.value[1] \div 32) % 2 > 0), ReadBytes(openClose.rest, 4), openClose.rest) IN IF ~correctedSize.ok THEN Fail ELSE
    LET echoText == ReadWhen(numberOfReturnBitfields.value >= 8 /\ (cancelRejectedReturnBitfield8.value # << >> /\ (cancelRejectedReturnBitfield8.value[1] \div 2) % 2 > 0), ReadBytes(correctedSize.rest, 64), correctedSize.rest) IN IF ~echoText.ok THEN Fail ELSE
    LET stopPx == ReadWhen(numberOfReturnBitfields.value >= 8 /\ (cancelRejectedReturnBitfield8.value # << >> /\ (cancelRejectedReturnBitfield8.value[1] \div 4) % 2 > 0), ReadBytes(echoText.rest, 8), echoText.rest) IN IF ~stopPx.ok THEN Fail ELSE
    LET marketingFeeCode == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (cancelRejectedReturnBitfield9.value # << >> /\ cancelRejectedReturnBitfield9.value[1] % 2 > 0), ReadBytes(stopPx.rest, 2), stopPx.rest) IN IF ~marketingFeeCode.ok THEN Fail ELSE
    LET targetPartyId == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (cancelRejectedReturnBitfield9.value # << >> /\ (cancelRejectedReturnBitfield9.value[1] \div 2) % 2 > 0), ReadBytes(marketingFeeCode.rest, 4), marketingFeeCode.rest) IN IF ~targetPartyId.ok THEN Fail ELSE
    LET auctionId == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (cancelRejectedReturnBitfield9.value # << >> /\ (cancelRejectedReturnBitfield9.value[1] \div 4) % 2 > 0), ReadBytes(targetPartyId.rest, 8), targetPartyId.rest) IN IF ~auctionId.ok THEN Fail ELSE
    LET cmtaNumber == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (cancelRejectedReturnBitfield9.value # << >> /\ (cancelRejectedReturnBitfield9.value[1] \div 32) % 2 > 0), ReadBytes(auctionId.rest, 4), auctionId.rest) IN IF ~cmtaNumber.ok THEN Fail ELSE
    LET crossId == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (cancelRejectedReturnBitfield10.value # << >> /\ cancelRejectedReturnBitfield10.value[1] % 2 > 0), ReadBytes(cmtaNumber.rest, 20), cmtaNumber.rest) IN IF ~crossId.ok THEN Fail ELSE
    LET allocQty == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (cancelRejectedReturnBitfield10.value # << >> /\ (cancelRejectedReturnBitfield10.value[1] \div 2) % 2 > 0), ReadBytes(crossId.rest, 4), crossId.rest) IN IF ~allocQty.ok THEN Fail ELSE
    LET giveUpFirmId == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (cancelRejectedReturnBitfield10.value # << >> /\ (cancelRejectedReturnBitfield10.value[1] \div 4) % 2 > 0), ReadBytes(allocQty.rest, 4), allocQty.rest) IN IF ~giveUpFirmId.ok THEN Fail ELSE
    LET routingFirmId == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (cancelRejectedReturnBitfield10.value # << >> /\ (cancelRejectedReturnBitfield10.value[1] \div 8) % 2 > 0), ReadBytes(giveUpFirmId.rest, 4), giveUpFirmId.rest) IN IF ~routingFirmId.ok THEN Fail ELSE
    LET crossExclusionIndicator == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (cancelRejectedReturnBitfield10.value # << >> /\ (cancelRejectedReturnBitfield10.value[1] \div 32) % 2 > 0), ReadBytes(routingFirmId.rest, 1), routingFirmId.rest) IN IF ~crossExclusionIndicator.ok THEN Fail ELSE
    LET clearingOptionalData == ReadWhen(numberOfReturnBitfields.value >= 12 /\ (cancelRejectedReturnBitfield12.value # << >> /\ (cancelRejectedReturnBitfield12.value[1] \div 128) % 2 > 0), ReadBytes(crossExclusionIndicator.rest, 16), crossExclusionIndicator.rest) IN IF ~clearingOptionalData.ok THEN Fail ELSE
    LET massCancelId == ReadWhen(numberOfReturnBitfields.value >= 15 /\ (cancelRejectedReturnBitfield15.value # << >> /\ (cancelRejectedReturnBitfield15.value[1] \div 8) % 2 > 0), ReadBytes(clearingOptionalData.rest, 20), clearingOptionalData.rest) IN IF ~massCancelId.ok THEN Fail ELSE
    LET stopPxType == ReadWhen(numberOfReturnBitfields.value >= 19 /\ (cancelRejectedReturnBitfield19.value # << >> /\ (cancelRejectedReturnBitfield19.value[1] \div 64) % 2 > 0), ReadBytes(massCancelId.rest, 1), massCancelId.rest) IN IF ~stopPxType.ok THEN Fail ELSE
    Ok([ transactionTime                |-> transactionTime.value,
         clOrdId                        |-> clOrdId.value,
         cancelRejectReason             |-> cancelRejectReason.value,
         text                           |-> text.value,
         reserved1                      |-> reserved1.value,
         numberOfReturnBitfields        |-> numberOfReturnBitfields.value,
         cancelRejectedReturnBitfield1  |-> cancelRejectedReturnBitfield1.value,
         cancelRejectedReturnBitfield2  |-> cancelRejectedReturnBitfield2.value,
         cancelRejectedReturnBitfield3  |-> cancelRejectedReturnBitfield3.value,
         cancelRejectedReturnBitfield4  |-> cancelRejectedReturnBitfield4.value,
         cancelRejectedReturnBitfield5  |-> cancelRejectedReturnBitfield5.value,
         cancelRejectedReturnBitfield6  |-> cancelRejectedReturnBitfield6.value,
         cancelRejectedReturnBitfield7  |-> cancelRejectedReturnBitfield7.value,
         cancelRejectedReturnBitfield8  |-> cancelRejectedReturnBitfield8.value,
         cancelRejectedReturnBitfield9  |-> cancelRejectedReturnBitfield9.value,
         cancelRejectedReturnBitfield10 |-> cancelRejectedReturnBitfield10.value,
         cancelRejectedReturnBitfield11 |-> cancelRejectedReturnBitfield11.value,
         cancelRejectedReturnBitfield12 |-> cancelRejectedReturnBitfield12.value,
         cancelRejectedReturnBitfield13 |-> cancelRejectedReturnBitfield13.value,
         cancelRejectedReturnBitfield14 |-> cancelRejectedReturnBitfield14.value,
         cancelRejectedReturnBitfield15 |-> cancelRejectedReturnBitfield15.value,
         cancelRejectedReturnBitfield16 |-> cancelRejectedReturnBitfield16.value,
         cancelRejectedReturnBitfield17 |-> cancelRejectedReturnBitfield17.value,
         cancelRejectedReturnBitfield18 |-> cancelRejectedReturnBitfield18.value,
         cancelRejectedReturnBitfield19 |-> cancelRejectedReturnBitfield19.value,
         side                           |-> side.value,
         priceLong                      |-> priceLong.value,
         execInst                       |-> execInst.value,
         ordType                        |-> ordType.value,
         timeInForce                    |-> timeInForce.value,
         minQty                         |-> minQty.value,
         symbolLong                     |-> symbolLong.value,
         capacity                       |-> capacity.value,
         maturityDate                   |-> maturityDate.value,
         strikePrice                    |-> strikePrice.value,
         putOrCall                      |-> putOrCall.value,
         openClose                      |-> openClose.value,
         correctedSize                  |-> correctedSize.value,
         echoText                       |-> echoText.value,
         stopPx                         |-> stopPx.value,
         marketingFeeCode               |-> marketingFeeCode.value,
         targetPartyId                  |-> targetPartyId.value,
         auctionId                      |-> auctionId.value,
         cmtaNumber                     |-> cmtaNumber.value,
         crossId                        |-> crossId.value,
         allocQty                       |-> allocQty.value,
         giveUpFirmId                   |-> giveUpFirmId.value,
         routingFirmId                  |-> routingFirmId.value,
         crossExclusionIndicator        |-> crossExclusionIndicator.value,
         clearingOptionalData           |-> clearingOptionalData.value,
         massCancelId                   |-> massCancelId.value,
         stopPxType                     |-> stopPxType.value ], stopPxType.rest)

(* Cancel Rejected Message with each field marked present by fields before it there exactly where they say *)
SettleCancelRejectedMessage(message) ==
    LET settled1 == [message EXCEPT !.cancelRejectedReturnBitfield1 = IF message.numberOfReturnBitfields >= 1 THEN (IF message.cancelRejectedReturnBitfield1 = << >> THEN <<0>> ELSE message.cancelRejectedReturnBitfield1) ELSE << >>]
        settled2 == [settled1 EXCEPT !.cancelRejectedReturnBitfield2 = IF settled1.numberOfReturnBitfields >= 2 THEN (IF settled1.cancelRejectedReturnBitfield2 = << >> THEN <<0>> ELSE settled1.cancelRejectedReturnBitfield2) ELSE << >>]
        settled3 == [settled2 EXCEPT !.cancelRejectedReturnBitfield3 = IF settled2.numberOfReturnBitfields >= 3 THEN (IF settled2.cancelRejectedReturnBitfield3 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled2.cancelRejectedReturnBitfield3) ELSE << >>]
        settled4 == [settled3 EXCEPT !.cancelRejectedReturnBitfield4 = IF settled3.numberOfReturnBitfields >= 4 THEN (IF settled3.cancelRejectedReturnBitfield4 = << >> THEN <<0>> ELSE settled3.cancelRejectedReturnBitfield4) ELSE << >>]
        settled5 == [settled4 EXCEPT !.cancelRejectedReturnBitfield5 = IF settled4.numberOfReturnBitfields >= 5 THEN (IF settled4.cancelRejectedReturnBitfield5 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled4.cancelRejectedReturnBitfield5) ELSE << >>]
        settled6 == [settled5 EXCEPT !.cancelRejectedReturnBitfield6 = IF settled5.numberOfReturnBitfields >= 6 THEN (IF settled5.cancelRejectedReturnBitfield6 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled5.cancelRejectedReturnBitfield6) ELSE << >>]
        settled7 == [settled6 EXCEPT !.cancelRejectedReturnBitfield7 = IF settled6.numberOfReturnBitfields >= 7 THEN (IF settled6.cancelRejectedReturnBitfield7 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled6.cancelRejectedReturnBitfield7) ELSE << >>]
        settled8 == [settled7 EXCEPT !.cancelRejectedReturnBitfield8 = IF settled7.numberOfReturnBitfields >= 8 THEN (IF settled7.cancelRejectedReturnBitfield8 = << >> THEN <<0>> ELSE settled7.cancelRejectedReturnBitfield8) ELSE << >>]
