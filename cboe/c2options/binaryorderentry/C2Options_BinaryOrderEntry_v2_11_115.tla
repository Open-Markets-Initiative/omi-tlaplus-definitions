        settled11 == [settled10 EXCEPT !.cancelRejectedReturnBitfield11 = IF settled10.numberOfReturnBitfields >= 11 THEN (IF settled10.cancelRejectedReturnBitfield11 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled10.cancelRejectedReturnBitfield11) ELSE << >>]
        settled12 == [settled11 EXCEPT !.cancelRejectedReturnBitfield12 = IF settled11.numberOfReturnBitfields >= 12 THEN (IF settled11.cancelRejectedReturnBitfield12 = << >> THEN <<0>> ELSE settled11.cancelRejectedReturnBitfield12) ELSE << >>]
        settled13 == [settled12 EXCEPT !.cancelRejectedReturnBitfield13 = IF settled12.numberOfReturnBitfields >= 13 THEN (IF settled12.cancelRejectedReturnBitfield13 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled12.cancelRejectedReturnBitfield13) ELSE << >>]
        settled14 == [settled13 EXCEPT !.cancelRejectedReturnBitfield14 = IF settled13.numberOfReturnBitfields >= 14 THEN (IF settled13.cancelRejectedReturnBitfield14 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled13.cancelRejectedReturnBitfield14) ELSE << >>]
        settled15 == [settled14 EXCEPT !.cancelRejectedReturnBitfield15 = IF settled14.numberOfReturnBitfields >= 15 THEN (IF settled14.cancelRejectedReturnBitfield15 = << >> THEN <<0>> ELSE settled14.cancelRejectedReturnBitfield15) ELSE << >>]
        settled16 == [settled15 EXCEPT !.cancelRejectedReturnBitfield16 = IF settled15.numberOfReturnBitfields >= 16 THEN (IF settled15.cancelRejectedReturnBitfield16 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled15.cancelRejectedReturnBitfield16) ELSE << >>]
        settled17 == [settled16 EXCEPT !.cancelRejectedReturnBitfield17 = IF settled16.numberOfReturnBitfields >= 17 THEN (IF settled16.cancelRejectedReturnBitfield17 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled16.cancelRejectedReturnBitfield17) ELSE << >>]
        settled18 == [settled17 EXCEPT !.cancelRejectedReturnBitfield18 = IF settled17.numberOfReturnBitfields >= 18 THEN (IF settled17.cancelRejectedReturnBitfield18 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled17.cancelRejectedReturnBitfield18) ELSE << >>]
        settled19 == [settled18 EXCEPT !.cancelRejectedReturnBitfield19 = IF settled18.numberOfReturnBitfields >= 19 THEN (IF settled18.cancelRejectedReturnBitfield19 = << >> THEN <<0>> ELSE settled18.cancelRejectedReturnBitfield19) ELSE << >>]
        settled20 == [settled19 EXCEPT !.side = IF settled19.numberOfReturnBitfields >= 1 /\ (settled19.cancelRejectedReturnBitfield1 # << >> /\ settled19.cancelRejectedReturnBitfield1[1] % 2 > 0) THEN (IF settled19.side = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled19.side) ELSE << >>]
        settled21 == [settled20 EXCEPT !.priceLong = IF settled20.numberOfReturnBitfields >= 1 /\ (settled20.cancelRejectedReturnBitfield1 # << >> /\ (settled20.cancelRejectedReturnBitfield1[1] \div 4) % 2 > 0) THEN (IF settled20.priceLong = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled20.priceLong) ELSE << >>]
        settled22 == [settled21 EXCEPT !.execInst = IF settled21.numberOfReturnBitfields >= 1 /\ (settled21.cancelRejectedReturnBitfield1 # << >> /\ (settled21.cancelRejectedReturnBitfield1[1] \div 8) % 2 > 0) THEN (IF settled21.execInst = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled21.execInst) ELSE << >>]
