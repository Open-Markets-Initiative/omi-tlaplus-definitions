        settled46 == [settled45 EXCEPT !.routStrategy = IF settled45.numberOfReturnBitfields >= 8 /\ (settled45.returnBitfield8 # << >> /\ (settled45.returnBitfield8[1] \div 16) % 2 > 0) THEN (IF settled45.routStrategy = << >> THEN <<[i \in 1 .. 6 |-> 0]>> ELSE settled45.routStrategy) ELSE << >>]
        settled47 == [settled46 EXCEPT !.routeDeliveryMethod = IF settled46.numberOfReturnBitfields >= 8 /\ (settled46.returnBitfield8 # << >> /\ (settled46.returnBitfield8[1] \div 32) % 2 > 0) THEN (IF settled46.routeDeliveryMethod = << >> THEN <<[i \in 1 .. 3 |-> 0]>> ELSE settled46.routeDeliveryMethod) ELSE << >>]
        settled48 == [settled47 EXCEPT !.exDestination = IF settled47.numberOfReturnBitfields >= 8 /\ (settled47.returnBitfield8 # << >> /\ (settled47.returnBitfield8[1] \div 64) % 2 > 0) THEN (IF settled47.exDestination = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled47.exDestination) ELSE << >>]
        settled49 == [settled48 EXCEPT !.marketingFeeCode = IF settled48.numberOfReturnBitfields >= 9 /\ (settled48.returnBitfield9 # << >> /\ settled48.returnBitfield9[1] % 2 > 0) THEN (IF settled48.marketingFeeCode = << >> THEN <<[i \in 1 .. 2 |-> 0]>> ELSE settled48.marketingFeeCode) ELSE << >>]
        settled50 == [settled49 EXCEPT !.targetPartyId = IF settled49.numberOfReturnBitfields >= 9 /\ (settled49.returnBitfield9 # << >> /\ (settled49.returnBitfield9[1] \div 2) % 2 > 0) THEN (IF settled49.targetPartyId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled49.targetPartyId) ELSE << >>]
        settled51 == [settled50 EXCEPT !.auctionId = IF settled50.numberOfReturnBitfields >= 9 /\ (settled50.returnBitfield9 # << >> /\ (settled50.returnBitfield9[1] \div 4) % 2 > 0) THEN (IF settled50.auctionId = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled50.auctionId) ELSE << >>]
        settled52 == [settled51 EXCEPT !.cmtaNumber = IF settled51.numberOfReturnBitfields >= 9 /\ (settled51.returnBitfield9 # << >> /\ (settled51.returnBitfield9[1] \div 32) % 2 > 0) THEN (IF settled51.cmtaNumber = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled51.cmtaNumber) ELSE << >>]
        settled53 == [settled52 EXCEPT !.crossId = IF settled52.numberOfReturnBitfields >= 10 /\ (settled52.returnBitfield10 # << >> /\ settled52.returnBitfield10[1] % 2 > 0) THEN (IF settled52.crossId = << >> THEN <<[i \in 1 .. 20 |-> 0]>> ELSE settled52.crossId) ELSE << >>]
        settled54 == [settled53 EXCEPT !.allocQty = IF settled53.numberOfReturnBitfields >= 10 /\ (settled53.returnBitfield10 # << >> /\ (settled53.returnBitfield10[1] \div 2) % 2 > 0) THEN (IF settled53.allocQty = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled53.allocQty) ELSE << >>]
