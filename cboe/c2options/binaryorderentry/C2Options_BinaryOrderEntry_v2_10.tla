        settled57 == [settled56 EXCEPT !.crossExclusionIndicator = IF settled56.numberOfReturnBitfields >= 10 /\ (settled56.returnBitfield10 # << >> /\ (settled56.returnBitfield10[1] \div 32) % 2 > 0) THEN (IF settled56.crossExclusionIndicator = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled56.crossExclusionIndicator) ELSE << >>]
        settled58 == [settled57 EXCEPT !.frequentTraderId = IF settled57.numberOfReturnBitfields >= 16 /\ (settled57.returnBitfield16 # << >> /\ settled57.returnBitfield16[1] % 2 > 0) THEN (IF settled57.frequentTraderId = << >> THEN <<[i \in 1 .. 6 |-> 0]>> ELSE settled57.frequentTraderId) ELSE << >>]
