        settled54 == [settled53 EXCEPT !.exDestination = IF settled53.numberOfReturnBitfields >= 8 /\ (settled53.returnBitfield8 # << >> /\ (settled53.returnBitfield8[1] \div 64) % 2 > 0) THEN (IF settled53.exDestination = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled53.exDestination) ELSE << >>]
        settled55 == [settled54 EXCEPT !.marketingFeeCode = IF settled54.numberOfReturnBitfields >= 9 /\ (settled54.returnBitfield9 # << >> /\ settled54.returnBitfield9[1] % 2 > 0) THEN (IF settled54.marketingFeeCode = << >> THEN <<[i \in 1 .. 2 |-> 0]>> ELSE settled54.marketingFeeCode) ELSE << >>]
        settled56 == [settled55 EXCEPT !.targetPartyId = IF settled55.numberOfReturnBitfields >= 9 /\ (settled55.returnBitfield9 # << >> /\ (settled55.returnBitfield9[1] \div 2) % 2 > 0) THEN (IF settled55.targetPartyId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled55.targetPartyId) ELSE << >>]
        settled57 == [settled56 EXCEPT !.auctionId = IF settled56.numberOfReturnBitfields >= 9 /\ (settled56.returnBitfield9 # << >> /\ (settled56.returnBitfield9[1] \div 4) % 2 > 0) THEN (IF settled56.auctionId = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled56.auctionId) ELSE << >>]
        settled58 == [settled57 EXCEPT !.cmtaNumber = IF settled57.numberOfReturnBitfields >= 9 /\ (settled57.returnBitfield9 # << >> /\ (settled57.returnBitfield9[1] \div 32) % 2 > 0) THEN (IF settled57.cmtaNumber = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled57.cmtaNumber) ELSE << >>]
        settled59 == [settled58 EXCEPT !.crossId = IF settled58.numberOfReturnBitfields >= 10 /\ (settled58.returnBitfield10 # << >> /\ settled58.returnBitfield10[1] % 2 > 0) THEN (IF settled58.crossId = << >> THEN <<[i \in 1 .. 20 |-> 0]>> ELSE settled58.crossId) ELSE << >>]
        settled60 == [settled59 EXCEPT !.allocQty = IF settled59.numberOfReturnBitfields >= 10 /\ (settled59.returnBitfield10 # << >> /\ (settled59.returnBitfield10[1] \div 2) % 2 > 0) THEN (IF settled59.allocQty = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled59.allocQty) ELSE << >>]
        settled61 == [settled60 EXCEPT !.giveUpFirmId = IF settled60.numberOfReturnBitfields >= 10 /\ (settled60.returnBitfield10 # << >> /\ (settled60.returnBitfield10[1] \div 4) % 2 > 0) THEN (IF settled60.giveUpFirmId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled60.giveUpFirmId) ELSE << >>]
        settled62 == [settled61 EXCEPT !.routingFirmId = IF settled61.numberOfReturnBitfields >= 10 /\ (settled61.returnBitfield10 # << >> /\ (settled61.returnBitfield10[1] \div 8) % 2 > 0) THEN (IF settled61.routingFirmId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled61.routingFirmId) ELSE << >>]
        settled63 == [settled62 EXCEPT !.crossExclusionIndicator = IF settled62.numberOfReturnBitfields >= 10 /\ (settled62.returnBitfield10 # << >> /\ (settled62.returnBitfield10[1] \div 32) % 2 > 0) THEN (IF settled62.crossExclusionIndicator = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled62.crossExclusionIndicator) ELSE << >>]
        settled64 == [settled63 EXCEPT !.clientIdAttr = IF settled63.numberOfReturnBitfields >= 15 /\ (settled63.returnBitfield15 # << >> /\ (settled63.returnBitfield15[1] \div 128) % 2 > 0) THEN (IF settled63.clientIdAttr = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled63.clientIdAttr) ELSE << >>]
        settled65 == [settled64 EXCEPT !.frequentTraderId = IF settled64.numberOfReturnBitfields >= 16 /\ (settled64.returnBitfield16 # << >> /\ settled64.returnBitfield16[1] % 2 > 0) THEN (IF settled64.frequentTraderId = << >> THEN <<[i \in 1 .. 6 |-> 0]>> ELSE settled64.frequentTraderId) ELSE << >>]
        settled66 == [settled65 EXCEPT !.comboOrder = IF settled65.numberOfReturnBitfields >= 16 /\ (settled65.returnBitfield16 # << >> /\ (settled65.returnBitfield16[1] \div 4) % 2 > 0) THEN (IF settled65.comboOrder = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled65.comboOrder) ELSE << >>]
