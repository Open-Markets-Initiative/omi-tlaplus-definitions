        \cup { SettleOrderExecutionMessage([ZeroOrderExecutionMessage EXCEPT !.numberOfReturnBitfields = 9, !.returnBitfield9 = <<32>>, !.cmtaNumber = one]) : one \in { <<held>> : held \in Sample(4) } }
