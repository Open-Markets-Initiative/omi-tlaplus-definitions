        settled38 == [settled37 EXCEPT !.baseLiquidityIndicator = IF settled37.numberOfReturnBitfields >= 5 /\ (settled37.returnBitfield5 # << >> /\ (settled37.returnBitfield5[1] \div 64) % 2 > 0) THEN (IF settled37.baseLiquidityIndicator = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled37.baseLiquidityIndicator) ELSE << >>]
