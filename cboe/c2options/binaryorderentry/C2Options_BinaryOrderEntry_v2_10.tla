        settled56 == [settled55 EXCEPT !.equityPartyId = IF settled55.numberOfReturnBitfields >= 15 /\ (settled55.returnBitfield15 # << >> /\ (settled55.returnBitfield15[1] \div 2) % 2 > 0) THEN (IF settled55.equityPartyId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled55.equityPartyId) ELSE << >>]
        settled57 == [settled56 EXCEPT !.clientIdAttr = IF settled56.numberOfReturnBitfields >= 15 /\ (settled56.returnBitfield15 # << >> /\ (settled56.returnBitfield15[1] \div 128) % 2 > 0) THEN (IF settled56.clientIdAttr = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled56.clientIdAttr) ELSE << >>]
        settled58 == [settled57 EXCEPT !.frequentTraderId = IF settled57.numberOfReturnBitfields >= 16 /\ (settled57.returnBitfield16 # << >> /\ settled57.returnBitfield16[1] % 2 > 0) THEN (IF settled57.frequentTraderId = << >> THEN <<[i \in 1 .. 6 |-> 0]>> ELSE settled57.frequentTraderId) ELSE << >>]
        settled59 == [settled58 EXCEPT !.sessionEligibility = IF settled58.numberOfReturnBitfields >= 16 /\ (settled58.returnBitfield16 # << >> /\ (settled58.returnBitfield16[1] \div 2) % 2 > 0) THEN (IF settled58.sessionEligibility = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled58.sessionEligibility) ELSE << >>]
