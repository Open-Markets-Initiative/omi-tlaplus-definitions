                                   orderRejectedV2ReturnBitfield16 |-> << >>,
                                   orderRejectedV2ReturnBitfield17 |-> << >>,
                                   orderRejectedV2ReturnBitfield18 |-> << >>,
                                   orderRejectedV2ReturnBitfield19 |-> << >>,
                                   side                            |-> << >>,
                                   price                           |-> << >>,
                                   ordType                         |-> << >>,
                                   timeInForce                     |-> << >>,
                                   minQty                          |-> << >>,
                                   symbolLong                      |-> << >>,
                                   idSource                        |-> << >>,
                                   securityId                      |-> << >>,
                                   capacity                        |-> << >>,
                                   account                         |-> << >>,
                                   clearingFirm                    |-> << >>,
                                   clearingAccount                 |-> << >>,
                                   displayIndicator                |-> << >>,
                                   orderQty                        |-> << >>,
                                   preventMatch                    |-> << >>,
                                   openClose                       |-> << >>,
                                   secondaryOrderId                |-> << >>,
                                   extExecInst                     |-> << >>,
                                   stopPx                          |-> << >>,
                                   routingInst                     |-> << >>,
                                   liquidityProvision              |-> << >>,
                                   clientQualifiedRole             |-> << >>,
                                   clientId                        |-> << >>,
                                   investorId                      |-> << >>,
                                   executorId                      |-> << >>,
                                   orderOrigination                |-> << >>,
                                   algorithmicIndicator            |-> << >>,
                                   investorQualifiedRole           |-> << >>,
                                   executorQualifiedRole           |-> << >>,
                                   custOrderHandlingInst           |-> << >>,
                                   accountType                     |-> << >>,
                                   subreason                       |-> << >> ])

(* Order Rejected V 2 Message at zero, then each field in turn at the values it is checked at *)
CheckedOrderRejectedV2Message ==
    { ZeroOrderRejectedV2Message }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.transactionTime = one]) : one \in Sample(8) }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.clOrdId = one]) : one \in Sample(20) }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.orderRejectReason = one]) : one \in Sample(1) }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.text = one]) : one \in Sample(60) }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.reserved1 = one]) : one \in Sample(1) }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = one]) : one \in {0, 1, 255} }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 1, !.orderRejectedV2ReturnBitfield1 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 2, !.orderRejectedV2ReturnBitfield2 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 3, !.orderRejectedV2ReturnBitfield3 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 4, !.orderRejectedV2ReturnBitfield4 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 5, !.orderRejectedV2ReturnBitfield5 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 6, !.orderRejectedV2ReturnBitfield6 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 7, !.orderRejectedV2ReturnBitfield7 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 8, !.orderRejectedV2ReturnBitfield8 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 9, !.orderRejectedV2ReturnBitfield9 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 10, !.orderRejectedV2ReturnBitfield10 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 11, !.orderRejectedV2ReturnBitfield11 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 12, !.orderRejectedV2ReturnBitfield12 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 13, !.orderRejectedV2ReturnBitfield13 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 14, !.orderRejectedV2ReturnBitfield14 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 15, !.orderRejectedV2ReturnBitfield15 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 16, !.orderRejectedV2ReturnBitfield16 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 17, !.orderRejectedV2ReturnBitfield17 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 18, !.orderRejectedV2ReturnBitfield18 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 19, !.orderRejectedV2ReturnBitfield19 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 1, !.orderRejectedV2ReturnBitfield1 = <<1>>, !.side = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 1, !.orderRejectedV2ReturnBitfield1 = <<4>>, !.price = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 1, !.orderRejectedV2ReturnBitfield1 = <<16>>, !.ordType = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 1, !.orderRejectedV2ReturnBitfield1 = <<32>>, !.timeInForce = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 1, !.orderRejectedV2ReturnBitfield1 = <<64>>, !.minQty = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 2, !.orderRejectedV2ReturnBitfield2 = <<1>>, !.symbolLong = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 2, !.orderRejectedV2ReturnBitfield2 = <<8>>, !.idSource = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 2, !.orderRejectedV2ReturnBitfield2 = <<16>>, !.securityId = one]) : one \in { <<held>> : held \in Sample(16) } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 2, !.orderRejectedV2ReturnBitfield2 = <<64>>, !.capacity = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 3, !.orderRejectedV2ReturnBitfield3 = <<1>>, !.account = one]) : one \in { <<held>> : held \in Sample(16) } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 3, !.orderRejectedV2ReturnBitfield3 = <<2>>, !.clearingFirm = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 3, !.orderRejectedV2ReturnBitfield3 = <<4>>, !.clearingAccount = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 3, !.orderRejectedV2ReturnBitfield3 = <<8>>, !.displayIndicator = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 3, !.orderRejectedV2ReturnBitfield3 = <<64>>, !.orderQty = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 3, !.orderRejectedV2ReturnBitfield3 = <<128>>, !.preventMatch = one]) : one \in { <<held>> : held \in Sample(3) } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 4, !.orderRejectedV2ReturnBitfield4 = <<8>>, !.openClose = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 6, !.orderRejectedV2ReturnBitfield6 = <<1>>, !.secondaryOrderId = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 6, !.orderRejectedV2ReturnBitfield6 = <<16>>, !.extExecInst = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 8, !.orderRejectedV2ReturnBitfield8 = <<4>>, !.stopPx = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 8, !.orderRejectedV2ReturnBitfield8 = <<8>>, !.routingInst = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 9, !.orderRejectedV2ReturnBitfield9 = <<16>>, !.liquidityProvision = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 10, !.orderRejectedV2ReturnBitfield10 = <<128>>, !.clientQualifiedRole = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 11, !.orderRejectedV2ReturnBitfield11 = <<1>>, !.clientId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 11, !.orderRejectedV2ReturnBitfield11 = <<2>>, !.investorId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 11, !.orderRejectedV2ReturnBitfield11 = <<4>>, !.executorId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 11, !.orderRejectedV2ReturnBitfield11 = <<8>>, !.orderOrigination = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 11, !.orderRejectedV2ReturnBitfield11 = <<16>>, !.algorithmicIndicator = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 11, !.orderRejectedV2ReturnBitfield11 = <<64>>, !.investorQualifiedRole = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 11, !.orderRejectedV2ReturnBitfield11 = <<128>>, !.executorQualifiedRole = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 17, !.orderRejectedV2ReturnBitfield17 = <<128>>, !.custOrderHandlingInst = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 18, !.orderRejectedV2ReturnBitfield18 = <<1>>, !.accountType = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderRejectedV2Message([ZeroOrderRejectedV2Message EXCEPT !.numberOfReturnBitfields = 18, !.orderRejectedV2ReturnBitfield18 = <<4>>, !.subreason = one]) : one \in { <<held>> : held \in Sample(1) } }

(***************************************************************************)
(* Cross Order Rejected Message                                            *)
(***************************************************************************)

CrossOrderRejectedMessage ==
    [ transactionTime                    : Sample(8),
      crossId                            : Sample(20),
      orderRejectReason                  : Sample(1),
      text                               : Sample(60),
      reserved1                          : Sample(1),
      numberOfReturnBitfields            : 0 .. 255,
      crossOrderRejectedReturnBitfield1  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderRejectedReturnBitfield2  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderRejectedReturnBitfield3  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderRejectedReturnBitfield4  : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderRejectedReturnBitfield5  : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderRejectedReturnBitfield6  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderRejectedReturnBitfield7  : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderRejectedReturnBitfield8  : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderRejectedReturnBitfield9  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderRejectedReturnBitfield10 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderRejectedReturnBitfield11 : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderRejectedReturnBitfield12 : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderRejectedReturnBitfield13 : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderRejectedReturnBitfield14 : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderRejectedReturnBitfield15 : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderRejectedReturnBitfield16 : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderRejectedReturnBitfield17 : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderRejectedReturnBitfield18 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderRejectedReturnBitfield19 : { << >> } \cup { <<held>> : held \in Sample(1) },
      price                              : { << >> } \cup { <<held>> : held \in Sample(8) },
      symbolLong                         : { << >> } \cup { <<held>> : held \in Sample(8) },
      idSource                           : { << >> } \cup { <<held>> : held \in Sample(1) },
      securityId                         : { << >> } \cup { <<held>> : held \in Sample(16) },
      orderQty                           : { << >> } \cup { <<held>> : held \in Sample(4) },
      preventMatch                       : { << >> } \cup { <<held>> : held \in Sample(3) },
      extExecInst                        : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossType                          : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossPrioritization                : { << >> } \cup { <<held>> : held \in Sample(1) },
      routingFirmId                      : { << >> } \cup { <<held>> : held \in Sample(4) },
      subreason                          : { << >> } \cup { <<held>> : held \in Sample(1) } ]

EncodeCrossOrderRejectedMessage(message) ==
    message.transactionTime
        \o message.crossId
        \o message.orderRejectReason
        \o message.text
        \o message.reserved1
        \o EncodeUIntBE(message.numberOfReturnBitfields, 1)
        \o (IF message.crossOrderRejectedReturnBitfield1 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderRejectedReturnBitfield1[1], 1))
        \o (IF message.crossOrderRejectedReturnBitfield2 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderRejectedReturnBitfield2[1], 1))
        \o (IF message.crossOrderRejectedReturnBitfield3 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderRejectedReturnBitfield3[1], 1))
        \o (IF message.crossOrderRejectedReturnBitfield4 = << >> THEN << >> ELSE message.crossOrderRejectedReturnBitfield4[1])
        \o (IF message.crossOrderRejectedReturnBitfield5 = << >> THEN << >> ELSE message.crossOrderRejectedReturnBitfield5[1])
        \o (IF message.crossOrderRejectedReturnBitfield6 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderRejectedReturnBitfield6[1], 1))
        \o (IF message.crossOrderRejectedReturnBitfield7 = << >> THEN << >> ELSE message.crossOrderRejectedReturnBitfield7[1])
        \o (IF message.crossOrderRejectedReturnBitfield8 = << >> THEN << >> ELSE message.crossOrderRejectedReturnBitfield8[1])
        \o (IF message.crossOrderRejectedReturnBitfield9 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderRejectedReturnBitfield9[1], 1))
        \o (IF message.crossOrderRejectedReturnBitfield10 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderRejectedReturnBitfield10[1], 1))
        \o (IF message.crossOrderRejectedReturnBitfield11 = << >> THEN << >> ELSE message.crossOrderRejectedReturnBitfield11[1])
        \o (IF message.crossOrderRejectedReturnBitfield12 = << >> THEN << >> ELSE message.crossOrderRejectedReturnBitfield12[1])
        \o (IF message.crossOrderRejectedReturnBitfield13 = << >> THEN << >> ELSE message.crossOrderRejectedReturnBitfield13[1])
        \o (IF message.crossOrderRejectedReturnBitfield14 = << >> THEN << >> ELSE message.crossOrderRejectedReturnBitfield14[1])
        \o (IF message.crossOrderRejectedReturnBitfield15 = << >> THEN << >> ELSE message.crossOrderRejectedReturnBitfield15[1])
        \o (IF message.crossOrderRejectedReturnBitfield16 = << >> THEN << >> ELSE message.crossOrderRejectedReturnBitfield16[1])
        \o (IF message.crossOrderRejectedReturnBitfield17 = << >> THEN << >> ELSE message.crossOrderRejectedReturnBitfield17[1])
        \o (IF message.crossOrderRejectedReturnBitfield18 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderRejectedReturnBitfield18[1], 1))
        \o (IF message.crossOrderRejectedReturnBitfield19 = << >> THEN << >> ELSE message.crossOrderRejectedReturnBitfield19[1])
        \o (IF message.price = << >> THEN << >> ELSE message.price[1])
        \o (IF message.symbolLong = << >> THEN << >> ELSE message.symbolLong[1])
        \o (IF message.idSource = << >> THEN << >> ELSE message.idSource[1])
        \o (IF message.securityId = << >> THEN << >> ELSE message.securityId[1])
        \o (IF message.orderQty = << >> THEN << >> ELSE message.orderQty[1])
        \o (IF message.preventMatch = << >> THEN << >> ELSE message.preventMatch[1])
        \o (IF message.extExecInst = << >> THEN << >> ELSE message.extExecInst[1])
        \o (IF message.crossType = << >> THEN << >> ELSE message.crossType[1])
        \o (IF message.crossPrioritization = << >> THEN << >> ELSE message.crossPrioritization[1])
        \o (IF message.routingFirmId = << >> THEN << >> ELSE message.routingFirmId[1])
        \o (IF message.subreason = << >> THEN << >> ELSE message.subreason[1])

DecodeCrossOrderRejectedMessage(bytes) ==
    LET transactionTime == ReadBytes(bytes, 8) IN IF ~transactionTime.ok THEN Fail ELSE
    LET crossId == ReadBytes(transactionTime.rest, 20) IN IF ~crossId.ok THEN Fail ELSE
    LET orderRejectReason == ReadBytes(crossId.rest, 1) IN IF ~orderRejectReason.ok THEN Fail ELSE
    LET text == ReadBytes(orderRejectReason.rest, 60) IN IF ~text.ok THEN Fail ELSE
    LET reserved1 == ReadBytes(text.rest, 1) IN IF ~reserved1.ok THEN Fail ELSE
    LET numberOfReturnBitfields == ReadUIntBE(reserved1.rest, 1) IN IF ~numberOfReturnBitfields.ok THEN Fail ELSE
    LET crossOrderRejectedReturnBitfield1 == ReadWhen(numberOfReturnBitfields.value >= 1, ReadUIntLE(numberOfReturnBitfields.rest, 1), numberOfReturnBitfields.rest) IN IF ~crossOrderRejectedReturnBitfield1.ok THEN Fail ELSE
    LET crossOrderRejectedReturnBitfield2 == ReadWhen(numberOfReturnBitfields.value >= 2, ReadUIntLE(crossOrderRejectedReturnBitfield1.rest, 1), crossOrderRejectedReturnBitfield1.rest) IN IF ~crossOrderRejectedReturnBitfield2.ok THEN Fail ELSE
    LET crossOrderRejectedReturnBitfield3 == ReadWhen(numberOfReturnBitfields.value >= 3, ReadUIntLE(crossOrderRejectedReturnBitfield2.rest, 1), crossOrderRejectedReturnBitfield2.rest) IN IF ~crossOrderRejectedReturnBitfield3.ok THEN Fail ELSE
    LET crossOrderRejectedReturnBitfield4 == ReadWhen(numberOfReturnBitfields.value >= 4, ReadBytes(crossOrderRejectedReturnBitfield3.rest, 1), crossOrderRejectedReturnBitfield3.rest) IN IF ~crossOrderRejectedReturnBitfield4.ok THEN Fail ELSE
    LET crossOrderRejectedReturnBitfield5 == ReadWhen(numberOfReturnBitfields.value >= 5, ReadBytes(crossOrderRejectedReturnBitfield4.rest, 1), crossOrderRejectedReturnBitfield4.rest) IN IF ~crossOrderRejectedReturnBitfield5.ok THEN Fail ELSE
    LET crossOrderRejectedReturnBitfield6 == ReadWhen(numberOfReturnBitfields.value >= 6, ReadUIntLE(crossOrderRejectedReturnBitfield5.rest, 1), crossOrderRejectedReturnBitfield5.rest) IN IF ~crossOrderRejectedReturnBitfield6.ok THEN Fail ELSE
    LET crossOrderRejectedReturnBitfield7 == ReadWhen(numberOfReturnBitfields.value >= 7, ReadBytes(crossOrderRejectedReturnBitfield6.rest, 1), crossOrderRejectedReturnBitfield6.rest) IN IF ~crossOrderRejectedReturnBitfield7.ok THEN Fail ELSE
    LET crossOrderRejectedReturnBitfield8 == ReadWhen(numberOfReturnBitfields.value >= 8, ReadBytes(crossOrderRejectedReturnBitfield7.rest, 1), crossOrderRejectedReturnBitfield7.rest) IN IF ~crossOrderRejectedReturnBitfield8.ok THEN Fail ELSE
    LET crossOrderRejectedReturnBitfield9 == ReadWhen(numberOfReturnBitfields.value >= 9, ReadUIntLE(crossOrderRejectedReturnBitfield8.rest, 1), crossOrderRejectedReturnBitfield8.rest) IN IF ~crossOrderRejectedReturnBitfield9.ok THEN Fail ELSE
    LET crossOrderRejectedReturnBitfield10 == ReadWhen(numberOfReturnBitfields.value >= 10, ReadUIntLE(crossOrderRejectedReturnBitfield9.rest, 1), crossOrderRejectedReturnBitfield9.rest) IN IF ~crossOrderRejectedReturnBitfield10.ok THEN Fail ELSE
    LET crossOrderRejectedReturnBitfield11 == ReadWhen(numberOfReturnBitfields.value >= 11, ReadBytes(crossOrderRejectedReturnBitfield10.rest, 1), crossOrderRejectedReturnBitfield10.rest) IN IF ~crossOrderRejectedReturnBitfield11.ok THEN Fail ELSE
    LET crossOrderRejectedReturnBitfield12 == ReadWhen(numberOfReturnBitfields.value >= 12, ReadBytes(crossOrderRejectedReturnBitfield11.rest, 1), crossOrderRejectedReturnBitfield11.rest) IN IF ~crossOrderRejectedReturnBitfield12.ok THEN Fail ELSE
    LET crossOrderRejectedReturnBitfield13 == ReadWhen(numberOfReturnBitfields.value >= 13, ReadBytes(crossOrderRejectedReturnBitfield12.rest, 1), crossOrderRejectedReturnBitfield12.rest) IN IF ~crossOrderRejectedReturnBitfield13.ok THEN Fail ELSE
    LET crossOrderRejectedReturnBitfield14 == ReadWhen(numberOfReturnBitfields.value >= 14, ReadBytes(crossOrderRejectedReturnBitfield13.rest, 1), crossOrderRejectedReturnBitfield13.rest) IN IF ~crossOrderRejectedReturnBitfield14.ok THEN Fail ELSE
    LET crossOrderRejectedReturnBitfield15 == ReadWhen(numberOfReturnBitfields.value >= 15, ReadBytes(crossOrderRejectedReturnBitfield14.rest, 1), crossOrderRejectedReturnBitfield14.rest) IN IF ~crossOrderRejectedReturnBitfield15.ok THEN Fail ELSE
    LET crossOrderRejectedReturnBitfield16 == ReadWhen(numberOfReturnBitfields.value >= 16, ReadBytes(crossOrderRejectedReturnBitfield15.rest, 1), crossOrderRejectedReturnBitfield15.rest) IN IF ~crossOrderRejectedReturnBitfield16.ok THEN Fail ELSE
    LET crossOrderRejectedReturnBitfield17 == ReadWhen(numberOfReturnBitfields.value >= 17, ReadBytes(crossOrderRejectedReturnBitfield16.rest, 1), crossOrderRejectedReturnBitfield16.rest) IN IF ~crossOrderRejectedReturnBitfield17.ok THEN Fail ELSE
    LET crossOrderRejectedReturnBitfield18 == ReadWhen(numberOfReturnBitfields.value >= 18, ReadUIntLE(crossOrderRejectedReturnBitfield17.rest, 1), crossOrderRejectedReturnBitfield17.rest) IN IF ~crossOrderRejectedReturnBitfield18.ok THEN Fail ELSE
    LET crossOrderRejectedReturnBitfield19 == ReadWhen(numberOfReturnBitfields.value >= 19, ReadBytes(crossOrderRejectedReturnBitfield18.rest, 1), crossOrderRejectedReturnBitfield18.rest) IN IF ~crossOrderRejectedReturnBitfield19.ok THEN Fail ELSE
    LET price == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (crossOrderRejectedReturnBitfield1.value # << >> /\ (crossOrderRejectedReturnBitfield1.value[1] \div 4) % 2 > 0), ReadBytes(crossOrderRejectedReturnBitfield19.rest, 8), crossOrderRejectedReturnBitfield19.rest) IN IF ~price.ok THEN Fail ELSE
    LET symbolLong == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (crossOrderRejectedReturnBitfield2.value # << >> /\ crossOrderRejectedReturnBitfield2.value[1] % 2 > 0), ReadBytes(price.rest, 8), price.rest) IN IF ~symbolLong.ok THEN Fail ELSE
    LET idSource == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (crossOrderRejectedReturnBitfield2.value # << >> /\ (crossOrderRejectedReturnBitfield2.value[1] \div 8) % 2 > 0), ReadBytes(symbolLong.rest, 1), symbolLong.rest) IN IF ~idSource.ok THEN Fail ELSE
    LET securityId == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (crossOrderRejectedReturnBitfield2.value # << >> /\ (crossOrderRejectedReturnBitfield2.value[1] \div 16) % 2 > 0), ReadBytes(idSource.rest, 16), idSource.rest) IN IF ~securityId.ok THEN Fail ELSE
    LET orderQty == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (crossOrderRejectedReturnBitfield3.value # << >> /\ (crossOrderRejectedReturnBitfield3.value[1] \div 64) % 2 > 0), ReadBytes(securityId.rest, 4), securityId.rest) IN IF ~orderQty.ok THEN Fail ELSE
    LET preventMatch == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (crossOrderRejectedReturnBitfield3.value # << >> /\ (crossOrderRejectedReturnBitfield3.value[1] \div 128) % 2 > 0), ReadBytes(orderQty.rest, 3), orderQty.rest) IN IF ~preventMatch.ok THEN Fail ELSE
    LET extExecInst == ReadWhen(numberOfReturnBitfields.value >= 6 /\ (crossOrderRejectedReturnBitfield6.value # << >> /\ (crossOrderRejectedReturnBitfield6.value[1] \div 16) % 2 > 0), ReadBytes(preventMatch.rest, 1), preventMatch.rest) IN IF ~extExecInst.ok THEN Fail ELSE
    LET crossType == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (crossOrderRejectedReturnBitfield9.value # << >> /\ (crossOrderRejectedReturnBitfield9.value[1] \div 64) % 2 > 0), ReadBytes(extExecInst.rest, 1), extExecInst.rest) IN IF ~crossType.ok THEN Fail ELSE
    LET crossPrioritization == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (crossOrderRejectedReturnBitfield9.value # << >> /\ (crossOrderRejectedReturnBitfield9.value[1] \div 128) % 2 > 0), ReadBytes(crossType.rest, 1), crossType.rest) IN IF ~crossPrioritization.ok THEN Fail ELSE
    LET routingFirmId == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (crossOrderRejectedReturnBitfield10.value # << >> /\ (crossOrderRejectedReturnBitfield10.value[1] \div 8) % 2 > 0), ReadBytes(crossPrioritization.rest, 4), crossPrioritization.rest) IN IF ~routingFirmId.ok THEN Fail ELSE
    LET subreason == ReadWhen(numberOfReturnBitfields.value >= 18 /\ (crossOrderRejectedReturnBitfield18.value # << >> /\ (crossOrderRejectedReturnBitfield18.value[1] \div 4) % 2 > 0), ReadBytes(routingFirmId.rest, 1), routingFirmId.rest) IN IF ~subreason.ok THEN Fail ELSE
    Ok([ transactionTime                    |-> transactionTime.value,
         crossId                            |-> crossId.value,
         orderRejectReason                  |-> orderRejectReason.value,
         text                               |-> text.value,
         reserved1                          |-> reserved1.value,
         numberOfReturnBitfields            |-> numberOfReturnBitfields.value,
         crossOrderRejectedReturnBitfield1  |-> crossOrderRejectedReturnBitfield1.value,
         crossOrderRejectedReturnBitfield2  |-> crossOrderRejectedReturnBitfield2.value,
         crossOrderRejectedReturnBitfield3  |-> crossOrderRejectedReturnBitfield3.value,
         crossOrderRejectedReturnBitfield4  |-> crossOrderRejectedReturnBitfield4.value,
         crossOrderRejectedReturnBitfield5  |-> crossOrderRejectedReturnBitfield5.value,
         crossOrderRejectedReturnBitfield6  |-> crossOrderRejectedReturnBitfield6.value,
         crossOrderRejectedReturnBitfield7  |-> crossOrderRejectedReturnBitfield7.value,
         crossOrderRejectedReturnBitfield8  |-> crossOrderRejectedReturnBitfield8.value,
         crossOrderRejectedReturnBitfield9  |-> crossOrderRejectedReturnBitfield9.value,
         crossOrderRejectedReturnBitfield10 |-> crossOrderRejectedReturnBitfield10.value,
         crossOrderRejectedReturnBitfield11 |-> crossOrderRejectedReturnBitfield11.value,
         crossOrderRejectedReturnBitfield12 |-> crossOrderRejectedReturnBitfield12.value,
         crossOrderRejectedReturnBitfield13 |-> crossOrderRejectedReturnBitfield13.value,
         crossOrderRejectedReturnBitfield14 |-> crossOrderRejectedReturnBitfield14.value,
         crossOrderRejectedReturnBitfield15 |-> crossOrderRejectedReturnBitfield15.value,
         crossOrderRejectedReturnBitfield16 |-> crossOrderRejectedReturnBitfield16.value,
         crossOrderRejectedReturnBitfield17 |-> crossOrderRejectedReturnBitfield17.value,
         crossOrderRejectedReturnBitfield18 |-> crossOrderRejectedReturnBitfield18.value,
         crossOrderRejectedReturnBitfield19 |-> crossOrderRejectedReturnBitfield19.value,
         price                              |-> price.value,
         symbolLong                         |-> symbolLong.value,
         idSource                           |-> idSource.value,
         securityId                         |-> securityId.value,
         orderQty                           |-> orderQty.value,
         preventMatch                       |-> preventMatch.value,
         extExecInst                        |-> extExecInst.value,
         crossType                          |-> crossType.value,
         crossPrioritization                |-> crossPrioritization.value,
         routingFirmId                      |-> routingFirmId.value,
         subreason                          |-> subreason.value ], subreason.rest)

(* Cross Order Rejected Message with each field marked present by fields before it there exactly where they say *)
SettleCrossOrderRejectedMessage(message) ==
    LET settled1 == [message EXCEPT !.crossOrderRejectedReturnBitfield1 = IF message.numberOfReturnBitfields >= 1 THEN (IF message.crossOrderRejectedReturnBitfield1 = << >> THEN <<0>> ELSE message.crossOrderRejectedReturnBitfield1) ELSE << >>]
        settled2 == [settled1 EXCEPT !.crossOrderRejectedReturnBitfield2 = IF settled1.numberOfReturnBitfields >= 2 THEN (IF settled1.crossOrderRejectedReturnBitfield2 = << >> THEN <<0>> ELSE settled1.crossOrderRejectedReturnBitfield2) ELSE << >>]
        settled3 == [settled2 EXCEPT !.crossOrderRejectedReturnBitfield3 = IF settled2.numberOfReturnBitfields >= 3 THEN (IF settled2.crossOrderRejectedReturnBitfield3 = << >> THEN <<0>> ELSE settled2.crossOrderRejectedReturnBitfield3) ELSE << >>]
        settled4 == [settled3 EXCEPT !.crossOrderRejectedReturnBitfield4 = IF settled3.numberOfReturnBitfields >= 4 THEN (IF settled3.crossOrderRejectedReturnBitfield4 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled3.crossOrderRejectedReturnBitfield4) ELSE << >>]
        settled5 == [settled4 EXCEPT !.crossOrderRejectedReturnBitfield5 = IF settled4.numberOfReturnBitfields >= 5 THEN (IF settled4.crossOrderRejectedReturnBitfield5 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled4.crossOrderRejectedReturnBitfield5) ELSE << >>]
        settled6 == [settled5 EXCEPT !.crossOrderRejectedReturnBitfield6 = IF settled5.numberOfReturnBitfields >= 6 THEN (IF settled5.crossOrderRejectedReturnBitfield6 = << >> THEN <<0>> ELSE settled5.crossOrderRejectedReturnBitfield6) ELSE << >>]
        settled7 == [settled6 EXCEPT !.crossOrderRejectedReturnBitfield7 = IF settled6.numberOfReturnBitfields >= 7 THEN (IF settled6.crossOrderRejectedReturnBitfield7 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled6.crossOrderRejectedReturnBitfield7) ELSE << >>]
        settled8 == [settled7 EXCEPT !.crossOrderRejectedReturnBitfield8 = IF settled7.numberOfReturnBitfields >= 8 THEN (IF settled7.crossOrderRejectedReturnBitfield8 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled7.crossOrderRejectedReturnBitfield8) ELSE << >>]
        settled9 == [settled8 EXCEPT !.crossOrderRejectedReturnBitfield9 = IF settled8.numberOfReturnBitfields >= 9 THEN (IF settled8.crossOrderRejectedReturnBitfield9 = << >> THEN <<0>> ELSE settled8.crossOrderRejectedReturnBitfield9) ELSE << >>]
        settled10 == [settled9 EXCEPT !.crossOrderRejectedReturnBitfield10 = IF settled9.numberOfReturnBitfields >= 10 THEN (IF settled9.crossOrderRejectedReturnBitfield10 = << >> THEN <<0>> ELSE settled9.crossOrderRejectedReturnBitfield10) ELSE << >>]
        settled11 == [settled10 EXCEPT !.crossOrderRejectedReturnBitfield11 = IF settled10.numberOfReturnBitfields >= 11 THEN (IF settled10.crossOrderRejectedReturnBitfield11 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled10.crossOrderRejectedReturnBitfield11) ELSE << >>]
        settled12 == [settled11 EXCEPT !.crossOrderRejectedReturnBitfield12 = IF settled11.numberOfReturnBitfields >= 12 THEN (IF settled11.crossOrderRejectedReturnBitfield12 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled11.crossOrderRejectedReturnBitfield12) ELSE << >>]
        settled13 == [settled12 EXCEPT !.crossOrderRejectedReturnBitfield13 = IF settled12.numberOfReturnBitfields >= 13 THEN (IF settled12.crossOrderRejectedReturnBitfield13 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled12.crossOrderRejectedReturnBitfield13) ELSE << >>]
        settled14 == [settled13 EXCEPT !.crossOrderRejectedReturnBitfield14 = IF settled13.numberOfReturnBitfields >= 14 THEN (IF settled13.crossOrderRejectedReturnBitfield14 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled13.crossOrderRejectedReturnBitfield14) ELSE << >>]
        settled15 == [settled14 EXCEPT !.crossOrderRejectedReturnBitfield15 = IF settled14.numberOfReturnBitfields >= 15 THEN (IF settled14.crossOrderRejectedReturnBitfield15 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled14.crossOrderRejectedReturnBitfield15) ELSE << >>]
        settled16 == [settled15 EXCEPT !.crossOrderRejectedReturnBitfield16 = IF settled15.numberOfReturnBitfields >= 16 THEN (IF settled15.crossOrderRejectedReturnBitfield16 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled15.crossOrderRejectedReturnBitfield16) ELSE << >>]
        settled17 == [settled16 EXCEPT !.crossOrderRejectedReturnBitfield17 = IF settled16.numberOfReturnBitfields >= 17 THEN (IF settled16.crossOrderRejectedReturnBitfield17 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled16.crossOrderRejectedReturnBitfield17) ELSE << >>]
        settled18 == [settled17 EXCEPT !.crossOrderRejectedReturnBitfield18 = IF settled17.numberOfReturnBitfields >= 18 THEN (IF settled17.crossOrderRejectedReturnBitfield18 = << >> THEN <<0>> ELSE settled17.crossOrderRejectedReturnBitfield18) ELSE << >>]
        settled19 == [settled18 EXCEPT !.crossOrderRejectedReturnBitfield19 = IF settled18.numberOfReturnBitfields >= 19 THEN (IF settled18.crossOrderRejectedReturnBitfield19 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled18.crossOrderRejectedReturnBitfield19) ELSE << >>]
        settled20 == [settled19 EXCEPT !.price = IF settled19.numberOfReturnBitfields >= 1 /\ (settled19.crossOrderRejectedReturnBitfield1 # << >> /\ (settled19.crossOrderRejectedReturnBitfield1[1] \div 4) % 2 > 0) THEN (IF settled19.price = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled19.price) ELSE << >>]
        settled21 == [settled20 EXCEPT !.symbolLong = IF settled20.numberOfReturnBitfields >= 2 /\ (settled20.crossOrderRejectedReturnBitfield2 # << >> /\ settled20.crossOrderRejectedReturnBitfield2[1] % 2 > 0) THEN (IF settled20.symbolLong = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled20.symbolLong) ELSE << >>]
        settled22 == [settled21 EXCEPT !.idSource = IF settled21.numberOfReturnBitfields >= 2 /\ (settled21.crossOrderRejectedReturnBitfield2 # << >> /\ (settled21.crossOrderRejectedReturnBitfield2[1] \div 8) % 2 > 0) THEN (IF settled21.idSource = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled21.idSource) ELSE << >>]
        settled23 == [settled22 EXCEPT !.securityId = IF settled22.numberOfReturnBitfields >= 2 /\ (settled22.crossOrderRejectedReturnBitfield2 # << >> /\ (settled22.crossOrderRejectedReturnBitfield2[1] \div 16) % 2 > 0) THEN (IF settled22.securityId = << >> THEN <<[i \in 1 .. 16 |-> 0]>> ELSE settled22.securityId) ELSE << >>]
        settled24 == [settled23 EXCEPT !.orderQty = IF settled23.numberOfReturnBitfields >= 3 /\ (settled23.crossOrderRejectedReturnBitfield3 # << >> /\ (settled23.crossOrderRejectedReturnBitfield3[1] \div 64) % 2 > 0) THEN (IF settled23.orderQty = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled23.orderQty) ELSE << >>]
        settled25 == [settled24 EXCEPT !.preventMatch = IF settled24.numberOfReturnBitfields >= 3 /\ (settled24.crossOrderRejectedReturnBitfield3 # << >> /\ (settled24.crossOrderRejectedReturnBitfield3[1] \div 128) % 2 > 0) THEN (IF settled24.preventMatch = << >> THEN <<[i \in 1 .. 3 |-> 0]>> ELSE settled24.preventMatch) ELSE << >>]
        settled26 == [settled25 EXCEPT !.extExecInst = IF settled25.numberOfReturnBitfields >= 6 /\ (settled25.crossOrderRejectedReturnBitfield6 # << >> /\ (settled25.crossOrderRejectedReturnBitfield6[1] \div 16) % 2 > 0) THEN (IF settled25.extExecInst = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled25.extExecInst) ELSE << >>]
        settled27 == [settled26 EXCEPT !.crossType = IF settled26.numberOfReturnBitfields >= 9 /\ (settled26.crossOrderRejectedReturnBitfield9 # << >> /\ (settled26.crossOrderRejectedReturnBitfield9[1] \div 64) % 2 > 0) THEN (IF settled26.crossType = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled26.crossType) ELSE << >>]
        settled28 == [settled27 EXCEPT !.crossPrioritization = IF settled27.numberOfReturnBitfields >= 9 /\ (settled27.crossOrderRejectedReturnBitfield9 # << >> /\ (settled27.crossOrderRejectedReturnBitfield9[1] \div 128) % 2 > 0) THEN (IF settled27.crossPrioritization = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled27.crossPrioritization) ELSE << >>]
        settled29 == [settled28 EXCEPT !.routingFirmId = IF settled28.numberOfReturnBitfields >= 10 /\ (settled28.crossOrderRejectedReturnBitfield10 # << >> /\ (settled28.crossOrderRejectedReturnBitfield10[1] \div 8) % 2 > 0) THEN (IF settled28.routingFirmId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled28.routingFirmId) ELSE << >>]
        settled30 == [settled29 EXCEPT !.subreason = IF settled29.numberOfReturnBitfields >= 18 /\ (settled29.crossOrderRejectedReturnBitfield18 # << >> /\ (settled29.crossOrderRejectedReturnBitfield18[1] \div 4) % 2 > 0) THEN (IF settled29.subreason = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled29.subreason) ELSE << >>]
    IN  settled30

ZeroCrossOrderRejectedMessage ==
    SettleCrossOrderRejectedMessage([ transactionTime                    |-> [i \in 1 .. 8 |-> 0],
                                      crossId                            |-> [i \in 1 .. 20 |-> 0],
                                      orderRejectReason                  |-> [i \in 1 .. 1 |-> 0],
                                      text                               |-> [i \in 1 .. 60 |-> 0],
                                      reserved1                          |-> [i \in 1 .. 1 |-> 0],
                                      numberOfReturnBitfields            |-> 0,
                                      crossOrderRejectedReturnBitfield1  |-> << >>,
                                      crossOrderRejectedReturnBitfield2  |-> << >>,
                                      crossOrderRejectedReturnBitfield3  |-> << >>,
                                      crossOrderRejectedReturnBitfield4  |-> << >>,
                                      crossOrderRejectedReturnBitfield5  |-> << >>,
                                      crossOrderRejectedReturnBitfield6  |-> << >>,
                                      crossOrderRejectedReturnBitfield7  |-> << >>,
                                      crossOrderRejectedReturnBitfield8  |-> << >>,
                                      crossOrderRejectedReturnBitfield9  |-> << >>,
                                      crossOrderRejectedReturnBitfield10 |-> << >>,
                                      crossOrderRejectedReturnBitfield11 |-> << >>,
                                      crossOrderRejectedReturnBitfield12 |-> << >>,
                                      crossOrderRejectedReturnBitfield13 |-> << >>,
                                      crossOrderRejectedReturnBitfield14 |-> << >>,
                                      crossOrderRejectedReturnBitfield15 |-> << >>,
                                      crossOrderRejectedReturnBitfield16 |-> << >>,
                                      crossOrderRejectedReturnBitfield17 |-> << >>,
                                      crossOrderRejectedReturnBitfield18 |-> << >>,
                                      crossOrderRejectedReturnBitfield19 |-> << >>,
                                      price                              |-> << >>,
                                      symbolLong                         |-> << >>,
                                      idSource                           |-> << >>,
                                      securityId                         |-> << >>,
                                      orderQty                           |-> << >>,
                                      preventMatch                       |-> << >>,
                                      extExecInst                        |-> << >>,
                                      crossType                          |-> << >>,
                                      crossPrioritization                |-> << >>,
                                      routingFirmId                      |-> << >>,
                                      subreason                          |-> << >> ])

(* Cross Order Rejected Message at zero, then each field in turn at the values it is checked at *)
CheckedCrossOrderRejectedMessage ==
    { ZeroCrossOrderRejectedMessage }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.transactionTime = one]) : one \in Sample(8) }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.crossId = one]) : one \in Sample(20) }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.orderRejectReason = one]) : one \in Sample(1) }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.text = one]) : one \in Sample(60) }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.reserved1 = one]) : one \in Sample(1) }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = one]) : one \in {0, 1, 255} }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 1, !.crossOrderRejectedReturnBitfield1 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 2, !.crossOrderRejectedReturnBitfield2 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 3, !.crossOrderRejectedReturnBitfield3 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 4, !.crossOrderRejectedReturnBitfield4 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 5, !.crossOrderRejectedReturnBitfield5 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 6, !.crossOrderRejectedReturnBitfield6 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 7, !.crossOrderRejectedReturnBitfield7 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 8, !.crossOrderRejectedReturnBitfield8 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 9, !.crossOrderRejectedReturnBitfield9 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 10, !.crossOrderRejectedReturnBitfield10 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 11, !.crossOrderRejectedReturnBitfield11 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 12, !.crossOrderRejectedReturnBitfield12 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 13, !.crossOrderRejectedReturnBitfield13 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 14, !.crossOrderRejectedReturnBitfield14 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 15, !.crossOrderRejectedReturnBitfield15 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 16, !.crossOrderRejectedReturnBitfield16 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 17, !.crossOrderRejectedReturnBitfield17 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 18, !.crossOrderRejectedReturnBitfield18 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 19, !.crossOrderRejectedReturnBitfield19 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 1, !.crossOrderRejectedReturnBitfield1 = <<4>>, !.price = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 2, !.crossOrderRejectedReturnBitfield2 = <<1>>, !.symbolLong = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 2, !.crossOrderRejectedReturnBitfield2 = <<8>>, !.idSource = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 2, !.crossOrderRejectedReturnBitfield2 = <<16>>, !.securityId = one]) : one \in { <<held>> : held \in Sample(16) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 3, !.crossOrderRejectedReturnBitfield3 = <<64>>, !.orderQty = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 3, !.crossOrderRejectedReturnBitfield3 = <<128>>, !.preventMatch = one]) : one \in { <<held>> : held \in Sample(3) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 6, !.crossOrderRejectedReturnBitfield6 = <<16>>, !.extExecInst = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 9, !.crossOrderRejectedReturnBitfield9 = <<64>>, !.crossType = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 9, !.crossOrderRejectedReturnBitfield9 = <<128>>, !.crossPrioritization = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 10, !.crossOrderRejectedReturnBitfield10 = <<8>>, !.routingFirmId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleCrossOrderRejectedMessage([ZeroCrossOrderRejectedMessage EXCEPT !.numberOfReturnBitfields = 18, !.crossOrderRejectedReturnBitfield18 = <<4>>, !.subreason = one]) : one \in { <<held>> : held \in Sample(1) } }

(***************************************************************************)
(* Quote Update Rejected Message: 42 bytes                                 *)
(***************************************************************************)

QuoteUpdateRejectedMessage ==
    [ transactionTime   : Sample(8),
      quoteUpdateId     : Sample(16),
      quoteRejectReason : Sample(1),
      reserved17        : Sample(17) ]

EncodeQuoteUpdateRejectedMessage(message) ==
    message.transactionTime
        \o message.quoteUpdateId
        \o message.quoteRejectReason
        \o message.reserved17

DecodeQuoteUpdateRejectedMessage(bytes) ==
    LET transactionTime == ReadBytes(bytes, 8) IN IF ~transactionTime.ok THEN Fail ELSE
    LET quoteUpdateId == ReadBytes(transactionTime.rest, 16) IN IF ~quoteUpdateId.ok THEN Fail ELSE
    LET quoteRejectReason == ReadBytes(quoteUpdateId.rest, 1) IN IF ~quoteRejectReason.ok THEN Fail ELSE
    LET reserved17 == ReadBytes(quoteRejectReason.rest, 17) IN IF ~reserved17.ok THEN Fail ELSE
    Ok([ transactionTime   |-> transactionTime.value,
         quoteUpdateId     |-> quoteUpdateId.value,
         quoteRejectReason |-> quoteRejectReason.value,
         reserved17        |-> reserved17.value ], reserved17.rest)

ZeroQuoteUpdateRejectedMessage ==
    [ transactionTime   |-> [i \in 1 .. 8 |-> 0],
      quoteUpdateId     |-> [i \in 1 .. 16 |-> 0],
      quoteRejectReason |-> [i \in 1 .. 1 |-> 0],
      reserved17        |-> [i \in 1 .. 17 |-> 0] ]

(* Quote Update Rejected Message at zero, then each field in turn at the values it is checked at *)
CheckedQuoteUpdateRejectedMessage ==
    { ZeroQuoteUpdateRejectedMessage }
        \cup { [ZeroQuoteUpdateRejectedMessage EXCEPT !.transactionTime = one] : one \in Sample(8) }
        \cup { [ZeroQuoteUpdateRejectedMessage EXCEPT !.quoteUpdateId = one] : one \in Sample(16) }
        \cup { [ZeroQuoteUpdateRejectedMessage EXCEPT !.quoteRejectReason = one] : one \in Sample(1) }
        \cup { [ZeroQuoteUpdateRejectedMessage EXCEPT !.reserved17 = one] : one \in Sample(17) }

(***************************************************************************)
(* Order Modified V 2 Message                                              *)
(***************************************************************************)

OrderModifiedV2Message ==
    [ transactionTime                 : Sample(8),
      clOrdId                         : Sample(20),
      orderId                         : Sample(8),
      reserved1                       : Sample(1),
      numberOfReturnBitfields         : 0 .. 255,
      orderModifiedV2ReturnBitfield1  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderModifiedV2ReturnBitfield2  : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderModifiedV2ReturnBitfield3  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderModifiedV2ReturnBitfield4  : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderModifiedV2ReturnBitfield5  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderModifiedV2ReturnBitfield6  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderModifiedV2ReturnBitfield7  : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderModifiedV2ReturnBitfield8  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderModifiedV2ReturnBitfield9  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderModifiedV2ReturnBitfield10 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderModifiedV2ReturnBitfield11 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderModifiedV2ReturnBitfield12 : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderModifiedV2ReturnBitfield13 : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderModifiedV2ReturnBitfield14 : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderModifiedV2ReturnBitfield15 : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderModifiedV2ReturnBitfield16 : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderModifiedV2ReturnBitfield17 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderModifiedV2ReturnBitfield18 : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderModifiedV2ReturnBitfield19 : { << >> } \cup { <<held>> : held \in Sample(1) },
      side                            : { << >> } \cup { <<held>> : held \in Sample(1) },
      price                           : { << >> } \cup { <<held>> : held \in Sample(8) },
      ordType                         : { << >> } \cup { <<held>> : held \in Sample(1) },
      timeInForce                     : { << >> } \cup { <<held>> : held \in Sample(1) },
      minQty                          : { << >> } \cup { <<held>> : held \in Sample(4) },
      account                         : { << >> } \cup { <<held>> : held \in Sample(16) },
      clearingFirm                    : { << >> } \cup { <<held>> : held \in Sample(4) },
      clearingAccount                 : { << >> } \cup { <<held>> : held \in Sample(4) },
      displayIndicator                : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderQty                        : { << >> } \cup { <<held>> : held \in Sample(4) },
      preventMatch                    : { << >> } \cup { <<held>> : held \in Sample(3) },
      origClOrdId                     : { << >> } \cup { <<held>> : held \in Sample(20) },
      leavesQty                       : { << >> } \cup { <<held>> : held \in Sample(4) },
      lastShares                      : { << >> } \cup { <<held>> : held \in Sample(4) },
      lastPx                          : { << >> } \cup { <<held>> : held \in Sample(8) },
      displayPrice                    : { << >> } \cup { <<held>> : held \in Sample(8) },
      workingPrice                    : { << >> } \cup { <<held>> : held \in Sample(8) },
      baseLiquidityIndicator          : { << >> } \cup { <<held>> : held \in Sample(1) },
      expireTime                      : { << >> } \cup { <<held>> : held \in Sample(8) },
      secondaryOrderId                : { << >> } \cup { <<held>> : held \in Sample(8) },
      extExecInst                     : { << >> } \cup { <<held>> : held \in Sample(1) },
      stopPx                          : { << >> } \cup { <<held>> : held \in Sample(8) },
      routingInst                     : { << >> } \cup { <<held>> : held \in Sample(4) },
      auctionId                       : { << >> } \cup { <<held>> : held \in Sample(8) },
      liquidityProvision              : { << >> } \cup { <<held>> : held \in Sample(1) },
      clientQualifiedRole             : { << >> } \cup { <<held>> : held \in Sample(1) },
      clientId                        : { << >> } \cup { <<held>> : held \in Sample(4) },
      investorId                      : { << >> } \cup { <<held>> : held \in Sample(4) },
      executorId                      : { << >> } \cup { <<held>> : held \in Sample(4) },
      orderOrigination                : { << >> } \cup { <<held>> : held \in Sample(1) },
      algorithmicIndicator            : { << >> } \cup { <<held>> : held \in Sample(1) },
      investorQualifiedRole           : { << >> } \cup { <<held>> : held \in Sample(1) },
      executorQualifiedRole           : { << >> } \cup { <<held>> : held \in Sample(1) },
      custOrderHandlingInst           : { << >> } \cup { <<held>> : held \in Sample(1) } ]

EncodeOrderModifiedV2Message(message) ==
    message.transactionTime
        \o message.clOrdId
        \o message.orderId
        \o message.reserved1
        \o EncodeUIntBE(message.numberOfReturnBitfields, 1)
        \o (IF message.orderModifiedV2ReturnBitfield1 = << >> THEN << >> ELSE EncodeUIntLE(message.orderModifiedV2ReturnBitfield1[1], 1))
        \o (IF message.orderModifiedV2ReturnBitfield2 = << >> THEN << >> ELSE message.orderModifiedV2ReturnBitfield2[1])
        \o (IF message.orderModifiedV2ReturnBitfield3 = << >> THEN << >> ELSE EncodeUIntLE(message.orderModifiedV2ReturnBitfield3[1], 1))
        \o (IF message.orderModifiedV2ReturnBitfield4 = << >> THEN << >> ELSE message.orderModifiedV2ReturnBitfield4[1])
        \o (IF message.orderModifiedV2ReturnBitfield5 = << >> THEN << >> ELSE EncodeUIntLE(message.orderModifiedV2ReturnBitfield5[1], 1))
        \o (IF message.orderModifiedV2ReturnBitfield6 = << >> THEN << >> ELSE EncodeUIntLE(message.orderModifiedV2ReturnBitfield6[1], 1))
        \o (IF message.orderModifiedV2ReturnBitfield7 = << >> THEN << >> ELSE message.orderModifiedV2ReturnBitfield7[1])
        \o (IF message.orderModifiedV2ReturnBitfield8 = << >> THEN << >> ELSE EncodeUIntLE(message.orderModifiedV2ReturnBitfield8[1], 1))
        \o (IF message.orderModifiedV2ReturnBitfield9 = << >> THEN << >> ELSE EncodeUIntLE(message.orderModifiedV2ReturnBitfield9[1], 1))
        \o (IF message.orderModifiedV2ReturnBitfield10 = << >> THEN << >> ELSE EncodeUIntLE(message.orderModifiedV2ReturnBitfield10[1], 1))
        \o (IF message.orderModifiedV2ReturnBitfield11 = << >> THEN << >> ELSE EncodeUIntLE(message.orderModifiedV2ReturnBitfield11[1], 1))
        \o (IF message.orderModifiedV2ReturnBitfield12 = << >> THEN << >> ELSE message.orderModifiedV2ReturnBitfield12[1])
        \o (IF message.orderModifiedV2ReturnBitfield13 = << >> THEN << >> ELSE message.orderModifiedV2ReturnBitfield13[1])
        \o (IF message.orderModifiedV2ReturnBitfield14 = << >> THEN << >> ELSE message.orderModifiedV2ReturnBitfield14[1])
        \o (IF message.orderModifiedV2ReturnBitfield15 = << >> THEN << >> ELSE message.orderModifiedV2ReturnBitfield15[1])
        \o (IF message.orderModifiedV2ReturnBitfield16 = << >> THEN << >> ELSE message.orderModifiedV2ReturnBitfield16[1])
        \o (IF message.orderModifiedV2ReturnBitfield17 = << >> THEN << >> ELSE EncodeUIntLE(message.orderModifiedV2ReturnBitfield17[1], 1))
        \o (IF message.orderModifiedV2ReturnBitfield18 = << >> THEN << >> ELSE message.orderModifiedV2ReturnBitfield18[1])
        \o (IF message.orderModifiedV2ReturnBitfield19 = << >> THEN << >> ELSE message.orderModifiedV2ReturnBitfield19[1])
        \o (IF message.side = << >> THEN << >> ELSE message.side[1])
        \o (IF message.price = << >> THEN << >> ELSE message.price[1])
        \o (IF message.ordType = << >> THEN << >> ELSE message.ordType[1])
        \o (IF message.timeInForce = << >> THEN << >> ELSE message.timeInForce[1])
        \o (IF message.minQty = << >> THEN << >> ELSE message.minQty[1])
        \o (IF message.account = << >> THEN << >> ELSE message.account[1])
        \o (IF message.clearingFirm = << >> THEN << >> ELSE message.clearingFirm[1])
        \o (IF message.clearingAccount = << >> THEN << >> ELSE message.clearingAccount[1])
        \o (IF message.displayIndicator = << >> THEN << >> ELSE message.displayIndicator[1])
        \o (IF message.orderQty = << >> THEN << >> ELSE message.orderQty[1])
        \o (IF message.preventMatch = << >> THEN << >> ELSE message.preventMatch[1])
        \o (IF message.origClOrdId = << >> THEN << >> ELSE message.origClOrdId[1])
        \o (IF message.leavesQty = << >> THEN << >> ELSE message.leavesQty[1])
        \o (IF message.lastShares = << >> THEN << >> ELSE message.lastShares[1])
        \o (IF message.lastPx = << >> THEN << >> ELSE message.lastPx[1])
        \o (IF message.displayPrice = << >> THEN << >> ELSE message.displayPrice[1])
        \o (IF message.workingPrice = << >> THEN << >> ELSE message.workingPrice[1])
        \o (IF message.baseLiquidityIndicator = << >> THEN << >> ELSE message.baseLiquidityIndicator[1])
        \o (IF message.expireTime = << >> THEN << >> ELSE message.expireTime[1])
        \o (IF message.secondaryOrderId = << >> THEN << >> ELSE message.secondaryOrderId[1])
        \o (IF message.extExecInst = << >> THEN << >> ELSE message.extExecInst[1])
        \o (IF message.stopPx = << >> THEN << >> ELSE message.stopPx[1])
        \o (IF message.routingInst = << >> THEN << >> ELSE message.routingInst[1])
        \o (IF message.auctionId = << >> THEN << >> ELSE message.auctionId[1])
        \o (IF message.liquidityProvision = << >> THEN << >> ELSE message.liquidityProvision[1])
        \o (IF message.clientQualifiedRole = << >> THEN << >> ELSE message.clientQualifiedRole[1])
        \o (IF message.clientId = << >> THEN << >> ELSE message.clientId[1])
        \o (IF message.investorId = << >> THEN << >> ELSE message.investorId[1])
        \o (IF message.executorId = << >> THEN << >> ELSE message.executorId[1])
        \o (IF message.orderOrigination = << >> THEN << >> ELSE message.orderOrigination[1])
        \o (IF message.algorithmicIndicator = << >> THEN << >> ELSE message.algorithmicIndicator[1])
        \o (IF message.investorQualifiedRole = << >> THEN << >> ELSE message.investorQualifiedRole[1])
        \o (IF message.executorQualifiedRole = << >> THEN << >> ELSE message.executorQualifiedRole[1])
        \o (IF message.custOrderHandlingInst = << >> THEN << >> ELSE message.custOrderHandlingInst[1])

DecodeOrderModifiedV2Message(bytes) ==
    LET transactionTime == ReadBytes(bytes, 8) IN IF ~transactionTime.ok THEN Fail ELSE
    LET clOrdId == ReadBytes(transactionTime.rest, 20) IN IF ~clOrdId.ok THEN Fail ELSE
    LET orderId == ReadBytes(clOrdId.rest, 8) IN IF ~orderId.ok THEN Fail ELSE
    LET reserved1 == ReadBytes(orderId.rest, 1) IN IF ~reserved1.ok THEN Fail ELSE
    LET numberOfReturnBitfields == ReadUIntBE(reserved1.rest, 1) IN IF ~numberOfReturnBitfields.ok THEN Fail ELSE
    LET orderModifiedV2ReturnBitfield1 == ReadWhen(numberOfReturnBitfields.value >= 1, ReadUIntLE(numberOfReturnBitfields.rest, 1), numberOfReturnBitfields.rest) IN IF ~orderModifiedV2ReturnBitfield1.ok THEN Fail ELSE
    LET orderModifiedV2ReturnBitfield2 == ReadWhen(numberOfReturnBitfields.value >= 2, ReadBytes(orderModifiedV2ReturnBitfield1.rest, 1), orderModifiedV2ReturnBitfield1.rest) IN IF ~orderModifiedV2ReturnBitfield2.ok THEN Fail ELSE
    LET orderModifiedV2ReturnBitfield3 == ReadWhen(numberOfReturnBitfields.value >= 3, ReadUIntLE(orderModifiedV2ReturnBitfield2.rest, 1), orderModifiedV2ReturnBitfield2.rest) IN IF ~orderModifiedV2ReturnBitfield3.ok THEN Fail ELSE
    LET orderModifiedV2ReturnBitfield4 == ReadWhen(numberOfReturnBitfields.value >= 4, ReadBytes(orderModifiedV2ReturnBitfield3.rest, 1), orderModifiedV2ReturnBitfield3.rest) IN IF ~orderModifiedV2ReturnBitfield4.ok THEN Fail ELSE
    LET orderModifiedV2ReturnBitfield5 == ReadWhen(numberOfReturnBitfields.value >= 5, ReadUIntLE(orderModifiedV2ReturnBitfield4.rest, 1), orderModifiedV2ReturnBitfield4.rest) IN IF ~orderModifiedV2ReturnBitfield5.ok THEN Fail ELSE
    LET orderModifiedV2ReturnBitfield6 == ReadWhen(numberOfReturnBitfields.value >= 6, ReadUIntLE(orderModifiedV2ReturnBitfield5.rest, 1), orderModifiedV2ReturnBitfield5.rest) IN IF ~orderModifiedV2ReturnBitfield6.ok THEN Fail ELSE
    LET orderModifiedV2ReturnBitfield7 == ReadWhen(numberOfReturnBitfields.value >= 7, ReadBytes(orderModifiedV2ReturnBitfield6.rest, 1), orderModifiedV2ReturnBitfield6.rest) IN IF ~orderModifiedV2ReturnBitfield7.ok THEN Fail ELSE
    LET orderModifiedV2ReturnBitfield8 == ReadWhen(numberOfReturnBitfields.value >= 8, ReadUIntLE(orderModifiedV2ReturnBitfield7.rest, 1), orderModifiedV2ReturnBitfield7.rest) IN IF ~orderModifiedV2ReturnBitfield8.ok THEN Fail ELSE
    LET orderModifiedV2ReturnBitfield9 == ReadWhen(numberOfReturnBitfields.value >= 9, ReadUIntLE(orderModifiedV2ReturnBitfield8.rest, 1), orderModifiedV2ReturnBitfield8.rest) IN IF ~orderModifiedV2ReturnBitfield9.ok THEN Fail ELSE
    LET orderModifiedV2ReturnBitfield10 == ReadWhen(numberOfReturnBitfields.value >= 10, ReadUIntLE(orderModifiedV2ReturnBitfield9.rest, 1), orderModifiedV2ReturnBitfield9.rest) IN IF ~orderModifiedV2ReturnBitfield10.ok THEN Fail ELSE
    LET orderModifiedV2ReturnBitfield11 == ReadWhen(numberOfReturnBitfields.value >= 11, ReadUIntLE(orderModifiedV2ReturnBitfield10.rest, 1), orderModifiedV2ReturnBitfield10.rest) IN IF ~orderModifiedV2ReturnBitfield11.ok THEN Fail ELSE
    LET orderModifiedV2ReturnBitfield12 == ReadWhen(numberOfReturnBitfields.value >= 12, ReadBytes(orderModifiedV2ReturnBitfield11.rest, 1), orderModifiedV2ReturnBitfield11.rest) IN IF ~orderModifiedV2ReturnBitfield12.ok THEN Fail ELSE
    LET orderModifiedV2ReturnBitfield13 == ReadWhen(numberOfReturnBitfields.value >= 13, ReadBytes(orderModifiedV2ReturnBitfield12.rest, 1), orderModifiedV2ReturnBitfield12.rest) IN IF ~orderModifiedV2ReturnBitfield13.ok THEN Fail ELSE
    LET orderModifiedV2ReturnBitfield14 == ReadWhen(numberOfReturnBitfields.value >= 14, ReadBytes(orderModifiedV2ReturnBitfield13.rest, 1), orderModifiedV2ReturnBitfield13.rest) IN IF ~orderModifiedV2ReturnBitfield14.ok THEN Fail ELSE
    LET orderModifiedV2ReturnBitfield15 == ReadWhen(numberOfReturnBitfields.value >= 15, ReadBytes(orderModifiedV2ReturnBitfield14.rest, 1), orderModifiedV2ReturnBitfield14.rest) IN IF ~orderModifiedV2ReturnBitfield15.ok THEN Fail ELSE
    LET orderModifiedV2ReturnBitfield16 == ReadWhen(numberOfReturnBitfields.value >= 16, ReadBytes(orderModifiedV2ReturnBitfield15.rest, 1), orderModifiedV2ReturnBitfield15.rest) IN IF ~orderModifiedV2ReturnBitfield16.ok THEN Fail ELSE
    LET orderModifiedV2ReturnBitfield17 == ReadWhen(numberOfReturnBitfields.value >= 17, ReadUIntLE(orderModifiedV2ReturnBitfield16.rest, 1), orderModifiedV2ReturnBitfield16.rest) IN IF ~orderModifiedV2ReturnBitfield17.ok THEN Fail ELSE
    LET orderModifiedV2ReturnBitfield18 == ReadWhen(numberOfReturnBitfields.value >= 18, ReadBytes(orderModifiedV2ReturnBitfield17.rest, 1), orderModifiedV2ReturnBitfield17.rest) IN IF ~orderModifiedV2ReturnBitfield18.ok THEN Fail ELSE
    LET orderModifiedV2ReturnBitfield19 == ReadWhen(numberOfReturnBitfields.value >= 19, ReadBytes(orderModifiedV2ReturnBitfield18.rest, 1), orderModifiedV2ReturnBitfield18.rest) IN IF ~orderModifiedV2ReturnBitfield19.ok THEN Fail ELSE
    LET side == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderModifiedV2ReturnBitfield1.value # << >> /\ orderModifiedV2ReturnBitfield1.value[1] % 2 > 0), ReadBytes(orderModifiedV2ReturnBitfield19.rest, 1), orderModifiedV2ReturnBitfield19.rest) IN IF ~side.ok THEN Fail ELSE
    LET price == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderModifiedV2ReturnBitfield1.value # << >> /\ (orderModifiedV2ReturnBitfield1.value[1] \div 4) % 2 > 0), ReadBytes(side.rest, 8), side.rest) IN IF ~price.ok THEN Fail ELSE
    LET ordType == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderModifiedV2ReturnBitfield1.value # << >> /\ (orderModifiedV2ReturnBitfield1.value[1] \div 16) % 2 > 0), ReadBytes(price.rest, 1), price.rest) IN IF ~ordType.ok THEN Fail ELSE
    LET timeInForce == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderModifiedV2ReturnBitfield1.value # << >> /\ (orderModifiedV2ReturnBitfield1.value[1] \div 32) % 2 > 0), ReadBytes(ordType.rest, 1), ordType.rest) IN IF ~timeInForce.ok THEN Fail ELSE
    LET minQty == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderModifiedV2ReturnBitfield1.value # << >> /\ (orderModifiedV2ReturnBitfield1.value[1] \div 64) % 2 > 0), ReadBytes(timeInForce.rest, 4), timeInForce.rest) IN IF ~minQty.ok THEN Fail ELSE
    LET account == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderModifiedV2ReturnBitfield3.value # << >> /\ orderModifiedV2ReturnBitfield3.value[1] % 2 > 0), ReadBytes(minQty.rest, 16), minQty.rest) IN IF ~account.ok THEN Fail ELSE
    LET clearingFirm == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderModifiedV2ReturnBitfield3.value # << >> /\ (orderModifiedV2ReturnBitfield3.value[1] \div 2) % 2 > 0), ReadBytes(account.rest, 4), account.rest) IN IF ~clearingFirm.ok THEN Fail ELSE
    LET clearingAccount == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderModifiedV2ReturnBitfield3.value # << >> /\ (orderModifiedV2ReturnBitfield3.value[1] \div 4) % 2 > 0), ReadBytes(clearingFirm.rest, 4), clearingFirm.rest) IN IF ~clearingAccount.ok THEN Fail ELSE
    LET displayIndicator == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderModifiedV2ReturnBitfield3.value # << >> /\ (orderModifiedV2ReturnBitfield3.value[1] \div 8) % 2 > 0), ReadBytes(clearingAccount.rest, 1), clearingAccount.rest) IN IF ~displayIndicator.ok THEN Fail ELSE
    LET orderQty == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderModifiedV2ReturnBitfield3.value # << >> /\ (orderModifiedV2ReturnBitfield3.value[1] \div 64) % 2 > 0), ReadBytes(displayIndicator.rest, 4), displayIndicator.rest) IN IF ~orderQty.ok THEN Fail ELSE
    LET preventMatch == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderModifiedV2ReturnBitfield3.value # << >> /\ (orderModifiedV2ReturnBitfield3.value[1] \div 128) % 2 > 0), ReadBytes(orderQty.rest, 3), orderQty.rest) IN IF ~preventMatch.ok THEN Fail ELSE
    LET origClOrdId == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderModifiedV2ReturnBitfield5.value # << >> /\ orderModifiedV2ReturnBitfield5.value[1] % 2 > 0), ReadBytes(preventMatch.rest, 20), preventMatch.rest) IN IF ~origClOrdId.ok THEN Fail ELSE
    LET leavesQty == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderModifiedV2ReturnBitfield5.value # << >> /\ (orderModifiedV2ReturnBitfield5.value[1] \div 2) % 2 > 0), ReadBytes(origClOrdId.rest, 4), origClOrdId.rest) IN IF ~leavesQty.ok THEN Fail ELSE
    LET lastShares == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderModifiedV2ReturnBitfield5.value # << >> /\ (orderModifiedV2ReturnBitfield5.value[1] \div 4) % 2 > 0), ReadBytes(leavesQty.rest, 4), leavesQty.rest) IN IF ~lastShares.ok THEN Fail ELSE
    LET lastPx == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderModifiedV2ReturnBitfield5.value # << >> /\ (orderModifiedV2ReturnBitfield5.value[1] \div 8) % 2 > 0), ReadBytes(lastShares.rest, 8), lastShares.rest) IN IF ~lastPx.ok THEN Fail ELSE
    LET displayPrice == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderModifiedV2ReturnBitfield5.value # << >> /\ (orderModifiedV2ReturnBitfield5.value[1] \div 16) % 2 > 0), ReadBytes(lastPx.rest, 8), lastPx.rest) IN IF ~displayPrice.ok THEN Fail ELSE
    LET workingPrice == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderModifiedV2ReturnBitfield5.value # << >> /\ (orderModifiedV2ReturnBitfield5.value[1] \div 32) % 2 > 0), ReadBytes(displayPrice.rest, 8), displayPrice.rest) IN IF ~workingPrice.ok THEN Fail ELSE
    LET baseLiquidityIndicator == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderModifiedV2ReturnBitfield5.value # << >> /\ (orderModifiedV2ReturnBitfield5.value[1] \div 64) % 2 > 0), ReadBytes(workingPrice.rest, 1), workingPrice.rest) IN IF ~baseLiquidityIndicator.ok THEN Fail ELSE
    LET expireTime == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderModifiedV2ReturnBitfield5.value # << >> /\ (orderModifiedV2ReturnBitfield5.value[1] \div 128) % 2 > 0), ReadBytes(baseLiquidityIndicator.rest, 8), baseLiquidityIndicator.rest) IN IF ~expireTime.ok THEN Fail ELSE
    LET secondaryOrderId == ReadWhen(numberOfReturnBitfields.value >= 6 /\ (orderModifiedV2ReturnBitfield6.value # << >> /\ orderModifiedV2ReturnBitfield6.value[1] % 2 > 0), ReadBytes(expireTime.rest, 8), expireTime.rest) IN IF ~secondaryOrderId.ok THEN Fail ELSE
    LET extExecInst == ReadWhen(numberOfReturnBitfields.value >= 6 /\ (orderModifiedV2ReturnBitfield6.value # << >> /\ (orderModifiedV2ReturnBitfield6.value[1] \div 16) % 2 > 0), ReadBytes(secondaryOrderId.rest, 1), secondaryOrderId.rest) IN IF ~extExecInst.ok THEN Fail ELSE
    LET stopPx == ReadWhen(numberOfReturnBitfields.value >= 8 /\ (orderModifiedV2ReturnBitfield8.value # << >> /\ (orderModifiedV2ReturnBitfield8.value[1] \div 4) % 2 > 0), ReadBytes(extExecInst.rest, 8), extExecInst.rest) IN IF ~stopPx.ok THEN Fail ELSE
    LET routingInst == ReadWhen(numberOfReturnBitfields.value >= 8 /\ (orderModifiedV2ReturnBitfield8.value # << >> /\ (orderModifiedV2ReturnBitfield8.value[1] \div 8) % 2 > 0), ReadBytes(stopPx.rest, 4), stopPx.rest) IN IF ~routingInst.ok THEN Fail ELSE
    LET auctionId == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (orderModifiedV2ReturnBitfield9.value # << >> /\ (orderModifiedV2ReturnBitfield9.value[1] \div 4) % 2 > 0), ReadBytes(routingInst.rest, 8), routingInst.rest) IN IF ~auctionId.ok THEN Fail ELSE
    LET liquidityProvision == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (orderModifiedV2ReturnBitfield9.value # << >> /\ (orderModifiedV2ReturnBitfield9.value[1] \div 16) % 2 > 0), ReadBytes(auctionId.rest, 1), auctionId.rest) IN IF ~liquidityProvision.ok THEN Fail ELSE
    LET clientQualifiedRole == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (orderModifiedV2ReturnBitfield10.value # << >> /\ (orderModifiedV2ReturnBitfield10.value[1] \div 128) % 2 > 0), ReadBytes(liquidityProvision.rest, 1), liquidityProvision.rest) IN IF ~clientQualifiedRole.ok THEN Fail ELSE
    LET clientId == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (orderModifiedV2ReturnBitfield11.value # << >> /\ orderModifiedV2ReturnBitfield11.value[1] % 2 > 0), ReadBytes(clientQualifiedRole.rest, 4), clientQualifiedRole.rest) IN IF ~clientId.ok THEN Fail ELSE
    LET investorId == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (orderModifiedV2ReturnBitfield11.value # << >> /\ (orderModifiedV2ReturnBitfield11.value[1] \div 2) % 2 > 0), ReadBytes(clientId.rest, 4), clientId.rest) IN IF ~investorId.ok THEN Fail ELSE
    LET executorId == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (orderModifiedV2ReturnBitfield11.value # << >> /\ (orderModifiedV2ReturnBitfield11.value[1] \div 4) % 2 > 0), ReadBytes(investorId.rest, 4), investorId.rest) IN IF ~executorId.ok THEN Fail ELSE
    LET orderOrigination == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (orderModifiedV2ReturnBitfield11.value # << >> /\ (orderModifiedV2ReturnBitfield11.value[1] \div 8) % 2 > 0), ReadBytes(executorId.rest, 1), executorId.rest) IN IF ~orderOrigination.ok THEN Fail ELSE
    LET algorithmicIndicator == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (orderModifiedV2ReturnBitfield11.value # << >> /\ (orderModifiedV2ReturnBitfield11.value[1] \div 16) % 2 > 0), ReadBytes(orderOrigination.rest, 1), orderOrigination.rest) IN IF ~algorithmicIndicator.ok THEN Fail ELSE
    LET investorQualifiedRole == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (orderModifiedV2ReturnBitfield11.value # << >> /\ (orderModifiedV2ReturnBitfield11.value[1] \div 64) % 2 > 0), ReadBytes(algorithmicIndicator.rest, 1), algorithmicIndicator.rest) IN IF ~investorQualifiedRole.ok THEN Fail ELSE
    LET executorQualifiedRole == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (orderModifiedV2ReturnBitfield11.value # << >> /\ (orderModifiedV2ReturnBitfield11.value[1] \div 128) % 2 > 0), ReadBytes(investorQualifiedRole.rest, 1), investorQualifiedRole.rest) IN IF ~executorQualifiedRole.ok THEN Fail ELSE
    LET custOrderHandlingInst == ReadWhen(numberOfReturnBitfields.value >= 17 /\ (orderModifiedV2ReturnBitfield17.value # << >> /\ (orderModifiedV2ReturnBitfield17.value[1] \div 128) % 2 > 0), ReadBytes(executorQualifiedRole.rest, 1), executorQualifiedRole.rest) IN IF ~custOrderHandlingInst.ok THEN Fail ELSE
    Ok([ transactionTime                 |-> transactionTime.value,
         clOrdId                         |-> clOrdId.value,
         orderId                         |-> orderId.value,
         reserved1                       |-> reserved1.value,
         numberOfReturnBitfields         |-> numberOfReturnBitfields.value,
         orderModifiedV2ReturnBitfield1  |-> orderModifiedV2ReturnBitfield1.value,
         orderModifiedV2ReturnBitfield2  |-> orderModifiedV2ReturnBitfield2.value,
         orderModifiedV2ReturnBitfield3  |-> orderModifiedV2ReturnBitfield3.value,
         orderModifiedV2ReturnBitfield4  |-> orderModifiedV2ReturnBitfield4.value,
         orderModifiedV2ReturnBitfield5  |-> orderModifiedV2ReturnBitfield5.value,
         orderModifiedV2ReturnBitfield6  |-> orderModifiedV2ReturnBitfield6.value,
         orderModifiedV2ReturnBitfield7  |-> orderModifiedV2ReturnBitfield7.value,
         orderModifiedV2ReturnBitfield8  |-> orderModifiedV2ReturnBitfield8.value,
         orderModifiedV2ReturnBitfield9  |-> orderModifiedV2ReturnBitfield9.value,
         orderModifiedV2ReturnBitfield10 |-> orderModifiedV2ReturnBitfield10.value,
         orderModifiedV2ReturnBitfield11 |-> orderModifiedV2ReturnBitfield11.value,
         orderModifiedV2ReturnBitfield12 |-> orderModifiedV2ReturnBitfield12.value,
         orderModifiedV2ReturnBitfield13 |-> orderModifiedV2ReturnBitfield13.value,
         orderModifiedV2ReturnBitfield14 |-> orderModifiedV2ReturnBitfield14.value,
         orderModifiedV2ReturnBitfield15 |-> orderModifiedV2ReturnBitfield15.value,
         orderModifiedV2ReturnBitfield16 |-> orderModifiedV2ReturnBitfield16.value,
         orderModifiedV2ReturnBitfield17 |-> orderModifiedV2ReturnBitfield17.value,
         orderModifiedV2ReturnBitfield18 |-> orderModifiedV2ReturnBitfield18.value,
         orderModifiedV2ReturnBitfield19 |-> orderModifiedV2ReturnBitfield19.value,
         side                            |-> side.value,
         price                           |-> price.value,
         ordType                         |-> ordType.value,
         timeInForce                     |-> timeInForce.value,
         minQty                          |-> minQty.value,
         account                         |-> account.value,
         clearingFirm                    |-> clearingFirm.value,
         clearingAccount                 |-> clearingAccount.value,
         displayIndicator                |-> displayIndicator.value,
         orderQty                        |-> orderQty.value,
         preventMatch                    |-> preventMatch.value,
         origClOrdId                     |-> origClOrdId.value,
         leavesQty                       |-> leavesQty.value,
         lastShares                      |-> lastShares.value,
         lastPx                          |-> lastPx.value,
         displayPrice                    |-> displayPrice.value,
         workingPrice                    |-> workingPrice.value,
         baseLiquidityIndicator          |-> baseLiquidityIndicator.value,
         expireTime                      |-> expireTime.value,
         secondaryOrderId                |-> secondaryOrderId.value,
         extExecInst                     |-> extExecInst.value,
         stopPx                          |-> stopPx.value,
         routingInst                     |-> routingInst.value,
         auctionId                       |-> auctionId.value,
         liquidityProvision              |-> liquidityProvision.value,
         clientQualifiedRole             |-> clientQualifiedRole.value,
         clientId                        |-> clientId.value,
         investorId                      |-> investorId.value,
         executorId                      |-> executorId.value,
         orderOrigination                |-> orderOrigination.value,
         algorithmicIndicator            |-> algorithmicIndicator.value,
         investorQualifiedRole           |-> investorQualifiedRole.value,
         executorQualifiedRole           |-> executorQualifiedRole.value,
         custOrderHandlingInst           |-> custOrderHandlingInst.value ], custOrderHandlingInst.rest)

(* Order Modified V 2 Message with each field marked present by fields before it there exactly where they say *)
SettleOrderModifiedV2Message(message) ==
    LET settled1 == [message EXCEPT !.orderModifiedV2ReturnBitfield1 = IF message.numberOfReturnBitfields >= 1 THEN (IF message.orderModifiedV2ReturnBitfield1 = << >> THEN <<0>> ELSE message.orderModifiedV2ReturnBitfield1) ELSE << >>]
        settled2 == [settled1 EXCEPT !.orderModifiedV2ReturnBitfield2 = IF settled1.numberOfReturnBitfields >= 2 THEN (IF settled1.orderModifiedV2ReturnBitfield2 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled1.orderModifiedV2ReturnBitfield2) ELSE << >>]
        settled3 == [settled2 EXCEPT !.orderModifiedV2ReturnBitfield3 = IF settled2.numberOfReturnBitfields >= 3 THEN (IF settled2.orderModifiedV2ReturnBitfield3 = << >> THEN <<0>> ELSE settled2.orderModifiedV2ReturnBitfield3) ELSE << >>]
        settled4 == [settled3 EXCEPT !.orderModifiedV2ReturnBitfield4 = IF settled3.numberOfReturnBitfields >= 4 THEN (IF settled3.orderModifiedV2ReturnBitfield4 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled3.orderModifiedV2ReturnBitfield4) ELSE << >>]
        settled5 == [settled4 EXCEPT !.orderModifiedV2ReturnBitfield5 = IF settled4.numberOfReturnBitfields >= 5 THEN (IF settled4.orderModifiedV2ReturnBitfield5 = << >> THEN <<0>> ELSE settled4.orderModifiedV2ReturnBitfield5) ELSE << >>]
        settled6 == [settled5 EXCEPT !.orderModifiedV2ReturnBitfield6 = IF settled5.numberOfReturnBitfields >= 6 THEN (IF settled5.orderModifiedV2ReturnBitfield6 = << >> THEN <<0>> ELSE settled5.orderModifiedV2ReturnBitfield6) ELSE << >>]
        settled7 == [settled6 EXCEPT !.orderModifiedV2ReturnBitfield7 = IF settled6.numberOfReturnBitfields >= 7 THEN (IF settled6.orderModifiedV2ReturnBitfield7 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled6.orderModifiedV2ReturnBitfield7) ELSE << >>]
        settled8 == [settled7 EXCEPT !.orderModifiedV2ReturnBitfield8 = IF settled7.numberOfReturnBitfields >= 8 THEN (IF settled7.orderModifiedV2ReturnBitfield8 = << >> THEN <<0>> ELSE settled7.orderModifiedV2ReturnBitfield8) ELSE << >>]
        settled9 == [settled8 EXCEPT !.orderModifiedV2ReturnBitfield9 = IF settled8.numberOfReturnBitfields >= 9 THEN (IF settled8.orderModifiedV2ReturnBitfield9 = << >> THEN <<0>> ELSE settled8.orderModifiedV2ReturnBitfield9) ELSE << >>]
        settled10 == [settled9 EXCEPT !.orderModifiedV2ReturnBitfield10 = IF settled9.numberOfReturnBitfields >= 10 THEN (IF settled9.orderModifiedV2ReturnBitfield10 = << >> THEN <<0>> ELSE settled9.orderModifiedV2ReturnBitfield10) ELSE << >>]
        settled11 == [settled10 EXCEPT !.orderModifiedV2ReturnBitfield11 = IF settled10.numberOfReturnBitfields >= 11 THEN (IF settled10.orderModifiedV2ReturnBitfield11 = << >> THEN <<0>> ELSE settled10.orderModifiedV2ReturnBitfield11) ELSE << >>]
        settled12 == [settled11 EXCEPT !.orderModifiedV2ReturnBitfield12 = IF settled11.numberOfReturnBitfields >= 12 THEN (IF settled11.orderModifiedV2ReturnBitfield12 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled11.orderModifiedV2ReturnBitfield12) ELSE << >>]
        settled13 == [settled12 EXCEPT !.orderModifiedV2ReturnBitfield13 = IF settled12.numberOfReturnBitfields >= 13 THEN (IF settled12.orderModifiedV2ReturnBitfield13 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled12.orderModifiedV2ReturnBitfield13) ELSE << >>]
        settled14 == [settled13 EXCEPT !.orderModifiedV2ReturnBitfield14 = IF settled13.numberOfReturnBitfields >= 14 THEN (IF settled13.orderModifiedV2ReturnBitfield14 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled13.orderModifiedV2ReturnBitfield14) ELSE << >>]
        settled15 == [settled14 EXCEPT !.orderModifiedV2ReturnBitfield15 = IF settled14.numberOfReturnBitfields >= 15 THEN (IF settled14.orderModifiedV2ReturnBitfield15 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled14.orderModifiedV2ReturnBitfield15) ELSE << >>]
        settled16 == [settled15 EXCEPT !.orderModifiedV2ReturnBitfield16 = IF settled15.numberOfReturnBitfields >= 16 THEN (IF settled15.orderModifiedV2ReturnBitfield16 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled15.orderModifiedV2ReturnBitfield16) ELSE << >>]
        settled17 == [settled16 EXCEPT !.orderModifiedV2ReturnBitfield17 = IF settled16.numberOfReturnBitfields >= 17 THEN (IF settled16.orderModifiedV2ReturnBitfield17 = << >> THEN <<0>> ELSE settled16.orderModifiedV2ReturnBitfield17) ELSE << >>]
        settled18 == [settled17 EXCEPT !.orderModifiedV2ReturnBitfield18 = IF settled17.numberOfReturnBitfields >= 18 THEN (IF settled17.orderModifiedV2ReturnBitfield18 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled17.orderModifiedV2ReturnBitfield18) ELSE << >>]
        settled19 == [settled18 EXCEPT !.orderModifiedV2ReturnBitfield19 = IF settled18.numberOfReturnBitfields >= 19 THEN (IF settled18.orderModifiedV2ReturnBitfield19 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled18.orderModifiedV2ReturnBitfield19) ELSE << >>]
        settled20 == [settled19 EXCEPT !.side = IF settled19.numberOfReturnBitfields >= 1 /\ (settled19.orderModifiedV2ReturnBitfield1 # << >> /\ settled19.orderModifiedV2ReturnBitfield1[1] % 2 > 0) THEN (IF settled19.side = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled19.side) ELSE << >>]
        settled21 == [settled20 EXCEPT !.price = IF settled20.numberOfReturnBitfields >= 1 /\ (settled20.orderModifiedV2ReturnBitfield1 # << >> /\ (settled20.orderModifiedV2ReturnBitfield1[1] \div 4) % 2 > 0) THEN (IF settled20.price = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled20.price) ELSE << >>]
        settled22 == [settled21 EXCEPT !.ordType = IF settled21.numberOfReturnBitfields >= 1 /\ (settled21.orderModifiedV2ReturnBitfield1 # << >> /\ (settled21.orderModifiedV2ReturnBitfield1[1] \div 16) % 2 > 0) THEN (IF settled21.ordType = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled21.ordType) ELSE << >>]
        settled23 == [settled22 EXCEPT !.timeInForce = IF settled22.numberOfReturnBitfields >= 1 /\ (settled22.orderModifiedV2ReturnBitfield1 # << >> /\ (settled22.orderModifiedV2ReturnBitfield1[1] \div 32) % 2 > 0) THEN (IF settled22.timeInForce = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled22.timeInForce) ELSE << >>]
        settled24 == [settled23 EXCEPT !.minQty = IF settled23.numberOfReturnBitfields >= 1 /\ (settled23.orderModifiedV2ReturnBitfield1 # << >> /\ (settled23.orderModifiedV2ReturnBitfield1[1] \div 64) % 2 > 0) THEN (IF settled23.minQty = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled23.minQty) ELSE << >>]
        settled25 == [settled24 EXCEPT !.account = IF settled24.numberOfReturnBitfields >= 3 /\ (settled24.orderModifiedV2ReturnBitfield3 # << >> /\ settled24.orderModifiedV2ReturnBitfield3[1] % 2 > 0) THEN (IF settled24.account = << >> THEN <<[i \in 1 .. 16 |-> 0]>> ELSE settled24.account) ELSE << >>]
        settled26 == [settled25 EXCEPT !.clearingFirm = IF settled25.numberOfReturnBitfields >= 3 /\ (settled25.orderModifiedV2ReturnBitfield3 # << >> /\ (settled25.orderModifiedV2ReturnBitfield3[1] \div 2) % 2 > 0) THEN (IF settled25.clearingFirm = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled25.clearingFirm) ELSE << >>]
        settled27 == [settled26 EXCEPT !.clearingAccount = IF settled26.numberOfReturnBitfields >= 3 /\ (settled26.orderModifiedV2ReturnBitfield3 # << >> /\ (settled26.orderModifiedV2ReturnBitfield3[1] \div 4) % 2 > 0) THEN (IF settled26.clearingAccount = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled26.clearingAccount) ELSE << >>]
        settled28 == [settled27 EXCEPT !.displayIndicator = IF settled27.numberOfReturnBitfields >= 3 /\ (settled27.orderModifiedV2ReturnBitfield3 # << >> /\ (settled27.orderModifiedV2ReturnBitfield3[1] \div 8) % 2 > 0) THEN (IF settled27.displayIndicator = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled27.displayIndicator) ELSE << >>]
        settled29 == [settled28 EXCEPT !.orderQty = IF settled28.numberOfReturnBitfields >= 3 /\ (settled28.orderModifiedV2ReturnBitfield3 # << >> /\ (settled28.orderModifiedV2ReturnBitfield3[1] \div 64) % 2 > 0) THEN (IF settled28.orderQty = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled28.orderQty) ELSE << >>]
        settled30 == [settled29 EXCEPT !.preventMatch = IF settled29.numberOfReturnBitfields >= 3 /\ (settled29.orderModifiedV2ReturnBitfield3 # << >> /\ (settled29.orderModifiedV2ReturnBitfield3[1] \div 128) % 2 > 0) THEN (IF settled29.preventMatch = << >> THEN <<[i \in 1 .. 3 |-> 0]>> ELSE settled29.preventMatch) ELSE << >>]
        settled31 == [settled30 EXCEPT !.origClOrdId = IF settled30.numberOfReturnBitfields >= 5 /\ (settled30.orderModifiedV2ReturnBitfield5 # << >> /\ settled30.orderModifiedV2ReturnBitfield5[1] % 2 > 0) THEN (IF settled30.origClOrdId = << >> THEN <<[i \in 1 .. 20 |-> 0]>> ELSE settled30.origClOrdId) ELSE << >>]
        settled32 == [settled31 EXCEPT !.leavesQty = IF settled31.numberOfReturnBitfields >= 5 /\ (settled31.orderModifiedV2ReturnBitfield5 # << >> /\ (settled31.orderModifiedV2ReturnBitfield5[1] \div 2) % 2 > 0) THEN (IF settled31.leavesQty = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled31.leavesQty) ELSE << >>]
        settled33 == [settled32 EXCEPT !.lastShares = IF settled32.numberOfReturnBitfields >= 5 /\ (settled32.orderModifiedV2ReturnBitfield5 # << >> /\ (settled32.orderModifiedV2ReturnBitfield5[1] \div 4) % 2 > 0) THEN (IF settled32.lastShares = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled32.lastShares) ELSE << >>]
        settled34 == [settled33 EXCEPT !.lastPx = IF settled33.numberOfReturnBitfields >= 5 /\ (settled33.orderModifiedV2ReturnBitfield5 # << >> /\ (settled33.orderModifiedV2ReturnBitfield5[1] \div 8) % 2 > 0) THEN (IF settled33.lastPx = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled33.lastPx) ELSE << >>]
        settled35 == [settled34 EXCEPT !.displayPrice = IF settled34.numberOfReturnBitfields >= 5 /\ (settled34.orderModifiedV2ReturnBitfield5 # << >> /\ (settled34.orderModifiedV2ReturnBitfield5[1] \div 16) % 2 > 0) THEN (IF settled34.displayPrice = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled34.displayPrice) ELSE << >>]
        settled36 == [settled35 EXCEPT !.workingPrice = IF settled35.numberOfReturnBitfields >= 5 /\ (settled35.orderModifiedV2ReturnBitfield5 # << >> /\ (settled35.orderModifiedV2ReturnBitfield5[1] \div 32) % 2 > 0) THEN (IF settled35.workingPrice = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled35.workingPrice) ELSE << >>]
        settled37 == [settled36 EXCEPT !.baseLiquidityIndicator = IF settled36.numberOfReturnBitfields >= 5 /\ (settled36.orderModifiedV2ReturnBitfield5 # << >> /\ (settled36.orderModifiedV2ReturnBitfield5[1] \div 64) % 2 > 0) THEN (IF settled36.baseLiquidityIndicator = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled36.baseLiquidityIndicator) ELSE << >>]
        settled38 == [settled37 EXCEPT !.expireTime = IF settled37.numberOfReturnBitfields >= 5 /\ (settled37.orderModifiedV2ReturnBitfield5 # << >> /\ (settled37.orderModifiedV2ReturnBitfield5[1] \div 128) % 2 > 0) THEN (IF settled37.expireTime = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled37.expireTime) ELSE << >>]
        settled39 == [settled38 EXCEPT !.secondaryOrderId = IF settled38.numberOfReturnBitfields >= 6 /\ (settled38.orderModifiedV2ReturnBitfield6 # << >> /\ settled38.orderModifiedV2ReturnBitfield6[1] % 2 > 0) THEN (IF settled38.secondaryOrderId = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled38.secondaryOrderId) ELSE << >>]
        settled40 == [settled39 EXCEPT !.extExecInst = IF settled39.numberOfReturnBitfields >= 6 /\ (settled39.orderModifiedV2ReturnBitfield6 # << >> /\ (settled39.orderModifiedV2ReturnBitfield6[1] \div 16) % 2 > 0) THEN (IF settled39.extExecInst = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled39.extExecInst) ELSE << >>]
        settled41 == [settled40 EXCEPT !.stopPx = IF settled40.numberOfReturnBitfields >= 8 /\ (settled40.orderModifiedV2ReturnBitfield8 # << >> /\ (settled40.orderModifiedV2ReturnBitfield8[1] \div 4) % 2 > 0) THEN (IF settled40.stopPx = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled40.stopPx) ELSE << >>]
        settled42 == [settled41 EXCEPT !.routingInst = IF settled41.numberOfReturnBitfields >= 8 /\ (settled41.orderModifiedV2ReturnBitfield8 # << >> /\ (settled41.orderModifiedV2ReturnBitfield8[1] \div 8) % 2 > 0) THEN (IF settled41.routingInst = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled41.routingInst) ELSE << >>]
        settled43 == [settled42 EXCEPT !.auctionId = IF settled42.numberOfReturnBitfields >= 9 /\ (settled42.orderModifiedV2ReturnBitfield9 # << >> /\ (settled42.orderModifiedV2ReturnBitfield9[1] \div 4) % 2 > 0) THEN (IF settled42.auctionId = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled42.auctionId) ELSE << >>]
        settled44 == [settled43 EXCEPT !.liquidityProvision = IF settled43.numberOfReturnBitfields >= 9 /\ (settled43.orderModifiedV2ReturnBitfield9 # << >> /\ (settled43.orderModifiedV2ReturnBitfield9[1] \div 16) % 2 > 0) THEN (IF settled43.liquidityProvision = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled43.liquidityProvision) ELSE << >>]
        settled45 == [settled44 EXCEPT !.clientQualifiedRole = IF settled44.numberOfReturnBitfields >= 10 /\ (settled44.orderModifiedV2ReturnBitfield10 # << >> /\ (settled44.orderModifiedV2ReturnBitfield10[1] \div 128) % 2 > 0) THEN (IF settled44.clientQualifiedRole = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled44.clientQualifiedRole) ELSE << >>]
        settled46 == [settled45 EXCEPT !.clientId = IF settled45.numberOfReturnBitfields >= 11 /\ (settled45.orderModifiedV2ReturnBitfield11 # << >> /\ settled45.orderModifiedV2ReturnBitfield11[1] % 2 > 0) THEN (IF settled45.clientId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled45.clientId) ELSE << >>]
        settled47 == [settled46 EXCEPT !.investorId = IF settled46.numberOfReturnBitfields >= 11 /\ (settled46.orderModifiedV2ReturnBitfield11 # << >> /\ (settled46.orderModifiedV2ReturnBitfield11[1] \div 2) % 2 > 0) THEN (IF settled46.investorId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled46.investorId) ELSE << >>]
        settled48 == [settled47 EXCEPT !.executorId = IF settled47.numberOfReturnBitfields >= 11 /\ (settled47.orderModifiedV2ReturnBitfield11 # << >> /\ (settled47.orderModifiedV2ReturnBitfield11[1] \div 4) % 2 > 0) THEN (IF settled47.executorId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled47.executorId) ELSE << >>]
        settled49 == [settled48 EXCEPT !.orderOrigination = IF settled48.numberOfReturnBitfields >= 11 /\ (settled48.orderModifiedV2ReturnBitfield11 # << >> /\ (settled48.orderModifiedV2ReturnBitfield11[1] \div 8) % 2 > 0) THEN (IF settled48.orderOrigination = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled48.orderOrigination) ELSE << >>]
        settled50 == [settled49 EXCEPT !.algorithmicIndicator = IF settled49.numberOfReturnBitfields >= 11 /\ (settled49.orderModifiedV2ReturnBitfield11 # << >> /\ (settled49.orderModifiedV2ReturnBitfield11[1] \div 16) % 2 > 0) THEN (IF settled49.algorithmicIndicator = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled49.algorithmicIndicator) ELSE << >>]
        settled51 == [settled50 EXCEPT !.investorQualifiedRole = IF settled50.numberOfReturnBitfields >= 11 /\ (settled50.orderModifiedV2ReturnBitfield11 # << >> /\ (settled50.orderModifiedV2ReturnBitfield11[1] \div 64) % 2 > 0) THEN (IF settled50.investorQualifiedRole = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled50.investorQualifiedRole) ELSE << >>]
        settled52 == [settled51 EXCEPT !.executorQualifiedRole = IF settled51.numberOfReturnBitfields >= 11 /\ (settled51.orderModifiedV2ReturnBitfield11 # << >> /\ (settled51.orderModifiedV2ReturnBitfield11[1] \div 128) % 2 > 0) THEN (IF settled51.executorQualifiedRole = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled51.executorQualifiedRole) ELSE << >>]
        settled53 == [settled52 EXCEPT !.custOrderHandlingInst = IF settled52.numberOfReturnBitfields >= 17 /\ (settled52.orderModifiedV2ReturnBitfield17 # << >> /\ (settled52.orderModifiedV2ReturnBitfield17[1] \div 128) % 2 > 0) THEN (IF settled52.custOrderHandlingInst = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled52.custOrderHandlingInst) ELSE << >>]
    IN  settled53

ZeroOrderModifiedV2Message ==
    SettleOrderModifiedV2Message([ transactionTime                 |-> [i \in 1 .. 8 |-> 0],
                                   clOrdId                         |-> [i \in 1 .. 20 |-> 0],
                                   orderId                         |-> [i \in 1 .. 8 |-> 0],
                                   reserved1                       |-> [i \in 1 .. 1 |-> 0],
                                   numberOfReturnBitfields         |-> 0,
                                   orderModifiedV2ReturnBitfield1  |-> << >>,
                                   orderModifiedV2ReturnBitfield2  |-> << >>,
                                   orderModifiedV2ReturnBitfield3  |-> << >>,
                                   orderModifiedV2ReturnBitfield4  |-> << >>,
                                   orderModifiedV2ReturnBitfield5  |-> << >>,
                                   orderModifiedV2ReturnBitfield6  |-> << >>,
                                   orderModifiedV2ReturnBitfield7  |-> << >>,
                                   orderModifiedV2ReturnBitfield8  |-> << >>,
                                   orderModifiedV2ReturnBitfield9  |-> << >>,
                                   orderModifiedV2ReturnBitfield10 |-> << >>,
                                   orderModifiedV2ReturnBitfield11 |-> << >>,
                                   orderModifiedV2ReturnBitfield12 |-> << >>,
                                   orderModifiedV2ReturnBitfield13 |-> << >>,
                                   orderModifiedV2ReturnBitfield14 |-> << >>,
                                   orderModifiedV2ReturnBitfield15 |-> << >>,
                                   orderModifiedV2ReturnBitfield16 |-> << >>,
                                   orderModifiedV2ReturnBitfield17 |-> << >>,
                                   orderModifiedV2ReturnBitfield18 |-> << >>,
                                   orderModifiedV2ReturnBitfield19 |-> << >>,
                                   side                            |-> << >>,
                                   price                           |-> << >>,
                                   ordType                         |-> << >>,
                                   timeInForce                     |-> << >>,
                                   minQty                          |-> << >>,
                                   account                         |-> << >>,
                                   clearingFirm                    |-> << >>,
                                   clearingAccount                 |-> << >>,
                                   displayIndicator                |-> << >>,
                                   orderQty                        |-> << >>,
                                   preventMatch                    |-> << >>,
                                   origClOrdId                     |-> << >>,
                                   leavesQty                       |-> << >>,
                                   lastShares                      |-> << >>,
                                   lastPx                          |-> << >>,
                                   displayPrice                    |-> << >>,
                                   workingPrice                    |-> << >>,
                                   baseLiquidityIndicator          |-> << >>,
                                   expireTime                      |-> << >>,
                                   secondaryOrderId                |-> << >>,
                                   extExecInst                     |-> << >>,
                                   stopPx                          |-> << >>,
                                   routingInst                     |-> << >>,
                                   auctionId                       |-> << >>,
                                   liquidityProvision              |-> << >>,
                                   clientQualifiedRole             |-> << >>,
                                   clientId                        |-> << >>,
                                   investorId                      |-> << >>,
                                   executorId                      |-> << >>,
                                   orderOrigination                |-> << >>,
                                   algorithmicIndicator            |-> << >>,
                                   investorQualifiedRole           |-> << >>,
                                   executorQualifiedRole           |-> << >>,
                                   custOrderHandlingInst           |-> << >> ])

(* Order Modified V 2 Message at zero, then each field in turn at the values it is checked at *)
CheckedOrderModifiedV2Message ==
    { ZeroOrderModifiedV2Message }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.transactionTime = one]) : one \in Sample(8) }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.clOrdId = one]) : one \in Sample(20) }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.orderId = one]) : one \in Sample(8) }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.reserved1 = one]) : one \in Sample(1) }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = one]) : one \in {0, 1, 255} }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 1, !.orderModifiedV2ReturnBitfield1 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 2, !.orderModifiedV2ReturnBitfield2 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 3, !.orderModifiedV2ReturnBitfield3 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 4, !.orderModifiedV2ReturnBitfield4 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 5, !.orderModifiedV2ReturnBitfield5 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 6, !.orderModifiedV2ReturnBitfield6 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 7, !.orderModifiedV2ReturnBitfield7 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 8, !.orderModifiedV2ReturnBitfield8 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 9, !.orderModifiedV2ReturnBitfield9 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 10, !.orderModifiedV2ReturnBitfield10 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 11, !.orderModifiedV2ReturnBitfield11 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 12, !.orderModifiedV2ReturnBitfield12 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 13, !.orderModifiedV2ReturnBitfield13 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 14, !.orderModifiedV2ReturnBitfield14 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 15, !.orderModifiedV2ReturnBitfield15 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 16, !.orderModifiedV2ReturnBitfield16 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 17, !.orderModifiedV2ReturnBitfield17 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 18, !.orderModifiedV2ReturnBitfield18 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 19, !.orderModifiedV2ReturnBitfield19 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 1, !.orderModifiedV2ReturnBitfield1 = <<1>>, !.side = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 1, !.orderModifiedV2ReturnBitfield1 = <<4>>, !.price = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 1, !.orderModifiedV2ReturnBitfield1 = <<16>>, !.ordType = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 1, !.orderModifiedV2ReturnBitfield1 = <<32>>, !.timeInForce = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 1, !.orderModifiedV2ReturnBitfield1 = <<64>>, !.minQty = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 3, !.orderModifiedV2ReturnBitfield3 = <<1>>, !.account = one]) : one \in { <<held>> : held \in Sample(16) } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 3, !.orderModifiedV2ReturnBitfield3 = <<2>>, !.clearingFirm = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 3, !.orderModifiedV2ReturnBitfield3 = <<4>>, !.clearingAccount = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 3, !.orderModifiedV2ReturnBitfield3 = <<8>>, !.displayIndicator = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 3, !.orderModifiedV2ReturnBitfield3 = <<64>>, !.orderQty = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 3, !.orderModifiedV2ReturnBitfield3 = <<128>>, !.preventMatch = one]) : one \in { <<held>> : held \in Sample(3) } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 5, !.orderModifiedV2ReturnBitfield5 = <<1>>, !.origClOrdId = one]) : one \in { <<held>> : held \in Sample(20) } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 5, !.orderModifiedV2ReturnBitfield5 = <<2>>, !.leavesQty = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 5, !.orderModifiedV2ReturnBitfield5 = <<4>>, !.lastShares = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 5, !.orderModifiedV2ReturnBitfield5 = <<8>>, !.lastPx = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 5, !.orderModifiedV2ReturnBitfield5 = <<16>>, !.displayPrice = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 5, !.orderModifiedV2ReturnBitfield5 = <<32>>, !.workingPrice = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 5, !.orderModifiedV2ReturnBitfield5 = <<64>>, !.baseLiquidityIndicator = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 5, !.orderModifiedV2ReturnBitfield5 = <<128>>, !.expireTime = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 6, !.orderModifiedV2ReturnBitfield6 = <<1>>, !.secondaryOrderId = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 6, !.orderModifiedV2ReturnBitfield6 = <<16>>, !.extExecInst = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 8, !.orderModifiedV2ReturnBitfield8 = <<4>>, !.stopPx = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 8, !.orderModifiedV2ReturnBitfield8 = <<8>>, !.routingInst = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 9, !.orderModifiedV2ReturnBitfield9 = <<4>>, !.auctionId = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 9, !.orderModifiedV2ReturnBitfield9 = <<16>>, !.liquidityProvision = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 10, !.orderModifiedV2ReturnBitfield10 = <<128>>, !.clientQualifiedRole = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 11, !.orderModifiedV2ReturnBitfield11 = <<1>>, !.clientId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 11, !.orderModifiedV2ReturnBitfield11 = <<2>>, !.investorId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 11, !.orderModifiedV2ReturnBitfield11 = <<4>>, !.executorId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 11, !.orderModifiedV2ReturnBitfield11 = <<8>>, !.orderOrigination = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 11, !.orderModifiedV2ReturnBitfield11 = <<16>>, !.algorithmicIndicator = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 11, !.orderModifiedV2ReturnBitfield11 = <<64>>, !.investorQualifiedRole = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 11, !.orderModifiedV2ReturnBitfield11 = <<128>>, !.executorQualifiedRole = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderModifiedV2Message([ZeroOrderModifiedV2Message EXCEPT !.numberOfReturnBitfields = 17, !.orderModifiedV2ReturnBitfield17 = <<128>>, !.custOrderHandlingInst = one]) : one \in { <<held>> : held \in Sample(1) } }

(***************************************************************************)
(* Order Restated Message                                                  *)
(***************************************************************************)

OrderRestatedMessage ==
    [ transactionTime                 : Sample(8),
      clOrdId                         : Sample(20),
      orderId                         : Sample(8),
      restatementReason               : Sample(1),
      reserved1                       : Sample(1),
      numberOfReturnBitfields         : 0 .. 255,
      orderRestatedV2ReturnBitfield1  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderRestatedV2ReturnBitfield2  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderRestatedV2ReturnBitfield3  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderRestatedV2ReturnBitfield4  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderRestatedV2ReturnBitfield5  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderRestatedV2ReturnBitfield6  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderRestatedV2ReturnBitfield7  : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderRestatedV2ReturnBitfield8  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderRestatedV2ReturnBitfield9  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderRestatedV2ReturnBitfield10 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderRestatedV2ReturnBitfield11 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderRestatedV2ReturnBitfield12 : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderRestatedV2ReturnBitfield13 : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderRestatedV2ReturnBitfield14 : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderRestatedV2ReturnBitfield15 : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderRestatedV2ReturnBitfield16 : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderRestatedV2ReturnBitfield17 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderRestatedV2ReturnBitfield18 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderRestatedV2ReturnBitfield19 : { << >> } \cup { <<held>> : held \in Sample(1) },
      side                            : { << >> } \cup { <<held>> : held \in Sample(1) },
      price                           : { << >> } \cup { <<held>> : held \in Sample(8) },
      ordType                         : { << >> } \cup { <<held>> : held \in Sample(1) },
      timeInForce                     : { << >> } \cup { <<held>> : held \in Sample(1) },
      minQty                          : { << >> } \cup { <<held>> : held \in Sample(4) },
      symbolLong                      : { << >> } \cup { <<held>> : held \in Sample(8) },
      idSource                        : { << >> } \cup { <<held>> : held \in Sample(1) },
      securityId                      : { << >> } \cup { <<held>> : held \in Sample(16) },
      capacity                        : { << >> } \cup { <<held>> : held \in Sample(1) },
      account                         : { << >> } \cup { <<held>> : held \in Sample(16) },
      clearingFirm                    : { << >> } \cup { <<held>> : held \in Sample(4) },
      clearingAccount                 : { << >> } \cup { <<held>> : held \in Sample(4) },
      displayIndicator                : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderQty                        : { << >> } \cup { <<held>> : held \in Sample(4) },
      preventMatch                    : { << >> } \cup { <<held>> : held \in Sample(3) },
      openClose                       : { << >> } \cup { <<held>> : held \in Sample(1) },
      origClOrdId                     : { << >> } \cup { <<held>> : held \in Sample(20) },
      leavesQty                       : { << >> } \cup { <<held>> : held \in Sample(4) },
      lastShares                      : { << >> } \cup { <<held>> : held \in Sample(4) },
      lastPx                          : { << >> } \cup { <<held>> : held \in Sample(8) },
      displayPrice                    : { << >> } \cup { <<held>> : held \in Sample(8) },
      workingPrice                    : { << >> } \cup { <<held>> : held \in Sample(8) },
      baseLiquidityIndicator          : { << >> } \cup { <<held>> : held \in Sample(1) },
      expireTime                      : { << >> } \cup { <<held>> : held \in Sample(8) },
      secondaryOrderId                : { << >> } \cup { <<held>> : held \in Sample(8) },
      extExecInst                     : { << >> } \cup { <<held>> : held \in Sample(1) },
      stopPx                          : { << >> } \cup { <<held>> : held \in Sample(8) },
      routingInst                     : { << >> } \cup { <<held>> : held \in Sample(4) },
      liquidityProvision              : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossId                         : { << >> } \cup { <<held>> : held \in Sample(20) },
      clientQualifiedRole             : { << >> } \cup { <<held>> : held \in Sample(1) },
      clientId                        : { << >> } \cup { <<held>> : held \in Sample(4) },
      investorId                      : { << >> } \cup { <<held>> : held \in Sample(4) },
      executorId                      : { << >> } \cup { <<held>> : held \in Sample(4) },
      orderOrigination                : { << >> } \cup { <<held>> : held \in Sample(1) },
      algorithmicIndicator            : { << >> } \cup { <<held>> : held \in Sample(1) },
      investorQualifiedRole           : { << >> } \cup { <<held>> : held \in Sample(1) },
      executorQualifiedRole           : { << >> } \cup { <<held>> : held \in Sample(1) },
      custOrderHandlingInst           : { << >> } \cup { <<held>> : held \in Sample(1) },
      accountType                     : { << >> } \cup { <<held>> : held \in Sample(1) } ]

EncodeOrderRestatedMessage(message) ==
    message.transactionTime
        \o message.clOrdId
        \o message.orderId
        \o message.restatementReason
        \o message.reserved1
        \o EncodeUIntBE(message.numberOfReturnBitfields, 1)
        \o (IF message.orderRestatedV2ReturnBitfield1 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRestatedV2ReturnBitfield1[1], 1))
        \o (IF message.orderRestatedV2ReturnBitfield2 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRestatedV2ReturnBitfield2[1], 1))
        \o (IF message.orderRestatedV2ReturnBitfield3 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRestatedV2ReturnBitfield3[1], 1))
        \o (IF message.orderRestatedV2ReturnBitfield4 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRestatedV2ReturnBitfield4[1], 1))
        \o (IF message.orderRestatedV2ReturnBitfield5 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRestatedV2ReturnBitfield5[1], 1))
        \o (IF message.orderRestatedV2ReturnBitfield6 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRestatedV2ReturnBitfield6[1], 1))
        \o (IF message.orderRestatedV2ReturnBitfield7 = << >> THEN << >> ELSE message.orderRestatedV2ReturnBitfield7[1])
        \o (IF message.orderRestatedV2ReturnBitfield8 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRestatedV2ReturnBitfield8[1], 1))
        \o (IF message.orderRestatedV2ReturnBitfield9 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRestatedV2ReturnBitfield9[1], 1))
        \o (IF message.orderRestatedV2ReturnBitfield10 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRestatedV2ReturnBitfield10[1], 1))
        \o (IF message.orderRestatedV2ReturnBitfield11 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRestatedV2ReturnBitfield11[1], 1))
        \o (IF message.orderRestatedV2ReturnBitfield12 = << >> THEN << >> ELSE message.orderRestatedV2ReturnBitfield12[1])
        \o (IF message.orderRestatedV2ReturnBitfield13 = << >> THEN << >> ELSE message.orderRestatedV2ReturnBitfield13[1])
        \o (IF message.orderRestatedV2ReturnBitfield14 = << >> THEN << >> ELSE message.orderRestatedV2ReturnBitfield14[1])
        \o (IF message.orderRestatedV2ReturnBitfield15 = << >> THEN << >> ELSE message.orderRestatedV2ReturnBitfield15[1])
        \o (IF message.orderRestatedV2ReturnBitfield16 = << >> THEN << >> ELSE message.orderRestatedV2ReturnBitfield16[1])
        \o (IF message.orderRestatedV2ReturnBitfield17 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRestatedV2ReturnBitfield17[1], 1))
        \o (IF message.orderRestatedV2ReturnBitfield18 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRestatedV2ReturnBitfield18[1], 1))
        \o (IF message.orderRestatedV2ReturnBitfield19 = << >> THEN << >> ELSE message.orderRestatedV2ReturnBitfield19[1])
        \o (IF message.side = << >> THEN << >> ELSE message.side[1])
        \o (IF message.price = << >> THEN << >> ELSE message.price[1])
        \o (IF message.ordType = << >> THEN << >> ELSE message.ordType[1])
        \o (IF message.timeInForce = << >> THEN << >> ELSE message.timeInForce[1])
        \o (IF message.minQty = << >> THEN << >> ELSE message.minQty[1])
        \o (IF message.symbolLong = << >> THEN << >> ELSE message.symbolLong[1])
        \o (IF message.idSource = << >> THEN << >> ELSE message.idSource[1])
        \o (IF message.securityId = << >> THEN << >> ELSE message.securityId[1])
        \o (IF message.capacity = << >> THEN << >> ELSE message.capacity[1])
        \o (IF message.account = << >> THEN << >> ELSE message.account[1])
        \o (IF message.clearingFirm = << >> THEN << >> ELSE message.clearingFirm[1])
        \o (IF message.clearingAccount = << >> THEN << >> ELSE message.clearingAccount[1])
        \o (IF message.displayIndicator = << >> THEN << >> ELSE message.displayIndicator[1])
        \o (IF message.orderQty = << >> THEN << >> ELSE message.orderQty[1])
        \o (IF message.preventMatch = << >> THEN << >> ELSE message.preventMatch[1])
        \o (IF message.openClose = << >> THEN << >> ELSE message.openClose[1])
        \o (IF message.origClOrdId = << >> THEN << >> ELSE message.origClOrdId[1])
        \o (IF message.leavesQty = << >> THEN << >> ELSE message.leavesQty[1])
        \o (IF message.lastShares = << >> THEN << >> ELSE message.lastShares[1])
        \o (IF message.lastPx = << >> THEN << >> ELSE message.lastPx[1])
        \o (IF message.displayPrice = << >> THEN << >> ELSE message.displayPrice[1])
        \o (IF message.workingPrice = << >> THEN << >> ELSE message.workingPrice[1])
        \o (IF message.baseLiquidityIndicator = << >> THEN << >> ELSE message.baseLiquidityIndicator[1])
        \o (IF message.expireTime = << >> THEN << >> ELSE message.expireTime[1])
        \o (IF message.secondaryOrderId = << >> THEN << >> ELSE message.secondaryOrderId[1])
        \o (IF message.extExecInst = << >> THEN << >> ELSE message.extExecInst[1])
        \o (IF message.stopPx = << >> THEN << >> ELSE message.stopPx[1])
        \o (IF message.routingInst = << >> THEN << >> ELSE message.routingInst[1])
        \o (IF message.liquidityProvision = << >> THEN << >> ELSE message.liquidityProvision[1])
        \o (IF message.crossId = << >> THEN << >> ELSE message.crossId[1])
        \o (IF message.clientQualifiedRole = << >> THEN << >> ELSE message.clientQualifiedRole[1])
        \o (IF message.clientId = << >> THEN << >> ELSE message.clientId[1])
        \o (IF message.investorId = << >> THEN << >> ELSE message.investorId[1])
        \o (IF message.executorId = << >> THEN << >> ELSE message.executorId[1])
        \o (IF message.orderOrigination = << >> THEN << >> ELSE message.orderOrigination[1])
        \o (IF message.algorithmicIndicator = << >> THEN << >> ELSE message.algorithmicIndicator[1])
        \o (IF message.investorQualifiedRole = << >> THEN << >> ELSE message.investorQualifiedRole[1])
        \o (IF message.executorQualifiedRole = << >> THEN << >> ELSE message.executorQualifiedRole[1])
        \o (IF message.custOrderHandlingInst = << >> THEN << >> ELSE message.custOrderHandlingInst[1])
        \o (IF message.accountType = << >> THEN << >> ELSE message.accountType[1])

DecodeOrderRestatedMessage(bytes) ==
    LET transactionTime == ReadBytes(bytes, 8) IN IF ~transactionTime.ok THEN Fail ELSE
    LET clOrdId == ReadBytes(transactionTime.rest, 20) IN IF ~clOrdId.ok THEN Fail ELSE
    LET orderId == ReadBytes(clOrdId.rest, 8) IN IF ~orderId.ok THEN Fail ELSE
    LET restatementReason == ReadBytes(orderId.rest, 1) IN IF ~restatementReason.ok THEN Fail ELSE
    LET reserved1 == ReadBytes(restatementReason.rest, 1) IN IF ~reserved1.ok THEN Fail ELSE
    LET numberOfReturnBitfields == ReadUIntBE(reserved1.rest, 1) IN IF ~numberOfReturnBitfields.ok THEN Fail ELSE
    LET orderRestatedV2ReturnBitfield1 == ReadWhen(numberOfReturnBitfields.value >= 1, ReadUIntLE(numberOfReturnBitfields.rest, 1), numberOfReturnBitfields.rest) IN IF ~orderRestatedV2ReturnBitfield1.ok THEN Fail ELSE
    LET orderRestatedV2ReturnBitfield2 == ReadWhen(numberOfReturnBitfields.value >= 2, ReadUIntLE(orderRestatedV2ReturnBitfield1.rest, 1), orderRestatedV2ReturnBitfield1.rest) IN IF ~orderRestatedV2ReturnBitfield2.ok THEN Fail ELSE
    LET orderRestatedV2ReturnBitfield3 == ReadWhen(numberOfReturnBitfields.value >= 3, ReadUIntLE(orderRestatedV2ReturnBitfield2.rest, 1), orderRestatedV2ReturnBitfield2.rest) IN IF ~orderRestatedV2ReturnBitfield3.ok THEN Fail ELSE
    LET orderRestatedV2ReturnBitfield4 == ReadWhen(numberOfReturnBitfields.value >= 4, ReadUIntLE(orderRestatedV2ReturnBitfield3.rest, 1), orderRestatedV2ReturnBitfield3.rest) IN IF ~orderRestatedV2ReturnBitfield4.ok THEN Fail ELSE
    LET orderRestatedV2ReturnBitfield5 == ReadWhen(numberOfReturnBitfields.value >= 5, ReadUIntLE(orderRestatedV2ReturnBitfield4.rest, 1), orderRestatedV2ReturnBitfield4.rest) IN IF ~orderRestatedV2ReturnBitfield5.ok THEN Fail ELSE
    LET orderRestatedV2ReturnBitfield6 == ReadWhen(numberOfReturnBitfields.value >= 6, ReadUIntLE(orderRestatedV2ReturnBitfield5.rest, 1), orderRestatedV2ReturnBitfield5.rest) IN IF ~orderRestatedV2ReturnBitfield6.ok THEN Fail ELSE
    LET orderRestatedV2ReturnBitfield7 == ReadWhen(numberOfReturnBitfields.value >= 7, ReadBytes(orderRestatedV2ReturnBitfield6.rest, 1), orderRestatedV2ReturnBitfield6.rest) IN IF ~orderRestatedV2ReturnBitfield7.ok THEN Fail ELSE
    LET orderRestatedV2ReturnBitfield8 == ReadWhen(numberOfReturnBitfields.value >= 8, ReadUIntLE(orderRestatedV2ReturnBitfield7.rest, 1), orderRestatedV2ReturnBitfield7.rest) IN IF ~orderRestatedV2ReturnBitfield8.ok THEN Fail ELSE
    LET orderRestatedV2ReturnBitfield9 == ReadWhen(numberOfReturnBitfields.value >= 9, ReadUIntLE(orderRestatedV2ReturnBitfield8.rest, 1), orderRestatedV2ReturnBitfield8.rest) IN IF ~orderRestatedV2ReturnBitfield9.ok THEN Fail ELSE
    LET orderRestatedV2ReturnBitfield10 == ReadWhen(numberOfReturnBitfields.value >= 10, ReadUIntLE(orderRestatedV2ReturnBitfield9.rest, 1), orderRestatedV2ReturnBitfield9.rest) IN IF ~orderRestatedV2ReturnBitfield10.ok THEN Fail ELSE
    LET orderRestatedV2ReturnBitfield11 == ReadWhen(numberOfReturnBitfields.value >= 11, ReadUIntLE(orderRestatedV2ReturnBitfield10.rest, 1), orderRestatedV2ReturnBitfield10.rest) IN IF ~orderRestatedV2ReturnBitfield11.ok THEN Fail ELSE
    LET orderRestatedV2ReturnBitfield12 == ReadWhen(numberOfReturnBitfields.value >= 12, ReadBytes(orderRestatedV2ReturnBitfield11.rest, 1), orderRestatedV2ReturnBitfield11.rest) IN IF ~orderRestatedV2ReturnBitfield12.ok THEN Fail ELSE
    LET orderRestatedV2ReturnBitfield13 == ReadWhen(numberOfReturnBitfields.value >= 13, ReadBytes(orderRestatedV2ReturnBitfield12.rest, 1), orderRestatedV2ReturnBitfield12.rest) IN IF ~orderRestatedV2ReturnBitfield13.ok THEN Fail ELSE
    LET orderRestatedV2ReturnBitfield14 == ReadWhen(numberOfReturnBitfields.value >= 14, ReadBytes(orderRestatedV2ReturnBitfield13.rest, 1), orderRestatedV2ReturnBitfield13.rest) IN IF ~orderRestatedV2ReturnBitfield14.ok THEN Fail ELSE
    LET orderRestatedV2ReturnBitfield15 == ReadWhen(numberOfReturnBitfields.value >= 15, ReadBytes(orderRestatedV2ReturnBitfield14.rest, 1), orderRestatedV2ReturnBitfield14.rest) IN IF ~orderRestatedV2ReturnBitfield15.ok THEN Fail ELSE
    LET orderRestatedV2ReturnBitfield16 == ReadWhen(numberOfReturnBitfields.value >= 16, ReadBytes(orderRestatedV2ReturnBitfield15.rest, 1), orderRestatedV2ReturnBitfield15.rest) IN IF ~orderRestatedV2ReturnBitfield16.ok THEN Fail ELSE
    LET orderRestatedV2ReturnBitfield17 == ReadWhen(numberOfReturnBitfields.value >= 17, ReadUIntLE(orderRestatedV2ReturnBitfield16.rest, 1), orderRestatedV2ReturnBitfield16.rest) IN IF ~orderRestatedV2ReturnBitfield17.ok THEN Fail ELSE
    LET orderRestatedV2ReturnBitfield18 == ReadWhen(numberOfReturnBitfields.value >= 18, ReadUIntLE(orderRestatedV2ReturnBitfield17.rest, 1), orderRestatedV2ReturnBitfield17.rest) IN IF ~orderRestatedV2ReturnBitfield18.ok THEN Fail ELSE
    LET orderRestatedV2ReturnBitfield19 == ReadWhen(numberOfReturnBitfields.value >= 19, ReadBytes(orderRestatedV2ReturnBitfield18.rest, 1), orderRestatedV2ReturnBitfield18.rest) IN IF ~orderRestatedV2ReturnBitfield19.ok THEN Fail ELSE
    LET side == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderRestatedV2ReturnBitfield1.value # << >> /\ orderRestatedV2ReturnBitfield1.value[1] % 2 > 0), ReadBytes(orderRestatedV2ReturnBitfield19.rest, 1), orderRestatedV2ReturnBitfield19.rest) IN IF ~side.ok THEN Fail ELSE
    LET price == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderRestatedV2ReturnBitfield1.value # << >> /\ (orderRestatedV2ReturnBitfield1.value[1] \div 4) % 2 > 0), ReadBytes(side.rest, 8), side.rest) IN IF ~price.ok THEN Fail ELSE
    LET ordType == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderRestatedV2ReturnBitfield1.value # << >> /\ (orderRestatedV2ReturnBitfield1.value[1] \div 16) % 2 > 0), ReadBytes(price.rest, 1), price.rest) IN IF ~ordType.ok THEN Fail ELSE
    LET timeInForce == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderRestatedV2ReturnBitfield1.value # << >> /\ (orderRestatedV2ReturnBitfield1.value[1] \div 32) % 2 > 0), ReadBytes(ordType.rest, 1), ordType.rest) IN IF ~timeInForce.ok THEN Fail ELSE
    LET minQty == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderRestatedV2ReturnBitfield1.value # << >> /\ (orderRestatedV2ReturnBitfield1.value[1] \div 64) % 2 > 0), ReadBytes(timeInForce.rest, 4), timeInForce.rest) IN IF ~minQty.ok THEN Fail ELSE
    LET symbolLong == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (orderRestatedV2ReturnBitfield2.value # << >> /\ orderRestatedV2ReturnBitfield2.value[1] % 2 > 0), ReadBytes(minQty.rest, 8), minQty.rest) IN IF ~symbolLong.ok THEN Fail ELSE
    LET idSource == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (orderRestatedV2ReturnBitfield2.value # << >> /\ (orderRestatedV2ReturnBitfield2.value[1] \div 8) % 2 > 0), ReadBytes(symbolLong.rest, 1), symbolLong.rest) IN IF ~idSource.ok THEN Fail ELSE
    LET securityId == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (orderRestatedV2ReturnBitfield2.value # << >> /\ (orderRestatedV2ReturnBitfield2.value[1] \div 16) % 2 > 0), ReadBytes(idSource.rest, 16), idSource.rest) IN IF ~securityId.ok THEN Fail ELSE
    LET capacity == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (orderRestatedV2ReturnBitfield2.value # << >> /\ (orderRestatedV2ReturnBitfield2.value[1] \div 64) % 2 > 0), ReadBytes(securityId.rest, 1), securityId.rest) IN IF ~capacity.ok THEN Fail ELSE
    LET account == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderRestatedV2ReturnBitfield3.value # << >> /\ orderRestatedV2ReturnBitfield3.value[1] % 2 > 0), ReadBytes(capacity.rest, 16), capacity.rest) IN IF ~account.ok THEN Fail ELSE
    LET clearingFirm == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderRestatedV2ReturnBitfield3.value # << >> /\ (orderRestatedV2ReturnBitfield3.value[1] \div 2) % 2 > 0), ReadBytes(account.rest, 4), account.rest) IN IF ~clearingFirm.ok THEN Fail ELSE
    LET clearingAccount == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderRestatedV2ReturnBitfield3.value # << >> /\ (orderRestatedV2ReturnBitfield3.value[1] \div 4) % 2 > 0), ReadBytes(clearingFirm.rest, 4), clearingFirm.rest) IN IF ~clearingAccount.ok THEN Fail ELSE
    LET displayIndicator == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderRestatedV2ReturnBitfield3.value # << >> /\ (orderRestatedV2ReturnBitfield3.value[1] \div 8) % 2 > 0), ReadBytes(clearingAccount.rest, 1), clearingAccount.rest) IN IF ~displayIndicator.ok THEN Fail ELSE
    LET orderQty == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderRestatedV2ReturnBitfield3.value # << >> /\ (orderRestatedV2ReturnBitfield3.value[1] \div 64) % 2 > 0), ReadBytes(displayIndicator.rest, 4), displayIndicator.rest) IN IF ~orderQty.ok THEN Fail ELSE
    LET preventMatch == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderRestatedV2ReturnBitfield3.value # << >> /\ (orderRestatedV2ReturnBitfield3.value[1] \div 128) % 2 > 0), ReadBytes(orderQty.rest, 3), orderQty.rest) IN IF ~preventMatch.ok THEN Fail ELSE
    LET openClose == ReadWhen(numberOfReturnBitfields.value >= 4 /\ (orderRestatedV2ReturnBitfield4.value # << >> /\ (orderRestatedV2ReturnBitfield4.value[1] \div 8) % 2 > 0), ReadBytes(preventMatch.rest, 1), preventMatch.rest) IN IF ~openClose.ok THEN Fail ELSE
    LET origClOrdId == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderRestatedV2ReturnBitfield5.value # << >> /\ orderRestatedV2ReturnBitfield5.value[1] % 2 > 0), ReadBytes(openClose.rest, 20), openClose.rest) IN IF ~origClOrdId.ok THEN Fail ELSE
    LET leavesQty == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderRestatedV2ReturnBitfield5.value # << >> /\ (orderRestatedV2ReturnBitfield5.value[1] \div 2) % 2 > 0), ReadBytes(origClOrdId.rest, 4), origClOrdId.rest) IN IF ~leavesQty.ok THEN Fail ELSE
    LET lastShares == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderRestatedV2ReturnBitfield5.value # << >> /\ (orderRestatedV2ReturnBitfield5.value[1] \div 4) % 2 > 0), ReadBytes(leavesQty.rest, 4), leavesQty.rest) IN IF ~lastShares.ok THEN Fail ELSE
    LET lastPx == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderRestatedV2ReturnBitfield5.value # << >> /\ (orderRestatedV2ReturnBitfield5.value[1] \div 8) % 2 > 0), ReadBytes(lastShares.rest, 8), lastShares.rest) IN IF ~lastPx.ok THEN Fail ELSE
    LET displayPrice == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderRestatedV2ReturnBitfield5.value # << >> /\ (orderRestatedV2ReturnBitfield5.value[1] \div 16) % 2 > 0), ReadBytes(lastPx.rest, 8), lastPx.rest) IN IF ~displayPrice.ok THEN Fail ELSE
    LET workingPrice == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderRestatedV2ReturnBitfield5.value # << >> /\ (orderRestatedV2ReturnBitfield5.value[1] \div 32) % 2 > 0), ReadBytes(displayPrice.rest, 8), displayPrice.rest) IN IF ~workingPrice.ok THEN Fail ELSE
    LET baseLiquidityIndicator == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderRestatedV2ReturnBitfield5.value # << >> /\ (orderRestatedV2ReturnBitfield5.value[1] \div 64) % 2 > 0), ReadBytes(workingPrice.rest, 1), workingPrice.rest) IN IF ~baseLiquidityIndicator.ok THEN Fail ELSE
    LET expireTime == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderRestatedV2ReturnBitfield5.value # << >> /\ (orderRestatedV2ReturnBitfield5.value[1] \div 128) % 2 > 0), ReadBytes(baseLiquidityIndicator.rest, 8), baseLiquidityIndicator.rest) IN IF ~expireTime.ok THEN Fail ELSE
    LET secondaryOrderId == ReadWhen(numberOfReturnBitfields.value >= 6 /\ (orderRestatedV2ReturnBitfield6.value # << >> /\ orderRestatedV2ReturnBitfield6.value[1] % 2 > 0), ReadBytes(expireTime.rest, 8), expireTime.rest) IN IF ~secondaryOrderId.ok THEN Fail ELSE
    LET extExecInst == ReadWhen(numberOfReturnBitfields.value >= 6 /\ (orderRestatedV2ReturnBitfield6.value # << >> /\ (orderRestatedV2ReturnBitfield6.value[1] \div 16) % 2 > 0), ReadBytes(secondaryOrderId.rest, 1), secondaryOrderId.rest) IN IF ~extExecInst.ok THEN Fail ELSE
    LET stopPx == ReadWhen(numberOfReturnBitfields.value >= 8 /\ (orderRestatedV2ReturnBitfield8.value # << >> /\ (orderRestatedV2ReturnBitfield8.value[1] \div 4) % 2 > 0), ReadBytes(extExecInst.rest, 8), extExecInst.rest) IN IF ~stopPx.ok THEN Fail ELSE
    LET routingInst == ReadWhen(numberOfReturnBitfields.value >= 8 /\ (orderRestatedV2ReturnBitfield8.value # << >> /\ (orderRestatedV2ReturnBitfield8.value[1] \div 8) % 2 > 0), ReadBytes(stopPx.rest, 4), stopPx.rest) IN IF ~routingInst.ok THEN Fail ELSE
    LET liquidityProvision == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (orderRestatedV2ReturnBitfield9.value # << >> /\ (orderRestatedV2ReturnBitfield9.value[1] \div 16) % 2 > 0), ReadBytes(routingInst.rest, 1), routingInst.rest) IN IF ~liquidityProvision.ok THEN Fail ELSE
    LET crossId == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (orderRestatedV2ReturnBitfield10.value # << >> /\ orderRestatedV2ReturnBitfield10.value[1] % 2 > 0), ReadBytes(liquidityProvision.rest, 20), liquidityProvision.rest) IN IF ~crossId.ok THEN Fail ELSE
    LET clientQualifiedRole == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (orderRestatedV2ReturnBitfield10.value # << >> /\ (orderRestatedV2ReturnBitfield10.value[1] \div 128) % 2 > 0), ReadBytes(crossId.rest, 1), crossId.rest) IN IF ~clientQualifiedRole.ok THEN Fail ELSE
    LET clientId == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (orderRestatedV2ReturnBitfield11.value # << >> /\ orderRestatedV2ReturnBitfield11.value[1] % 2 > 0), ReadBytes(clientQualifiedRole.rest, 4), clientQualifiedRole.rest) IN IF ~clientId.ok THEN Fail ELSE
    LET investorId == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (orderRestatedV2ReturnBitfield11.value # << >> /\ (orderRestatedV2ReturnBitfield11.value[1] \div 2) % 2 > 0), ReadBytes(clientId.rest, 4), clientId.rest) IN IF ~investorId.ok THEN Fail ELSE
    LET executorId == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (orderRestatedV2ReturnBitfield11.value # << >> /\ (orderRestatedV2ReturnBitfield11.value[1] \div 4) % 2 > 0), ReadBytes(investorId.rest, 4), investorId.rest) IN IF ~executorId.ok THEN Fail ELSE
    LET orderOrigination == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (orderRestatedV2ReturnBitfield11.value # << >> /\ (orderRestatedV2ReturnBitfield11.value[1] \div 8) % 2 > 0), ReadBytes(executorId.rest, 1), executorId.rest) IN IF ~orderOrigination.ok THEN Fail ELSE
    LET algorithmicIndicator == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (orderRestatedV2ReturnBitfield11.value # << >> /\ (orderRestatedV2ReturnBitfield11.value[1] \div 16) % 2 > 0), ReadBytes(orderOrigination.rest, 1), orderOrigination.rest) IN IF ~algorithmicIndicator.ok THEN Fail ELSE
    LET investorQualifiedRole == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (orderRestatedV2ReturnBitfield11.value # << >> /\ (orderRestatedV2ReturnBitfield11.value[1] \div 64) % 2 > 0), ReadBytes(algorithmicIndicator.rest, 1), algorithmicIndicator.rest) IN IF ~investorQualifiedRole.ok THEN Fail ELSE
    LET executorQualifiedRole == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (orderRestatedV2ReturnBitfield11.value # << >> /\ (orderRestatedV2ReturnBitfield11.value[1] \div 128) % 2 > 0), ReadBytes(investorQualifiedRole.rest, 1), investorQualifiedRole.rest) IN IF ~executorQualifiedRole.ok THEN Fail ELSE
    LET custOrderHandlingInst == ReadWhen(numberOfReturnBitfields.value >= 17 /\ (orderRestatedV2ReturnBitfield17.value # << >> /\ (orderRestatedV2ReturnBitfield17.value[1] \div 128) % 2 > 0), ReadBytes(executorQualifiedRole.rest, 1), executorQualifiedRole.rest) IN IF ~custOrderHandlingInst.ok THEN Fail ELSE
    LET accountType == ReadWhen(numberOfReturnBitfields.value >= 18 /\ (orderRestatedV2ReturnBitfield18.value # << >> /\ orderRestatedV2ReturnBitfield18.value[1] % 2 > 0), ReadBytes(custOrderHandlingInst.rest, 1), custOrderHandlingInst.rest) IN IF ~accountType.ok THEN Fail ELSE
    Ok([ transactionTime                 |-> transactionTime.value,
         clOrdId                         |-> clOrdId.value,
         orderId                         |-> orderId.value,
         restatementReason               |-> restatementReason.value,
         reserved1                       |-> reserved1.value,
         numberOfReturnBitfields         |-> numberOfReturnBitfields.value,
         orderRestatedV2ReturnBitfield1  |-> orderRestatedV2ReturnBitfield1.value,
         orderRestatedV2ReturnBitfield2  |-> orderRestatedV2ReturnBitfield2.value,
         orderRestatedV2ReturnBitfield3  |-> orderRestatedV2ReturnBitfield3.value,
         orderRestatedV2ReturnBitfield4  |-> orderRestatedV2ReturnBitfield4.value,
         orderRestatedV2ReturnBitfield5  |-> orderRestatedV2ReturnBitfield5.value,
         orderRestatedV2ReturnBitfield6  |-> orderRestatedV2ReturnBitfield6.value,
         orderRestatedV2ReturnBitfield7  |-> orderRestatedV2ReturnBitfield7.value,
         orderRestatedV2ReturnBitfield8  |-> orderRestatedV2ReturnBitfield8.value,
         orderRestatedV2ReturnBitfield9  |-> orderRestatedV2ReturnBitfield9.value,
         orderRestatedV2ReturnBitfield10 |-> orderRestatedV2ReturnBitfield10.value,
         orderRestatedV2ReturnBitfield11 |-> orderRestatedV2ReturnBitfield11.value,
         orderRestatedV2ReturnBitfield12 |-> orderRestatedV2ReturnBitfield12.value,
         orderRestatedV2ReturnBitfield13 |-> orderRestatedV2ReturnBitfield13.value,
         orderRestatedV2ReturnBitfield14 |-> orderRestatedV2ReturnBitfield14.value,
         orderRestatedV2ReturnBitfield15 |-> orderRestatedV2ReturnBitfield15.value,
         orderRestatedV2ReturnBitfield16 |-> orderRestatedV2ReturnBitfield16.value,
         orderRestatedV2ReturnBitfield17 |-> orderRestatedV2ReturnBitfield17.value,
         orderRestatedV2ReturnBitfield18 |-> orderRestatedV2ReturnBitfield18.value,
         orderRestatedV2ReturnBitfield19 |-> orderRestatedV2ReturnBitfield19.value,
         side                            |-> side.value,
         price                           |-> price.value,
         ordType                         |-> ordType.value,
         timeInForce                     |-> timeInForce.value,
         minQty                          |-> minQty.value,
         symbolLong                      |-> symbolLong.value,
         idSource                        |-> idSource.value,
         securityId                      |-> securityId.value,
         capacity                        |-> capacity.value,
         account                         |-> account.value,
         clearingFirm                    |-> clearingFirm.value,
         clearingAccount                 |-> clearingAccount.value,
         displayIndicator                |-> displayIndicator.value,
         orderQty                        |-> orderQty.value,
         preventMatch                    |-> preventMatch.value,
         openClose                       |-> openClose.value,
         origClOrdId                     |-> origClOrdId.value,
         leavesQty                       |-> leavesQty.value,
         lastShares                      |-> lastShares.value,
         lastPx                          |-> lastPx.value,
         displayPrice                    |-> displayPrice.value,
         workingPrice                    |-> workingPrice.value,
         baseLiquidityIndicator          |-> baseLiquidityIndicator.value,
         expireTime                      |-> expireTime.value,
         secondaryOrderId                |-> secondaryOrderId.value,
         extExecInst                     |-> extExecInst.value,
         stopPx                          |-> stopPx.value,
         routingInst                     |-> routingInst.value,
         liquidityProvision              |-> liquidityProvision.value,
         crossId                         |-> crossId.value,
         clientQualifiedRole             |-> clientQualifiedRole.value,
         clientId                        |-> clientId.value,
         investorId                      |-> investorId.value,
         executorId                      |-> executorId.value,
         orderOrigination                |-> orderOrigination.value,
         algorithmicIndicator            |-> algorithmicIndicator.value,
         investorQualifiedRole           |-> investorQualifiedRole.value,
         executorQualifiedRole           |-> executorQualifiedRole.value,
         custOrderHandlingInst           |-> custOrderHandlingInst.value,
         accountType                     |-> accountType.value ], accountType.rest)

(* Order Restated Message with each field marked present by fields before it there exactly where they say *)
SettleOrderRestatedMessage(message) ==
    LET settled1 == [message EXCEPT !.orderRestatedV2ReturnBitfield1 = IF message.numberOfReturnBitfields >= 1 THEN (IF message.orderRestatedV2ReturnBitfield1 = << >> THEN <<0>> ELSE message.orderRestatedV2ReturnBitfield1) ELSE << >>]
        settled2 == [settled1 EXCEPT !.orderRestatedV2ReturnBitfield2 = IF settled1.numberOfReturnBitfields >= 2 THEN (IF settled1.orderRestatedV2ReturnBitfield2 = << >> THEN <<0>> ELSE settled1.orderRestatedV2ReturnBitfield2) ELSE << >>]
        settled3 == [settled2 EXCEPT !.orderRestatedV2ReturnBitfield3 = IF settled2.numberOfReturnBitfields >= 3 THEN (IF settled2.orderRestatedV2ReturnBitfield3 = << >> THEN <<0>> ELSE settled2.orderRestatedV2ReturnBitfield3) ELSE << >>]
        settled4 == [settled3 EXCEPT !.orderRestatedV2ReturnBitfield4 = IF settled3.numberOfReturnBitfields >= 4 THEN (IF settled3.orderRestatedV2ReturnBitfield4 = << >> THEN <<0>> ELSE settled3.orderRestatedV2ReturnBitfield4) ELSE << >>]
        settled5 == [settled4 EXCEPT !.orderRestatedV2ReturnBitfield5 = IF settled4.numberOfReturnBitfields >= 5 THEN (IF settled4.orderRestatedV2ReturnBitfield5 = << >> THEN <<0>> ELSE settled4.orderRestatedV2ReturnBitfield5) ELSE << >>]
        settled6 == [settled5 EXCEPT !.orderRestatedV2ReturnBitfield6 = IF settled5.numberOfReturnBitfields >= 6 THEN (IF settled5.orderRestatedV2ReturnBitfield6 = << >> THEN <<0>> ELSE settled5.orderRestatedV2ReturnBitfield6) ELSE << >>]
        settled7 == [settled6 EXCEPT !.orderRestatedV2ReturnBitfield7 = IF settled6.numberOfReturnBitfields >= 7 THEN (IF settled6.orderRestatedV2ReturnBitfield7 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled6.orderRestatedV2ReturnBitfield7) ELSE << >>]
        settled8 == [settled7 EXCEPT !.orderRestatedV2ReturnBitfield8 = IF settled7.numberOfReturnBitfields >= 8 THEN (IF settled7.orderRestatedV2ReturnBitfield8 = << >> THEN <<0>> ELSE settled7.orderRestatedV2ReturnBitfield8) ELSE << >>]
        settled9 == [settled8 EXCEPT !.orderRestatedV2ReturnBitfield9 = IF settled8.numberOfReturnBitfields >= 9 THEN (IF settled8.orderRestatedV2ReturnBitfield9 = << >> THEN <<0>> ELSE settled8.orderRestatedV2ReturnBitfield9) ELSE << >>]
        settled10 == [settled9 EXCEPT !.orderRestatedV2ReturnBitfield10 = IF settled9.numberOfReturnBitfields >= 10 THEN (IF settled9.orderRestatedV2ReturnBitfield10 = << >> THEN <<0>> ELSE settled9.orderRestatedV2ReturnBitfield10) ELSE << >>]
        settled11 == [settled10 EXCEPT !.orderRestatedV2ReturnBitfield11 = IF settled10.numberOfReturnBitfields >= 11 THEN (IF settled10.orderRestatedV2ReturnBitfield11 = << >> THEN <<0>> ELSE settled10.orderRestatedV2ReturnBitfield11) ELSE << >>]
        settled12 == [settled11 EXCEPT !.orderRestatedV2ReturnBitfield12 = IF settled11.numberOfReturnBitfields >= 12 THEN (IF settled11.orderRestatedV2ReturnBitfield12 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled11.orderRestatedV2ReturnBitfield12) ELSE << >>]
        settled13 == [settled12 EXCEPT !.orderRestatedV2ReturnBitfield13 = IF settled12.numberOfReturnBitfields >= 13 THEN (IF settled12.orderRestatedV2ReturnBitfield13 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled12.orderRestatedV2ReturnBitfield13) ELSE << >>]
        settled14 == [settled13 EXCEPT !.orderRestatedV2ReturnBitfield14 = IF settled13.numberOfReturnBitfields >= 14 THEN (IF settled13.orderRestatedV2ReturnBitfield14 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled13.orderRestatedV2ReturnBitfield14) ELSE << >>]
        settled15 == [settled14 EXCEPT !.orderRestatedV2ReturnBitfield15 = IF settled14.numberOfReturnBitfields >= 15 THEN (IF settled14.orderRestatedV2ReturnBitfield15 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled14.orderRestatedV2ReturnBitfield15) ELSE << >>]
        settled16 == [settled15 EXCEPT !.orderRestatedV2ReturnBitfield16 = IF settled15.numberOfReturnBitfields >= 16 THEN (IF settled15.orderRestatedV2ReturnBitfield16 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled15.orderRestatedV2ReturnBitfield16) ELSE << >>]
        settled17 == [settled16 EXCEPT !.orderRestatedV2ReturnBitfield17 = IF settled16.numberOfReturnBitfields >= 17 THEN (IF settled16.orderRestatedV2ReturnBitfield17 = << >> THEN <<0>> ELSE settled16.orderRestatedV2ReturnBitfield17) ELSE << >>]
        settled18 == [settled17 EXCEPT !.orderRestatedV2ReturnBitfield18 = IF settled17.numberOfReturnBitfields >= 18 THEN (IF settled17.orderRestatedV2ReturnBitfield18 = << >> THEN <<0>> ELSE settled17.orderRestatedV2ReturnBitfield18) ELSE << >>]
        settled19 == [settled18 EXCEPT !.orderRestatedV2ReturnBitfield19 = IF settled18.numberOfReturnBitfields >= 19 THEN (IF settled18.orderRestatedV2ReturnBitfield19 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled18.orderRestatedV2ReturnBitfield19) ELSE << >>]
        settled20 == [settled19 EXCEPT !.side = IF settled19.numberOfReturnBitfields >= 1 /\ (settled19.orderRestatedV2ReturnBitfield1 # << >> /\ settled19.orderRestatedV2ReturnBitfield1[1] % 2 > 0) THEN (IF settled19.side = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled19.side) ELSE << >>]
        settled21 == [settled20 EXCEPT !.price = IF settled20.numberOfReturnBitfields >= 1 /\ (settled20.orderRestatedV2ReturnBitfield1 # << >> /\ (settled20.orderRestatedV2ReturnBitfield1[1] \div 4) % 2 > 0) THEN (IF settled20.price = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled20.price) ELSE << >>]
        settled22 == [settled21 EXCEPT !.ordType = IF settled21.numberOfReturnBitfields >= 1 /\ (settled21.orderRestatedV2ReturnBitfield1 # << >> /\ (settled21.orderRestatedV2ReturnBitfield1[1] \div 16) % 2 > 0) THEN (IF settled21.ordType = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled21.ordType) ELSE << >>]
        settled23 == [settled22 EXCEPT !.timeInForce = IF settled22.numberOfReturnBitfields >= 1 /\ (settled22.orderRestatedV2ReturnBitfield1 # << >> /\ (settled22.orderRestatedV2ReturnBitfield1[1] \div 32) % 2 > 0) THEN (IF settled22.timeInForce = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled22.timeInForce) ELSE << >>]
        settled24 == [settled23 EXCEPT !.minQty = IF settled23.numberOfReturnBitfields >= 1 /\ (settled23.orderRestatedV2ReturnBitfield1 # << >> /\ (settled23.orderRestatedV2ReturnBitfield1[1] \div 64) % 2 > 0) THEN (IF settled23.minQty = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled23.minQty) ELSE << >>]
        settled25 == [settled24 EXCEPT !.symbolLong = IF settled24.numberOfReturnBitfields >= 2 /\ (settled24.orderRestatedV2ReturnBitfield2 # << >> /\ settled24.orderRestatedV2ReturnBitfield2[1] % 2 > 0) THEN (IF settled24.symbolLong = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled24.symbolLong) ELSE << >>]
        settled26 == [settled25 EXCEPT !.idSource = IF settled25.numberOfReturnBitfields >= 2 /\ (settled25.orderRestatedV2ReturnBitfield2 # << >> /\ (settled25.orderRestatedV2ReturnBitfield2[1] \div 8) % 2 > 0) THEN (IF settled25.idSource = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled25.idSource) ELSE << >>]
        settled27 == [settled26 EXCEPT !.securityId = IF settled26.numberOfReturnBitfields >= 2 /\ (settled26.orderRestatedV2ReturnBitfield2 # << >> /\ (settled26.orderRestatedV2ReturnBitfield2[1] \div 16) % 2 > 0) THEN (IF settled26.securityId = << >> THEN <<[i \in 1 .. 16 |-> 0]>> ELSE settled26.securityId) ELSE << >>]
        settled28 == [settled27 EXCEPT !.capacity = IF settled27.numberOfReturnBitfields >= 2 /\ (settled27.orderRestatedV2ReturnBitfield2 # << >> /\ (settled27.orderRestatedV2ReturnBitfield2[1] \div 64) % 2 > 0) THEN (IF settled27.capacity = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled27.capacity) ELSE << >>]
        settled29 == [settled28 EXCEPT !.account = IF settled28.numberOfReturnBitfields >= 3 /\ (settled28.orderRestatedV2ReturnBitfield3 # << >> /\ settled28.orderRestatedV2ReturnBitfield3[1] % 2 > 0) THEN (IF settled28.account = << >> THEN <<[i \in 1 .. 16 |-> 0]>> ELSE settled28.account) ELSE << >>]
        settled30 == [settled29 EXCEPT !.clearingFirm = IF settled29.numberOfReturnBitfields >= 3 /\ (settled29.orderRestatedV2ReturnBitfield3 # << >> /\ (settled29.orderRestatedV2ReturnBitfield3[1] \div 2) % 2 > 0) THEN (IF settled29.clearingFirm = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled29.clearingFirm) ELSE << >>]
        settled31 == [settled30 EXCEPT !.clearingAccount = IF settled30.numberOfReturnBitfields >= 3 /\ (settled30.orderRestatedV2ReturnBitfield3 # << >> /\ (settled30.orderRestatedV2ReturnBitfield3[1] \div 4) % 2 > 0) THEN (IF settled30.clearingAccount = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled30.clearingAccount) ELSE << >>]
        settled32 == [settled31 EXCEPT !.displayIndicator = IF settled31.numberOfReturnBitfields >= 3 /\ (settled31.orderRestatedV2ReturnBitfield3 # << >> /\ (settled31.orderRestatedV2ReturnBitfield3[1] \div 8) % 2 > 0) THEN (IF settled31.displayIndicator = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled31.displayIndicator) ELSE << >>]
        settled33 == [settled32 EXCEPT !.orderQty = IF settled32.numberOfReturnBitfields >= 3 /\ (settled32.orderRestatedV2ReturnBitfield3 # << >> /\ (settled32.orderRestatedV2ReturnBitfield3[1] \div 64) % 2 > 0) THEN (IF settled32.orderQty = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled32.orderQty) ELSE << >>]
        settled34 == [settled33 EXCEPT !.preventMatch = IF settled33.numberOfReturnBitfields >= 3 /\ (settled33.orderRestatedV2ReturnBitfield3 # << >> /\ (settled33.orderRestatedV2ReturnBitfield3[1] \div 128) % 2 > 0) THEN (IF settled33.preventMatch = << >> THEN <<[i \in 1 .. 3 |-> 0]>> ELSE settled33.preventMatch) ELSE << >>]
        settled35 == [settled34 EXCEPT !.openClose = IF settled34.numberOfReturnBitfields >= 4 /\ (settled34.orderRestatedV2ReturnBitfield4 # << >> /\ (settled34.orderRestatedV2ReturnBitfield4[1] \div 8) % 2 > 0) THEN (IF settled34.openClose = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled34.openClose) ELSE << >>]
        settled36 == [settled35 EXCEPT !.origClOrdId = IF settled35.numberOfReturnBitfields >= 5 /\ (settled35.orderRestatedV2ReturnBitfield5 # << >> /\ settled35.orderRestatedV2ReturnBitfield5[1] % 2 > 0) THEN (IF settled35.origClOrdId = << >> THEN <<[i \in 1 .. 20 |-> 0]>> ELSE settled35.origClOrdId) ELSE << >>]
        settled37 == [settled36 EXCEPT !.leavesQty = IF settled36.numberOfReturnBitfields >= 5 /\ (settled36.orderRestatedV2ReturnBitfield5 # << >> /\ (settled36.orderRestatedV2ReturnBitfield5[1] \div 2) % 2 > 0) THEN (IF settled36.leavesQty = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled36.leavesQty) ELSE << >>]
        settled38 == [settled37 EXCEPT !.lastShares = IF settled37.numberOfReturnBitfields >= 5 /\ (settled37.orderRestatedV2ReturnBitfield5 # << >> /\ (settled37.orderRestatedV2ReturnBitfield5[1] \div 4) % 2 > 0) THEN (IF settled37.lastShares = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled37.lastShares) ELSE << >>]
        settled39 == [settled38 EXCEPT !.lastPx = IF settled38.numberOfReturnBitfields >= 5 /\ (settled38.orderRestatedV2ReturnBitfield5 # << >> /\ (settled38.orderRestatedV2ReturnBitfield5[1] \div 8) % 2 > 0) THEN (IF settled38.lastPx = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled38.lastPx) ELSE << >>]
        settled40 == [settled39 EXCEPT !.displayPrice = IF settled39.numberOfReturnBitfields >= 5 /\ (settled39.orderRestatedV2ReturnBitfield5 # << >> /\ (settled39.orderRestatedV2ReturnBitfield5[1] \div 16) % 2 > 0) THEN (IF settled39.displayPrice = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled39.displayPrice) ELSE << >>]
        settled41 == [settled40 EXCEPT !.workingPrice = IF settled40.numberOfReturnBitfields >= 5 /\ (settled40.orderRestatedV2ReturnBitfield5 # << >> /\ (settled40.orderRestatedV2ReturnBitfield5[1] \div 32) % 2 > 0) THEN (IF settled40.workingPrice = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled40.workingPrice) ELSE << >>]
        settled42 == [settled41 EXCEPT !.baseLiquidityIndicator = IF settled41.numberOfReturnBitfields >= 5 /\ (settled41.orderRestatedV2ReturnBitfield5 # << >> /\ (settled41.orderRestatedV2ReturnBitfield5[1] \div 64) % 2 > 0) THEN (IF settled41.baseLiquidityIndicator = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled41.baseLiquidityIndicator) ELSE << >>]
        settled43 == [settled42 EXCEPT !.expireTime = IF settled42.numberOfReturnBitfields >= 5 /\ (settled42.orderRestatedV2ReturnBitfield5 # << >> /\ (settled42.orderRestatedV2ReturnBitfield5[1] \div 128) % 2 > 0) THEN (IF settled42.expireTime = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled42.expireTime) ELSE << >>]
        settled44 == [settled43 EXCEPT !.secondaryOrderId = IF settled43.numberOfReturnBitfields >= 6 /\ (settled43.orderRestatedV2ReturnBitfield6 # << >> /\ settled43.orderRestatedV2ReturnBitfield6[1] % 2 > 0) THEN (IF settled43.secondaryOrderId = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled43.secondaryOrderId) ELSE << >>]
        settled45 == [settled44 EXCEPT !.extExecInst = IF settled44.numberOfReturnBitfields >= 6 /\ (settled44.orderRestatedV2ReturnBitfield6 # << >> /\ (settled44.orderRestatedV2ReturnBitfield6[1] \div 16) % 2 > 0) THEN (IF settled44.extExecInst = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled44.extExecInst) ELSE << >>]
        settled46 == [settled45 EXCEPT !.stopPx = IF settled45.numberOfReturnBitfields >= 8 /\ (settled45.orderRestatedV2ReturnBitfield8 # << >> /\ (settled45.orderRestatedV2ReturnBitfield8[1] \div 4) % 2 > 0) THEN (IF settled45.stopPx = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled45.stopPx) ELSE << >>]
        settled47 == [settled46 EXCEPT !.routingInst = IF settled46.numberOfReturnBitfields >= 8 /\ (settled46.orderRestatedV2ReturnBitfield8 # << >> /\ (settled46.orderRestatedV2ReturnBitfield8[1] \div 8) % 2 > 0) THEN (IF settled46.routingInst = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled46.routingInst) ELSE << >>]
        settled48 == [settled47 EXCEPT !.liquidityProvision = IF settled47.numberOfReturnBitfields >= 9 /\ (settled47.orderRestatedV2ReturnBitfield9 # << >> /\ (settled47.orderRestatedV2ReturnBitfield9[1] \div 16) % 2 > 0) THEN (IF settled47.liquidityProvision = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled47.liquidityProvision) ELSE << >>]
        settled49 == [settled48 EXCEPT !.crossId = IF settled48.numberOfReturnBitfields >= 10 /\ (settled48.orderRestatedV2ReturnBitfield10 # << >> /\ settled48.orderRestatedV2ReturnBitfield10[1] % 2 > 0) THEN (IF settled48.crossId = << >> THEN <<[i \in 1 .. 20 |-> 0]>> ELSE settled48.crossId) ELSE << >>]
        settled50 == [settled49 EXCEPT !.clientQualifiedRole = IF settled49.numberOfReturnBitfields >= 10 /\ (settled49.orderRestatedV2ReturnBitfield10 # << >> /\ (settled49.orderRestatedV2ReturnBitfield10[1] \div 128) % 2 > 0) THEN (IF settled49.clientQualifiedRole = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled49.clientQualifiedRole) ELSE << >>]
        settled51 == [settled50 EXCEPT !.clientId = IF settled50.numberOfReturnBitfields >= 11 /\ (settled50.orderRestatedV2ReturnBitfield11 # << >> /\ settled50.orderRestatedV2ReturnBitfield11[1] % 2 > 0) THEN (IF settled50.clientId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled50.clientId) ELSE << >>]
        settled52 == [settled51 EXCEPT !.investorId = IF settled51.numberOfReturnBitfields >= 11 /\ (settled51.orderRestatedV2ReturnBitfield11 # << >> /\ (settled51.orderRestatedV2ReturnBitfield11[1] \div 2) % 2 > 0) THEN (IF settled51.investorId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled51.investorId) ELSE << >>]
        settled53 == [settled52 EXCEPT !.executorId = IF settled52.numberOfReturnBitfields >= 11 /\ (settled52.orderRestatedV2ReturnBitfield11 # << >> /\ (settled52.orderRestatedV2ReturnBitfield11[1] \div 4) % 2 > 0) THEN (IF settled52.executorId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled52.executorId) ELSE << >>]
        settled54 == [settled53 EXCEPT !.orderOrigination = IF settled53.numberOfReturnBitfields >= 11 /\ (settled53.orderRestatedV2ReturnBitfield11 # << >> /\ (settled53.orderRestatedV2ReturnBitfield11[1] \div 8) % 2 > 0) THEN (IF settled53.orderOrigination = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled53.orderOrigination) ELSE << >>]
        settled55 == [settled54 EXCEPT !.algorithmicIndicator = IF settled54.numberOfReturnBitfields >= 11 /\ (settled54.orderRestatedV2ReturnBitfield11 # << >> /\ (settled54.orderRestatedV2ReturnBitfield11[1] \div 16) % 2 > 0) THEN (IF settled54.algorithmicIndicator = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled54.algorithmicIndicator) ELSE << >>]
        settled56 == [settled55 EXCEPT !.investorQualifiedRole = IF settled55.numberOfReturnBitfields >= 11 /\ (settled55.orderRestatedV2ReturnBitfield11 # << >> /\ (settled55.orderRestatedV2ReturnBitfield11[1] \div 64) % 2 > 0) THEN (IF settled55.investorQualifiedRole = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled55.investorQualifiedRole) ELSE << >>]
        settled57 == [settled56 EXCEPT !.executorQualifiedRole = IF settled56.numberOfReturnBitfields >= 11 /\ (settled56.orderRestatedV2ReturnBitfield11 # << >> /\ (settled56.orderRestatedV2ReturnBitfield11[1] \div 128) % 2 > 0) THEN (IF settled56.executorQualifiedRole = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled56.executorQualifiedRole) ELSE << >>]
        settled58 == [settled57 EXCEPT !.custOrderHandlingInst = IF settled57.numberOfReturnBitfields >= 17 /\ (settled57.orderRestatedV2ReturnBitfield17 # << >> /\ (settled57.orderRestatedV2ReturnBitfield17[1] \div 128) % 2 > 0) THEN (IF settled57.custOrderHandlingInst = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled57.custOrderHandlingInst) ELSE << >>]
        settled59 == [settled58 EXCEPT !.accountType = IF settled58.numberOfReturnBitfields >= 18 /\ (settled58.orderRestatedV2ReturnBitfield18 # << >> /\ settled58.orderRestatedV2ReturnBitfield18[1] % 2 > 0) THEN (IF settled58.accountType = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled58.accountType) ELSE << >>]
    IN  settled59

ZeroOrderRestatedMessage ==
    SettleOrderRestatedMessage([ transactionTime                 |-> [i \in 1 .. 8 |-> 0],
                                 clOrdId                         |-> [i \in 1 .. 20 |-> 0],
                                 orderId                         |-> [i \in 1 .. 8 |-> 0],
                                 restatementReason               |-> [i \in 1 .. 1 |-> 0],
                                 reserved1                       |-> [i \in 1 .. 1 |-> 0],
                                 numberOfReturnBitfields         |-> 0,
                                 orderRestatedV2ReturnBitfield1  |-> << >>,
                                 orderRestatedV2ReturnBitfield2  |-> << >>,
                                 orderRestatedV2ReturnBitfield3  |-> << >>,
                                 orderRestatedV2ReturnBitfield4  |-> << >>,
                                 orderRestatedV2ReturnBitfield5  |-> << >>,
                                 orderRestatedV2ReturnBitfield6  |-> << >>,
                                 orderRestatedV2ReturnBitfield7  |-> << >>,
                                 orderRestatedV2ReturnBitfield8  |-> << >>,
                                 orderRestatedV2ReturnBitfield9  |-> << >>,
                                 orderRestatedV2ReturnBitfield10 |-> << >>,
                                 orderRestatedV2ReturnBitfield11 |-> << >>,
                                 orderRestatedV2ReturnBitfield12 |-> << >>,
                                 orderRestatedV2ReturnBitfield13 |-> << >>,
                                 orderRestatedV2ReturnBitfield14 |-> << >>,
                                 orderRestatedV2ReturnBitfield15 |-> << >>,
                                 orderRestatedV2ReturnBitfield16 |-> << >>,
                                 orderRestatedV2ReturnBitfield17 |-> << >>,
                                 orderRestatedV2ReturnBitfield18 |-> << >>,
                                 orderRestatedV2ReturnBitfield19 |-> << >>,
                                 side                            |-> << >>,
                                 price                           |-> << >>,
                                 ordType                         |-> << >>,
                                 timeInForce                     |-> << >>,
                                 minQty                          |-> << >>,
                                 symbolLong                      |-> << >>,
                                 idSource                        |-> << >>,
                                 securityId                      |-> << >>,
                                 capacity                        |-> << >>,
                                 account                         |-> << >>,
                                 clearingFirm                    |-> << >>,
                                 clearingAccount                 |-> << >>,
                                 displayIndicator                |-> << >>,
                                 orderQty                        |-> << >>,
                                 preventMatch                    |-> << >>,
                                 openClose                       |-> << >>,
                                 origClOrdId                     |-> << >>,
                                 leavesQty                       |-> << >>,
                                 lastShares                      |-> << >>,
                                 lastPx                          |-> << >>,
                                 displayPrice                    |-> << >>,
                                 workingPrice                    |-> << >>,
                                 baseLiquidityIndicator          |-> << >>,
                                 expireTime                      |-> << >>,
                                 secondaryOrderId                |-> << >>,
                                 extExecInst                     |-> << >>,
                                 stopPx                          |-> << >>,
                                 routingInst                     |-> << >>,
                                 liquidityProvision              |-> << >>,
                                 crossId                         |-> << >>,
                                 clientQualifiedRole             |-> << >>,
                                 clientId                        |-> << >>,
                                 investorId                      |-> << >>,
                                 executorId                      |-> << >>,
                                 orderOrigination                |-> << >>,
                                 algorithmicIndicator            |-> << >>,
                                 investorQualifiedRole           |-> << >>,
                                 executorQualifiedRole           |-> << >>,
                                 custOrderHandlingInst           |-> << >>,
                                 accountType                     |-> << >> ])

(* Order Restated Message at zero, then each field in turn at the values it is checked at *)
CheckedOrderRestatedMessage ==
    { ZeroOrderRestatedMessage }
        \cup { SettleOrderRestatedMessage([ZeroOrderRestatedMessage EXCEPT !.transactionTime = one]) : one \in Sample(8) }
        \cup { SettleOrderRestatedMessage([ZeroOrderRestatedMessage EXCEPT !.clOrdId = one]) : one \in Sample(20) }
        \cup { SettleOrderRestatedMessage([ZeroOrderRestatedMessage EXCEPT !.orderId = one]) : one \in Sample(8) }
        \cup { SettleOrderRestatedMessage([ZeroOrderRestatedMessage EXCEPT !.restatementReason = one]) : one \in Sample(1) }
        \cup { SettleOrderRestatedMessage([ZeroOrderRestatedMessage EXCEPT !.reserved1 = one]) : one \in Sample(1) }
        \cup { SettleOrderRestatedMessage([ZeroOrderRestatedMessage EXCEPT !.numberOfReturnBitfields = one]) : one \in {0, 1, 255} }
        \cup { SettleOrderRestatedMessage([ZeroOrderRestatedMessage EXCEPT !.numberOfReturnBitfields = 1, !.orderRestatedV2ReturnBitfield1 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderRestatedMessage([ZeroOrderRestatedMessage EXCEPT !.numberOfReturnBitfields = 2, !.orderRestatedV2ReturnBitfield2 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderRestatedMessage([ZeroOrderRestatedMessage EXCEPT !.numberOfReturnBitfields = 3, !.orderRestatedV2ReturnBitfield3 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderRestatedMessage([ZeroOrderRestatedMessage EXCEPT !.numberOfReturnBitfields = 4, !.orderRestatedV2ReturnBitfield4 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderRestatedMessage([ZeroOrderRestatedMessage EXCEPT !.numberOfReturnBitfields = 5, !.orderRestatedV2ReturnBitfield5 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderRestatedMessage([ZeroOrderRestatedMessage EXCEPT !.numberOfReturnBitfields = 6, !.orderRestatedV2ReturnBitfield6 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderRestatedMessage([ZeroOrderRestatedMessage EXCEPT !.numberOfReturnBitfields = 7, !.orderRestatedV2ReturnBitfield7 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderRestatedMessage([ZeroOrderRestatedMessage EXCEPT !.numberOfReturnBitfields = 8, !.orderRestatedV2ReturnBitfield8 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderRestatedMessage([ZeroOrderRestatedMessage EXCEPT !.numberOfReturnBitfields = 9, !.orderRestatedV2ReturnBitfield9 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderRestatedMessage([ZeroOrderRestatedMessage EXCEPT !.numberOfReturnBitfields = 10, !.orderRestatedV2ReturnBitfield10 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderRestatedMessage([ZeroOrderRestatedMessage EXCEPT !.numberOfReturnBitfields = 11, !.orderRestatedV2ReturnBitfield11 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderRestatedMessage([ZeroOrderRestatedMessage EXCEPT !.numberOfReturnBitfields = 12, !.orderRestatedV2ReturnBitfield12 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderRestatedMessage([ZeroOrderRestatedMessage EXCEPT !.numberOfReturnBitfields = 13, !.orderRestatedV2ReturnBitfield13 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderRestatedMessage([ZeroOrderRestatedMessage EXCEPT !.numberOfReturnBitfields = 14, !.orderRestatedV2ReturnBitfield14 = one]) : one \in { <<held>> : held \in Sample(1) } }
