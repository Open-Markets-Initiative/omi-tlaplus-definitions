-------------- MODULE CedxDerivatives_BinaryOrderEntry_v2_32 ---------------
(***************************************************************************)
(* Chicago Board Options Exchange Europe Derivatives Binary Order Entry    *)
(* v2.32                                                                   *)
(*                                                                         *)
(* Generated from the binary model. A field is the bytes it occupies; an   *)
(* integer is read only where a rule depends on one - a length, a count, a *)
(* message type - which are the dependencies the parse rules run on.       *)
(*                                                                         *)
(* TLC checks that every record decodes back to what was encoded, that a   *)
(* dispatch selects the message its type names, and that a derived length  *)
(* or count is written from what it describes.                             *)
(*                                                                         *)
(* Note: TLC evaluates integers in 32 bits, so a field wider than that has *)
(* no range it can enumerate; every field is checked as its bytes, which   *)
(* is exact at any width.                                                  *)
(*                                                                         *)
(* License: MIT No Attribution                                             *)
(*                                                                         *)
(* Note: Login Request V 2 Message fills what is left of the frame Message *)
(* Length states, which is what it is read from.                           *)
(*                                                                         *)
(* Note: Login Response V 2 Message fills what is left of the frame        *)
(* Message Length states, which is what it is read from.                   *)
(*                                                                         *)
(* Note: Logout Message fills what is left of the frame Message Length     *)
(* states, which is what it is read from.                                  *)
(*                                                                         *)
(* Note: A field marked present by fields read before it is read only when *)
(* they say it is there, and the records checked hold it exactly where     *)
(* they do: one holding it anywhere else is no message the protocol sends. *)
(*                                                                         *)
(* Note: New Order V 2 Message fills what is left of the frame Message     *)
(* Length states, which is what it is read from.                           *)
(*                                                                         *)
(* Note: New Order Cross Message fills what is left of the frame Message   *)
(* Length states, which is what it is read from.                           *)
(*                                                                         *)
(* Note: New Complex Order Message fills what is left of the frame Message *)
(* Length states, which is what it is read from.                           *)
(*                                                                         *)
(* Note: New Order Cross Multileg Message fills what is left of the frame  *)
(* Message Length states, which is what it is read from.                   *)
(*                                                                         *)
(* Note: Cancel Order V 2 Message fills what is left of the frame Message  *)
(* Length states, which is what it is read from.                           *)
(*                                                                         *)
(* Note: Modify Order V 2 Message fills what is left of the frame Message  *)
(* Length states, which is what it is read from.                           *)
(*                                                                         *)
(* Note: Quote Update Message fills what is left of the frame Message      *)
(* Length states, which is what it is read from.                           *)
(*                                                                         *)
(* Note: Purge Orders Message fills what is left of the frame Message      *)
(* Length states, which is what it is read from.                           *)
(*                                                                         *)
(* Note: Reset Risk Message fills what is left of the frame Message Length *)
(* states, which is what it is read from.                                  *)
(*                                                                         *)
(* Note: New Complex Instrument Message fills what is left of the frame    *)
(* Message Length states, which is what it is read from.                   *)
(*                                                                         *)
(* Note: Trade Capture Report V 2 Message fills what is left of the frame  *)
(* Message Length states, which is what it is read from.                   *)
(*                                                                         *)
(* Note: Order Acknowledgment V 2 Message fills what is left of the frame  *)
(* Message Length states, which is what it is read from.                   *)
(*                                                                         *)
(* Note: Cross Order Acknowledgment Message fills what is left of the      *)
(* frame Message Length states, which is what it is read from.             *)
(*                                                                         *)
(* Note: Quote Update Acknowledgment Message fills what is left of the     *)
(* frame Message Length states, which is what it is read from.             *)
(*                                                                         *)
(* Note: Order Rejected V 2 Message fills what is left of the frame        *)
(* Message Length states, which is what it is read from.                   *)
(*                                                                         *)
(* Note: Cross Order Rejected Message fills what is left of the frame      *)
(* Message Length states, which is what it is read from.                   *)
(*                                                                         *)
(* Note: Quote Update Rejected Message fills what is left of the frame     *)
(* Message Length states, which is what it is read from.                   *)
(*                                                                         *)
(* Note: Order Modified V 2 Message fills what is left of the frame        *)
(* Message Length states, which is what it is read from.                   *)
(*                                                                         *)
(* Note: Order Restated Message fills what is left of the frame Message    *)
(* Length states, which is what it is read from.                           *)
(*                                                                         *)
(* Note: Quote Restated Message fills what is left of the frame Message    *)
(* Length states, which is what it is read from.                           *)
(*                                                                         *)
(* Note: User Modify Rejected V 2 Message fills what is left of the frame  *)
(* Message Length states, which is what it is read from.                   *)
(*                                                                         *)
(* Note: Order Cancelled V 2 Message fills what is left of the frame       *)
(* Message Length states, which is what it is read from.                   *)
(*                                                                         *)
(* Note: Quote Cancelled Message fills what is left of the frame Message   *)
(* Length states, which is what it is read from.                           *)
(*                                                                         *)
(* Note: Cross Order Cancelled Message fills what is left of the frame     *)
(* Message Length states, which is what it is read from.                   *)
(*                                                                         *)
(* Note: Cancel Rejected V 2 Message fills what is left of the frame       *)
(* Message Length states, which is what it is read from.                   *)
(*                                                                         *)
(* Note: Order Execution V 2 Message fills what is left of the frame       *)
(* Message Length states, which is what it is read from.                   *)
(*                                                                         *)
(* Note: Quote Execution Message fills what is left of the frame Message   *)
(* Length states, which is what it is read from.                           *)
(*                                                                         *)
(* Note: Trade Cancel Or Correct V 2 Message fills what is left of the     *)
(* frame Message Length states, which is what it is read from.             *)
(*                                                                         *)
(* Note: Purge Rejected Message fills what is left of the frame Message    *)
(* Length states, which is what it is read from.                           *)
(*                                                                         *)
(* Note: Reset Risk Acknowledgment Message fills what is left of the frame *)
(* Message Length states, which is what it is read from.                   *)
(*                                                                         *)
(* Note: Mass Cancel Acknowledgment Message fills what is left of the      *)
(* frame Message Length states, which is what it is read from.             *)
(*                                                                         *)
(* Note: Complex Instrument Accepted Message fills what is left of the     *)
(* frame Message Length states, which is what it is read from.             *)
(*                                                                         *)
(* Note: Complex Instrument Rejected Message fills what is left of the     *)
(* frame Message Length states, which is what it is read from.             *)
(*                                                                         *)
(* Note: Trade Capture Report Acknowledgment V 2 Message fills what is     *)
(* left of the frame Message Length states, which is what it is read from. *)
(*                                                                         *)
(* Note: Trade Capture Report Reject V 2 Message fills what is left of the *)
(* frame Message Length states, which is what it is read from.             *)
(*                                                                         *)
(* Note: Trade Capture Confirm V 2 Message fills what is left of the frame *)
(* Message Length states, which is what it is read from.                   *)
(*                                                                         *)
(* Note: Trade Capture Report Decline V 2 Message fills what is left of    *)
(* the frame Message Length states, which is what it is read from.         *)
(***************************************************************************)
EXTENDS Integers, Sequences

(***************************************************************************)
(* Wire primitives                                                         *)
(***************************************************************************)

Byte == 0 .. 255

(* An unsigned integer, least significant byte first. Read only where a rule *)
(* depends on the value: a length, a count, a message type. *)
RECURSIVE DecodeUIntLE(_)
DecodeUIntLE(bytes) ==
    IF bytes = << >>
    THEN 0
    ELSE Head(bytes) + 256 * DecodeUIntLE(Tail(bytes))

RECURSIVE EncodeUIntLE(_, _)
EncodeUIntLE(value, width) ==
    IF width = 0
    THEN << >>
    ELSE <<value % 256>> \o EncodeUIntLE(value \div 256, width - 1)

(* The same, most significant byte first, which is how a big endian protocol writes it *)
RECURSIVE DecodeUIntBE(_)
DecodeUIntBE(bytes) ==
    IF bytes = << >>
    THEN 0
    ELSE DecodeUIntBE(SubSeq(bytes, 1, Len(bytes) - 1)) * 256 + bytes[Len(bytes)]

RECURSIVE EncodeUIntBE(_, _)
EncodeUIntBE(value, width) ==
    IF width = 0
    THEN << >>
    ELSE EncodeUIntBE(value \div 256, width - 1) \o <<value % 256>>

(***************************************************************************)
(* A decoder yields the value it read and the bytes left, or fails         *)
(***************************************************************************)

Fail == [ok |-> FALSE]
Ok(value, rest) == [ok |-> TRUE, value |-> value, rest |-> rest]

(* The bytes a field of this width occupies, kept as they lie *)
ReadBytes(bytes, width) ==
    IF Len(bytes) < width
    THEN Fail
    ELSE Ok(SubSeq(bytes, 1, width), SubSeq(bytes, width + 1, Len(bytes)))

(* The integer a rule depends on, in the byte order the field states *)
ReadUIntLE(bytes, width) ==
    IF Len(bytes) < width
    THEN Fail
    ELSE Ok(DecodeUIntLE(SubSeq(bytes, 1, width)), SubSeq(bytes, width + 1, Len(bytes)))

ReadUIntBE(bytes, width) ==
    IF Len(bytes) < width
    THEN Fail
    ELSE Ok(DecodeUIntBE(SubSeq(bytes, 1, width)), SubSeq(bytes, width + 1, Len(bytes)))

(* A field there only when what was read before it says so: read when it is, and held *)
(* as a sequence of the one value it read, or of none when it is not there. *)
ReadWhen(holds, read, bytes) ==
    IF ~holds
    THEN Ok(<< >>, bytes)
    ELSE IF ~read.ok THEN Fail ELSE Ok(<<read.value>>, read.rest)

(***************************************************************************)
(* The values a field is checked at: zero, the spaces a text field is      *)
(* padded with, and                                                        *)
(* every bit set, which is where an encoding goes wrong if it goes wrong   *)
(***************************************************************************)

Sample(width) ==
    { [i \in 1 .. width |-> 0],
      [i \in 1 .. width |-> 32],
      [i \in 1 .. width |-> 255] }

(* The bytes a field of no width of its own is checked at: none, one, and a short run *)
SampleBytes == { << >>, <<0>>, <<32, 255>> }

(* The lists a record is checked over: none, one, and a run of two. What a run has *)
(* to get right is reading one entry after another, which two of a kind already say. *)
SampleLists(entries) ==
    { << >> }
        \cup { <<one>> : one \in entries }
        \cup { <<one, one>> : one \in entries }

(***************************************************************************)
(* Units: 5 bytes                                                          *)
(***************************************************************************)

Units ==
    [ unitNumber   : Sample(1),
      unitSequence : Sample(4) ]

EncodeUnits(message) ==
    message.unitNumber
        \o message.unitSequence

DecodeUnits(bytes) ==
    LET unitNumber == ReadBytes(bytes, 1) IN IF ~unitNumber.ok THEN Fail ELSE
    LET unitSequence == ReadBytes(unitNumber.rest, 4) IN IF ~unitSequence.ok THEN Fail ELSE
    Ok([ unitNumber   |-> unitNumber.value,
         unitSequence |-> unitSequence.value ], unitSequence.rest)

ZeroUnits ==
    [ unitNumber   |-> [i \in 1 .. 1 |-> 0],
      unitSequence |-> [i \in 1 .. 4 |-> 0] ]

(* Units at zero, then each field in turn at the values it is checked at *)
CheckedUnits ==
    { ZeroUnits }
        \cup { [ZeroUnits EXCEPT !.unitNumber = one] : one \in Sample(1) }
        \cup { [ZeroUnits EXCEPT !.unitSequence = one] : one \in Sample(4) }

(* A run of Units, written one after another *)
RECURSIVE EncodeUnitsList(_)
EncodeUnitsList(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeUnits(Head(messages)) \o EncodeUnitsList(Tail(messages))

(* As many Units as the field that counts them says *)
RECURSIVE ReadUnitsList(_, _)
ReadUnitsList(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeUnits(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadUnitsList(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Units of each kind, for the lists that carry them *)
OneUnits == { ZeroUnits }

(***************************************************************************)
(* Unit Sequences Param Group                                              *)
(***************************************************************************)

UnitSequencesParamGroup ==
    [ noUnspecifiedUnitReplay : Sample(1),
      units                   : SampleLists(OneUnits) ]

EncodeUnitSequencesParamGroup(message) ==
    message.noUnspecifiedUnitReplay
        \o EncodeUIntBE(Len(message.units), 1)
        \o EncodeUnitsList(message.units)

DecodeUnitSequencesParamGroup(bytes) ==
    LET noUnspecifiedUnitReplay == ReadBytes(bytes, 1) IN IF ~noUnspecifiedUnitReplay.ok THEN Fail ELSE
    LET numberOfUnits == ReadUIntBE(noUnspecifiedUnitReplay.rest, 1) IN IF ~numberOfUnits.ok THEN Fail ELSE
    LET units == ReadUnitsList(numberOfUnits.rest, numberOfUnits.value) IN IF ~units.ok THEN Fail ELSE
    Ok([ noUnspecifiedUnitReplay |-> noUnspecifiedUnitReplay.value,
         units                   |-> units.value ], units.rest)

ZeroUnitSequencesParamGroup ==
    [ noUnspecifiedUnitReplay |-> [i \in 1 .. 1 |-> 0],
      units                   |-> << >> ]

(* Unit Sequences Param Group at zero, then each field in turn at the values it is checked at *)
CheckedUnitSequencesParamGroup ==
    { ZeroUnitSequencesParamGroup }
        \cup { [ZeroUnitSequencesParamGroup EXCEPT !.noUnspecifiedUnitReplay = one] : one \in Sample(1) }
        \cup { [ZeroUnitSequencesParamGroup EXCEPT !.units = one] : one \in SampleLists(OneUnits) }

(***************************************************************************)
(* Return Bitfields: 1 bytes                                               *)
(***************************************************************************)

ReturnBitfields ==
    [ returnBitfield : Sample(1) ]

EncodeReturnBitfields(message) ==
    message.returnBitfield

DecodeReturnBitfields(bytes) ==
    LET returnBitfield == ReadBytes(bytes, 1) IN IF ~returnBitfield.ok THEN Fail ELSE
    Ok([ returnBitfield |-> returnBitfield.value ], returnBitfield.rest)

ZeroReturnBitfields ==
    [ returnBitfield |-> [i \in 1 .. 1 |-> 0] ]

(* Return Bitfields at zero, then each field in turn at the values it is checked at *)
CheckedReturnBitfields ==
    { ZeroReturnBitfields }
        \cup { [ZeroReturnBitfields EXCEPT !.returnBitfield = one] : one \in Sample(1) }

(* A run of Return Bitfields, written one after another *)
RECURSIVE EncodeReturnBitfieldsList(_)
EncodeReturnBitfieldsList(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeReturnBitfields(Head(messages)) \o EncodeReturnBitfieldsList(Tail(messages))

(* As many Return Bitfields as the field that counts them says *)
RECURSIVE ReadReturnBitfieldsList(_, _)
ReadReturnBitfieldsList(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeReturnBitfields(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadReturnBitfieldsList(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Return Bitfields of each kind, for the lists that carry them *)
OneReturnBitfields == { ZeroReturnBitfields }

(***************************************************************************)
(* Return Bitfields Param Group                                            *)
(***************************************************************************)

ReturnBitfieldsParamGroup ==
    [ messageType     : Sample(1),
      returnBitfields : SampleLists(OneReturnBitfields) ]

EncodeReturnBitfieldsParamGroup(message) ==
    message.messageType
        \o EncodeUIntBE(Len(message.returnBitfields), 1)
        \o EncodeReturnBitfieldsList(message.returnBitfields)

DecodeReturnBitfieldsParamGroup(bytes) ==
    LET messageType == ReadBytes(bytes, 1) IN IF ~messageType.ok THEN Fail ELSE
    LET numberOfReturnBitfields == ReadUIntBE(messageType.rest, 1) IN IF ~numberOfReturnBitfields.ok THEN Fail ELSE
    LET returnBitfields == ReadReturnBitfieldsList(numberOfReturnBitfields.rest, numberOfReturnBitfields.value) IN IF ~returnBitfields.ok THEN Fail ELSE
    Ok([ messageType     |-> messageType.value,
         returnBitfields |-> returnBitfields.value ], returnBitfields.rest)

ZeroReturnBitfieldsParamGroup ==
    [ messageType     |-> [i \in 1 .. 1 |-> 0],
      returnBitfields |-> << >> ]

(* Return Bitfields Param Group at zero, then each field in turn at the values it is checked at *)
CheckedReturnBitfieldsParamGroup ==
    { ZeroReturnBitfieldsParamGroup }
        \cup { [ZeroReturnBitfieldsParamGroup EXCEPT !.messageType = one] : one \in Sample(1) }
        \cup { [ZeroReturnBitfieldsParamGroup EXCEPT !.returnBitfields = one] : one \in SampleLists(OneReturnBitfields) }

(***************************************************************************)
(* ParamGroupPayload, selected by Param Group Type                         *)
(***************************************************************************)

UnitSequencesParamGroupCode == 128  \* 0x80
ReturnBitfieldsParamGroupCode == 129  \* 0x81

Paramgrouppayload ==
    [ tag : {UnitSequencesParamGroupCode}, body : UnitSequencesParamGroup ]
        \cup [ tag : {ReturnBitfieldsParamGroupCode}, body : ReturnBitfieldsParamGroup ]

EncodeParamgrouppayload(message) ==
    CASE message.tag = UnitSequencesParamGroupCode -> EncodeUnitSequencesParamGroup(message.body)
      [] message.tag = ReturnBitfieldsParamGroupCode -> EncodeReturnBitfieldsParamGroup(message.body)

DecodeParamgrouppayload(tag, bytes) ==
    LET read ==
            CASE tag = UnitSequencesParamGroupCode -> DecodeUnitSequencesParamGroup(bytes)
              [] tag = ReturnBitfieldsParamGroupCode -> DecodeReturnBitfieldsParamGroup(bytes)
              [] OTHER -> Fail
    IN  IF ~read.ok THEN Fail ELSE Ok([tag |-> tag, body |-> read.value], read.rest)

ZeroParamgrouppayload == [tag |-> UnitSequencesParamGroupCode, body |-> ZeroUnitSequencesParamGroup]

(* Each ParamGroupPayload in turn, at the values the message it names is checked at *)
CheckedParamgrouppayload ==
    { [tag |-> UnitSequencesParamGroupCode, body |-> one] : one \in CheckedUnitSequencesParamGroup }
        \cup { [tag |-> ReturnBitfieldsParamGroupCode, body |-> one] : one \in CheckedReturnBitfieldsParamGroup }

(***************************************************************************)
(* Param Group                                                             *)
(***************************************************************************)

ParamGroup ==
    [ paramGroupLength  : Sample(2),
      paramgrouppayload : Paramgrouppayload ]

EncodeParamGroup(message) ==
    message.paramGroupLength
        \o EncodeUIntBE(message.paramgrouppayload.tag, 1)
        \o EncodeParamgrouppayload(message.paramgrouppayload)

DecodeParamGroup(bytes) ==
    LET paramGroupLength == ReadBytes(bytes, 2) IN IF ~paramGroupLength.ok THEN Fail ELSE
    LET paramGroupType == ReadUIntBE(paramGroupLength.rest, 1) IN IF ~paramGroupType.ok THEN Fail ELSE
    LET paramgrouppayload == DecodeParamgrouppayload(paramGroupType.value, paramGroupType.rest) IN IF ~paramgrouppayload.ok THEN Fail ELSE
    Ok([ paramGroupLength  |-> paramGroupLength.value,
         paramgrouppayload |-> paramgrouppayload.value ], paramgrouppayload.rest)

ZeroParamGroup ==
    [ paramGroupLength  |-> [i \in 1 .. 2 |-> 0],
      paramgrouppayload |-> ZeroParamgrouppayload ]

(* Param Group at zero, then each field in turn at the values it is checked at *)
CheckedParamGroup ==
    { ZeroParamGroup }
        \cup { [ZeroParamGroup EXCEPT !.paramGroupLength = one] : one \in Sample(2) }
        \cup { [ZeroParamGroup EXCEPT !.paramgrouppayload = one] : one \in CheckedParamgrouppayload }

(* A run of Param Group, written one after another *)
RECURSIVE EncodeParamGroupList(_)
EncodeParamGroupList(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeParamGroup(Head(messages)) \o EncodeParamGroupList(Tail(messages))

(* As many Param Group as the field that counts them says *)
RECURSIVE ReadParamGroupList(_, _)
ReadParamGroupList(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeParamGroup(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadParamGroupList(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Param Group of each kind, for the lists that carry them *)
OneParamGroup ==
    { [ZeroParamGroup EXCEPT !.paramgrouppayload = [tag |-> UnitSequencesParamGroupCode, body |-> ZeroUnitSequencesParamGroup]],
      [ZeroParamGroup EXCEPT !.paramgrouppayload = [tag |-> ReturnBitfieldsParamGroupCode, body |-> ZeroReturnBitfieldsParamGroup]] }

(***************************************************************************)
(* Login Request V 2 Message                                               *)
(***************************************************************************)

LoginRequestV2Message ==
    [ sessionSubId : Sample(4),
      username     : Sample(4),
      password     : Sample(10),
      paramGroup   : SampleLists(OneParamGroup) ]

EncodeLoginRequestV2Message(message) ==
    message.sessionSubId
        \o message.username
        \o message.password
        \o EncodeUIntBE(Len(message.paramGroup), 1)
        \o EncodeParamGroupList(message.paramGroup)

DecodeLoginRequestV2Message(bytes) ==
    LET sessionSubId == ReadBytes(bytes, 4) IN IF ~sessionSubId.ok THEN Fail ELSE
    LET username == ReadBytes(sessionSubId.rest, 4) IN IF ~username.ok THEN Fail ELSE
    LET password == ReadBytes(username.rest, 10) IN IF ~password.ok THEN Fail ELSE
    LET numberOfParamGroups == ReadUIntBE(password.rest, 1) IN IF ~numberOfParamGroups.ok THEN Fail ELSE
    LET paramGroup == ReadParamGroupList(numberOfParamGroups.rest, numberOfParamGroups.value) IN IF ~paramGroup.ok THEN Fail ELSE
    Ok([ sessionSubId |-> sessionSubId.value,
         username     |-> username.value,
         password     |-> password.value,
         paramGroup   |-> paramGroup.value ], paramGroup.rest)

ZeroLoginRequestV2Message ==
    [ sessionSubId |-> [i \in 1 .. 4 |-> 0],
      username     |-> [i \in 1 .. 4 |-> 0],
      password     |-> [i \in 1 .. 10 |-> 0],
      paramGroup   |-> << >> ]

(* Login Request V 2 Message at zero, then each field in turn at the values it is checked at *)
CheckedLoginRequestV2Message ==
    { ZeroLoginRequestV2Message }
        \cup { [ZeroLoginRequestV2Message EXCEPT !.sessionSubId = one] : one \in Sample(4) }
        \cup { [ZeroLoginRequestV2Message EXCEPT !.username = one] : one \in Sample(4) }
        \cup { [ZeroLoginRequestV2Message EXCEPT !.password = one] : one \in Sample(10) }
        \cup { [ZeroLoginRequestV2Message EXCEPT !.paramGroup = one] : one \in SampleLists(OneParamGroup) }

(***************************************************************************)
(* Units: 5 bytes                                                          *)
(***************************************************************************)

Units2 ==
    [ unitNumber   : Sample(1),
      unitSequence : Sample(4) ]

EncodeUnits2(message) ==
    message.unitNumber
        \o message.unitSequence

DecodeUnits2(bytes) ==
    LET unitNumber == ReadBytes(bytes, 1) IN IF ~unitNumber.ok THEN Fail ELSE
    LET unitSequence == ReadBytes(unitNumber.rest, 4) IN IF ~unitSequence.ok THEN Fail ELSE
    Ok([ unitNumber   |-> unitNumber.value,
         unitSequence |-> unitSequence.value ], unitSequence.rest)

ZeroUnits2 ==
    [ unitNumber   |-> [i \in 1 .. 1 |-> 0],
      unitSequence |-> [i \in 1 .. 4 |-> 0] ]

(* Units at zero, then each field in turn at the values it is checked at *)
CheckedUnits2 ==
    { ZeroUnits2 }
        \cup { [ZeroUnits2 EXCEPT !.unitNumber = one] : one \in Sample(1) }
        \cup { [ZeroUnits2 EXCEPT !.unitSequence = one] : one \in Sample(4) }

(* A run of Units, written one after another *)
RECURSIVE EncodeUnits2List(_)
EncodeUnits2List(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeUnits2(Head(messages)) \o EncodeUnits2List(Tail(messages))

(* As many Units as the field that counts them says *)
RECURSIVE ReadUnits2List(_, _)
ReadUnits2List(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeUnits2(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadUnits2List(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Units of each kind, for the lists that carry them *)
OneUnits2 == { ZeroUnits2 }

(***************************************************************************)
(* Units: 5 bytes                                                          *)
(***************************************************************************)

Units3 ==
    [ unitNumber   : Sample(1),
      unitSequence : Sample(4) ]

EncodeUnits3(message) ==
    message.unitNumber
        \o message.unitSequence

DecodeUnits3(bytes) ==
    LET unitNumber == ReadBytes(bytes, 1) IN IF ~unitNumber.ok THEN Fail ELSE
    LET unitSequence == ReadBytes(unitNumber.rest, 4) IN IF ~unitSequence.ok THEN Fail ELSE
    Ok([ unitNumber   |-> unitNumber.value,
         unitSequence |-> unitSequence.value ], unitSequence.rest)

ZeroUnits3 ==
    [ unitNumber   |-> [i \in 1 .. 1 |-> 0],
      unitSequence |-> [i \in 1 .. 4 |-> 0] ]

(* Units at zero, then each field in turn at the values it is checked at *)
CheckedUnits3 ==
    { ZeroUnits3 }
        \cup { [ZeroUnits3 EXCEPT !.unitNumber = one] : one \in Sample(1) }
        \cup { [ZeroUnits3 EXCEPT !.unitSequence = one] : one \in Sample(4) }

(* A run of Units, written one after another *)
RECURSIVE EncodeUnits3List(_)
EncodeUnits3List(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeUnits3(Head(messages)) \o EncodeUnits3List(Tail(messages))

(* As many Units as the field that counts them says *)
RECURSIVE ReadUnits3List(_, _)
ReadUnits3List(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeUnits3(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadUnits3List(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Units of each kind, for the lists that carry them *)
OneUnits3 == { ZeroUnits3 }

(***************************************************************************)
(* Unit Sequences Param Group                                              *)
(***************************************************************************)

UnitSequencesParamGroup2 ==
    [ noUnspecifiedUnitReplay : Sample(1),
      units                   : SampleLists(OneUnits3) ]

EncodeUnitSequencesParamGroup2(message) ==
    message.noUnspecifiedUnitReplay
        \o EncodeUIntBE(Len(message.units), 1)
        \o EncodeUnits3List(message.units)

DecodeUnitSequencesParamGroup2(bytes) ==
    LET noUnspecifiedUnitReplay == ReadBytes(bytes, 1) IN IF ~noUnspecifiedUnitReplay.ok THEN Fail ELSE
    LET numberOfUnits == ReadUIntBE(noUnspecifiedUnitReplay.rest, 1) IN IF ~numberOfUnits.ok THEN Fail ELSE
    LET units == ReadUnits3List(numberOfUnits.rest, numberOfUnits.value) IN IF ~units.ok THEN Fail ELSE
    Ok([ noUnspecifiedUnitReplay |-> noUnspecifiedUnitReplay.value,
         units                   |-> units.value ], units.rest)

ZeroUnitSequencesParamGroup2 ==
    [ noUnspecifiedUnitReplay |-> [i \in 1 .. 1 |-> 0],
      units                   |-> << >> ]

(* Unit Sequences Param Group at zero, then each field in turn at the values it is checked at *)
CheckedUnitSequencesParamGroup2 ==
    { ZeroUnitSequencesParamGroup2 }
        \cup { [ZeroUnitSequencesParamGroup2 EXCEPT !.noUnspecifiedUnitReplay = one] : one \in Sample(1) }
        \cup { [ZeroUnitSequencesParamGroup2 EXCEPT !.units = one] : one \in SampleLists(OneUnits3) }

(***************************************************************************)
(* Return Bitfields: 1 bytes                                               *)
(***************************************************************************)

ReturnBitfields2 ==
    [ returnBitfield : Sample(1) ]

EncodeReturnBitfields2(message) ==
    message.returnBitfield

DecodeReturnBitfields2(bytes) ==
    LET returnBitfield == ReadBytes(bytes, 1) IN IF ~returnBitfield.ok THEN Fail ELSE
    Ok([ returnBitfield |-> returnBitfield.value ], returnBitfield.rest)

ZeroReturnBitfields2 ==
    [ returnBitfield |-> [i \in 1 .. 1 |-> 0] ]

(* Return Bitfields at zero, then each field in turn at the values it is checked at *)
CheckedReturnBitfields2 ==
    { ZeroReturnBitfields2 }
        \cup { [ZeroReturnBitfields2 EXCEPT !.returnBitfield = one] : one \in Sample(1) }

(* A run of Return Bitfields, written one after another *)
RECURSIVE EncodeReturnBitfields2List(_)
EncodeReturnBitfields2List(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeReturnBitfields2(Head(messages)) \o EncodeReturnBitfields2List(Tail(messages))

(* As many Return Bitfields as the field that counts them says *)
RECURSIVE ReadReturnBitfields2List(_, _)
ReadReturnBitfields2List(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeReturnBitfields2(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadReturnBitfields2List(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Return Bitfields of each kind, for the lists that carry them *)
OneReturnBitfields2 == { ZeroReturnBitfields2 }

(***************************************************************************)
(* Return Bitfields Param Group                                            *)
(***************************************************************************)

ReturnBitfieldsParamGroup2 ==
    [ messageType     : Sample(1),
      returnBitfields : SampleLists(OneReturnBitfields2) ]

EncodeReturnBitfieldsParamGroup2(message) ==
    message.messageType
        \o EncodeUIntBE(Len(message.returnBitfields), 1)
        \o EncodeReturnBitfields2List(message.returnBitfields)

DecodeReturnBitfieldsParamGroup2(bytes) ==
    LET messageType == ReadBytes(bytes, 1) IN IF ~messageType.ok THEN Fail ELSE
    LET numberOfReturnBitfields == ReadUIntBE(messageType.rest, 1) IN IF ~numberOfReturnBitfields.ok THEN Fail ELSE
    LET returnBitfields == ReadReturnBitfields2List(numberOfReturnBitfields.rest, numberOfReturnBitfields.value) IN IF ~returnBitfields.ok THEN Fail ELSE
    Ok([ messageType     |-> messageType.value,
         returnBitfields |-> returnBitfields.value ], returnBitfields.rest)

ZeroReturnBitfieldsParamGroup2 ==
    [ messageType     |-> [i \in 1 .. 1 |-> 0],
      returnBitfields |-> << >> ]

(* Return Bitfields Param Group at zero, then each field in turn at the values it is checked at *)
CheckedReturnBitfieldsParamGroup2 ==
    { ZeroReturnBitfieldsParamGroup2 }
        \cup { [ZeroReturnBitfieldsParamGroup2 EXCEPT !.messageType = one] : one \in Sample(1) }
        \cup { [ZeroReturnBitfieldsParamGroup2 EXCEPT !.returnBitfields = one] : one \in SampleLists(OneReturnBitfields2) }

(***************************************************************************)
(* ParamGroupPayload, selected by Param Group Type                         *)
(***************************************************************************)

UnitSequencesParamGroupCode2 == 128  \* 0x80
ReturnBitfieldsParamGroupCode2 == 129  \* 0x81

Paramgrouppayload2 ==
    [ tag : {UnitSequencesParamGroupCode2}, body : UnitSequencesParamGroup2 ]
        \cup [ tag : {ReturnBitfieldsParamGroupCode2}, body : ReturnBitfieldsParamGroup2 ]

EncodeParamgrouppayload2(message) ==
    CASE message.tag = UnitSequencesParamGroupCode2 -> EncodeUnitSequencesParamGroup2(message.body)
      [] message.tag = ReturnBitfieldsParamGroupCode2 -> EncodeReturnBitfieldsParamGroup2(message.body)

DecodeParamgrouppayload2(tag, bytes) ==
    LET read ==
            CASE tag = UnitSequencesParamGroupCode2 -> DecodeUnitSequencesParamGroup2(bytes)
              [] tag = ReturnBitfieldsParamGroupCode2 -> DecodeReturnBitfieldsParamGroup2(bytes)
              [] OTHER -> Fail
    IN  IF ~read.ok THEN Fail ELSE Ok([tag |-> tag, body |-> read.value], read.rest)

ZeroParamgrouppayload2 == [tag |-> UnitSequencesParamGroupCode2, body |-> ZeroUnitSequencesParamGroup2]

(* Each ParamGroupPayload in turn, at the values the message it names is checked at *)
CheckedParamgrouppayload2 ==
    { [tag |-> UnitSequencesParamGroupCode2, body |-> one] : one \in CheckedUnitSequencesParamGroup2 }
        \cup { [tag |-> ReturnBitfieldsParamGroupCode2, body |-> one] : one \in CheckedReturnBitfieldsParamGroup2 }

(***************************************************************************)
(* Param Group                                                             *)
(***************************************************************************)

ParamGroup2 ==
    [ paramGroupLength  : Sample(2),
      paramgrouppayload : Paramgrouppayload2 ]

EncodeParamGroup2(message) ==
    message.paramGroupLength
        \o EncodeUIntBE(message.paramgrouppayload.tag, 1)
        \o EncodeParamgrouppayload2(message.paramgrouppayload)

DecodeParamGroup2(bytes) ==
    LET paramGroupLength == ReadBytes(bytes, 2) IN IF ~paramGroupLength.ok THEN Fail ELSE
    LET paramGroupType == ReadUIntBE(paramGroupLength.rest, 1) IN IF ~paramGroupType.ok THEN Fail ELSE
    LET paramgrouppayload == DecodeParamgrouppayload2(paramGroupType.value, paramGroupType.rest) IN IF ~paramgrouppayload.ok THEN Fail ELSE
    Ok([ paramGroupLength  |-> paramGroupLength.value,
         paramgrouppayload |-> paramgrouppayload.value ], paramgrouppayload.rest)

ZeroParamGroup2 ==
    [ paramGroupLength  |-> [i \in 1 .. 2 |-> 0],
      paramgrouppayload |-> ZeroParamgrouppayload2 ]

(* Param Group at zero, then each field in turn at the values it is checked at *)
CheckedParamGroup2 ==
    { ZeroParamGroup2 }
        \cup { [ZeroParamGroup2 EXCEPT !.paramGroupLength = one] : one \in Sample(2) }
        \cup { [ZeroParamGroup2 EXCEPT !.paramgrouppayload = one] : one \in CheckedParamgrouppayload2 }

(* A run of Param Group, written one after another *)
RECURSIVE EncodeParamGroup2List(_)
EncodeParamGroup2List(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeParamGroup2(Head(messages)) \o EncodeParamGroup2List(Tail(messages))

(* As many Param Group as the field that counts them says *)
RECURSIVE ReadParamGroup2List(_, _)
ReadParamGroup2List(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeParamGroup2(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadParamGroup2List(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Param Group of each kind, for the lists that carry them *)
OneParamGroup2 ==
    { [ZeroParamGroup2 EXCEPT !.paramgrouppayload = [tag |-> UnitSequencesParamGroupCode2, body |-> ZeroUnitSequencesParamGroup2]],
      [ZeroParamGroup2 EXCEPT !.paramgrouppayload = [tag |-> ReturnBitfieldsParamGroupCode2, body |-> ZeroReturnBitfieldsParamGroup2]] }

(***************************************************************************)
(* Login Response V 2 Message                                              *)
(***************************************************************************)

LoginResponseV2Message ==
    [ loginResponseStatus        : Sample(1),
      loginResponseText          : Sample(60),
      noUnspecifiedUnitReplay    : Sample(1),
      lastReceivedSequenceNumber : Sample(4),
      units                      : SampleLists(OneUnits2),
      paramGroup                 : SampleLists(OneParamGroup2) ]

EncodeLoginResponseV2Message(message) ==
    message.loginResponseStatus
        \o message.loginResponseText
        \o message.noUnspecifiedUnitReplay
        \o message.lastReceivedSequenceNumber
        \o EncodeUIntBE(Len(message.units), 1)
        \o EncodeUnits2List(message.units)
        \o EncodeUIntBE(Len(message.paramGroup), 1)
        \o EncodeParamGroup2List(message.paramGroup)

DecodeLoginResponseV2Message(bytes) ==
    LET loginResponseStatus == ReadBytes(bytes, 1) IN IF ~loginResponseStatus.ok THEN Fail ELSE
    LET loginResponseText == ReadBytes(loginResponseStatus.rest, 60) IN IF ~loginResponseText.ok THEN Fail ELSE
    LET noUnspecifiedUnitReplay == ReadBytes(loginResponseText.rest, 1) IN IF ~noUnspecifiedUnitReplay.ok THEN Fail ELSE
    LET lastReceivedSequenceNumber == ReadBytes(noUnspecifiedUnitReplay.rest, 4) IN IF ~lastReceivedSequenceNumber.ok THEN Fail ELSE
    LET numberOfUnits == ReadUIntBE(lastReceivedSequenceNumber.rest, 1) IN IF ~numberOfUnits.ok THEN Fail ELSE
    LET units == ReadUnits2List(numberOfUnits.rest, numberOfUnits.value) IN IF ~units.ok THEN Fail ELSE
    LET numberOfParamGroups == ReadUIntBE(units.rest, 1) IN IF ~numberOfParamGroups.ok THEN Fail ELSE
    LET paramGroup == ReadParamGroup2List(numberOfParamGroups.rest, numberOfParamGroups.value) IN IF ~paramGroup.ok THEN Fail ELSE
    Ok([ loginResponseStatus        |-> loginResponseStatus.value,
         loginResponseText          |-> loginResponseText.value,
         noUnspecifiedUnitReplay    |-> noUnspecifiedUnitReplay.value,
         lastReceivedSequenceNumber |-> lastReceivedSequenceNumber.value,
         units                      |-> units.value,
         paramGroup                 |-> paramGroup.value ], paramGroup.rest)

ZeroLoginResponseV2Message ==
    [ loginResponseStatus        |-> [i \in 1 .. 1 |-> 0],
      loginResponseText          |-> [i \in 1 .. 60 |-> 0],
      noUnspecifiedUnitReplay    |-> [i \in 1 .. 1 |-> 0],
      lastReceivedSequenceNumber |-> [i \in 1 .. 4 |-> 0],
      units                      |-> << >>,
      paramGroup                 |-> << >> ]

(* Login Response V 2 Message at zero, then each field in turn at the values it is checked at *)
CheckedLoginResponseV2Message ==
    { ZeroLoginResponseV2Message }
        \cup { [ZeroLoginResponseV2Message EXCEPT !.loginResponseStatus = one] : one \in Sample(1) }
        \cup { [ZeroLoginResponseV2Message EXCEPT !.loginResponseText = one] : one \in Sample(60) }
        \cup { [ZeroLoginResponseV2Message EXCEPT !.noUnspecifiedUnitReplay = one] : one \in Sample(1) }
        \cup { [ZeroLoginResponseV2Message EXCEPT !.lastReceivedSequenceNumber = one] : one \in Sample(4) }
        \cup { [ZeroLoginResponseV2Message EXCEPT !.units = one] : one \in SampleLists(OneUnits2) }
        \cup { [ZeroLoginResponseV2Message EXCEPT !.paramGroup = one] : one \in SampleLists(OneParamGroup2) }

(***************************************************************************)
(* Units: 5 bytes                                                          *)
(***************************************************************************)

Units4 ==
    [ unitNumber   : Sample(1),
      unitSequence : Sample(4) ]

EncodeUnits4(message) ==
    message.unitNumber
        \o message.unitSequence

DecodeUnits4(bytes) ==
    LET unitNumber == ReadBytes(bytes, 1) IN IF ~unitNumber.ok THEN Fail ELSE
    LET unitSequence == ReadBytes(unitNumber.rest, 4) IN IF ~unitSequence.ok THEN Fail ELSE
    Ok([ unitNumber   |-> unitNumber.value,
         unitSequence |-> unitSequence.value ], unitSequence.rest)

ZeroUnits4 ==
    [ unitNumber   |-> [i \in 1 .. 1 |-> 0],
      unitSequence |-> [i \in 1 .. 4 |-> 0] ]

(* Units at zero, then each field in turn at the values it is checked at *)
CheckedUnits4 ==
    { ZeroUnits4 }
        \cup { [ZeroUnits4 EXCEPT !.unitNumber = one] : one \in Sample(1) }
        \cup { [ZeroUnits4 EXCEPT !.unitSequence = one] : one \in Sample(4) }

(* A run of Units, written one after another *)
RECURSIVE EncodeUnits4List(_)
EncodeUnits4List(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeUnits4(Head(messages)) \o EncodeUnits4List(Tail(messages))

(* As many Units as the field that counts them says *)
RECURSIVE ReadUnits4List(_, _)
ReadUnits4List(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeUnits4(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadUnits4List(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Units of each kind, for the lists that carry them *)
OneUnits4 == { ZeroUnits4 }

(***************************************************************************)
(* Logout Message                                                          *)
(***************************************************************************)

LogoutMessage ==
    [ logoutReason               : Sample(1),
      logoutReasonText           : Sample(60),
      lastReceivedSequenceNumber : Sample(4),
      units                      : SampleLists(OneUnits4) ]

EncodeLogoutMessage(message) ==
    message.logoutReason
        \o message.logoutReasonText
        \o message.lastReceivedSequenceNumber
        \o EncodeUIntBE(Len(message.units), 1)
        \o EncodeUnits4List(message.units)

DecodeLogoutMessage(bytes) ==
    LET logoutReason == ReadBytes(bytes, 1) IN IF ~logoutReason.ok THEN Fail ELSE
    LET logoutReasonText == ReadBytes(logoutReason.rest, 60) IN IF ~logoutReasonText.ok THEN Fail ELSE
    LET lastReceivedSequenceNumber == ReadBytes(logoutReasonText.rest, 4) IN IF ~lastReceivedSequenceNumber.ok THEN Fail ELSE
    LET numberOfUnits == ReadUIntBE(lastReceivedSequenceNumber.rest, 1) IN IF ~numberOfUnits.ok THEN Fail ELSE
    LET units == ReadUnits4List(numberOfUnits.rest, numberOfUnits.value) IN IF ~units.ok THEN Fail ELSE
    Ok([ logoutReason               |-> logoutReason.value,
         logoutReasonText           |-> logoutReasonText.value,
         lastReceivedSequenceNumber |-> lastReceivedSequenceNumber.value,
         units                      |-> units.value ], units.rest)

ZeroLogoutMessage ==
    [ logoutReason               |-> [i \in 1 .. 1 |-> 0],
      logoutReasonText           |-> [i \in 1 .. 60 |-> 0],
      lastReceivedSequenceNumber |-> [i \in 1 .. 4 |-> 0],
      units                      |-> << >> ]

(* Logout Message at zero, then each field in turn at the values it is checked at *)
CheckedLogoutMessage ==
    { ZeroLogoutMessage }
        \cup { [ZeroLogoutMessage EXCEPT !.logoutReason = one] : one \in Sample(1) }
        \cup { [ZeroLogoutMessage EXCEPT !.logoutReasonText = one] : one \in Sample(60) }
        \cup { [ZeroLogoutMessage EXCEPT !.lastReceivedSequenceNumber = one] : one \in Sample(4) }
        \cup { [ZeroLogoutMessage EXCEPT !.units = one] : one \in SampleLists(OneUnits4) }

(***************************************************************************)
(* New Order V 2 Message                                                   *)
(***************************************************************************)

NewOrderV2Message ==
    [ clOrdId                     : Sample(20),
      side                        : Sample(1),
      orderQty                    : Sample(4),
      numberOfNewOrderV2Bitfields : 0 .. 255,
      newOrderV2Bitfield1         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      newOrderV2Bitfield2         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      newOrderV2Bitfield3         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      newOrderV2Bitfield4         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      newOrderV2Bitfield5         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      newOrderV2Bitfield6         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      newOrderV2Bitfield7         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      newOrderV2Bitfield8         : { << >> } \cup { <<held>> : held \in Sample(1) },
      newOrderV2Bitfield9         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      clearingFirm                : { << >> } \cup { <<held>> : held \in Sample(4) },
      clearingAccount             : { << >> } \cup { <<held>> : held \in Sample(4) },
      price                       : { << >> } \cup { <<held>> : held \in Sample(8) },
      ordType                     : { << >> } \cup { <<held>> : held \in Sample(1) },
      timeInForce                 : { << >> } \cup { <<held>> : held \in Sample(1) },
      minQty                      : { << >> } \cup { <<held>> : held \in Sample(4) },
      symbolLong                  : { << >> } \cup { <<held>> : held \in Sample(8) },
      idSource                    : { << >> } \cup { <<held>> : held \in Sample(1) },
      securityId                  : { << >> } \cup { <<held>> : held \in Sample(16) },
      capacity                    : { << >> } \cup { <<held>> : held \in Sample(1) },
      account                     : { << >> } \cup { <<held>> : held \in Sample(16) },
      preventMatch                : { << >> } \cup { <<held>> : held \in Sample(3) },
      expireTime                  : { << >> } \cup { <<held>> : held \in Sample(8) },
      riskReset                   : { << >> } \cup { <<held>> : held \in Sample(8) },
      openClose                   : { << >> } \cup { <<held>> : held \in Sample(1) },
      liquidityProvision          : { << >> } \cup { <<held>> : held \in Sample(1) },
      extExecInst                 : { << >> } \cup { <<held>> : held \in Sample(1) },
      clientId                    : { << >> } \cup { <<held>> : held \in Sample(4) },
      investorId                  : { << >> } \cup { <<held>> : held \in Sample(4) },
      executorId                  : { << >> } \cup { <<held>> : held \in Sample(4) },
      orderOrigination            : { << >> } \cup { <<held>> : held \in Sample(1) },
      stopPx                      : { << >> } \cup { <<held>> : held \in Sample(8) },
      auctionId                   : { << >> } \cup { <<held>> : held \in Sample(8) },
      algorithmicIndicator        : { << >> } \cup { <<held>> : held \in Sample(1) },
      customGroupId               : { << >> } \cup { <<held>> : held \in Sample(2) },
      clientQualifiedRole         : { << >> } \cup { <<held>> : held \in Sample(1) },
      investorQualifiedRole       : { << >> } \cup { <<held>> : held \in Sample(1) },
      executorQualifiedRole       : { << >> } \cup { <<held>> : held \in Sample(1) },
      custOrderHandlingInst       : { << >> } \cup { <<held>> : held \in Sample(1) },
      accountType                 : { << >> } \cup { <<held>> : held \in Sample(1) },
      drillThruProtection         : { << >> } \cup { <<held>> : held \in Sample(8) } ]

EncodeNewOrderV2Message(message) ==
    message.clOrdId
        \o message.side
        \o message.orderQty
        \o EncodeUIntBE(message.numberOfNewOrderV2Bitfields, 1)
        \o (IF message.newOrderV2Bitfield1 = << >> THEN << >> ELSE EncodeUIntLE(message.newOrderV2Bitfield1[1], 1))
        \o (IF message.newOrderV2Bitfield2 = << >> THEN << >> ELSE EncodeUIntLE(message.newOrderV2Bitfield2[1], 1))
        \o (IF message.newOrderV2Bitfield3 = << >> THEN << >> ELSE EncodeUIntLE(message.newOrderV2Bitfield3[1], 1))
        \o (IF message.newOrderV2Bitfield4 = << >> THEN << >> ELSE EncodeUIntLE(message.newOrderV2Bitfield4[1], 1))
        \o (IF message.newOrderV2Bitfield5 = << >> THEN << >> ELSE EncodeUIntLE(message.newOrderV2Bitfield5[1], 1))
        \o (IF message.newOrderV2Bitfield6 = << >> THEN << >> ELSE EncodeUIntLE(message.newOrderV2Bitfield6[1], 1))
        \o (IF message.newOrderV2Bitfield7 = << >> THEN << >> ELSE EncodeUIntLE(message.newOrderV2Bitfield7[1], 1))
        \o (IF message.newOrderV2Bitfield8 = << >> THEN << >> ELSE message.newOrderV2Bitfield8[1])
        \o (IF message.newOrderV2Bitfield9 = << >> THEN << >> ELSE EncodeUIntLE(message.newOrderV2Bitfield9[1], 1))
        \o (IF message.clearingFirm = << >> THEN << >> ELSE message.clearingFirm[1])
        \o (IF message.clearingAccount = << >> THEN << >> ELSE message.clearingAccount[1])
        \o (IF message.price = << >> THEN << >> ELSE message.price[1])
        \o (IF message.ordType = << >> THEN << >> ELSE message.ordType[1])
        \o (IF message.timeInForce = << >> THEN << >> ELSE message.timeInForce[1])
        \o (IF message.minQty = << >> THEN << >> ELSE message.minQty[1])
        \o (IF message.symbolLong = << >> THEN << >> ELSE message.symbolLong[1])
        \o (IF message.idSource = << >> THEN << >> ELSE message.idSource[1])
        \o (IF message.securityId = << >> THEN << >> ELSE message.securityId[1])
        \o (IF message.capacity = << >> THEN << >> ELSE message.capacity[1])
        \o (IF message.account = << >> THEN << >> ELSE message.account[1])
        \o (IF message.preventMatch = << >> THEN << >> ELSE message.preventMatch[1])
        \o (IF message.expireTime = << >> THEN << >> ELSE message.expireTime[1])
        \o (IF message.riskReset = << >> THEN << >> ELSE message.riskReset[1])
        \o (IF message.openClose = << >> THEN << >> ELSE message.openClose[1])
        \o (IF message.liquidityProvision = << >> THEN << >> ELSE message.liquidityProvision[1])
        \o (IF message.extExecInst = << >> THEN << >> ELSE message.extExecInst[1])
        \o (IF message.clientId = << >> THEN << >> ELSE message.clientId[1])
        \o (IF message.investorId = << >> THEN << >> ELSE message.investorId[1])
        \o (IF message.executorId = << >> THEN << >> ELSE message.executorId[1])
        \o (IF message.orderOrigination = << >> THEN << >> ELSE message.orderOrigination[1])
        \o (IF message.stopPx = << >> THEN << >> ELSE message.stopPx[1])
        \o (IF message.auctionId = << >> THEN << >> ELSE message.auctionId[1])
        \o (IF message.algorithmicIndicator = << >> THEN << >> ELSE message.algorithmicIndicator[1])
        \o (IF message.customGroupId = << >> THEN << >> ELSE message.customGroupId[1])
        \o (IF message.clientQualifiedRole = << >> THEN << >> ELSE message.clientQualifiedRole[1])
        \o (IF message.investorQualifiedRole = << >> THEN << >> ELSE message.investorQualifiedRole[1])
        \o (IF message.executorQualifiedRole = << >> THEN << >> ELSE message.executorQualifiedRole[1])
        \o (IF message.custOrderHandlingInst = << >> THEN << >> ELSE message.custOrderHandlingInst[1])
        \o (IF message.accountType = << >> THEN << >> ELSE message.accountType[1])
        \o (IF message.drillThruProtection = << >> THEN << >> ELSE message.drillThruProtection[1])

DecodeNewOrderV2Message(bytes) ==
    LET clOrdId == ReadBytes(bytes, 20) IN IF ~clOrdId.ok THEN Fail ELSE
    LET side == ReadBytes(clOrdId.rest, 1) IN IF ~side.ok THEN Fail ELSE
    LET orderQty == ReadBytes(side.rest, 4) IN IF ~orderQty.ok THEN Fail ELSE
    LET numberOfNewOrderV2Bitfields == ReadUIntBE(orderQty.rest, 1) IN IF ~numberOfNewOrderV2Bitfields.ok THEN Fail ELSE
    LET newOrderV2Bitfield1 == ReadWhen(numberOfNewOrderV2Bitfields.value >= 1, ReadUIntLE(numberOfNewOrderV2Bitfields.rest, 1), numberOfNewOrderV2Bitfields.rest) IN IF ~newOrderV2Bitfield1.ok THEN Fail ELSE
    LET newOrderV2Bitfield2 == ReadWhen(numberOfNewOrderV2Bitfields.value >= 2, ReadUIntLE(newOrderV2Bitfield1.rest, 1), newOrderV2Bitfield1.rest) IN IF ~newOrderV2Bitfield2.ok THEN Fail ELSE
    LET newOrderV2Bitfield3 == ReadWhen(numberOfNewOrderV2Bitfields.value >= 3, ReadUIntLE(newOrderV2Bitfield2.rest, 1), newOrderV2Bitfield2.rest) IN IF ~newOrderV2Bitfield3.ok THEN Fail ELSE
    LET newOrderV2Bitfield4 == ReadWhen(numberOfNewOrderV2Bitfields.value >= 4, ReadUIntLE(newOrderV2Bitfield3.rest, 1), newOrderV2Bitfield3.rest) IN IF ~newOrderV2Bitfield4.ok THEN Fail ELSE
    LET newOrderV2Bitfield5 == ReadWhen(numberOfNewOrderV2Bitfields.value >= 5, ReadUIntLE(newOrderV2Bitfield4.rest, 1), newOrderV2Bitfield4.rest) IN IF ~newOrderV2Bitfield5.ok THEN Fail ELSE
    LET newOrderV2Bitfield6 == ReadWhen(numberOfNewOrderV2Bitfields.value >= 6, ReadUIntLE(newOrderV2Bitfield5.rest, 1), newOrderV2Bitfield5.rest) IN IF ~newOrderV2Bitfield6.ok THEN Fail ELSE
    LET newOrderV2Bitfield7 == ReadWhen(numberOfNewOrderV2Bitfields.value >= 7, ReadUIntLE(newOrderV2Bitfield6.rest, 1), newOrderV2Bitfield6.rest) IN IF ~newOrderV2Bitfield7.ok THEN Fail ELSE
    LET newOrderV2Bitfield8 == ReadWhen(numberOfNewOrderV2Bitfields.value >= 8, ReadBytes(newOrderV2Bitfield7.rest, 1), newOrderV2Bitfield7.rest) IN IF ~newOrderV2Bitfield8.ok THEN Fail ELSE
    LET newOrderV2Bitfield9 == ReadWhen(numberOfNewOrderV2Bitfields.value >= 9, ReadUIntLE(newOrderV2Bitfield8.rest, 1), newOrderV2Bitfield8.rest) IN IF ~newOrderV2Bitfield9.ok THEN Fail ELSE
    LET clearingFirm == ReadWhen(numberOfNewOrderV2Bitfields.value >= 1 /\ (newOrderV2Bitfield1.value # << >> /\ newOrderV2Bitfield1.value[1] % 2 > 0), ReadBytes(newOrderV2Bitfield9.rest, 4), newOrderV2Bitfield9.rest) IN IF ~clearingFirm.ok THEN Fail ELSE
    LET clearingAccount == ReadWhen(numberOfNewOrderV2Bitfields.value >= 1 /\ (newOrderV2Bitfield1.value # << >> /\ (newOrderV2Bitfield1.value[1] \div 2) % 2 > 0), ReadBytes(clearingFirm.rest, 4), clearingFirm.rest) IN IF ~clearingAccount.ok THEN Fail ELSE
    LET price == ReadWhen(numberOfNewOrderV2Bitfields.value >= 1 /\ (newOrderV2Bitfield1.value # << >> /\ (newOrderV2Bitfield1.value[1] \div 4) % 2 > 0), ReadBytes(clearingAccount.rest, 8), clearingAccount.rest) IN IF ~price.ok THEN Fail ELSE
    LET ordType == ReadWhen(numberOfNewOrderV2Bitfields.value >= 1 /\ (newOrderV2Bitfield1.value # << >> /\ (newOrderV2Bitfield1.value[1] \div 16) % 2 > 0), ReadBytes(price.rest, 1), price.rest) IN IF ~ordType.ok THEN Fail ELSE
    LET timeInForce == ReadWhen(numberOfNewOrderV2Bitfields.value >= 1 /\ (newOrderV2Bitfield1.value # << >> /\ (newOrderV2Bitfield1.value[1] \div 32) % 2 > 0), ReadBytes(ordType.rest, 1), ordType.rest) IN IF ~timeInForce.ok THEN Fail ELSE
    LET minQty == ReadWhen(numberOfNewOrderV2Bitfields.value >= 1 /\ (newOrderV2Bitfield1.value # << >> /\ (newOrderV2Bitfield1.value[1] \div 64) % 2 > 0), ReadBytes(timeInForce.rest, 4), timeInForce.rest) IN IF ~minQty.ok THEN Fail ELSE
    LET symbolLong == ReadWhen(numberOfNewOrderV2Bitfields.value >= 2 /\ (newOrderV2Bitfield2.value # << >> /\ newOrderV2Bitfield2.value[1] % 2 > 0), ReadBytes(minQty.rest, 8), minQty.rest) IN IF ~symbolLong.ok THEN Fail ELSE
    LET idSource == ReadWhen(numberOfNewOrderV2Bitfields.value >= 2 /\ (newOrderV2Bitfield2.value # << >> /\ (newOrderV2Bitfield2.value[1] \div 8) % 2 > 0), ReadBytes(symbolLong.rest, 1), symbolLong.rest) IN IF ~idSource.ok THEN Fail ELSE
    LET securityId == ReadWhen(numberOfNewOrderV2Bitfields.value >= 2 /\ (newOrderV2Bitfield2.value # << >> /\ (newOrderV2Bitfield2.value[1] \div 16) % 2 > 0), ReadBytes(idSource.rest, 16), idSource.rest) IN IF ~securityId.ok THEN Fail ELSE
    LET capacity == ReadWhen(numberOfNewOrderV2Bitfields.value >= 2 /\ (newOrderV2Bitfield2.value # << >> /\ (newOrderV2Bitfield2.value[1] \div 64) % 2 > 0), ReadBytes(securityId.rest, 1), securityId.rest) IN IF ~capacity.ok THEN Fail ELSE
    LET account == ReadWhen(numberOfNewOrderV2Bitfields.value >= 3 /\ (newOrderV2Bitfield3.value # << >> /\ newOrderV2Bitfield3.value[1] % 2 > 0), ReadBytes(capacity.rest, 16), capacity.rest) IN IF ~account.ok THEN Fail ELSE
    LET preventMatch == ReadWhen(numberOfNewOrderV2Bitfields.value >= 3 /\ (newOrderV2Bitfield3.value # << >> /\ (newOrderV2Bitfield3.value[1] \div 32) % 2 > 0), ReadBytes(account.rest, 3), account.rest) IN IF ~preventMatch.ok THEN Fail ELSE
    LET expireTime == ReadWhen(numberOfNewOrderV2Bitfields.value >= 3 /\ (newOrderV2Bitfield3.value # << >> /\ (newOrderV2Bitfield3.value[1] \div 128) % 2 > 0), ReadBytes(preventMatch.rest, 8), preventMatch.rest) IN IF ~expireTime.ok THEN Fail ELSE
    LET riskReset == ReadWhen(numberOfNewOrderV2Bitfields.value >= 4 /\ (newOrderV2Bitfield4.value # << >> /\ (newOrderV2Bitfield4.value[1] \div 8) % 2 > 0), ReadBytes(expireTime.rest, 8), expireTime.rest) IN IF ~riskReset.ok THEN Fail ELSE
    LET openClose == ReadWhen(numberOfNewOrderV2Bitfields.value >= 4 /\ (newOrderV2Bitfield4.value # << >> /\ (newOrderV2Bitfield4.value[1] \div 16) % 2 > 0), ReadBytes(riskReset.rest, 1), riskReset.rest) IN IF ~openClose.ok THEN Fail ELSE
    LET liquidityProvision == ReadWhen(numberOfNewOrderV2Bitfields.value >= 4 /\ (newOrderV2Bitfield4.value # << >> /\ (newOrderV2Bitfield4.value[1] \div 128) % 2 > 0), ReadBytes(openClose.rest, 1), openClose.rest) IN IF ~liquidityProvision.ok THEN Fail ELSE
    LET extExecInst == ReadWhen(numberOfNewOrderV2Bitfields.value >= 5 /\ (newOrderV2Bitfield5.value # << >> /\ (newOrderV2Bitfield5.value[1] \div 8) % 2 > 0), ReadBytes(liquidityProvision.rest, 1), liquidityProvision.rest) IN IF ~extExecInst.ok THEN Fail ELSE
    LET clientId == ReadWhen(numberOfNewOrderV2Bitfields.value >= 5 /\ (newOrderV2Bitfield5.value # << >> /\ (newOrderV2Bitfield5.value[1] \div 16) % 2 > 0), ReadBytes(extExecInst.rest, 4), extExecInst.rest) IN IF ~clientId.ok THEN Fail ELSE
    LET investorId == ReadWhen(numberOfNewOrderV2Bitfields.value >= 5 /\ (newOrderV2Bitfield5.value # << >> /\ (newOrderV2Bitfield5.value[1] \div 32) % 2 > 0), ReadBytes(clientId.rest, 4), clientId.rest) IN IF ~investorId.ok THEN Fail ELSE
    LET executorId == ReadWhen(numberOfNewOrderV2Bitfields.value >= 5 /\ (newOrderV2Bitfield5.value # << >> /\ (newOrderV2Bitfield5.value[1] \div 64) % 2 > 0), ReadBytes(investorId.rest, 4), investorId.rest) IN IF ~executorId.ok THEN Fail ELSE
    LET orderOrigination == ReadWhen(numberOfNewOrderV2Bitfields.value >= 5 /\ (newOrderV2Bitfield5.value # << >> /\ (newOrderV2Bitfield5.value[1] \div 128) % 2 > 0), ReadBytes(executorId.rest, 1), executorId.rest) IN IF ~orderOrigination.ok THEN Fail ELSE
    LET stopPx == ReadWhen(numberOfNewOrderV2Bitfields.value >= 6 /\ (newOrderV2Bitfield6.value # << >> /\ (newOrderV2Bitfield6.value[1] \div 2) % 2 > 0), ReadBytes(orderOrigination.rest, 8), orderOrigination.rest) IN IF ~stopPx.ok THEN Fail ELSE
    LET auctionId == ReadWhen(numberOfNewOrderV2Bitfields.value >= 6 /\ (newOrderV2Bitfield6.value # << >> /\ (newOrderV2Bitfield6.value[1] \div 64) % 2 > 0), ReadBytes(stopPx.rest, 8), stopPx.rest) IN IF ~auctionId.ok THEN Fail ELSE
    LET algorithmicIndicator == ReadWhen(numberOfNewOrderV2Bitfields.value >= 7 /\ (newOrderV2Bitfield7.value # << >> /\ newOrderV2Bitfield7.value[1] % 2 > 0), ReadBytes(auctionId.rest, 1), auctionId.rest) IN IF ~algorithmicIndicator.ok THEN Fail ELSE
    LET customGroupId == ReadWhen(numberOfNewOrderV2Bitfields.value >= 7 /\ (newOrderV2Bitfield7.value # << >> /\ (newOrderV2Bitfield7.value[1] \div 2) % 2 > 0), ReadBytes(algorithmicIndicator.rest, 2), algorithmicIndicator.rest) IN IF ~customGroupId.ok THEN Fail ELSE
    LET clientQualifiedRole == ReadWhen(numberOfNewOrderV2Bitfields.value >= 7 /\ (newOrderV2Bitfield7.value # << >> /\ (newOrderV2Bitfield7.value[1] \div 4) % 2 > 0), ReadBytes(customGroupId.rest, 1), customGroupId.rest) IN IF ~clientQualifiedRole.ok THEN Fail ELSE
    LET investorQualifiedRole == ReadWhen(numberOfNewOrderV2Bitfields.value >= 7 /\ (newOrderV2Bitfield7.value # << >> /\ (newOrderV2Bitfield7.value[1] \div 8) % 2 > 0), ReadBytes(clientQualifiedRole.rest, 1), clientQualifiedRole.rest) IN IF ~investorQualifiedRole.ok THEN Fail ELSE
    LET executorQualifiedRole == ReadWhen(numberOfNewOrderV2Bitfields.value >= 7 /\ (newOrderV2Bitfield7.value # << >> /\ (newOrderV2Bitfield7.value[1] \div 16) % 2 > 0), ReadBytes(investorQualifiedRole.rest, 1), investorQualifiedRole.rest) IN IF ~executorQualifiedRole.ok THEN Fail ELSE
    LET custOrderHandlingInst == ReadWhen(numberOfNewOrderV2Bitfields.value >= 9 /\ (newOrderV2Bitfield9.value # << >> /\ (newOrderV2Bitfield9.value[1] \div 16) % 2 > 0), ReadBytes(executorQualifiedRole.rest, 1), executorQualifiedRole.rest) IN IF ~custOrderHandlingInst.ok THEN Fail ELSE
    LET accountType == ReadWhen(numberOfNewOrderV2Bitfields.value >= 9 /\ (newOrderV2Bitfield9.value # << >> /\ (newOrderV2Bitfield9.value[1] \div 32) % 2 > 0), ReadBytes(custOrderHandlingInst.rest, 1), custOrderHandlingInst.rest) IN IF ~accountType.ok THEN Fail ELSE
    LET drillThruProtection == ReadWhen(numberOfNewOrderV2Bitfields.value >= 9 /\ (newOrderV2Bitfield9.value # << >> /\ (newOrderV2Bitfield9.value[1] \div 128) % 2 > 0), ReadBytes(accountType.rest, 8), accountType.rest) IN IF ~drillThruProtection.ok THEN Fail ELSE
    Ok([ clOrdId                     |-> clOrdId.value,
         side                        |-> side.value,
         orderQty                    |-> orderQty.value,
         numberOfNewOrderV2Bitfields |-> numberOfNewOrderV2Bitfields.value,
         newOrderV2Bitfield1         |-> newOrderV2Bitfield1.value,
         newOrderV2Bitfield2         |-> newOrderV2Bitfield2.value,
         newOrderV2Bitfield3         |-> newOrderV2Bitfield3.value,
         newOrderV2Bitfield4         |-> newOrderV2Bitfield4.value,
         newOrderV2Bitfield5         |-> newOrderV2Bitfield5.value,
         newOrderV2Bitfield6         |-> newOrderV2Bitfield6.value,
         newOrderV2Bitfield7         |-> newOrderV2Bitfield7.value,
         newOrderV2Bitfield8         |-> newOrderV2Bitfield8.value,
         newOrderV2Bitfield9         |-> newOrderV2Bitfield9.value,
         clearingFirm                |-> clearingFirm.value,
         clearingAccount             |-> clearingAccount.value,
         price                       |-> price.value,
         ordType                     |-> ordType.value,
         timeInForce                 |-> timeInForce.value,
         minQty                      |-> minQty.value,
         symbolLong                  |-> symbolLong.value,
         idSource                    |-> idSource.value,
         securityId                  |-> securityId.value,
         capacity                    |-> capacity.value,
         account                     |-> account.value,
         preventMatch                |-> preventMatch.value,
         expireTime                  |-> expireTime.value,
         riskReset                   |-> riskReset.value,
         openClose                   |-> openClose.value,
         liquidityProvision          |-> liquidityProvision.value,
         extExecInst                 |-> extExecInst.value,
         clientId                    |-> clientId.value,
         investorId                  |-> investorId.value,
         executorId                  |-> executorId.value,
         orderOrigination            |-> orderOrigination.value,
         stopPx                      |-> stopPx.value,
         auctionId                   |-> auctionId.value,
         algorithmicIndicator        |-> algorithmicIndicator.value,
         customGroupId               |-> customGroupId.value,
         clientQualifiedRole         |-> clientQualifiedRole.value,
         investorQualifiedRole       |-> investorQualifiedRole.value,
         executorQualifiedRole       |-> executorQualifiedRole.value,
         custOrderHandlingInst       |-> custOrderHandlingInst.value,
         accountType                 |-> accountType.value,
         drillThruProtection         |-> drillThruProtection.value ], drillThruProtection.rest)

(* New Order V 2 Message with each field marked present by fields before it there exactly where they say *)
SettleNewOrderV2Message(message) ==
    LET settled1 == [message EXCEPT !.newOrderV2Bitfield1 = IF message.numberOfNewOrderV2Bitfields >= 1 THEN (IF message.newOrderV2Bitfield1 = << >> THEN <<0>> ELSE message.newOrderV2Bitfield1) ELSE << >>]
        settled2 == [settled1 EXCEPT !.newOrderV2Bitfield2 = IF settled1.numberOfNewOrderV2Bitfields >= 2 THEN (IF settled1.newOrderV2Bitfield2 = << >> THEN <<0>> ELSE settled1.newOrderV2Bitfield2) ELSE << >>]
        settled3 == [settled2 EXCEPT !.newOrderV2Bitfield3 = IF settled2.numberOfNewOrderV2Bitfields >= 3 THEN (IF settled2.newOrderV2Bitfield3 = << >> THEN <<0>> ELSE settled2.newOrderV2Bitfield3) ELSE << >>]
        settled4 == [settled3 EXCEPT !.newOrderV2Bitfield4 = IF settled3.numberOfNewOrderV2Bitfields >= 4 THEN (IF settled3.newOrderV2Bitfield4 = << >> THEN <<0>> ELSE settled3.newOrderV2Bitfield4) ELSE << >>]
        settled5 == [settled4 EXCEPT !.newOrderV2Bitfield5 = IF settled4.numberOfNewOrderV2Bitfields >= 5 THEN (IF settled4.newOrderV2Bitfield5 = << >> THEN <<0>> ELSE settled4.newOrderV2Bitfield5) ELSE << >>]
        settled6 == [settled5 EXCEPT !.newOrderV2Bitfield6 = IF settled5.numberOfNewOrderV2Bitfields >= 6 THEN (IF settled5.newOrderV2Bitfield6 = << >> THEN <<0>> ELSE settled5.newOrderV2Bitfield6) ELSE << >>]
        settled7 == [settled6 EXCEPT !.newOrderV2Bitfield7 = IF settled6.numberOfNewOrderV2Bitfields >= 7 THEN (IF settled6.newOrderV2Bitfield7 = << >> THEN <<0>> ELSE settled6.newOrderV2Bitfield7) ELSE << >>]
        settled8 == [settled7 EXCEPT !.newOrderV2Bitfield8 = IF settled7.numberOfNewOrderV2Bitfields >= 8 THEN (IF settled7.newOrderV2Bitfield8 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled7.newOrderV2Bitfield8) ELSE << >>]
        settled9 == [settled8 EXCEPT !.newOrderV2Bitfield9 = IF settled8.numberOfNewOrderV2Bitfields >= 9 THEN (IF settled8.newOrderV2Bitfield9 = << >> THEN <<0>> ELSE settled8.newOrderV2Bitfield9) ELSE << >>]
        settled10 == [settled9 EXCEPT !.clearingFirm = IF settled9.numberOfNewOrderV2Bitfields >= 1 /\ (settled9.newOrderV2Bitfield1 # << >> /\ settled9.newOrderV2Bitfield1[1] % 2 > 0) THEN (IF settled9.clearingFirm = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled9.clearingFirm) ELSE << >>]
        settled11 == [settled10 EXCEPT !.clearingAccount = IF settled10.numberOfNewOrderV2Bitfields >= 1 /\ (settled10.newOrderV2Bitfield1 # << >> /\ (settled10.newOrderV2Bitfield1[1] \div 2) % 2 > 0) THEN (IF settled10.clearingAccount = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled10.clearingAccount) ELSE << >>]
        settled12 == [settled11 EXCEPT !.price = IF settled11.numberOfNewOrderV2Bitfields >= 1 /\ (settled11.newOrderV2Bitfield1 # << >> /\ (settled11.newOrderV2Bitfield1[1] \div 4) % 2 > 0) THEN (IF settled11.price = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled11.price) ELSE << >>]
        settled13 == [settled12 EXCEPT !.ordType = IF settled12.numberOfNewOrderV2Bitfields >= 1 /\ (settled12.newOrderV2Bitfield1 # << >> /\ (settled12.newOrderV2Bitfield1[1] \div 16) % 2 > 0) THEN (IF settled12.ordType = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled12.ordType) ELSE << >>]
        settled14 == [settled13 EXCEPT !.timeInForce = IF settled13.numberOfNewOrderV2Bitfields >= 1 /\ (settled13.newOrderV2Bitfield1 # << >> /\ (settled13.newOrderV2Bitfield1[1] \div 32) % 2 > 0) THEN (IF settled13.timeInForce = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled13.timeInForce) ELSE << >>]
        settled15 == [settled14 EXCEPT !.minQty = IF settled14.numberOfNewOrderV2Bitfields >= 1 /\ (settled14.newOrderV2Bitfield1 # << >> /\ (settled14.newOrderV2Bitfield1[1] \div 64) % 2 > 0) THEN (IF settled14.minQty = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled14.minQty) ELSE << >>]
        settled16 == [settled15 EXCEPT !.symbolLong = IF settled15.numberOfNewOrderV2Bitfields >= 2 /\ (settled15.newOrderV2Bitfield2 # << >> /\ settled15.newOrderV2Bitfield2[1] % 2 > 0) THEN (IF settled15.symbolLong = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled15.symbolLong) ELSE << >>]
        settled17 == [settled16 EXCEPT !.idSource = IF settled16.numberOfNewOrderV2Bitfields >= 2 /\ (settled16.newOrderV2Bitfield2 # << >> /\ (settled16.newOrderV2Bitfield2[1] \div 8) % 2 > 0) THEN (IF settled16.idSource = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled16.idSource) ELSE << >>]
        settled18 == [settled17 EXCEPT !.securityId = IF settled17.numberOfNewOrderV2Bitfields >= 2 /\ (settled17.newOrderV2Bitfield2 # << >> /\ (settled17.newOrderV2Bitfield2[1] \div 16) % 2 > 0) THEN (IF settled17.securityId = << >> THEN <<[i \in 1 .. 16 |-> 0]>> ELSE settled17.securityId) ELSE << >>]
        settled19 == [settled18 EXCEPT !.capacity = IF settled18.numberOfNewOrderV2Bitfields >= 2 /\ (settled18.newOrderV2Bitfield2 # << >> /\ (settled18.newOrderV2Bitfield2[1] \div 64) % 2 > 0) THEN (IF settled18.capacity = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled18.capacity) ELSE << >>]
        settled20 == [settled19 EXCEPT !.account = IF settled19.numberOfNewOrderV2Bitfields >= 3 /\ (settled19.newOrderV2Bitfield3 # << >> /\ settled19.newOrderV2Bitfield3[1] % 2 > 0) THEN (IF settled19.account = << >> THEN <<[i \in 1 .. 16 |-> 0]>> ELSE settled19.account) ELSE << >>]
        settled21 == [settled20 EXCEPT !.preventMatch = IF settled20.numberOfNewOrderV2Bitfields >= 3 /\ (settled20.newOrderV2Bitfield3 # << >> /\ (settled20.newOrderV2Bitfield3[1] \div 32) % 2 > 0) THEN (IF settled20.preventMatch = << >> THEN <<[i \in 1 .. 3 |-> 0]>> ELSE settled20.preventMatch) ELSE << >>]
        settled22 == [settled21 EXCEPT !.expireTime = IF settled21.numberOfNewOrderV2Bitfields >= 3 /\ (settled21.newOrderV2Bitfield3 # << >> /\ (settled21.newOrderV2Bitfield3[1] \div 128) % 2 > 0) THEN (IF settled21.expireTime = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled21.expireTime) ELSE << >>]
        settled23 == [settled22 EXCEPT !.riskReset = IF settled22.numberOfNewOrderV2Bitfields >= 4 /\ (settled22.newOrderV2Bitfield4 # << >> /\ (settled22.newOrderV2Bitfield4[1] \div 8) % 2 > 0) THEN (IF settled22.riskReset = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled22.riskReset) ELSE << >>]
        settled24 == [settled23 EXCEPT !.openClose = IF settled23.numberOfNewOrderV2Bitfields >= 4 /\ (settled23.newOrderV2Bitfield4 # << >> /\ (settled23.newOrderV2Bitfield4[1] \div 16) % 2 > 0) THEN (IF settled23.openClose = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled23.openClose) ELSE << >>]
        settled25 == [settled24 EXCEPT !.liquidityProvision = IF settled24.numberOfNewOrderV2Bitfields >= 4 /\ (settled24.newOrderV2Bitfield4 # << >> /\ (settled24.newOrderV2Bitfield4[1] \div 128) % 2 > 0) THEN (IF settled24.liquidityProvision = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled24.liquidityProvision) ELSE << >>]
        settled26 == [settled25 EXCEPT !.extExecInst = IF settled25.numberOfNewOrderV2Bitfields >= 5 /\ (settled25.newOrderV2Bitfield5 # << >> /\ (settled25.newOrderV2Bitfield5[1] \div 8) % 2 > 0) THEN (IF settled25.extExecInst = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled25.extExecInst) ELSE << >>]
        settled27 == [settled26 EXCEPT !.clientId = IF settled26.numberOfNewOrderV2Bitfields >= 5 /\ (settled26.newOrderV2Bitfield5 # << >> /\ (settled26.newOrderV2Bitfield5[1] \div 16) % 2 > 0) THEN (IF settled26.clientId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled26.clientId) ELSE << >>]
        settled28 == [settled27 EXCEPT !.investorId = IF settled27.numberOfNewOrderV2Bitfields >= 5 /\ (settled27.newOrderV2Bitfield5 # << >> /\ (settled27.newOrderV2Bitfield5[1] \div 32) % 2 > 0) THEN (IF settled27.investorId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled27.investorId) ELSE << >>]
        settled29 == [settled28 EXCEPT !.executorId = IF settled28.numberOfNewOrderV2Bitfields >= 5 /\ (settled28.newOrderV2Bitfield5 # << >> /\ (settled28.newOrderV2Bitfield5[1] \div 64) % 2 > 0) THEN (IF settled28.executorId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled28.executorId) ELSE << >>]
        settled30 == [settled29 EXCEPT !.orderOrigination = IF settled29.numberOfNewOrderV2Bitfields >= 5 /\ (settled29.newOrderV2Bitfield5 # << >> /\ (settled29.newOrderV2Bitfield5[1] \div 128) % 2 > 0) THEN (IF settled29.orderOrigination = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled29.orderOrigination) ELSE << >>]
        settled31 == [settled30 EXCEPT !.stopPx = IF settled30.numberOfNewOrderV2Bitfields >= 6 /\ (settled30.newOrderV2Bitfield6 # << >> /\ (settled30.newOrderV2Bitfield6[1] \div 2) % 2 > 0) THEN (IF settled30.stopPx = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled30.stopPx) ELSE << >>]
        settled32 == [settled31 EXCEPT !.auctionId = IF settled31.numberOfNewOrderV2Bitfields >= 6 /\ (settled31.newOrderV2Bitfield6 # << >> /\ (settled31.newOrderV2Bitfield6[1] \div 64) % 2 > 0) THEN (IF settled31.auctionId = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled31.auctionId) ELSE << >>]
        settled33 == [settled32 EXCEPT !.algorithmicIndicator = IF settled32.numberOfNewOrderV2Bitfields >= 7 /\ (settled32.newOrderV2Bitfield7 # << >> /\ settled32.newOrderV2Bitfield7[1] % 2 > 0) THEN (IF settled32.algorithmicIndicator = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled32.algorithmicIndicator) ELSE << >>]
        settled34 == [settled33 EXCEPT !.customGroupId = IF settled33.numberOfNewOrderV2Bitfields >= 7 /\ (settled33.newOrderV2Bitfield7 # << >> /\ (settled33.newOrderV2Bitfield7[1] \div 2) % 2 > 0) THEN (IF settled33.customGroupId = << >> THEN <<[i \in 1 .. 2 |-> 0]>> ELSE settled33.customGroupId) ELSE << >>]
        settled35 == [settled34 EXCEPT !.clientQualifiedRole = IF settled34.numberOfNewOrderV2Bitfields >= 7 /\ (settled34.newOrderV2Bitfield7 # << >> /\ (settled34.newOrderV2Bitfield7[1] \div 4) % 2 > 0) THEN (IF settled34.clientQualifiedRole = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled34.clientQualifiedRole) ELSE << >>]
        settled36 == [settled35 EXCEPT !.investorQualifiedRole = IF settled35.numberOfNewOrderV2Bitfields >= 7 /\ (settled35.newOrderV2Bitfield7 # << >> /\ (settled35.newOrderV2Bitfield7[1] \div 8) % 2 > 0) THEN (IF settled35.investorQualifiedRole = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled35.investorQualifiedRole) ELSE << >>]
        settled37 == [settled36 EXCEPT !.executorQualifiedRole = IF settled36.numberOfNewOrderV2Bitfields >= 7 /\ (settled36.newOrderV2Bitfield7 # << >> /\ (settled36.newOrderV2Bitfield7[1] \div 16) % 2 > 0) THEN (IF settled36.executorQualifiedRole = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled36.executorQualifiedRole) ELSE << >>]
        settled38 == [settled37 EXCEPT !.custOrderHandlingInst = IF settled37.numberOfNewOrderV2Bitfields >= 9 /\ (settled37.newOrderV2Bitfield9 # << >> /\ (settled37.newOrderV2Bitfield9[1] \div 16) % 2 > 0) THEN (IF settled37.custOrderHandlingInst = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled37.custOrderHandlingInst) ELSE << >>]
        settled39 == [settled38 EXCEPT !.accountType = IF settled38.numberOfNewOrderV2Bitfields >= 9 /\ (settled38.newOrderV2Bitfield9 # << >> /\ (settled38.newOrderV2Bitfield9[1] \div 32) % 2 > 0) THEN (IF settled38.accountType = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled38.accountType) ELSE << >>]
        settled40 == [settled39 EXCEPT !.drillThruProtection = IF settled39.numberOfNewOrderV2Bitfields >= 9 /\ (settled39.newOrderV2Bitfield9 # << >> /\ (settled39.newOrderV2Bitfield9[1] \div 128) % 2 > 0) THEN (IF settled39.drillThruProtection = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled39.drillThruProtection) ELSE << >>]
    IN  settled40

ZeroNewOrderV2Message ==
    SettleNewOrderV2Message([ clOrdId                     |-> [i \in 1 .. 20 |-> 0],
                              side                        |-> [i \in 1 .. 1 |-> 0],
                              orderQty                    |-> [i \in 1 .. 4 |-> 0],
                              numberOfNewOrderV2Bitfields |-> 0,
                              newOrderV2Bitfield1         |-> << >>,
                              newOrderV2Bitfield2         |-> << >>,
                              newOrderV2Bitfield3         |-> << >>,
                              newOrderV2Bitfield4         |-> << >>,
                              newOrderV2Bitfield5         |-> << >>,
                              newOrderV2Bitfield6         |-> << >>,
                              newOrderV2Bitfield7         |-> << >>,
                              newOrderV2Bitfield8         |-> << >>,
                              newOrderV2Bitfield9         |-> << >>,
                              clearingFirm                |-> << >>,
                              clearingAccount             |-> << >>,
                              price                       |-> << >>,
                              ordType                     |-> << >>,
                              timeInForce                 |-> << >>,
                              minQty                      |-> << >>,
                              symbolLong                  |-> << >>,
                              idSource                    |-> << >>,
                              securityId                  |-> << >>,
                              capacity                    |-> << >>,
                              account                     |-> << >>,
                              preventMatch                |-> << >>,
                              expireTime                  |-> << >>,
                              riskReset                   |-> << >>,
                              openClose                   |-> << >>,
                              liquidityProvision          |-> << >>,
                              extExecInst                 |-> << >>,
                              clientId                    |-> << >>,
                              investorId                  |-> << >>,
                              executorId                  |-> << >>,
                              orderOrigination            |-> << >>,
                              stopPx                      |-> << >>,
                              auctionId                   |-> << >>,
                              algorithmicIndicator        |-> << >>,
                              customGroupId               |-> << >>,
                              clientQualifiedRole         |-> << >>,
                              investorQualifiedRole       |-> << >>,
                              executorQualifiedRole       |-> << >>,
                              custOrderHandlingInst       |-> << >>,
                              accountType                 |-> << >>,
                              drillThruProtection         |-> << >> ])

(* New Order V 2 Message at zero, then each field in turn at the values it is checked at *)
CheckedNewOrderV2Message ==
    { ZeroNewOrderV2Message }
        \cup { SettleNewOrderV2Message([ZeroNewOrderV2Message EXCEPT !.clOrdId = one]) : one \in Sample(20) }
        \cup { SettleNewOrderV2Message([ZeroNewOrderV2Message EXCEPT !.side = one]) : one \in Sample(1) }
        \cup { SettleNewOrderV2Message([ZeroNewOrderV2Message EXCEPT !.orderQty = one]) : one \in Sample(4) }
        \cup { SettleNewOrderV2Message([ZeroNewOrderV2Message EXCEPT !.numberOfNewOrderV2Bitfields = one]) : one \in {0, 1, 255} }
        \cup { SettleNewOrderV2Message([ZeroNewOrderV2Message EXCEPT !.numberOfNewOrderV2Bitfields = 1, !.newOrderV2Bitfield1 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleNewOrderV2Message([ZeroNewOrderV2Message EXCEPT !.numberOfNewOrderV2Bitfields = 2, !.newOrderV2Bitfield2 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleNewOrderV2Message([ZeroNewOrderV2Message EXCEPT !.numberOfNewOrderV2Bitfields = 3, !.newOrderV2Bitfield3 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleNewOrderV2Message([ZeroNewOrderV2Message EXCEPT !.numberOfNewOrderV2Bitfields = 4, !.newOrderV2Bitfield4 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleNewOrderV2Message([ZeroNewOrderV2Message EXCEPT !.numberOfNewOrderV2Bitfields = 5, !.newOrderV2Bitfield5 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleNewOrderV2Message([ZeroNewOrderV2Message EXCEPT !.numberOfNewOrderV2Bitfields = 6, !.newOrderV2Bitfield6 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleNewOrderV2Message([ZeroNewOrderV2Message EXCEPT !.numberOfNewOrderV2Bitfields = 7, !.newOrderV2Bitfield7 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleNewOrderV2Message([ZeroNewOrderV2Message EXCEPT !.numberOfNewOrderV2Bitfields = 8, !.newOrderV2Bitfield8 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderV2Message([ZeroNewOrderV2Message EXCEPT !.numberOfNewOrderV2Bitfields = 9, !.newOrderV2Bitfield9 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleNewOrderV2Message([ZeroNewOrderV2Message EXCEPT !.numberOfNewOrderV2Bitfields = 1, !.newOrderV2Bitfield1 = <<1>>, !.clearingFirm = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewOrderV2Message([ZeroNewOrderV2Message EXCEPT !.numberOfNewOrderV2Bitfields = 1, !.newOrderV2Bitfield1 = <<2>>, !.clearingAccount = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewOrderV2Message([ZeroNewOrderV2Message EXCEPT !.numberOfNewOrderV2Bitfields = 1, !.newOrderV2Bitfield1 = <<4>>, !.price = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleNewOrderV2Message([ZeroNewOrderV2Message EXCEPT !.numberOfNewOrderV2Bitfields = 1, !.newOrderV2Bitfield1 = <<16>>, !.ordType = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderV2Message([ZeroNewOrderV2Message EXCEPT !.numberOfNewOrderV2Bitfields = 1, !.newOrderV2Bitfield1 = <<32>>, !.timeInForce = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderV2Message([ZeroNewOrderV2Message EXCEPT !.numberOfNewOrderV2Bitfields = 1, !.newOrderV2Bitfield1 = <<64>>, !.minQty = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewOrderV2Message([ZeroNewOrderV2Message EXCEPT !.numberOfNewOrderV2Bitfields = 2, !.newOrderV2Bitfield2 = <<1>>, !.symbolLong = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleNewOrderV2Message([ZeroNewOrderV2Message EXCEPT !.numberOfNewOrderV2Bitfields = 2, !.newOrderV2Bitfield2 = <<8>>, !.idSource = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderV2Message([ZeroNewOrderV2Message EXCEPT !.numberOfNewOrderV2Bitfields = 2, !.newOrderV2Bitfield2 = <<16>>, !.securityId = one]) : one \in { <<held>> : held \in Sample(16) } }
        \cup { SettleNewOrderV2Message([ZeroNewOrderV2Message EXCEPT !.numberOfNewOrderV2Bitfields = 2, !.newOrderV2Bitfield2 = <<64>>, !.capacity = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderV2Message([ZeroNewOrderV2Message EXCEPT !.numberOfNewOrderV2Bitfields = 3, !.newOrderV2Bitfield3 = <<1>>, !.account = one]) : one \in { <<held>> : held \in Sample(16) } }
        \cup { SettleNewOrderV2Message([ZeroNewOrderV2Message EXCEPT !.numberOfNewOrderV2Bitfields = 3, !.newOrderV2Bitfield3 = <<32>>, !.preventMatch = one]) : one \in { <<held>> : held \in Sample(3) } }
        \cup { SettleNewOrderV2Message([ZeroNewOrderV2Message EXCEPT !.numberOfNewOrderV2Bitfields = 3, !.newOrderV2Bitfield3 = <<128>>, !.expireTime = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleNewOrderV2Message([ZeroNewOrderV2Message EXCEPT !.numberOfNewOrderV2Bitfields = 4, !.newOrderV2Bitfield4 = <<8>>, !.riskReset = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleNewOrderV2Message([ZeroNewOrderV2Message EXCEPT !.numberOfNewOrderV2Bitfields = 4, !.newOrderV2Bitfield4 = <<16>>, !.openClose = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderV2Message([ZeroNewOrderV2Message EXCEPT !.numberOfNewOrderV2Bitfields = 4, !.newOrderV2Bitfield4 = <<128>>, !.liquidityProvision = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderV2Message([ZeroNewOrderV2Message EXCEPT !.numberOfNewOrderV2Bitfields = 5, !.newOrderV2Bitfield5 = <<8>>, !.extExecInst = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderV2Message([ZeroNewOrderV2Message EXCEPT !.numberOfNewOrderV2Bitfields = 5, !.newOrderV2Bitfield5 = <<16>>, !.clientId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewOrderV2Message([ZeroNewOrderV2Message EXCEPT !.numberOfNewOrderV2Bitfields = 5, !.newOrderV2Bitfield5 = <<32>>, !.investorId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewOrderV2Message([ZeroNewOrderV2Message EXCEPT !.numberOfNewOrderV2Bitfields = 5, !.newOrderV2Bitfield5 = <<64>>, !.executorId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewOrderV2Message([ZeroNewOrderV2Message EXCEPT !.numberOfNewOrderV2Bitfields = 5, !.newOrderV2Bitfield5 = <<128>>, !.orderOrigination = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderV2Message([ZeroNewOrderV2Message EXCEPT !.numberOfNewOrderV2Bitfields = 6, !.newOrderV2Bitfield6 = <<2>>, !.stopPx = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleNewOrderV2Message([ZeroNewOrderV2Message EXCEPT !.numberOfNewOrderV2Bitfields = 6, !.newOrderV2Bitfield6 = <<64>>, !.auctionId = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleNewOrderV2Message([ZeroNewOrderV2Message EXCEPT !.numberOfNewOrderV2Bitfields = 7, !.newOrderV2Bitfield7 = <<1>>, !.algorithmicIndicator = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderV2Message([ZeroNewOrderV2Message EXCEPT !.numberOfNewOrderV2Bitfields = 7, !.newOrderV2Bitfield7 = <<2>>, !.customGroupId = one]) : one \in { <<held>> : held \in Sample(2) } }
        \cup { SettleNewOrderV2Message([ZeroNewOrderV2Message EXCEPT !.numberOfNewOrderV2Bitfields = 7, !.newOrderV2Bitfield7 = <<4>>, !.clientQualifiedRole = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderV2Message([ZeroNewOrderV2Message EXCEPT !.numberOfNewOrderV2Bitfields = 7, !.newOrderV2Bitfield7 = <<8>>, !.investorQualifiedRole = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderV2Message([ZeroNewOrderV2Message EXCEPT !.numberOfNewOrderV2Bitfields = 7, !.newOrderV2Bitfield7 = <<16>>, !.executorQualifiedRole = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderV2Message([ZeroNewOrderV2Message EXCEPT !.numberOfNewOrderV2Bitfields = 9, !.newOrderV2Bitfield9 = <<16>>, !.custOrderHandlingInst = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderV2Message([ZeroNewOrderV2Message EXCEPT !.numberOfNewOrderV2Bitfields = 9, !.newOrderV2Bitfield9 = <<32>>, !.accountType = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderV2Message([ZeroNewOrderV2Message EXCEPT !.numberOfNewOrderV2Bitfields = 9, !.newOrderV2Bitfield9 = <<128>>, !.drillThruProtection = one]) : one \in { <<held>> : held \in Sample(8) } }

(***************************************************************************)
(* Order Allocations                                                       *)
(***************************************************************************)

OrderAllocations ==
    [ side                  : Sample(1),
      allocQty              : Sample(4),
      clOrdId               : Sample(20),
      capacity              : Sample(1),
      clearingFirm          : Sample(4),
      accountType           : Sample(1),
      account               : { << >> } \cup { <<held>> : held \in Sample(16) },
      clearingAccount       : { << >> } \cup { <<held>> : held \in Sample(4) },
      openClose             : { << >> } \cup { <<held>> : held \in Sample(1) },
      custOrderHandlingInst : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderOrigination      : { << >> } \cup { <<held>> : held \in Sample(1) },
      algorithmicIndicator  : { << >> } \cup { <<held>> : held \in Sample(1) },
      clientId              : { << >> } \cup { <<held>> : held \in Sample(4) },
      clientQualifiedRole   : { << >> } \cup { <<held>> : held \in Sample(1) },
      investorId            : { << >> } \cup { <<held>> : held \in Sample(4) },
      investorQualifiedRole : { << >> } \cup { <<held>> : held \in Sample(1) },
      executorId            : { << >> } \cup { <<held>> : held \in Sample(4) },
      executorQualifiedRole : { << >> } \cup { <<held>> : held \in Sample(1) } ]

EncodeOrderAllocations(message) ==
    message.side
        \o message.allocQty
        \o message.clOrdId
        \o message.capacity
        \o message.clearingFirm
        \o message.accountType
        \o (IF message.account = << >> THEN << >> ELSE message.account[1])
        \o (IF message.clearingAccount = << >> THEN << >> ELSE message.clearingAccount[1])
        \o (IF message.openClose = << >> THEN << >> ELSE message.openClose[1])
        \o (IF message.custOrderHandlingInst = << >> THEN << >> ELSE message.custOrderHandlingInst[1])
        \o (IF message.orderOrigination = << >> THEN << >> ELSE message.orderOrigination[1])
        \o (IF message.algorithmicIndicator = << >> THEN << >> ELSE message.algorithmicIndicator[1])
        \o (IF message.clientId = << >> THEN << >> ELSE message.clientId[1])
        \o (IF message.clientQualifiedRole = << >> THEN << >> ELSE message.clientQualifiedRole[1])
        \o (IF message.investorId = << >> THEN << >> ELSE message.investorId[1])
        \o (IF message.investorQualifiedRole = << >> THEN << >> ELSE message.investorQualifiedRole[1])
        \o (IF message.executorId = << >> THEN << >> ELSE message.executorId[1])
        \o (IF message.executorQualifiedRole = << >> THEN << >> ELSE message.executorQualifiedRole[1])

DecodeOrderAllocations(bytes, handedNumberOfNewOrderCrossBitfields, handedNewOrderCrossBitfield1, handedNewOrderCrossBitfield2, handedNewOrderCrossBitfield3) ==
    LET side == ReadBytes(bytes, 1) IN IF ~side.ok THEN Fail ELSE
    LET allocQty == ReadBytes(side.rest, 4) IN IF ~allocQty.ok THEN Fail ELSE
    LET clOrdId == ReadBytes(allocQty.rest, 20) IN IF ~clOrdId.ok THEN Fail ELSE
    LET capacity == ReadBytes(clOrdId.rest, 1) IN IF ~capacity.ok THEN Fail ELSE
    LET clearingFirm == ReadBytes(capacity.rest, 4) IN IF ~clearingFirm.ok THEN Fail ELSE
    LET accountType == ReadBytes(clearingFirm.rest, 1) IN IF ~accountType.ok THEN Fail ELSE
    LET account == ReadWhen(handedNumberOfNewOrderCrossBitfields >= 2 /\ (handedNewOrderCrossBitfield2 # << >> /\ (handedNewOrderCrossBitfield2[1] \div 8) % 2 > 0), ReadBytes(accountType.rest, 16), accountType.rest) IN IF ~account.ok THEN Fail ELSE
    LET clearingAccount == ReadWhen(handedNumberOfNewOrderCrossBitfields >= 2 /\ (handedNewOrderCrossBitfield2 # << >> /\ (handedNewOrderCrossBitfield2[1] \div 32) % 2 > 0), ReadBytes(account.rest, 4), account.rest) IN IF ~clearingAccount.ok THEN Fail ELSE
    LET openClose == ReadWhen(handedNumberOfNewOrderCrossBitfields >= 3 /\ (handedNewOrderCrossBitfield3 # << >> /\ (handedNewOrderCrossBitfield3[1] \div 16) % 2 > 0), ReadBytes(clearingAccount.rest, 1), clearingAccount.rest) IN IF ~openClose.ok THEN Fail ELSE
    LET custOrderHandlingInst == ReadWhen(handedNumberOfNewOrderCrossBitfields >= 1 /\ (handedNewOrderCrossBitfield1 # << >> /\ (handedNewOrderCrossBitfield1[1] \div 8) % 2 > 0), ReadBytes(openClose.rest, 1), openClose.rest) IN IF ~custOrderHandlingInst.ok THEN Fail ELSE
    LET orderOrigination == ReadWhen(handedNumberOfNewOrderCrossBitfields >= 1 /\ (handedNewOrderCrossBitfield1 # << >> /\ (handedNewOrderCrossBitfield1[1] \div 32) % 2 > 0), ReadBytes(custOrderHandlingInst.rest, 1), custOrderHandlingInst.rest) IN IF ~orderOrigination.ok THEN Fail ELSE
    LET algorithmicIndicator == ReadWhen(handedNumberOfNewOrderCrossBitfields >= 1 /\ (handedNewOrderCrossBitfield1 # << >> /\ (handedNewOrderCrossBitfield1[1] \div 64) % 2 > 0), ReadBytes(orderOrigination.rest, 1), orderOrigination.rest) IN IF ~algorithmicIndicator.ok THEN Fail ELSE
    LET clientId == ReadWhen(handedNumberOfNewOrderCrossBitfields >= 2 /\ (handedNewOrderCrossBitfield2 # << >> /\ (handedNewOrderCrossBitfield2[1] \div 64) % 2 > 0), ReadBytes(algorithmicIndicator.rest, 4), algorithmicIndicator.rest) IN IF ~clientId.ok THEN Fail ELSE
    LET clientQualifiedRole == ReadWhen(handedNumberOfNewOrderCrossBitfields >= 2 /\ (handedNewOrderCrossBitfield2 # << >> /\ (handedNewOrderCrossBitfield2[1] \div 128) % 2 > 0), ReadBytes(clientId.rest, 1), clientId.rest) IN IF ~clientQualifiedRole.ok THEN Fail ELSE
    LET investorId == ReadWhen(handedNumberOfNewOrderCrossBitfields >= 3 /\ (handedNewOrderCrossBitfield3 # << >> /\ handedNewOrderCrossBitfield3[1] % 2 > 0), ReadBytes(clientQualifiedRole.rest, 4), clientQualifiedRole.rest) IN IF ~investorId.ok THEN Fail ELSE
    LET investorQualifiedRole == ReadWhen(handedNumberOfNewOrderCrossBitfields >= 3 /\ (handedNewOrderCrossBitfield3 # << >> /\ (handedNewOrderCrossBitfield3[1] \div 2) % 2 > 0), ReadBytes(investorId.rest, 1), investorId.rest) IN IF ~investorQualifiedRole.ok THEN Fail ELSE
    LET executorId == ReadWhen(handedNumberOfNewOrderCrossBitfields >= 3 /\ (handedNewOrderCrossBitfield3 # << >> /\ (handedNewOrderCrossBitfield3[1] \div 4) % 2 > 0), ReadBytes(investorQualifiedRole.rest, 4), investorQualifiedRole.rest) IN IF ~executorId.ok THEN Fail ELSE
    LET executorQualifiedRole == ReadWhen(handedNumberOfNewOrderCrossBitfields >= 3 /\ (handedNewOrderCrossBitfield3 # << >> /\ (handedNewOrderCrossBitfield3[1] \div 8) % 2 > 0), ReadBytes(executorId.rest, 1), executorId.rest) IN IF ~executorQualifiedRole.ok THEN Fail ELSE
    Ok([ side                  |-> side.value,
         allocQty              |-> allocQty.value,
         clOrdId               |-> clOrdId.value,
         capacity              |-> capacity.value,
         clearingFirm          |-> clearingFirm.value,
         accountType           |-> accountType.value,
         account               |-> account.value,
         clearingAccount       |-> clearingAccount.value,
         openClose             |-> openClose.value,
         custOrderHandlingInst |-> custOrderHandlingInst.value,
         orderOrigination      |-> orderOrigination.value,
         algorithmicIndicator  |-> algorithmicIndicator.value,
         clientId              |-> clientId.value,
         clientQualifiedRole   |-> clientQualifiedRole.value,
         investorId            |-> investorId.value,
         investorQualifiedRole |-> investorQualifiedRole.value,
         executorId            |-> executorId.value,
         executorQualifiedRole |-> executorQualifiedRole.value ], executorQualifiedRole.rest)

(* Order Allocations with each field marked present by fields before it there exactly where they say *)
SettleOrderAllocations(message, handedNumberOfNewOrderCrossBitfields, handedNewOrderCrossBitfield1, handedNewOrderCrossBitfield2, handedNewOrderCrossBitfield3) ==
    LET settled1 == [message EXCEPT !.account = IF handedNumberOfNewOrderCrossBitfields >= 2 /\ (handedNewOrderCrossBitfield2 # << >> /\ (handedNewOrderCrossBitfield2[1] \div 8) % 2 > 0) THEN (IF message.account = << >> THEN <<[i \in 1 .. 16 |-> 0]>> ELSE message.account) ELSE << >>]
        settled2 == [settled1 EXCEPT !.clearingAccount = IF handedNumberOfNewOrderCrossBitfields >= 2 /\ (handedNewOrderCrossBitfield2 # << >> /\ (handedNewOrderCrossBitfield2[1] \div 32) % 2 > 0) THEN (IF settled1.clearingAccount = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled1.clearingAccount) ELSE << >>]
        settled3 == [settled2 EXCEPT !.openClose = IF handedNumberOfNewOrderCrossBitfields >= 3 /\ (handedNewOrderCrossBitfield3 # << >> /\ (handedNewOrderCrossBitfield3[1] \div 16) % 2 > 0) THEN (IF settled2.openClose = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled2.openClose) ELSE << >>]
        settled4 == [settled3 EXCEPT !.custOrderHandlingInst = IF handedNumberOfNewOrderCrossBitfields >= 1 /\ (handedNewOrderCrossBitfield1 # << >> /\ (handedNewOrderCrossBitfield1[1] \div 8) % 2 > 0) THEN (IF settled3.custOrderHandlingInst = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled3.custOrderHandlingInst) ELSE << >>]
        settled5 == [settled4 EXCEPT !.orderOrigination = IF handedNumberOfNewOrderCrossBitfields >= 1 /\ (handedNewOrderCrossBitfield1 # << >> /\ (handedNewOrderCrossBitfield1[1] \div 32) % 2 > 0) THEN (IF settled4.orderOrigination = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled4.orderOrigination) ELSE << >>]
        settled6 == [settled5 EXCEPT !.algorithmicIndicator = IF handedNumberOfNewOrderCrossBitfields >= 1 /\ (handedNewOrderCrossBitfield1 # << >> /\ (handedNewOrderCrossBitfield1[1] \div 64) % 2 > 0) THEN (IF settled5.algorithmicIndicator = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled5.algorithmicIndicator) ELSE << >>]
        settled7 == [settled6 EXCEPT !.clientId = IF handedNumberOfNewOrderCrossBitfields >= 2 /\ (handedNewOrderCrossBitfield2 # << >> /\ (handedNewOrderCrossBitfield2[1] \div 64) % 2 > 0) THEN (IF settled6.clientId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled6.clientId) ELSE << >>]
        settled8 == [settled7 EXCEPT !.clientQualifiedRole = IF handedNumberOfNewOrderCrossBitfields >= 2 /\ (handedNewOrderCrossBitfield2 # << >> /\ (handedNewOrderCrossBitfield2[1] \div 128) % 2 > 0) THEN (IF settled7.clientQualifiedRole = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled7.clientQualifiedRole) ELSE << >>]
        settled9 == [settled8 EXCEPT !.investorId = IF handedNumberOfNewOrderCrossBitfields >= 3 /\ (handedNewOrderCrossBitfield3 # << >> /\ handedNewOrderCrossBitfield3[1] % 2 > 0) THEN (IF settled8.investorId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled8.investorId) ELSE << >>]
        settled10 == [settled9 EXCEPT !.investorQualifiedRole = IF handedNumberOfNewOrderCrossBitfields >= 3 /\ (handedNewOrderCrossBitfield3 # << >> /\ (handedNewOrderCrossBitfield3[1] \div 2) % 2 > 0) THEN (IF settled9.investorQualifiedRole = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled9.investorQualifiedRole) ELSE << >>]
        settled11 == [settled10 EXCEPT !.executorId = IF handedNumberOfNewOrderCrossBitfields >= 3 /\ (handedNewOrderCrossBitfield3 # << >> /\ (handedNewOrderCrossBitfield3[1] \div 4) % 2 > 0) THEN (IF settled10.executorId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled10.executorId) ELSE << >>]
        settled12 == [settled11 EXCEPT !.executorQualifiedRole = IF handedNumberOfNewOrderCrossBitfields >= 3 /\ (handedNewOrderCrossBitfield3 # << >> /\ (handedNewOrderCrossBitfield3[1] \div 8) % 2 > 0) THEN (IF settled11.executorQualifiedRole = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled11.executorQualifiedRole) ELSE << >>]
    IN  settled12

ZeroOrderAllocations ==
    SettleOrderAllocations([ side                  |-> [i \in 1 .. 1 |-> 0],
                             allocQty              |-> [i \in 1 .. 4 |-> 0],
                             clOrdId               |-> [i \in 1 .. 20 |-> 0],
                             capacity              |-> [i \in 1 .. 1 |-> 0],
                             clearingFirm          |-> [i \in 1 .. 4 |-> 0],
                             accountType           |-> [i \in 1 .. 1 |-> 0],
                             account               |-> << >>,
                             clearingAccount       |-> << >>,
                             openClose             |-> << >>,
                             custOrderHandlingInst |-> << >>,
                             orderOrigination      |-> << >>,
                             algorithmicIndicator  |-> << >>,
                             clientId              |-> << >>,
                             clientQualifiedRole   |-> << >>,
                             investorId            |-> << >>,
                             investorQualifiedRole |-> << >>,
                             executorId            |-> << >>,
                             executorQualifiedRole |-> << >> ], 0, << >>, << >>, << >>)

(* Order Allocations at zero, then each field in turn at the values it is checked at *)
CheckedOrderAllocations ==
    { [given |-> <<0, << >>, << >>, << >>>>, message |-> ZeroOrderAllocations] }
        \cup { [given |-> <<0, << >>, << >>, << >>>>, message |-> SettleOrderAllocations([ZeroOrderAllocations EXCEPT !.side = one], 0, << >>, << >>, << >>)] : one \in Sample(1) }
        \cup { [given |-> <<0, << >>, << >>, << >>>>, message |-> SettleOrderAllocations([ZeroOrderAllocations EXCEPT !.allocQty = one], 0, << >>, << >>, << >>)] : one \in Sample(4) }
        \cup { [given |-> <<0, << >>, << >>, << >>>>, message |-> SettleOrderAllocations([ZeroOrderAllocations EXCEPT !.clOrdId = one], 0, << >>, << >>, << >>)] : one \in Sample(20) }
        \cup { [given |-> <<0, << >>, << >>, << >>>>, message |-> SettleOrderAllocations([ZeroOrderAllocations EXCEPT !.capacity = one], 0, << >>, << >>, << >>)] : one \in Sample(1) }
        \cup { [given |-> <<0, << >>, << >>, << >>>>, message |-> SettleOrderAllocations([ZeroOrderAllocations EXCEPT !.clearingFirm = one], 0, << >>, << >>, << >>)] : one \in Sample(4) }
        \cup { [given |-> <<0, << >>, << >>, << >>>>, message |-> SettleOrderAllocations([ZeroOrderAllocations EXCEPT !.accountType = one], 0, << >>, << >>, << >>)] : one \in Sample(1) }
        \cup { [given |-> <<2, << >>, <<8>>, << >>>>, message |-> SettleOrderAllocations([ZeroOrderAllocations EXCEPT !.account = one], 2, << >>, <<8>>, << >>)] : one \in { <<held>> : held \in Sample(16) } }
        \cup { [given |-> <<2, << >>, <<32>>, << >>>>, message |-> SettleOrderAllocations([ZeroOrderAllocations EXCEPT !.clearingAccount = one], 2, << >>, <<32>>, << >>)] : one \in { <<held>> : held \in Sample(4) } }
        \cup { [given |-> <<3, << >>, << >>, <<16>>>>, message |-> SettleOrderAllocations([ZeroOrderAllocations EXCEPT !.openClose = one], 3, << >>, << >>, <<16>>)] : one \in { <<held>> : held \in Sample(1) } }
        \cup { [given |-> <<1, <<8>>, << >>, << >>>>, message |-> SettleOrderAllocations([ZeroOrderAllocations EXCEPT !.custOrderHandlingInst = one], 1, <<8>>, << >>, << >>)] : one \in { <<held>> : held \in Sample(1) } }
        \cup { [given |-> <<1, <<32>>, << >>, << >>>>, message |-> SettleOrderAllocations([ZeroOrderAllocations EXCEPT !.orderOrigination = one], 1, <<32>>, << >>, << >>)] : one \in { <<held>> : held \in Sample(1) } }
        \cup { [given |-> <<1, <<64>>, << >>, << >>>>, message |-> SettleOrderAllocations([ZeroOrderAllocations EXCEPT !.algorithmicIndicator = one], 1, <<64>>, << >>, << >>)] : one \in { <<held>> : held \in Sample(1) } }
        \cup { [given |-> <<2, << >>, <<64>>, << >>>>, message |-> SettleOrderAllocations([ZeroOrderAllocations EXCEPT !.clientId = one], 2, << >>, <<64>>, << >>)] : one \in { <<held>> : held \in Sample(4) } }
        \cup { [given |-> <<2, << >>, <<128>>, << >>>>, message |-> SettleOrderAllocations([ZeroOrderAllocations EXCEPT !.clientQualifiedRole = one], 2, << >>, <<128>>, << >>)] : one \in { <<held>> : held \in Sample(1) } }
        \cup { [given |-> <<3, << >>, << >>, <<1>>>>, message |-> SettleOrderAllocations([ZeroOrderAllocations EXCEPT !.investorId = one], 3, << >>, << >>, <<1>>)] : one \in { <<held>> : held \in Sample(4) } }
        \cup { [given |-> <<3, << >>, << >>, <<2>>>>, message |-> SettleOrderAllocations([ZeroOrderAllocations EXCEPT !.investorQualifiedRole = one], 3, << >>, << >>, <<2>>)] : one \in { <<held>> : held \in Sample(1) } }
        \cup { [given |-> <<3, << >>, << >>, <<4>>>>, message |-> SettleOrderAllocations([ZeroOrderAllocations EXCEPT !.executorId = one], 3, << >>, << >>, <<4>>)] : one \in { <<held>> : held \in Sample(4) } }
        \cup { [given |-> <<3, << >>, << >>, <<8>>>>, message |-> SettleOrderAllocations([ZeroOrderAllocations EXCEPT !.executorQualifiedRole = one], 3, << >>, << >>, <<8>>)] : one \in { <<held>> : held \in Sample(1) } }

(* A run of Order Allocations, written one after another *)
RECURSIVE EncodeOrderAllocationsList(_)
EncodeOrderAllocationsList(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeOrderAllocations(Head(messages)) \o EncodeOrderAllocationsList(Tail(messages))

(* As many Order Allocations as the field that counts them says *)
RECURSIVE ReadOrderAllocationsList(_, _, _, _, _, _)
ReadOrderAllocationsList(bytes, count, handedNumberOfNewOrderCrossBitfields, handedNewOrderCrossBitfield1, handedNewOrderCrossBitfield2, handedNewOrderCrossBitfield3) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeOrderAllocations(bytes, handedNumberOfNewOrderCrossBitfields, handedNewOrderCrossBitfield1, handedNewOrderCrossBitfield2, handedNewOrderCrossBitfield3)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadOrderAllocationsList(one.rest, count - 1, handedNumberOfNewOrderCrossBitfields, handedNewOrderCrossBitfield1, handedNewOrderCrossBitfield2, handedNewOrderCrossBitfield3)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Order Allocations of each kind, for the lists that carry them *)
OneOrderAllocations == { ZeroOrderAllocations }

(***************************************************************************)
(* New Order Cross Message                                                 *)
(***************************************************************************)

NewOrderCrossMessage ==
    [ crossId                        : Sample(20),
      crossType                      : Sample(1),
      crossPrioritization            : Sample(1),
      price                          : Sample(8),
      orderQty                       : Sample(4),
      numberOfNewOrderCrossBitfields : 0 .. 255,
      newOrderCrossBitfield1         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      newOrderCrossBitfield2         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      newOrderCrossBitfield3         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderAllocations               : SampleLists(OneOrderAllocations),
      symbolLong                     : { << >> } \cup { <<held>> : held \in Sample(8) },
      idSource                       : { << >> } \cup { <<held>> : held \in Sample(1) },
      securityId                     : { << >> } \cup { <<held>> : held \in Sample(16) },
      liquidityProvision             : { << >> } \cup { <<held>> : held \in Sample(1) },
      preventMatch                   : { << >> } \cup { <<held>> : held \in Sample(3) },
      autoMatch                      : { << >> } \cup { <<held>> : held \in Sample(1) },
      autoMatchPrice                 : { << >> } \cup { <<held>> : held \in Sample(8) },
      lastPriority                   : { << >> } \cup { <<held>> : held \in Sample(1) },
      drillThruProtection            : { << >> } \cup { <<held>> : held \in Sample(8) },
      extExecInst                    : { << >> } \cup { <<held>> : held \in Sample(1) } ]

EncodeNewOrderCrossMessage(message) ==
    message.crossId
        \o message.crossType
        \o message.crossPrioritization
        \o message.price
        \o message.orderQty
        \o EncodeUIntBE(message.numberOfNewOrderCrossBitfields, 1)
        \o (IF message.newOrderCrossBitfield1 = << >> THEN << >> ELSE EncodeUIntLE(message.newOrderCrossBitfield1[1], 1))
        \o (IF message.newOrderCrossBitfield2 = << >> THEN << >> ELSE EncodeUIntLE(message.newOrderCrossBitfield2[1], 1))
        \o (IF message.newOrderCrossBitfield3 = << >> THEN << >> ELSE EncodeUIntLE(message.newOrderCrossBitfield3[1], 1))
        \o EncodeUIntLE(Len(message.orderAllocations), 2)
        \o EncodeOrderAllocationsList(message.orderAllocations)
        \o (IF message.symbolLong = << >> THEN << >> ELSE message.symbolLong[1])
        \o (IF message.idSource = << >> THEN << >> ELSE message.idSource[1])
        \o (IF message.securityId = << >> THEN << >> ELSE message.securityId[1])
        \o (IF message.liquidityProvision = << >> THEN << >> ELSE message.liquidityProvision[1])
        \o (IF message.preventMatch = << >> THEN << >> ELSE message.preventMatch[1])
        \o (IF message.autoMatch = << >> THEN << >> ELSE message.autoMatch[1])
        \o (IF message.autoMatchPrice = << >> THEN << >> ELSE message.autoMatchPrice[1])
        \o (IF message.lastPriority = << >> THEN << >> ELSE message.lastPriority[1])
        \o (IF message.drillThruProtection = << >> THEN << >> ELSE message.drillThruProtection[1])
        \o (IF message.extExecInst = << >> THEN << >> ELSE message.extExecInst[1])

DecodeNewOrderCrossMessage(bytes) ==
    LET crossId == ReadBytes(bytes, 20) IN IF ~crossId.ok THEN Fail ELSE
    LET crossType == ReadBytes(crossId.rest, 1) IN IF ~crossType.ok THEN Fail ELSE
    LET crossPrioritization == ReadBytes(crossType.rest, 1) IN IF ~crossPrioritization.ok THEN Fail ELSE
    LET price == ReadBytes(crossPrioritization.rest, 8) IN IF ~price.ok THEN Fail ELSE
    LET orderQty == ReadBytes(price.rest, 4) IN IF ~orderQty.ok THEN Fail ELSE
    LET numberOfNewOrderCrossBitfields == ReadUIntBE(orderQty.rest, 1) IN IF ~numberOfNewOrderCrossBitfields.ok THEN Fail ELSE
    LET newOrderCrossBitfield1 == ReadWhen(numberOfNewOrderCrossBitfields.value >= 1, ReadUIntLE(numberOfNewOrderCrossBitfields.rest, 1), numberOfNewOrderCrossBitfields.rest) IN IF ~newOrderCrossBitfield1.ok THEN Fail ELSE
    LET newOrderCrossBitfield2 == ReadWhen(numberOfNewOrderCrossBitfields.value >= 2, ReadUIntLE(newOrderCrossBitfield1.rest, 1), newOrderCrossBitfield1.rest) IN IF ~newOrderCrossBitfield2.ok THEN Fail ELSE
    LET newOrderCrossBitfield3 == ReadWhen(numberOfNewOrderCrossBitfields.value >= 3, ReadUIntLE(newOrderCrossBitfield2.rest, 1), newOrderCrossBitfield2.rest) IN IF ~newOrderCrossBitfield3.ok THEN Fail ELSE
    LET groupCnt == ReadUIntLE(newOrderCrossBitfield3.rest, 2) IN IF ~groupCnt.ok THEN Fail ELSE
    LET orderAllocations == ReadOrderAllocationsList(groupCnt.rest, groupCnt.value, numberOfNewOrderCrossBitfields.value, newOrderCrossBitfield1.value, newOrderCrossBitfield2.value, newOrderCrossBitfield3.value) IN IF ~orderAllocations.ok THEN Fail ELSE
    LET symbolLong == ReadWhen(numberOfNewOrderCrossBitfields.value >= 1 /\ (newOrderCrossBitfield1.value # << >> /\ newOrderCrossBitfield1.value[1] % 2 > 0), ReadBytes(orderAllocations.rest, 8), orderAllocations.rest) IN IF ~symbolLong.ok THEN Fail ELSE
    LET idSource == ReadWhen(numberOfNewOrderCrossBitfields.value >= 1 /\ (newOrderCrossBitfield1.value # << >> /\ (newOrderCrossBitfield1.value[1] \div 2) % 2 > 0), ReadBytes(symbolLong.rest, 1), symbolLong.rest) IN IF ~idSource.ok THEN Fail ELSE
    LET securityId == ReadWhen(numberOfNewOrderCrossBitfields.value >= 1 /\ (newOrderCrossBitfield1.value # << >> /\ (newOrderCrossBitfield1.value[1] \div 4) % 2 > 0), ReadBytes(idSource.rest, 16), idSource.rest) IN IF ~securityId.ok THEN Fail ELSE
    LET liquidityProvision == ReadWhen(numberOfNewOrderCrossBitfields.value >= 1 /\ (newOrderCrossBitfield1.value # << >> /\ (newOrderCrossBitfield1.value[1] \div 16) % 2 > 0), ReadBytes(securityId.rest, 1), securityId.rest) IN IF ~liquidityProvision.ok THEN Fail ELSE
    LET preventMatch == ReadWhen(numberOfNewOrderCrossBitfields.value >= 1 /\ (newOrderCrossBitfield1.value # << >> /\ (newOrderCrossBitfield1.value[1] \div 128) % 2 > 0), ReadBytes(liquidityProvision.rest, 3), liquidityProvision.rest) IN IF ~preventMatch.ok THEN Fail ELSE
    LET autoMatch == ReadWhen(numberOfNewOrderCrossBitfields.value >= 2 /\ (newOrderCrossBitfield2.value # << >> /\ newOrderCrossBitfield2.value[1] % 2 > 0), ReadBytes(preventMatch.rest, 1), preventMatch.rest) IN IF ~autoMatch.ok THEN Fail ELSE
    LET autoMatchPrice == ReadWhen(numberOfNewOrderCrossBitfields.value >= 2 /\ (newOrderCrossBitfield2.value # << >> /\ (newOrderCrossBitfield2.value[1] \div 2) % 2 > 0), ReadBytes(autoMatch.rest, 8), autoMatch.rest) IN IF ~autoMatchPrice.ok THEN Fail ELSE
    LET lastPriority == ReadWhen(numberOfNewOrderCrossBitfields.value >= 2 /\ (newOrderCrossBitfield2.value # << >> /\ (newOrderCrossBitfield2.value[1] \div 4) % 2 > 0), ReadBytes(autoMatchPrice.rest, 1), autoMatchPrice.rest) IN IF ~lastPriority.ok THEN Fail ELSE
    LET drillThruProtection == ReadWhen(numberOfNewOrderCrossBitfields.value >= 3 /\ (newOrderCrossBitfield3.value # << >> /\ (newOrderCrossBitfield3.value[1] \div 32) % 2 > 0), ReadBytes(lastPriority.rest, 8), lastPriority.rest) IN IF ~drillThruProtection.ok THEN Fail ELSE
    LET extExecInst == ReadWhen(numberOfNewOrderCrossBitfields.value >= 3 /\ (newOrderCrossBitfield3.value # << >> /\ (newOrderCrossBitfield3.value[1] \div 64) % 2 > 0), ReadBytes(drillThruProtection.rest, 1), drillThruProtection.rest) IN IF ~extExecInst.ok THEN Fail ELSE
    Ok([ crossId                        |-> crossId.value,
         crossType                      |-> crossType.value,
         crossPrioritization            |-> crossPrioritization.value,
         price                          |-> price.value,
         orderQty                       |-> orderQty.value,
         numberOfNewOrderCrossBitfields |-> numberOfNewOrderCrossBitfields.value,
         newOrderCrossBitfield1         |-> newOrderCrossBitfield1.value,
         newOrderCrossBitfield2         |-> newOrderCrossBitfield2.value,
         newOrderCrossBitfield3         |-> newOrderCrossBitfield3.value,
         orderAllocations               |-> orderAllocations.value,
         symbolLong                     |-> symbolLong.value,
         idSource                       |-> idSource.value,
         securityId                     |-> securityId.value,
         liquidityProvision             |-> liquidityProvision.value,
         preventMatch                   |-> preventMatch.value,
         autoMatch                      |-> autoMatch.value,
         autoMatchPrice                 |-> autoMatchPrice.value,
         lastPriority                   |-> lastPriority.value,
         drillThruProtection            |-> drillThruProtection.value,
         extExecInst                    |-> extExecInst.value ], extExecInst.rest)

(* New Order Cross Message with each field marked present by fields before it there exactly where they say *)
SettleNewOrderCrossMessage(message) ==
    LET settled1 == [message EXCEPT !.newOrderCrossBitfield1 = IF message.numberOfNewOrderCrossBitfields >= 1 THEN (IF message.newOrderCrossBitfield1 = << >> THEN <<0>> ELSE message.newOrderCrossBitfield1) ELSE << >>]
        settled2 == [settled1 EXCEPT !.newOrderCrossBitfield2 = IF settled1.numberOfNewOrderCrossBitfields >= 2 THEN (IF settled1.newOrderCrossBitfield2 = << >> THEN <<0>> ELSE settled1.newOrderCrossBitfield2) ELSE << >>]
        settled3 == [settled2 EXCEPT !.newOrderCrossBitfield3 = IF settled2.numberOfNewOrderCrossBitfields >= 3 THEN (IF settled2.newOrderCrossBitfield3 = << >> THEN <<0>> ELSE settled2.newOrderCrossBitfield3) ELSE << >>]
        settled4 == [settled3 EXCEPT !.orderAllocations = [i \in DOMAIN settled3.orderAllocations |-> SettleOrderAllocations(settled3.orderAllocations[i], settled3.numberOfNewOrderCrossBitfields, settled3.newOrderCrossBitfield1, settled3.newOrderCrossBitfield2, settled3.newOrderCrossBitfield3)]]
        settled5 == [settled4 EXCEPT !.symbolLong = IF settled4.numberOfNewOrderCrossBitfields >= 1 /\ (settled4.newOrderCrossBitfield1 # << >> /\ settled4.newOrderCrossBitfield1[1] % 2 > 0) THEN (IF settled4.symbolLong = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled4.symbolLong) ELSE << >>]
        settled6 == [settled5 EXCEPT !.idSource = IF settled5.numberOfNewOrderCrossBitfields >= 1 /\ (settled5.newOrderCrossBitfield1 # << >> /\ (settled5.newOrderCrossBitfield1[1] \div 2) % 2 > 0) THEN (IF settled5.idSource = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled5.idSource) ELSE << >>]
        settled7 == [settled6 EXCEPT !.securityId = IF settled6.numberOfNewOrderCrossBitfields >= 1 /\ (settled6.newOrderCrossBitfield1 # << >> /\ (settled6.newOrderCrossBitfield1[1] \div 4) % 2 > 0) THEN (IF settled6.securityId = << >> THEN <<[i \in 1 .. 16 |-> 0]>> ELSE settled6.securityId) ELSE << >>]
        settled8 == [settled7 EXCEPT !.liquidityProvision = IF settled7.numberOfNewOrderCrossBitfields >= 1 /\ (settled7.newOrderCrossBitfield1 # << >> /\ (settled7.newOrderCrossBitfield1[1] \div 16) % 2 > 0) THEN (IF settled7.liquidityProvision = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled7.liquidityProvision) ELSE << >>]
        settled9 == [settled8 EXCEPT !.preventMatch = IF settled8.numberOfNewOrderCrossBitfields >= 1 /\ (settled8.newOrderCrossBitfield1 # << >> /\ (settled8.newOrderCrossBitfield1[1] \div 128) % 2 > 0) THEN (IF settled8.preventMatch = << >> THEN <<[i \in 1 .. 3 |-> 0]>> ELSE settled8.preventMatch) ELSE << >>]
        settled10 == [settled9 EXCEPT !.autoMatch = IF settled9.numberOfNewOrderCrossBitfields >= 2 /\ (settled9.newOrderCrossBitfield2 # << >> /\ settled9.newOrderCrossBitfield2[1] % 2 > 0) THEN (IF settled9.autoMatch = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled9.autoMatch) ELSE << >>]
        settled11 == [settled10 EXCEPT !.autoMatchPrice = IF settled10.numberOfNewOrderCrossBitfields >= 2 /\ (settled10.newOrderCrossBitfield2 # << >> /\ (settled10.newOrderCrossBitfield2[1] \div 2) % 2 > 0) THEN (IF settled10.autoMatchPrice = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled10.autoMatchPrice) ELSE << >>]
        settled12 == [settled11 EXCEPT !.lastPriority = IF settled11.numberOfNewOrderCrossBitfields >= 2 /\ (settled11.newOrderCrossBitfield2 # << >> /\ (settled11.newOrderCrossBitfield2[1] \div 4) % 2 > 0) THEN (IF settled11.lastPriority = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled11.lastPriority) ELSE << >>]
        settled13 == [settled12 EXCEPT !.drillThruProtection = IF settled12.numberOfNewOrderCrossBitfields >= 3 /\ (settled12.newOrderCrossBitfield3 # << >> /\ (settled12.newOrderCrossBitfield3[1] \div 32) % 2 > 0) THEN (IF settled12.drillThruProtection = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled12.drillThruProtection) ELSE << >>]
        settled14 == [settled13 EXCEPT !.extExecInst = IF settled13.numberOfNewOrderCrossBitfields >= 3 /\ (settled13.newOrderCrossBitfield3 # << >> /\ (settled13.newOrderCrossBitfield3[1] \div 64) % 2 > 0) THEN (IF settled13.extExecInst = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled13.extExecInst) ELSE << >>]
    IN  settled14

ZeroNewOrderCrossMessage ==
    SettleNewOrderCrossMessage([ crossId                        |-> [i \in 1 .. 20 |-> 0],
                                 crossType                      |-> [i \in 1 .. 1 |-> 0],
                                 crossPrioritization            |-> [i \in 1 .. 1 |-> 0],
                                 price                          |-> [i \in 1 .. 8 |-> 0],
                                 orderQty                       |-> [i \in 1 .. 4 |-> 0],
                                 numberOfNewOrderCrossBitfields |-> 0,
                                 newOrderCrossBitfield1         |-> << >>,
                                 newOrderCrossBitfield2         |-> << >>,
                                 newOrderCrossBitfield3         |-> << >>,
                                 orderAllocations               |-> << >>,
                                 symbolLong                     |-> << >>,
                                 idSource                       |-> << >>,
                                 securityId                     |-> << >>,
                                 liquidityProvision             |-> << >>,
                                 preventMatch                   |-> << >>,
                                 autoMatch                      |-> << >>,
                                 autoMatchPrice                 |-> << >>,
                                 lastPriority                   |-> << >>,
                                 drillThruProtection            |-> << >>,
                                 extExecInst                    |-> << >> ])

(* New Order Cross Message at zero, then each field in turn at the values it is checked at *)
CheckedNewOrderCrossMessage ==
    { ZeroNewOrderCrossMessage }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.crossId = one]) : one \in Sample(20) }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.crossType = one]) : one \in Sample(1) }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.crossPrioritization = one]) : one \in Sample(1) }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.price = one]) : one \in Sample(8) }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.orderQty = one]) : one \in Sample(4) }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = one]) : one \in {0, 1, 255} }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 1, !.newOrderCrossBitfield1 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 2, !.newOrderCrossBitfield2 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 3, !.newOrderCrossBitfield3 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.orderAllocations = one]) : one \in SampleLists(OneOrderAllocations) }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 2, !.newOrderCrossBitfield2 = <<8>>, !.orderAllocations = one]) : one \in SampleLists(OneOrderAllocations) }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 2, !.newOrderCrossBitfield2 = <<32>>, !.orderAllocations = one]) : one \in SampleLists(OneOrderAllocations) }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 3, !.newOrderCrossBitfield3 = <<16>>, !.orderAllocations = one]) : one \in SampleLists(OneOrderAllocations) }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 1, !.newOrderCrossBitfield1 = <<8>>, !.orderAllocations = one]) : one \in SampleLists(OneOrderAllocations) }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 1, !.newOrderCrossBitfield1 = <<32>>, !.orderAllocations = one]) : one \in SampleLists(OneOrderAllocations) }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 1, !.newOrderCrossBitfield1 = <<64>>, !.orderAllocations = one]) : one \in SampleLists(OneOrderAllocations) }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 2, !.newOrderCrossBitfield2 = <<64>>, !.orderAllocations = one]) : one \in SampleLists(OneOrderAllocations) }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 2, !.newOrderCrossBitfield2 = <<128>>, !.orderAllocations = one]) : one \in SampleLists(OneOrderAllocations) }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 3, !.newOrderCrossBitfield3 = <<1>>, !.orderAllocations = one]) : one \in SampleLists(OneOrderAllocations) }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 3, !.newOrderCrossBitfield3 = <<2>>, !.orderAllocations = one]) : one \in SampleLists(OneOrderAllocations) }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 3, !.newOrderCrossBitfield3 = <<4>>, !.orderAllocations = one]) : one \in SampleLists(OneOrderAllocations) }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 3, !.newOrderCrossBitfield3 = <<8>>, !.orderAllocations = one]) : one \in SampleLists(OneOrderAllocations) }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 1, !.newOrderCrossBitfield1 = <<1>>, !.symbolLong = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 1, !.newOrderCrossBitfield1 = <<2>>, !.idSource = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 1, !.newOrderCrossBitfield1 = <<4>>, !.securityId = one]) : one \in { <<held>> : held \in Sample(16) } }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 1, !.newOrderCrossBitfield1 = <<16>>, !.liquidityProvision = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 1, !.newOrderCrossBitfield1 = <<128>>, !.preventMatch = one]) : one \in { <<held>> : held \in Sample(3) } }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 2, !.newOrderCrossBitfield2 = <<1>>, !.autoMatch = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 2, !.newOrderCrossBitfield2 = <<2>>, !.autoMatchPrice = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 2, !.newOrderCrossBitfield2 = <<4>>, !.lastPriority = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 3, !.newOrderCrossBitfield3 = <<32>>, !.drillThruProtection = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleNewOrderCrossMessage([ZeroNewOrderCrossMessage EXCEPT !.numberOfNewOrderCrossBitfields = 3, !.newOrderCrossBitfield3 = <<64>>, !.extExecInst = one]) : one \in { <<held>> : held \in Sample(1) } }

(***************************************************************************)
(* Complex Leg Order Info: 1 bytes                                         *)
(***************************************************************************)

ComplexLegOrderInfo ==
    [ legPositionEffect : Sample(1) ]

EncodeComplexLegOrderInfo(message) ==
    message.legPositionEffect

DecodeComplexLegOrderInfo(bytes) ==
    LET legPositionEffect == ReadBytes(bytes, 1) IN IF ~legPositionEffect.ok THEN Fail ELSE
    Ok([ legPositionEffect |-> legPositionEffect.value ], legPositionEffect.rest)

ZeroComplexLegOrderInfo ==
    [ legPositionEffect |-> [i \in 1 .. 1 |-> 0] ]

(* Complex Leg Order Info at zero, then each field in turn at the values it is checked at *)
CheckedComplexLegOrderInfo ==
    { ZeroComplexLegOrderInfo }
        \cup { [ZeroComplexLegOrderInfo EXCEPT !.legPositionEffect = one] : one \in Sample(1) }

(* A run of Complex Leg Order Info, written one after another *)
RECURSIVE EncodeComplexLegOrderInfoList(_)
EncodeComplexLegOrderInfoList(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeComplexLegOrderInfo(Head(messages)) \o EncodeComplexLegOrderInfoList(Tail(messages))

(* As many Complex Leg Order Info as the field that counts them says *)
RECURSIVE ReadComplexLegOrderInfoList(_, _)
ReadComplexLegOrderInfoList(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeComplexLegOrderInfo(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadComplexLegOrderInfoList(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Complex Leg Order Info of each kind, for the lists that carry them *)
OneComplexLegOrderInfo == { ZeroComplexLegOrderInfo }

(***************************************************************************)
(* New Complex Order Message                                               *)
(***************************************************************************)

NewComplexOrderMessage ==
    [ clOrdId                          : Sample(20),
      side                             : Sample(1),
      orderQty                         : Sample(4),
      numberOfNewComplexOrderBitfields : 0 .. 255,
      newComplexOrderBitfield1         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      newComplexOrderBitfield2         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      newComplexOrderBitfield3         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      newComplexOrderBitfield4         : { << >> } \cup { <<held>> : held \in Sample(1) },
      newComplexOrderBitfield5         : { << >> } \cup { <<held>> : held \in Sample(1) },
      newComplexOrderBitfield6         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      newComplexOrderBitfield7         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      newComplexOrderBitfield8         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      complexLegOrderInfo              : SampleLists(OneComplexLegOrderInfo),
      clearingFirm                     : { << >> } \cup { <<held>> : held \in Sample(4) },
      clearingAccount                  : { << >> } \cup { <<held>> : held \in Sample(4) },
      price                            : { << >> } \cup { <<held>> : held \in Sample(8) },
      ordType                          : { << >> } \cup { <<held>> : held \in Sample(1) },
      timeInForce                      : { << >> } \cup { <<held>> : held \in Sample(1) },
      symbolLong                       : { << >> } \cup { <<held>> : held \in Sample(8) },
      capacity                         : { << >> } \cup { <<held>> : held \in Sample(1) },
      routingInst                      : { << >> } \cup { <<held>> : held \in Sample(4) },
      account                          : { << >> } \cup { <<held>> : held \in Sample(16) },
      preventMatch                     : { << >> } \cup { <<held>> : held \in Sample(3) },
      expireTime                       : { << >> } \cup { <<held>> : held \in Sample(8) },
      auctionId                        : { << >> } \cup { <<held>> : held \in Sample(8) },
      drillThruProtection              : { << >> } \cup { <<held>> : held \in Sample(8) },
      riskReset                        : { << >> } \cup { <<held>> : held \in Sample(8) },
      customGroupId                    : { << >> } \cup { <<held>> : held \in Sample(2) },
      liquidityProvision               : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderOrigination                 : { << >> } \cup { <<held>> : held \in Sample(1) },
      algorithmicIndicator             : { << >> } \cup { <<held>> : held \in Sample(1) },
      clientId                         : { << >> } \cup { <<held>> : held \in Sample(4) },
      clientQualifiedRole              : { << >> } \cup { <<held>> : held \in Sample(1) },
      investorId                       : { << >> } \cup { <<held>> : held \in Sample(4) },
      investorQualifiedRole            : { << >> } \cup { <<held>> : held \in Sample(1) },
      executorId                       : { << >> } \cup { <<held>> : held \in Sample(4) },
      executorQualifiedRole            : { << >> } \cup { <<held>> : held \in Sample(1) },
      custOrderHandlingInst            : { << >> } \cup { <<held>> : held \in Sample(1) },
      accountType                      : { << >> } \cup { <<held>> : held \in Sample(1) },
      displayIndicator                 : { << >> } \cup { <<held>> : held \in Sample(1) },
      extExecInst                      : { << >> } \cup { <<held>> : held \in Sample(1) } ]

EncodeNewComplexOrderMessage(message) ==
    message.clOrdId
        \o message.side
        \o message.orderQty
        \o EncodeUIntBE(message.numberOfNewComplexOrderBitfields, 1)
        \o (IF message.newComplexOrderBitfield1 = << >> THEN << >> ELSE EncodeUIntLE(message.newComplexOrderBitfield1[1], 1))
        \o (IF message.newComplexOrderBitfield2 = << >> THEN << >> ELSE EncodeUIntLE(message.newComplexOrderBitfield2[1], 1))
        \o (IF message.newComplexOrderBitfield3 = << >> THEN << >> ELSE EncodeUIntLE(message.newComplexOrderBitfield3[1], 1))
        \o (IF message.newComplexOrderBitfield4 = << >> THEN << >> ELSE message.newComplexOrderBitfield4[1])
        \o (IF message.newComplexOrderBitfield5 = << >> THEN << >> ELSE message.newComplexOrderBitfield5[1])
        \o (IF message.newComplexOrderBitfield6 = << >> THEN << >> ELSE EncodeUIntLE(message.newComplexOrderBitfield6[1], 1))
        \o (IF message.newComplexOrderBitfield7 = << >> THEN << >> ELSE EncodeUIntLE(message.newComplexOrderBitfield7[1], 1))
        \o (IF message.newComplexOrderBitfield8 = << >> THEN << >> ELSE EncodeUIntLE(message.newComplexOrderBitfield8[1], 1))
        \o EncodeUIntBE(Len(message.complexLegOrderInfo), 1)
        \o EncodeComplexLegOrderInfoList(message.complexLegOrderInfo)
        \o (IF message.clearingFirm = << >> THEN << >> ELSE message.clearingFirm[1])
        \o (IF message.clearingAccount = << >> THEN << >> ELSE message.clearingAccount[1])
        \o (IF message.price = << >> THEN << >> ELSE message.price[1])
        \o (IF message.ordType = << >> THEN << >> ELSE message.ordType[1])
        \o (IF message.timeInForce = << >> THEN << >> ELSE message.timeInForce[1])
        \o (IF message.symbolLong = << >> THEN << >> ELSE message.symbolLong[1])
        \o (IF message.capacity = << >> THEN << >> ELSE message.capacity[1])
        \o (IF message.routingInst = << >> THEN << >> ELSE message.routingInst[1])
        \o (IF message.account = << >> THEN << >> ELSE message.account[1])
        \o (IF message.preventMatch = << >> THEN << >> ELSE message.preventMatch[1])
        \o (IF message.expireTime = << >> THEN << >> ELSE message.expireTime[1])
        \o (IF message.auctionId = << >> THEN << >> ELSE message.auctionId[1])
        \o (IF message.drillThruProtection = << >> THEN << >> ELSE message.drillThruProtection[1])
        \o (IF message.riskReset = << >> THEN << >> ELSE message.riskReset[1])
        \o (IF message.customGroupId = << >> THEN << >> ELSE message.customGroupId[1])
        \o (IF message.liquidityProvision = << >> THEN << >> ELSE message.liquidityProvision[1])
        \o (IF message.orderOrigination = << >> THEN << >> ELSE message.orderOrigination[1])
        \o (IF message.algorithmicIndicator = << >> THEN << >> ELSE message.algorithmicIndicator[1])
        \o (IF message.clientId = << >> THEN << >> ELSE message.clientId[1])
        \o (IF message.clientQualifiedRole = << >> THEN << >> ELSE message.clientQualifiedRole[1])
        \o (IF message.investorId = << >> THEN << >> ELSE message.investorId[1])
        \o (IF message.investorQualifiedRole = << >> THEN << >> ELSE message.investorQualifiedRole[1])
        \o (IF message.executorId = << >> THEN << >> ELSE message.executorId[1])
        \o (IF message.executorQualifiedRole = << >> THEN << >> ELSE message.executorQualifiedRole[1])
        \o (IF message.custOrderHandlingInst = << >> THEN << >> ELSE message.custOrderHandlingInst[1])
        \o (IF message.accountType = << >> THEN << >> ELSE message.accountType[1])
        \o (IF message.displayIndicator = << >> THEN << >> ELSE message.displayIndicator[1])
        \o (IF message.extExecInst = << >> THEN << >> ELSE message.extExecInst[1])

DecodeNewComplexOrderMessage(bytes) ==
    LET clOrdId == ReadBytes(bytes, 20) IN IF ~clOrdId.ok THEN Fail ELSE
    LET side == ReadBytes(clOrdId.rest, 1) IN IF ~side.ok THEN Fail ELSE
    LET orderQty == ReadBytes(side.rest, 4) IN IF ~orderQty.ok THEN Fail ELSE
    LET numberOfNewComplexOrderBitfields == ReadUIntBE(orderQty.rest, 1) IN IF ~numberOfNewComplexOrderBitfields.ok THEN Fail ELSE
    LET newComplexOrderBitfield1 == ReadWhen(numberOfNewComplexOrderBitfields.value >= 1, ReadUIntLE(numberOfNewComplexOrderBitfields.rest, 1), numberOfNewComplexOrderBitfields.rest) IN IF ~newComplexOrderBitfield1.ok THEN Fail ELSE
    LET newComplexOrderBitfield2 == ReadWhen(numberOfNewComplexOrderBitfields.value >= 2, ReadUIntLE(newComplexOrderBitfield1.rest, 1), newComplexOrderBitfield1.rest) IN IF ~newComplexOrderBitfield2.ok THEN Fail ELSE
    LET newComplexOrderBitfield3 == ReadWhen(numberOfNewComplexOrderBitfields.value >= 3, ReadUIntLE(newComplexOrderBitfield2.rest, 1), newComplexOrderBitfield2.rest) IN IF ~newComplexOrderBitfield3.ok THEN Fail ELSE
    LET newComplexOrderBitfield4 == ReadWhen(numberOfNewComplexOrderBitfields.value >= 4, ReadBytes(newComplexOrderBitfield3.rest, 1), newComplexOrderBitfield3.rest) IN IF ~newComplexOrderBitfield4.ok THEN Fail ELSE
    LET newComplexOrderBitfield5 == ReadWhen(numberOfNewComplexOrderBitfields.value >= 5, ReadBytes(newComplexOrderBitfield4.rest, 1), newComplexOrderBitfield4.rest) IN IF ~newComplexOrderBitfield5.ok THEN Fail ELSE
    LET newComplexOrderBitfield6 == ReadWhen(numberOfNewComplexOrderBitfields.value >= 6, ReadUIntLE(newComplexOrderBitfield5.rest, 1), newComplexOrderBitfield5.rest) IN IF ~newComplexOrderBitfield6.ok THEN Fail ELSE
    LET newComplexOrderBitfield7 == ReadWhen(numberOfNewComplexOrderBitfields.value >= 7, ReadUIntLE(newComplexOrderBitfield6.rest, 1), newComplexOrderBitfield6.rest) IN IF ~newComplexOrderBitfield7.ok THEN Fail ELSE
    LET newComplexOrderBitfield8 == ReadWhen(numberOfNewComplexOrderBitfields.value >= 8, ReadUIntLE(newComplexOrderBitfield7.rest, 1), newComplexOrderBitfield7.rest) IN IF ~newComplexOrderBitfield8.ok THEN Fail ELSE
    LET noLegs == ReadUIntBE(newComplexOrderBitfield8.rest, 1) IN IF ~noLegs.ok THEN Fail ELSE
    LET complexLegOrderInfo == ReadComplexLegOrderInfoList(noLegs.rest, noLegs.value) IN IF ~complexLegOrderInfo.ok THEN Fail ELSE
    LET clearingFirm == ReadWhen(numberOfNewComplexOrderBitfields.value >= 1 /\ (newComplexOrderBitfield1.value # << >> /\ newComplexOrderBitfield1.value[1] % 2 > 0), ReadBytes(complexLegOrderInfo.rest, 4), complexLegOrderInfo.rest) IN IF ~clearingFirm.ok THEN Fail ELSE
    LET clearingAccount == ReadWhen(numberOfNewComplexOrderBitfields.value >= 1 /\ (newComplexOrderBitfield1.value # << >> /\ (newComplexOrderBitfield1.value[1] \div 2) % 2 > 0), ReadBytes(clearingFirm.rest, 4), clearingFirm.rest) IN IF ~clearingAccount.ok THEN Fail ELSE
    LET price == ReadWhen(numberOfNewComplexOrderBitfields.value >= 1 /\ (newComplexOrderBitfield1.value # << >> /\ (newComplexOrderBitfield1.value[1] \div 4) % 2 > 0), ReadBytes(clearingAccount.rest, 8), clearingAccount.rest) IN IF ~price.ok THEN Fail ELSE
    LET ordType == ReadWhen(numberOfNewComplexOrderBitfields.value >= 1 /\ (newComplexOrderBitfield1.value # << >> /\ (newComplexOrderBitfield1.value[1] \div 8) % 2 > 0), ReadBytes(price.rest, 1), price.rest) IN IF ~ordType.ok THEN Fail ELSE
    LET timeInForce == ReadWhen(numberOfNewComplexOrderBitfields.value >= 1 /\ (newComplexOrderBitfield1.value # << >> /\ (newComplexOrderBitfield1.value[1] \div 16) % 2 > 0), ReadBytes(ordType.rest, 1), ordType.rest) IN IF ~timeInForce.ok THEN Fail ELSE
    LET symbolLong == ReadWhen(numberOfNewComplexOrderBitfields.value >= 1 /\ (newComplexOrderBitfield1.value # << >> /\ (newComplexOrderBitfield1.value[1] \div 32) % 2 > 0), ReadBytes(timeInForce.rest, 8), timeInForce.rest) IN IF ~symbolLong.ok THEN Fail ELSE
    LET capacity == ReadWhen(numberOfNewComplexOrderBitfields.value >= 1 /\ (newComplexOrderBitfield1.value # << >> /\ (newComplexOrderBitfield1.value[1] \div 64) % 2 > 0), ReadBytes(symbolLong.rest, 1), symbolLong.rest) IN IF ~capacity.ok THEN Fail ELSE
    LET routingInst == ReadWhen(numberOfNewComplexOrderBitfields.value >= 1 /\ (newComplexOrderBitfield1.value # << >> /\ (newComplexOrderBitfield1.value[1] \div 128) % 2 > 0), ReadBytes(capacity.rest, 4), capacity.rest) IN IF ~routingInst.ok THEN Fail ELSE
    LET account == ReadWhen(numberOfNewComplexOrderBitfields.value >= 2 /\ (newComplexOrderBitfield2.value # << >> /\ newComplexOrderBitfield2.value[1] % 2 > 0), ReadBytes(routingInst.rest, 16), routingInst.rest) IN IF ~account.ok THEN Fail ELSE
    LET preventMatch == ReadWhen(numberOfNewComplexOrderBitfields.value >= 2 /\ (newComplexOrderBitfield2.value # << >> /\ (newComplexOrderBitfield2.value[1] \div 2) % 2 > 0), ReadBytes(account.rest, 3), account.rest) IN IF ~preventMatch.ok THEN Fail ELSE
    LET expireTime == ReadWhen(numberOfNewComplexOrderBitfields.value >= 2 /\ (newComplexOrderBitfield2.value # << >> /\ (newComplexOrderBitfield2.value[1] \div 4) % 2 > 0), ReadBytes(preventMatch.rest, 8), preventMatch.rest) IN IF ~expireTime.ok THEN Fail ELSE
    LET auctionId == ReadWhen(numberOfNewComplexOrderBitfields.value >= 2 /\ (newComplexOrderBitfield2.value # << >> /\ (newComplexOrderBitfield2.value[1] \div 128) % 2 > 0), ReadBytes(expireTime.rest, 8), expireTime.rest) IN IF ~auctionId.ok THEN Fail ELSE
    LET drillThruProtection == ReadWhen(numberOfNewComplexOrderBitfields.value >= 3 /\ (newComplexOrderBitfield3.value # << >> /\ (newComplexOrderBitfield3.value[1] \div 2) % 2 > 0), ReadBytes(auctionId.rest, 8), auctionId.rest) IN IF ~drillThruProtection.ok THEN Fail ELSE
    LET riskReset == ReadWhen(numberOfNewComplexOrderBitfields.value >= 3 /\ (newComplexOrderBitfield3.value # << >> /\ (newComplexOrderBitfield3.value[1] \div 4) % 2 > 0), ReadBytes(drillThruProtection.rest, 8), drillThruProtection.rest) IN IF ~riskReset.ok THEN Fail ELSE
    LET customGroupId == ReadWhen(numberOfNewComplexOrderBitfields.value >= 3 /\ (newComplexOrderBitfield3.value # << >> /\ (newComplexOrderBitfield3.value[1] \div 8) % 2 > 0), ReadBytes(riskReset.rest, 2), riskReset.rest) IN IF ~customGroupId.ok THEN Fail ELSE
    LET liquidityProvision == ReadWhen(numberOfNewComplexOrderBitfields.value >= 6 /\ (newComplexOrderBitfield6.value # << >> /\ (newComplexOrderBitfield6.value[1] \div 8) % 2 > 0), ReadBytes(customGroupId.rest, 1), customGroupId.rest) IN IF ~liquidityProvision.ok THEN Fail ELSE
    LET orderOrigination == ReadWhen(numberOfNewComplexOrderBitfields.value >= 6 /\ (newComplexOrderBitfield6.value # << >> /\ (newComplexOrderBitfield6.value[1] \div 16) % 2 > 0), ReadBytes(liquidityProvision.rest, 1), liquidityProvision.rest) IN IF ~orderOrigination.ok THEN Fail ELSE
    LET algorithmicIndicator == ReadWhen(numberOfNewComplexOrderBitfields.value >= 6 /\ (newComplexOrderBitfield6.value # << >> /\ (newComplexOrderBitfield6.value[1] \div 32) % 2 > 0), ReadBytes(orderOrigination.rest, 1), orderOrigination.rest) IN IF ~algorithmicIndicator.ok THEN Fail ELSE
    LET clientId == ReadWhen(numberOfNewComplexOrderBitfields.value >= 6 /\ (newComplexOrderBitfield6.value # << >> /\ (newComplexOrderBitfield6.value[1] \div 64) % 2 > 0), ReadBytes(algorithmicIndicator.rest, 4), algorithmicIndicator.rest) IN IF ~clientId.ok THEN Fail ELSE
    LET clientQualifiedRole == ReadWhen(numberOfNewComplexOrderBitfields.value >= 6 /\ (newComplexOrderBitfield6.value # << >> /\ (newComplexOrderBitfield6.value[1] \div 128) % 2 > 0), ReadBytes(clientId.rest, 1), clientId.rest) IN IF ~clientQualifiedRole.ok THEN Fail ELSE
    LET investorId == ReadWhen(numberOfNewComplexOrderBitfields.value >= 7 /\ (newComplexOrderBitfield7.value # << >> /\ newComplexOrderBitfield7.value[1] % 2 > 0), ReadBytes(clientQualifiedRole.rest, 4), clientQualifiedRole.rest) IN IF ~investorId.ok THEN Fail ELSE
    LET investorQualifiedRole == ReadWhen(numberOfNewComplexOrderBitfields.value >= 7 /\ (newComplexOrderBitfield7.value # << >> /\ (newComplexOrderBitfield7.value[1] \div 2) % 2 > 0), ReadBytes(investorId.rest, 1), investorId.rest) IN IF ~investorQualifiedRole.ok THEN Fail ELSE
    LET executorId == ReadWhen(numberOfNewComplexOrderBitfields.value >= 7 /\ (newComplexOrderBitfield7.value # << >> /\ (newComplexOrderBitfield7.value[1] \div 4) % 2 > 0), ReadBytes(investorQualifiedRole.rest, 4), investorQualifiedRole.rest) IN IF ~executorId.ok THEN Fail ELSE
    LET executorQualifiedRole == ReadWhen(numberOfNewComplexOrderBitfields.value >= 7 /\ (newComplexOrderBitfield7.value # << >> /\ (newComplexOrderBitfield7.value[1] \div 8) % 2 > 0), ReadBytes(executorId.rest, 1), executorId.rest) IN IF ~executorQualifiedRole.ok THEN Fail ELSE
    LET custOrderHandlingInst == ReadWhen(numberOfNewComplexOrderBitfields.value >= 7 /\ (newComplexOrderBitfield7.value # << >> /\ (newComplexOrderBitfield7.value[1] \div 16) % 2 > 0), ReadBytes(executorQualifiedRole.rest, 1), executorQualifiedRole.rest) IN IF ~custOrderHandlingInst.ok THEN Fail ELSE
    LET accountType == ReadWhen(numberOfNewComplexOrderBitfields.value >= 7 /\ (newComplexOrderBitfield7.value # << >> /\ (newComplexOrderBitfield7.value[1] \div 32) % 2 > 0), ReadBytes(custOrderHandlingInst.rest, 1), custOrderHandlingInst.rest) IN IF ~accountType.ok THEN Fail ELSE
    LET displayIndicator == ReadWhen(numberOfNewComplexOrderBitfields.value >= 7 /\ (newComplexOrderBitfield7.value # << >> /\ (newComplexOrderBitfield7.value[1] \div 64) % 2 > 0), ReadBytes(accountType.rest, 1), accountType.rest) IN IF ~displayIndicator.ok THEN Fail ELSE
    LET extExecInst == ReadWhen(numberOfNewComplexOrderBitfields.value >= 8 /\ (newComplexOrderBitfield8.value # << >> /\ newComplexOrderBitfield8.value[1] % 2 > 0), ReadBytes(displayIndicator.rest, 1), displayIndicator.rest) IN IF ~extExecInst.ok THEN Fail ELSE
    Ok([ clOrdId                          |-> clOrdId.value,
         side                             |-> side.value,
         orderQty                         |-> orderQty.value,
         numberOfNewComplexOrderBitfields |-> numberOfNewComplexOrderBitfields.value,
         newComplexOrderBitfield1         |-> newComplexOrderBitfield1.value,
         newComplexOrderBitfield2         |-> newComplexOrderBitfield2.value,
         newComplexOrderBitfield3         |-> newComplexOrderBitfield3.value,
         newComplexOrderBitfield4         |-> newComplexOrderBitfield4.value,
         newComplexOrderBitfield5         |-> newComplexOrderBitfield5.value,
         newComplexOrderBitfield6         |-> newComplexOrderBitfield6.value,
         newComplexOrderBitfield7         |-> newComplexOrderBitfield7.value,
         newComplexOrderBitfield8         |-> newComplexOrderBitfield8.value,
         complexLegOrderInfo              |-> complexLegOrderInfo.value,
         clearingFirm                     |-> clearingFirm.value,
         clearingAccount                  |-> clearingAccount.value,
         price                            |-> price.value,
         ordType                          |-> ordType.value,
         timeInForce                      |-> timeInForce.value,
         symbolLong                       |-> symbolLong.value,
         capacity                         |-> capacity.value,
         routingInst                      |-> routingInst.value,
         account                          |-> account.value,
         preventMatch                     |-> preventMatch.value,
         expireTime                       |-> expireTime.value,
         auctionId                        |-> auctionId.value,
         drillThruProtection              |-> drillThruProtection.value,
         riskReset                        |-> riskReset.value,
         customGroupId                    |-> customGroupId.value,
         liquidityProvision               |-> liquidityProvision.value,
         orderOrigination                 |-> orderOrigination.value,
         algorithmicIndicator             |-> algorithmicIndicator.value,
         clientId                         |-> clientId.value,
         clientQualifiedRole              |-> clientQualifiedRole.value,
         investorId                       |-> investorId.value,
         investorQualifiedRole            |-> investorQualifiedRole.value,
         executorId                       |-> executorId.value,
         executorQualifiedRole            |-> executorQualifiedRole.value,
         custOrderHandlingInst            |-> custOrderHandlingInst.value,
         accountType                      |-> accountType.value,
         displayIndicator                 |-> displayIndicator.value,
         extExecInst                      |-> extExecInst.value ], extExecInst.rest)

(* New Complex Order Message with each field marked present by fields before it there exactly where they say *)
SettleNewComplexOrderMessage(message) ==
    LET settled1 == [message EXCEPT !.newComplexOrderBitfield1 = IF message.numberOfNewComplexOrderBitfields >= 1 THEN (IF message.newComplexOrderBitfield1 = << >> THEN <<0>> ELSE message.newComplexOrderBitfield1) ELSE << >>]
        settled2 == [settled1 EXCEPT !.newComplexOrderBitfield2 = IF settled1.numberOfNewComplexOrderBitfields >= 2 THEN (IF settled1.newComplexOrderBitfield2 = << >> THEN <<0>> ELSE settled1.newComplexOrderBitfield2) ELSE << >>]
        settled3 == [settled2 EXCEPT !.newComplexOrderBitfield3 = IF settled2.numberOfNewComplexOrderBitfields >= 3 THEN (IF settled2.newComplexOrderBitfield3 = << >> THEN <<0>> ELSE settled2.newComplexOrderBitfield3) ELSE << >>]
        settled4 == [settled3 EXCEPT !.newComplexOrderBitfield4 = IF settled3.numberOfNewComplexOrderBitfields >= 4 THEN (IF settled3.newComplexOrderBitfield4 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled3.newComplexOrderBitfield4) ELSE << >>]
        settled5 == [settled4 EXCEPT !.newComplexOrderBitfield5 = IF settled4.numberOfNewComplexOrderBitfields >= 5 THEN (IF settled4.newComplexOrderBitfield5 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled4.newComplexOrderBitfield5) ELSE << >>]
        settled6 == [settled5 EXCEPT !.newComplexOrderBitfield6 = IF settled5.numberOfNewComplexOrderBitfields >= 6 THEN (IF settled5.newComplexOrderBitfield6 = << >> THEN <<0>> ELSE settled5.newComplexOrderBitfield6) ELSE << >>]
        settled7 == [settled6 EXCEPT !.newComplexOrderBitfield7 = IF settled6.numberOfNewComplexOrderBitfields >= 7 THEN (IF settled6.newComplexOrderBitfield7 = << >> THEN <<0>> ELSE settled6.newComplexOrderBitfield7) ELSE << >>]
        settled8 == [settled7 EXCEPT !.newComplexOrderBitfield8 = IF settled7.numberOfNewComplexOrderBitfields >= 8 THEN (IF settled7.newComplexOrderBitfield8 = << >> THEN <<0>> ELSE settled7.newComplexOrderBitfield8) ELSE << >>]
        settled9 == [settled8 EXCEPT !.clearingFirm = IF settled8.numberOfNewComplexOrderBitfields >= 1 /\ (settled8.newComplexOrderBitfield1 # << >> /\ settled8.newComplexOrderBitfield1[1] % 2 > 0) THEN (IF settled8.clearingFirm = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled8.clearingFirm) ELSE << >>]
        settled10 == [settled9 EXCEPT !.clearingAccount = IF settled9.numberOfNewComplexOrderBitfields >= 1 /\ (settled9.newComplexOrderBitfield1 # << >> /\ (settled9.newComplexOrderBitfield1[1] \div 2) % 2 > 0) THEN (IF settled9.clearingAccount = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled9.clearingAccount) ELSE << >>]
        settled11 == [settled10 EXCEPT !.price = IF settled10.numberOfNewComplexOrderBitfields >= 1 /\ (settled10.newComplexOrderBitfield1 # << >> /\ (settled10.newComplexOrderBitfield1[1] \div 4) % 2 > 0) THEN (IF settled10.price = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled10.price) ELSE << >>]
        settled12 == [settled11 EXCEPT !.ordType = IF settled11.numberOfNewComplexOrderBitfields >= 1 /\ (settled11.newComplexOrderBitfield1 # << >> /\ (settled11.newComplexOrderBitfield1[1] \div 8) % 2 > 0) THEN (IF settled11.ordType = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled11.ordType) ELSE << >>]
        settled13 == [settled12 EXCEPT !.timeInForce = IF settled12.numberOfNewComplexOrderBitfields >= 1 /\ (settled12.newComplexOrderBitfield1 # << >> /\ (settled12.newComplexOrderBitfield1[1] \div 16) % 2 > 0) THEN (IF settled12.timeInForce = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled12.timeInForce) ELSE << >>]
        settled14 == [settled13 EXCEPT !.symbolLong = IF settled13.numberOfNewComplexOrderBitfields >= 1 /\ (settled13.newComplexOrderBitfield1 # << >> /\ (settled13.newComplexOrderBitfield1[1] \div 32) % 2 > 0) THEN (IF settled13.symbolLong = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled13.symbolLong) ELSE << >>]
        settled15 == [settled14 EXCEPT !.capacity = IF settled14.numberOfNewComplexOrderBitfields >= 1 /\ (settled14.newComplexOrderBitfield1 # << >> /\ (settled14.newComplexOrderBitfield1[1] \div 64) % 2 > 0) THEN (IF settled14.capacity = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled14.capacity) ELSE << >>]
        settled16 == [settled15 EXCEPT !.routingInst = IF settled15.numberOfNewComplexOrderBitfields >= 1 /\ (settled15.newComplexOrderBitfield1 # << >> /\ (settled15.newComplexOrderBitfield1[1] \div 128) % 2 > 0) THEN (IF settled15.routingInst = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled15.routingInst) ELSE << >>]
        settled17 == [settled16 EXCEPT !.account = IF settled16.numberOfNewComplexOrderBitfields >= 2 /\ (settled16.newComplexOrderBitfield2 # << >> /\ settled16.newComplexOrderBitfield2[1] % 2 > 0) THEN (IF settled16.account = << >> THEN <<[i \in 1 .. 16 |-> 0]>> ELSE settled16.account) ELSE << >>]
        settled18 == [settled17 EXCEPT !.preventMatch = IF settled17.numberOfNewComplexOrderBitfields >= 2 /\ (settled17.newComplexOrderBitfield2 # << >> /\ (settled17.newComplexOrderBitfield2[1] \div 2) % 2 > 0) THEN (IF settled17.preventMatch = << >> THEN <<[i \in 1 .. 3 |-> 0]>> ELSE settled17.preventMatch) ELSE << >>]
        settled19 == [settled18 EXCEPT !.expireTime = IF settled18.numberOfNewComplexOrderBitfields >= 2 /\ (settled18.newComplexOrderBitfield2 # << >> /\ (settled18.newComplexOrderBitfield2[1] \div 4) % 2 > 0) THEN (IF settled18.expireTime = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled18.expireTime) ELSE << >>]
        settled20 == [settled19 EXCEPT !.auctionId = IF settled19.numberOfNewComplexOrderBitfields >= 2 /\ (settled19.newComplexOrderBitfield2 # << >> /\ (settled19.newComplexOrderBitfield2[1] \div 128) % 2 > 0) THEN (IF settled19.auctionId = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled19.auctionId) ELSE << >>]
        settled21 == [settled20 EXCEPT !.drillThruProtection = IF settled20.numberOfNewComplexOrderBitfields >= 3 /\ (settled20.newComplexOrderBitfield3 # << >> /\ (settled20.newComplexOrderBitfield3[1] \div 2) % 2 > 0) THEN (IF settled20.drillThruProtection = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled20.drillThruProtection) ELSE << >>]
        settled22 == [settled21 EXCEPT !.riskReset = IF settled21.numberOfNewComplexOrderBitfields >= 3 /\ (settled21.newComplexOrderBitfield3 # << >> /\ (settled21.newComplexOrderBitfield3[1] \div 4) % 2 > 0) THEN (IF settled21.riskReset = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled21.riskReset) ELSE << >>]
        settled23 == [settled22 EXCEPT !.customGroupId = IF settled22.numberOfNewComplexOrderBitfields >= 3 /\ (settled22.newComplexOrderBitfield3 # << >> /\ (settled22.newComplexOrderBitfield3[1] \div 8) % 2 > 0) THEN (IF settled22.customGroupId = << >> THEN <<[i \in 1 .. 2 |-> 0]>> ELSE settled22.customGroupId) ELSE << >>]
        settled24 == [settled23 EXCEPT !.liquidityProvision = IF settled23.numberOfNewComplexOrderBitfields >= 6 /\ (settled23.newComplexOrderBitfield6 # << >> /\ (settled23.newComplexOrderBitfield6[1] \div 8) % 2 > 0) THEN (IF settled23.liquidityProvision = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled23.liquidityProvision) ELSE << >>]
        settled25 == [settled24 EXCEPT !.orderOrigination = IF settled24.numberOfNewComplexOrderBitfields >= 6 /\ (settled24.newComplexOrderBitfield6 # << >> /\ (settled24.newComplexOrderBitfield6[1] \div 16) % 2 > 0) THEN (IF settled24.orderOrigination = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled24.orderOrigination) ELSE << >>]
        settled26 == [settled25 EXCEPT !.algorithmicIndicator = IF settled25.numberOfNewComplexOrderBitfields >= 6 /\ (settled25.newComplexOrderBitfield6 # << >> /\ (settled25.newComplexOrderBitfield6[1] \div 32) % 2 > 0) THEN (IF settled25.algorithmicIndicator = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled25.algorithmicIndicator) ELSE << >>]
        settled27 == [settled26 EXCEPT !.clientId = IF settled26.numberOfNewComplexOrderBitfields >= 6 /\ (settled26.newComplexOrderBitfield6 # << >> /\ (settled26.newComplexOrderBitfield6[1] \div 64) % 2 > 0) THEN (IF settled26.clientId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled26.clientId) ELSE << >>]
        settled28 == [settled27 EXCEPT !.clientQualifiedRole = IF settled27.numberOfNewComplexOrderBitfields >= 6 /\ (settled27.newComplexOrderBitfield6 # << >> /\ (settled27.newComplexOrderBitfield6[1] \div 128) % 2 > 0) THEN (IF settled27.clientQualifiedRole = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled27.clientQualifiedRole) ELSE << >>]
        settled29 == [settled28 EXCEPT !.investorId = IF settled28.numberOfNewComplexOrderBitfields >= 7 /\ (settled28.newComplexOrderBitfield7 # << >> /\ settled28.newComplexOrderBitfield7[1] % 2 > 0) THEN (IF settled28.investorId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled28.investorId) ELSE << >>]
        settled30 == [settled29 EXCEPT !.investorQualifiedRole = IF settled29.numberOfNewComplexOrderBitfields >= 7 /\ (settled29.newComplexOrderBitfield7 # << >> /\ (settled29.newComplexOrderBitfield7[1] \div 2) % 2 > 0) THEN (IF settled29.investorQualifiedRole = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled29.investorQualifiedRole) ELSE << >>]
        settled31 == [settled30 EXCEPT !.executorId = IF settled30.numberOfNewComplexOrderBitfields >= 7 /\ (settled30.newComplexOrderBitfield7 # << >> /\ (settled30.newComplexOrderBitfield7[1] \div 4) % 2 > 0) THEN (IF settled30.executorId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled30.executorId) ELSE << >>]
        settled32 == [settled31 EXCEPT !.executorQualifiedRole = IF settled31.numberOfNewComplexOrderBitfields >= 7 /\ (settled31.newComplexOrderBitfield7 # << >> /\ (settled31.newComplexOrderBitfield7[1] \div 8) % 2 > 0) THEN (IF settled31.executorQualifiedRole = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled31.executorQualifiedRole) ELSE << >>]
        settled33 == [settled32 EXCEPT !.custOrderHandlingInst = IF settled32.numberOfNewComplexOrderBitfields >= 7 /\ (settled32.newComplexOrderBitfield7 # << >> /\ (settled32.newComplexOrderBitfield7[1] \div 16) % 2 > 0) THEN (IF settled32.custOrderHandlingInst = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled32.custOrderHandlingInst) ELSE << >>]
        settled34 == [settled33 EXCEPT !.accountType = IF settled33.numberOfNewComplexOrderBitfields >= 7 /\ (settled33.newComplexOrderBitfield7 # << >> /\ (settled33.newComplexOrderBitfield7[1] \div 32) % 2 > 0) THEN (IF settled33.accountType = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled33.accountType) ELSE << >>]
        settled35 == [settled34 EXCEPT !.displayIndicator = IF settled34.numberOfNewComplexOrderBitfields >= 7 /\ (settled34.newComplexOrderBitfield7 # << >> /\ (settled34.newComplexOrderBitfield7[1] \div 64) % 2 > 0) THEN (IF settled34.displayIndicator = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled34.displayIndicator) ELSE << >>]
        settled36 == [settled35 EXCEPT !.extExecInst = IF settled35.numberOfNewComplexOrderBitfields >= 8 /\ (settled35.newComplexOrderBitfield8 # << >> /\ settled35.newComplexOrderBitfield8[1] % 2 > 0) THEN (IF settled35.extExecInst = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled35.extExecInst) ELSE << >>]
    IN  settled36

ZeroNewComplexOrderMessage ==
    SettleNewComplexOrderMessage([ clOrdId                          |-> [i \in 1 .. 20 |-> 0],
                                   side                             |-> [i \in 1 .. 1 |-> 0],
                                   orderQty                         |-> [i \in 1 .. 4 |-> 0],
                                   numberOfNewComplexOrderBitfields |-> 0,
                                   newComplexOrderBitfield1         |-> << >>,
                                   newComplexOrderBitfield2         |-> << >>,
                                   newComplexOrderBitfield3         |-> << >>,
                                   newComplexOrderBitfield4         |-> << >>,
                                   newComplexOrderBitfield5         |-> << >>,
                                   newComplexOrderBitfield6         |-> << >>,
                                   newComplexOrderBitfield7         |-> << >>,
                                   newComplexOrderBitfield8         |-> << >>,
                                   complexLegOrderInfo              |-> << >>,
                                   clearingFirm                     |-> << >>,
                                   clearingAccount                  |-> << >>,
                                   price                            |-> << >>,
                                   ordType                          |-> << >>,
                                   timeInForce                      |-> << >>,
                                   symbolLong                       |-> << >>,
                                   capacity                         |-> << >>,
                                   routingInst                      |-> << >>,
                                   account                          |-> << >>,
                                   preventMatch                     |-> << >>,
                                   expireTime                       |-> << >>,
                                   auctionId                        |-> << >>,
                                   drillThruProtection              |-> << >>,
                                   riskReset                        |-> << >>,
                                   customGroupId                    |-> << >>,
                                   liquidityProvision               |-> << >>,
                                   orderOrigination                 |-> << >>,
                                   algorithmicIndicator             |-> << >>,
                                   clientId                         |-> << >>,
                                   clientQualifiedRole              |-> << >>,
                                   investorId                       |-> << >>,
                                   investorQualifiedRole            |-> << >>,
                                   executorId                       |-> << >>,
                                   executorQualifiedRole            |-> << >>,
                                   custOrderHandlingInst            |-> << >>,
                                   accountType                      |-> << >>,
                                   displayIndicator                 |-> << >>,
                                   extExecInst                      |-> << >> ])

(* New Complex Order Message at zero, then each field in turn at the values it is checked at *)
CheckedNewComplexOrderMessage ==
    { ZeroNewComplexOrderMessage }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.clOrdId = one]) : one \in Sample(20) }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.side = one]) : one \in Sample(1) }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.orderQty = one]) : one \in Sample(4) }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = one]) : one \in {0, 1, 255} }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 1, !.newComplexOrderBitfield1 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 2, !.newComplexOrderBitfield2 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 3, !.newComplexOrderBitfield3 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 4, !.newComplexOrderBitfield4 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 5, !.newComplexOrderBitfield5 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 6, !.newComplexOrderBitfield6 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 7, !.newComplexOrderBitfield7 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 8, !.newComplexOrderBitfield8 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.complexLegOrderInfo = one]) : one \in SampleLists(OneComplexLegOrderInfo) }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 1, !.newComplexOrderBitfield1 = <<1>>, !.clearingFirm = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 1, !.newComplexOrderBitfield1 = <<2>>, !.clearingAccount = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 1, !.newComplexOrderBitfield1 = <<4>>, !.price = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 1, !.newComplexOrderBitfield1 = <<8>>, !.ordType = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 1, !.newComplexOrderBitfield1 = <<16>>, !.timeInForce = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 1, !.newComplexOrderBitfield1 = <<32>>, !.symbolLong = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 1, !.newComplexOrderBitfield1 = <<64>>, !.capacity = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 1, !.newComplexOrderBitfield1 = <<128>>, !.routingInst = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 2, !.newComplexOrderBitfield2 = <<1>>, !.account = one]) : one \in { <<held>> : held \in Sample(16) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 2, !.newComplexOrderBitfield2 = <<2>>, !.preventMatch = one]) : one \in { <<held>> : held \in Sample(3) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 2, !.newComplexOrderBitfield2 = <<4>>, !.expireTime = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 2, !.newComplexOrderBitfield2 = <<128>>, !.auctionId = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 3, !.newComplexOrderBitfield3 = <<2>>, !.drillThruProtection = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 3, !.newComplexOrderBitfield3 = <<4>>, !.riskReset = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 3, !.newComplexOrderBitfield3 = <<8>>, !.customGroupId = one]) : one \in { <<held>> : held \in Sample(2) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 6, !.newComplexOrderBitfield6 = <<8>>, !.liquidityProvision = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 6, !.newComplexOrderBitfield6 = <<16>>, !.orderOrigination = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 6, !.newComplexOrderBitfield6 = <<32>>, !.algorithmicIndicator = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 6, !.newComplexOrderBitfield6 = <<64>>, !.clientId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 6, !.newComplexOrderBitfield6 = <<128>>, !.clientQualifiedRole = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 7, !.newComplexOrderBitfield7 = <<1>>, !.investorId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 7, !.newComplexOrderBitfield7 = <<2>>, !.investorQualifiedRole = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 7, !.newComplexOrderBitfield7 = <<4>>, !.executorId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 7, !.newComplexOrderBitfield7 = <<8>>, !.executorQualifiedRole = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 7, !.newComplexOrderBitfield7 = <<16>>, !.custOrderHandlingInst = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 7, !.newComplexOrderBitfield7 = <<32>>, !.accountType = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 7, !.newComplexOrderBitfield7 = <<64>>, !.displayIndicator = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewComplexOrderMessage([ZeroNewComplexOrderMessage EXCEPT !.numberOfNewComplexOrderBitfields = 8, !.newComplexOrderBitfield8 = <<1>>, !.extExecInst = one]) : one \in { <<held>> : held \in Sample(1) } }

(***************************************************************************)
(* New Order Cross Multileg Order Allocations                              *)
(***************************************************************************)

NewOrderCrossMultilegOrderAllocations ==
    [ side                  : Sample(1),
      allocQty              : Sample(4),
      clOrdId               : Sample(20),
      capacity              : Sample(1),
      clearingFirm          : Sample(4),
      accountType           : Sample(1),
      account               : { << >> } \cup { <<held>> : held \in Sample(16) },
      clearingAccount       : { << >> } \cup { <<held>> : held \in Sample(4) },
      legPositionEffects    : { << >> } \cup { <<held>> : held \in Sample(12) },
      custOrderHandlingInst : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderOrigination      : { << >> } \cup { <<held>> : held \in Sample(1) },
      algorithmicIndicator  : { << >> } \cup { <<held>> : held \in Sample(1) },
      clientId              : { << >> } \cup { <<held>> : held \in Sample(4) },
      clientQualifiedRole   : { << >> } \cup { <<held>> : held \in Sample(1) },
      investorId            : { << >> } \cup { <<held>> : held \in Sample(4) },
      investorQualifiedRole : { << >> } \cup { <<held>> : held \in Sample(1) },
      executorId            : { << >> } \cup { <<held>> : held \in Sample(4) },
      executorQualifiedRole : { << >> } \cup { <<held>> : held \in Sample(1) } ]

EncodeNewOrderCrossMultilegOrderAllocations(message) ==
    message.side
        \o message.allocQty
        \o message.clOrdId
        \o message.capacity
        \o message.clearingFirm
        \o message.accountType
        \o (IF message.account = << >> THEN << >> ELSE message.account[1])
        \o (IF message.clearingAccount = << >> THEN << >> ELSE message.clearingAccount[1])
        \o (IF message.legPositionEffects = << >> THEN << >> ELSE message.legPositionEffects[1])
        \o (IF message.custOrderHandlingInst = << >> THEN << >> ELSE message.custOrderHandlingInst[1])
        \o (IF message.orderOrigination = << >> THEN << >> ELSE message.orderOrigination[1])
        \o (IF message.algorithmicIndicator = << >> THEN << >> ELSE message.algorithmicIndicator[1])
        \o (IF message.clientId = << >> THEN << >> ELSE message.clientId[1])
        \o (IF message.clientQualifiedRole = << >> THEN << >> ELSE message.clientQualifiedRole[1])
        \o (IF message.investorId = << >> THEN << >> ELSE message.investorId[1])
        \o (IF message.investorQualifiedRole = << >> THEN << >> ELSE message.investorQualifiedRole[1])
        \o (IF message.executorId = << >> THEN << >> ELSE message.executorId[1])
        \o (IF message.executorQualifiedRole = << >> THEN << >> ELSE message.executorQualifiedRole[1])

DecodeNewOrderCrossMultilegOrderAllocations(bytes, handedNumberOfNewOrderCrossMultilegBitfields, handedNewOrderCrossMultilegBitfield1, handedNewOrderCrossMultilegBitfield2, handedNewOrderCrossMultilegBitfield3) ==
    LET side == ReadBytes(bytes, 1) IN IF ~side.ok THEN Fail ELSE
    LET allocQty == ReadBytes(side.rest, 4) IN IF ~allocQty.ok THEN Fail ELSE
    LET clOrdId == ReadBytes(allocQty.rest, 20) IN IF ~clOrdId.ok THEN Fail ELSE
    LET capacity == ReadBytes(clOrdId.rest, 1) IN IF ~capacity.ok THEN Fail ELSE
    LET clearingFirm == ReadBytes(capacity.rest, 4) IN IF ~clearingFirm.ok THEN Fail ELSE
    LET accountType == ReadBytes(clearingFirm.rest, 1) IN IF ~accountType.ok THEN Fail ELSE
    LET account == ReadWhen(handedNumberOfNewOrderCrossMultilegBitfields >= 2 /\ (handedNewOrderCrossMultilegBitfield2 # << >> /\ (handedNewOrderCrossMultilegBitfield2[1] \div 8) % 2 > 0), ReadBytes(accountType.rest, 16), accountType.rest) IN IF ~account.ok THEN Fail ELSE
    LET clearingAccount == ReadWhen(handedNumberOfNewOrderCrossMultilegBitfields >= 2 /\ (handedNewOrderCrossMultilegBitfield2 # << >> /\ (handedNewOrderCrossMultilegBitfield2[1] \div 32) % 2 > 0), ReadBytes(account.rest, 4), account.rest) IN IF ~clearingAccount.ok THEN Fail ELSE
    LET legPositionEffects == ReadWhen(handedNumberOfNewOrderCrossMultilegBitfields >= 3 /\ (handedNewOrderCrossMultilegBitfield3 # << >> /\ (handedNewOrderCrossMultilegBitfield3[1] \div 16) % 2 > 0), ReadBytes(clearingAccount.rest, 12), clearingAccount.rest) IN IF ~legPositionEffects.ok THEN Fail ELSE
    LET custOrderHandlingInst == ReadWhen(handedNumberOfNewOrderCrossMultilegBitfields >= 1 /\ (handedNewOrderCrossMultilegBitfield1 # << >> /\ (handedNewOrderCrossMultilegBitfield1[1] \div 8) % 2 > 0), ReadBytes(legPositionEffects.rest, 1), legPositionEffects.rest) IN IF ~custOrderHandlingInst.ok THEN Fail ELSE
    LET orderOrigination == ReadWhen(handedNumberOfNewOrderCrossMultilegBitfields >= 1 /\ (handedNewOrderCrossMultilegBitfield1 # << >> /\ (handedNewOrderCrossMultilegBitfield1[1] \div 32) % 2 > 0), ReadBytes(custOrderHandlingInst.rest, 1), custOrderHandlingInst.rest) IN IF ~orderOrigination.ok THEN Fail ELSE
    LET algorithmicIndicator == ReadWhen(handedNumberOfNewOrderCrossMultilegBitfields >= 1 /\ (handedNewOrderCrossMultilegBitfield1 # << >> /\ (handedNewOrderCrossMultilegBitfield1[1] \div 64) % 2 > 0), ReadBytes(orderOrigination.rest, 1), orderOrigination.rest) IN IF ~algorithmicIndicator.ok THEN Fail ELSE
    LET clientId == ReadWhen(handedNumberOfNewOrderCrossMultilegBitfields >= 2 /\ (handedNewOrderCrossMultilegBitfield2 # << >> /\ (handedNewOrderCrossMultilegBitfield2[1] \div 64) % 2 > 0), ReadBytes(algorithmicIndicator.rest, 4), algorithmicIndicator.rest) IN IF ~clientId.ok THEN Fail ELSE
    LET clientQualifiedRole == ReadWhen(handedNumberOfNewOrderCrossMultilegBitfields >= 2 /\ (handedNewOrderCrossMultilegBitfield2 # << >> /\ (handedNewOrderCrossMultilegBitfield2[1] \div 128) % 2 > 0), ReadBytes(clientId.rest, 1), clientId.rest) IN IF ~clientQualifiedRole.ok THEN Fail ELSE
    LET investorId == ReadWhen(handedNumberOfNewOrderCrossMultilegBitfields >= 3 /\ (handedNewOrderCrossMultilegBitfield3 # << >> /\ handedNewOrderCrossMultilegBitfield3[1] % 2 > 0), ReadBytes(clientQualifiedRole.rest, 4), clientQualifiedRole.rest) IN IF ~investorId.ok THEN Fail ELSE
    LET investorQualifiedRole == ReadWhen(handedNumberOfNewOrderCrossMultilegBitfields >= 3 /\ (handedNewOrderCrossMultilegBitfield3 # << >> /\ (handedNewOrderCrossMultilegBitfield3[1] \div 2) % 2 > 0), ReadBytes(investorId.rest, 1), investorId.rest) IN IF ~investorQualifiedRole.ok THEN Fail ELSE
    LET executorId == ReadWhen(handedNumberOfNewOrderCrossMultilegBitfields >= 3 /\ (handedNewOrderCrossMultilegBitfield3 # << >> /\ (handedNewOrderCrossMultilegBitfield3[1] \div 4) % 2 > 0), ReadBytes(investorQualifiedRole.rest, 4), investorQualifiedRole.rest) IN IF ~executorId.ok THEN Fail ELSE
    LET executorQualifiedRole == ReadWhen(handedNumberOfNewOrderCrossMultilegBitfields >= 3 /\ (handedNewOrderCrossMultilegBitfield3 # << >> /\ (handedNewOrderCrossMultilegBitfield3[1] \div 8) % 2 > 0), ReadBytes(executorId.rest, 1), executorId.rest) IN IF ~executorQualifiedRole.ok THEN Fail ELSE
    Ok([ side                  |-> side.value,
         allocQty              |-> allocQty.value,
         clOrdId               |-> clOrdId.value,
         capacity              |-> capacity.value,
         clearingFirm          |-> clearingFirm.value,
         accountType           |-> accountType.value,
         account               |-> account.value,
         clearingAccount       |-> clearingAccount.value,
         legPositionEffects    |-> legPositionEffects.value,
         custOrderHandlingInst |-> custOrderHandlingInst.value,
         orderOrigination      |-> orderOrigination.value,
         algorithmicIndicator  |-> algorithmicIndicator.value,
         clientId              |-> clientId.value,
         clientQualifiedRole   |-> clientQualifiedRole.value,
         investorId            |-> investorId.value,
         investorQualifiedRole |-> investorQualifiedRole.value,
         executorId            |-> executorId.value,
         executorQualifiedRole |-> executorQualifiedRole.value ], executorQualifiedRole.rest)

(* New Order Cross Multileg Order Allocations with each field marked present by fields before it there exactly where they say *)
SettleNewOrderCrossMultilegOrderAllocations(message, handedNumberOfNewOrderCrossMultilegBitfields, handedNewOrderCrossMultilegBitfield1, handedNewOrderCrossMultilegBitfield2, handedNewOrderCrossMultilegBitfield3) ==
    LET settled1 == [message EXCEPT !.account = IF handedNumberOfNewOrderCrossMultilegBitfields >= 2 /\ (handedNewOrderCrossMultilegBitfield2 # << >> /\ (handedNewOrderCrossMultilegBitfield2[1] \div 8) % 2 > 0) THEN (IF message.account = << >> THEN <<[i \in 1 .. 16 |-> 0]>> ELSE message.account) ELSE << >>]
        settled2 == [settled1 EXCEPT !.clearingAccount = IF handedNumberOfNewOrderCrossMultilegBitfields >= 2 /\ (handedNewOrderCrossMultilegBitfield2 # << >> /\ (handedNewOrderCrossMultilegBitfield2[1] \div 32) % 2 > 0) THEN (IF settled1.clearingAccount = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled1.clearingAccount) ELSE << >>]
        settled3 == [settled2 EXCEPT !.legPositionEffects = IF handedNumberOfNewOrderCrossMultilegBitfields >= 3 /\ (handedNewOrderCrossMultilegBitfield3 # << >> /\ (handedNewOrderCrossMultilegBitfield3[1] \div 16) % 2 > 0) THEN (IF settled2.legPositionEffects = << >> THEN <<[i \in 1 .. 12 |-> 0]>> ELSE settled2.legPositionEffects) ELSE << >>]
        settled4 == [settled3 EXCEPT !.custOrderHandlingInst = IF handedNumberOfNewOrderCrossMultilegBitfields >= 1 /\ (handedNewOrderCrossMultilegBitfield1 # << >> /\ (handedNewOrderCrossMultilegBitfield1[1] \div 8) % 2 > 0) THEN (IF settled3.custOrderHandlingInst = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled3.custOrderHandlingInst) ELSE << >>]
        settled5 == [settled4 EXCEPT !.orderOrigination = IF handedNumberOfNewOrderCrossMultilegBitfields >= 1 /\ (handedNewOrderCrossMultilegBitfield1 # << >> /\ (handedNewOrderCrossMultilegBitfield1[1] \div 32) % 2 > 0) THEN (IF settled4.orderOrigination = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled4.orderOrigination) ELSE << >>]
        settled6 == [settled5 EXCEPT !.algorithmicIndicator = IF handedNumberOfNewOrderCrossMultilegBitfields >= 1 /\ (handedNewOrderCrossMultilegBitfield1 # << >> /\ (handedNewOrderCrossMultilegBitfield1[1] \div 64) % 2 > 0) THEN (IF settled5.algorithmicIndicator = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled5.algorithmicIndicator) ELSE << >>]
        settled7 == [settled6 EXCEPT !.clientId = IF handedNumberOfNewOrderCrossMultilegBitfields >= 2 /\ (handedNewOrderCrossMultilegBitfield2 # << >> /\ (handedNewOrderCrossMultilegBitfield2[1] \div 64) % 2 > 0) THEN (IF settled6.clientId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled6.clientId) ELSE << >>]
        settled8 == [settled7 EXCEPT !.clientQualifiedRole = IF handedNumberOfNewOrderCrossMultilegBitfields >= 2 /\ (handedNewOrderCrossMultilegBitfield2 # << >> /\ (handedNewOrderCrossMultilegBitfield2[1] \div 128) % 2 > 0) THEN (IF settled7.clientQualifiedRole = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled7.clientQualifiedRole) ELSE << >>]
        settled9 == [settled8 EXCEPT !.investorId = IF handedNumberOfNewOrderCrossMultilegBitfields >= 3 /\ (handedNewOrderCrossMultilegBitfield3 # << >> /\ handedNewOrderCrossMultilegBitfield3[1] % 2 > 0) THEN (IF settled8.investorId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled8.investorId) ELSE << >>]
        settled10 == [settled9 EXCEPT !.investorQualifiedRole = IF handedNumberOfNewOrderCrossMultilegBitfields >= 3 /\ (handedNewOrderCrossMultilegBitfield3 # << >> /\ (handedNewOrderCrossMultilegBitfield3[1] \div 2) % 2 > 0) THEN (IF settled9.investorQualifiedRole = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled9.investorQualifiedRole) ELSE << >>]
        settled11 == [settled10 EXCEPT !.executorId = IF handedNumberOfNewOrderCrossMultilegBitfields >= 3 /\ (handedNewOrderCrossMultilegBitfield3 # << >> /\ (handedNewOrderCrossMultilegBitfield3[1] \div 4) % 2 > 0) THEN (IF settled10.executorId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled10.executorId) ELSE << >>]
        settled12 == [settled11 EXCEPT !.executorQualifiedRole = IF handedNumberOfNewOrderCrossMultilegBitfields >= 3 /\ (handedNewOrderCrossMultilegBitfield3 # << >> /\ (handedNewOrderCrossMultilegBitfield3[1] \div 8) % 2 > 0) THEN (IF settled11.executorQualifiedRole = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled11.executorQualifiedRole) ELSE << >>]
    IN  settled12

ZeroNewOrderCrossMultilegOrderAllocations ==
    SettleNewOrderCrossMultilegOrderAllocations([ side                  |-> [i \in 1 .. 1 |-> 0],
                                                  allocQty              |-> [i \in 1 .. 4 |-> 0],
                                                  clOrdId               |-> [i \in 1 .. 20 |-> 0],
                                                  capacity              |-> [i \in 1 .. 1 |-> 0],
                                                  clearingFirm          |-> [i \in 1 .. 4 |-> 0],
                                                  accountType           |-> [i \in 1 .. 1 |-> 0],
                                                  account               |-> << >>,
                                                  clearingAccount       |-> << >>,
                                                  legPositionEffects    |-> << >>,
                                                  custOrderHandlingInst |-> << >>,
                                                  orderOrigination      |-> << >>,
                                                  algorithmicIndicator  |-> << >>,
                                                  clientId              |-> << >>,
                                                  clientQualifiedRole   |-> << >>,
                                                  investorId            |-> << >>,
                                                  investorQualifiedRole |-> << >>,
                                                  executorId            |-> << >>,
                                                  executorQualifiedRole |-> << >> ], 0, << >>, << >>, << >>)

(* New Order Cross Multileg Order Allocations at zero, then each field in turn at the values it is checked at *)
CheckedNewOrderCrossMultilegOrderAllocations ==
    { [given |-> <<0, << >>, << >>, << >>>>, message |-> ZeroNewOrderCrossMultilegOrderAllocations] }
        \cup { [given |-> <<0, << >>, << >>, << >>>>, message |-> SettleNewOrderCrossMultilegOrderAllocations([ZeroNewOrderCrossMultilegOrderAllocations EXCEPT !.side = one], 0, << >>, << >>, << >>)] : one \in Sample(1) }
        \cup { [given |-> <<0, << >>, << >>, << >>>>, message |-> SettleNewOrderCrossMultilegOrderAllocations([ZeroNewOrderCrossMultilegOrderAllocations EXCEPT !.allocQty = one], 0, << >>, << >>, << >>)] : one \in Sample(4) }
        \cup { [given |-> <<0, << >>, << >>, << >>>>, message |-> SettleNewOrderCrossMultilegOrderAllocations([ZeroNewOrderCrossMultilegOrderAllocations EXCEPT !.clOrdId = one], 0, << >>, << >>, << >>)] : one \in Sample(20) }
        \cup { [given |-> <<0, << >>, << >>, << >>>>, message |-> SettleNewOrderCrossMultilegOrderAllocations([ZeroNewOrderCrossMultilegOrderAllocations EXCEPT !.capacity = one], 0, << >>, << >>, << >>)] : one \in Sample(1) }
        \cup { [given |-> <<0, << >>, << >>, << >>>>, message |-> SettleNewOrderCrossMultilegOrderAllocations([ZeroNewOrderCrossMultilegOrderAllocations EXCEPT !.clearingFirm = one], 0, << >>, << >>, << >>)] : one \in Sample(4) }
        \cup { [given |-> <<0, << >>, << >>, << >>>>, message |-> SettleNewOrderCrossMultilegOrderAllocations([ZeroNewOrderCrossMultilegOrderAllocations EXCEPT !.accountType = one], 0, << >>, << >>, << >>)] : one \in Sample(1) }
        \cup { [given |-> <<2, << >>, <<8>>, << >>>>, message |-> SettleNewOrderCrossMultilegOrderAllocations([ZeroNewOrderCrossMultilegOrderAllocations EXCEPT !.account = one], 2, << >>, <<8>>, << >>)] : one \in { <<held>> : held \in Sample(16) } }
        \cup { [given |-> <<2, << >>, <<32>>, << >>>>, message |-> SettleNewOrderCrossMultilegOrderAllocations([ZeroNewOrderCrossMultilegOrderAllocations EXCEPT !.clearingAccount = one], 2, << >>, <<32>>, << >>)] : one \in { <<held>> : held \in Sample(4) } }
        \cup { [given |-> <<3, << >>, << >>, <<16>>>>, message |-> SettleNewOrderCrossMultilegOrderAllocations([ZeroNewOrderCrossMultilegOrderAllocations EXCEPT !.legPositionEffects = one], 3, << >>, << >>, <<16>>)] : one \in { <<held>> : held \in Sample(12) } }
        \cup { [given |-> <<1, <<8>>, << >>, << >>>>, message |-> SettleNewOrderCrossMultilegOrderAllocations([ZeroNewOrderCrossMultilegOrderAllocations EXCEPT !.custOrderHandlingInst = one], 1, <<8>>, << >>, << >>)] : one \in { <<held>> : held \in Sample(1) } }
        \cup { [given |-> <<1, <<32>>, << >>, << >>>>, message |-> SettleNewOrderCrossMultilegOrderAllocations([ZeroNewOrderCrossMultilegOrderAllocations EXCEPT !.orderOrigination = one], 1, <<32>>, << >>, << >>)] : one \in { <<held>> : held \in Sample(1) } }
        \cup { [given |-> <<1, <<64>>, << >>, << >>>>, message |-> SettleNewOrderCrossMultilegOrderAllocations([ZeroNewOrderCrossMultilegOrderAllocations EXCEPT !.algorithmicIndicator = one], 1, <<64>>, << >>, << >>)] : one \in { <<held>> : held \in Sample(1) } }
        \cup { [given |-> <<2, << >>, <<64>>, << >>>>, message |-> SettleNewOrderCrossMultilegOrderAllocations([ZeroNewOrderCrossMultilegOrderAllocations EXCEPT !.clientId = one], 2, << >>, <<64>>, << >>)] : one \in { <<held>> : held \in Sample(4) } }
        \cup { [given |-> <<2, << >>, <<128>>, << >>>>, message |-> SettleNewOrderCrossMultilegOrderAllocations([ZeroNewOrderCrossMultilegOrderAllocations EXCEPT !.clientQualifiedRole = one], 2, << >>, <<128>>, << >>)] : one \in { <<held>> : held \in Sample(1) } }
        \cup { [given |-> <<3, << >>, << >>, <<1>>>>, message |-> SettleNewOrderCrossMultilegOrderAllocations([ZeroNewOrderCrossMultilegOrderAllocations EXCEPT !.investorId = one], 3, << >>, << >>, <<1>>)] : one \in { <<held>> : held \in Sample(4) } }
        \cup { [given |-> <<3, << >>, << >>, <<2>>>>, message |-> SettleNewOrderCrossMultilegOrderAllocations([ZeroNewOrderCrossMultilegOrderAllocations EXCEPT !.investorQualifiedRole = one], 3, << >>, << >>, <<2>>)] : one \in { <<held>> : held \in Sample(1) } }
        \cup { [given |-> <<3, << >>, << >>, <<4>>>>, message |-> SettleNewOrderCrossMultilegOrderAllocations([ZeroNewOrderCrossMultilegOrderAllocations EXCEPT !.executorId = one], 3, << >>, << >>, <<4>>)] : one \in { <<held>> : held \in Sample(4) } }
        \cup { [given |-> <<3, << >>, << >>, <<8>>>>, message |-> SettleNewOrderCrossMultilegOrderAllocations([ZeroNewOrderCrossMultilegOrderAllocations EXCEPT !.executorQualifiedRole = one], 3, << >>, << >>, <<8>>)] : one \in { <<held>> : held \in Sample(1) } }

(* A run of New Order Cross Multileg Order Allocations, written one after another *)
RECURSIVE EncodeNewOrderCrossMultilegOrderAllocationsList(_)
EncodeNewOrderCrossMultilegOrderAllocationsList(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeNewOrderCrossMultilegOrderAllocations(Head(messages)) \o EncodeNewOrderCrossMultilegOrderAllocationsList(Tail(messages))

(* As many New Order Cross Multileg Order Allocations as the field that counts them says *)
RECURSIVE ReadNewOrderCrossMultilegOrderAllocationsList(_, _, _, _, _, _)
ReadNewOrderCrossMultilegOrderAllocationsList(bytes, count, handedNumberOfNewOrderCrossMultilegBitfields, handedNewOrderCrossMultilegBitfield1, handedNewOrderCrossMultilegBitfield2, handedNewOrderCrossMultilegBitfield3) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeNewOrderCrossMultilegOrderAllocations(bytes, handedNumberOfNewOrderCrossMultilegBitfields, handedNewOrderCrossMultilegBitfield1, handedNewOrderCrossMultilegBitfield2, handedNewOrderCrossMultilegBitfield3)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadNewOrderCrossMultilegOrderAllocationsList(one.rest, count - 1, handedNumberOfNewOrderCrossMultilegBitfields, handedNewOrderCrossMultilegBitfield1, handedNewOrderCrossMultilegBitfield2, handedNewOrderCrossMultilegBitfield3)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One New Order Cross Multileg Order Allocations of each kind, for the lists that carry them *)
OneNewOrderCrossMultilegOrderAllocations == { ZeroNewOrderCrossMultilegOrderAllocations }

(***************************************************************************)
(* New Order Cross Multileg Message                                        *)
(***************************************************************************)

NewOrderCrossMultilegMessage ==
    [ crossId                                : Sample(20),
      crossType                              : Sample(1),
      crossPrioritization                    : Sample(1),
      price                                  : Sample(8),
      orderQty                               : Sample(4),
      numberOfNewOrderCrossMultilegBitfields : 0 .. 255,
      newOrderCrossMultilegBitfield1         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      newOrderCrossMultilegBitfield2         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      newOrderCrossMultilegBitfield3         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      newOrderCrossMultilegOrderAllocations  : SampleLists(OneNewOrderCrossMultilegOrderAllocations),
      symbolLong                             : { << >> } \cup { <<held>> : held \in Sample(8) },
      liquidityProvision                     : { << >> } \cup { <<held>> : held \in Sample(1) },
      preventMatch                           : { << >> } \cup { <<held>> : held \in Sample(3) },
      autoMatch                              : { << >> } \cup { <<held>> : held \in Sample(1) },
      autoMatchPrice                         : { << >> } \cup { <<held>> : held \in Sample(8) },
      lastPriority                           : { << >> } \cup { <<held>> : held \in Sample(1) },
      extExecInst                            : { << >> } \cup { <<held>> : held \in Sample(1) } ]

EncodeNewOrderCrossMultilegMessage(message) ==
    message.crossId
        \o message.crossType
        \o message.crossPrioritization
        \o message.price
        \o message.orderQty
        \o EncodeUIntBE(message.numberOfNewOrderCrossMultilegBitfields, 1)
        \o (IF message.newOrderCrossMultilegBitfield1 = << >> THEN << >> ELSE EncodeUIntLE(message.newOrderCrossMultilegBitfield1[1], 1))
        \o (IF message.newOrderCrossMultilegBitfield2 = << >> THEN << >> ELSE EncodeUIntLE(message.newOrderCrossMultilegBitfield2[1], 1))
        \o (IF message.newOrderCrossMultilegBitfield3 = << >> THEN << >> ELSE EncodeUIntLE(message.newOrderCrossMultilegBitfield3[1], 1))
        \o EncodeUIntLE(Len(message.newOrderCrossMultilegOrderAllocations), 2)
        \o EncodeNewOrderCrossMultilegOrderAllocationsList(message.newOrderCrossMultilegOrderAllocations)
        \o (IF message.symbolLong = << >> THEN << >> ELSE message.symbolLong[1])
        \o (IF message.liquidityProvision = << >> THEN << >> ELSE message.liquidityProvision[1])
        \o (IF message.preventMatch = << >> THEN << >> ELSE message.preventMatch[1])
        \o (IF message.autoMatch = << >> THEN << >> ELSE message.autoMatch[1])
        \o (IF message.autoMatchPrice = << >> THEN << >> ELSE message.autoMatchPrice[1])
        \o (IF message.lastPriority = << >> THEN << >> ELSE message.lastPriority[1])
        \o (IF message.extExecInst = << >> THEN << >> ELSE message.extExecInst[1])

DecodeNewOrderCrossMultilegMessage(bytes) ==
    LET crossId == ReadBytes(bytes, 20) IN IF ~crossId.ok THEN Fail ELSE
    LET crossType == ReadBytes(crossId.rest, 1) IN IF ~crossType.ok THEN Fail ELSE
    LET crossPrioritization == ReadBytes(crossType.rest, 1) IN IF ~crossPrioritization.ok THEN Fail ELSE
    LET price == ReadBytes(crossPrioritization.rest, 8) IN IF ~price.ok THEN Fail ELSE
    LET orderQty == ReadBytes(price.rest, 4) IN IF ~orderQty.ok THEN Fail ELSE
    LET numberOfNewOrderCrossMultilegBitfields == ReadUIntBE(orderQty.rest, 1) IN IF ~numberOfNewOrderCrossMultilegBitfields.ok THEN Fail ELSE
    LET newOrderCrossMultilegBitfield1 == ReadWhen(numberOfNewOrderCrossMultilegBitfields.value >= 1, ReadUIntLE(numberOfNewOrderCrossMultilegBitfields.rest, 1), numberOfNewOrderCrossMultilegBitfields.rest) IN IF ~newOrderCrossMultilegBitfield1.ok THEN Fail ELSE
    LET newOrderCrossMultilegBitfield2 == ReadWhen(numberOfNewOrderCrossMultilegBitfields.value >= 2, ReadUIntLE(newOrderCrossMultilegBitfield1.rest, 1), newOrderCrossMultilegBitfield1.rest) IN IF ~newOrderCrossMultilegBitfield2.ok THEN Fail ELSE
    LET newOrderCrossMultilegBitfield3 == ReadWhen(numberOfNewOrderCrossMultilegBitfields.value >= 3, ReadUIntLE(newOrderCrossMultilegBitfield2.rest, 1), newOrderCrossMultilegBitfield2.rest) IN IF ~newOrderCrossMultilegBitfield3.ok THEN Fail ELSE
    LET groupCnt == ReadUIntLE(newOrderCrossMultilegBitfield3.rest, 2) IN IF ~groupCnt.ok THEN Fail ELSE
    LET newOrderCrossMultilegOrderAllocations == ReadNewOrderCrossMultilegOrderAllocationsList(groupCnt.rest, groupCnt.value, numberOfNewOrderCrossMultilegBitfields.value, newOrderCrossMultilegBitfield1.value, newOrderCrossMultilegBitfield2.value, newOrderCrossMultilegBitfield3.value) IN IF ~newOrderCrossMultilegOrderAllocations.ok THEN Fail ELSE
    LET symbolLong == ReadWhen(numberOfNewOrderCrossMultilegBitfields.value >= 1 /\ (newOrderCrossMultilegBitfield1.value # << >> /\ newOrderCrossMultilegBitfield1.value[1] % 2 > 0), ReadBytes(newOrderCrossMultilegOrderAllocations.rest, 8), newOrderCrossMultilegOrderAllocations.rest) IN IF ~symbolLong.ok THEN Fail ELSE
    LET liquidityProvision == ReadWhen(numberOfNewOrderCrossMultilegBitfields.value >= 1 /\ (newOrderCrossMultilegBitfield1.value # << >> /\ (newOrderCrossMultilegBitfield1.value[1] \div 16) % 2 > 0), ReadBytes(symbolLong.rest, 1), symbolLong.rest) IN IF ~liquidityProvision.ok THEN Fail ELSE
    LET preventMatch == ReadWhen(numberOfNewOrderCrossMultilegBitfields.value >= 1 /\ (newOrderCrossMultilegBitfield1.value # << >> /\ (newOrderCrossMultilegBitfield1.value[1] \div 128) % 2 > 0), ReadBytes(liquidityProvision.rest, 3), liquidityProvision.rest) IN IF ~preventMatch.ok THEN Fail ELSE
    LET autoMatch == ReadWhen(numberOfNewOrderCrossMultilegBitfields.value >= 2 /\ (newOrderCrossMultilegBitfield2.value # << >> /\ newOrderCrossMultilegBitfield2.value[1] % 2 > 0), ReadBytes(preventMatch.rest, 1), preventMatch.rest) IN IF ~autoMatch.ok THEN Fail ELSE
    LET autoMatchPrice == ReadWhen(numberOfNewOrderCrossMultilegBitfields.value >= 2 /\ (newOrderCrossMultilegBitfield2.value # << >> /\ (newOrderCrossMultilegBitfield2.value[1] \div 2) % 2 > 0), ReadBytes(autoMatch.rest, 8), autoMatch.rest) IN IF ~autoMatchPrice.ok THEN Fail ELSE
    LET lastPriority == ReadWhen(numberOfNewOrderCrossMultilegBitfields.value >= 2 /\ (newOrderCrossMultilegBitfield2.value # << >> /\ (newOrderCrossMultilegBitfield2.value[1] \div 4) % 2 > 0), ReadBytes(autoMatchPrice.rest, 1), autoMatchPrice.rest) IN IF ~lastPriority.ok THEN Fail ELSE
    LET extExecInst == ReadWhen(numberOfNewOrderCrossMultilegBitfields.value >= 2 /\ (newOrderCrossMultilegBitfield2.value # << >> /\ (newOrderCrossMultilegBitfield2.value[1] \div 16) % 2 > 0), ReadBytes(lastPriority.rest, 1), lastPriority.rest) IN IF ~extExecInst.ok THEN Fail ELSE
    Ok([ crossId                                |-> crossId.value,
         crossType                              |-> crossType.value,
         crossPrioritization                    |-> crossPrioritization.value,
         price                                  |-> price.value,
         orderQty                               |-> orderQty.value,
         numberOfNewOrderCrossMultilegBitfields |-> numberOfNewOrderCrossMultilegBitfields.value,
         newOrderCrossMultilegBitfield1         |-> newOrderCrossMultilegBitfield1.value,
         newOrderCrossMultilegBitfield2         |-> newOrderCrossMultilegBitfield2.value,
         newOrderCrossMultilegBitfield3         |-> newOrderCrossMultilegBitfield3.value,
         newOrderCrossMultilegOrderAllocations  |-> newOrderCrossMultilegOrderAllocations.value,
         symbolLong                             |-> symbolLong.value,
         liquidityProvision                     |-> liquidityProvision.value,
         preventMatch                           |-> preventMatch.value,
         autoMatch                              |-> autoMatch.value,
         autoMatchPrice                         |-> autoMatchPrice.value,
         lastPriority                           |-> lastPriority.value,
         extExecInst                            |-> extExecInst.value ], extExecInst.rest)

(* New Order Cross Multileg Message with each field marked present by fields before it there exactly where they say *)
SettleNewOrderCrossMultilegMessage(message) ==
    LET settled1 == [message EXCEPT !.newOrderCrossMultilegBitfield1 = IF message.numberOfNewOrderCrossMultilegBitfields >= 1 THEN (IF message.newOrderCrossMultilegBitfield1 = << >> THEN <<0>> ELSE message.newOrderCrossMultilegBitfield1) ELSE << >>]
        settled2 == [settled1 EXCEPT !.newOrderCrossMultilegBitfield2 = IF settled1.numberOfNewOrderCrossMultilegBitfields >= 2 THEN (IF settled1.newOrderCrossMultilegBitfield2 = << >> THEN <<0>> ELSE settled1.newOrderCrossMultilegBitfield2) ELSE << >>]
        settled3 == [settled2 EXCEPT !.newOrderCrossMultilegBitfield3 = IF settled2.numberOfNewOrderCrossMultilegBitfields >= 3 THEN (IF settled2.newOrderCrossMultilegBitfield3 = << >> THEN <<0>> ELSE settled2.newOrderCrossMultilegBitfield3) ELSE << >>]
        settled4 == [settled3 EXCEPT !.newOrderCrossMultilegOrderAllocations = [i \in DOMAIN settled3.newOrderCrossMultilegOrderAllocations |-> SettleNewOrderCrossMultilegOrderAllocations(settled3.newOrderCrossMultilegOrderAllocations[i], settled3.numberOfNewOrderCrossMultilegBitfields, settled3.newOrderCrossMultilegBitfield1, settled3.newOrderCrossMultilegBitfield2, settled3.newOrderCrossMultilegBitfield3)]]
        settled5 == [settled4 EXCEPT !.symbolLong = IF settled4.numberOfNewOrderCrossMultilegBitfields >= 1 /\ (settled4.newOrderCrossMultilegBitfield1 # << >> /\ settled4.newOrderCrossMultilegBitfield1[1] % 2 > 0) THEN (IF settled4.symbolLong = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled4.symbolLong) ELSE << >>]
        settled6 == [settled5 EXCEPT !.liquidityProvision = IF settled5.numberOfNewOrderCrossMultilegBitfields >= 1 /\ (settled5.newOrderCrossMultilegBitfield1 # << >> /\ (settled5.newOrderCrossMultilegBitfield1[1] \div 16) % 2 > 0) THEN (IF settled5.liquidityProvision = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled5.liquidityProvision) ELSE << >>]
        settled7 == [settled6 EXCEPT !.preventMatch = IF settled6.numberOfNewOrderCrossMultilegBitfields >= 1 /\ (settled6.newOrderCrossMultilegBitfield1 # << >> /\ (settled6.newOrderCrossMultilegBitfield1[1] \div 128) % 2 > 0) THEN (IF settled6.preventMatch = << >> THEN <<[i \in 1 .. 3 |-> 0]>> ELSE settled6.preventMatch) ELSE << >>]
        settled8 == [settled7 EXCEPT !.autoMatch = IF settled7.numberOfNewOrderCrossMultilegBitfields >= 2 /\ (settled7.newOrderCrossMultilegBitfield2 # << >> /\ settled7.newOrderCrossMultilegBitfield2[1] % 2 > 0) THEN (IF settled7.autoMatch = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled7.autoMatch) ELSE << >>]
        settled9 == [settled8 EXCEPT !.autoMatchPrice = IF settled8.numberOfNewOrderCrossMultilegBitfields >= 2 /\ (settled8.newOrderCrossMultilegBitfield2 # << >> /\ (settled8.newOrderCrossMultilegBitfield2[1] \div 2) % 2 > 0) THEN (IF settled8.autoMatchPrice = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled8.autoMatchPrice) ELSE << >>]
        settled10 == [settled9 EXCEPT !.lastPriority = IF settled9.numberOfNewOrderCrossMultilegBitfields >= 2 /\ (settled9.newOrderCrossMultilegBitfield2 # << >> /\ (settled9.newOrderCrossMultilegBitfield2[1] \div 4) % 2 > 0) THEN (IF settled9.lastPriority = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled9.lastPriority) ELSE << >>]
        settled11 == [settled10 EXCEPT !.extExecInst = IF settled10.numberOfNewOrderCrossMultilegBitfields >= 2 /\ (settled10.newOrderCrossMultilegBitfield2 # << >> /\ (settled10.newOrderCrossMultilegBitfield2[1] \div 16) % 2 > 0) THEN (IF settled10.extExecInst = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled10.extExecInst) ELSE << >>]
    IN  settled11

ZeroNewOrderCrossMultilegMessage ==
    SettleNewOrderCrossMultilegMessage([ crossId                                |-> [i \in 1 .. 20 |-> 0],
                                         crossType                              |-> [i \in 1 .. 1 |-> 0],
                                         crossPrioritization                    |-> [i \in 1 .. 1 |-> 0],
                                         price                                  |-> [i \in 1 .. 8 |-> 0],
                                         orderQty                               |-> [i \in 1 .. 4 |-> 0],
                                         numberOfNewOrderCrossMultilegBitfields |-> 0,
                                         newOrderCrossMultilegBitfield1         |-> << >>,
                                         newOrderCrossMultilegBitfield2         |-> << >>,
                                         newOrderCrossMultilegBitfield3         |-> << >>,
                                         newOrderCrossMultilegOrderAllocations  |-> << >>,
                                         symbolLong                             |-> << >>,
                                         liquidityProvision                     |-> << >>,
                                         preventMatch                           |-> << >>,
                                         autoMatch                              |-> << >>,
                                         autoMatchPrice                         |-> << >>,
                                         lastPriority                           |-> << >>,
                                         extExecInst                            |-> << >> ])

(* New Order Cross Multileg Message at zero, then each field in turn at the values it is checked at *)
CheckedNewOrderCrossMultilegMessage ==
    { ZeroNewOrderCrossMultilegMessage }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.crossId = one]) : one \in Sample(20) }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.crossType = one]) : one \in Sample(1) }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.crossPrioritization = one]) : one \in Sample(1) }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.price = one]) : one \in Sample(8) }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.orderQty = one]) : one \in Sample(4) }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = one]) : one \in {0, 1, 255} }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 1, !.newOrderCrossMultilegBitfield1 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 2, !.newOrderCrossMultilegBitfield2 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 3, !.newOrderCrossMultilegBitfield3 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.newOrderCrossMultilegOrderAllocations = one]) : one \in SampleLists(OneNewOrderCrossMultilegOrderAllocations) }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 2, !.newOrderCrossMultilegBitfield2 = <<8>>, !.newOrderCrossMultilegOrderAllocations = one]) : one \in SampleLists(OneNewOrderCrossMultilegOrderAllocations) }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 2, !.newOrderCrossMultilegBitfield2 = <<32>>, !.newOrderCrossMultilegOrderAllocations = one]) : one \in SampleLists(OneNewOrderCrossMultilegOrderAllocations) }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 3, !.newOrderCrossMultilegBitfield3 = <<16>>, !.newOrderCrossMultilegOrderAllocations = one]) : one \in SampleLists(OneNewOrderCrossMultilegOrderAllocations) }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 1, !.newOrderCrossMultilegBitfield1 = <<8>>, !.newOrderCrossMultilegOrderAllocations = one]) : one \in SampleLists(OneNewOrderCrossMultilegOrderAllocations) }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 1, !.newOrderCrossMultilegBitfield1 = <<32>>, !.newOrderCrossMultilegOrderAllocations = one]) : one \in SampleLists(OneNewOrderCrossMultilegOrderAllocations) }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 1, !.newOrderCrossMultilegBitfield1 = <<64>>, !.newOrderCrossMultilegOrderAllocations = one]) : one \in SampleLists(OneNewOrderCrossMultilegOrderAllocations) }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 2, !.newOrderCrossMultilegBitfield2 = <<64>>, !.newOrderCrossMultilegOrderAllocations = one]) : one \in SampleLists(OneNewOrderCrossMultilegOrderAllocations) }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 2, !.newOrderCrossMultilegBitfield2 = <<128>>, !.newOrderCrossMultilegOrderAllocations = one]) : one \in SampleLists(OneNewOrderCrossMultilegOrderAllocations) }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 3, !.newOrderCrossMultilegBitfield3 = <<1>>, !.newOrderCrossMultilegOrderAllocations = one]) : one \in SampleLists(OneNewOrderCrossMultilegOrderAllocations) }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 3, !.newOrderCrossMultilegBitfield3 = <<2>>, !.newOrderCrossMultilegOrderAllocations = one]) : one \in SampleLists(OneNewOrderCrossMultilegOrderAllocations) }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 3, !.newOrderCrossMultilegBitfield3 = <<4>>, !.newOrderCrossMultilegOrderAllocations = one]) : one \in SampleLists(OneNewOrderCrossMultilegOrderAllocations) }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 3, !.newOrderCrossMultilegBitfield3 = <<8>>, !.newOrderCrossMultilegOrderAllocations = one]) : one \in SampleLists(OneNewOrderCrossMultilegOrderAllocations) }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 1, !.newOrderCrossMultilegBitfield1 = <<1>>, !.symbolLong = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 1, !.newOrderCrossMultilegBitfield1 = <<16>>, !.liquidityProvision = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 1, !.newOrderCrossMultilegBitfield1 = <<128>>, !.preventMatch = one]) : one \in { <<held>> : held \in Sample(3) } }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 2, !.newOrderCrossMultilegBitfield2 = <<1>>, !.autoMatch = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 2, !.newOrderCrossMultilegBitfield2 = <<2>>, !.autoMatchPrice = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 2, !.newOrderCrossMultilegBitfield2 = <<4>>, !.lastPriority = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleNewOrderCrossMultilegMessage([ZeroNewOrderCrossMultilegMessage EXCEPT !.numberOfNewOrderCrossMultilegBitfields = 2, !.newOrderCrossMultilegBitfield2 = <<16>>, !.extExecInst = one]) : one \in { <<held>> : held \in Sample(1) } }

(***************************************************************************)
(* Cancel Order V 2 Message                                                *)
(***************************************************************************)

CancelOrderV2Message ==
    [ origClOrdId                    : Sample(20),
      numberOfCancelOrderV2Bitfields : 0 .. 255,
      cancelOrderV2Bitfield1         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      cancelOrderV2Bitfield2         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      clearingFirm                   : { << >> } \cup { <<held>> : held \in Sample(4) },
      productCode                    : { << >> } \cup { <<held>> : held \in Sample(6) },
      massCancelId                   : { << >> } \cup { <<held>> : held \in Sample(20) },
      massCancelInst                 : { << >> } \cup { <<held>> : held \in Sample(16) } ]

EncodeCancelOrderV2Message(message) ==
    message.origClOrdId
        \o EncodeUIntBE(message.numberOfCancelOrderV2Bitfields, 1)
        \o (IF message.cancelOrderV2Bitfield1 = << >> THEN << >> ELSE EncodeUIntLE(message.cancelOrderV2Bitfield1[1], 1))
        \o (IF message.cancelOrderV2Bitfield2 = << >> THEN << >> ELSE EncodeUIntLE(message.cancelOrderV2Bitfield2[1], 1))
        \o (IF message.clearingFirm = << >> THEN << >> ELSE message.clearingFirm[1])
        \o (IF message.productCode = << >> THEN << >> ELSE message.productCode[1])
        \o (IF message.massCancelId = << >> THEN << >> ELSE message.massCancelId[1])
        \o (IF message.massCancelInst = << >> THEN << >> ELSE message.massCancelInst[1])

DecodeCancelOrderV2Message(bytes) ==
    LET origClOrdId == ReadBytes(bytes, 20) IN IF ~origClOrdId.ok THEN Fail ELSE
    LET numberOfCancelOrderV2Bitfields == ReadUIntBE(origClOrdId.rest, 1) IN IF ~numberOfCancelOrderV2Bitfields.ok THEN Fail ELSE
    LET cancelOrderV2Bitfield1 == ReadWhen(numberOfCancelOrderV2Bitfields.value >= 1, ReadUIntLE(numberOfCancelOrderV2Bitfields.rest, 1), numberOfCancelOrderV2Bitfields.rest) IN IF ~cancelOrderV2Bitfield1.ok THEN Fail ELSE
    LET cancelOrderV2Bitfield2 == ReadWhen(numberOfCancelOrderV2Bitfields.value >= 2, ReadUIntLE(cancelOrderV2Bitfield1.rest, 1), cancelOrderV2Bitfield1.rest) IN IF ~cancelOrderV2Bitfield2.ok THEN Fail ELSE
    LET clearingFirm == ReadWhen(numberOfCancelOrderV2Bitfields.value >= 1 /\ (cancelOrderV2Bitfield1.value # << >> /\ cancelOrderV2Bitfield1.value[1] % 2 > 0), ReadBytes(cancelOrderV2Bitfield2.rest, 4), cancelOrderV2Bitfield2.rest) IN IF ~clearingFirm.ok THEN Fail ELSE
    LET productCode == ReadWhen(numberOfCancelOrderV2Bitfields.value >= 1 /\ (cancelOrderV2Bitfield1.value # << >> /\ (cancelOrderV2Bitfield1.value[1] \div 8) % 2 > 0), ReadBytes(clearingFirm.rest, 6), clearingFirm.rest) IN IF ~productCode.ok THEN Fail ELSE
    LET massCancelId == ReadWhen(numberOfCancelOrderV2Bitfields.value >= 1 /\ (cancelOrderV2Bitfield1.value # << >> /\ (cancelOrderV2Bitfield1.value[1] \div 16) % 2 > 0), ReadBytes(productCode.rest, 20), productCode.rest) IN IF ~massCancelId.ok THEN Fail ELSE
    LET massCancelInst == ReadWhen(numberOfCancelOrderV2Bitfields.value >= 2 /\ (cancelOrderV2Bitfield2.value # << >> /\ cancelOrderV2Bitfield2.value[1] % 2 > 0), ReadBytes(massCancelId.rest, 16), massCancelId.rest) IN IF ~massCancelInst.ok THEN Fail ELSE
    Ok([ origClOrdId                    |-> origClOrdId.value,
         numberOfCancelOrderV2Bitfields |-> numberOfCancelOrderV2Bitfields.value,
         cancelOrderV2Bitfield1         |-> cancelOrderV2Bitfield1.value,
         cancelOrderV2Bitfield2         |-> cancelOrderV2Bitfield2.value,
         clearingFirm                   |-> clearingFirm.value,
         productCode                    |-> productCode.value,
         massCancelId                   |-> massCancelId.value,
         massCancelInst                 |-> massCancelInst.value ], massCancelInst.rest)

(* Cancel Order V 2 Message with each field marked present by fields before it there exactly where they say *)
SettleCancelOrderV2Message(message) ==
    LET settled1 == [message EXCEPT !.cancelOrderV2Bitfield1 = IF message.numberOfCancelOrderV2Bitfields >= 1 THEN (IF message.cancelOrderV2Bitfield1 = << >> THEN <<0>> ELSE message.cancelOrderV2Bitfield1) ELSE << >>]
        settled2 == [settled1 EXCEPT !.cancelOrderV2Bitfield2 = IF settled1.numberOfCancelOrderV2Bitfields >= 2 THEN (IF settled1.cancelOrderV2Bitfield2 = << >> THEN <<0>> ELSE settled1.cancelOrderV2Bitfield2) ELSE << >>]
        settled3 == [settled2 EXCEPT !.clearingFirm = IF settled2.numberOfCancelOrderV2Bitfields >= 1 /\ (settled2.cancelOrderV2Bitfield1 # << >> /\ settled2.cancelOrderV2Bitfield1[1] % 2 > 0) THEN (IF settled2.clearingFirm = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled2.clearingFirm) ELSE << >>]
        settled4 == [settled3 EXCEPT !.productCode = IF settled3.numberOfCancelOrderV2Bitfields >= 1 /\ (settled3.cancelOrderV2Bitfield1 # << >> /\ (settled3.cancelOrderV2Bitfield1[1] \div 8) % 2 > 0) THEN (IF settled3.productCode = << >> THEN <<[i \in 1 .. 6 |-> 0]>> ELSE settled3.productCode) ELSE << >>]
        settled5 == [settled4 EXCEPT !.massCancelId = IF settled4.numberOfCancelOrderV2Bitfields >= 1 /\ (settled4.cancelOrderV2Bitfield1 # << >> /\ (settled4.cancelOrderV2Bitfield1[1] \div 16) % 2 > 0) THEN (IF settled4.massCancelId = << >> THEN <<[i \in 1 .. 20 |-> 0]>> ELSE settled4.massCancelId) ELSE << >>]
        settled6 == [settled5 EXCEPT !.massCancelInst = IF settled5.numberOfCancelOrderV2Bitfields >= 2 /\ (settled5.cancelOrderV2Bitfield2 # << >> /\ settled5.cancelOrderV2Bitfield2[1] % 2 > 0) THEN (IF settled5.massCancelInst = << >> THEN <<[i \in 1 .. 16 |-> 0]>> ELSE settled5.massCancelInst) ELSE << >>]
    IN  settled6

ZeroCancelOrderV2Message ==
    SettleCancelOrderV2Message([ origClOrdId                    |-> [i \in 1 .. 20 |-> 0],
                                 numberOfCancelOrderV2Bitfields |-> 0,
                                 cancelOrderV2Bitfield1         |-> << >>,
                                 cancelOrderV2Bitfield2         |-> << >>,
                                 clearingFirm                   |-> << >>,
                                 productCode                    |-> << >>,
                                 massCancelId                   |-> << >>,
                                 massCancelInst                 |-> << >> ])

(* Cancel Order V 2 Message at zero, then each field in turn at the values it is checked at *)
CheckedCancelOrderV2Message ==
    { ZeroCancelOrderV2Message }
        \cup { SettleCancelOrderV2Message([ZeroCancelOrderV2Message EXCEPT !.origClOrdId = one]) : one \in Sample(20) }
        \cup { SettleCancelOrderV2Message([ZeroCancelOrderV2Message EXCEPT !.numberOfCancelOrderV2Bitfields = one]) : one \in {0, 1, 255} }
        \cup { SettleCancelOrderV2Message([ZeroCancelOrderV2Message EXCEPT !.numberOfCancelOrderV2Bitfields = 1, !.cancelOrderV2Bitfield1 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCancelOrderV2Message([ZeroCancelOrderV2Message EXCEPT !.numberOfCancelOrderV2Bitfields = 2, !.cancelOrderV2Bitfield2 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCancelOrderV2Message([ZeroCancelOrderV2Message EXCEPT !.numberOfCancelOrderV2Bitfields = 1, !.cancelOrderV2Bitfield1 = <<1>>, !.clearingFirm = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleCancelOrderV2Message([ZeroCancelOrderV2Message EXCEPT !.numberOfCancelOrderV2Bitfields = 1, !.cancelOrderV2Bitfield1 = <<8>>, !.productCode = one]) : one \in { <<held>> : held \in Sample(6) } }
        \cup { SettleCancelOrderV2Message([ZeroCancelOrderV2Message EXCEPT !.numberOfCancelOrderV2Bitfields = 1, !.cancelOrderV2Bitfield1 = <<16>>, !.massCancelId = one]) : one \in { <<held>> : held \in Sample(20) } }
        \cup { SettleCancelOrderV2Message([ZeroCancelOrderV2Message EXCEPT !.numberOfCancelOrderV2Bitfields = 2, !.cancelOrderV2Bitfield2 = <<1>>, !.massCancelInst = one]) : one \in { <<held>> : held \in Sample(16) } }

(***************************************************************************)
(* Modify Order V 2 Message                                                *)
(***************************************************************************)

ModifyOrderV2Message ==
    [ clOrdId                        : Sample(20),
      origClOrdId                    : Sample(20),
      numberOfModifyOrderV2Bitfields : 0 .. 255,
      modifyOrderV2Bitfield1         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      modifyOrderV2Bitfield2         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      clearingFirm                   : { << >> } \cup { <<held>> : held \in Sample(4) },
      ordType                        : { << >> } \cup { <<held>> : held \in Sample(1) },
      cancelOrigOnReject             : { << >> } \cup { <<held>> : held \in Sample(1) },
      stopPx                         : { << >> } \cup { <<held>> : held \in Sample(8) },
      custOrderHandlingInst          : { << >> } \cup { <<held>> : held \in Sample(1) } ]

EncodeModifyOrderV2Message(message) ==
    message.clOrdId
        \o message.origClOrdId
        \o EncodeUIntBE(message.numberOfModifyOrderV2Bitfields, 1)
        \o (IF message.modifyOrderV2Bitfield1 = << >> THEN << >> ELSE EncodeUIntLE(message.modifyOrderV2Bitfield1[1], 1))
        \o (IF message.modifyOrderV2Bitfield2 = << >> THEN << >> ELSE EncodeUIntLE(message.modifyOrderV2Bitfield2[1], 1))
        \o (IF message.clearingFirm = << >> THEN << >> ELSE message.clearingFirm[1])
        \o (IF message.ordType = << >> THEN << >> ELSE message.ordType[1])
        \o (IF message.cancelOrigOnReject = << >> THEN << >> ELSE message.cancelOrigOnReject[1])
        \o (IF message.stopPx = << >> THEN << >> ELSE message.stopPx[1])
        \o (IF message.custOrderHandlingInst = << >> THEN << >> ELSE message.custOrderHandlingInst[1])

DecodeModifyOrderV2Message(bytes) ==
    LET clOrdId == ReadBytes(bytes, 20) IN IF ~clOrdId.ok THEN Fail ELSE
    LET origClOrdId == ReadBytes(clOrdId.rest, 20) IN IF ~origClOrdId.ok THEN Fail ELSE
    LET numberOfModifyOrderV2Bitfields == ReadUIntBE(origClOrdId.rest, 1) IN IF ~numberOfModifyOrderV2Bitfields.ok THEN Fail ELSE
    LET modifyOrderV2Bitfield1 == ReadWhen(numberOfModifyOrderV2Bitfields.value >= 1, ReadUIntLE(numberOfModifyOrderV2Bitfields.rest, 1), numberOfModifyOrderV2Bitfields.rest) IN IF ~modifyOrderV2Bitfield1.ok THEN Fail ELSE
    LET modifyOrderV2Bitfield2 == ReadWhen(numberOfModifyOrderV2Bitfields.value >= 2, ReadUIntLE(modifyOrderV2Bitfield1.rest, 1), modifyOrderV2Bitfield1.rest) IN IF ~modifyOrderV2Bitfield2.ok THEN Fail ELSE
    LET clearingFirm == ReadWhen(numberOfModifyOrderV2Bitfields.value >= 1 /\ (modifyOrderV2Bitfield1.value # << >> /\ modifyOrderV2Bitfield1.value[1] % 2 > 0), ReadBytes(modifyOrderV2Bitfield2.rest, 4), modifyOrderV2Bitfield2.rest) IN IF ~clearingFirm.ok THEN Fail ELSE
    LET ordType == ReadWhen(numberOfModifyOrderV2Bitfields.value >= 1 /\ (modifyOrderV2Bitfield1.value # << >> /\ (modifyOrderV2Bitfield1.value[1] \div 16) % 2 > 0), ReadBytes(clearingFirm.rest, 1), clearingFirm.rest) IN IF ~ordType.ok THEN Fail ELSE
    LET cancelOrigOnReject == ReadWhen(numberOfModifyOrderV2Bitfields.value >= 1 /\ (modifyOrderV2Bitfield1.value # << >> /\ (modifyOrderV2Bitfield1.value[1] \div 32) % 2 > 0), ReadBytes(ordType.rest, 1), ordType.rest) IN IF ~cancelOrigOnReject.ok THEN Fail ELSE
    LET stopPx == ReadWhen(numberOfModifyOrderV2Bitfields.value >= 2 /\ (modifyOrderV2Bitfield2.value # << >> /\ (modifyOrderV2Bitfield2.value[1] \div 2) % 2 > 0), ReadBytes(cancelOrigOnReject.rest, 8), cancelOrigOnReject.rest) IN IF ~stopPx.ok THEN Fail ELSE
    LET custOrderHandlingInst == ReadWhen(numberOfModifyOrderV2Bitfields.value >= 2 /\ (modifyOrderV2Bitfield2.value # << >> /\ (modifyOrderV2Bitfield2.value[1] \div 64) % 2 > 0), ReadBytes(stopPx.rest, 1), stopPx.rest) IN IF ~custOrderHandlingInst.ok THEN Fail ELSE
    Ok([ clOrdId                        |-> clOrdId.value,
         origClOrdId                    |-> origClOrdId.value,
         numberOfModifyOrderV2Bitfields |-> numberOfModifyOrderV2Bitfields.value,
         modifyOrderV2Bitfield1         |-> modifyOrderV2Bitfield1.value,
         modifyOrderV2Bitfield2         |-> modifyOrderV2Bitfield2.value,
         clearingFirm                   |-> clearingFirm.value,
         ordType                        |-> ordType.value,
         cancelOrigOnReject             |-> cancelOrigOnReject.value,
         stopPx                         |-> stopPx.value,
         custOrderHandlingInst          |-> custOrderHandlingInst.value ], custOrderHandlingInst.rest)

(* Modify Order V 2 Message with each field marked present by fields before it there exactly where they say *)
SettleModifyOrderV2Message(message) ==
    LET settled1 == [message EXCEPT !.modifyOrderV2Bitfield1 = IF message.numberOfModifyOrderV2Bitfields >= 1 THEN (IF message.modifyOrderV2Bitfield1 = << >> THEN <<0>> ELSE message.modifyOrderV2Bitfield1) ELSE << >>]
        settled2 == [settled1 EXCEPT !.modifyOrderV2Bitfield2 = IF settled1.numberOfModifyOrderV2Bitfields >= 2 THEN (IF settled1.modifyOrderV2Bitfield2 = << >> THEN <<0>> ELSE settled1.modifyOrderV2Bitfield2) ELSE << >>]
        settled3 == [settled2 EXCEPT !.clearingFirm = IF settled2.numberOfModifyOrderV2Bitfields >= 1 /\ (settled2.modifyOrderV2Bitfield1 # << >> /\ settled2.modifyOrderV2Bitfield1[1] % 2 > 0) THEN (IF settled2.clearingFirm = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled2.clearingFirm) ELSE << >>]
        settled4 == [settled3 EXCEPT !.ordType = IF settled3.numberOfModifyOrderV2Bitfields >= 1 /\ (settled3.modifyOrderV2Bitfield1 # << >> /\ (settled3.modifyOrderV2Bitfield1[1] \div 16) % 2 > 0) THEN (IF settled3.ordType = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled3.ordType) ELSE << >>]
        settled5 == [settled4 EXCEPT !.cancelOrigOnReject = IF settled4.numberOfModifyOrderV2Bitfields >= 1 /\ (settled4.modifyOrderV2Bitfield1 # << >> /\ (settled4.modifyOrderV2Bitfield1[1] \div 32) % 2 > 0) THEN (IF settled4.cancelOrigOnReject = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled4.cancelOrigOnReject) ELSE << >>]
        settled6 == [settled5 EXCEPT !.stopPx = IF settled5.numberOfModifyOrderV2Bitfields >= 2 /\ (settled5.modifyOrderV2Bitfield2 # << >> /\ (settled5.modifyOrderV2Bitfield2[1] \div 2) % 2 > 0) THEN (IF settled5.stopPx = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled5.stopPx) ELSE << >>]
        settled7 == [settled6 EXCEPT !.custOrderHandlingInst = IF settled6.numberOfModifyOrderV2Bitfields >= 2 /\ (settled6.modifyOrderV2Bitfield2 # << >> /\ (settled6.modifyOrderV2Bitfield2[1] \div 64) % 2 > 0) THEN (IF settled6.custOrderHandlingInst = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled6.custOrderHandlingInst) ELSE << >>]
    IN  settled7

ZeroModifyOrderV2Message ==
    SettleModifyOrderV2Message([ clOrdId                        |-> [i \in 1 .. 20 |-> 0],
                                 origClOrdId                    |-> [i \in 1 .. 20 |-> 0],
                                 numberOfModifyOrderV2Bitfields |-> 0,
                                 modifyOrderV2Bitfield1         |-> << >>,
                                 modifyOrderV2Bitfield2         |-> << >>,
                                 clearingFirm                   |-> << >>,
                                 ordType                        |-> << >>,
                                 cancelOrigOnReject             |-> << >>,
                                 stopPx                         |-> << >>,
                                 custOrderHandlingInst          |-> << >> ])

(* Modify Order V 2 Message at zero, then each field in turn at the values it is checked at *)
CheckedModifyOrderV2Message ==
    { ZeroModifyOrderV2Message }
        \cup { SettleModifyOrderV2Message([ZeroModifyOrderV2Message EXCEPT !.clOrdId = one]) : one \in Sample(20) }
        \cup { SettleModifyOrderV2Message([ZeroModifyOrderV2Message EXCEPT !.origClOrdId = one]) : one \in Sample(20) }
        \cup { SettleModifyOrderV2Message([ZeroModifyOrderV2Message EXCEPT !.numberOfModifyOrderV2Bitfields = one]) : one \in {0, 1, 255} }
        \cup { SettleModifyOrderV2Message([ZeroModifyOrderV2Message EXCEPT !.numberOfModifyOrderV2Bitfields = 1, !.modifyOrderV2Bitfield1 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleModifyOrderV2Message([ZeroModifyOrderV2Message EXCEPT !.numberOfModifyOrderV2Bitfields = 2, !.modifyOrderV2Bitfield2 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleModifyOrderV2Message([ZeroModifyOrderV2Message EXCEPT !.numberOfModifyOrderV2Bitfields = 1, !.modifyOrderV2Bitfield1 = <<1>>, !.clearingFirm = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleModifyOrderV2Message([ZeroModifyOrderV2Message EXCEPT !.numberOfModifyOrderV2Bitfields = 1, !.modifyOrderV2Bitfield1 = <<16>>, !.ordType = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleModifyOrderV2Message([ZeroModifyOrderV2Message EXCEPT !.numberOfModifyOrderV2Bitfields = 1, !.modifyOrderV2Bitfield1 = <<32>>, !.cancelOrigOnReject = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleModifyOrderV2Message([ZeroModifyOrderV2Message EXCEPT !.numberOfModifyOrderV2Bitfields = 2, !.modifyOrderV2Bitfield2 = <<2>>, !.stopPx = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleModifyOrderV2Message([ZeroModifyOrderV2Message EXCEPT !.numberOfModifyOrderV2Bitfields = 2, !.modifyOrderV2Bitfield2 = <<64>>, !.custOrderHandlingInst = one]) : one \in { <<held>> : held \in Sample(1) } }

(***************************************************************************)
(* Quote: 20 bytes                                                         *)
(***************************************************************************)

Quote ==
    [ symbolShort : Sample(6),
      side        : Sample(1),
      openClose   : Sample(1),
      price       : Sample(8),
      orderQty    : Sample(4) ]

EncodeQuote(message) ==
    message.symbolShort
        \o message.side
        \o message.openClose
        \o message.price
        \o message.orderQty

DecodeQuote(bytes) ==
    LET symbolShort == ReadBytes(bytes, 6) IN IF ~symbolShort.ok THEN Fail ELSE
    LET side == ReadBytes(symbolShort.rest, 1) IN IF ~side.ok THEN Fail ELSE
    LET openClose == ReadBytes(side.rest, 1) IN IF ~openClose.ok THEN Fail ELSE
    LET price == ReadBytes(openClose.rest, 8) IN IF ~price.ok THEN Fail ELSE
    LET orderQty == ReadBytes(price.rest, 4) IN IF ~orderQty.ok THEN Fail ELSE
    Ok([ symbolShort |-> symbolShort.value,
         side        |-> side.value,
         openClose   |-> openClose.value,
         price       |-> price.value,
         orderQty    |-> orderQty.value ], orderQty.rest)

ZeroQuote ==
    [ symbolShort |-> [i \in 1 .. 6 |-> 0],
      side        |-> [i \in 1 .. 1 |-> 0],
      openClose   |-> [i \in 1 .. 1 |-> 0],
      price       |-> [i \in 1 .. 8 |-> 0],
      orderQty    |-> [i \in 1 .. 4 |-> 0] ]

(* Quote at zero, then each field in turn at the values it is checked at *)
CheckedQuote ==
    { ZeroQuote }
        \cup { [ZeroQuote EXCEPT !.symbolShort = one] : one \in Sample(6) }
        \cup { [ZeroQuote EXCEPT !.side = one] : one \in Sample(1) }
        \cup { [ZeroQuote EXCEPT !.openClose = one] : one \in Sample(1) }
        \cup { [ZeroQuote EXCEPT !.price = one] : one \in Sample(8) }
        \cup { [ZeroQuote EXCEPT !.orderQty = one] : one \in Sample(4) }

(* A run of Quote, written one after another *)
RECURSIVE EncodeQuoteList(_)
EncodeQuoteList(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeQuote(Head(messages)) \o EncodeQuoteList(Tail(messages))

(* As many Quote as the field that counts them says *)
RECURSIVE ReadQuoteList(_, _)
ReadQuoteList(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeQuote(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadQuoteList(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Quote of each kind, for the lists that carry them *)
OneQuote == { ZeroQuote }

(***************************************************************************)
(* Quote Update Message                                                    *)
(***************************************************************************)

QuoteUpdateMessage ==
    [ quoteUpdateId         : Sample(16),
      clearingFirm          : Sample(4),
      clearingAccount       : Sample(4),
      orderOrigination      : Sample(1),
      algorithmicIndicator  : Sample(1),
      liquidityProvision    : Sample(1),
      custOrderHandlingInst : Sample(1),
      account               : Sample(16),
      customGroupId         : Sample(2),
      capacity              : Sample(1),
      clientId              : Sample(4),
      clientQualifiedRole   : Sample(1),
      executorId            : Sample(4),
      executorQualifiedRole : Sample(1),
      investorId            : Sample(4),
      investorQualifiedRole : Sample(1),
      accountType           : Sample(1),
      postingInstruction    : Sample(1),
      quote                 : SampleLists(OneQuote) ]

EncodeQuoteUpdateMessage(message) ==
    message.quoteUpdateId
        \o message.clearingFirm
        \o message.clearingAccount
        \o message.orderOrigination
        \o message.algorithmicIndicator
        \o message.liquidityProvision
        \o message.custOrderHandlingInst
        \o message.account
        \o message.customGroupId
        \o message.capacity
        \o message.clientId
        \o message.clientQualifiedRole
        \o message.executorId
        \o message.executorQualifiedRole
        \o message.investorId
        \o message.investorQualifiedRole
        \o message.accountType
        \o message.postingInstruction
        \o EncodeUIntBE(Len(message.quote), 1)
        \o EncodeQuoteList(message.quote)

DecodeQuoteUpdateMessage(bytes) ==
    LET quoteUpdateId == ReadBytes(bytes, 16) IN IF ~quoteUpdateId.ok THEN Fail ELSE
    LET clearingFirm == ReadBytes(quoteUpdateId.rest, 4) IN IF ~clearingFirm.ok THEN Fail ELSE
    LET clearingAccount == ReadBytes(clearingFirm.rest, 4) IN IF ~clearingAccount.ok THEN Fail ELSE
    LET orderOrigination == ReadBytes(clearingAccount.rest, 1) IN IF ~orderOrigination.ok THEN Fail ELSE
    LET algorithmicIndicator == ReadBytes(orderOrigination.rest, 1) IN IF ~algorithmicIndicator.ok THEN Fail ELSE
    LET liquidityProvision == ReadBytes(algorithmicIndicator.rest, 1) IN IF ~liquidityProvision.ok THEN Fail ELSE
    LET custOrderHandlingInst == ReadBytes(liquidityProvision.rest, 1) IN IF ~custOrderHandlingInst.ok THEN Fail ELSE
    LET account == ReadBytes(custOrderHandlingInst.rest, 16) IN IF ~account.ok THEN Fail ELSE
    LET customGroupId == ReadBytes(account.rest, 2) IN IF ~customGroupId.ok THEN Fail ELSE
    LET capacity == ReadBytes(customGroupId.rest, 1) IN IF ~capacity.ok THEN Fail ELSE
    LET clientId == ReadBytes(capacity.rest, 4) IN IF ~clientId.ok THEN Fail ELSE
    LET clientQualifiedRole == ReadBytes(clientId.rest, 1) IN IF ~clientQualifiedRole.ok THEN Fail ELSE
    LET executorId == ReadBytes(clientQualifiedRole.rest, 4) IN IF ~executorId.ok THEN Fail ELSE
    LET executorQualifiedRole == ReadBytes(executorId.rest, 1) IN IF ~executorQualifiedRole.ok THEN Fail ELSE
    LET investorId == ReadBytes(executorQualifiedRole.rest, 4) IN IF ~investorId.ok THEN Fail ELSE
    LET investorQualifiedRole == ReadBytes(investorId.rest, 1) IN IF ~investorQualifiedRole.ok THEN Fail ELSE
    LET accountType == ReadBytes(investorQualifiedRole.rest, 1) IN IF ~accountType.ok THEN Fail ELSE
    LET postingInstruction == ReadBytes(accountType.rest, 1) IN IF ~postingInstruction.ok THEN Fail ELSE
    LET quoteCnt == ReadUIntBE(postingInstruction.rest, 1) IN IF ~quoteCnt.ok THEN Fail ELSE
    LET quote == ReadQuoteList(quoteCnt.rest, quoteCnt.value) IN IF ~quote.ok THEN Fail ELSE
    Ok([ quoteUpdateId         |-> quoteUpdateId.value,
         clearingFirm          |-> clearingFirm.value,
         clearingAccount       |-> clearingAccount.value,
         orderOrigination      |-> orderOrigination.value,
         algorithmicIndicator  |-> algorithmicIndicator.value,
         liquidityProvision    |-> liquidityProvision.value,
         custOrderHandlingInst |-> custOrderHandlingInst.value,
         account               |-> account.value,
         customGroupId         |-> customGroupId.value,
         capacity              |-> capacity.value,
         clientId              |-> clientId.value,
         clientQualifiedRole   |-> clientQualifiedRole.value,
         executorId            |-> executorId.value,
         executorQualifiedRole |-> executorQualifiedRole.value,
         investorId            |-> investorId.value,
         investorQualifiedRole |-> investorQualifiedRole.value,
         accountType           |-> accountType.value,
         postingInstruction    |-> postingInstruction.value,
         quote                 |-> quote.value ], quote.rest)

ZeroQuoteUpdateMessage ==
    [ quoteUpdateId         |-> [i \in 1 .. 16 |-> 0],
      clearingFirm          |-> [i \in 1 .. 4 |-> 0],
      clearingAccount       |-> [i \in 1 .. 4 |-> 0],
      orderOrigination      |-> [i \in 1 .. 1 |-> 0],
      algorithmicIndicator  |-> [i \in 1 .. 1 |-> 0],
      liquidityProvision    |-> [i \in 1 .. 1 |-> 0],
      custOrderHandlingInst |-> [i \in 1 .. 1 |-> 0],
      account               |-> [i \in 1 .. 16 |-> 0],
      customGroupId         |-> [i \in 1 .. 2 |-> 0],
      capacity              |-> [i \in 1 .. 1 |-> 0],
      clientId              |-> [i \in 1 .. 4 |-> 0],
      clientQualifiedRole   |-> [i \in 1 .. 1 |-> 0],
      executorId            |-> [i \in 1 .. 4 |-> 0],
      executorQualifiedRole |-> [i \in 1 .. 1 |-> 0],
      investorId            |-> [i \in 1 .. 4 |-> 0],
      investorQualifiedRole |-> [i \in 1 .. 1 |-> 0],
      accountType           |-> [i \in 1 .. 1 |-> 0],
      postingInstruction    |-> [i \in 1 .. 1 |-> 0],
      quote                 |-> << >> ]

(* Quote Update Message at zero, then each field in turn at the values it is checked at *)
CheckedQuoteUpdateMessage ==
    { ZeroQuoteUpdateMessage }
        \cup { [ZeroQuoteUpdateMessage EXCEPT !.quoteUpdateId = one] : one \in Sample(16) }
        \cup { [ZeroQuoteUpdateMessage EXCEPT !.clearingFirm = one] : one \in Sample(4) }
        \cup { [ZeroQuoteUpdateMessage EXCEPT !.clearingAccount = one] : one \in Sample(4) }
        \cup { [ZeroQuoteUpdateMessage EXCEPT !.orderOrigination = one] : one \in Sample(1) }
        \cup { [ZeroQuoteUpdateMessage EXCEPT !.algorithmicIndicator = one] : one \in Sample(1) }
        \cup { [ZeroQuoteUpdateMessage EXCEPT !.liquidityProvision = one] : one \in Sample(1) }
        \cup { [ZeroQuoteUpdateMessage EXCEPT !.custOrderHandlingInst = one] : one \in Sample(1) }
        \cup { [ZeroQuoteUpdateMessage EXCEPT !.account = one] : one \in Sample(16) }
        \cup { [ZeroQuoteUpdateMessage EXCEPT !.customGroupId = one] : one \in Sample(2) }
        \cup { [ZeroQuoteUpdateMessage EXCEPT !.capacity = one] : one \in Sample(1) }
        \cup { [ZeroQuoteUpdateMessage EXCEPT !.clientId = one] : one \in Sample(4) }
        \cup { [ZeroQuoteUpdateMessage EXCEPT !.clientQualifiedRole = one] : one \in Sample(1) }
        \cup { [ZeroQuoteUpdateMessage EXCEPT !.executorId = one] : one \in Sample(4) }
        \cup { [ZeroQuoteUpdateMessage EXCEPT !.executorQualifiedRole = one] : one \in Sample(1) }
        \cup { [ZeroQuoteUpdateMessage EXCEPT !.investorId = one] : one \in Sample(4) }
        \cup { [ZeroQuoteUpdateMessage EXCEPT !.investorQualifiedRole = one] : one \in Sample(1) }
        \cup { [ZeroQuoteUpdateMessage EXCEPT !.accountType = one] : one \in Sample(1) }
        \cup { [ZeroQuoteUpdateMessage EXCEPT !.postingInstruction = one] : one \in Sample(1) }
        \cup { [ZeroQuoteUpdateMessage EXCEPT !.quote = one] : one \in SampleLists(OneQuote) }

(***************************************************************************)
(* Custom Group Ids: 2 bytes                                               *)
(***************************************************************************)

CustomGroupIds ==
    [ customGroupId : Sample(2) ]

EncodeCustomGroupIds(message) ==
    message.customGroupId

DecodeCustomGroupIds(bytes) ==
    LET customGroupId == ReadBytes(bytes, 2) IN IF ~customGroupId.ok THEN Fail ELSE
    Ok([ customGroupId |-> customGroupId.value ], customGroupId.rest)

ZeroCustomGroupIds ==
    [ customGroupId |-> [i \in 1 .. 2 |-> 0] ]

(* Custom Group Ids at zero, then each field in turn at the values it is checked at *)
CheckedCustomGroupIds ==
    { ZeroCustomGroupIds }
        \cup { [ZeroCustomGroupIds EXCEPT !.customGroupId = one] : one \in Sample(2) }

(* A run of Custom Group Ids, written one after another *)
RECURSIVE EncodeCustomGroupIdsList(_)
EncodeCustomGroupIdsList(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeCustomGroupIds(Head(messages)) \o EncodeCustomGroupIdsList(Tail(messages))

(* As many Custom Group Ids as the field that counts them says *)
RECURSIVE ReadCustomGroupIdsList(_, _)
ReadCustomGroupIdsList(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeCustomGroupIds(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadCustomGroupIdsList(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Custom Group Ids of each kind, for the lists that carry them *)
OneCustomGroupIds == { ZeroCustomGroupIds }

(***************************************************************************)
(* Purge Orders Message                                                    *)
(***************************************************************************)

PurgeOrdersMessage ==
    [ reserved1                    : Sample(1),
      numberOfPurgeOrdersBitfields : 0 .. 255,
      purgeOrdersBitfield1         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      purgeOrdersBitfield2         : { << >> } \cup { <<held>> : held \in Sample(1) },
      customGroupIds               : SampleLists(OneCustomGroupIds),
      clearingFirm                 : { << >> } \cup { <<held>> : held \in Sample(4) },
      productCode                  : { << >> } \cup { <<held>> : held \in Sample(6) },
      massCancelId                 : { << >> } \cup { <<held>> : held \in Sample(20) } ]

EncodePurgeOrdersMessage(message) ==
    message.reserved1
        \o EncodeUIntBE(message.numberOfPurgeOrdersBitfields, 1)
        \o (IF message.purgeOrdersBitfield1 = << >> THEN << >> ELSE EncodeUIntLE(message.purgeOrdersBitfield1[1], 1))
        \o (IF message.purgeOrdersBitfield2 = << >> THEN << >> ELSE message.purgeOrdersBitfield2[1])
        \o EncodeUIntBE(Len(message.customGroupIds), 1)
        \o EncodeCustomGroupIdsList(message.customGroupIds)
        \o (IF message.clearingFirm = << >> THEN << >> ELSE message.clearingFirm[1])
        \o (IF message.productCode = << >> THEN << >> ELSE message.productCode[1])
        \o (IF message.massCancelId = << >> THEN << >> ELSE message.massCancelId[1])

DecodePurgeOrdersMessage(bytes) ==
    LET reserved1 == ReadBytes(bytes, 1) IN IF ~reserved1.ok THEN Fail ELSE
    LET numberOfPurgeOrdersBitfields == ReadUIntBE(reserved1.rest, 1) IN IF ~numberOfPurgeOrdersBitfields.ok THEN Fail ELSE
    LET purgeOrdersBitfield1 == ReadWhen(numberOfPurgeOrdersBitfields.value >= 1, ReadUIntLE(numberOfPurgeOrdersBitfields.rest, 1), numberOfPurgeOrdersBitfields.rest) IN IF ~purgeOrdersBitfield1.ok THEN Fail ELSE
    LET purgeOrdersBitfield2 == ReadWhen(numberOfPurgeOrdersBitfields.value >= 2, ReadBytes(purgeOrdersBitfield1.rest, 1), purgeOrdersBitfield1.rest) IN IF ~purgeOrdersBitfield2.ok THEN Fail ELSE
    LET customGroupIdCnt == ReadUIntBE(purgeOrdersBitfield2.rest, 1) IN IF ~customGroupIdCnt.ok THEN Fail ELSE
    LET customGroupIds == ReadCustomGroupIdsList(customGroupIdCnt.rest, customGroupIdCnt.value) IN IF ~customGroupIds.ok THEN Fail ELSE
    LET clearingFirm == ReadWhen(numberOfPurgeOrdersBitfields.value >= 1 /\ (purgeOrdersBitfield1.value # << >> /\ purgeOrdersBitfield1.value[1] % 2 > 0), ReadBytes(customGroupIds.rest, 4), customGroupIds.rest) IN IF ~clearingFirm.ok THEN Fail ELSE
    LET productCode == ReadWhen(numberOfPurgeOrdersBitfields.value >= 1 /\ (purgeOrdersBitfield1.value # << >> /\ (purgeOrdersBitfield1.value[1] \div 8) % 2 > 0), ReadBytes(clearingFirm.rest, 6), clearingFirm.rest) IN IF ~productCode.ok THEN Fail ELSE
    LET massCancelId == ReadWhen(numberOfPurgeOrdersBitfields.value >= 1 /\ (purgeOrdersBitfield1.value # << >> /\ (purgeOrdersBitfield1.value[1] \div 16) % 2 > 0), ReadBytes(productCode.rest, 20), productCode.rest) IN IF ~massCancelId.ok THEN Fail ELSE
    Ok([ reserved1                    |-> reserved1.value,
         numberOfPurgeOrdersBitfields |-> numberOfPurgeOrdersBitfields.value,
         purgeOrdersBitfield1         |-> purgeOrdersBitfield1.value,
         purgeOrdersBitfield2         |-> purgeOrdersBitfield2.value,
         customGroupIds               |-> customGroupIds.value,
         clearingFirm                 |-> clearingFirm.value,
         productCode                  |-> productCode.value,
         massCancelId                 |-> massCancelId.value ], massCancelId.rest)

(* Purge Orders Message with each field marked present by fields before it there exactly where they say *)
SettlePurgeOrdersMessage(message) ==
    LET settled1 == [message EXCEPT !.purgeOrdersBitfield1 = IF message.numberOfPurgeOrdersBitfields >= 1 THEN (IF message.purgeOrdersBitfield1 = << >> THEN <<0>> ELSE message.purgeOrdersBitfield1) ELSE << >>]
        settled2 == [settled1 EXCEPT !.purgeOrdersBitfield2 = IF settled1.numberOfPurgeOrdersBitfields >= 2 THEN (IF settled1.purgeOrdersBitfield2 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled1.purgeOrdersBitfield2) ELSE << >>]
        settled3 == [settled2 EXCEPT !.clearingFirm = IF settled2.numberOfPurgeOrdersBitfields >= 1 /\ (settled2.purgeOrdersBitfield1 # << >> /\ settled2.purgeOrdersBitfield1[1] % 2 > 0) THEN (IF settled2.clearingFirm = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled2.clearingFirm) ELSE << >>]
        settled4 == [settled3 EXCEPT !.productCode = IF settled3.numberOfPurgeOrdersBitfields >= 1 /\ (settled3.purgeOrdersBitfield1 # << >> /\ (settled3.purgeOrdersBitfield1[1] \div 8) % 2 > 0) THEN (IF settled3.productCode = << >> THEN <<[i \in 1 .. 6 |-> 0]>> ELSE settled3.productCode) ELSE << >>]
        settled5 == [settled4 EXCEPT !.massCancelId = IF settled4.numberOfPurgeOrdersBitfields >= 1 /\ (settled4.purgeOrdersBitfield1 # << >> /\ (settled4.purgeOrdersBitfield1[1] \div 16) % 2 > 0) THEN (IF settled4.massCancelId = << >> THEN <<[i \in 1 .. 20 |-> 0]>> ELSE settled4.massCancelId) ELSE << >>]
    IN  settled5

ZeroPurgeOrdersMessage ==
    SettlePurgeOrdersMessage([ reserved1                    |-> [i \in 1 .. 1 |-> 0],
                               numberOfPurgeOrdersBitfields |-> 0,
                               purgeOrdersBitfield1         |-> << >>,
                               purgeOrdersBitfield2         |-> << >>,
                               customGroupIds               |-> << >>,
                               clearingFirm                 |-> << >>,
                               productCode                  |-> << >>,
                               massCancelId                 |-> << >> ])

(* Purge Orders Message at zero, then each field in turn at the values it is checked at *)
CheckedPurgeOrdersMessage ==
    { ZeroPurgeOrdersMessage }
        \cup { SettlePurgeOrdersMessage([ZeroPurgeOrdersMessage EXCEPT !.reserved1 = one]) : one \in Sample(1) }
        \cup { SettlePurgeOrdersMessage([ZeroPurgeOrdersMessage EXCEPT !.numberOfPurgeOrdersBitfields = one]) : one \in {0, 1, 255} }
        \cup { SettlePurgeOrdersMessage([ZeroPurgeOrdersMessage EXCEPT !.numberOfPurgeOrdersBitfields = 1, !.purgeOrdersBitfield1 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettlePurgeOrdersMessage([ZeroPurgeOrdersMessage EXCEPT !.numberOfPurgeOrdersBitfields = 2, !.purgeOrdersBitfield2 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeOrdersMessage([ZeroPurgeOrdersMessage EXCEPT !.customGroupIds = one]) : one \in SampleLists(OneCustomGroupIds) }
        \cup { SettlePurgeOrdersMessage([ZeroPurgeOrdersMessage EXCEPT !.numberOfPurgeOrdersBitfields = 1, !.purgeOrdersBitfield1 = <<1>>, !.clearingFirm = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettlePurgeOrdersMessage([ZeroPurgeOrdersMessage EXCEPT !.numberOfPurgeOrdersBitfields = 1, !.purgeOrdersBitfield1 = <<8>>, !.productCode = one]) : one \in { <<held>> : held \in Sample(6) } }
        \cup { SettlePurgeOrdersMessage([ZeroPurgeOrdersMessage EXCEPT !.numberOfPurgeOrdersBitfields = 1, !.purgeOrdersBitfield1 = <<16>>, !.massCancelId = one]) : one \in { <<held>> : held \in Sample(20) } }

(***************************************************************************)
(* Reset Risk Message: 40 bytes                                            *)
(***************************************************************************)

ResetRiskMessage ==
    [ riskStatusId  : Sample(16),
      riskReset     : Sample(8),
      reserved4     : Sample(4),
      clearingFirm  : Sample(4),
      symbolShort   : Sample(6),
      customGroupId : Sample(2) ]

EncodeResetRiskMessage(message) ==
    message.riskStatusId
        \o message.riskReset
        \o message.reserved4
        \o message.clearingFirm
        \o message.symbolShort
        \o message.customGroupId

DecodeResetRiskMessage(bytes) ==
    LET riskStatusId == ReadBytes(bytes, 16) IN IF ~riskStatusId.ok THEN Fail ELSE
    LET riskReset == ReadBytes(riskStatusId.rest, 8) IN IF ~riskReset.ok THEN Fail ELSE
    LET reserved4 == ReadBytes(riskReset.rest, 4) IN IF ~reserved4.ok THEN Fail ELSE
    LET clearingFirm == ReadBytes(reserved4.rest, 4) IN IF ~clearingFirm.ok THEN Fail ELSE
    LET symbolShort == ReadBytes(clearingFirm.rest, 6) IN IF ~symbolShort.ok THEN Fail ELSE
    LET customGroupId == ReadBytes(symbolShort.rest, 2) IN IF ~customGroupId.ok THEN Fail ELSE
    Ok([ riskStatusId  |-> riskStatusId.value,
         riskReset     |-> riskReset.value,
         reserved4     |-> reserved4.value,
         clearingFirm  |-> clearingFirm.value,
         symbolShort   |-> symbolShort.value,
         customGroupId |-> customGroupId.value ], customGroupId.rest)

ZeroResetRiskMessage ==
    [ riskStatusId  |-> [i \in 1 .. 16 |-> 0],
      riskReset     |-> [i \in 1 .. 8 |-> 0],
      reserved4     |-> [i \in 1 .. 4 |-> 0],
      clearingFirm  |-> [i \in 1 .. 4 |-> 0],
      symbolShort   |-> [i \in 1 .. 6 |-> 0],
      customGroupId |-> [i \in 1 .. 2 |-> 0] ]

(* Reset Risk Message at zero, then each field in turn at the values it is checked at *)
CheckedResetRiskMessage ==
    { ZeroResetRiskMessage }
        \cup { [ZeroResetRiskMessage EXCEPT !.riskStatusId = one] : one \in Sample(16) }
        \cup { [ZeroResetRiskMessage EXCEPT !.riskReset = one] : one \in Sample(8) }
        \cup { [ZeroResetRiskMessage EXCEPT !.reserved4 = one] : one \in Sample(4) }
        \cup { [ZeroResetRiskMessage EXCEPT !.clearingFirm = one] : one \in Sample(4) }
        \cup { [ZeroResetRiskMessage EXCEPT !.symbolShort = one] : one \in Sample(6) }
        \cup { [ZeroResetRiskMessage EXCEPT !.customGroupId = one] : one \in Sample(2) }

(***************************************************************************)
(* Complex Leg: 21 bytes                                                   *)
(***************************************************************************)

ComplexLeg ==
    [ legSymbol   : Sample(8),
      legPrice    : Sample(8),
      legRatioQty : Sample(4),
      legSide     : Sample(1) ]

EncodeComplexLeg(message) ==
    message.legSymbol
        \o message.legPrice
        \o message.legRatioQty
        \o message.legSide

DecodeComplexLeg(bytes) ==
    LET legSymbol == ReadBytes(bytes, 8) IN IF ~legSymbol.ok THEN Fail ELSE
    LET legPrice == ReadBytes(legSymbol.rest, 8) IN IF ~legPrice.ok THEN Fail ELSE
    LET legRatioQty == ReadBytes(legPrice.rest, 4) IN IF ~legRatioQty.ok THEN Fail ELSE
    LET legSide == ReadBytes(legRatioQty.rest, 1) IN IF ~legSide.ok THEN Fail ELSE
    Ok([ legSymbol   |-> legSymbol.value,
         legPrice    |-> legPrice.value,
         legRatioQty |-> legRatioQty.value,
         legSide     |-> legSide.value ], legSide.rest)

ZeroComplexLeg ==
    [ legSymbol   |-> [i \in 1 .. 8 |-> 0],
      legPrice    |-> [i \in 1 .. 8 |-> 0],
      legRatioQty |-> [i \in 1 .. 4 |-> 0],
      legSide     |-> [i \in 1 .. 1 |-> 0] ]

(* Complex Leg at zero, then each field in turn at the values it is checked at *)
CheckedComplexLeg ==
    { ZeroComplexLeg }
        \cup { [ZeroComplexLeg EXCEPT !.legSymbol = one] : one \in Sample(8) }
        \cup { [ZeroComplexLeg EXCEPT !.legPrice = one] : one \in Sample(8) }
        \cup { [ZeroComplexLeg EXCEPT !.legRatioQty = one] : one \in Sample(4) }
        \cup { [ZeroComplexLeg EXCEPT !.legSide = one] : one \in Sample(1) }

(* A run of Complex Leg, written one after another *)
RECURSIVE EncodeComplexLegList(_)
EncodeComplexLegList(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeComplexLeg(Head(messages)) \o EncodeComplexLegList(Tail(messages))

(* As many Complex Leg as the field that counts them says *)
RECURSIVE ReadComplexLegList(_, _)
ReadComplexLegList(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeComplexLeg(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadComplexLegList(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Complex Leg of each kind, for the lists that carry them *)
OneComplexLeg == { ZeroComplexLeg }

(***************************************************************************)
(* New Complex Instrument Message                                          *)
(***************************************************************************)

NewComplexInstrumentMessage ==
    [ clOrdId                               : Sample(20),
      numberOfNewComplexInstrumentBitfields : 0 .. 255,
      newComplexInstrumentBitfield1         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      complexLeg                            : SampleLists(OneComplexLeg),
      clearingFirm                          : { << >> } \cup { <<held>> : held \in Sample(4) },
      legPrice                              : { << >> } \cup { <<held>> : held \in Sample(8) } ]

EncodeNewComplexInstrumentMessage(message) ==
    message.clOrdId
        \o EncodeUIntBE(message.numberOfNewComplexInstrumentBitfields, 1)
        \o (IF message.newComplexInstrumentBitfield1 = << >> THEN << >> ELSE EncodeUIntLE(message.newComplexInstrumentBitfield1[1], 1))
        \o EncodeUIntBE(Len(message.complexLeg), 1)
        \o EncodeComplexLegList(message.complexLeg)
        \o (IF message.clearingFirm = << >> THEN << >> ELSE message.clearingFirm[1])
        \o (IF message.legPrice = << >> THEN << >> ELSE message.legPrice[1])

DecodeNewComplexInstrumentMessage(bytes) ==
    LET clOrdId == ReadBytes(bytes, 20) IN IF ~clOrdId.ok THEN Fail ELSE
    LET numberOfNewComplexInstrumentBitfields == ReadUIntBE(clOrdId.rest, 1) IN IF ~numberOfNewComplexInstrumentBitfields.ok THEN Fail ELSE
    LET newComplexInstrumentBitfield1 == ReadWhen(numberOfNewComplexInstrumentBitfields.value >= 1, ReadUIntLE(numberOfNewComplexInstrumentBitfields.rest, 1), numberOfNewComplexInstrumentBitfields.rest) IN IF ~newComplexInstrumentBitfield1.ok THEN Fail ELSE
    LET noLegs == ReadUIntBE(newComplexInstrumentBitfield1.rest, 1) IN IF ~noLegs.ok THEN Fail ELSE
    LET complexLeg == ReadComplexLegList(noLegs.rest, noLegs.value) IN IF ~complexLeg.ok THEN Fail ELSE
    LET clearingFirm == ReadWhen(numberOfNewComplexInstrumentBitfields.value >= 1 /\ (newComplexInstrumentBitfield1.value # << >> /\ (newComplexInstrumentBitfield1.value[1] \div 8) % 2 > 0), ReadBytes(complexLeg.rest, 4), complexLeg.rest) IN IF ~clearingFirm.ok THEN Fail ELSE
    LET legPrice == ReadWhen(numberOfNewComplexInstrumentBitfields.value >= 1 /\ (newComplexInstrumentBitfield1.value # << >> /\ (newComplexInstrumentBitfield1.value[1] \div 32) % 2 > 0), ReadBytes(clearingFirm.rest, 8), clearingFirm.rest) IN IF ~legPrice.ok THEN Fail ELSE
    Ok([ clOrdId                               |-> clOrdId.value,
         numberOfNewComplexInstrumentBitfields |-> numberOfNewComplexInstrumentBitfields.value,
         newComplexInstrumentBitfield1         |-> newComplexInstrumentBitfield1.value,
         complexLeg                            |-> complexLeg.value,
         clearingFirm                          |-> clearingFirm.value,
         legPrice                              |-> legPrice.value ], legPrice.rest)

(* New Complex Instrument Message with each field marked present by fields before it there exactly where they say *)
SettleNewComplexInstrumentMessage(message) ==
    LET settled1 == [message EXCEPT !.newComplexInstrumentBitfield1 = IF message.numberOfNewComplexInstrumentBitfields >= 1 THEN (IF message.newComplexInstrumentBitfield1 = << >> THEN <<0>> ELSE message.newComplexInstrumentBitfield1) ELSE << >>]
        settled2 == [settled1 EXCEPT !.clearingFirm = IF settled1.numberOfNewComplexInstrumentBitfields >= 1 /\ (settled1.newComplexInstrumentBitfield1 # << >> /\ (settled1.newComplexInstrumentBitfield1[1] \div 8) % 2 > 0) THEN (IF settled1.clearingFirm = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled1.clearingFirm) ELSE << >>]
        settled3 == [settled2 EXCEPT !.legPrice = IF settled2.numberOfNewComplexInstrumentBitfields >= 1 /\ (settled2.newComplexInstrumentBitfield1 # << >> /\ (settled2.newComplexInstrumentBitfield1[1] \div 32) % 2 > 0) THEN (IF settled2.legPrice = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled2.legPrice) ELSE << >>]
    IN  settled3

ZeroNewComplexInstrumentMessage ==
    SettleNewComplexInstrumentMessage([ clOrdId                               |-> [i \in 1 .. 20 |-> 0],
                                        numberOfNewComplexInstrumentBitfields |-> 0,
                                        newComplexInstrumentBitfield1         |-> << >>,
                                        complexLeg                            |-> << >>,
                                        clearingFirm                          |-> << >>,
                                        legPrice                              |-> << >> ])

(* New Complex Instrument Message at zero, then each field in turn at the values it is checked at *)
CheckedNewComplexInstrumentMessage ==
    { ZeroNewComplexInstrumentMessage }
        \cup { SettleNewComplexInstrumentMessage([ZeroNewComplexInstrumentMessage EXCEPT !.clOrdId = one]) : one \in Sample(20) }
        \cup { SettleNewComplexInstrumentMessage([ZeroNewComplexInstrumentMessage EXCEPT !.numberOfNewComplexInstrumentBitfields = one]) : one \in {0, 1, 255} }
        \cup { SettleNewComplexInstrumentMessage([ZeroNewComplexInstrumentMessage EXCEPT !.numberOfNewComplexInstrumentBitfields = 1, !.newComplexInstrumentBitfield1 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleNewComplexInstrumentMessage([ZeroNewComplexInstrumentMessage EXCEPT !.complexLeg = one]) : one \in SampleLists(OneComplexLeg) }
        \cup { SettleNewComplexInstrumentMessage([ZeroNewComplexInstrumentMessage EXCEPT !.numberOfNewComplexInstrumentBitfields = 1, !.newComplexInstrumentBitfield1 = <<8>>, !.clearingFirm = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleNewComplexInstrumentMessage([ZeroNewComplexInstrumentMessage EXCEPT !.numberOfNewComplexInstrumentBitfields = 1, !.newComplexInstrumentBitfield1 = <<32>>, !.legPrice = one]) : one \in { <<held>> : held \in Sample(8) } }

(***************************************************************************)
(* Trade Capture Report V 2 Message                                        *)
(***************************************************************************)

TradeCaptureReportV2Message ==
    [ tradeReportId                         : Sample(20),
      lastShares                            : Sample(4),
      tradeCaptureLastPx                    : Sample(8),
      numberOfTradeCaptureReportV2Bitfields : 0 .. 255,
      tradeCaptureReportV2Bitfield1         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      tradeCaptureReportV2Bitfield2         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      tradeCaptureReportV2Bitfield3         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      tradeCaptureReportV2Bitfield4         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      tradeCaptureReportV2Bitfield5         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      tradeCaptureReportV2Bitfield6         : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      noSides                               : Sample(1),
      symbolLong                            : { << >> } \cup { <<held>> : held \in Sample(8) },
      idSource                              : { << >> } \cup { <<held>> : held \in Sample(1) },
      securityId                            : { << >> } \cup { <<held>> : held \in Sample(16) },
      capacity                              : { << >> } \cup { <<held>> : held \in Sample(1) },
      account                               : { << >> } \cup { <<held>> : held \in Sample(16) },
      transactionCategory                   : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeTime                             : { << >> } \cup { <<held>> : held \in Sample(8) },
      partyRole                             : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeReportTransType                  : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeId                               : { << >> } \cup { <<held>> : held \in Sample(8) },
      venueType                             : { << >> } \cup { <<held>> : held \in Sample(1) },
      matchType                             : { << >> } \cup { <<held>> : held \in Sample(1) },
      trdSubType                            : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradePublishIndicator                 : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeReportType                       : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeHandlingInstruction              : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeLinkId                           : { << >> } \cup { <<held>> : held \in Sample(1) },
      grossTradeAmt                         : { << >> } \cup { <<held>> : held \in Sample(8) },
      tolerance                             : { << >> } \cup { <<held>> : held \in Sample(2) },
      orderCategory                         : { << >> } \cup { <<held>> : held \in Sample(1) },
      priceFormation                        : { << >> } \cup { <<held>> : held \in Sample(1) },
      algorithmicIndicator                  : { << >> } \cup { <<held>> : held \in Sample(1) },
      custOrderHandlingInst                 : { << >> } \cup { <<held>> : held \in Sample(1) },
      openClose                             : { << >> } \cup { <<held>> : held \in Sample(1) },
      accountType                           : { << >> } \cup { <<held>> : held \in Sample(1) } ]

EncodeTradeCaptureReportV2Message(message) ==
    message.tradeReportId
        \o message.lastShares
        \o message.tradeCaptureLastPx
        \o EncodeUIntBE(message.numberOfTradeCaptureReportV2Bitfields, 1)
        \o (IF message.tradeCaptureReportV2Bitfield1 = << >> THEN << >> ELSE EncodeUIntLE(message.tradeCaptureReportV2Bitfield1[1], 1))
        \o (IF message.tradeCaptureReportV2Bitfield2 = << >> THEN << >> ELSE EncodeUIntLE(message.tradeCaptureReportV2Bitfield2[1], 1))
        \o (IF message.tradeCaptureReportV2Bitfield3 = << >> THEN << >> ELSE EncodeUIntLE(message.tradeCaptureReportV2Bitfield3[1], 1))
        \o (IF message.tradeCaptureReportV2Bitfield4 = << >> THEN << >> ELSE EncodeUIntLE(message.tradeCaptureReportV2Bitfield4[1], 1))
        \o (IF message.tradeCaptureReportV2Bitfield5 = << >> THEN << >> ELSE EncodeUIntLE(message.tradeCaptureReportV2Bitfield5[1], 1))
        \o (IF message.tradeCaptureReportV2Bitfield6 = << >> THEN << >> ELSE EncodeUIntLE(message.tradeCaptureReportV2Bitfield6[1], 1))
        \o message.noSides
        \o (IF message.symbolLong = << >> THEN << >> ELSE message.symbolLong[1])
        \o (IF message.idSource = << >> THEN << >> ELSE message.idSource[1])
        \o (IF message.securityId = << >> THEN << >> ELSE message.securityId[1])
        \o (IF message.capacity = << >> THEN << >> ELSE message.capacity[1])
        \o (IF message.account = << >> THEN << >> ELSE message.account[1])
        \o (IF message.transactionCategory = << >> THEN << >> ELSE message.transactionCategory[1])
        \o (IF message.tradeTime = << >> THEN << >> ELSE message.tradeTime[1])
        \o (IF message.partyRole = << >> THEN << >> ELSE message.partyRole[1])
        \o (IF message.tradeReportTransType = << >> THEN << >> ELSE message.tradeReportTransType[1])
        \o (IF message.tradeId = << >> THEN << >> ELSE message.tradeId[1])
        \o (IF message.venueType = << >> THEN << >> ELSE message.venueType[1])
        \o (IF message.matchType = << >> THEN << >> ELSE message.matchType[1])
        \o (IF message.trdSubType = << >> THEN << >> ELSE message.trdSubType[1])
        \o (IF message.tradePublishIndicator = << >> THEN << >> ELSE message.tradePublishIndicator[1])
        \o (IF message.tradeReportType = << >> THEN << >> ELSE message.tradeReportType[1])
        \o (IF message.tradeHandlingInstruction = << >> THEN << >> ELSE message.tradeHandlingInstruction[1])
        \o (IF message.tradeLinkId = << >> THEN << >> ELSE message.tradeLinkId[1])
        \o (IF message.grossTradeAmt = << >> THEN << >> ELSE message.grossTradeAmt[1])
        \o (IF message.tolerance = << >> THEN << >> ELSE message.tolerance[1])
        \o (IF message.orderCategory = << >> THEN << >> ELSE message.orderCategory[1])
        \o (IF message.priceFormation = << >> THEN << >> ELSE message.priceFormation[1])
        \o (IF message.algorithmicIndicator = << >> THEN << >> ELSE message.algorithmicIndicator[1])
        \o (IF message.custOrderHandlingInst = << >> THEN << >> ELSE message.custOrderHandlingInst[1])
        \o (IF message.openClose = << >> THEN << >> ELSE message.openClose[1])
        \o (IF message.accountType = << >> THEN << >> ELSE message.accountType[1])

DecodeTradeCaptureReportV2Message(bytes) ==
    LET tradeReportId == ReadBytes(bytes, 20) IN IF ~tradeReportId.ok THEN Fail ELSE
    LET lastShares == ReadBytes(tradeReportId.rest, 4) IN IF ~lastShares.ok THEN Fail ELSE
    LET tradeCaptureLastPx == ReadBytes(lastShares.rest, 8) IN IF ~tradeCaptureLastPx.ok THEN Fail ELSE
    LET numberOfTradeCaptureReportV2Bitfields == ReadUIntBE(tradeCaptureLastPx.rest, 1) IN IF ~numberOfTradeCaptureReportV2Bitfields.ok THEN Fail ELSE
    LET tradeCaptureReportV2Bitfield1 == ReadWhen(numberOfTradeCaptureReportV2Bitfields.value >= 1, ReadUIntLE(numberOfTradeCaptureReportV2Bitfields.rest, 1), numberOfTradeCaptureReportV2Bitfields.rest) IN IF ~tradeCaptureReportV2Bitfield1.ok THEN Fail ELSE
    LET tradeCaptureReportV2Bitfield2 == ReadWhen(numberOfTradeCaptureReportV2Bitfields.value >= 2, ReadUIntLE(tradeCaptureReportV2Bitfield1.rest, 1), tradeCaptureReportV2Bitfield1.rest) IN IF ~tradeCaptureReportV2Bitfield2.ok THEN Fail ELSE
    LET tradeCaptureReportV2Bitfield3 == ReadWhen(numberOfTradeCaptureReportV2Bitfields.value >= 3, ReadUIntLE(tradeCaptureReportV2Bitfield2.rest, 1), tradeCaptureReportV2Bitfield2.rest) IN IF ~tradeCaptureReportV2Bitfield3.ok THEN Fail ELSE
    LET tradeCaptureReportV2Bitfield4 == ReadWhen(numberOfTradeCaptureReportV2Bitfields.value >= 4, ReadUIntLE(tradeCaptureReportV2Bitfield3.rest, 1), tradeCaptureReportV2Bitfield3.rest) IN IF ~tradeCaptureReportV2Bitfield4.ok THEN Fail ELSE
    LET tradeCaptureReportV2Bitfield5 == ReadWhen(numberOfTradeCaptureReportV2Bitfields.value >= 5, ReadUIntLE(tradeCaptureReportV2Bitfield4.rest, 1), tradeCaptureReportV2Bitfield4.rest) IN IF ~tradeCaptureReportV2Bitfield5.ok THEN Fail ELSE
    LET tradeCaptureReportV2Bitfield6 == ReadWhen(numberOfTradeCaptureReportV2Bitfields.value >= 6, ReadUIntLE(tradeCaptureReportV2Bitfield5.rest, 1), tradeCaptureReportV2Bitfield5.rest) IN IF ~tradeCaptureReportV2Bitfield6.ok THEN Fail ELSE
    LET noSides == ReadBytes(tradeCaptureReportV2Bitfield6.rest, 1) IN IF ~noSides.ok THEN Fail ELSE
    LET symbolLong == ReadWhen(numberOfTradeCaptureReportV2Bitfields.value >= 1 /\ (tradeCaptureReportV2Bitfield1.value # << >> /\ tradeCaptureReportV2Bitfield1.value[1] % 2 > 0), ReadBytes(noSides.rest, 8), noSides.rest) IN IF ~symbolLong.ok THEN Fail ELSE
    LET idSource == ReadWhen(numberOfTradeCaptureReportV2Bitfields.value >= 1 /\ (tradeCaptureReportV2Bitfield1.value # << >> /\ (tradeCaptureReportV2Bitfield1.value[1] \div 8) % 2 > 0), ReadBytes(symbolLong.rest, 1), symbolLong.rest) IN IF ~idSource.ok THEN Fail ELSE
    LET securityId == ReadWhen(numberOfTradeCaptureReportV2Bitfields.value >= 1 /\ (tradeCaptureReportV2Bitfield1.value # << >> /\ (tradeCaptureReportV2Bitfield1.value[1] \div 16) % 2 > 0), ReadBytes(idSource.rest, 16), idSource.rest) IN IF ~securityId.ok THEN Fail ELSE
    LET capacity == ReadWhen(numberOfTradeCaptureReportV2Bitfields.value >= 2 /\ (tradeCaptureReportV2Bitfield2.value # << >> /\ tradeCaptureReportV2Bitfield2.value[1] % 2 > 0), ReadBytes(securityId.rest, 1), securityId.rest) IN IF ~capacity.ok THEN Fail ELSE
    LET account == ReadWhen(numberOfTradeCaptureReportV2Bitfields.value >= 2 /\ (tradeCaptureReportV2Bitfield2.value # << >> /\ (tradeCaptureReportV2Bitfield2.value[1] \div 2) % 2 > 0), ReadBytes(capacity.rest, 16), capacity.rest) IN IF ~account.ok THEN Fail ELSE
    LET transactionCategory == ReadWhen(numberOfTradeCaptureReportV2Bitfields.value >= 2 /\ (tradeCaptureReportV2Bitfield2.value # << >> /\ (tradeCaptureReportV2Bitfield2.value[1] \div 4) % 2 > 0), ReadBytes(account.rest, 1), account.rest) IN IF ~transactionCategory.ok THEN Fail ELSE
    LET tradeTime == ReadWhen(numberOfTradeCaptureReportV2Bitfields.value >= 2 /\ (tradeCaptureReportV2Bitfield2.value # << >> /\ (tradeCaptureReportV2Bitfield2.value[1] \div 8) % 2 > 0), ReadBytes(transactionCategory.rest, 8), transactionCategory.rest) IN IF ~tradeTime.ok THEN Fail ELSE
    LET partyRole == ReadWhen(numberOfTradeCaptureReportV2Bitfields.value >= 2 /\ (tradeCaptureReportV2Bitfield2.value # << >> /\ (tradeCaptureReportV2Bitfield2.value[1] \div 16) % 2 > 0), ReadBytes(tradeTime.rest, 1), tradeTime.rest) IN IF ~partyRole.ok THEN Fail ELSE
    LET tradeReportTransType == ReadWhen(numberOfTradeCaptureReportV2Bitfields.value >= 2 /\ (tradeCaptureReportV2Bitfield2.value # << >> /\ (tradeCaptureReportV2Bitfield2.value[1] \div 32) % 2 > 0), ReadBytes(partyRole.rest, 1), partyRole.rest) IN IF ~tradeReportTransType.ok THEN Fail ELSE
    LET tradeId == ReadWhen(numberOfTradeCaptureReportV2Bitfields.value >= 2 /\ (tradeCaptureReportV2Bitfield2.value # << >> /\ (tradeCaptureReportV2Bitfield2.value[1] \div 64) % 2 > 0), ReadBytes(tradeReportTransType.rest, 8), tradeReportTransType.rest) IN IF ~tradeId.ok THEN Fail ELSE
    LET venueType == ReadWhen(numberOfTradeCaptureReportV2Bitfields.value >= 2 /\ (tradeCaptureReportV2Bitfield2.value # << >> /\ (tradeCaptureReportV2Bitfield2.value[1] \div 128) % 2 > 0), ReadBytes(tradeId.rest, 1), tradeId.rest) IN IF ~venueType.ok THEN Fail ELSE
    LET matchType == ReadWhen(numberOfTradeCaptureReportV2Bitfields.value >= 3 /\ (tradeCaptureReportV2Bitfield3.value # << >> /\ (tradeCaptureReportV2Bitfield3.value[1] \div 2) % 2 > 0), ReadBytes(venueType.rest, 1), venueType.rest) IN IF ~matchType.ok THEN Fail ELSE
    LET trdSubType == ReadWhen(numberOfTradeCaptureReportV2Bitfields.value >= 3 /\ (tradeCaptureReportV2Bitfield3.value # << >> /\ (tradeCaptureReportV2Bitfield3.value[1] \div 4) % 2 > 0), ReadBytes(matchType.rest, 1), matchType.rest) IN IF ~trdSubType.ok THEN Fail ELSE
    LET tradePublishIndicator == ReadWhen(numberOfTradeCaptureReportV2Bitfields.value >= 3 /\ (tradeCaptureReportV2Bitfield3.value # << >> /\ (tradeCaptureReportV2Bitfield3.value[1] \div 32) % 2 > 0), ReadBytes(trdSubType.rest, 1), trdSubType.rest) IN IF ~tradePublishIndicator.ok THEN Fail ELSE
    LET tradeReportType == ReadWhen(numberOfTradeCaptureReportV2Bitfields.value >= 4 /\ (tradeCaptureReportV2Bitfield4.value # << >> /\ tradeCaptureReportV2Bitfield4.value[1] % 2 > 0), ReadBytes(tradePublishIndicator.rest, 1), tradePublishIndicator.rest) IN IF ~tradeReportType.ok THEN Fail ELSE
    LET tradeHandlingInstruction == ReadWhen(numberOfTradeCaptureReportV2Bitfields.value >= 4 /\ (tradeCaptureReportV2Bitfield4.value # << >> /\ (tradeCaptureReportV2Bitfield4.value[1] \div 2) % 2 > 0), ReadBytes(tradeReportType.rest, 1), tradeReportType.rest) IN IF ~tradeHandlingInstruction.ok THEN Fail ELSE
    LET tradeLinkId == ReadWhen(numberOfTradeCaptureReportV2Bitfields.value >= 4 /\ (tradeCaptureReportV2Bitfield4.value # << >> /\ (tradeCaptureReportV2Bitfield4.value[1] \div 4) % 2 > 0), ReadBytes(tradeHandlingInstruction.rest, 1), tradeHandlingInstruction.rest) IN IF ~tradeLinkId.ok THEN Fail ELSE
    LET grossTradeAmt == ReadWhen(numberOfTradeCaptureReportV2Bitfields.value >= 4 /\ (tradeCaptureReportV2Bitfield4.value # << >> /\ (tradeCaptureReportV2Bitfield4.value[1] \div 16) % 2 > 0), ReadBytes(tradeLinkId.rest, 8), tradeLinkId.rest) IN IF ~grossTradeAmt.ok THEN Fail ELSE
    LET tolerance == ReadWhen(numberOfTradeCaptureReportV2Bitfields.value >= 4 /\ (tradeCaptureReportV2Bitfield4.value # << >> /\ (tradeCaptureReportV2Bitfield4.value[1] \div 32) % 2 > 0), ReadBytes(grossTradeAmt.rest, 2), grossTradeAmt.rest) IN IF ~tolerance.ok THEN Fail ELSE
    LET orderCategory == ReadWhen(numberOfTradeCaptureReportV2Bitfields.value >= 4 /\ (tradeCaptureReportV2Bitfield4.value # << >> /\ (tradeCaptureReportV2Bitfield4.value[1] \div 64) % 2 > 0), ReadBytes(tolerance.rest, 1), tolerance.rest) IN IF ~orderCategory.ok THEN Fail ELSE
    LET priceFormation == ReadWhen(numberOfTradeCaptureReportV2Bitfields.value >= 5 /\ (tradeCaptureReportV2Bitfield5.value # << >> /\ (tradeCaptureReportV2Bitfield5.value[1] \div 2) % 2 > 0), ReadBytes(orderCategory.rest, 1), orderCategory.rest) IN IF ~priceFormation.ok THEN Fail ELSE
    LET algorithmicIndicator == ReadWhen(numberOfTradeCaptureReportV2Bitfields.value >= 5 /\ (tradeCaptureReportV2Bitfield5.value # << >> /\ (tradeCaptureReportV2Bitfield5.value[1] \div 4) % 2 > 0), ReadBytes(priceFormation.rest, 1), priceFormation.rest) IN IF ~algorithmicIndicator.ok THEN Fail ELSE
    LET custOrderHandlingInst == ReadWhen(numberOfTradeCaptureReportV2Bitfields.value >= 6 /\ (tradeCaptureReportV2Bitfield6.value # << >> /\ tradeCaptureReportV2Bitfield6.value[1] % 2 > 0), ReadBytes(algorithmicIndicator.rest, 1), algorithmicIndicator.rest) IN IF ~custOrderHandlingInst.ok THEN Fail ELSE
    LET openClose == ReadWhen(numberOfTradeCaptureReportV2Bitfields.value >= 6 /\ (tradeCaptureReportV2Bitfield6.value # << >> /\ (tradeCaptureReportV2Bitfield6.value[1] \div 2) % 2 > 0), ReadBytes(custOrderHandlingInst.rest, 1), custOrderHandlingInst.rest) IN IF ~openClose.ok THEN Fail ELSE
    LET accountType == ReadWhen(numberOfTradeCaptureReportV2Bitfields.value >= 6 /\ (tradeCaptureReportV2Bitfield6.value # << >> /\ (tradeCaptureReportV2Bitfield6.value[1] \div 4) % 2 > 0), ReadBytes(openClose.rest, 1), openClose.rest) IN IF ~accountType.ok THEN Fail ELSE
    Ok([ tradeReportId                         |-> tradeReportId.value,
         lastShares                            |-> lastShares.value,
         tradeCaptureLastPx                    |-> tradeCaptureLastPx.value,
         numberOfTradeCaptureReportV2Bitfields |-> numberOfTradeCaptureReportV2Bitfields.value,
         tradeCaptureReportV2Bitfield1         |-> tradeCaptureReportV2Bitfield1.value,
         tradeCaptureReportV2Bitfield2         |-> tradeCaptureReportV2Bitfield2.value,
         tradeCaptureReportV2Bitfield3         |-> tradeCaptureReportV2Bitfield3.value,
         tradeCaptureReportV2Bitfield4         |-> tradeCaptureReportV2Bitfield4.value,
         tradeCaptureReportV2Bitfield5         |-> tradeCaptureReportV2Bitfield5.value,
         tradeCaptureReportV2Bitfield6         |-> tradeCaptureReportV2Bitfield6.value,
         noSides                               |-> noSides.value,
         symbolLong                            |-> symbolLong.value,
         idSource                              |-> idSource.value,
         securityId                            |-> securityId.value,
         capacity                              |-> capacity.value,
         account                               |-> account.value,
         transactionCategory                   |-> transactionCategory.value,
         tradeTime                             |-> tradeTime.value,
         partyRole                             |-> partyRole.value,
         tradeReportTransType                  |-> tradeReportTransType.value,
         tradeId                               |-> tradeId.value,
         venueType                             |-> venueType.value,
         matchType                             |-> matchType.value,
         trdSubType                            |-> trdSubType.value,
         tradePublishIndicator                 |-> tradePublishIndicator.value,
         tradeReportType                       |-> tradeReportType.value,
         tradeHandlingInstruction              |-> tradeHandlingInstruction.value,
         tradeLinkId                           |-> tradeLinkId.value,
         grossTradeAmt                         |-> grossTradeAmt.value,
         tolerance                             |-> tolerance.value,
         orderCategory                         |-> orderCategory.value,
         priceFormation                        |-> priceFormation.value,
         algorithmicIndicator                  |-> algorithmicIndicator.value,
         custOrderHandlingInst                 |-> custOrderHandlingInst.value,
         openClose                             |-> openClose.value,
         accountType                           |-> accountType.value ], accountType.rest)

(* Trade Capture Report V 2 Message with each field marked present by fields before it there exactly where they say *)
SettleTradeCaptureReportV2Message(message) ==
    LET settled1 == [message EXCEPT !.tradeCaptureReportV2Bitfield1 = IF message.numberOfTradeCaptureReportV2Bitfields >= 1 THEN (IF message.tradeCaptureReportV2Bitfield1 = << >> THEN <<0>> ELSE message.tradeCaptureReportV2Bitfield1) ELSE << >>]
        settled2 == [settled1 EXCEPT !.tradeCaptureReportV2Bitfield2 = IF settled1.numberOfTradeCaptureReportV2Bitfields >= 2 THEN (IF settled1.tradeCaptureReportV2Bitfield2 = << >> THEN <<0>> ELSE settled1.tradeCaptureReportV2Bitfield2) ELSE << >>]
        settled3 == [settled2 EXCEPT !.tradeCaptureReportV2Bitfield3 = IF settled2.numberOfTradeCaptureReportV2Bitfields >= 3 THEN (IF settled2.tradeCaptureReportV2Bitfield3 = << >> THEN <<0>> ELSE settled2.tradeCaptureReportV2Bitfield3) ELSE << >>]
        settled4 == [settled3 EXCEPT !.tradeCaptureReportV2Bitfield4 = IF settled3.numberOfTradeCaptureReportV2Bitfields >= 4 THEN (IF settled3.tradeCaptureReportV2Bitfield4 = << >> THEN <<0>> ELSE settled3.tradeCaptureReportV2Bitfield4) ELSE << >>]
        settled5 == [settled4 EXCEPT !.tradeCaptureReportV2Bitfield5 = IF settled4.numberOfTradeCaptureReportV2Bitfields >= 5 THEN (IF settled4.tradeCaptureReportV2Bitfield5 = << >> THEN <<0>> ELSE settled4.tradeCaptureReportV2Bitfield5) ELSE << >>]
        settled6 == [settled5 EXCEPT !.tradeCaptureReportV2Bitfield6 = IF settled5.numberOfTradeCaptureReportV2Bitfields >= 6 THEN (IF settled5.tradeCaptureReportV2Bitfield6 = << >> THEN <<0>> ELSE settled5.tradeCaptureReportV2Bitfield6) ELSE << >>]
        settled7 == [settled6 EXCEPT !.symbolLong = IF settled6.numberOfTradeCaptureReportV2Bitfields >= 1 /\ (settled6.tradeCaptureReportV2Bitfield1 # << >> /\ settled6.tradeCaptureReportV2Bitfield1[1] % 2 > 0) THEN (IF settled6.symbolLong = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled6.symbolLong) ELSE << >>]
        settled8 == [settled7 EXCEPT !.idSource = IF settled7.numberOfTradeCaptureReportV2Bitfields >= 1 /\ (settled7.tradeCaptureReportV2Bitfield1 # << >> /\ (settled7.tradeCaptureReportV2Bitfield1[1] \div 8) % 2 > 0) THEN (IF settled7.idSource = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled7.idSource) ELSE << >>]
        settled9 == [settled8 EXCEPT !.securityId = IF settled8.numberOfTradeCaptureReportV2Bitfields >= 1 /\ (settled8.tradeCaptureReportV2Bitfield1 # << >> /\ (settled8.tradeCaptureReportV2Bitfield1[1] \div 16) % 2 > 0) THEN (IF settled8.securityId = << >> THEN <<[i \in 1 .. 16 |-> 0]>> ELSE settled8.securityId) ELSE << >>]
        settled10 == [settled9 EXCEPT !.capacity = IF settled9.numberOfTradeCaptureReportV2Bitfields >= 2 /\ (settled9.tradeCaptureReportV2Bitfield2 # << >> /\ settled9.tradeCaptureReportV2Bitfield2[1] % 2 > 0) THEN (IF settled9.capacity = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled9.capacity) ELSE << >>]
        settled11 == [settled10 EXCEPT !.account = IF settled10.numberOfTradeCaptureReportV2Bitfields >= 2 /\ (settled10.tradeCaptureReportV2Bitfield2 # << >> /\ (settled10.tradeCaptureReportV2Bitfield2[1] \div 2) % 2 > 0) THEN (IF settled10.account = << >> THEN <<[i \in 1 .. 16 |-> 0]>> ELSE settled10.account) ELSE << >>]
        settled12 == [settled11 EXCEPT !.transactionCategory = IF settled11.numberOfTradeCaptureReportV2Bitfields >= 2 /\ (settled11.tradeCaptureReportV2Bitfield2 # << >> /\ (settled11.tradeCaptureReportV2Bitfield2[1] \div 4) % 2 > 0) THEN (IF settled11.transactionCategory = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled11.transactionCategory) ELSE << >>]
        settled13 == [settled12 EXCEPT !.tradeTime = IF settled12.numberOfTradeCaptureReportV2Bitfields >= 2 /\ (settled12.tradeCaptureReportV2Bitfield2 # << >> /\ (settled12.tradeCaptureReportV2Bitfield2[1] \div 8) % 2 > 0) THEN (IF settled12.tradeTime = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled12.tradeTime) ELSE << >>]
        settled14 == [settled13 EXCEPT !.partyRole = IF settled13.numberOfTradeCaptureReportV2Bitfields >= 2 /\ (settled13.tradeCaptureReportV2Bitfield2 # << >> /\ (settled13.tradeCaptureReportV2Bitfield2[1] \div 16) % 2 > 0) THEN (IF settled13.partyRole = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled13.partyRole) ELSE << >>]
        settled15 == [settled14 EXCEPT !.tradeReportTransType = IF settled14.numberOfTradeCaptureReportV2Bitfields >= 2 /\ (settled14.tradeCaptureReportV2Bitfield2 # << >> /\ (settled14.tradeCaptureReportV2Bitfield2[1] \div 32) % 2 > 0) THEN (IF settled14.tradeReportTransType = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled14.tradeReportTransType) ELSE << >>]
        settled16 == [settled15 EXCEPT !.tradeId = IF settled15.numberOfTradeCaptureReportV2Bitfields >= 2 /\ (settled15.tradeCaptureReportV2Bitfield2 # << >> /\ (settled15.tradeCaptureReportV2Bitfield2[1] \div 64) % 2 > 0) THEN (IF settled15.tradeId = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled15.tradeId) ELSE << >>]
        settled17 == [settled16 EXCEPT !.venueType = IF settled16.numberOfTradeCaptureReportV2Bitfields >= 2 /\ (settled16.tradeCaptureReportV2Bitfield2 # << >> /\ (settled16.tradeCaptureReportV2Bitfield2[1] \div 128) % 2 > 0) THEN (IF settled16.venueType = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled16.venueType) ELSE << >>]
        settled18 == [settled17 EXCEPT !.matchType = IF settled17.numberOfTradeCaptureReportV2Bitfields >= 3 /\ (settled17.tradeCaptureReportV2Bitfield3 # << >> /\ (settled17.tradeCaptureReportV2Bitfield3[1] \div 2) % 2 > 0) THEN (IF settled17.matchType = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled17.matchType) ELSE << >>]
        settled19 == [settled18 EXCEPT !.trdSubType = IF settled18.numberOfTradeCaptureReportV2Bitfields >= 3 /\ (settled18.tradeCaptureReportV2Bitfield3 # << >> /\ (settled18.tradeCaptureReportV2Bitfield3[1] \div 4) % 2 > 0) THEN (IF settled18.trdSubType = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled18.trdSubType) ELSE << >>]
        settled20 == [settled19 EXCEPT !.tradePublishIndicator = IF settled19.numberOfTradeCaptureReportV2Bitfields >= 3 /\ (settled19.tradeCaptureReportV2Bitfield3 # << >> /\ (settled19.tradeCaptureReportV2Bitfield3[1] \div 32) % 2 > 0) THEN (IF settled19.tradePublishIndicator = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled19.tradePublishIndicator) ELSE << >>]
        settled21 == [settled20 EXCEPT !.tradeReportType = IF settled20.numberOfTradeCaptureReportV2Bitfields >= 4 /\ (settled20.tradeCaptureReportV2Bitfield4 # << >> /\ settled20.tradeCaptureReportV2Bitfield4[1] % 2 > 0) THEN (IF settled20.tradeReportType = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled20.tradeReportType) ELSE << >>]
        settled22 == [settled21 EXCEPT !.tradeHandlingInstruction = IF settled21.numberOfTradeCaptureReportV2Bitfields >= 4 /\ (settled21.tradeCaptureReportV2Bitfield4 # << >> /\ (settled21.tradeCaptureReportV2Bitfield4[1] \div 2) % 2 > 0) THEN (IF settled21.tradeHandlingInstruction = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled21.tradeHandlingInstruction) ELSE << >>]
        settled23 == [settled22 EXCEPT !.tradeLinkId = IF settled22.numberOfTradeCaptureReportV2Bitfields >= 4 /\ (settled22.tradeCaptureReportV2Bitfield4 # << >> /\ (settled22.tradeCaptureReportV2Bitfield4[1] \div 4) % 2 > 0) THEN (IF settled22.tradeLinkId = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled22.tradeLinkId) ELSE << >>]
        settled24 == [settled23 EXCEPT !.grossTradeAmt = IF settled23.numberOfTradeCaptureReportV2Bitfields >= 4 /\ (settled23.tradeCaptureReportV2Bitfield4 # << >> /\ (settled23.tradeCaptureReportV2Bitfield4[1] \div 16) % 2 > 0) THEN (IF settled23.grossTradeAmt = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled23.grossTradeAmt) ELSE << >>]
        settled25 == [settled24 EXCEPT !.tolerance = IF settled24.numberOfTradeCaptureReportV2Bitfields >= 4 /\ (settled24.tradeCaptureReportV2Bitfield4 # << >> /\ (settled24.tradeCaptureReportV2Bitfield4[1] \div 32) % 2 > 0) THEN (IF settled24.tolerance = << >> THEN <<[i \in 1 .. 2 |-> 0]>> ELSE settled24.tolerance) ELSE << >>]
        settled26 == [settled25 EXCEPT !.orderCategory = IF settled25.numberOfTradeCaptureReportV2Bitfields >= 4 /\ (settled25.tradeCaptureReportV2Bitfield4 # << >> /\ (settled25.tradeCaptureReportV2Bitfield4[1] \div 64) % 2 > 0) THEN (IF settled25.orderCategory = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled25.orderCategory) ELSE << >>]
        settled27 == [settled26 EXCEPT !.priceFormation = IF settled26.numberOfTradeCaptureReportV2Bitfields >= 5 /\ (settled26.tradeCaptureReportV2Bitfield5 # << >> /\ (settled26.tradeCaptureReportV2Bitfield5[1] \div 2) % 2 > 0) THEN (IF settled26.priceFormation = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled26.priceFormation) ELSE << >>]
        settled28 == [settled27 EXCEPT !.algorithmicIndicator = IF settled27.numberOfTradeCaptureReportV2Bitfields >= 5 /\ (settled27.tradeCaptureReportV2Bitfield5 # << >> /\ (settled27.tradeCaptureReportV2Bitfield5[1] \div 4) % 2 > 0) THEN (IF settled27.algorithmicIndicator = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled27.algorithmicIndicator) ELSE << >>]
        settled29 == [settled28 EXCEPT !.custOrderHandlingInst = IF settled28.numberOfTradeCaptureReportV2Bitfields >= 6 /\ (settled28.tradeCaptureReportV2Bitfield6 # << >> /\ settled28.tradeCaptureReportV2Bitfield6[1] % 2 > 0) THEN (IF settled28.custOrderHandlingInst = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled28.custOrderHandlingInst) ELSE << >>]
        settled30 == [settled29 EXCEPT !.openClose = IF settled29.numberOfTradeCaptureReportV2Bitfields >= 6 /\ (settled29.tradeCaptureReportV2Bitfield6 # << >> /\ (settled29.tradeCaptureReportV2Bitfield6[1] \div 2) % 2 > 0) THEN (IF settled29.openClose = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled29.openClose) ELSE << >>]
        settled31 == [settled30 EXCEPT !.accountType = IF settled30.numberOfTradeCaptureReportV2Bitfields >= 6 /\ (settled30.tradeCaptureReportV2Bitfield6 # << >> /\ (settled30.tradeCaptureReportV2Bitfield6[1] \div 4) % 2 > 0) THEN (IF settled30.accountType = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled30.accountType) ELSE << >>]
    IN  settled31

ZeroTradeCaptureReportV2Message ==
    SettleTradeCaptureReportV2Message([ tradeReportId                         |-> [i \in 1 .. 20 |-> 0],
                                        lastShares                            |-> [i \in 1 .. 4 |-> 0],
                                        tradeCaptureLastPx                    |-> [i \in 1 .. 8 |-> 0],
                                        numberOfTradeCaptureReportV2Bitfields |-> 0,
                                        tradeCaptureReportV2Bitfield1         |-> << >>,
                                        tradeCaptureReportV2Bitfield2         |-> << >>,
                                        tradeCaptureReportV2Bitfield3         |-> << >>,
                                        tradeCaptureReportV2Bitfield4         |-> << >>,
                                        tradeCaptureReportV2Bitfield5         |-> << >>,
                                        tradeCaptureReportV2Bitfield6         |-> << >>,
                                        noSides                               |-> [i \in 1 .. 1 |-> 0],
                                        symbolLong                            |-> << >>,
                                        idSource                              |-> << >>,
                                        securityId                            |-> << >>,
                                        capacity                              |-> << >>,
                                        account                               |-> << >>,
                                        transactionCategory                   |-> << >>,
                                        tradeTime                             |-> << >>,
                                        partyRole                             |-> << >>,
                                        tradeReportTransType                  |-> << >>,
                                        tradeId                               |-> << >>,
                                        venueType                             |-> << >>,
                                        matchType                             |-> << >>,
                                        trdSubType                            |-> << >>,
                                        tradePublishIndicator                 |-> << >>,
                                        tradeReportType                       |-> << >>,
                                        tradeHandlingInstruction              |-> << >>,
                                        tradeLinkId                           |-> << >>,
                                        grossTradeAmt                         |-> << >>,
                                        tolerance                             |-> << >>,
                                        orderCategory                         |-> << >>,
                                        priceFormation                        |-> << >>,
                                        algorithmicIndicator                  |-> << >>,
                                        custOrderHandlingInst                 |-> << >>,
                                        openClose                             |-> << >>,
                                        accountType                           |-> << >> ])

(* Trade Capture Report V 2 Message at zero, then each field in turn at the values it is checked at *)
CheckedTradeCaptureReportV2Message ==
    { ZeroTradeCaptureReportV2Message }
        \cup { SettleTradeCaptureReportV2Message([ZeroTradeCaptureReportV2Message EXCEPT !.tradeReportId = one]) : one \in Sample(20) }
        \cup { SettleTradeCaptureReportV2Message([ZeroTradeCaptureReportV2Message EXCEPT !.lastShares = one]) : one \in Sample(4) }
        \cup { SettleTradeCaptureReportV2Message([ZeroTradeCaptureReportV2Message EXCEPT !.tradeCaptureLastPx = one]) : one \in Sample(8) }
        \cup { SettleTradeCaptureReportV2Message([ZeroTradeCaptureReportV2Message EXCEPT !.numberOfTradeCaptureReportV2Bitfields = one]) : one \in {0, 1, 255} }
        \cup { SettleTradeCaptureReportV2Message([ZeroTradeCaptureReportV2Message EXCEPT !.numberOfTradeCaptureReportV2Bitfields = 1, !.tradeCaptureReportV2Bitfield1 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleTradeCaptureReportV2Message([ZeroTradeCaptureReportV2Message EXCEPT !.numberOfTradeCaptureReportV2Bitfields = 2, !.tradeCaptureReportV2Bitfield2 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleTradeCaptureReportV2Message([ZeroTradeCaptureReportV2Message EXCEPT !.numberOfTradeCaptureReportV2Bitfields = 3, !.tradeCaptureReportV2Bitfield3 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleTradeCaptureReportV2Message([ZeroTradeCaptureReportV2Message EXCEPT !.numberOfTradeCaptureReportV2Bitfields = 4, !.tradeCaptureReportV2Bitfield4 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleTradeCaptureReportV2Message([ZeroTradeCaptureReportV2Message EXCEPT !.numberOfTradeCaptureReportV2Bitfields = 5, !.tradeCaptureReportV2Bitfield5 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleTradeCaptureReportV2Message([ZeroTradeCaptureReportV2Message EXCEPT !.numberOfTradeCaptureReportV2Bitfields = 6, !.tradeCaptureReportV2Bitfield6 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleTradeCaptureReportV2Message([ZeroTradeCaptureReportV2Message EXCEPT !.noSides = one]) : one \in Sample(1) }
        \cup { SettleTradeCaptureReportV2Message([ZeroTradeCaptureReportV2Message EXCEPT !.numberOfTradeCaptureReportV2Bitfields = 1, !.tradeCaptureReportV2Bitfield1 = <<1>>, !.symbolLong = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleTradeCaptureReportV2Message([ZeroTradeCaptureReportV2Message EXCEPT !.numberOfTradeCaptureReportV2Bitfields = 1, !.tradeCaptureReportV2Bitfield1 = <<8>>, !.idSource = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCaptureReportV2Message([ZeroTradeCaptureReportV2Message EXCEPT !.numberOfTradeCaptureReportV2Bitfields = 1, !.tradeCaptureReportV2Bitfield1 = <<16>>, !.securityId = one]) : one \in { <<held>> : held \in Sample(16) } }
        \cup { SettleTradeCaptureReportV2Message([ZeroTradeCaptureReportV2Message EXCEPT !.numberOfTradeCaptureReportV2Bitfields = 2, !.tradeCaptureReportV2Bitfield2 = <<1>>, !.capacity = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCaptureReportV2Message([ZeroTradeCaptureReportV2Message EXCEPT !.numberOfTradeCaptureReportV2Bitfields = 2, !.tradeCaptureReportV2Bitfield2 = <<2>>, !.account = one]) : one \in { <<held>> : held \in Sample(16) } }
        \cup { SettleTradeCaptureReportV2Message([ZeroTradeCaptureReportV2Message EXCEPT !.numberOfTradeCaptureReportV2Bitfields = 2, !.tradeCaptureReportV2Bitfield2 = <<4>>, !.transactionCategory = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCaptureReportV2Message([ZeroTradeCaptureReportV2Message EXCEPT !.numberOfTradeCaptureReportV2Bitfields = 2, !.tradeCaptureReportV2Bitfield2 = <<8>>, !.tradeTime = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleTradeCaptureReportV2Message([ZeroTradeCaptureReportV2Message EXCEPT !.numberOfTradeCaptureReportV2Bitfields = 2, !.tradeCaptureReportV2Bitfield2 = <<16>>, !.partyRole = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCaptureReportV2Message([ZeroTradeCaptureReportV2Message EXCEPT !.numberOfTradeCaptureReportV2Bitfields = 2, !.tradeCaptureReportV2Bitfield2 = <<32>>, !.tradeReportTransType = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCaptureReportV2Message([ZeroTradeCaptureReportV2Message EXCEPT !.numberOfTradeCaptureReportV2Bitfields = 2, !.tradeCaptureReportV2Bitfield2 = <<64>>, !.tradeId = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleTradeCaptureReportV2Message([ZeroTradeCaptureReportV2Message EXCEPT !.numberOfTradeCaptureReportV2Bitfields = 2, !.tradeCaptureReportV2Bitfield2 = <<128>>, !.venueType = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCaptureReportV2Message([ZeroTradeCaptureReportV2Message EXCEPT !.numberOfTradeCaptureReportV2Bitfields = 3, !.tradeCaptureReportV2Bitfield3 = <<2>>, !.matchType = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCaptureReportV2Message([ZeroTradeCaptureReportV2Message EXCEPT !.numberOfTradeCaptureReportV2Bitfields = 3, !.tradeCaptureReportV2Bitfield3 = <<4>>, !.trdSubType = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCaptureReportV2Message([ZeroTradeCaptureReportV2Message EXCEPT !.numberOfTradeCaptureReportV2Bitfields = 3, !.tradeCaptureReportV2Bitfield3 = <<32>>, !.tradePublishIndicator = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCaptureReportV2Message([ZeroTradeCaptureReportV2Message EXCEPT !.numberOfTradeCaptureReportV2Bitfields = 4, !.tradeCaptureReportV2Bitfield4 = <<1>>, !.tradeReportType = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCaptureReportV2Message([ZeroTradeCaptureReportV2Message EXCEPT !.numberOfTradeCaptureReportV2Bitfields = 4, !.tradeCaptureReportV2Bitfield4 = <<2>>, !.tradeHandlingInstruction = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCaptureReportV2Message([ZeroTradeCaptureReportV2Message EXCEPT !.numberOfTradeCaptureReportV2Bitfields = 4, !.tradeCaptureReportV2Bitfield4 = <<4>>, !.tradeLinkId = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCaptureReportV2Message([ZeroTradeCaptureReportV2Message EXCEPT !.numberOfTradeCaptureReportV2Bitfields = 4, !.tradeCaptureReportV2Bitfield4 = <<16>>, !.grossTradeAmt = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleTradeCaptureReportV2Message([ZeroTradeCaptureReportV2Message EXCEPT !.numberOfTradeCaptureReportV2Bitfields = 4, !.tradeCaptureReportV2Bitfield4 = <<32>>, !.tolerance = one]) : one \in { <<held>> : held \in Sample(2) } }
        \cup { SettleTradeCaptureReportV2Message([ZeroTradeCaptureReportV2Message EXCEPT !.numberOfTradeCaptureReportV2Bitfields = 4, !.tradeCaptureReportV2Bitfield4 = <<64>>, !.orderCategory = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCaptureReportV2Message([ZeroTradeCaptureReportV2Message EXCEPT !.numberOfTradeCaptureReportV2Bitfields = 5, !.tradeCaptureReportV2Bitfield5 = <<2>>, !.priceFormation = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCaptureReportV2Message([ZeroTradeCaptureReportV2Message EXCEPT !.numberOfTradeCaptureReportV2Bitfields = 5, !.tradeCaptureReportV2Bitfield5 = <<4>>, !.algorithmicIndicator = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCaptureReportV2Message([ZeroTradeCaptureReportV2Message EXCEPT !.numberOfTradeCaptureReportV2Bitfields = 6, !.tradeCaptureReportV2Bitfield6 = <<1>>, !.custOrderHandlingInst = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCaptureReportV2Message([ZeroTradeCaptureReportV2Message EXCEPT !.numberOfTradeCaptureReportV2Bitfields = 6, !.tradeCaptureReportV2Bitfield6 = <<2>>, !.openClose = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCaptureReportV2Message([ZeroTradeCaptureReportV2Message EXCEPT !.numberOfTradeCaptureReportV2Bitfields = 6, !.tradeCaptureReportV2Bitfield6 = <<4>>, !.accountType = one]) : one \in { <<held>> : held \in Sample(1) } }

(***************************************************************************)
(* Order Acknowledgment V 2 Message                                        *)
(***************************************************************************)

OrderAcknowledgmentV2Message ==
    [ transactionTime                       : Sample(8),
      clOrdId                               : Sample(20),
      orderId                               : Sample(8),
      reserved1                             : Sample(1),
      numberOfReturnBitfields               : 0 .. 255,
      orderAcknowledgmentV2ReturnBitfield1  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderAcknowledgmentV2ReturnBitfield2  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderAcknowledgmentV2ReturnBitfield3  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderAcknowledgmentV2ReturnBitfield4  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderAcknowledgmentV2ReturnBitfield5  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderAcknowledgmentV2ReturnBitfield6  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderAcknowledgmentV2ReturnBitfield7  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderAcknowledgmentV2ReturnBitfield8  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderAcknowledgmentV2ReturnBitfield9  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderAcknowledgmentV2ReturnBitfield10 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderAcknowledgmentV2ReturnBitfield11 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderAcknowledgmentV2ReturnBitfield12 : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderAcknowledgmentV2ReturnBitfield13 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderAcknowledgmentV2ReturnBitfield14 : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderAcknowledgmentV2ReturnBitfield15 : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderAcknowledgmentV2ReturnBitfield16 : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderAcknowledgmentV2ReturnBitfield17 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderAcknowledgmentV2ReturnBitfield18 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderAcknowledgmentV2ReturnBitfield19 : { << >> } \cup { <<held>> : held \in Sample(1) },
      side                                  : { << >> } \cup { <<held>> : held \in Sample(1) },
      price                                 : { << >> } \cup { <<held>> : held \in Sample(8) },
      ordType                               : { << >> } \cup { <<held>> : held \in Sample(1) },
      timeInForce                           : { << >> } \cup { <<held>> : held \in Sample(1) },
      minQty                                : { << >> } \cup { <<held>> : held \in Sample(4) },
      symbolLong                            : { << >> } \cup { <<held>> : held \in Sample(8) },
      idSource                              : { << >> } \cup { <<held>> : held \in Sample(1) },
      securityId                            : { << >> } \cup { <<held>> : held \in Sample(16) },
      capacity                              : { << >> } \cup { <<held>> : held \in Sample(1) },
      account                               : { << >> } \cup { <<held>> : held \in Sample(16) },
      clearingFirm                          : { << >> } \cup { <<held>> : held \in Sample(4) },
      clearingAccount                       : { << >> } \cup { <<held>> : held \in Sample(4) },
      displayIndicator                      : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderQty                              : { << >> } \cup { <<held>> : held \in Sample(4) },
      preventMatch                          : { << >> } \cup { <<held>> : held \in Sample(3) },
      openClose                             : { << >> } \cup { <<held>> : held \in Sample(1) },
      origClOrdId                           : { << >> } \cup { <<held>> : held \in Sample(20) },
      leavesQty                             : { << >> } \cup { <<held>> : held \in Sample(4) },
      lastShares                            : { << >> } \cup { <<held>> : held \in Sample(4) },
      lastPx                                : { << >> } \cup { <<held>> : held \in Sample(8) },
      displayPrice                          : { << >> } \cup { <<held>> : held \in Sample(8) },
      workingPrice                          : { << >> } \cup { <<held>> : held \in Sample(8) },
      baseLiquidityIndicator                : { << >> } \cup { <<held>> : held \in Sample(1) },
      expireTime                            : { << >> } \cup { <<held>> : held \in Sample(8) },
      secondaryOrderId                      : { << >> } \cup { <<held>> : held \in Sample(8) },
      extExecInst                           : { << >> } \cup { <<held>> : held \in Sample(1) },
      subLiquidityIndicator                 : { << >> } \cup { <<held>> : held \in Sample(1) },
      stopPx                                : { << >> } \cup { <<held>> : held \in Sample(8) },
      routingInst                           : { << >> } \cup { <<held>> : held \in Sample(4) },
      auctionId                             : { << >> } \cup { <<held>> : held \in Sample(8) },
      liquidityProvision                    : { << >> } \cup { <<held>> : held \in Sample(1) },
      clientQualifiedRole                   : { << >> } \cup { <<held>> : held \in Sample(1) },
      clientId                              : { << >> } \cup { <<held>> : held \in Sample(4) },
      investorId                            : { << >> } \cup { <<held>> : held \in Sample(4) },
      executorId                            : { << >> } \cup { <<held>> : held \in Sample(4) },
      orderOrigination                      : { << >> } \cup { <<held>> : held \in Sample(1) },
      algorithmicIndicator                  : { << >> } \cup { <<held>> : held \in Sample(1) },
      investorQualifiedRole                 : { << >> } \cup { <<held>> : held \in Sample(1) },
      executorQualifiedRole                 : { << >> } \cup { <<held>> : held \in Sample(1) },
      drillThruProtection                   : { << >> } \cup { <<held>> : held \in Sample(8) },
      custOrderHandlingInst                 : { << >> } \cup { <<held>> : held \in Sample(1) },
      accountType                           : { << >> } \cup { <<held>> : held \in Sample(1) } ]

EncodeOrderAcknowledgmentV2Message(message) ==
    message.transactionTime
        \o message.clOrdId
        \o message.orderId
        \o message.reserved1
        \o EncodeUIntBE(message.numberOfReturnBitfields, 1)
        \o (IF message.orderAcknowledgmentV2ReturnBitfield1 = << >> THEN << >> ELSE EncodeUIntLE(message.orderAcknowledgmentV2ReturnBitfield1[1], 1))
        \o (IF message.orderAcknowledgmentV2ReturnBitfield2 = << >> THEN << >> ELSE EncodeUIntLE(message.orderAcknowledgmentV2ReturnBitfield2[1], 1))
        \o (IF message.orderAcknowledgmentV2ReturnBitfield3 = << >> THEN << >> ELSE EncodeUIntLE(message.orderAcknowledgmentV2ReturnBitfield3[1], 1))
        \o (IF message.orderAcknowledgmentV2ReturnBitfield4 = << >> THEN << >> ELSE EncodeUIntLE(message.orderAcknowledgmentV2ReturnBitfield4[1], 1))
        \o (IF message.orderAcknowledgmentV2ReturnBitfield5 = << >> THEN << >> ELSE EncodeUIntLE(message.orderAcknowledgmentV2ReturnBitfield5[1], 1))
        \o (IF message.orderAcknowledgmentV2ReturnBitfield6 = << >> THEN << >> ELSE EncodeUIntLE(message.orderAcknowledgmentV2ReturnBitfield6[1], 1))
        \o (IF message.orderAcknowledgmentV2ReturnBitfield7 = << >> THEN << >> ELSE EncodeUIntLE(message.orderAcknowledgmentV2ReturnBitfield7[1], 1))
        \o (IF message.orderAcknowledgmentV2ReturnBitfield8 = << >> THEN << >> ELSE EncodeUIntLE(message.orderAcknowledgmentV2ReturnBitfield8[1], 1))
        \o (IF message.orderAcknowledgmentV2ReturnBitfield9 = << >> THEN << >> ELSE EncodeUIntLE(message.orderAcknowledgmentV2ReturnBitfield9[1], 1))
        \o (IF message.orderAcknowledgmentV2ReturnBitfield10 = << >> THEN << >> ELSE EncodeUIntLE(message.orderAcknowledgmentV2ReturnBitfield10[1], 1))
        \o (IF message.orderAcknowledgmentV2ReturnBitfield11 = << >> THEN << >> ELSE EncodeUIntLE(message.orderAcknowledgmentV2ReturnBitfield11[1], 1))
        \o (IF message.orderAcknowledgmentV2ReturnBitfield12 = << >> THEN << >> ELSE message.orderAcknowledgmentV2ReturnBitfield12[1])
        \o (IF message.orderAcknowledgmentV2ReturnBitfield13 = << >> THEN << >> ELSE EncodeUIntLE(message.orderAcknowledgmentV2ReturnBitfield13[1], 1))
        \o (IF message.orderAcknowledgmentV2ReturnBitfield14 = << >> THEN << >> ELSE message.orderAcknowledgmentV2ReturnBitfield14[1])
        \o (IF message.orderAcknowledgmentV2ReturnBitfield15 = << >> THEN << >> ELSE message.orderAcknowledgmentV2ReturnBitfield15[1])
        \o (IF message.orderAcknowledgmentV2ReturnBitfield16 = << >> THEN << >> ELSE message.orderAcknowledgmentV2ReturnBitfield16[1])
        \o (IF message.orderAcknowledgmentV2ReturnBitfield17 = << >> THEN << >> ELSE EncodeUIntLE(message.orderAcknowledgmentV2ReturnBitfield17[1], 1))
        \o (IF message.orderAcknowledgmentV2ReturnBitfield18 = << >> THEN << >> ELSE EncodeUIntLE(message.orderAcknowledgmentV2ReturnBitfield18[1], 1))
        \o (IF message.orderAcknowledgmentV2ReturnBitfield19 = << >> THEN << >> ELSE message.orderAcknowledgmentV2ReturnBitfield19[1])
        \o (IF message.side = << >> THEN << >> ELSE message.side[1])
        \o (IF message.price = << >> THEN << >> ELSE message.price[1])
        \o (IF message.ordType = << >> THEN << >> ELSE message.ordType[1])
        \o (IF message.timeInForce = << >> THEN << >> ELSE message.timeInForce[1])
        \o (IF message.minQty = << >> THEN << >> ELSE message.minQty[1])
        \o (IF message.symbolLong = << >> THEN << >> ELSE message.symbolLong[1])
        \o (IF message.idSource = << >> THEN << >> ELSE message.idSource[1])
        \o (IF message.securityId = << >> THEN << >> ELSE message.securityId[1])
        \o (IF message.capacity = << >> THEN << >> ELSE message.capacity[1])
        \o (IF message.account = << >> THEN << >> ELSE message.account[1])
        \o (IF message.clearingFirm = << >> THEN << >> ELSE message.clearingFirm[1])
        \o (IF message.clearingAccount = << >> THEN << >> ELSE message.clearingAccount[1])
        \o (IF message.displayIndicator = << >> THEN << >> ELSE message.displayIndicator[1])
        \o (IF message.orderQty = << >> THEN << >> ELSE message.orderQty[1])
        \o (IF message.preventMatch = << >> THEN << >> ELSE message.preventMatch[1])
        \o (IF message.openClose = << >> THEN << >> ELSE message.openClose[1])
        \o (IF message.origClOrdId = << >> THEN << >> ELSE message.origClOrdId[1])
        \o (IF message.leavesQty = << >> THEN << >> ELSE message.leavesQty[1])
        \o (IF message.lastShares = << >> THEN << >> ELSE message.lastShares[1])
        \o (IF message.lastPx = << >> THEN << >> ELSE message.lastPx[1])
        \o (IF message.displayPrice = << >> THEN << >> ELSE message.displayPrice[1])
        \o (IF message.workingPrice = << >> THEN << >> ELSE message.workingPrice[1])
        \o (IF message.baseLiquidityIndicator = << >> THEN << >> ELSE message.baseLiquidityIndicator[1])
        \o (IF message.expireTime = << >> THEN << >> ELSE message.expireTime[1])
        \o (IF message.secondaryOrderId = << >> THEN << >> ELSE message.secondaryOrderId[1])
        \o (IF message.extExecInst = << >> THEN << >> ELSE message.extExecInst[1])
        \o (IF message.subLiquidityIndicator = << >> THEN << >> ELSE message.subLiquidityIndicator[1])
        \o (IF message.stopPx = << >> THEN << >> ELSE message.stopPx[1])
        \o (IF message.routingInst = << >> THEN << >> ELSE message.routingInst[1])
        \o (IF message.auctionId = << >> THEN << >> ELSE message.auctionId[1])
        \o (IF message.liquidityProvision = << >> THEN << >> ELSE message.liquidityProvision[1])
        \o (IF message.clientQualifiedRole = << >> THEN << >> ELSE message.clientQualifiedRole[1])
        \o (IF message.clientId = << >> THEN << >> ELSE message.clientId[1])
        \o (IF message.investorId = << >> THEN << >> ELSE message.investorId[1])
        \o (IF message.executorId = << >> THEN << >> ELSE message.executorId[1])
        \o (IF message.orderOrigination = << >> THEN << >> ELSE message.orderOrigination[1])
        \o (IF message.algorithmicIndicator = << >> THEN << >> ELSE message.algorithmicIndicator[1])
        \o (IF message.investorQualifiedRole = << >> THEN << >> ELSE message.investorQualifiedRole[1])
        \o (IF message.executorQualifiedRole = << >> THEN << >> ELSE message.executorQualifiedRole[1])
        \o (IF message.drillThruProtection = << >> THEN << >> ELSE message.drillThruProtection[1])
        \o (IF message.custOrderHandlingInst = << >> THEN << >> ELSE message.custOrderHandlingInst[1])
        \o (IF message.accountType = << >> THEN << >> ELSE message.accountType[1])

DecodeOrderAcknowledgmentV2Message(bytes) ==
    LET transactionTime == ReadBytes(bytes, 8) IN IF ~transactionTime.ok THEN Fail ELSE
    LET clOrdId == ReadBytes(transactionTime.rest, 20) IN IF ~clOrdId.ok THEN Fail ELSE
    LET orderId == ReadBytes(clOrdId.rest, 8) IN IF ~orderId.ok THEN Fail ELSE
    LET reserved1 == ReadBytes(orderId.rest, 1) IN IF ~reserved1.ok THEN Fail ELSE
    LET numberOfReturnBitfields == ReadUIntBE(reserved1.rest, 1) IN IF ~numberOfReturnBitfields.ok THEN Fail ELSE
    LET orderAcknowledgmentV2ReturnBitfield1 == ReadWhen(numberOfReturnBitfields.value >= 1, ReadUIntLE(numberOfReturnBitfields.rest, 1), numberOfReturnBitfields.rest) IN IF ~orderAcknowledgmentV2ReturnBitfield1.ok THEN Fail ELSE
    LET orderAcknowledgmentV2ReturnBitfield2 == ReadWhen(numberOfReturnBitfields.value >= 2, ReadUIntLE(orderAcknowledgmentV2ReturnBitfield1.rest, 1), orderAcknowledgmentV2ReturnBitfield1.rest) IN IF ~orderAcknowledgmentV2ReturnBitfield2.ok THEN Fail ELSE
    LET orderAcknowledgmentV2ReturnBitfield3 == ReadWhen(numberOfReturnBitfields.value >= 3, ReadUIntLE(orderAcknowledgmentV2ReturnBitfield2.rest, 1), orderAcknowledgmentV2ReturnBitfield2.rest) IN IF ~orderAcknowledgmentV2ReturnBitfield3.ok THEN Fail ELSE
    LET orderAcknowledgmentV2ReturnBitfield4 == ReadWhen(numberOfReturnBitfields.value >= 4, ReadUIntLE(orderAcknowledgmentV2ReturnBitfield3.rest, 1), orderAcknowledgmentV2ReturnBitfield3.rest) IN IF ~orderAcknowledgmentV2ReturnBitfield4.ok THEN Fail ELSE
    LET orderAcknowledgmentV2ReturnBitfield5 == ReadWhen(numberOfReturnBitfields.value >= 5, ReadUIntLE(orderAcknowledgmentV2ReturnBitfield4.rest, 1), orderAcknowledgmentV2ReturnBitfield4.rest) IN IF ~orderAcknowledgmentV2ReturnBitfield5.ok THEN Fail ELSE
    LET orderAcknowledgmentV2ReturnBitfield6 == ReadWhen(numberOfReturnBitfields.value >= 6, ReadUIntLE(orderAcknowledgmentV2ReturnBitfield5.rest, 1), orderAcknowledgmentV2ReturnBitfield5.rest) IN IF ~orderAcknowledgmentV2ReturnBitfield6.ok THEN Fail ELSE
    LET orderAcknowledgmentV2ReturnBitfield7 == ReadWhen(numberOfReturnBitfields.value >= 7, ReadUIntLE(orderAcknowledgmentV2ReturnBitfield6.rest, 1), orderAcknowledgmentV2ReturnBitfield6.rest) IN IF ~orderAcknowledgmentV2ReturnBitfield7.ok THEN Fail ELSE
    LET orderAcknowledgmentV2ReturnBitfield8 == ReadWhen(numberOfReturnBitfields.value >= 8, ReadUIntLE(orderAcknowledgmentV2ReturnBitfield7.rest, 1), orderAcknowledgmentV2ReturnBitfield7.rest) IN IF ~orderAcknowledgmentV2ReturnBitfield8.ok THEN Fail ELSE
    LET orderAcknowledgmentV2ReturnBitfield9 == ReadWhen(numberOfReturnBitfields.value >= 9, ReadUIntLE(orderAcknowledgmentV2ReturnBitfield8.rest, 1), orderAcknowledgmentV2ReturnBitfield8.rest) IN IF ~orderAcknowledgmentV2ReturnBitfield9.ok THEN Fail ELSE
    LET orderAcknowledgmentV2ReturnBitfield10 == ReadWhen(numberOfReturnBitfields.value >= 10, ReadUIntLE(orderAcknowledgmentV2ReturnBitfield9.rest, 1), orderAcknowledgmentV2ReturnBitfield9.rest) IN IF ~orderAcknowledgmentV2ReturnBitfield10.ok THEN Fail ELSE
    LET orderAcknowledgmentV2ReturnBitfield11 == ReadWhen(numberOfReturnBitfields.value >= 11, ReadUIntLE(orderAcknowledgmentV2ReturnBitfield10.rest, 1), orderAcknowledgmentV2ReturnBitfield10.rest) IN IF ~orderAcknowledgmentV2ReturnBitfield11.ok THEN Fail ELSE
    LET orderAcknowledgmentV2ReturnBitfield12 == ReadWhen(numberOfReturnBitfields.value >= 12, ReadBytes(orderAcknowledgmentV2ReturnBitfield11.rest, 1), orderAcknowledgmentV2ReturnBitfield11.rest) IN IF ~orderAcknowledgmentV2ReturnBitfield12.ok THEN Fail ELSE
    LET orderAcknowledgmentV2ReturnBitfield13 == ReadWhen(numberOfReturnBitfields.value >= 13, ReadUIntLE(orderAcknowledgmentV2ReturnBitfield12.rest, 1), orderAcknowledgmentV2ReturnBitfield12.rest) IN IF ~orderAcknowledgmentV2ReturnBitfield13.ok THEN Fail ELSE
    LET orderAcknowledgmentV2ReturnBitfield14 == ReadWhen(numberOfReturnBitfields.value >= 14, ReadBytes(orderAcknowledgmentV2ReturnBitfield13.rest, 1), orderAcknowledgmentV2ReturnBitfield13.rest) IN IF ~orderAcknowledgmentV2ReturnBitfield14.ok THEN Fail ELSE
    LET orderAcknowledgmentV2ReturnBitfield15 == ReadWhen(numberOfReturnBitfields.value >= 15, ReadBytes(orderAcknowledgmentV2ReturnBitfield14.rest, 1), orderAcknowledgmentV2ReturnBitfield14.rest) IN IF ~orderAcknowledgmentV2ReturnBitfield15.ok THEN Fail ELSE
    LET orderAcknowledgmentV2ReturnBitfield16 == ReadWhen(numberOfReturnBitfields.value >= 16, ReadBytes(orderAcknowledgmentV2ReturnBitfield15.rest, 1), orderAcknowledgmentV2ReturnBitfield15.rest) IN IF ~orderAcknowledgmentV2ReturnBitfield16.ok THEN Fail ELSE
    LET orderAcknowledgmentV2ReturnBitfield17 == ReadWhen(numberOfReturnBitfields.value >= 17, ReadUIntLE(orderAcknowledgmentV2ReturnBitfield16.rest, 1), orderAcknowledgmentV2ReturnBitfield16.rest) IN IF ~orderAcknowledgmentV2ReturnBitfield17.ok THEN Fail ELSE
    LET orderAcknowledgmentV2ReturnBitfield18 == ReadWhen(numberOfReturnBitfields.value >= 18, ReadUIntLE(orderAcknowledgmentV2ReturnBitfield17.rest, 1), orderAcknowledgmentV2ReturnBitfield17.rest) IN IF ~orderAcknowledgmentV2ReturnBitfield18.ok THEN Fail ELSE
    LET orderAcknowledgmentV2ReturnBitfield19 == ReadWhen(numberOfReturnBitfields.value >= 19, ReadBytes(orderAcknowledgmentV2ReturnBitfield18.rest, 1), orderAcknowledgmentV2ReturnBitfield18.rest) IN IF ~orderAcknowledgmentV2ReturnBitfield19.ok THEN Fail ELSE
    LET side == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderAcknowledgmentV2ReturnBitfield1.value # << >> /\ orderAcknowledgmentV2ReturnBitfield1.value[1] % 2 > 0), ReadBytes(orderAcknowledgmentV2ReturnBitfield19.rest, 1), orderAcknowledgmentV2ReturnBitfield19.rest) IN IF ~side.ok THEN Fail ELSE
    LET price == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderAcknowledgmentV2ReturnBitfield1.value # << >> /\ (orderAcknowledgmentV2ReturnBitfield1.value[1] \div 4) % 2 > 0), ReadBytes(side.rest, 8), side.rest) IN IF ~price.ok THEN Fail ELSE
    LET ordType == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderAcknowledgmentV2ReturnBitfield1.value # << >> /\ (orderAcknowledgmentV2ReturnBitfield1.value[1] \div 16) % 2 > 0), ReadBytes(price.rest, 1), price.rest) IN IF ~ordType.ok THEN Fail ELSE
    LET timeInForce == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderAcknowledgmentV2ReturnBitfield1.value # << >> /\ (orderAcknowledgmentV2ReturnBitfield1.value[1] \div 32) % 2 > 0), ReadBytes(ordType.rest, 1), ordType.rest) IN IF ~timeInForce.ok THEN Fail ELSE
    LET minQty == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderAcknowledgmentV2ReturnBitfield1.value # << >> /\ (orderAcknowledgmentV2ReturnBitfield1.value[1] \div 64) % 2 > 0), ReadBytes(timeInForce.rest, 4), timeInForce.rest) IN IF ~minQty.ok THEN Fail ELSE
    LET symbolLong == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (orderAcknowledgmentV2ReturnBitfield2.value # << >> /\ orderAcknowledgmentV2ReturnBitfield2.value[1] % 2 > 0), ReadBytes(minQty.rest, 8), minQty.rest) IN IF ~symbolLong.ok THEN Fail ELSE
    LET idSource == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (orderAcknowledgmentV2ReturnBitfield2.value # << >> /\ (orderAcknowledgmentV2ReturnBitfield2.value[1] \div 8) % 2 > 0), ReadBytes(symbolLong.rest, 1), symbolLong.rest) IN IF ~idSource.ok THEN Fail ELSE
    LET securityId == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (orderAcknowledgmentV2ReturnBitfield2.value # << >> /\ (orderAcknowledgmentV2ReturnBitfield2.value[1] \div 16) % 2 > 0), ReadBytes(idSource.rest, 16), idSource.rest) IN IF ~securityId.ok THEN Fail ELSE
    LET capacity == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (orderAcknowledgmentV2ReturnBitfield2.value # << >> /\ (orderAcknowledgmentV2ReturnBitfield2.value[1] \div 64) % 2 > 0), ReadBytes(securityId.rest, 1), securityId.rest) IN IF ~capacity.ok THEN Fail ELSE
    LET account == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderAcknowledgmentV2ReturnBitfield3.value # << >> /\ orderAcknowledgmentV2ReturnBitfield3.value[1] % 2 > 0), ReadBytes(capacity.rest, 16), capacity.rest) IN IF ~account.ok THEN Fail ELSE
    LET clearingFirm == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderAcknowledgmentV2ReturnBitfield3.value # << >> /\ (orderAcknowledgmentV2ReturnBitfield3.value[1] \div 2) % 2 > 0), ReadBytes(account.rest, 4), account.rest) IN IF ~clearingFirm.ok THEN Fail ELSE
    LET clearingAccount == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderAcknowledgmentV2ReturnBitfield3.value # << >> /\ (orderAcknowledgmentV2ReturnBitfield3.value[1] \div 4) % 2 > 0), ReadBytes(clearingFirm.rest, 4), clearingFirm.rest) IN IF ~clearingAccount.ok THEN Fail ELSE
    LET displayIndicator == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderAcknowledgmentV2ReturnBitfield3.value # << >> /\ (orderAcknowledgmentV2ReturnBitfield3.value[1] \div 8) % 2 > 0), ReadBytes(clearingAccount.rest, 1), clearingAccount.rest) IN IF ~displayIndicator.ok THEN Fail ELSE
    LET orderQty == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderAcknowledgmentV2ReturnBitfield3.value # << >> /\ (orderAcknowledgmentV2ReturnBitfield3.value[1] \div 64) % 2 > 0), ReadBytes(displayIndicator.rest, 4), displayIndicator.rest) IN IF ~orderQty.ok THEN Fail ELSE
    LET preventMatch == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderAcknowledgmentV2ReturnBitfield3.value # << >> /\ (orderAcknowledgmentV2ReturnBitfield3.value[1] \div 128) % 2 > 0), ReadBytes(orderQty.rest, 3), orderQty.rest) IN IF ~preventMatch.ok THEN Fail ELSE
    LET openClose == ReadWhen(numberOfReturnBitfields.value >= 4 /\ (orderAcknowledgmentV2ReturnBitfield4.value # << >> /\ (orderAcknowledgmentV2ReturnBitfield4.value[1] \div 8) % 2 > 0), ReadBytes(preventMatch.rest, 1), preventMatch.rest) IN IF ~openClose.ok THEN Fail ELSE
    LET origClOrdId == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderAcknowledgmentV2ReturnBitfield5.value # << >> /\ orderAcknowledgmentV2ReturnBitfield5.value[1] % 2 > 0), ReadBytes(openClose.rest, 20), openClose.rest) IN IF ~origClOrdId.ok THEN Fail ELSE
    LET leavesQty == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderAcknowledgmentV2ReturnBitfield5.value # << >> /\ (orderAcknowledgmentV2ReturnBitfield5.value[1] \div 2) % 2 > 0), ReadBytes(origClOrdId.rest, 4), origClOrdId.rest) IN IF ~leavesQty.ok THEN Fail ELSE
    LET lastShares == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderAcknowledgmentV2ReturnBitfield5.value # << >> /\ (orderAcknowledgmentV2ReturnBitfield5.value[1] \div 4) % 2 > 0), ReadBytes(leavesQty.rest, 4), leavesQty.rest) IN IF ~lastShares.ok THEN Fail ELSE
    LET lastPx == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderAcknowledgmentV2ReturnBitfield5.value # << >> /\ (orderAcknowledgmentV2ReturnBitfield5.value[1] \div 8) % 2 > 0), ReadBytes(lastShares.rest, 8), lastShares.rest) IN IF ~lastPx.ok THEN Fail ELSE
    LET displayPrice == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderAcknowledgmentV2ReturnBitfield5.value # << >> /\ (orderAcknowledgmentV2ReturnBitfield5.value[1] \div 16) % 2 > 0), ReadBytes(lastPx.rest, 8), lastPx.rest) IN IF ~displayPrice.ok THEN Fail ELSE
    LET workingPrice == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderAcknowledgmentV2ReturnBitfield5.value # << >> /\ (orderAcknowledgmentV2ReturnBitfield5.value[1] \div 32) % 2 > 0), ReadBytes(displayPrice.rest, 8), displayPrice.rest) IN IF ~workingPrice.ok THEN Fail ELSE
    LET baseLiquidityIndicator == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderAcknowledgmentV2ReturnBitfield5.value # << >> /\ (orderAcknowledgmentV2ReturnBitfield5.value[1] \div 64) % 2 > 0), ReadBytes(workingPrice.rest, 1), workingPrice.rest) IN IF ~baseLiquidityIndicator.ok THEN Fail ELSE
    LET expireTime == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderAcknowledgmentV2ReturnBitfield5.value # << >> /\ (orderAcknowledgmentV2ReturnBitfield5.value[1] \div 128) % 2 > 0), ReadBytes(baseLiquidityIndicator.rest, 8), baseLiquidityIndicator.rest) IN IF ~expireTime.ok THEN Fail ELSE
    LET secondaryOrderId == ReadWhen(numberOfReturnBitfields.value >= 6 /\ (orderAcknowledgmentV2ReturnBitfield6.value # << >> /\ orderAcknowledgmentV2ReturnBitfield6.value[1] % 2 > 0), ReadBytes(expireTime.rest, 8), expireTime.rest) IN IF ~secondaryOrderId.ok THEN Fail ELSE
    LET extExecInst == ReadWhen(numberOfReturnBitfields.value >= 6 /\ (orderAcknowledgmentV2ReturnBitfield6.value # << >> /\ (orderAcknowledgmentV2ReturnBitfield6.value[1] \div 16) % 2 > 0), ReadBytes(secondaryOrderId.rest, 1), secondaryOrderId.rest) IN IF ~extExecInst.ok THEN Fail ELSE
    LET subLiquidityIndicator == ReadWhen(numberOfReturnBitfields.value >= 7 /\ (orderAcknowledgmentV2ReturnBitfield7.value # << >> /\ orderAcknowledgmentV2ReturnBitfield7.value[1] % 2 > 0), ReadBytes(extExecInst.rest, 1), extExecInst.rest) IN IF ~subLiquidityIndicator.ok THEN Fail ELSE
    LET stopPx == ReadWhen(numberOfReturnBitfields.value >= 8 /\ (orderAcknowledgmentV2ReturnBitfield8.value # << >> /\ (orderAcknowledgmentV2ReturnBitfield8.value[1] \div 4) % 2 > 0), ReadBytes(subLiquidityIndicator.rest, 8), subLiquidityIndicator.rest) IN IF ~stopPx.ok THEN Fail ELSE
    LET routingInst == ReadWhen(numberOfReturnBitfields.value >= 8 /\ (orderAcknowledgmentV2ReturnBitfield8.value # << >> /\ (orderAcknowledgmentV2ReturnBitfield8.value[1] \div 8) % 2 > 0), ReadBytes(stopPx.rest, 4), stopPx.rest) IN IF ~routingInst.ok THEN Fail ELSE
    LET auctionId == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (orderAcknowledgmentV2ReturnBitfield9.value # << >> /\ (orderAcknowledgmentV2ReturnBitfield9.value[1] \div 4) % 2 > 0), ReadBytes(routingInst.rest, 8), routingInst.rest) IN IF ~auctionId.ok THEN Fail ELSE
    LET liquidityProvision == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (orderAcknowledgmentV2ReturnBitfield9.value # << >> /\ (orderAcknowledgmentV2ReturnBitfield9.value[1] \div 16) % 2 > 0), ReadBytes(auctionId.rest, 1), auctionId.rest) IN IF ~liquidityProvision.ok THEN Fail ELSE
    LET clientQualifiedRole == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (orderAcknowledgmentV2ReturnBitfield10.value # << >> /\ (orderAcknowledgmentV2ReturnBitfield10.value[1] \div 128) % 2 > 0), ReadBytes(liquidityProvision.rest, 1), liquidityProvision.rest) IN IF ~clientQualifiedRole.ok THEN Fail ELSE
    LET clientId == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (orderAcknowledgmentV2ReturnBitfield11.value # << >> /\ orderAcknowledgmentV2ReturnBitfield11.value[1] % 2 > 0), ReadBytes(clientQualifiedRole.rest, 4), clientQualifiedRole.rest) IN IF ~clientId.ok THEN Fail ELSE
    LET investorId == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (orderAcknowledgmentV2ReturnBitfield11.value # << >> /\ (orderAcknowledgmentV2ReturnBitfield11.value[1] \div 2) % 2 > 0), ReadBytes(clientId.rest, 4), clientId.rest) IN IF ~investorId.ok THEN Fail ELSE
    LET executorId == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (orderAcknowledgmentV2ReturnBitfield11.value # << >> /\ (orderAcknowledgmentV2ReturnBitfield11.value[1] \div 4) % 2 > 0), ReadBytes(investorId.rest, 4), investorId.rest) IN IF ~executorId.ok THEN Fail ELSE
    LET orderOrigination == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (orderAcknowledgmentV2ReturnBitfield11.value # << >> /\ (orderAcknowledgmentV2ReturnBitfield11.value[1] \div 8) % 2 > 0), ReadBytes(executorId.rest, 1), executorId.rest) IN IF ~orderOrigination.ok THEN Fail ELSE
    LET algorithmicIndicator == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (orderAcknowledgmentV2ReturnBitfield11.value # << >> /\ (orderAcknowledgmentV2ReturnBitfield11.value[1] \div 16) % 2 > 0), ReadBytes(orderOrigination.rest, 1), orderOrigination.rest) IN IF ~algorithmicIndicator.ok THEN Fail ELSE
    LET investorQualifiedRole == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (orderAcknowledgmentV2ReturnBitfield11.value # << >> /\ (orderAcknowledgmentV2ReturnBitfield11.value[1] \div 64) % 2 > 0), ReadBytes(algorithmicIndicator.rest, 1), algorithmicIndicator.rest) IN IF ~investorQualifiedRole.ok THEN Fail ELSE
    LET executorQualifiedRole == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (orderAcknowledgmentV2ReturnBitfield11.value # << >> /\ (orderAcknowledgmentV2ReturnBitfield11.value[1] \div 128) % 2 > 0), ReadBytes(investorQualifiedRole.rest, 1), investorQualifiedRole.rest) IN IF ~executorQualifiedRole.ok THEN Fail ELSE
    LET drillThruProtection == ReadWhen(numberOfReturnBitfields.value >= 13 /\ (orderAcknowledgmentV2ReturnBitfield13.value # << >> /\ (orderAcknowledgmentV2ReturnBitfield13.value[1] \div 64) % 2 > 0), ReadBytes(executorQualifiedRole.rest, 8), executorQualifiedRole.rest) IN IF ~drillThruProtection.ok THEN Fail ELSE
    LET custOrderHandlingInst == ReadWhen(numberOfReturnBitfields.value >= 17 /\ (orderAcknowledgmentV2ReturnBitfield17.value # << >> /\ (orderAcknowledgmentV2ReturnBitfield17.value[1] \div 128) % 2 > 0), ReadBytes(drillThruProtection.rest, 1), drillThruProtection.rest) IN IF ~custOrderHandlingInst.ok THEN Fail ELSE
    LET accountType == ReadWhen(numberOfReturnBitfields.value >= 18 /\ (orderAcknowledgmentV2ReturnBitfield18.value # << >> /\ orderAcknowledgmentV2ReturnBitfield18.value[1] % 2 > 0), ReadBytes(custOrderHandlingInst.rest, 1), custOrderHandlingInst.rest) IN IF ~accountType.ok THEN Fail ELSE
    Ok([ transactionTime                       |-> transactionTime.value,
         clOrdId                               |-> clOrdId.value,
         orderId                               |-> orderId.value,
         reserved1                             |-> reserved1.value,
         numberOfReturnBitfields               |-> numberOfReturnBitfields.value,
         orderAcknowledgmentV2ReturnBitfield1  |-> orderAcknowledgmentV2ReturnBitfield1.value,
         orderAcknowledgmentV2ReturnBitfield2  |-> orderAcknowledgmentV2ReturnBitfield2.value,
         orderAcknowledgmentV2ReturnBitfield3  |-> orderAcknowledgmentV2ReturnBitfield3.value,
         orderAcknowledgmentV2ReturnBitfield4  |-> orderAcknowledgmentV2ReturnBitfield4.value,
         orderAcknowledgmentV2ReturnBitfield5  |-> orderAcknowledgmentV2ReturnBitfield5.value,
         orderAcknowledgmentV2ReturnBitfield6  |-> orderAcknowledgmentV2ReturnBitfield6.value,
         orderAcknowledgmentV2ReturnBitfield7  |-> orderAcknowledgmentV2ReturnBitfield7.value,
         orderAcknowledgmentV2ReturnBitfield8  |-> orderAcknowledgmentV2ReturnBitfield8.value,
         orderAcknowledgmentV2ReturnBitfield9  |-> orderAcknowledgmentV2ReturnBitfield9.value,
         orderAcknowledgmentV2ReturnBitfield10 |-> orderAcknowledgmentV2ReturnBitfield10.value,
         orderAcknowledgmentV2ReturnBitfield11 |-> orderAcknowledgmentV2ReturnBitfield11.value,
         orderAcknowledgmentV2ReturnBitfield12 |-> orderAcknowledgmentV2ReturnBitfield12.value,
         orderAcknowledgmentV2ReturnBitfield13 |-> orderAcknowledgmentV2ReturnBitfield13.value,
         orderAcknowledgmentV2ReturnBitfield14 |-> orderAcknowledgmentV2ReturnBitfield14.value,
         orderAcknowledgmentV2ReturnBitfield15 |-> orderAcknowledgmentV2ReturnBitfield15.value,
         orderAcknowledgmentV2ReturnBitfield16 |-> orderAcknowledgmentV2ReturnBitfield16.value,
         orderAcknowledgmentV2ReturnBitfield17 |-> orderAcknowledgmentV2ReturnBitfield17.value,
         orderAcknowledgmentV2ReturnBitfield18 |-> orderAcknowledgmentV2ReturnBitfield18.value,
         orderAcknowledgmentV2ReturnBitfield19 |-> orderAcknowledgmentV2ReturnBitfield19.value,
         side                                  |-> side.value,
         price                                 |-> price.value,
         ordType                               |-> ordType.value,
         timeInForce                           |-> timeInForce.value,
         minQty                                |-> minQty.value,
         symbolLong                            |-> symbolLong.value,
         idSource                              |-> idSource.value,
         securityId                            |-> securityId.value,
         capacity                              |-> capacity.value,
         account                               |-> account.value,
         clearingFirm                          |-> clearingFirm.value,
         clearingAccount                       |-> clearingAccount.value,
         displayIndicator                      |-> displayIndicator.value,
         orderQty                              |-> orderQty.value,
         preventMatch                          |-> preventMatch.value,
         openClose                             |-> openClose.value,
         origClOrdId                           |-> origClOrdId.value,
         leavesQty                             |-> leavesQty.value,
         lastShares                            |-> lastShares.value,
         lastPx                                |-> lastPx.value,
         displayPrice                          |-> displayPrice.value,
         workingPrice                          |-> workingPrice.value,
         baseLiquidityIndicator                |-> baseLiquidityIndicator.value,
         expireTime                            |-> expireTime.value,
         secondaryOrderId                      |-> secondaryOrderId.value,
         extExecInst                           |-> extExecInst.value,
         subLiquidityIndicator                 |-> subLiquidityIndicator.value,
         stopPx                                |-> stopPx.value,
         routingInst                           |-> routingInst.value,
         auctionId                             |-> auctionId.value,
         liquidityProvision                    |-> liquidityProvision.value,
         clientQualifiedRole                   |-> clientQualifiedRole.value,
         clientId                              |-> clientId.value,
         investorId                            |-> investorId.value,
         executorId                            |-> executorId.value,
         orderOrigination                      |-> orderOrigination.value,
         algorithmicIndicator                  |-> algorithmicIndicator.value,
         investorQualifiedRole                 |-> investorQualifiedRole.value,
         executorQualifiedRole                 |-> executorQualifiedRole.value,
         drillThruProtection                   |-> drillThruProtection.value,
         custOrderHandlingInst                 |-> custOrderHandlingInst.value,
         accountType                           |-> accountType.value ], accountType.rest)

(* Order Acknowledgment V 2 Message with each field marked present by fields before it there exactly where they say *)
SettleOrderAcknowledgmentV2Message(message) ==
    LET settled1 == [message EXCEPT !.orderAcknowledgmentV2ReturnBitfield1 = IF message.numberOfReturnBitfields >= 1 THEN (IF message.orderAcknowledgmentV2ReturnBitfield1 = << >> THEN <<0>> ELSE message.orderAcknowledgmentV2ReturnBitfield1) ELSE << >>]
        settled2 == [settled1 EXCEPT !.orderAcknowledgmentV2ReturnBitfield2 = IF settled1.numberOfReturnBitfields >= 2 THEN (IF settled1.orderAcknowledgmentV2ReturnBitfield2 = << >> THEN <<0>> ELSE settled1.orderAcknowledgmentV2ReturnBitfield2) ELSE << >>]
        settled3 == [settled2 EXCEPT !.orderAcknowledgmentV2ReturnBitfield3 = IF settled2.numberOfReturnBitfields >= 3 THEN (IF settled2.orderAcknowledgmentV2ReturnBitfield3 = << >> THEN <<0>> ELSE settled2.orderAcknowledgmentV2ReturnBitfield3) ELSE << >>]
        settled4 == [settled3 EXCEPT !.orderAcknowledgmentV2ReturnBitfield4 = IF settled3.numberOfReturnBitfields >= 4 THEN (IF settled3.orderAcknowledgmentV2ReturnBitfield4 = << >> THEN <<0>> ELSE settled3.orderAcknowledgmentV2ReturnBitfield4) ELSE << >>]
        settled5 == [settled4 EXCEPT !.orderAcknowledgmentV2ReturnBitfield5 = IF settled4.numberOfReturnBitfields >= 5 THEN (IF settled4.orderAcknowledgmentV2ReturnBitfield5 = << >> THEN <<0>> ELSE settled4.orderAcknowledgmentV2ReturnBitfield5) ELSE << >>]
        settled6 == [settled5 EXCEPT !.orderAcknowledgmentV2ReturnBitfield6 = IF settled5.numberOfReturnBitfields >= 6 THEN (IF settled5.orderAcknowledgmentV2ReturnBitfield6 = << >> THEN <<0>> ELSE settled5.orderAcknowledgmentV2ReturnBitfield6) ELSE << >>]
        settled7 == [settled6 EXCEPT !.orderAcknowledgmentV2ReturnBitfield7 = IF settled6.numberOfReturnBitfields >= 7 THEN (IF settled6.orderAcknowledgmentV2ReturnBitfield7 = << >> THEN <<0>> ELSE settled6.orderAcknowledgmentV2ReturnBitfield7) ELSE << >>]
        settled8 == [settled7 EXCEPT !.orderAcknowledgmentV2ReturnBitfield8 = IF settled7.numberOfReturnBitfields >= 8 THEN (IF settled7.orderAcknowledgmentV2ReturnBitfield8 = << >> THEN <<0>> ELSE settled7.orderAcknowledgmentV2ReturnBitfield8) ELSE << >>]
        settled9 == [settled8 EXCEPT !.orderAcknowledgmentV2ReturnBitfield9 = IF settled8.numberOfReturnBitfields >= 9 THEN (IF settled8.orderAcknowledgmentV2ReturnBitfield9 = << >> THEN <<0>> ELSE settled8.orderAcknowledgmentV2ReturnBitfield9) ELSE << >>]
        settled10 == [settled9 EXCEPT !.orderAcknowledgmentV2ReturnBitfield10 = IF settled9.numberOfReturnBitfields >= 10 THEN (IF settled9.orderAcknowledgmentV2ReturnBitfield10 = << >> THEN <<0>> ELSE settled9.orderAcknowledgmentV2ReturnBitfield10) ELSE << >>]
        settled11 == [settled10 EXCEPT !.orderAcknowledgmentV2ReturnBitfield11 = IF settled10.numberOfReturnBitfields >= 11 THEN (IF settled10.orderAcknowledgmentV2ReturnBitfield11 = << >> THEN <<0>> ELSE settled10.orderAcknowledgmentV2ReturnBitfield11) ELSE << >>]
        settled12 == [settled11 EXCEPT !.orderAcknowledgmentV2ReturnBitfield12 = IF settled11.numberOfReturnBitfields >= 12 THEN (IF settled11.orderAcknowledgmentV2ReturnBitfield12 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled11.orderAcknowledgmentV2ReturnBitfield12) ELSE << >>]
        settled13 == [settled12 EXCEPT !.orderAcknowledgmentV2ReturnBitfield13 = IF settled12.numberOfReturnBitfields >= 13 THEN (IF settled12.orderAcknowledgmentV2ReturnBitfield13 = << >> THEN <<0>> ELSE settled12.orderAcknowledgmentV2ReturnBitfield13) ELSE << >>]
        settled14 == [settled13 EXCEPT !.orderAcknowledgmentV2ReturnBitfield14 = IF settled13.numberOfReturnBitfields >= 14 THEN (IF settled13.orderAcknowledgmentV2ReturnBitfield14 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled13.orderAcknowledgmentV2ReturnBitfield14) ELSE << >>]
