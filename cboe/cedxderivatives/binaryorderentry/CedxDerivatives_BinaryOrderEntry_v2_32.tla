ZeroOrderExecutionV2Message ==
    SettleOrderExecutionV2Message([ transactionTime                  |-> [i \in 1 .. 8 |-> 0],
                                    clOrdId                          |-> [i \in 1 .. 20 |-> 0],
                                    execId                           |-> [i \in 1 .. 8 |-> 0],
                                    lastShares                       |-> [i \in 1 .. 4 |-> 0],
                                    lastPx                           |-> [i \in 1 .. 8 |-> 0],
                                    leavesQty                        |-> [i \in 1 .. 4 |-> 0],
                                    baseLiquidityIndicator           |-> [i \in 1 .. 1 |-> 0],
                                    subLiquidityIndicator            |-> [i \in 1 .. 1 |-> 0],
                                    contraBroker                     |-> [i \in 1 .. 4 |-> 0],
                                    reserved1                        |-> [i \in 1 .. 1 |-> 0],
                                    numberOfReturnBitfields          |-> 0,
                                    orderExecutionV2ReturnBitfield1  |-> << >>,
                                    orderExecutionV2ReturnBitfield2  |-> << >>,
                                    orderExecutionV2ReturnBitfield3  |-> << >>,
                                    orderExecutionV2ReturnBitfield4  |-> << >>,
                                    orderExecutionV2ReturnBitfield5  |-> << >>,
                                    orderExecutionV2ReturnBitfield6  |-> << >>,
                                    orderExecutionV2ReturnBitfield7  |-> << >>,
                                    orderExecutionV2ReturnBitfield8  |-> << >>,
                                    orderExecutionV2ReturnBitfield9  |-> << >>,
                                    orderExecutionV2ReturnBitfield10 |-> << >>,
                                    orderExecutionV2ReturnBitfield11 |-> << >>,
                                    orderExecutionV2ReturnBitfield12 |-> << >>,
                                    orderExecutionV2ReturnBitfield13 |-> << >>,
                                    orderExecutionV2ReturnBitfield14 |-> << >>,
                                    orderExecutionV2ReturnBitfield15 |-> << >>,
                                    orderExecutionV2ReturnBitfield16 |-> << >>,
                                    orderExecutionV2ReturnBitfield17 |-> << >>,
                                    orderExecutionV2ReturnBitfield18 |-> << >>,
                                    orderExecutionV2ReturnBitfield19 |-> << >>,
                                    side                             |-> << >>,
                                    price                            |-> << >>,
                                    ordType                          |-> << >>,
                                    timeInForce                      |-> << >>,
                                    minQty                           |-> << >>,
                                    symbolLong                       |-> << >>,
                                    idSource                         |-> << >>,
                                    securityId                       |-> << >>,
                                    capacity                         |-> << >>,
                                    account                          |-> << >>,
                                    clearingFirm                     |-> << >>,
                                    clearingAccount                  |-> << >>,
                                    displayIndicator                 |-> << >>,
                                    orderQty                         |-> << >>,
                                    preventMatch                     |-> << >>,
                                    openClose                        |-> << >>,
                                    extExecInst                      |-> << >>,
                                    lastMkt                          |-> << >>,
                                    feeCode                          |-> << >>,
                                    stopPx                           |-> << >>,
                                    routingInst                      |-> << >>,
                                    crossType                        |-> << >>,
                                    crossPrioritization              |-> << >>,
                                    crossId                          |-> << >>,
                                    allocQty                         |-> << >>,
                                    clientQualifiedRole              |-> << >>,
                                    clientId                         |-> << >>,
                                    investorId                       |-> << >>,
                                    executorId                       |-> << >>,
                                    orderOrigination                 |-> << >>,
                                    algorithmicIndicator             |-> << >>,
                                    investorQualifiedRole            |-> << >>,
                                    executorQualifiedRole            |-> << >>,
                                    drillThruProtection              |-> << >>,
                                    multilegReportingType            |-> << >>,
                                    secondaryExecId                  |-> << >>,
                                    custOrderHandlingInst            |-> << >>,
                                    accountType                      |-> << >> ])

(* Order Execution V 2 Message at zero, then each field in turn at the values it is checked at *)
CheckedOrderExecutionV2Message ==
    { ZeroOrderExecutionV2Message }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.transactionTime = one]) : one \in Sample(8) }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.clOrdId = one]) : one \in Sample(20) }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.execId = one]) : one \in Sample(8) }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.lastShares = one]) : one \in Sample(4) }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.lastPx = one]) : one \in Sample(8) }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.leavesQty = one]) : one \in Sample(4) }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.baseLiquidityIndicator = one]) : one \in Sample(1) }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.subLiquidityIndicator = one]) : one \in Sample(1) }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.contraBroker = one]) : one \in Sample(4) }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.reserved1 = one]) : one \in Sample(1) }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = one]) : one \in {0, 1, 255} }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 1, !.orderExecutionV2ReturnBitfield1 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 2, !.orderExecutionV2ReturnBitfield2 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 3, !.orderExecutionV2ReturnBitfield3 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 4, !.orderExecutionV2ReturnBitfield4 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 5, !.orderExecutionV2ReturnBitfield5 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 6, !.orderExecutionV2ReturnBitfield6 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 7, !.orderExecutionV2ReturnBitfield7 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 8, !.orderExecutionV2ReturnBitfield8 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 9, !.orderExecutionV2ReturnBitfield9 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 10, !.orderExecutionV2ReturnBitfield10 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 11, !.orderExecutionV2ReturnBitfield11 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 12, !.orderExecutionV2ReturnBitfield12 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 13, !.orderExecutionV2ReturnBitfield13 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 14, !.orderExecutionV2ReturnBitfield14 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 15, !.orderExecutionV2ReturnBitfield15 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 16, !.orderExecutionV2ReturnBitfield16 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 17, !.orderExecutionV2ReturnBitfield17 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 18, !.orderExecutionV2ReturnBitfield18 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 19, !.orderExecutionV2ReturnBitfield19 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 1, !.orderExecutionV2ReturnBitfield1 = <<1>>, !.side = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 1, !.orderExecutionV2ReturnBitfield1 = <<4>>, !.price = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 1, !.orderExecutionV2ReturnBitfield1 = <<16>>, !.ordType = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 1, !.orderExecutionV2ReturnBitfield1 = <<32>>, !.timeInForce = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 1, !.orderExecutionV2ReturnBitfield1 = <<64>>, !.minQty = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 2, !.orderExecutionV2ReturnBitfield2 = <<1>>, !.symbolLong = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 2, !.orderExecutionV2ReturnBitfield2 = <<8>>, !.idSource = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 2, !.orderExecutionV2ReturnBitfield2 = <<16>>, !.securityId = one]) : one \in { <<held>> : held \in Sample(16) } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 2, !.orderExecutionV2ReturnBitfield2 = <<64>>, !.capacity = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 3, !.orderExecutionV2ReturnBitfield3 = <<1>>, !.account = one]) : one \in { <<held>> : held \in Sample(16) } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 3, !.orderExecutionV2ReturnBitfield3 = <<2>>, !.clearingFirm = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 3, !.orderExecutionV2ReturnBitfield3 = <<4>>, !.clearingAccount = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 3, !.orderExecutionV2ReturnBitfield3 = <<8>>, !.displayIndicator = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 3, !.orderExecutionV2ReturnBitfield3 = <<64>>, !.orderQty = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 3, !.orderExecutionV2ReturnBitfield3 = <<128>>, !.preventMatch = one]) : one \in { <<held>> : held \in Sample(3) } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 4, !.orderExecutionV2ReturnBitfield4 = <<8>>, !.openClose = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 6, !.orderExecutionV2ReturnBitfield6 = <<16>>, !.extExecInst = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 7, !.orderExecutionV2ReturnBitfield7 = <<128>>, !.lastMkt = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 8, !.orderExecutionV2ReturnBitfield8 = <<1>>, !.feeCode = one]) : one \in { <<held>> : held \in Sample(2) } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 8, !.orderExecutionV2ReturnBitfield8 = <<4>>, !.stopPx = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 8, !.orderExecutionV2ReturnBitfield8 = <<8>>, !.routingInst = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 9, !.orderExecutionV2ReturnBitfield9 = <<64>>, !.crossType = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 9, !.orderExecutionV2ReturnBitfield9 = <<128>>, !.crossPrioritization = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 10, !.orderExecutionV2ReturnBitfield10 = <<1>>, !.crossId = one]) : one \in { <<held>> : held \in Sample(20) } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 10, !.orderExecutionV2ReturnBitfield10 = <<2>>, !.allocQty = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 10, !.orderExecutionV2ReturnBitfield10 = <<128>>, !.clientQualifiedRole = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 11, !.orderExecutionV2ReturnBitfield11 = <<1>>, !.clientId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 11, !.orderExecutionV2ReturnBitfield11 = <<2>>, !.investorId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 11, !.orderExecutionV2ReturnBitfield11 = <<4>>, !.executorId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 11, !.orderExecutionV2ReturnBitfield11 = <<8>>, !.orderOrigination = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 11, !.orderExecutionV2ReturnBitfield11 = <<16>>, !.algorithmicIndicator = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 11, !.orderExecutionV2ReturnBitfield11 = <<64>>, !.investorQualifiedRole = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 11, !.orderExecutionV2ReturnBitfield11 = <<128>>, !.executorQualifiedRole = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 13, !.orderExecutionV2ReturnBitfield13 = <<64>>, !.drillThruProtection = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 13, !.orderExecutionV2ReturnBitfield13 = <<128>>, !.multilegReportingType = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 14, !.orderExecutionV2ReturnBitfield14 = <<16>>, !.secondaryExecId = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 17, !.orderExecutionV2ReturnBitfield17 = <<128>>, !.custOrderHandlingInst = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderExecutionV2Message([ZeroOrderExecutionV2Message EXCEPT !.numberOfReturnBitfields = 18, !.orderExecutionV2ReturnBitfield18 = <<1>>, !.accountType = one]) : one \in { <<held>> : held \in Sample(1) } }

(***************************************************************************)
(* Quote Execution Message: 75 bytes                                       *)
(***************************************************************************)

QuoteExecutionMessage ==
    [ transactionTime        : Sample(8),
      quoteUpdateId          : Sample(16),
      orderId                : Sample(8),
      execId                 : Sample(8),
      symbolShort            : Sample(6),
      clearingFirm           : Sample(4),
      lastShares             : Sample(4),
      lastPx                 : Sample(8),
      leavesQty              : Sample(4),
      lastMkt                : Sample(4),
      side                   : Sample(1),
      baseLiquidityIndicator : Sample(1),
      subLiquidityIndicator  : Sample(1),
      feeCode                : Sample(2) ]

EncodeQuoteExecutionMessage(message) ==
    message.transactionTime
        \o message.quoteUpdateId
        \o message.orderId
        \o message.execId
        \o message.symbolShort
        \o message.clearingFirm
        \o message.lastShares
        \o message.lastPx
        \o message.leavesQty
        \o message.lastMkt
        \o message.side
        \o message.baseLiquidityIndicator
        \o message.subLiquidityIndicator
        \o message.feeCode

DecodeQuoteExecutionMessage(bytes) ==
    LET transactionTime == ReadBytes(bytes, 8) IN IF ~transactionTime.ok THEN Fail ELSE
    LET quoteUpdateId == ReadBytes(transactionTime.rest, 16) IN IF ~quoteUpdateId.ok THEN Fail ELSE
    LET orderId == ReadBytes(quoteUpdateId.rest, 8) IN IF ~orderId.ok THEN Fail ELSE
    LET execId == ReadBytes(orderId.rest, 8) IN IF ~execId.ok THEN Fail ELSE
    LET symbolShort == ReadBytes(execId.rest, 6) IN IF ~symbolShort.ok THEN Fail ELSE
    LET clearingFirm == ReadBytes(symbolShort.rest, 4) IN IF ~clearingFirm.ok THEN Fail ELSE
    LET lastShares == ReadBytes(clearingFirm.rest, 4) IN IF ~lastShares.ok THEN Fail ELSE
    LET lastPx == ReadBytes(lastShares.rest, 8) IN IF ~lastPx.ok THEN Fail ELSE
    LET leavesQty == ReadBytes(lastPx.rest, 4) IN IF ~leavesQty.ok THEN Fail ELSE
    LET lastMkt == ReadBytes(leavesQty.rest, 4) IN IF ~lastMkt.ok THEN Fail ELSE
    LET side == ReadBytes(lastMkt.rest, 1) IN IF ~side.ok THEN Fail ELSE
    LET baseLiquidityIndicator == ReadBytes(side.rest, 1) IN IF ~baseLiquidityIndicator.ok THEN Fail ELSE
    LET subLiquidityIndicator == ReadBytes(baseLiquidityIndicator.rest, 1) IN IF ~subLiquidityIndicator.ok THEN Fail ELSE
    LET feeCode == ReadBytes(subLiquidityIndicator.rest, 2) IN IF ~feeCode.ok THEN Fail ELSE
    Ok([ transactionTime        |-> transactionTime.value,
         quoteUpdateId          |-> quoteUpdateId.value,
         orderId                |-> orderId.value,
         execId                 |-> execId.value,
         symbolShort            |-> symbolShort.value,
         clearingFirm           |-> clearingFirm.value,
         lastShares             |-> lastShares.value,
         lastPx                 |-> lastPx.value,
         leavesQty              |-> leavesQty.value,
         lastMkt                |-> lastMkt.value,
         side                   |-> side.value,
         baseLiquidityIndicator |-> baseLiquidityIndicator.value,
         subLiquidityIndicator  |-> subLiquidityIndicator.value,
         feeCode                |-> feeCode.value ], feeCode.rest)

ZeroQuoteExecutionMessage ==
    [ transactionTime        |-> [i \in 1 .. 8 |-> 0],
      quoteUpdateId          |-> [i \in 1 .. 16 |-> 0],
      orderId                |-> [i \in 1 .. 8 |-> 0],
      execId                 |-> [i \in 1 .. 8 |-> 0],
      symbolShort            |-> [i \in 1 .. 6 |-> 0],
      clearingFirm           |-> [i \in 1 .. 4 |-> 0],
      lastShares             |-> [i \in 1 .. 4 |-> 0],
      lastPx                 |-> [i \in 1 .. 8 |-> 0],
      leavesQty              |-> [i \in 1 .. 4 |-> 0],
      lastMkt                |-> [i \in 1 .. 4 |-> 0],
      side                   |-> [i \in 1 .. 1 |-> 0],
      baseLiquidityIndicator |-> [i \in 1 .. 1 |-> 0],
      subLiquidityIndicator  |-> [i \in 1 .. 1 |-> 0],
      feeCode                |-> [i \in 1 .. 2 |-> 0] ]

(* Quote Execution Message at zero, then each field in turn at the values it is checked at *)
CheckedQuoteExecutionMessage ==
    { ZeroQuoteExecutionMessage }
        \cup { [ZeroQuoteExecutionMessage EXCEPT !.transactionTime = one] : one \in Sample(8) }
        \cup { [ZeroQuoteExecutionMessage EXCEPT !.quoteUpdateId = one] : one \in Sample(16) }
        \cup { [ZeroQuoteExecutionMessage EXCEPT !.orderId = one] : one \in Sample(8) }
        \cup { [ZeroQuoteExecutionMessage EXCEPT !.execId = one] : one \in Sample(8) }
        \cup { [ZeroQuoteExecutionMessage EXCEPT !.symbolShort = one] : one \in Sample(6) }
        \cup { [ZeroQuoteExecutionMessage EXCEPT !.clearingFirm = one] : one \in Sample(4) }
        \cup { [ZeroQuoteExecutionMessage EXCEPT !.lastShares = one] : one \in Sample(4) }
        \cup { [ZeroQuoteExecutionMessage EXCEPT !.lastPx = one] : one \in Sample(8) }
        \cup { [ZeroQuoteExecutionMessage EXCEPT !.leavesQty = one] : one \in Sample(4) }
        \cup { [ZeroQuoteExecutionMessage EXCEPT !.lastMkt = one] : one \in Sample(4) }
        \cup { [ZeroQuoteExecutionMessage EXCEPT !.side = one] : one \in Sample(1) }
        \cup { [ZeroQuoteExecutionMessage EXCEPT !.baseLiquidityIndicator = one] : one \in Sample(1) }
        \cup { [ZeroQuoteExecutionMessage EXCEPT !.subLiquidityIndicator = one] : one \in Sample(1) }
        \cup { [ZeroQuoteExecutionMessage EXCEPT !.feeCode = one] : one \in Sample(2) }

(***************************************************************************)
(* Trade Cancel Or Correct V 2 Message                                     *)
(***************************************************************************)

TradeCancelOrCorrectV2Message ==
    [ transactionTime                        : Sample(8),
      clOrdId                                : Sample(20),
      orderId                                : Sample(8),
      execRefId                              : Sample(8),
      side                                   : Sample(1),
      baseLiquidityIndicator                 : Sample(1),
      clearingFirm                           : Sample(4),
      clearingAccount                        : Sample(4),
      lastShares                             : Sample(4),
      lastPx                                 : Sample(8),
      correctedPrice                         : Sample(8),
      origTime                               : Sample(8),
      reserved1                              : Sample(1),
      numberOfReturnBitfields                : 0 .. 255,
      tradeCancelorCorrectV2ReturnBitfield1  : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeCancelorCorrectV2ReturnBitfield2  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      tradeCancelorCorrectV2ReturnBitfield3  : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeCancelorCorrectV2ReturnBitfield4  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      tradeCancelorCorrectV2ReturnBitfield5  : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeCancelorCorrectV2ReturnBitfield6  : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeCancelorCorrectV2ReturnBitfield7  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      tradeCancelorCorrectV2ReturnBitfield8  : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeCancelorCorrectV2ReturnBitfield9  : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeCancelorCorrectV2ReturnBitfield10 : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeCancelorCorrectV2ReturnBitfield11 : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeCancelorCorrectV2ReturnBitfield12 : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeCancelorCorrectV2ReturnBitfield13 : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeCancelorCorrectV2ReturnBitfield14 : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeCancelorCorrectV2ReturnBitfield15 : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeCancelorCorrectV2ReturnBitfield16 : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeCancelorCorrectV2ReturnBitfield17 : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeCancelorCorrectV2ReturnBitfield18 : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeCancelorCorrectV2ReturnBitfield19 : { << >> } \cup { <<held>> : held \in Sample(1) },
      symbolLong                             : { << >> } \cup { <<held>> : held \in Sample(8) },
      idSource                               : { << >> } \cup { <<held>> : held \in Sample(1) },
      securityId                             : { << >> } \cup { <<held>> : held \in Sample(16) },
      capacity                               : { << >> } \cup { <<held>> : held \in Sample(1) },
      openClose                              : { << >> } \cup { <<held>> : held \in Sample(1) },
      correctedSize                          : { << >> } \cup { <<held>> : held \in Sample(4) },
      subLiquidityIndicator                  : { << >> } \cup { <<held>> : held \in Sample(1) },
      lastMkt                                : { << >> } \cup { <<held>> : held \in Sample(4) } ]

EncodeTradeCancelOrCorrectV2Message(message) ==
    message.transactionTime
        \o message.clOrdId
        \o message.orderId
        \o message.execRefId
        \o message.side
        \o message.baseLiquidityIndicator
        \o message.clearingFirm
        \o message.clearingAccount
        \o message.lastShares
        \o message.lastPx
        \o message.correctedPrice
        \o message.origTime
        \o message.reserved1
        \o EncodeUIntBE(message.numberOfReturnBitfields, 1)
        \o (IF message.tradeCancelorCorrectV2ReturnBitfield1 = << >> THEN << >> ELSE message.tradeCancelorCorrectV2ReturnBitfield1[1])
        \o (IF message.tradeCancelorCorrectV2ReturnBitfield2 = << >> THEN << >> ELSE EncodeUIntLE(message.tradeCancelorCorrectV2ReturnBitfield2[1], 1))
        \o (IF message.tradeCancelorCorrectV2ReturnBitfield3 = << >> THEN << >> ELSE message.tradeCancelorCorrectV2ReturnBitfield3[1])
        \o (IF message.tradeCancelorCorrectV2ReturnBitfield4 = << >> THEN << >> ELSE EncodeUIntLE(message.tradeCancelorCorrectV2ReturnBitfield4[1], 1))
        \o (IF message.tradeCancelorCorrectV2ReturnBitfield5 = << >> THEN << >> ELSE message.tradeCancelorCorrectV2ReturnBitfield5[1])
        \o (IF message.tradeCancelorCorrectV2ReturnBitfield6 = << >> THEN << >> ELSE message.tradeCancelorCorrectV2ReturnBitfield6[1])
        \o (IF message.tradeCancelorCorrectV2ReturnBitfield7 = << >> THEN << >> ELSE EncodeUIntLE(message.tradeCancelorCorrectV2ReturnBitfield7[1], 1))
        \o (IF message.tradeCancelorCorrectV2ReturnBitfield8 = << >> THEN << >> ELSE message.tradeCancelorCorrectV2ReturnBitfield8[1])
        \o (IF message.tradeCancelorCorrectV2ReturnBitfield9 = << >> THEN << >> ELSE message.tradeCancelorCorrectV2ReturnBitfield9[1])
        \o (IF message.tradeCancelorCorrectV2ReturnBitfield10 = << >> THEN << >> ELSE message.tradeCancelorCorrectV2ReturnBitfield10[1])
        \o (IF message.tradeCancelorCorrectV2ReturnBitfield11 = << >> THEN << >> ELSE message.tradeCancelorCorrectV2ReturnBitfield11[1])
        \o (IF message.tradeCancelorCorrectV2ReturnBitfield12 = << >> THEN << >> ELSE message.tradeCancelorCorrectV2ReturnBitfield12[1])
        \o (IF message.tradeCancelorCorrectV2ReturnBitfield13 = << >> THEN << >> ELSE message.tradeCancelorCorrectV2ReturnBitfield13[1])
        \o (IF message.tradeCancelorCorrectV2ReturnBitfield14 = << >> THEN << >> ELSE message.tradeCancelorCorrectV2ReturnBitfield14[1])
        \o (IF message.tradeCancelorCorrectV2ReturnBitfield15 = << >> THEN << >> ELSE message.tradeCancelorCorrectV2ReturnBitfield15[1])
        \o (IF message.tradeCancelorCorrectV2ReturnBitfield16 = << >> THEN << >> ELSE message.tradeCancelorCorrectV2ReturnBitfield16[1])
        \o (IF message.tradeCancelorCorrectV2ReturnBitfield17 = << >> THEN << >> ELSE message.tradeCancelorCorrectV2ReturnBitfield17[1])
        \o (IF message.tradeCancelorCorrectV2ReturnBitfield18 = << >> THEN << >> ELSE message.tradeCancelorCorrectV2ReturnBitfield18[1])
        \o (IF message.tradeCancelorCorrectV2ReturnBitfield19 = << >> THEN << >> ELSE message.tradeCancelorCorrectV2ReturnBitfield19[1])
        \o (IF message.symbolLong = << >> THEN << >> ELSE message.symbolLong[1])
        \o (IF message.idSource = << >> THEN << >> ELSE message.idSource[1])
        \o (IF message.securityId = << >> THEN << >> ELSE message.securityId[1])
        \o (IF message.capacity = << >> THEN << >> ELSE message.capacity[1])
        \o (IF message.openClose = << >> THEN << >> ELSE message.openClose[1])
        \o (IF message.correctedSize = << >> THEN << >> ELSE message.correctedSize[1])
        \o (IF message.subLiquidityIndicator = << >> THEN << >> ELSE message.subLiquidityIndicator[1])
        \o (IF message.lastMkt = << >> THEN << >> ELSE message.lastMkt[1])

DecodeTradeCancelOrCorrectV2Message(bytes) ==
    LET transactionTime == ReadBytes(bytes, 8) IN IF ~transactionTime.ok THEN Fail ELSE
    LET clOrdId == ReadBytes(transactionTime.rest, 20) IN IF ~clOrdId.ok THEN Fail ELSE
    LET orderId == ReadBytes(clOrdId.rest, 8) IN IF ~orderId.ok THEN Fail ELSE
    LET execRefId == ReadBytes(orderId.rest, 8) IN IF ~execRefId.ok THEN Fail ELSE
    LET side == ReadBytes(execRefId.rest, 1) IN IF ~side.ok THEN Fail ELSE
    LET baseLiquidityIndicator == ReadBytes(side.rest, 1) IN IF ~baseLiquidityIndicator.ok THEN Fail ELSE
    LET clearingFirm == ReadBytes(baseLiquidityIndicator.rest, 4) IN IF ~clearingFirm.ok THEN Fail ELSE
    LET clearingAccount == ReadBytes(clearingFirm.rest, 4) IN IF ~clearingAccount.ok THEN Fail ELSE
    LET lastShares == ReadBytes(clearingAccount.rest, 4) IN IF ~lastShares.ok THEN Fail ELSE
    LET lastPx == ReadBytes(lastShares.rest, 8) IN IF ~lastPx.ok THEN Fail ELSE
    LET correctedPrice == ReadBytes(lastPx.rest, 8) IN IF ~correctedPrice.ok THEN Fail ELSE
    LET origTime == ReadBytes(correctedPrice.rest, 8) IN IF ~origTime.ok THEN Fail ELSE
    LET reserved1 == ReadBytes(origTime.rest, 1) IN IF ~reserved1.ok THEN Fail ELSE
    LET numberOfReturnBitfields == ReadUIntBE(reserved1.rest, 1) IN IF ~numberOfReturnBitfields.ok THEN Fail ELSE
    LET tradeCancelorCorrectV2ReturnBitfield1 == ReadWhen(numberOfReturnBitfields.value >= 1, ReadBytes(numberOfReturnBitfields.rest, 1), numberOfReturnBitfields.rest) IN IF ~tradeCancelorCorrectV2ReturnBitfield1.ok THEN Fail ELSE
    LET tradeCancelorCorrectV2ReturnBitfield2 == ReadWhen(numberOfReturnBitfields.value >= 2, ReadUIntLE(tradeCancelorCorrectV2ReturnBitfield1.rest, 1), tradeCancelorCorrectV2ReturnBitfield1.rest) IN IF ~tradeCancelorCorrectV2ReturnBitfield2.ok THEN Fail ELSE
    LET tradeCancelorCorrectV2ReturnBitfield3 == ReadWhen(numberOfReturnBitfields.value >= 3, ReadBytes(tradeCancelorCorrectV2ReturnBitfield2.rest, 1), tradeCancelorCorrectV2ReturnBitfield2.rest) IN IF ~tradeCancelorCorrectV2ReturnBitfield3.ok THEN Fail ELSE
    LET tradeCancelorCorrectV2ReturnBitfield4 == ReadWhen(numberOfReturnBitfields.value >= 4, ReadUIntLE(tradeCancelorCorrectV2ReturnBitfield3.rest, 1), tradeCancelorCorrectV2ReturnBitfield3.rest) IN IF ~tradeCancelorCorrectV2ReturnBitfield4.ok THEN Fail ELSE
    LET tradeCancelorCorrectV2ReturnBitfield5 == ReadWhen(numberOfReturnBitfields.value >= 5, ReadBytes(tradeCancelorCorrectV2ReturnBitfield4.rest, 1), tradeCancelorCorrectV2ReturnBitfield4.rest) IN IF ~tradeCancelorCorrectV2ReturnBitfield5.ok THEN Fail ELSE
    LET tradeCancelorCorrectV2ReturnBitfield6 == ReadWhen(numberOfReturnBitfields.value >= 6, ReadBytes(tradeCancelorCorrectV2ReturnBitfield5.rest, 1), tradeCancelorCorrectV2ReturnBitfield5.rest) IN IF ~tradeCancelorCorrectV2ReturnBitfield6.ok THEN Fail ELSE
    LET tradeCancelorCorrectV2ReturnBitfield7 == ReadWhen(numberOfReturnBitfields.value >= 7, ReadUIntLE(tradeCancelorCorrectV2ReturnBitfield6.rest, 1), tradeCancelorCorrectV2ReturnBitfield6.rest) IN IF ~tradeCancelorCorrectV2ReturnBitfield7.ok THEN Fail ELSE
    LET tradeCancelorCorrectV2ReturnBitfield8 == ReadWhen(numberOfReturnBitfields.value >= 8, ReadBytes(tradeCancelorCorrectV2ReturnBitfield7.rest, 1), tradeCancelorCorrectV2ReturnBitfield7.rest) IN IF ~tradeCancelorCorrectV2ReturnBitfield8.ok THEN Fail ELSE
    LET tradeCancelorCorrectV2ReturnBitfield9 == ReadWhen(numberOfReturnBitfields.value >= 9, ReadBytes(tradeCancelorCorrectV2ReturnBitfield8.rest, 1), tradeCancelorCorrectV2ReturnBitfield8.rest) IN IF ~tradeCancelorCorrectV2ReturnBitfield9.ok THEN Fail ELSE
    LET tradeCancelorCorrectV2ReturnBitfield10 == ReadWhen(numberOfReturnBitfields.value >= 10, ReadBytes(tradeCancelorCorrectV2ReturnBitfield9.rest, 1), tradeCancelorCorrectV2ReturnBitfield9.rest) IN IF ~tradeCancelorCorrectV2ReturnBitfield10.ok THEN Fail ELSE
    LET tradeCancelorCorrectV2ReturnBitfield11 == ReadWhen(numberOfReturnBitfields.value >= 11, ReadBytes(tradeCancelorCorrectV2ReturnBitfield10.rest, 1), tradeCancelorCorrectV2ReturnBitfield10.rest) IN IF ~tradeCancelorCorrectV2ReturnBitfield11.ok THEN Fail ELSE
    LET tradeCancelorCorrectV2ReturnBitfield12 == ReadWhen(numberOfReturnBitfields.value >= 12, ReadBytes(tradeCancelorCorrectV2ReturnBitfield11.rest, 1), tradeCancelorCorrectV2ReturnBitfield11.rest) IN IF ~tradeCancelorCorrectV2ReturnBitfield12.ok THEN Fail ELSE
    LET tradeCancelorCorrectV2ReturnBitfield13 == ReadWhen(numberOfReturnBitfields.value >= 13, ReadBytes(tradeCancelorCorrectV2ReturnBitfield12.rest, 1), tradeCancelorCorrectV2ReturnBitfield12.rest) IN IF ~tradeCancelorCorrectV2ReturnBitfield13.ok THEN Fail ELSE
    LET tradeCancelorCorrectV2ReturnBitfield14 == ReadWhen(numberOfReturnBitfields.value >= 14, ReadBytes(tradeCancelorCorrectV2ReturnBitfield13.rest, 1), tradeCancelorCorrectV2ReturnBitfield13.rest) IN IF ~tradeCancelorCorrectV2ReturnBitfield14.ok THEN Fail ELSE
    LET tradeCancelorCorrectV2ReturnBitfield15 == ReadWhen(numberOfReturnBitfields.value >= 15, ReadBytes(tradeCancelorCorrectV2ReturnBitfield14.rest, 1), tradeCancelorCorrectV2ReturnBitfield14.rest) IN IF ~tradeCancelorCorrectV2ReturnBitfield15.ok THEN Fail ELSE
    LET tradeCancelorCorrectV2ReturnBitfield16 == ReadWhen(numberOfReturnBitfields.value >= 16, ReadBytes(tradeCancelorCorrectV2ReturnBitfield15.rest, 1), tradeCancelorCorrectV2ReturnBitfield15.rest) IN IF ~tradeCancelorCorrectV2ReturnBitfield16.ok THEN Fail ELSE
    LET tradeCancelorCorrectV2ReturnBitfield17 == ReadWhen(numberOfReturnBitfields.value >= 17, ReadBytes(tradeCancelorCorrectV2ReturnBitfield16.rest, 1), tradeCancelorCorrectV2ReturnBitfield16.rest) IN IF ~tradeCancelorCorrectV2ReturnBitfield17.ok THEN Fail ELSE
    LET tradeCancelorCorrectV2ReturnBitfield18 == ReadWhen(numberOfReturnBitfields.value >= 18, ReadBytes(tradeCancelorCorrectV2ReturnBitfield17.rest, 1), tradeCancelorCorrectV2ReturnBitfield17.rest) IN IF ~tradeCancelorCorrectV2ReturnBitfield18.ok THEN Fail ELSE
    LET tradeCancelorCorrectV2ReturnBitfield19 == ReadWhen(numberOfReturnBitfields.value >= 19, ReadBytes(tradeCancelorCorrectV2ReturnBitfield18.rest, 1), tradeCancelorCorrectV2ReturnBitfield18.rest) IN IF ~tradeCancelorCorrectV2ReturnBitfield19.ok THEN Fail ELSE
    LET symbolLong == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (tradeCancelorCorrectV2ReturnBitfield2.value # << >> /\ tradeCancelorCorrectV2ReturnBitfield2.value[1] % 2 > 0), ReadBytes(tradeCancelorCorrectV2ReturnBitfield19.rest, 8), tradeCancelorCorrectV2ReturnBitfield19.rest) IN IF ~symbolLong.ok THEN Fail ELSE
    LET idSource == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (tradeCancelorCorrectV2ReturnBitfield2.value # << >> /\ (tradeCancelorCorrectV2ReturnBitfield2.value[1] \div 8) % 2 > 0), ReadBytes(symbolLong.rest, 1), symbolLong.rest) IN IF ~idSource.ok THEN Fail ELSE
    LET securityId == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (tradeCancelorCorrectV2ReturnBitfield2.value # << >> /\ (tradeCancelorCorrectV2ReturnBitfield2.value[1] \div 16) % 2 > 0), ReadBytes(idSource.rest, 16), idSource.rest) IN IF ~securityId.ok THEN Fail ELSE
    LET capacity == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (tradeCancelorCorrectV2ReturnBitfield2.value # << >> /\ (tradeCancelorCorrectV2ReturnBitfield2.value[1] \div 64) % 2 > 0), ReadBytes(securityId.rest, 1), securityId.rest) IN IF ~capacity.ok THEN Fail ELSE
    LET openClose == ReadWhen(numberOfReturnBitfields.value >= 4 /\ (tradeCancelorCorrectV2ReturnBitfield4.value # << >> /\ (tradeCancelorCorrectV2ReturnBitfield4.value[1] \div 8) % 2 > 0), ReadBytes(capacity.rest, 1), capacity.rest) IN IF ~openClose.ok THEN Fail ELSE
    LET correctedSize == ReadWhen(numberOfReturnBitfields.value >= 4 /\ (tradeCancelorCorrectV2ReturnBitfield4.value # << >> /\ (tradeCancelorCorrectV2ReturnBitfield4.value[1] \div 32) % 2 > 0), ReadBytes(openClose.rest, 4), openClose.rest) IN IF ~correctedSize.ok THEN Fail ELSE
    LET subLiquidityIndicator == ReadWhen(numberOfReturnBitfields.value >= 7 /\ (tradeCancelorCorrectV2ReturnBitfield7.value # << >> /\ tradeCancelorCorrectV2ReturnBitfield7.value[1] % 2 > 0), ReadBytes(correctedSize.rest, 1), correctedSize.rest) IN IF ~subLiquidityIndicator.ok THEN Fail ELSE
    LET lastMkt == ReadWhen(numberOfReturnBitfields.value >= 7 /\ (tradeCancelorCorrectV2ReturnBitfield7.value # << >> /\ (tradeCancelorCorrectV2ReturnBitfield7.value[1] \div 128) % 2 > 0), ReadBytes(subLiquidityIndicator.rest, 4), subLiquidityIndicator.rest) IN IF ~lastMkt.ok THEN Fail ELSE
    Ok([ transactionTime                        |-> transactionTime.value,
         clOrdId                                |-> clOrdId.value,
         orderId                                |-> orderId.value,
         execRefId                              |-> execRefId.value,
         side                                   |-> side.value,
         baseLiquidityIndicator                 |-> baseLiquidityIndicator.value,
         clearingFirm                           |-> clearingFirm.value,
         clearingAccount                        |-> clearingAccount.value,
         lastShares                             |-> lastShares.value,
         lastPx                                 |-> lastPx.value,
         correctedPrice                         |-> correctedPrice.value,
         origTime                               |-> origTime.value,
         reserved1                              |-> reserved1.value,
         numberOfReturnBitfields                |-> numberOfReturnBitfields.value,
         tradeCancelorCorrectV2ReturnBitfield1  |-> tradeCancelorCorrectV2ReturnBitfield1.value,
         tradeCancelorCorrectV2ReturnBitfield2  |-> tradeCancelorCorrectV2ReturnBitfield2.value,
         tradeCancelorCorrectV2ReturnBitfield3  |-> tradeCancelorCorrectV2ReturnBitfield3.value,
         tradeCancelorCorrectV2ReturnBitfield4  |-> tradeCancelorCorrectV2ReturnBitfield4.value,
         tradeCancelorCorrectV2ReturnBitfield5  |-> tradeCancelorCorrectV2ReturnBitfield5.value,
         tradeCancelorCorrectV2ReturnBitfield6  |-> tradeCancelorCorrectV2ReturnBitfield6.value,
         tradeCancelorCorrectV2ReturnBitfield7  |-> tradeCancelorCorrectV2ReturnBitfield7.value,
         tradeCancelorCorrectV2ReturnBitfield8  |-> tradeCancelorCorrectV2ReturnBitfield8.value,
         tradeCancelorCorrectV2ReturnBitfield9  |-> tradeCancelorCorrectV2ReturnBitfield9.value,
         tradeCancelorCorrectV2ReturnBitfield10 |-> tradeCancelorCorrectV2ReturnBitfield10.value,
         tradeCancelorCorrectV2ReturnBitfield11 |-> tradeCancelorCorrectV2ReturnBitfield11.value,
         tradeCancelorCorrectV2ReturnBitfield12 |-> tradeCancelorCorrectV2ReturnBitfield12.value,
         tradeCancelorCorrectV2ReturnBitfield13 |-> tradeCancelorCorrectV2ReturnBitfield13.value,
         tradeCancelorCorrectV2ReturnBitfield14 |-> tradeCancelorCorrectV2ReturnBitfield14.value,
         tradeCancelorCorrectV2ReturnBitfield15 |-> tradeCancelorCorrectV2ReturnBitfield15.value,
         tradeCancelorCorrectV2ReturnBitfield16 |-> tradeCancelorCorrectV2ReturnBitfield16.value,
         tradeCancelorCorrectV2ReturnBitfield17 |-> tradeCancelorCorrectV2ReturnBitfield17.value,
         tradeCancelorCorrectV2ReturnBitfield18 |-> tradeCancelorCorrectV2ReturnBitfield18.value,
         tradeCancelorCorrectV2ReturnBitfield19 |-> tradeCancelorCorrectV2ReturnBitfield19.value,
         symbolLong                             |-> symbolLong.value,
         idSource                               |-> idSource.value,
         securityId                             |-> securityId.value,
         capacity                               |-> capacity.value,
         openClose                              |-> openClose.value,
         correctedSize                          |-> correctedSize.value,
         subLiquidityIndicator                  |-> subLiquidityIndicator.value,
         lastMkt                                |-> lastMkt.value ], lastMkt.rest)

(* Trade Cancel Or Correct V 2 Message with each field marked present by fields before it there exactly where they say *)
SettleTradeCancelOrCorrectV2Message(message) ==
    LET settled1 == [message EXCEPT !.tradeCancelorCorrectV2ReturnBitfield1 = IF message.numberOfReturnBitfields >= 1 THEN (IF message.tradeCancelorCorrectV2ReturnBitfield1 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE message.tradeCancelorCorrectV2ReturnBitfield1) ELSE << >>]
        settled2 == [settled1 EXCEPT !.tradeCancelorCorrectV2ReturnBitfield2 = IF settled1.numberOfReturnBitfields >= 2 THEN (IF settled1.tradeCancelorCorrectV2ReturnBitfield2 = << >> THEN <<0>> ELSE settled1.tradeCancelorCorrectV2ReturnBitfield2) ELSE << >>]
        settled3 == [settled2 EXCEPT !.tradeCancelorCorrectV2ReturnBitfield3 = IF settled2.numberOfReturnBitfields >= 3 THEN (IF settled2.tradeCancelorCorrectV2ReturnBitfield3 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled2.tradeCancelorCorrectV2ReturnBitfield3) ELSE << >>]
        settled4 == [settled3 EXCEPT !.tradeCancelorCorrectV2ReturnBitfield4 = IF settled3.numberOfReturnBitfields >= 4 THEN (IF settled3.tradeCancelorCorrectV2ReturnBitfield4 = << >> THEN <<0>> ELSE settled3.tradeCancelorCorrectV2ReturnBitfield4) ELSE << >>]
        settled5 == [settled4 EXCEPT !.tradeCancelorCorrectV2ReturnBitfield5 = IF settled4.numberOfReturnBitfields >= 5 THEN (IF settled4.tradeCancelorCorrectV2ReturnBitfield5 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled4.tradeCancelorCorrectV2ReturnBitfield5) ELSE << >>]
        settled6 == [settled5 EXCEPT !.tradeCancelorCorrectV2ReturnBitfield6 = IF settled5.numberOfReturnBitfields >= 6 THEN (IF settled5.tradeCancelorCorrectV2ReturnBitfield6 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled5.tradeCancelorCorrectV2ReturnBitfield6) ELSE << >>]
        settled7 == [settled6 EXCEPT !.tradeCancelorCorrectV2ReturnBitfield7 = IF settled6.numberOfReturnBitfields >= 7 THEN (IF settled6.tradeCancelorCorrectV2ReturnBitfield7 = << >> THEN <<0>> ELSE settled6.tradeCancelorCorrectV2ReturnBitfield7) ELSE << >>]
        settled8 == [settled7 EXCEPT !.tradeCancelorCorrectV2ReturnBitfield8 = IF settled7.numberOfReturnBitfields >= 8 THEN (IF settled7.tradeCancelorCorrectV2ReturnBitfield8 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled7.tradeCancelorCorrectV2ReturnBitfield8) ELSE << >>]
        settled9 == [settled8 EXCEPT !.tradeCancelorCorrectV2ReturnBitfield9 = IF settled8.numberOfReturnBitfields >= 9 THEN (IF settled8.tradeCancelorCorrectV2ReturnBitfield9 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled8.tradeCancelorCorrectV2ReturnBitfield9) ELSE << >>]
        settled10 == [settled9 EXCEPT !.tradeCancelorCorrectV2ReturnBitfield10 = IF settled9.numberOfReturnBitfields >= 10 THEN (IF settled9.tradeCancelorCorrectV2ReturnBitfield10 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled9.tradeCancelorCorrectV2ReturnBitfield10) ELSE << >>]
        settled11 == [settled10 EXCEPT !.tradeCancelorCorrectV2ReturnBitfield11 = IF settled10.numberOfReturnBitfields >= 11 THEN (IF settled10.tradeCancelorCorrectV2ReturnBitfield11 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled10.tradeCancelorCorrectV2ReturnBitfield11) ELSE << >>]
        settled12 == [settled11 EXCEPT !.tradeCancelorCorrectV2ReturnBitfield12 = IF settled11.numberOfReturnBitfields >= 12 THEN (IF settled11.tradeCancelorCorrectV2ReturnBitfield12 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled11.tradeCancelorCorrectV2ReturnBitfield12) ELSE << >>]
        settled13 == [settled12 EXCEPT !.tradeCancelorCorrectV2ReturnBitfield13 = IF settled12.numberOfReturnBitfields >= 13 THEN (IF settled12.tradeCancelorCorrectV2ReturnBitfield13 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled12.tradeCancelorCorrectV2ReturnBitfield13) ELSE << >>]
        settled14 == [settled13 EXCEPT !.tradeCancelorCorrectV2ReturnBitfield14 = IF settled13.numberOfReturnBitfields >= 14 THEN (IF settled13.tradeCancelorCorrectV2ReturnBitfield14 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled13.tradeCancelorCorrectV2ReturnBitfield14) ELSE << >>]
        settled15 == [settled14 EXCEPT !.tradeCancelorCorrectV2ReturnBitfield15 = IF settled14.numberOfReturnBitfields >= 15 THEN (IF settled14.tradeCancelorCorrectV2ReturnBitfield15 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled14.tradeCancelorCorrectV2ReturnBitfield15) ELSE << >>]
        settled16 == [settled15 EXCEPT !.tradeCancelorCorrectV2ReturnBitfield16 = IF settled15.numberOfReturnBitfields >= 16 THEN (IF settled15.tradeCancelorCorrectV2ReturnBitfield16 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled15.tradeCancelorCorrectV2ReturnBitfield16) ELSE << >>]
        settled17 == [settled16 EXCEPT !.tradeCancelorCorrectV2ReturnBitfield17 = IF settled16.numberOfReturnBitfields >= 17 THEN (IF settled16.tradeCancelorCorrectV2ReturnBitfield17 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled16.tradeCancelorCorrectV2ReturnBitfield17) ELSE << >>]
        settled18 == [settled17 EXCEPT !.tradeCancelorCorrectV2ReturnBitfield18 = IF settled17.numberOfReturnBitfields >= 18 THEN (IF settled17.tradeCancelorCorrectV2ReturnBitfield18 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled17.tradeCancelorCorrectV2ReturnBitfield18) ELSE << >>]
        settled19 == [settled18 EXCEPT !.tradeCancelorCorrectV2ReturnBitfield19 = IF settled18.numberOfReturnBitfields >= 19 THEN (IF settled18.tradeCancelorCorrectV2ReturnBitfield19 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled18.tradeCancelorCorrectV2ReturnBitfield19) ELSE << >>]
        settled20 == [settled19 EXCEPT !.symbolLong = IF settled19.numberOfReturnBitfields >= 2 /\ (settled19.tradeCancelorCorrectV2ReturnBitfield2 # << >> /\ settled19.tradeCancelorCorrectV2ReturnBitfield2[1] % 2 > 0) THEN (IF settled19.symbolLong = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled19.symbolLong) ELSE << >>]
        settled21 == [settled20 EXCEPT !.idSource = IF settled20.numberOfReturnBitfields >= 2 /\ (settled20.tradeCancelorCorrectV2ReturnBitfield2 # << >> /\ (settled20.tradeCancelorCorrectV2ReturnBitfield2[1] \div 8) % 2 > 0) THEN (IF settled20.idSource = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled20.idSource) ELSE << >>]
        settled22 == [settled21 EXCEPT !.securityId = IF settled21.numberOfReturnBitfields >= 2 /\ (settled21.tradeCancelorCorrectV2ReturnBitfield2 # << >> /\ (settled21.tradeCancelorCorrectV2ReturnBitfield2[1] \div 16) % 2 > 0) THEN (IF settled21.securityId = << >> THEN <<[i \in 1 .. 16 |-> 0]>> ELSE settled21.securityId) ELSE << >>]
        settled23 == [settled22 EXCEPT !.capacity = IF settled22.numberOfReturnBitfields >= 2 /\ (settled22.tradeCancelorCorrectV2ReturnBitfield2 # << >> /\ (settled22.tradeCancelorCorrectV2ReturnBitfield2[1] \div 64) % 2 > 0) THEN (IF settled22.capacity = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled22.capacity) ELSE << >>]
        settled24 == [settled23 EXCEPT !.openClose = IF settled23.numberOfReturnBitfields >= 4 /\ (settled23.tradeCancelorCorrectV2ReturnBitfield4 # << >> /\ (settled23.tradeCancelorCorrectV2ReturnBitfield4[1] \div 8) % 2 > 0) THEN (IF settled23.openClose = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled23.openClose) ELSE << >>]
        settled25 == [settled24 EXCEPT !.correctedSize = IF settled24.numberOfReturnBitfields >= 4 /\ (settled24.tradeCancelorCorrectV2ReturnBitfield4 # << >> /\ (settled24.tradeCancelorCorrectV2ReturnBitfield4[1] \div 32) % 2 > 0) THEN (IF settled24.correctedSize = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled24.correctedSize) ELSE << >>]
        settled26 == [settled25 EXCEPT !.subLiquidityIndicator = IF settled25.numberOfReturnBitfields >= 7 /\ (settled25.tradeCancelorCorrectV2ReturnBitfield7 # << >> /\ settled25.tradeCancelorCorrectV2ReturnBitfield7[1] % 2 > 0) THEN (IF settled25.subLiquidityIndicator = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled25.subLiquidityIndicator) ELSE << >>]
        settled27 == [settled26 EXCEPT !.lastMkt = IF settled26.numberOfReturnBitfields >= 7 /\ (settled26.tradeCancelorCorrectV2ReturnBitfield7 # << >> /\ (settled26.tradeCancelorCorrectV2ReturnBitfield7[1] \div 128) % 2 > 0) THEN (IF settled26.lastMkt = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled26.lastMkt) ELSE << >>]
    IN  settled27

ZeroTradeCancelOrCorrectV2Message ==
    SettleTradeCancelOrCorrectV2Message([ transactionTime                        |-> [i \in 1 .. 8 |-> 0],
                                          clOrdId                                |-> [i \in 1 .. 20 |-> 0],
                                          orderId                                |-> [i \in 1 .. 8 |-> 0],
                                          execRefId                              |-> [i \in 1 .. 8 |-> 0],
                                          side                                   |-> [i \in 1 .. 1 |-> 0],
                                          baseLiquidityIndicator                 |-> [i \in 1 .. 1 |-> 0],
                                          clearingFirm                           |-> [i \in 1 .. 4 |-> 0],
                                          clearingAccount                        |-> [i \in 1 .. 4 |-> 0],
                                          lastShares                             |-> [i \in 1 .. 4 |-> 0],
                                          lastPx                                 |-> [i \in 1 .. 8 |-> 0],
                                          correctedPrice                         |-> [i \in 1 .. 8 |-> 0],
                                          origTime                               |-> [i \in 1 .. 8 |-> 0],
                                          reserved1                              |-> [i \in 1 .. 1 |-> 0],
                                          numberOfReturnBitfields                |-> 0,
                                          tradeCancelorCorrectV2ReturnBitfield1  |-> << >>,
                                          tradeCancelorCorrectV2ReturnBitfield2  |-> << >>,
                                          tradeCancelorCorrectV2ReturnBitfield3  |-> << >>,
                                          tradeCancelorCorrectV2ReturnBitfield4  |-> << >>,
                                          tradeCancelorCorrectV2ReturnBitfield5  |-> << >>,
                                          tradeCancelorCorrectV2ReturnBitfield6  |-> << >>,
                                          tradeCancelorCorrectV2ReturnBitfield7  |-> << >>,
                                          tradeCancelorCorrectV2ReturnBitfield8  |-> << >>,
                                          tradeCancelorCorrectV2ReturnBitfield9  |-> << >>,
                                          tradeCancelorCorrectV2ReturnBitfield10 |-> << >>,
                                          tradeCancelorCorrectV2ReturnBitfield11 |-> << >>,
                                          tradeCancelorCorrectV2ReturnBitfield12 |-> << >>,
                                          tradeCancelorCorrectV2ReturnBitfield13 |-> << >>,
                                          tradeCancelorCorrectV2ReturnBitfield14 |-> << >>,
                                          tradeCancelorCorrectV2ReturnBitfield15 |-> << >>,
                                          tradeCancelorCorrectV2ReturnBitfield16 |-> << >>,
                                          tradeCancelorCorrectV2ReturnBitfield17 |-> << >>,
                                          tradeCancelorCorrectV2ReturnBitfield18 |-> << >>,
                                          tradeCancelorCorrectV2ReturnBitfield19 |-> << >>,
                                          symbolLong                             |-> << >>,
                                          idSource                               |-> << >>,
                                          securityId                             |-> << >>,
                                          capacity                               |-> << >>,
                                          openClose                              |-> << >>,
                                          correctedSize                          |-> << >>,
                                          subLiquidityIndicator                  |-> << >>,
                                          lastMkt                                |-> << >> ])

(* Trade Cancel Or Correct V 2 Message at zero, then each field in turn at the values it is checked at *)
CheckedTradeCancelOrCorrectV2Message ==
    { ZeroTradeCancelOrCorrectV2Message }
        \cup { SettleTradeCancelOrCorrectV2Message([ZeroTradeCancelOrCorrectV2Message EXCEPT !.transactionTime = one]) : one \in Sample(8) }
        \cup { SettleTradeCancelOrCorrectV2Message([ZeroTradeCancelOrCorrectV2Message EXCEPT !.clOrdId = one]) : one \in Sample(20) }
        \cup { SettleTradeCancelOrCorrectV2Message([ZeroTradeCancelOrCorrectV2Message EXCEPT !.orderId = one]) : one \in Sample(8) }
        \cup { SettleTradeCancelOrCorrectV2Message([ZeroTradeCancelOrCorrectV2Message EXCEPT !.execRefId = one]) : one \in Sample(8) }
        \cup { SettleTradeCancelOrCorrectV2Message([ZeroTradeCancelOrCorrectV2Message EXCEPT !.side = one]) : one \in Sample(1) }
        \cup { SettleTradeCancelOrCorrectV2Message([ZeroTradeCancelOrCorrectV2Message EXCEPT !.baseLiquidityIndicator = one]) : one \in Sample(1) }
        \cup { SettleTradeCancelOrCorrectV2Message([ZeroTradeCancelOrCorrectV2Message EXCEPT !.clearingFirm = one]) : one \in Sample(4) }
        \cup { SettleTradeCancelOrCorrectV2Message([ZeroTradeCancelOrCorrectV2Message EXCEPT !.clearingAccount = one]) : one \in Sample(4) }
        \cup { SettleTradeCancelOrCorrectV2Message([ZeroTradeCancelOrCorrectV2Message EXCEPT !.lastShares = one]) : one \in Sample(4) }
        \cup { SettleTradeCancelOrCorrectV2Message([ZeroTradeCancelOrCorrectV2Message EXCEPT !.lastPx = one]) : one \in Sample(8) }
        \cup { SettleTradeCancelOrCorrectV2Message([ZeroTradeCancelOrCorrectV2Message EXCEPT !.correctedPrice = one]) : one \in Sample(8) }
        \cup { SettleTradeCancelOrCorrectV2Message([ZeroTradeCancelOrCorrectV2Message EXCEPT !.origTime = one]) : one \in Sample(8) }
        \cup { SettleTradeCancelOrCorrectV2Message([ZeroTradeCancelOrCorrectV2Message EXCEPT !.reserved1 = one]) : one \in Sample(1) }
        \cup { SettleTradeCancelOrCorrectV2Message([ZeroTradeCancelOrCorrectV2Message EXCEPT !.numberOfReturnBitfields = one]) : one \in {0, 1, 255} }
        \cup { SettleTradeCancelOrCorrectV2Message([ZeroTradeCancelOrCorrectV2Message EXCEPT !.numberOfReturnBitfields = 1, !.tradeCancelorCorrectV2ReturnBitfield1 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCancelOrCorrectV2Message([ZeroTradeCancelOrCorrectV2Message EXCEPT !.numberOfReturnBitfields = 2, !.tradeCancelorCorrectV2ReturnBitfield2 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleTradeCancelOrCorrectV2Message([ZeroTradeCancelOrCorrectV2Message EXCEPT !.numberOfReturnBitfields = 3, !.tradeCancelorCorrectV2ReturnBitfield3 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCancelOrCorrectV2Message([ZeroTradeCancelOrCorrectV2Message EXCEPT !.numberOfReturnBitfields = 4, !.tradeCancelorCorrectV2ReturnBitfield4 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleTradeCancelOrCorrectV2Message([ZeroTradeCancelOrCorrectV2Message EXCEPT !.numberOfReturnBitfields = 5, !.tradeCancelorCorrectV2ReturnBitfield5 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCancelOrCorrectV2Message([ZeroTradeCancelOrCorrectV2Message EXCEPT !.numberOfReturnBitfields = 6, !.tradeCancelorCorrectV2ReturnBitfield6 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCancelOrCorrectV2Message([ZeroTradeCancelOrCorrectV2Message EXCEPT !.numberOfReturnBitfields = 7, !.tradeCancelorCorrectV2ReturnBitfield7 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleTradeCancelOrCorrectV2Message([ZeroTradeCancelOrCorrectV2Message EXCEPT !.numberOfReturnBitfields = 8, !.tradeCancelorCorrectV2ReturnBitfield8 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCancelOrCorrectV2Message([ZeroTradeCancelOrCorrectV2Message EXCEPT !.numberOfReturnBitfields = 9, !.tradeCancelorCorrectV2ReturnBitfield9 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCancelOrCorrectV2Message([ZeroTradeCancelOrCorrectV2Message EXCEPT !.numberOfReturnBitfields = 10, !.tradeCancelorCorrectV2ReturnBitfield10 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCancelOrCorrectV2Message([ZeroTradeCancelOrCorrectV2Message EXCEPT !.numberOfReturnBitfields = 11, !.tradeCancelorCorrectV2ReturnBitfield11 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCancelOrCorrectV2Message([ZeroTradeCancelOrCorrectV2Message EXCEPT !.numberOfReturnBitfields = 12, !.tradeCancelorCorrectV2ReturnBitfield12 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCancelOrCorrectV2Message([ZeroTradeCancelOrCorrectV2Message EXCEPT !.numberOfReturnBitfields = 13, !.tradeCancelorCorrectV2ReturnBitfield13 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCancelOrCorrectV2Message([ZeroTradeCancelOrCorrectV2Message EXCEPT !.numberOfReturnBitfields = 14, !.tradeCancelorCorrectV2ReturnBitfield14 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCancelOrCorrectV2Message([ZeroTradeCancelOrCorrectV2Message EXCEPT !.numberOfReturnBitfields = 15, !.tradeCancelorCorrectV2ReturnBitfield15 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCancelOrCorrectV2Message([ZeroTradeCancelOrCorrectV2Message EXCEPT !.numberOfReturnBitfields = 16, !.tradeCancelorCorrectV2ReturnBitfield16 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCancelOrCorrectV2Message([ZeroTradeCancelOrCorrectV2Message EXCEPT !.numberOfReturnBitfields = 17, !.tradeCancelorCorrectV2ReturnBitfield17 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCancelOrCorrectV2Message([ZeroTradeCancelOrCorrectV2Message EXCEPT !.numberOfReturnBitfields = 18, !.tradeCancelorCorrectV2ReturnBitfield18 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCancelOrCorrectV2Message([ZeroTradeCancelOrCorrectV2Message EXCEPT !.numberOfReturnBitfields = 19, !.tradeCancelorCorrectV2ReturnBitfield19 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCancelOrCorrectV2Message([ZeroTradeCancelOrCorrectV2Message EXCEPT !.numberOfReturnBitfields = 2, !.tradeCancelorCorrectV2ReturnBitfield2 = <<1>>, !.symbolLong = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleTradeCancelOrCorrectV2Message([ZeroTradeCancelOrCorrectV2Message EXCEPT !.numberOfReturnBitfields = 2, !.tradeCancelorCorrectV2ReturnBitfield2 = <<8>>, !.idSource = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCancelOrCorrectV2Message([ZeroTradeCancelOrCorrectV2Message EXCEPT !.numberOfReturnBitfields = 2, !.tradeCancelorCorrectV2ReturnBitfield2 = <<16>>, !.securityId = one]) : one \in { <<held>> : held \in Sample(16) } }
        \cup { SettleTradeCancelOrCorrectV2Message([ZeroTradeCancelOrCorrectV2Message EXCEPT !.numberOfReturnBitfields = 2, !.tradeCancelorCorrectV2ReturnBitfield2 = <<64>>, !.capacity = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCancelOrCorrectV2Message([ZeroTradeCancelOrCorrectV2Message EXCEPT !.numberOfReturnBitfields = 4, !.tradeCancelorCorrectV2ReturnBitfield4 = <<8>>, !.openClose = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCancelOrCorrectV2Message([ZeroTradeCancelOrCorrectV2Message EXCEPT !.numberOfReturnBitfields = 4, !.tradeCancelorCorrectV2ReturnBitfield4 = <<32>>, !.correctedSize = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleTradeCancelOrCorrectV2Message([ZeroTradeCancelOrCorrectV2Message EXCEPT !.numberOfReturnBitfields = 7, !.tradeCancelorCorrectV2ReturnBitfield7 = <<1>>, !.subLiquidityIndicator = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCancelOrCorrectV2Message([ZeroTradeCancelOrCorrectV2Message EXCEPT !.numberOfReturnBitfields = 7, !.tradeCancelorCorrectV2ReturnBitfield7 = <<128>>, !.lastMkt = one]) : one \in { <<held>> : held \in Sample(4) } }

(***************************************************************************)
(* Purge Rejected Message                                                  *)
(***************************************************************************)

PurgeRejectedMessage ==
    [ transactionTime               : Sample(8),
      purgeRejectReason             : Sample(1),
      text                          : Sample(60),
      reserved1                     : Sample(1),
      numberOfReturnBitfields       : 0 .. 255,
      purgeRejectedReturnBitfield1  : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeRejectedReturnBitfield2  : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeRejectedReturnBitfield3  : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeRejectedReturnBitfield4  : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeRejectedReturnBitfield5  : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeRejectedReturnBitfield6  : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeRejectedReturnBitfield7  : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeRejectedReturnBitfield8  : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeRejectedReturnBitfield9  : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeRejectedReturnBitfield10 : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeRejectedReturnBitfield11 : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeRejectedReturnBitfield12 : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeRejectedReturnBitfield13 : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeRejectedReturnBitfield14 : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeRejectedReturnBitfield15 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      purgeRejectedReturnBitfield16 : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeRejectedReturnBitfield17 : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeRejectedReturnBitfield18 : { << >> } \cup { <<held>> : held \in Sample(1) },
      purgeRejectedReturnBitfield19 : { << >> } \cup { <<held>> : held \in Sample(1) },
      massCancelId                  : { << >> } \cup { <<held>> : held \in Sample(20) } ]

EncodePurgeRejectedMessage(message) ==
    message.transactionTime
        \o message.purgeRejectReason
        \o message.text
        \o message.reserved1
        \o EncodeUIntBE(message.numberOfReturnBitfields, 1)
        \o (IF message.purgeRejectedReturnBitfield1 = << >> THEN << >> ELSE message.purgeRejectedReturnBitfield1[1])
        \o (IF message.purgeRejectedReturnBitfield2 = << >> THEN << >> ELSE message.purgeRejectedReturnBitfield2[1])
        \o (IF message.purgeRejectedReturnBitfield3 = << >> THEN << >> ELSE message.purgeRejectedReturnBitfield3[1])
        \o (IF message.purgeRejectedReturnBitfield4 = << >> THEN << >> ELSE message.purgeRejectedReturnBitfield4[1])
        \o (IF message.purgeRejectedReturnBitfield5 = << >> THEN << >> ELSE message.purgeRejectedReturnBitfield5[1])
        \o (IF message.purgeRejectedReturnBitfield6 = << >> THEN << >> ELSE message.purgeRejectedReturnBitfield6[1])
        \o (IF message.purgeRejectedReturnBitfield7 = << >> THEN << >> ELSE message.purgeRejectedReturnBitfield7[1])
        \o (IF message.purgeRejectedReturnBitfield8 = << >> THEN << >> ELSE message.purgeRejectedReturnBitfield8[1])
        \o (IF message.purgeRejectedReturnBitfield9 = << >> THEN << >> ELSE message.purgeRejectedReturnBitfield9[1])
        \o (IF message.purgeRejectedReturnBitfield10 = << >> THEN << >> ELSE message.purgeRejectedReturnBitfield10[1])
        \o (IF message.purgeRejectedReturnBitfield11 = << >> THEN << >> ELSE message.purgeRejectedReturnBitfield11[1])
        \o (IF message.purgeRejectedReturnBitfield12 = << >> THEN << >> ELSE message.purgeRejectedReturnBitfield12[1])
        \o (IF message.purgeRejectedReturnBitfield13 = << >> THEN << >> ELSE message.purgeRejectedReturnBitfield13[1])
        \o (IF message.purgeRejectedReturnBitfield14 = << >> THEN << >> ELSE message.purgeRejectedReturnBitfield14[1])
        \o (IF message.purgeRejectedReturnBitfield15 = << >> THEN << >> ELSE EncodeUIntLE(message.purgeRejectedReturnBitfield15[1], 1))
        \o (IF message.purgeRejectedReturnBitfield16 = << >> THEN << >> ELSE message.purgeRejectedReturnBitfield16[1])
        \o (IF message.purgeRejectedReturnBitfield17 = << >> THEN << >> ELSE message.purgeRejectedReturnBitfield17[1])
        \o (IF message.purgeRejectedReturnBitfield18 = << >> THEN << >> ELSE message.purgeRejectedReturnBitfield18[1])
        \o (IF message.purgeRejectedReturnBitfield19 = << >> THEN << >> ELSE message.purgeRejectedReturnBitfield19[1])
        \o (IF message.massCancelId = << >> THEN << >> ELSE message.massCancelId[1])

DecodePurgeRejectedMessage(bytes) ==
    LET transactionTime == ReadBytes(bytes, 8) IN IF ~transactionTime.ok THEN Fail ELSE
    LET purgeRejectReason == ReadBytes(transactionTime.rest, 1) IN IF ~purgeRejectReason.ok THEN Fail ELSE
    LET text == ReadBytes(purgeRejectReason.rest, 60) IN IF ~text.ok THEN Fail ELSE
    LET reserved1 == ReadBytes(text.rest, 1) IN IF ~reserved1.ok THEN Fail ELSE
    LET numberOfReturnBitfields == ReadUIntBE(reserved1.rest, 1) IN IF ~numberOfReturnBitfields.ok THEN Fail ELSE
    LET purgeRejectedReturnBitfield1 == ReadWhen(numberOfReturnBitfields.value >= 1, ReadBytes(numberOfReturnBitfields.rest, 1), numberOfReturnBitfields.rest) IN IF ~purgeRejectedReturnBitfield1.ok THEN Fail ELSE
    LET purgeRejectedReturnBitfield2 == ReadWhen(numberOfReturnBitfields.value >= 2, ReadBytes(purgeRejectedReturnBitfield1.rest, 1), purgeRejectedReturnBitfield1.rest) IN IF ~purgeRejectedReturnBitfield2.ok THEN Fail ELSE
    LET purgeRejectedReturnBitfield3 == ReadWhen(numberOfReturnBitfields.value >= 3, ReadBytes(purgeRejectedReturnBitfield2.rest, 1), purgeRejectedReturnBitfield2.rest) IN IF ~purgeRejectedReturnBitfield3.ok THEN Fail ELSE
    LET purgeRejectedReturnBitfield4 == ReadWhen(numberOfReturnBitfields.value >= 4, ReadBytes(purgeRejectedReturnBitfield3.rest, 1), purgeRejectedReturnBitfield3.rest) IN IF ~purgeRejectedReturnBitfield4.ok THEN Fail ELSE
    LET purgeRejectedReturnBitfield5 == ReadWhen(numberOfReturnBitfields.value >= 5, ReadBytes(purgeRejectedReturnBitfield4.rest, 1), purgeRejectedReturnBitfield4.rest) IN IF ~purgeRejectedReturnBitfield5.ok THEN Fail ELSE
    LET purgeRejectedReturnBitfield6 == ReadWhen(numberOfReturnBitfields.value >= 6, ReadBytes(purgeRejectedReturnBitfield5.rest, 1), purgeRejectedReturnBitfield5.rest) IN IF ~purgeRejectedReturnBitfield6.ok THEN Fail ELSE
    LET purgeRejectedReturnBitfield7 == ReadWhen(numberOfReturnBitfields.value >= 7, ReadBytes(purgeRejectedReturnBitfield6.rest, 1), purgeRejectedReturnBitfield6.rest) IN IF ~purgeRejectedReturnBitfield7.ok THEN Fail ELSE
    LET purgeRejectedReturnBitfield8 == ReadWhen(numberOfReturnBitfields.value >= 8, ReadBytes(purgeRejectedReturnBitfield7.rest, 1), purgeRejectedReturnBitfield7.rest) IN IF ~purgeRejectedReturnBitfield8.ok THEN Fail ELSE
    LET purgeRejectedReturnBitfield9 == ReadWhen(numberOfReturnBitfields.value >= 9, ReadBytes(purgeRejectedReturnBitfield8.rest, 1), purgeRejectedReturnBitfield8.rest) IN IF ~purgeRejectedReturnBitfield9.ok THEN Fail ELSE
    LET purgeRejectedReturnBitfield10 == ReadWhen(numberOfReturnBitfields.value >= 10, ReadBytes(purgeRejectedReturnBitfield9.rest, 1), purgeRejectedReturnBitfield9.rest) IN IF ~purgeRejectedReturnBitfield10.ok THEN Fail ELSE
    LET purgeRejectedReturnBitfield11 == ReadWhen(numberOfReturnBitfields.value >= 11, ReadBytes(purgeRejectedReturnBitfield10.rest, 1), purgeRejectedReturnBitfield10.rest) IN IF ~purgeRejectedReturnBitfield11.ok THEN Fail ELSE
    LET purgeRejectedReturnBitfield12 == ReadWhen(numberOfReturnBitfields.value >= 12, ReadBytes(purgeRejectedReturnBitfield11.rest, 1), purgeRejectedReturnBitfield11.rest) IN IF ~purgeRejectedReturnBitfield12.ok THEN Fail ELSE
    LET purgeRejectedReturnBitfield13 == ReadWhen(numberOfReturnBitfields.value >= 13, ReadBytes(purgeRejectedReturnBitfield12.rest, 1), purgeRejectedReturnBitfield12.rest) IN IF ~purgeRejectedReturnBitfield13.ok THEN Fail ELSE
    LET purgeRejectedReturnBitfield14 == ReadWhen(numberOfReturnBitfields.value >= 14, ReadBytes(purgeRejectedReturnBitfield13.rest, 1), purgeRejectedReturnBitfield13.rest) IN IF ~purgeRejectedReturnBitfield14.ok THEN Fail ELSE
    LET purgeRejectedReturnBitfield15 == ReadWhen(numberOfReturnBitfields.value >= 15, ReadUIntLE(purgeRejectedReturnBitfield14.rest, 1), purgeRejectedReturnBitfield14.rest) IN IF ~purgeRejectedReturnBitfield15.ok THEN Fail ELSE
    LET purgeRejectedReturnBitfield16 == ReadWhen(numberOfReturnBitfields.value >= 16, ReadBytes(purgeRejectedReturnBitfield15.rest, 1), purgeRejectedReturnBitfield15.rest) IN IF ~purgeRejectedReturnBitfield16.ok THEN Fail ELSE
    LET purgeRejectedReturnBitfield17 == ReadWhen(numberOfReturnBitfields.value >= 17, ReadBytes(purgeRejectedReturnBitfield16.rest, 1), purgeRejectedReturnBitfield16.rest) IN IF ~purgeRejectedReturnBitfield17.ok THEN Fail ELSE
    LET purgeRejectedReturnBitfield18 == ReadWhen(numberOfReturnBitfields.value >= 18, ReadBytes(purgeRejectedReturnBitfield17.rest, 1), purgeRejectedReturnBitfield17.rest) IN IF ~purgeRejectedReturnBitfield18.ok THEN Fail ELSE
    LET purgeRejectedReturnBitfield19 == ReadWhen(numberOfReturnBitfields.value >= 19, ReadBytes(purgeRejectedReturnBitfield18.rest, 1), purgeRejectedReturnBitfield18.rest) IN IF ~purgeRejectedReturnBitfield19.ok THEN Fail ELSE
    LET massCancelId == ReadWhen(numberOfReturnBitfields.value >= 15 /\ (purgeRejectedReturnBitfield15.value # << >> /\ (purgeRejectedReturnBitfield15.value[1] \div 8) % 2 > 0), ReadBytes(purgeRejectedReturnBitfield19.rest, 20), purgeRejectedReturnBitfield19.rest) IN IF ~massCancelId.ok THEN Fail ELSE
    Ok([ transactionTime               |-> transactionTime.value,
         purgeRejectReason             |-> purgeRejectReason.value,
         text                          |-> text.value,
         reserved1                     |-> reserved1.value,
         numberOfReturnBitfields       |-> numberOfReturnBitfields.value,
         purgeRejectedReturnBitfield1  |-> purgeRejectedReturnBitfield1.value,
         purgeRejectedReturnBitfield2  |-> purgeRejectedReturnBitfield2.value,
         purgeRejectedReturnBitfield3  |-> purgeRejectedReturnBitfield3.value,
         purgeRejectedReturnBitfield4  |-> purgeRejectedReturnBitfield4.value,
         purgeRejectedReturnBitfield5  |-> purgeRejectedReturnBitfield5.value,
         purgeRejectedReturnBitfield6  |-> purgeRejectedReturnBitfield6.value,
         purgeRejectedReturnBitfield7  |-> purgeRejectedReturnBitfield7.value,
         purgeRejectedReturnBitfield8  |-> purgeRejectedReturnBitfield8.value,
         purgeRejectedReturnBitfield9  |-> purgeRejectedReturnBitfield9.value,
         purgeRejectedReturnBitfield10 |-> purgeRejectedReturnBitfield10.value,
         purgeRejectedReturnBitfield11 |-> purgeRejectedReturnBitfield11.value,
         purgeRejectedReturnBitfield12 |-> purgeRejectedReturnBitfield12.value,
         purgeRejectedReturnBitfield13 |-> purgeRejectedReturnBitfield13.value,
         purgeRejectedReturnBitfield14 |-> purgeRejectedReturnBitfield14.value,
         purgeRejectedReturnBitfield15 |-> purgeRejectedReturnBitfield15.value,
         purgeRejectedReturnBitfield16 |-> purgeRejectedReturnBitfield16.value,
         purgeRejectedReturnBitfield17 |-> purgeRejectedReturnBitfield17.value,
         purgeRejectedReturnBitfield18 |-> purgeRejectedReturnBitfield18.value,
         purgeRejectedReturnBitfield19 |-> purgeRejectedReturnBitfield19.value,
         massCancelId                  |-> massCancelId.value ], massCancelId.rest)

(* Purge Rejected Message with each field marked present by fields before it there exactly where they say *)
SettlePurgeRejectedMessage(message) ==
    LET settled1 == [message EXCEPT !.purgeRejectedReturnBitfield1 = IF message.numberOfReturnBitfields >= 1 THEN (IF message.purgeRejectedReturnBitfield1 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE message.purgeRejectedReturnBitfield1) ELSE << >>]
        settled2 == [settled1 EXCEPT !.purgeRejectedReturnBitfield2 = IF settled1.numberOfReturnBitfields >= 2 THEN (IF settled1.purgeRejectedReturnBitfield2 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled1.purgeRejectedReturnBitfield2) ELSE << >>]
        settled3 == [settled2 EXCEPT !.purgeRejectedReturnBitfield3 = IF settled2.numberOfReturnBitfields >= 3 THEN (IF settled2.purgeRejectedReturnBitfield3 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled2.purgeRejectedReturnBitfield3) ELSE << >>]
        settled4 == [settled3 EXCEPT !.purgeRejectedReturnBitfield4 = IF settled3.numberOfReturnBitfields >= 4 THEN (IF settled3.purgeRejectedReturnBitfield4 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled3.purgeRejectedReturnBitfield4) ELSE << >>]
        settled5 == [settled4 EXCEPT !.purgeRejectedReturnBitfield5 = IF settled4.numberOfReturnBitfields >= 5 THEN (IF settled4.purgeRejectedReturnBitfield5 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled4.purgeRejectedReturnBitfield5) ELSE << >>]
        settled6 == [settled5 EXCEPT !.purgeRejectedReturnBitfield6 = IF settled5.numberOfReturnBitfields >= 6 THEN (IF settled5.purgeRejectedReturnBitfield6 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled5.purgeRejectedReturnBitfield6) ELSE << >>]
        settled7 == [settled6 EXCEPT !.purgeRejectedReturnBitfield7 = IF settled6.numberOfReturnBitfields >= 7 THEN (IF settled6.purgeRejectedReturnBitfield7 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled6.purgeRejectedReturnBitfield7) ELSE << >>]
        settled8 == [settled7 EXCEPT !.purgeRejectedReturnBitfield8 = IF settled7.numberOfReturnBitfields >= 8 THEN (IF settled7.purgeRejectedReturnBitfield8 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled7.purgeRejectedReturnBitfield8) ELSE << >>]
        settled9 == [settled8 EXCEPT !.purgeRejectedReturnBitfield9 = IF settled8.numberOfReturnBitfields >= 9 THEN (IF settled8.purgeRejectedReturnBitfield9 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled8.purgeRejectedReturnBitfield9) ELSE << >>]
        settled10 == [settled9 EXCEPT !.purgeRejectedReturnBitfield10 = IF settled9.numberOfReturnBitfields >= 10 THEN (IF settled9.purgeRejectedReturnBitfield10 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled9.purgeRejectedReturnBitfield10) ELSE << >>]
        settled11 == [settled10 EXCEPT !.purgeRejectedReturnBitfield11 = IF settled10.numberOfReturnBitfields >= 11 THEN (IF settled10.purgeRejectedReturnBitfield11 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled10.purgeRejectedReturnBitfield11) ELSE << >>]
        settled12 == [settled11 EXCEPT !.purgeRejectedReturnBitfield12 = IF settled11.numberOfReturnBitfields >= 12 THEN (IF settled11.purgeRejectedReturnBitfield12 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled11.purgeRejectedReturnBitfield12) ELSE << >>]
        settled13 == [settled12 EXCEPT !.purgeRejectedReturnBitfield13 = IF settled12.numberOfReturnBitfields >= 13 THEN (IF settled12.purgeRejectedReturnBitfield13 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled12.purgeRejectedReturnBitfield13) ELSE << >>]
        settled14 == [settled13 EXCEPT !.purgeRejectedReturnBitfield14 = IF settled13.numberOfReturnBitfields >= 14 THEN (IF settled13.purgeRejectedReturnBitfield14 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled13.purgeRejectedReturnBitfield14) ELSE << >>]
        settled15 == [settled14 EXCEPT !.purgeRejectedReturnBitfield15 = IF settled14.numberOfReturnBitfields >= 15 THEN (IF settled14.purgeRejectedReturnBitfield15 = << >> THEN <<0>> ELSE settled14.purgeRejectedReturnBitfield15) ELSE << >>]
        settled16 == [settled15 EXCEPT !.purgeRejectedReturnBitfield16 = IF settled15.numberOfReturnBitfields >= 16 THEN (IF settled15.purgeRejectedReturnBitfield16 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled15.purgeRejectedReturnBitfield16) ELSE << >>]
        settled17 == [settled16 EXCEPT !.purgeRejectedReturnBitfield17 = IF settled16.numberOfReturnBitfields >= 17 THEN (IF settled16.purgeRejectedReturnBitfield17 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled16.purgeRejectedReturnBitfield17) ELSE << >>]
        settled18 == [settled17 EXCEPT !.purgeRejectedReturnBitfield18 = IF settled17.numberOfReturnBitfields >= 18 THEN (IF settled17.purgeRejectedReturnBitfield18 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled17.purgeRejectedReturnBitfield18) ELSE << >>]
        settled19 == [settled18 EXCEPT !.purgeRejectedReturnBitfield19 = IF settled18.numberOfReturnBitfields >= 19 THEN (IF settled18.purgeRejectedReturnBitfield19 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled18.purgeRejectedReturnBitfield19) ELSE << >>]
        settled20 == [settled19 EXCEPT !.massCancelId = IF settled19.numberOfReturnBitfields >= 15 /\ (settled19.purgeRejectedReturnBitfield15 # << >> /\ (settled19.purgeRejectedReturnBitfield15[1] \div 8) % 2 > 0) THEN (IF settled19.massCancelId = << >> THEN <<[i \in 1 .. 20 |-> 0]>> ELSE settled19.massCancelId) ELSE << >>]
    IN  settled20

ZeroPurgeRejectedMessage ==
    SettlePurgeRejectedMessage([ transactionTime               |-> [i \in 1 .. 8 |-> 0],
                                 purgeRejectReason             |-> [i \in 1 .. 1 |-> 0],
                                 text                          |-> [i \in 1 .. 60 |-> 0],
                                 reserved1                     |-> [i \in 1 .. 1 |-> 0],
                                 numberOfReturnBitfields       |-> 0,
                                 purgeRejectedReturnBitfield1  |-> << >>,
                                 purgeRejectedReturnBitfield2  |-> << >>,
                                 purgeRejectedReturnBitfield3  |-> << >>,
                                 purgeRejectedReturnBitfield4  |-> << >>,
                                 purgeRejectedReturnBitfield5  |-> << >>,
                                 purgeRejectedReturnBitfield6  |-> << >>,
                                 purgeRejectedReturnBitfield7  |-> << >>,
                                 purgeRejectedReturnBitfield8  |-> << >>,
                                 purgeRejectedReturnBitfield9  |-> << >>,
                                 purgeRejectedReturnBitfield10 |-> << >>,
                                 purgeRejectedReturnBitfield11 |-> << >>,
                                 purgeRejectedReturnBitfield12 |-> << >>,
                                 purgeRejectedReturnBitfield13 |-> << >>,
                                 purgeRejectedReturnBitfield14 |-> << >>,
                                 purgeRejectedReturnBitfield15 |-> << >>,
                                 purgeRejectedReturnBitfield16 |-> << >>,
                                 purgeRejectedReturnBitfield17 |-> << >>,
                                 purgeRejectedReturnBitfield18 |-> << >>,
                                 purgeRejectedReturnBitfield19 |-> << >>,
                                 massCancelId                  |-> << >> ])

(* Purge Rejected Message at zero, then each field in turn at the values it is checked at *)
CheckedPurgeRejectedMessage ==
    { ZeroPurgeRejectedMessage }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.transactionTime = one]) : one \in Sample(8) }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.purgeRejectReason = one]) : one \in Sample(1) }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.text = one]) : one \in Sample(60) }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.reserved1 = one]) : one \in Sample(1) }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.numberOfReturnBitfields = one]) : one \in {0, 1, 255} }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.numberOfReturnBitfields = 1, !.purgeRejectedReturnBitfield1 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.numberOfReturnBitfields = 2, !.purgeRejectedReturnBitfield2 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.numberOfReturnBitfields = 3, !.purgeRejectedReturnBitfield3 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.numberOfReturnBitfields = 4, !.purgeRejectedReturnBitfield4 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.numberOfReturnBitfields = 5, !.purgeRejectedReturnBitfield5 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.numberOfReturnBitfields = 6, !.purgeRejectedReturnBitfield6 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.numberOfReturnBitfields = 7, !.purgeRejectedReturnBitfield7 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.numberOfReturnBitfields = 8, !.purgeRejectedReturnBitfield8 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.numberOfReturnBitfields = 9, !.purgeRejectedReturnBitfield9 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.numberOfReturnBitfields = 10, !.purgeRejectedReturnBitfield10 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.numberOfReturnBitfields = 11, !.purgeRejectedReturnBitfield11 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.numberOfReturnBitfields = 12, !.purgeRejectedReturnBitfield12 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.numberOfReturnBitfields = 13, !.purgeRejectedReturnBitfield13 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.numberOfReturnBitfields = 14, !.purgeRejectedReturnBitfield14 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.numberOfReturnBitfields = 15, !.purgeRejectedReturnBitfield15 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.numberOfReturnBitfields = 16, !.purgeRejectedReturnBitfield16 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.numberOfReturnBitfields = 17, !.purgeRejectedReturnBitfield17 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.numberOfReturnBitfields = 18, !.purgeRejectedReturnBitfield18 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.numberOfReturnBitfields = 19, !.purgeRejectedReturnBitfield19 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettlePurgeRejectedMessage([ZeroPurgeRejectedMessage EXCEPT !.numberOfReturnBitfields = 15, !.purgeRejectedReturnBitfield15 = <<8>>, !.massCancelId = one]) : one \in { <<held>> : held \in Sample(20) } }

(***************************************************************************)
(* Reset Risk Acknowledgment Message: 17 bytes                             *)
(***************************************************************************)

ResetRiskAcknowledgmentMessage ==
    [ riskStatusId    : Sample(16),
      riskResetResult : Sample(1) ]

EncodeResetRiskAcknowledgmentMessage(message) ==
    message.riskStatusId
        \o message.riskResetResult

DecodeResetRiskAcknowledgmentMessage(bytes) ==
    LET riskStatusId == ReadBytes(bytes, 16) IN IF ~riskStatusId.ok THEN Fail ELSE
    LET riskResetResult == ReadBytes(riskStatusId.rest, 1) IN IF ~riskResetResult.ok THEN Fail ELSE
    Ok([ riskStatusId    |-> riskStatusId.value,
         riskResetResult |-> riskResetResult.value ], riskResetResult.rest)

ZeroResetRiskAcknowledgmentMessage ==
    [ riskStatusId    |-> [i \in 1 .. 16 |-> 0],
      riskResetResult |-> [i \in 1 .. 1 |-> 0] ]

(* Reset Risk Acknowledgment Message at zero, then each field in turn at the values it is checked at *)
CheckedResetRiskAcknowledgmentMessage ==
    { ZeroResetRiskAcknowledgmentMessage }
        \cup { [ZeroResetRiskAcknowledgmentMessage EXCEPT !.riskStatusId = one] : one \in Sample(16) }
        \cup { [ZeroResetRiskAcknowledgmentMessage EXCEPT !.riskResetResult = one] : one \in Sample(1) }

(***************************************************************************)
(* Mass Cancel Acknowledgment Message: 33 bytes                            *)
(***************************************************************************)

MassCancelAcknowledgmentMessage ==
    [ transactionTime     : Sample(8),
      massCancelId        : Sample(20),
      cancelledOrderCount : Sample(4),
      reserved1           : Sample(1) ]

EncodeMassCancelAcknowledgmentMessage(message) ==
    message.transactionTime
        \o message.massCancelId
        \o message.cancelledOrderCount
        \o message.reserved1

DecodeMassCancelAcknowledgmentMessage(bytes) ==
    LET transactionTime == ReadBytes(bytes, 8) IN IF ~transactionTime.ok THEN Fail ELSE
    LET massCancelId == ReadBytes(transactionTime.rest, 20) IN IF ~massCancelId.ok THEN Fail ELSE
    LET cancelledOrderCount == ReadBytes(massCancelId.rest, 4) IN IF ~cancelledOrderCount.ok THEN Fail ELSE
    LET reserved1 == ReadBytes(cancelledOrderCount.rest, 1) IN IF ~reserved1.ok THEN Fail ELSE
    Ok([ transactionTime     |-> transactionTime.value,
         massCancelId        |-> massCancelId.value,
         cancelledOrderCount |-> cancelledOrderCount.value,
         reserved1           |-> reserved1.value ], reserved1.rest)

ZeroMassCancelAcknowledgmentMessage ==
    [ transactionTime     |-> [i \in 1 .. 8 |-> 0],
      massCancelId        |-> [i \in 1 .. 20 |-> 0],
      cancelledOrderCount |-> [i \in 1 .. 4 |-> 0],
      reserved1           |-> [i \in 1 .. 1 |-> 0] ]

(* Mass Cancel Acknowledgment Message at zero, then each field in turn at the values it is checked at *)
CheckedMassCancelAcknowledgmentMessage ==
    { ZeroMassCancelAcknowledgmentMessage }
        \cup { [ZeroMassCancelAcknowledgmentMessage EXCEPT !.transactionTime = one] : one \in Sample(8) }
        \cup { [ZeroMassCancelAcknowledgmentMessage EXCEPT !.massCancelId = one] : one \in Sample(20) }
        \cup { [ZeroMassCancelAcknowledgmentMessage EXCEPT !.cancelledOrderCount = one] : one \in Sample(4) }
        \cup { [ZeroMassCancelAcknowledgmentMessage EXCEPT !.reserved1 = one] : one \in Sample(1) }

(***************************************************************************)
(* Complex Leg: 21 bytes                                                   *)
(***************************************************************************)

ComplexLeg2 ==
    [ legSymbol   : Sample(8),
      legPrice    : Sample(8),
      legRatioQty : Sample(4),
      legSide     : Sample(1) ]

EncodeComplexLeg2(message) ==
    message.legSymbol
        \o message.legPrice
        \o message.legRatioQty
        \o message.legSide

DecodeComplexLeg2(bytes) ==
    LET legSymbol == ReadBytes(bytes, 8) IN IF ~legSymbol.ok THEN Fail ELSE
    LET legPrice == ReadBytes(legSymbol.rest, 8) IN IF ~legPrice.ok THEN Fail ELSE
    LET legRatioQty == ReadBytes(legPrice.rest, 4) IN IF ~legRatioQty.ok THEN Fail ELSE
    LET legSide == ReadBytes(legRatioQty.rest, 1) IN IF ~legSide.ok THEN Fail ELSE
    Ok([ legSymbol   |-> legSymbol.value,
         legPrice    |-> legPrice.value,
         legRatioQty |-> legRatioQty.value,
         legSide     |-> legSide.value ], legSide.rest)

ZeroComplexLeg2 ==
    [ legSymbol   |-> [i \in 1 .. 8 |-> 0],
      legPrice    |-> [i \in 1 .. 8 |-> 0],
      legRatioQty |-> [i \in 1 .. 4 |-> 0],
      legSide     |-> [i \in 1 .. 1 |-> 0] ]

(* Complex Leg at zero, then each field in turn at the values it is checked at *)
CheckedComplexLeg2 ==
    { ZeroComplexLeg2 }
        \cup { [ZeroComplexLeg2 EXCEPT !.legSymbol = one] : one \in Sample(8) }
        \cup { [ZeroComplexLeg2 EXCEPT !.legPrice = one] : one \in Sample(8) }
        \cup { [ZeroComplexLeg2 EXCEPT !.legRatioQty = one] : one \in Sample(4) }
        \cup { [ZeroComplexLeg2 EXCEPT !.legSide = one] : one \in Sample(1) }

(* A run of Complex Leg, written one after another *)
RECURSIVE EncodeComplexLeg2List(_)
EncodeComplexLeg2List(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeComplexLeg2(Head(messages)) \o EncodeComplexLeg2List(Tail(messages))

(* As many Complex Leg as the field that counts them says *)
RECURSIVE ReadComplexLeg2List(_, _)
ReadComplexLeg2List(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeComplexLeg2(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadComplexLeg2List(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Complex Leg of each kind, for the lists that carry them *)
OneComplexLeg2 == { ZeroComplexLeg2 }

(***************************************************************************)
(* Complex Instrument Accepted Message                                     *)
(***************************************************************************)

ComplexInstrumentAcceptedMessage ==
    [ transactionTime                           : Sample(8),
      clOrdId                                   : Sample(20),
      symbolLong                                : Sample(8),
      revisedLegs                               : Sample(1),
      noOfSecurities                            : Sample(4),
      reserved1                                 : Sample(1),
      numberOfReturnBitfields                   : 0 .. 255,
      complexInstrumentAcceptedReturnBitfield1  : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentAcceptedReturnBitfield2  : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentAcceptedReturnBitfield3  : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentAcceptedReturnBitfield4  : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentAcceptedReturnBitfield5  : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentAcceptedReturnBitfield6  : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentAcceptedReturnBitfield7  : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentAcceptedReturnBitfield8  : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentAcceptedReturnBitfield9  : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentAcceptedReturnBitfield10 : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentAcceptedReturnBitfield11 : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentAcceptedReturnBitfield12 : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentAcceptedReturnBitfield13 : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentAcceptedReturnBitfield14 : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentAcceptedReturnBitfield15 : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentAcceptedReturnBitfield16 : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentAcceptedReturnBitfield17 : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentAcceptedReturnBitfield18 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      complexInstrumentAcceptedReturnBitfield19 : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexLeg                                : SampleLists(OneComplexLeg2),
      legPrice                                  : { << >> } \cup { <<held>> : held \in Sample(8) } ]

EncodeComplexInstrumentAcceptedMessage(message) ==
    message.transactionTime
        \o message.clOrdId
        \o message.symbolLong
        \o message.revisedLegs
        \o message.noOfSecurities
        \o message.reserved1
        \o EncodeUIntBE(message.numberOfReturnBitfields, 1)
        \o (IF message.complexInstrumentAcceptedReturnBitfield1 = << >> THEN << >> ELSE message.complexInstrumentAcceptedReturnBitfield1[1])
        \o (IF message.complexInstrumentAcceptedReturnBitfield2 = << >> THEN << >> ELSE message.complexInstrumentAcceptedReturnBitfield2[1])
        \o (IF message.complexInstrumentAcceptedReturnBitfield3 = << >> THEN << >> ELSE message.complexInstrumentAcceptedReturnBitfield3[1])
        \o (IF message.complexInstrumentAcceptedReturnBitfield4 = << >> THEN << >> ELSE message.complexInstrumentAcceptedReturnBitfield4[1])
        \o (IF message.complexInstrumentAcceptedReturnBitfield5 = << >> THEN << >> ELSE message.complexInstrumentAcceptedReturnBitfield5[1])
        \o (IF message.complexInstrumentAcceptedReturnBitfield6 = << >> THEN << >> ELSE message.complexInstrumentAcceptedReturnBitfield6[1])
        \o (IF message.complexInstrumentAcceptedReturnBitfield7 = << >> THEN << >> ELSE message.complexInstrumentAcceptedReturnBitfield7[1])
        \o (IF message.complexInstrumentAcceptedReturnBitfield8 = << >> THEN << >> ELSE message.complexInstrumentAcceptedReturnBitfield8[1])
        \o (IF message.complexInstrumentAcceptedReturnBitfield9 = << >> THEN << >> ELSE message.complexInstrumentAcceptedReturnBitfield9[1])
        \o (IF message.complexInstrumentAcceptedReturnBitfield10 = << >> THEN << >> ELSE message.complexInstrumentAcceptedReturnBitfield10[1])
        \o (IF message.complexInstrumentAcceptedReturnBitfield11 = << >> THEN << >> ELSE message.complexInstrumentAcceptedReturnBitfield11[1])
        \o (IF message.complexInstrumentAcceptedReturnBitfield12 = << >> THEN << >> ELSE message.complexInstrumentAcceptedReturnBitfield12[1])
        \o (IF message.complexInstrumentAcceptedReturnBitfield13 = << >> THEN << >> ELSE message.complexInstrumentAcceptedReturnBitfield13[1])
        \o (IF message.complexInstrumentAcceptedReturnBitfield14 = << >> THEN << >> ELSE message.complexInstrumentAcceptedReturnBitfield14[1])
        \o (IF message.complexInstrumentAcceptedReturnBitfield15 = << >> THEN << >> ELSE message.complexInstrumentAcceptedReturnBitfield15[1])
        \o (IF message.complexInstrumentAcceptedReturnBitfield16 = << >> THEN << >> ELSE message.complexInstrumentAcceptedReturnBitfield16[1])
        \o (IF message.complexInstrumentAcceptedReturnBitfield17 = << >> THEN << >> ELSE message.complexInstrumentAcceptedReturnBitfield17[1])
        \o (IF message.complexInstrumentAcceptedReturnBitfield18 = << >> THEN << >> ELSE EncodeUIntLE(message.complexInstrumentAcceptedReturnBitfield18[1], 1))
        \o (IF message.complexInstrumentAcceptedReturnBitfield19 = << >> THEN << >> ELSE message.complexInstrumentAcceptedReturnBitfield19[1])
        \o EncodeUIntBE(Len(message.complexLeg), 1)
        \o EncodeComplexLeg2List(message.complexLeg)
        \o (IF message.legPrice = << >> THEN << >> ELSE message.legPrice[1])

DecodeComplexInstrumentAcceptedMessage(bytes) ==
    LET transactionTime == ReadBytes(bytes, 8) IN IF ~transactionTime.ok THEN Fail ELSE
    LET clOrdId == ReadBytes(transactionTime.rest, 20) IN IF ~clOrdId.ok THEN Fail ELSE
    LET symbolLong == ReadBytes(clOrdId.rest, 8) IN IF ~symbolLong.ok THEN Fail ELSE
    LET revisedLegs == ReadBytes(symbolLong.rest, 1) IN IF ~revisedLegs.ok THEN Fail ELSE
    LET noOfSecurities == ReadBytes(revisedLegs.rest, 4) IN IF ~noOfSecurities.ok THEN Fail ELSE
    LET reserved1 == ReadBytes(noOfSecurities.rest, 1) IN IF ~reserved1.ok THEN Fail ELSE
    LET numberOfReturnBitfields == ReadUIntBE(reserved1.rest, 1) IN IF ~numberOfReturnBitfields.ok THEN Fail ELSE
    LET complexInstrumentAcceptedReturnBitfield1 == ReadWhen(numberOfReturnBitfields.value >= 1, ReadBytes(numberOfReturnBitfields.rest, 1), numberOfReturnBitfields.rest) IN IF ~complexInstrumentAcceptedReturnBitfield1.ok THEN Fail ELSE
    LET complexInstrumentAcceptedReturnBitfield2 == ReadWhen(numberOfReturnBitfields.value >= 2, ReadBytes(complexInstrumentAcceptedReturnBitfield1.rest, 1), complexInstrumentAcceptedReturnBitfield1.rest) IN IF ~complexInstrumentAcceptedReturnBitfield2.ok THEN Fail ELSE
    LET complexInstrumentAcceptedReturnBitfield3 == ReadWhen(numberOfReturnBitfields.value >= 3, ReadBytes(complexInstrumentAcceptedReturnBitfield2.rest, 1), complexInstrumentAcceptedReturnBitfield2.rest) IN IF ~complexInstrumentAcceptedReturnBitfield3.ok THEN Fail ELSE
    LET complexInstrumentAcceptedReturnBitfield4 == ReadWhen(numberOfReturnBitfields.value >= 4, ReadBytes(complexInstrumentAcceptedReturnBitfield3.rest, 1), complexInstrumentAcceptedReturnBitfield3.rest) IN IF ~complexInstrumentAcceptedReturnBitfield4.ok THEN Fail ELSE
    LET complexInstrumentAcceptedReturnBitfield5 == ReadWhen(numberOfReturnBitfields.value >= 5, ReadBytes(complexInstrumentAcceptedReturnBitfield4.rest, 1), complexInstrumentAcceptedReturnBitfield4.rest) IN IF ~complexInstrumentAcceptedReturnBitfield5.ok THEN Fail ELSE
    LET complexInstrumentAcceptedReturnBitfield6 == ReadWhen(numberOfReturnBitfields.value >= 6, ReadBytes(complexInstrumentAcceptedReturnBitfield5.rest, 1), complexInstrumentAcceptedReturnBitfield5.rest) IN IF ~complexInstrumentAcceptedReturnBitfield6.ok THEN Fail ELSE
    LET complexInstrumentAcceptedReturnBitfield7 == ReadWhen(numberOfReturnBitfields.value >= 7, ReadBytes(complexInstrumentAcceptedReturnBitfield6.rest, 1), complexInstrumentAcceptedReturnBitfield6.rest) IN IF ~complexInstrumentAcceptedReturnBitfield7.ok THEN Fail ELSE
    LET complexInstrumentAcceptedReturnBitfield8 == ReadWhen(numberOfReturnBitfields.value >= 8, ReadBytes(complexInstrumentAcceptedReturnBitfield7.rest, 1), complexInstrumentAcceptedReturnBitfield7.rest) IN IF ~complexInstrumentAcceptedReturnBitfield8.ok THEN Fail ELSE
    LET complexInstrumentAcceptedReturnBitfield9 == ReadWhen(numberOfReturnBitfields.value >= 9, ReadBytes(complexInstrumentAcceptedReturnBitfield8.rest, 1), complexInstrumentAcceptedReturnBitfield8.rest) IN IF ~complexInstrumentAcceptedReturnBitfield9.ok THEN Fail ELSE
    LET complexInstrumentAcceptedReturnBitfield10 == ReadWhen(numberOfReturnBitfields.value >= 10, ReadBytes(complexInstrumentAcceptedReturnBitfield9.rest, 1), complexInstrumentAcceptedReturnBitfield9.rest) IN IF ~complexInstrumentAcceptedReturnBitfield10.ok THEN Fail ELSE
    LET complexInstrumentAcceptedReturnBitfield11 == ReadWhen(numberOfReturnBitfields.value >= 11, ReadBytes(complexInstrumentAcceptedReturnBitfield10.rest, 1), complexInstrumentAcceptedReturnBitfield10.rest) IN IF ~complexInstrumentAcceptedReturnBitfield11.ok THEN Fail ELSE
    LET complexInstrumentAcceptedReturnBitfield12 == ReadWhen(numberOfReturnBitfields.value >= 12, ReadBytes(complexInstrumentAcceptedReturnBitfield11.rest, 1), complexInstrumentAcceptedReturnBitfield11.rest) IN IF ~complexInstrumentAcceptedReturnBitfield12.ok THEN Fail ELSE
    LET complexInstrumentAcceptedReturnBitfield13 == ReadWhen(numberOfReturnBitfields.value >= 13, ReadBytes(complexInstrumentAcceptedReturnBitfield12.rest, 1), complexInstrumentAcceptedReturnBitfield12.rest) IN IF ~complexInstrumentAcceptedReturnBitfield13.ok THEN Fail ELSE
    LET complexInstrumentAcceptedReturnBitfield14 == ReadWhen(numberOfReturnBitfields.value >= 14, ReadBytes(complexInstrumentAcceptedReturnBitfield13.rest, 1), complexInstrumentAcceptedReturnBitfield13.rest) IN IF ~complexInstrumentAcceptedReturnBitfield14.ok THEN Fail ELSE
    LET complexInstrumentAcceptedReturnBitfield15 == ReadWhen(numberOfReturnBitfields.value >= 15, ReadBytes(complexInstrumentAcceptedReturnBitfield14.rest, 1), complexInstrumentAcceptedReturnBitfield14.rest) IN IF ~complexInstrumentAcceptedReturnBitfield15.ok THEN Fail ELSE
    LET complexInstrumentAcceptedReturnBitfield16 == ReadWhen(numberOfReturnBitfields.value >= 16, ReadBytes(complexInstrumentAcceptedReturnBitfield15.rest, 1), complexInstrumentAcceptedReturnBitfield15.rest) IN IF ~complexInstrumentAcceptedReturnBitfield16.ok THEN Fail ELSE
    LET complexInstrumentAcceptedReturnBitfield17 == ReadWhen(numberOfReturnBitfields.value >= 17, ReadBytes(complexInstrumentAcceptedReturnBitfield16.rest, 1), complexInstrumentAcceptedReturnBitfield16.rest) IN IF ~complexInstrumentAcceptedReturnBitfield17.ok THEN Fail ELSE
    LET complexInstrumentAcceptedReturnBitfield18 == ReadWhen(numberOfReturnBitfields.value >= 18, ReadUIntLE(complexInstrumentAcceptedReturnBitfield17.rest, 1), complexInstrumentAcceptedReturnBitfield17.rest) IN IF ~complexInstrumentAcceptedReturnBitfield18.ok THEN Fail ELSE
    LET complexInstrumentAcceptedReturnBitfield19 == ReadWhen(numberOfReturnBitfields.value >= 19, ReadBytes(complexInstrumentAcceptedReturnBitfield18.rest, 1), complexInstrumentAcceptedReturnBitfield18.rest) IN IF ~complexInstrumentAcceptedReturnBitfield19.ok THEN Fail ELSE
    LET noLegs == ReadUIntBE(complexInstrumentAcceptedReturnBitfield19.rest, 1) IN IF ~noLegs.ok THEN Fail ELSE
    LET complexLeg == ReadComplexLeg2List(noLegs.rest, noLegs.value) IN IF ~complexLeg.ok THEN Fail ELSE
    LET legPrice == ReadWhen(numberOfReturnBitfields.value >= 18 /\ (complexInstrumentAcceptedReturnBitfield18.value # << >> /\ (complexInstrumentAcceptedReturnBitfield18.value[1] \div 16) % 2 > 0), ReadBytes(complexLeg.rest, 8), complexLeg.rest) IN IF ~legPrice.ok THEN Fail ELSE
    Ok([ transactionTime                           |-> transactionTime.value,
         clOrdId                                   |-> clOrdId.value,
         symbolLong                                |-> symbolLong.value,
         revisedLegs                               |-> revisedLegs.value,
         noOfSecurities                            |-> noOfSecurities.value,
         reserved1                                 |-> reserved1.value,
         numberOfReturnBitfields                   |-> numberOfReturnBitfields.value,
         complexInstrumentAcceptedReturnBitfield1  |-> complexInstrumentAcceptedReturnBitfield1.value,
         complexInstrumentAcceptedReturnBitfield2  |-> complexInstrumentAcceptedReturnBitfield2.value,
         complexInstrumentAcceptedReturnBitfield3  |-> complexInstrumentAcceptedReturnBitfield3.value,
         complexInstrumentAcceptedReturnBitfield4  |-> complexInstrumentAcceptedReturnBitfield4.value,
         complexInstrumentAcceptedReturnBitfield5  |-> complexInstrumentAcceptedReturnBitfield5.value,
         complexInstrumentAcceptedReturnBitfield6  |-> complexInstrumentAcceptedReturnBitfield6.value,
         complexInstrumentAcceptedReturnBitfield7  |-> complexInstrumentAcceptedReturnBitfield7.value,
         complexInstrumentAcceptedReturnBitfield8  |-> complexInstrumentAcceptedReturnBitfield8.value,
         complexInstrumentAcceptedReturnBitfield9  |-> complexInstrumentAcceptedReturnBitfield9.value,
         complexInstrumentAcceptedReturnBitfield10 |-> complexInstrumentAcceptedReturnBitfield10.value,
         complexInstrumentAcceptedReturnBitfield11 |-> complexInstrumentAcceptedReturnBitfield11.value,
         complexInstrumentAcceptedReturnBitfield12 |-> complexInstrumentAcceptedReturnBitfield12.value,
         complexInstrumentAcceptedReturnBitfield13 |-> complexInstrumentAcceptedReturnBitfield13.value,
         complexInstrumentAcceptedReturnBitfield14 |-> complexInstrumentAcceptedReturnBitfield14.value,
         complexInstrumentAcceptedReturnBitfield15 |-> complexInstrumentAcceptedReturnBitfield15.value,
         complexInstrumentAcceptedReturnBitfield16 |-> complexInstrumentAcceptedReturnBitfield16.value,
         complexInstrumentAcceptedReturnBitfield17 |-> complexInstrumentAcceptedReturnBitfield17.value,
         complexInstrumentAcceptedReturnBitfield18 |-> complexInstrumentAcceptedReturnBitfield18.value,
         complexInstrumentAcceptedReturnBitfield19 |-> complexInstrumentAcceptedReturnBitfield19.value,
         complexLeg                                |-> complexLeg.value,
         legPrice                                  |-> legPrice.value ], legPrice.rest)

(* Complex Instrument Accepted Message with each field marked present by fields before it there exactly where they say *)
SettleComplexInstrumentAcceptedMessage(message) ==
    LET settled1 == [message EXCEPT !.complexInstrumentAcceptedReturnBitfield1 = IF message.numberOfReturnBitfields >= 1 THEN (IF message.complexInstrumentAcceptedReturnBitfield1 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE message.complexInstrumentAcceptedReturnBitfield1) ELSE << >>]
        settled2 == [settled1 EXCEPT !.complexInstrumentAcceptedReturnBitfield2 = IF settled1.numberOfReturnBitfields >= 2 THEN (IF settled1.complexInstrumentAcceptedReturnBitfield2 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled1.complexInstrumentAcceptedReturnBitfield2) ELSE << >>]
        settled3 == [settled2 EXCEPT !.complexInstrumentAcceptedReturnBitfield3 = IF settled2.numberOfReturnBitfields >= 3 THEN (IF settled2.complexInstrumentAcceptedReturnBitfield3 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled2.complexInstrumentAcceptedReturnBitfield3) ELSE << >>]
        settled4 == [settled3 EXCEPT !.complexInstrumentAcceptedReturnBitfield4 = IF settled3.numberOfReturnBitfields >= 4 THEN (IF settled3.complexInstrumentAcceptedReturnBitfield4 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled3.complexInstrumentAcceptedReturnBitfield4) ELSE << >>]
        settled5 == [settled4 EXCEPT !.complexInstrumentAcceptedReturnBitfield5 = IF settled4.numberOfReturnBitfields >= 5 THEN (IF settled4.complexInstrumentAcceptedReturnBitfield5 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled4.complexInstrumentAcceptedReturnBitfield5) ELSE << >>]
        settled6 == [settled5 EXCEPT !.complexInstrumentAcceptedReturnBitfield6 = IF settled5.numberOfReturnBitfields >= 6 THEN (IF settled5.complexInstrumentAcceptedReturnBitfield6 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled5.complexInstrumentAcceptedReturnBitfield6) ELSE << >>]
        settled7 == [settled6 EXCEPT !.complexInstrumentAcceptedReturnBitfield7 = IF settled6.numberOfReturnBitfields >= 7 THEN (IF settled6.complexInstrumentAcceptedReturnBitfield7 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled6.complexInstrumentAcceptedReturnBitfield7) ELSE << >>]
        settled8 == [settled7 EXCEPT !.complexInstrumentAcceptedReturnBitfield8 = IF settled7.numberOfReturnBitfields >= 8 THEN (IF settled7.complexInstrumentAcceptedReturnBitfield8 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled7.complexInstrumentAcceptedReturnBitfield8) ELSE << >>]
        settled9 == [settled8 EXCEPT !.complexInstrumentAcceptedReturnBitfield9 = IF settled8.numberOfReturnBitfields >= 9 THEN (IF settled8.complexInstrumentAcceptedReturnBitfield9 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled8.complexInstrumentAcceptedReturnBitfield9) ELSE << >>]
        settled10 == [settled9 EXCEPT !.complexInstrumentAcceptedReturnBitfield10 = IF settled9.numberOfReturnBitfields >= 10 THEN (IF settled9.complexInstrumentAcceptedReturnBitfield10 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled9.complexInstrumentAcceptedReturnBitfield10) ELSE << >>]
        settled11 == [settled10 EXCEPT !.complexInstrumentAcceptedReturnBitfield11 = IF settled10.numberOfReturnBitfields >= 11 THEN (IF settled10.complexInstrumentAcceptedReturnBitfield11 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled10.complexInstrumentAcceptedReturnBitfield11) ELSE << >>]
        settled12 == [settled11 EXCEPT !.complexInstrumentAcceptedReturnBitfield12 = IF settled11.numberOfReturnBitfields >= 12 THEN (IF settled11.complexInstrumentAcceptedReturnBitfield12 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled11.complexInstrumentAcceptedReturnBitfield12) ELSE << >>]
        settled13 == [settled12 EXCEPT !.complexInstrumentAcceptedReturnBitfield13 = IF settled12.numberOfReturnBitfields >= 13 THEN (IF settled12.complexInstrumentAcceptedReturnBitfield13 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled12.complexInstrumentAcceptedReturnBitfield13) ELSE << >>]
        settled14 == [settled13 EXCEPT !.complexInstrumentAcceptedReturnBitfield14 = IF settled13.numberOfReturnBitfields >= 14 THEN (IF settled13.complexInstrumentAcceptedReturnBitfield14 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled13.complexInstrumentAcceptedReturnBitfield14) ELSE << >>]
        settled15 == [settled14 EXCEPT !.complexInstrumentAcceptedReturnBitfield15 = IF settled14.numberOfReturnBitfields >= 15 THEN (IF settled14.complexInstrumentAcceptedReturnBitfield15 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled14.complexInstrumentAcceptedReturnBitfield15) ELSE << >>]
        settled16 == [settled15 EXCEPT !.complexInstrumentAcceptedReturnBitfield16 = IF settled15.numberOfReturnBitfields >= 16 THEN (IF settled15.complexInstrumentAcceptedReturnBitfield16 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled15.complexInstrumentAcceptedReturnBitfield16) ELSE << >>]
        settled17 == [settled16 EXCEPT !.complexInstrumentAcceptedReturnBitfield17 = IF settled16.numberOfReturnBitfields >= 17 THEN (IF settled16.complexInstrumentAcceptedReturnBitfield17 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled16.complexInstrumentAcceptedReturnBitfield17) ELSE << >>]
        settled18 == [settled17 EXCEPT !.complexInstrumentAcceptedReturnBitfield18 = IF settled17.numberOfReturnBitfields >= 18 THEN (IF settled17.complexInstrumentAcceptedReturnBitfield18 = << >> THEN <<0>> ELSE settled17.complexInstrumentAcceptedReturnBitfield18) ELSE << >>]
        settled19 == [settled18 EXCEPT !.complexInstrumentAcceptedReturnBitfield19 = IF settled18.numberOfReturnBitfields >= 19 THEN (IF settled18.complexInstrumentAcceptedReturnBitfield19 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled18.complexInstrumentAcceptedReturnBitfield19) ELSE << >>]
        settled20 == [settled19 EXCEPT !.legPrice = IF settled19.numberOfReturnBitfields >= 18 /\ (settled19.complexInstrumentAcceptedReturnBitfield18 # << >> /\ (settled19.complexInstrumentAcceptedReturnBitfield18[1] \div 16) % 2 > 0) THEN (IF settled19.legPrice = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled19.legPrice) ELSE << >>]
    IN  settled20

ZeroComplexInstrumentAcceptedMessage ==
    SettleComplexInstrumentAcceptedMessage([ transactionTime                           |-> [i \in 1 .. 8 |-> 0],
                                             clOrdId                                   |-> [i \in 1 .. 20 |-> 0],
                                             symbolLong                                |-> [i \in 1 .. 8 |-> 0],
                                             revisedLegs                               |-> [i \in 1 .. 1 |-> 0],
                                             noOfSecurities                            |-> [i \in 1 .. 4 |-> 0],
                                             reserved1                                 |-> [i \in 1 .. 1 |-> 0],
                                             numberOfReturnBitfields                   |-> 0,
                                             complexInstrumentAcceptedReturnBitfield1  |-> << >>,
                                             complexInstrumentAcceptedReturnBitfield2  |-> << >>,
                                             complexInstrumentAcceptedReturnBitfield3  |-> << >>,
                                             complexInstrumentAcceptedReturnBitfield4  |-> << >>,
                                             complexInstrumentAcceptedReturnBitfield5  |-> << >>,
                                             complexInstrumentAcceptedReturnBitfield6  |-> << >>,
                                             complexInstrumentAcceptedReturnBitfield7  |-> << >>,
                                             complexInstrumentAcceptedReturnBitfield8  |-> << >>,
                                             complexInstrumentAcceptedReturnBitfield9  |-> << >>,
                                             complexInstrumentAcceptedReturnBitfield10 |-> << >>,
                                             complexInstrumentAcceptedReturnBitfield11 |-> << >>,
                                             complexInstrumentAcceptedReturnBitfield12 |-> << >>,
                                             complexInstrumentAcceptedReturnBitfield13 |-> << >>,
                                             complexInstrumentAcceptedReturnBitfield14 |-> << >>,
                                             complexInstrumentAcceptedReturnBitfield15 |-> << >>,
                                             complexInstrumentAcceptedReturnBitfield16 |-> << >>,
                                             complexInstrumentAcceptedReturnBitfield17 |-> << >>,
                                             complexInstrumentAcceptedReturnBitfield18 |-> << >>,
                                             complexInstrumentAcceptedReturnBitfield19 |-> << >>,
                                             complexLeg                                |-> << >>,
                                             legPrice                                  |-> << >> ])

(* Complex Instrument Accepted Message at zero, then each field in turn at the values it is checked at *)
CheckedComplexInstrumentAcceptedMessage ==
    { ZeroComplexInstrumentAcceptedMessage }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.transactionTime = one]) : one \in Sample(8) }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.clOrdId = one]) : one \in Sample(20) }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.symbolLong = one]) : one \in Sample(8) }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.revisedLegs = one]) : one \in Sample(1) }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.noOfSecurities = one]) : one \in Sample(4) }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.reserved1 = one]) : one \in Sample(1) }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.numberOfReturnBitfields = one]) : one \in {0, 1, 255} }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.numberOfReturnBitfields = 1, !.complexInstrumentAcceptedReturnBitfield1 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.numberOfReturnBitfields = 2, !.complexInstrumentAcceptedReturnBitfield2 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.numberOfReturnBitfields = 3, !.complexInstrumentAcceptedReturnBitfield3 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.numberOfReturnBitfields = 4, !.complexInstrumentAcceptedReturnBitfield4 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.numberOfReturnBitfields = 5, !.complexInstrumentAcceptedReturnBitfield5 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.numberOfReturnBitfields = 6, !.complexInstrumentAcceptedReturnBitfield6 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.numberOfReturnBitfields = 7, !.complexInstrumentAcceptedReturnBitfield7 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.numberOfReturnBitfields = 8, !.complexInstrumentAcceptedReturnBitfield8 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.numberOfReturnBitfields = 9, !.complexInstrumentAcceptedReturnBitfield9 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.numberOfReturnBitfields = 10, !.complexInstrumentAcceptedReturnBitfield10 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.numberOfReturnBitfields = 11, !.complexInstrumentAcceptedReturnBitfield11 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.numberOfReturnBitfields = 12, !.complexInstrumentAcceptedReturnBitfield12 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.numberOfReturnBitfields = 13, !.complexInstrumentAcceptedReturnBitfield13 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.numberOfReturnBitfields = 14, !.complexInstrumentAcceptedReturnBitfield14 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.numberOfReturnBitfields = 15, !.complexInstrumentAcceptedReturnBitfield15 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.numberOfReturnBitfields = 16, !.complexInstrumentAcceptedReturnBitfield16 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.numberOfReturnBitfields = 17, !.complexInstrumentAcceptedReturnBitfield17 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.numberOfReturnBitfields = 18, !.complexInstrumentAcceptedReturnBitfield18 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.numberOfReturnBitfields = 19, !.complexInstrumentAcceptedReturnBitfield19 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.complexLeg = one]) : one \in SampleLists(OneComplexLeg2) }
        \cup { SettleComplexInstrumentAcceptedMessage([ZeroComplexInstrumentAcceptedMessage EXCEPT !.numberOfReturnBitfields = 18, !.complexInstrumentAcceptedReturnBitfield18 = <<16>>, !.legPrice = one]) : one \in { <<held>> : held \in Sample(8) } }

(***************************************************************************)
(* Complex Instrument Rejected Message                                     *)
(***************************************************************************)

ComplexInstrumentRejectedMessage ==
    [ transactionTime                           : Sample(8),
      clOrdId                                   : Sample(20),
      orderRejectReason                         : Sample(1),
      text                                      : Sample(60),
      noOfSecurities                            : Sample(4),
      reserved1                                 : Sample(1),
      numberOfReturnBitfields                   : 0 .. 255,
      complexInstrumentRejectedReturnBitfield1  : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentRejectedReturnBitfield2  : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentRejectedReturnBitfield3  : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentRejectedReturnBitfield4  : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentRejectedReturnBitfield5  : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentRejectedReturnBitfield6  : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentRejectedReturnBitfield7  : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentRejectedReturnBitfield8  : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentRejectedReturnBitfield9  : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentRejectedReturnBitfield10 : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentRejectedReturnBitfield11 : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentRejectedReturnBitfield12 : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentRejectedReturnBitfield13 : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentRejectedReturnBitfield14 : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentRejectedReturnBitfield15 : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentRejectedReturnBitfield16 : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentRejectedReturnBitfield17 : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentRejectedReturnBitfield18 : { << >> } \cup { <<held>> : held \in Sample(1) },
      complexInstrumentRejectedReturnBitfield19 : { << >> } \cup { <<held>> : held \in Sample(1) } ]

EncodeComplexInstrumentRejectedMessage(message) ==
    message.transactionTime
        \o message.clOrdId
        \o message.orderRejectReason
        \o message.text
        \o message.noOfSecurities
        \o message.reserved1
        \o EncodeUIntBE(message.numberOfReturnBitfields, 1)
        \o (IF message.complexInstrumentRejectedReturnBitfield1 = << >> THEN << >> ELSE message.complexInstrumentRejectedReturnBitfield1[1])
        \o (IF message.complexInstrumentRejectedReturnBitfield2 = << >> THEN << >> ELSE message.complexInstrumentRejectedReturnBitfield2[1])
        \o (IF message.complexInstrumentRejectedReturnBitfield3 = << >> THEN << >> ELSE message.complexInstrumentRejectedReturnBitfield3[1])
        \o (IF message.complexInstrumentRejectedReturnBitfield4 = << >> THEN << >> ELSE message.complexInstrumentRejectedReturnBitfield4[1])
        \o (IF message.complexInstrumentRejectedReturnBitfield5 = << >> THEN << >> ELSE message.complexInstrumentRejectedReturnBitfield5[1])
        \o (IF message.complexInstrumentRejectedReturnBitfield6 = << >> THEN << >> ELSE message.complexInstrumentRejectedReturnBitfield6[1])
        \o (IF message.complexInstrumentRejectedReturnBitfield7 = << >> THEN << >> ELSE message.complexInstrumentRejectedReturnBitfield7[1])
        \o (IF message.complexInstrumentRejectedReturnBitfield8 = << >> THEN << >> ELSE message.complexInstrumentRejectedReturnBitfield8[1])
        \o (IF message.complexInstrumentRejectedReturnBitfield9 = << >> THEN << >> ELSE message.complexInstrumentRejectedReturnBitfield9[1])
        \o (IF message.complexInstrumentRejectedReturnBitfield10 = << >> THEN << >> ELSE message.complexInstrumentRejectedReturnBitfield10[1])
        \o (IF message.complexInstrumentRejectedReturnBitfield11 = << >> THEN << >> ELSE message.complexInstrumentRejectedReturnBitfield11[1])
        \o (IF message.complexInstrumentRejectedReturnBitfield12 = << >> THEN << >> ELSE message.complexInstrumentRejectedReturnBitfield12[1])
        \o (IF message.complexInstrumentRejectedReturnBitfield13 = << >> THEN << >> ELSE message.complexInstrumentRejectedReturnBitfield13[1])
        \o (IF message.complexInstrumentRejectedReturnBitfield14 = << >> THEN << >> ELSE message.complexInstrumentRejectedReturnBitfield14[1])
        \o (IF message.complexInstrumentRejectedReturnBitfield15 = << >> THEN << >> ELSE message.complexInstrumentRejectedReturnBitfield15[1])
        \o (IF message.complexInstrumentRejectedReturnBitfield16 = << >> THEN << >> ELSE message.complexInstrumentRejectedReturnBitfield16[1])
        \o (IF message.complexInstrumentRejectedReturnBitfield17 = << >> THEN << >> ELSE message.complexInstrumentRejectedReturnBitfield17[1])
        \o (IF message.complexInstrumentRejectedReturnBitfield18 = << >> THEN << >> ELSE message.complexInstrumentRejectedReturnBitfield18[1])
        \o (IF message.complexInstrumentRejectedReturnBitfield19 = << >> THEN << >> ELSE message.complexInstrumentRejectedReturnBitfield19[1])

DecodeComplexInstrumentRejectedMessage(bytes) ==
    LET transactionTime == ReadBytes(bytes, 8) IN IF ~transactionTime.ok THEN Fail ELSE
    LET clOrdId == ReadBytes(transactionTime.rest, 20) IN IF ~clOrdId.ok THEN Fail ELSE
    LET orderRejectReason == ReadBytes(clOrdId.rest, 1) IN IF ~orderRejectReason.ok THEN Fail ELSE
    LET text == ReadBytes(orderRejectReason.rest, 60) IN IF ~text.ok THEN Fail ELSE
    LET noOfSecurities == ReadBytes(text.rest, 4) IN IF ~noOfSecurities.ok THEN Fail ELSE
    LET reserved1 == ReadBytes(noOfSecurities.rest, 1) IN IF ~reserved1.ok THEN Fail ELSE
    LET numberOfReturnBitfields == ReadUIntBE(reserved1.rest, 1) IN IF ~numberOfReturnBitfields.ok THEN Fail ELSE
    LET complexInstrumentRejectedReturnBitfield1 == ReadWhen(numberOfReturnBitfields.value >= 1, ReadBytes(numberOfReturnBitfields.rest, 1), numberOfReturnBitfields.rest) IN IF ~complexInstrumentRejectedReturnBitfield1.ok THEN Fail ELSE
    LET complexInstrumentRejectedReturnBitfield2 == ReadWhen(numberOfReturnBitfields.value >= 2, ReadBytes(complexInstrumentRejectedReturnBitfield1.rest, 1), complexInstrumentRejectedReturnBitfield1.rest) IN IF ~complexInstrumentRejectedReturnBitfield2.ok THEN Fail ELSE
    LET complexInstrumentRejectedReturnBitfield3 == ReadWhen(numberOfReturnBitfields.value >= 3, ReadBytes(complexInstrumentRejectedReturnBitfield2.rest, 1), complexInstrumentRejectedReturnBitfield2.rest) IN IF ~complexInstrumentRejectedReturnBitfield3.ok THEN Fail ELSE
    LET complexInstrumentRejectedReturnBitfield4 == ReadWhen(numberOfReturnBitfields.value >= 4, ReadBytes(complexInstrumentRejectedReturnBitfield3.rest, 1), complexInstrumentRejectedReturnBitfield3.rest) IN IF ~complexInstrumentRejectedReturnBitfield4.ok THEN Fail ELSE
    LET complexInstrumentRejectedReturnBitfield5 == ReadWhen(numberOfReturnBitfields.value >= 5, ReadBytes(complexInstrumentRejectedReturnBitfield4.rest, 1), complexInstrumentRejectedReturnBitfield4.rest) IN IF ~complexInstrumentRejectedReturnBitfield5.ok THEN Fail ELSE
    LET complexInstrumentRejectedReturnBitfield6 == ReadWhen(numberOfReturnBitfields.value >= 6, ReadBytes(complexInstrumentRejectedReturnBitfield5.rest, 1), complexInstrumentRejectedReturnBitfield5.rest) IN IF ~complexInstrumentRejectedReturnBitfield6.ok THEN Fail ELSE
    LET complexInstrumentRejectedReturnBitfield7 == ReadWhen(numberOfReturnBitfields.value >= 7, ReadBytes(complexInstrumentRejectedReturnBitfield6.rest, 1), complexInstrumentRejectedReturnBitfield6.rest) IN IF ~complexInstrumentRejectedReturnBitfield7.ok THEN Fail ELSE
    LET complexInstrumentRejectedReturnBitfield8 == ReadWhen(numberOfReturnBitfields.value >= 8, ReadBytes(complexInstrumentRejectedReturnBitfield7.rest, 1), complexInstrumentRejectedReturnBitfield7.rest) IN IF ~complexInstrumentRejectedReturnBitfield8.ok THEN Fail ELSE
    LET complexInstrumentRejectedReturnBitfield9 == ReadWhen(numberOfReturnBitfields.value >= 9, ReadBytes(complexInstrumentRejectedReturnBitfield8.rest, 1), complexInstrumentRejectedReturnBitfield8.rest) IN IF ~complexInstrumentRejectedReturnBitfield9.ok THEN Fail ELSE
    LET complexInstrumentRejectedReturnBitfield10 == ReadWhen(numberOfReturnBitfields.value >= 10, ReadBytes(complexInstrumentRejectedReturnBitfield9.rest, 1), complexInstrumentRejectedReturnBitfield9.rest) IN IF ~complexInstrumentRejectedReturnBitfield10.ok THEN Fail ELSE
    LET complexInstrumentRejectedReturnBitfield11 == ReadWhen(numberOfReturnBitfields.value >= 11, ReadBytes(complexInstrumentRejectedReturnBitfield10.rest, 1), complexInstrumentRejectedReturnBitfield10.rest) IN IF ~complexInstrumentRejectedReturnBitfield11.ok THEN Fail ELSE
    LET complexInstrumentRejectedReturnBitfield12 == ReadWhen(numberOfReturnBitfields.value >= 12, ReadBytes(complexInstrumentRejectedReturnBitfield11.rest, 1), complexInstrumentRejectedReturnBitfield11.rest) IN IF ~complexInstrumentRejectedReturnBitfield12.ok THEN Fail ELSE
    LET complexInstrumentRejectedReturnBitfield13 == ReadWhen(numberOfReturnBitfields.value >= 13, ReadBytes(complexInstrumentRejectedReturnBitfield12.rest, 1), complexInstrumentRejectedReturnBitfield12.rest) IN IF ~complexInstrumentRejectedReturnBitfield13.ok THEN Fail ELSE
    LET complexInstrumentRejectedReturnBitfield14 == ReadWhen(numberOfReturnBitfields.value >= 14, ReadBytes(complexInstrumentRejectedReturnBitfield13.rest, 1), complexInstrumentRejectedReturnBitfield13.rest) IN IF ~complexInstrumentRejectedReturnBitfield14.ok THEN Fail ELSE
    LET complexInstrumentRejectedReturnBitfield15 == ReadWhen(numberOfReturnBitfields.value >= 15, ReadBytes(complexInstrumentRejectedReturnBitfield14.rest, 1), complexInstrumentRejectedReturnBitfield14.rest) IN IF ~complexInstrumentRejectedReturnBitfield15.ok THEN Fail ELSE
    LET complexInstrumentRejectedReturnBitfield16 == ReadWhen(numberOfReturnBitfields.value >= 16, ReadBytes(complexInstrumentRejectedReturnBitfield15.rest, 1), complexInstrumentRejectedReturnBitfield15.rest) IN IF ~complexInstrumentRejectedReturnBitfield16.ok THEN Fail ELSE
    LET complexInstrumentRejectedReturnBitfield17 == ReadWhen(numberOfReturnBitfields.value >= 17, ReadBytes(complexInstrumentRejectedReturnBitfield16.rest, 1), complexInstrumentRejectedReturnBitfield16.rest) IN IF ~complexInstrumentRejectedReturnBitfield17.ok THEN Fail ELSE
    LET complexInstrumentRejectedReturnBitfield18 == ReadWhen(numberOfReturnBitfields.value >= 18, ReadBytes(complexInstrumentRejectedReturnBitfield17.rest, 1), complexInstrumentRejectedReturnBitfield17.rest) IN IF ~complexInstrumentRejectedReturnBitfield18.ok THEN Fail ELSE
    LET complexInstrumentRejectedReturnBitfield19 == ReadWhen(numberOfReturnBitfields.value >= 19, ReadBytes(complexInstrumentRejectedReturnBitfield18.rest, 1), complexInstrumentRejectedReturnBitfield18.rest) IN IF ~complexInstrumentRejectedReturnBitfield19.ok THEN Fail ELSE
    Ok([ transactionTime                           |-> transactionTime.value,
         clOrdId                                   |-> clOrdId.value,
         orderRejectReason                         |-> orderRejectReason.value,
         text                                      |-> text.value,
         noOfSecurities                            |-> noOfSecurities.value,
         reserved1                                 |-> reserved1.value,
         numberOfReturnBitfields                   |-> numberOfReturnBitfields.value,
         complexInstrumentRejectedReturnBitfield1  |-> complexInstrumentRejectedReturnBitfield1.value,
         complexInstrumentRejectedReturnBitfield2  |-> complexInstrumentRejectedReturnBitfield2.value,
         complexInstrumentRejectedReturnBitfield3  |-> complexInstrumentRejectedReturnBitfield3.value,
         complexInstrumentRejectedReturnBitfield4  |-> complexInstrumentRejectedReturnBitfield4.value,
         complexInstrumentRejectedReturnBitfield5  |-> complexInstrumentRejectedReturnBitfield5.value,
         complexInstrumentRejectedReturnBitfield6  |-> complexInstrumentRejectedReturnBitfield6.value,
         complexInstrumentRejectedReturnBitfield7  |-> complexInstrumentRejectedReturnBitfield7.value,
         complexInstrumentRejectedReturnBitfield8  |-> complexInstrumentRejectedReturnBitfield8.value,
         complexInstrumentRejectedReturnBitfield9  |-> complexInstrumentRejectedReturnBitfield9.value,
         complexInstrumentRejectedReturnBitfield10 |-> complexInstrumentRejectedReturnBitfield10.value,
         complexInstrumentRejectedReturnBitfield11 |-> complexInstrumentRejectedReturnBitfield11.value,
         complexInstrumentRejectedReturnBitfield12 |-> complexInstrumentRejectedReturnBitfield12.value,
         complexInstrumentRejectedReturnBitfield13 |-> complexInstrumentRejectedReturnBitfield13.value,
         complexInstrumentRejectedReturnBitfield14 |-> complexInstrumentRejectedReturnBitfield14.value,
         complexInstrumentRejectedReturnBitfield15 |-> complexInstrumentRejectedReturnBitfield15.value,
         complexInstrumentRejectedReturnBitfield16 |-> complexInstrumentRejectedReturnBitfield16.value,
         complexInstrumentRejectedReturnBitfield17 |-> complexInstrumentRejectedReturnBitfield17.value,
         complexInstrumentRejectedReturnBitfield18 |-> complexInstrumentRejectedReturnBitfield18.value,
         complexInstrumentRejectedReturnBitfield19 |-> complexInstrumentRejectedReturnBitfield19.value ], complexInstrumentRejectedReturnBitfield19.rest)

(* Complex Instrument Rejected Message with each field marked present by fields before it there exactly where they say *)
SettleComplexInstrumentRejectedMessage(message) ==
    LET settled1 == [message EXCEPT !.complexInstrumentRejectedReturnBitfield1 = IF message.numberOfReturnBitfields >= 1 THEN (IF message.complexInstrumentRejectedReturnBitfield1 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE message.complexInstrumentRejectedReturnBitfield1) ELSE << >>]
        settled2 == [settled1 EXCEPT !.complexInstrumentRejectedReturnBitfield2 = IF settled1.numberOfReturnBitfields >= 2 THEN (IF settled1.complexInstrumentRejectedReturnBitfield2 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled1.complexInstrumentRejectedReturnBitfield2) ELSE << >>]
        settled3 == [settled2 EXCEPT !.complexInstrumentRejectedReturnBitfield3 = IF settled2.numberOfReturnBitfields >= 3 THEN (IF settled2.complexInstrumentRejectedReturnBitfield3 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled2.complexInstrumentRejectedReturnBitfield3) ELSE << >>]
        settled4 == [settled3 EXCEPT !.complexInstrumentRejectedReturnBitfield4 = IF settled3.numberOfReturnBitfields >= 4 THEN (IF settled3.complexInstrumentRejectedReturnBitfield4 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled3.complexInstrumentRejectedReturnBitfield4) ELSE << >>]
        settled5 == [settled4 EXCEPT !.complexInstrumentRejectedReturnBitfield5 = IF settled4.numberOfReturnBitfields >= 5 THEN (IF settled4.complexInstrumentRejectedReturnBitfield5 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled4.complexInstrumentRejectedReturnBitfield5) ELSE << >>]
        settled6 == [settled5 EXCEPT !.complexInstrumentRejectedReturnBitfield6 = IF settled5.numberOfReturnBitfields >= 6 THEN (IF settled5.complexInstrumentRejectedReturnBitfield6 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled5.complexInstrumentRejectedReturnBitfield6) ELSE << >>]
        settled7 == [settled6 EXCEPT !.complexInstrumentRejectedReturnBitfield7 = IF settled6.numberOfReturnBitfields >= 7 THEN (IF settled6.complexInstrumentRejectedReturnBitfield7 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled6.complexInstrumentRejectedReturnBitfield7) ELSE << >>]
        settled8 == [settled7 EXCEPT !.complexInstrumentRejectedReturnBitfield8 = IF settled7.numberOfReturnBitfields >= 8 THEN (IF settled7.complexInstrumentRejectedReturnBitfield8 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled7.complexInstrumentRejectedReturnBitfield8) ELSE << >>]
        settled9 == [settled8 EXCEPT !.complexInstrumentRejectedReturnBitfield9 = IF settled8.numberOfReturnBitfields >= 9 THEN (IF settled8.complexInstrumentRejectedReturnBitfield9 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled8.complexInstrumentRejectedReturnBitfield9) ELSE << >>]
        settled10 == [settled9 EXCEPT !.complexInstrumentRejectedReturnBitfield10 = IF settled9.numberOfReturnBitfields >= 10 THEN (IF settled9.complexInstrumentRejectedReturnBitfield10 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled9.complexInstrumentRejectedReturnBitfield10) ELSE << >>]
        settled11 == [settled10 EXCEPT !.complexInstrumentRejectedReturnBitfield11 = IF settled10.numberOfReturnBitfields >= 11 THEN (IF settled10.complexInstrumentRejectedReturnBitfield11 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled10.complexInstrumentRejectedReturnBitfield11) ELSE << >>]
        settled12 == [settled11 EXCEPT !.complexInstrumentRejectedReturnBitfield12 = IF settled11.numberOfReturnBitfields >= 12 THEN (IF settled11.complexInstrumentRejectedReturnBitfield12 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled11.complexInstrumentRejectedReturnBitfield12) ELSE << >>]
        settled13 == [settled12 EXCEPT !.complexInstrumentRejectedReturnBitfield13 = IF settled12.numberOfReturnBitfields >= 13 THEN (IF settled12.complexInstrumentRejectedReturnBitfield13 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled12.complexInstrumentRejectedReturnBitfield13) ELSE << >>]
        settled14 == [settled13 EXCEPT !.complexInstrumentRejectedReturnBitfield14 = IF settled13.numberOfReturnBitfields >= 14 THEN (IF settled13.complexInstrumentRejectedReturnBitfield14 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled13.complexInstrumentRejectedReturnBitfield14) ELSE << >>]
        settled15 == [settled14 EXCEPT !.complexInstrumentRejectedReturnBitfield15 = IF settled14.numberOfReturnBitfields >= 15 THEN (IF settled14.complexInstrumentRejectedReturnBitfield15 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled14.complexInstrumentRejectedReturnBitfield15) ELSE << >>]
        settled16 == [settled15 EXCEPT !.complexInstrumentRejectedReturnBitfield16 = IF settled15.numberOfReturnBitfields >= 16 THEN (IF settled15.complexInstrumentRejectedReturnBitfield16 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled15.complexInstrumentRejectedReturnBitfield16) ELSE << >>]
        settled17 == [settled16 EXCEPT !.complexInstrumentRejectedReturnBitfield17 = IF settled16.numberOfReturnBitfields >= 17 THEN (IF settled16.complexInstrumentRejectedReturnBitfield17 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled16.complexInstrumentRejectedReturnBitfield17) ELSE << >>]
        settled18 == [settled17 EXCEPT !.complexInstrumentRejectedReturnBitfield18 = IF settled17.numberOfReturnBitfields >= 18 THEN (IF settled17.complexInstrumentRejectedReturnBitfield18 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled17.complexInstrumentRejectedReturnBitfield18) ELSE << >>]
        settled19 == [settled18 EXCEPT !.complexInstrumentRejectedReturnBitfield19 = IF settled18.numberOfReturnBitfields >= 19 THEN (IF settled18.complexInstrumentRejectedReturnBitfield19 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled18.complexInstrumentRejectedReturnBitfield19) ELSE << >>]
    IN  settled19

ZeroComplexInstrumentRejectedMessage ==
    SettleComplexInstrumentRejectedMessage([ transactionTime                           |-> [i \in 1 .. 8 |-> 0],
                                             clOrdId                                   |-> [i \in 1 .. 20 |-> 0],
                                             orderRejectReason                         |-> [i \in 1 .. 1 |-> 0],
                                             text                                      |-> [i \in 1 .. 60 |-> 0],
                                             noOfSecurities                            |-> [i \in 1 .. 4 |-> 0],
                                             reserved1                                 |-> [i \in 1 .. 1 |-> 0],
                                             numberOfReturnBitfields                   |-> 0,
                                             complexInstrumentRejectedReturnBitfield1  |-> << >>,
                                             complexInstrumentRejectedReturnBitfield2  |-> << >>,
                                             complexInstrumentRejectedReturnBitfield3  |-> << >>,
                                             complexInstrumentRejectedReturnBitfield4  |-> << >>,
                                             complexInstrumentRejectedReturnBitfield5  |-> << >>,
                                             complexInstrumentRejectedReturnBitfield6  |-> << >>,
                                             complexInstrumentRejectedReturnBitfield7  |-> << >>,
                                             complexInstrumentRejectedReturnBitfield8  |-> << >>,
                                             complexInstrumentRejectedReturnBitfield9  |-> << >>,
                                             complexInstrumentRejectedReturnBitfield10 |-> << >>,
                                             complexInstrumentRejectedReturnBitfield11 |-> << >>,
                                             complexInstrumentRejectedReturnBitfield12 |-> << >>,
                                             complexInstrumentRejectedReturnBitfield13 |-> << >>,
                                             complexInstrumentRejectedReturnBitfield14 |-> << >>,
                                             complexInstrumentRejectedReturnBitfield15 |-> << >>,
                                             complexInstrumentRejectedReturnBitfield16 |-> << >>,
                                             complexInstrumentRejectedReturnBitfield17 |-> << >>,
                                             complexInstrumentRejectedReturnBitfield18 |-> << >>,
                                             complexInstrumentRejectedReturnBitfield19 |-> << >> ])

(* Complex Instrument Rejected Message at zero, then each field in turn at the values it is checked at *)
CheckedComplexInstrumentRejectedMessage ==
    { ZeroComplexInstrumentRejectedMessage }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.transactionTime = one]) : one \in Sample(8) }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.clOrdId = one]) : one \in Sample(20) }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.orderRejectReason = one]) : one \in Sample(1) }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.text = one]) : one \in Sample(60) }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.noOfSecurities = one]) : one \in Sample(4) }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.reserved1 = one]) : one \in Sample(1) }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.numberOfReturnBitfields = one]) : one \in {0, 1, 255} }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.numberOfReturnBitfields = 1, !.complexInstrumentRejectedReturnBitfield1 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.numberOfReturnBitfields = 2, !.complexInstrumentRejectedReturnBitfield2 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.numberOfReturnBitfields = 3, !.complexInstrumentRejectedReturnBitfield3 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.numberOfReturnBitfields = 4, !.complexInstrumentRejectedReturnBitfield4 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.numberOfReturnBitfields = 5, !.complexInstrumentRejectedReturnBitfield5 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.numberOfReturnBitfields = 6, !.complexInstrumentRejectedReturnBitfield6 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.numberOfReturnBitfields = 7, !.complexInstrumentRejectedReturnBitfield7 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.numberOfReturnBitfields = 8, !.complexInstrumentRejectedReturnBitfield8 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.numberOfReturnBitfields = 9, !.complexInstrumentRejectedReturnBitfield9 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.numberOfReturnBitfields = 10, !.complexInstrumentRejectedReturnBitfield10 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.numberOfReturnBitfields = 11, !.complexInstrumentRejectedReturnBitfield11 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.numberOfReturnBitfields = 12, !.complexInstrumentRejectedReturnBitfield12 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.numberOfReturnBitfields = 13, !.complexInstrumentRejectedReturnBitfield13 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.numberOfReturnBitfields = 14, !.complexInstrumentRejectedReturnBitfield14 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.numberOfReturnBitfields = 15, !.complexInstrumentRejectedReturnBitfield15 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.numberOfReturnBitfields = 16, !.complexInstrumentRejectedReturnBitfield16 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.numberOfReturnBitfields = 17, !.complexInstrumentRejectedReturnBitfield17 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.numberOfReturnBitfields = 18, !.complexInstrumentRejectedReturnBitfield18 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleComplexInstrumentRejectedMessage([ZeroComplexInstrumentRejectedMessage EXCEPT !.numberOfReturnBitfields = 19, !.complexInstrumentRejectedReturnBitfield19 = one]) : one \in { <<held>> : held \in Sample(1) } }

(***************************************************************************)
(* Trd Cap Ack Side Grp                                                    *)
(***************************************************************************)

TrdCapAckSideGrp ==
    [ side                  : { << >> } \cup { <<held>> : held \in Sample(1) },
      capacity              : { << >> } \cup { <<held>> : held \in Sample(1) },
      account               : { << >> } \cup { <<held>> : held \in Sample(16) },
      partyId               : { << >> } \cup { <<held>> : held \in Sample(4) },
      partyRole             : { << >> } \cup { <<held>> : held \in Sample(1) },
      openClose             : { << >> } \cup { <<held>> : held \in Sample(1) },
      custOrderHandlingInst : { << >> } \cup { <<held>> : held \in Sample(1) },
      accountType           : { << >> } \cup { <<held>> : held \in Sample(1) } ]

EncodeTrdCapAckSideGrp(message) ==
    (IF message.side = << >> THEN << >> ELSE message.side[1])
        \o (IF message.capacity = << >> THEN << >> ELSE message.capacity[1])
        \o (IF message.account = << >> THEN << >> ELSE message.account[1])
        \o (IF message.partyId = << >> THEN << >> ELSE message.partyId[1])
        \o (IF message.partyRole = << >> THEN << >> ELSE message.partyRole[1])
        \o (IF message.openClose = << >> THEN << >> ELSE message.openClose[1])
        \o (IF message.custOrderHandlingInst = << >> THEN << >> ELSE message.custOrderHandlingInst[1])
        \o (IF message.accountType = << >> THEN << >> ELSE message.accountType[1])

DecodeTrdCapAckSideGrp(bytes, handedNumberOfReturnBitfields, handedTradeCaptureReportAcknowledgmentV2ReturnBitfield1, handedTradeCaptureReportAcknowledgmentV2ReturnBitfield2, handedTradeCaptureReportAcknowledgmentV2ReturnBitfield3, handedTradeCaptureReportAcknowledgmentV2ReturnBitfield4, handedTradeCaptureReportAcknowledgmentV2ReturnBitfield6, handedTradeCaptureReportAcknowledgmentV2ReturnBitfield17, handedTradeCaptureReportAcknowledgmentV2ReturnBitfield18) ==
    LET side == ReadWhen(handedNumberOfReturnBitfields >= 1 /\ (handedTradeCaptureReportAcknowledgmentV2ReturnBitfield1 # << >> /\ handedTradeCaptureReportAcknowledgmentV2ReturnBitfield1[1] % 2 > 0), ReadBytes(bytes, 1), bytes) IN IF ~side.ok THEN Fail ELSE
    LET capacity == ReadWhen(handedNumberOfReturnBitfields >= 2 /\ (handedTradeCaptureReportAcknowledgmentV2ReturnBitfield2 # << >> /\ (handedTradeCaptureReportAcknowledgmentV2ReturnBitfield2[1] \div 64) % 2 > 0), ReadBytes(side.rest, 1), side.rest) IN IF ~capacity.ok THEN Fail ELSE
    LET account == ReadWhen(handedNumberOfReturnBitfields >= 3 /\ (handedTradeCaptureReportAcknowledgmentV2ReturnBitfield3 # << >> /\ handedTradeCaptureReportAcknowledgmentV2ReturnBitfield3[1] % 2 > 0), ReadBytes(capacity.rest, 16), capacity.rest) IN IF ~account.ok THEN Fail ELSE
    LET partyId == ReadWhen(handedNumberOfReturnBitfields >= 4 /\ (handedTradeCaptureReportAcknowledgmentV2ReturnBitfield4 # << >> /\ (handedTradeCaptureReportAcknowledgmentV2ReturnBitfield4[1] \div 64) % 2 > 0), ReadBytes(account.rest, 4), account.rest) IN IF ~partyId.ok THEN Fail ELSE
    LET partyRole == ReadWhen(handedNumberOfReturnBitfields >= 6 /\ (handedTradeCaptureReportAcknowledgmentV2ReturnBitfield6 # << >> /\ (handedTradeCaptureReportAcknowledgmentV2ReturnBitfield6[1] \div 128) % 2 > 0), ReadBytes(partyId.rest, 1), partyId.rest) IN IF ~partyRole.ok THEN Fail ELSE
    LET openClose == ReadWhen(handedNumberOfReturnBitfields >= 4 /\ (handedTradeCaptureReportAcknowledgmentV2ReturnBitfield4 # << >> /\ (handedTradeCaptureReportAcknowledgmentV2ReturnBitfield4[1] \div 8) % 2 > 0), ReadBytes(partyRole.rest, 1), partyRole.rest) IN IF ~openClose.ok THEN Fail ELSE
    LET custOrderHandlingInst == ReadWhen(handedNumberOfReturnBitfields >= 17 /\ (handedTradeCaptureReportAcknowledgmentV2ReturnBitfield17 # << >> /\ (handedTradeCaptureReportAcknowledgmentV2ReturnBitfield17[1] \div 128) % 2 > 0), ReadBytes(openClose.rest, 1), openClose.rest) IN IF ~custOrderHandlingInst.ok THEN Fail ELSE
    LET accountType == ReadWhen(handedNumberOfReturnBitfields >= 18 /\ (handedTradeCaptureReportAcknowledgmentV2ReturnBitfield18 # << >> /\ handedTradeCaptureReportAcknowledgmentV2ReturnBitfield18[1] % 2 > 0), ReadBytes(custOrderHandlingInst.rest, 1), custOrderHandlingInst.rest) IN IF ~accountType.ok THEN Fail ELSE
    Ok([ side                  |-> side.value,
         capacity              |-> capacity.value,
         account               |-> account.value,
         partyId               |-> partyId.value,
         partyRole             |-> partyRole.value,
         openClose             |-> openClose.value,
         custOrderHandlingInst |-> custOrderHandlingInst.value,
         accountType           |-> accountType.value ], accountType.rest)

(* Trd Cap Ack Side Grp with each field marked present by fields before it there exactly where they say *)
SettleTrdCapAckSideGrp(message, handedNumberOfReturnBitfields, handedTradeCaptureReportAcknowledgmentV2ReturnBitfield1, handedTradeCaptureReportAcknowledgmentV2ReturnBitfield2, handedTradeCaptureReportAcknowledgmentV2ReturnBitfield3, handedTradeCaptureReportAcknowledgmentV2ReturnBitfield4, handedTradeCaptureReportAcknowledgmentV2ReturnBitfield6, handedTradeCaptureReportAcknowledgmentV2ReturnBitfield17, handedTradeCaptureReportAcknowledgmentV2ReturnBitfield18) ==
    LET settled1 == [message EXCEPT !.side = IF handedNumberOfReturnBitfields >= 1 /\ (handedTradeCaptureReportAcknowledgmentV2ReturnBitfield1 # << >> /\ handedTradeCaptureReportAcknowledgmentV2ReturnBitfield1[1] % 2 > 0) THEN (IF message.side = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE message.side) ELSE << >>]
        settled2 == [settled1 EXCEPT !.capacity = IF handedNumberOfReturnBitfields >= 2 /\ (handedTradeCaptureReportAcknowledgmentV2ReturnBitfield2 # << >> /\ (handedTradeCaptureReportAcknowledgmentV2ReturnBitfield2[1] \div 64) % 2 > 0) THEN (IF settled1.capacity = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled1.capacity) ELSE << >>]
        settled3 == [settled2 EXCEPT !.account = IF handedNumberOfReturnBitfields >= 3 /\ (handedTradeCaptureReportAcknowledgmentV2ReturnBitfield3 # << >> /\ handedTradeCaptureReportAcknowledgmentV2ReturnBitfield3[1] % 2 > 0) THEN (IF settled2.account = << >> THEN <<[i \in 1 .. 16 |-> 0]>> ELSE settled2.account) ELSE << >>]
        settled4 == [settled3 EXCEPT !.partyId = IF handedNumberOfReturnBitfields >= 4 /\ (handedTradeCaptureReportAcknowledgmentV2ReturnBitfield4 # << >> /\ (handedTradeCaptureReportAcknowledgmentV2ReturnBitfield4[1] \div 64) % 2 > 0) THEN (IF settled3.partyId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled3.partyId) ELSE << >>]
        settled5 == [settled4 EXCEPT !.partyRole = IF handedNumberOfReturnBitfields >= 6 /\ (handedTradeCaptureReportAcknowledgmentV2ReturnBitfield6 # << >> /\ (handedTradeCaptureReportAcknowledgmentV2ReturnBitfield6[1] \div 128) % 2 > 0) THEN (IF settled4.partyRole = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled4.partyRole) ELSE << >>]
        settled6 == [settled5 EXCEPT !.openClose = IF handedNumberOfReturnBitfields >= 4 /\ (handedTradeCaptureReportAcknowledgmentV2ReturnBitfield4 # << >> /\ (handedTradeCaptureReportAcknowledgmentV2ReturnBitfield4[1] \div 8) % 2 > 0) THEN (IF settled5.openClose = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled5.openClose) ELSE << >>]
        settled7 == [settled6 EXCEPT !.custOrderHandlingInst = IF handedNumberOfReturnBitfields >= 17 /\ (handedTradeCaptureReportAcknowledgmentV2ReturnBitfield17 # << >> /\ (handedTradeCaptureReportAcknowledgmentV2ReturnBitfield17[1] \div 128) % 2 > 0) THEN (IF settled6.custOrderHandlingInst = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled6.custOrderHandlingInst) ELSE << >>]
        settled8 == [settled7 EXCEPT !.accountType = IF handedNumberOfReturnBitfields >= 18 /\ (handedTradeCaptureReportAcknowledgmentV2ReturnBitfield18 # << >> /\ handedTradeCaptureReportAcknowledgmentV2ReturnBitfield18[1] % 2 > 0) THEN (IF settled7.accountType = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled7.accountType) ELSE << >>]
    IN  settled8

ZeroTrdCapAckSideGrp ==
    SettleTrdCapAckSideGrp([ side                  |-> << >>,
                             capacity              |-> << >>,
                             account               |-> << >>,
                             partyId               |-> << >>,
                             partyRole             |-> << >>,
                             openClose             |-> << >>,
                             custOrderHandlingInst |-> << >>,
                             accountType           |-> << >> ], 0, << >>, << >>, << >>, << >>, << >>, << >>, << >>)

(* Trd Cap Ack Side Grp at zero, then each field in turn at the values it is checked at *)
CheckedTrdCapAckSideGrp ==
    { [given |-> <<0, << >>, << >>, << >>, << >>, << >>, << >>, << >>>>, message |-> ZeroTrdCapAckSideGrp] }
        \cup { [given |-> <<1, <<1>>, << >>, << >>, << >>, << >>, << >>, << >>>>, message |-> SettleTrdCapAckSideGrp([ZeroTrdCapAckSideGrp EXCEPT !.side = one], 1, <<1>>, << >>, << >>, << >>, << >>, << >>, << >>)] : one \in { <<held>> : held \in Sample(1) } }
        \cup { [given |-> <<2, << >>, <<64>>, << >>, << >>, << >>, << >>, << >>>>, message |-> SettleTrdCapAckSideGrp([ZeroTrdCapAckSideGrp EXCEPT !.capacity = one], 2, << >>, <<64>>, << >>, << >>, << >>, << >>, << >>)] : one \in { <<held>> : held \in Sample(1) } }
        \cup { [given |-> <<3, << >>, << >>, <<1>>, << >>, << >>, << >>, << >>>>, message |-> SettleTrdCapAckSideGrp([ZeroTrdCapAckSideGrp EXCEPT !.account = one], 3, << >>, << >>, <<1>>, << >>, << >>, << >>, << >>)] : one \in { <<held>> : held \in Sample(16) } }
        \cup { [given |-> <<4, << >>, << >>, << >>, <<64>>, << >>, << >>, << >>>>, message |-> SettleTrdCapAckSideGrp([ZeroTrdCapAckSideGrp EXCEPT !.partyId = one], 4, << >>, << >>, << >>, <<64>>, << >>, << >>, << >>)] : one \in { <<held>> : held \in Sample(4) } }
        \cup { [given |-> <<6, << >>, << >>, << >>, << >>, <<128>>, << >>, << >>>>, message |-> SettleTrdCapAckSideGrp([ZeroTrdCapAckSideGrp EXCEPT !.partyRole = one], 6, << >>, << >>, << >>, << >>, <<128>>, << >>, << >>)] : one \in { <<held>> : held \in Sample(1) } }
        \cup { [given |-> <<4, << >>, << >>, << >>, <<8>>, << >>, << >>, << >>>>, message |-> SettleTrdCapAckSideGrp([ZeroTrdCapAckSideGrp EXCEPT !.openClose = one], 4, << >>, << >>, << >>, <<8>>, << >>, << >>, << >>)] : one \in { <<held>> : held \in Sample(1) } }
        \cup { [given |-> <<17, << >>, << >>, << >>, << >>, << >>, <<128>>, << >>>>, message |-> SettleTrdCapAckSideGrp([ZeroTrdCapAckSideGrp EXCEPT !.custOrderHandlingInst = one], 17, << >>, << >>, << >>, << >>, << >>, <<128>>, << >>)] : one \in { <<held>> : held \in Sample(1) } }
        \cup { [given |-> <<18, << >>, << >>, << >>, << >>, << >>, << >>, <<1>>>>, message |-> SettleTrdCapAckSideGrp([ZeroTrdCapAckSideGrp EXCEPT !.accountType = one], 18, << >>, << >>, << >>, << >>, << >>, << >>, <<1>>)] : one \in { <<held>> : held \in Sample(1) } }

(* A run of Trd Cap Ack Side Grp, written one after another *)
RECURSIVE EncodeTrdCapAckSideGrpList(_)
EncodeTrdCapAckSideGrpList(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeTrdCapAckSideGrp(Head(messages)) \o EncodeTrdCapAckSideGrpList(Tail(messages))

(* As many Trd Cap Ack Side Grp as the field that counts them says *)
RECURSIVE ReadTrdCapAckSideGrpList(_, _, _, _, _, _, _, _, _, _)
ReadTrdCapAckSideGrpList(bytes, count, handedNumberOfReturnBitfields, handedTradeCaptureReportAcknowledgmentV2ReturnBitfield1, handedTradeCaptureReportAcknowledgmentV2ReturnBitfield2, handedTradeCaptureReportAcknowledgmentV2ReturnBitfield3, handedTradeCaptureReportAcknowledgmentV2ReturnBitfield4, handedTradeCaptureReportAcknowledgmentV2ReturnBitfield6, handedTradeCaptureReportAcknowledgmentV2ReturnBitfield17, handedTradeCaptureReportAcknowledgmentV2ReturnBitfield18) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeTrdCapAckSideGrp(bytes, handedNumberOfReturnBitfields, handedTradeCaptureReportAcknowledgmentV2ReturnBitfield1, handedTradeCaptureReportAcknowledgmentV2ReturnBitfield2, handedTradeCaptureReportAcknowledgmentV2ReturnBitfield3, handedTradeCaptureReportAcknowledgmentV2ReturnBitfield4, handedTradeCaptureReportAcknowledgmentV2ReturnBitfield6, handedTradeCaptureReportAcknowledgmentV2ReturnBitfield17, handedTradeCaptureReportAcknowledgmentV2ReturnBitfield18)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadTrdCapAckSideGrpList(one.rest, count - 1, handedNumberOfReturnBitfields, handedTradeCaptureReportAcknowledgmentV2ReturnBitfield1, handedTradeCaptureReportAcknowledgmentV2ReturnBitfield2, handedTradeCaptureReportAcknowledgmentV2ReturnBitfield3, handedTradeCaptureReportAcknowledgmentV2ReturnBitfield4, handedTradeCaptureReportAcknowledgmentV2ReturnBitfield6, handedTradeCaptureReportAcknowledgmentV2ReturnBitfield17, handedTradeCaptureReportAcknowledgmentV2ReturnBitfield18)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Trd Cap Ack Side Grp of each kind, for the lists that carry them *)
OneTrdCapAckSideGrp == { ZeroTrdCapAckSideGrp }

(***************************************************************************)
(* Trade Capture Report Acknowledgment V 2 Message                         *)
(***************************************************************************)

TradeCaptureReportAcknowledgmentV2Message ==
    [ transactionTime                                    : Sample(8),
      tradeReportId                                      : Sample(20),
      reserved1                                          : Sample(1),
      numberOfReturnBitfields                            : 0 .. 255,
      tradeCaptureReportAcknowledgmentV2ReturnBitfield1  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      tradeCaptureReportAcknowledgmentV2ReturnBitfield2  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      tradeCaptureReportAcknowledgmentV2ReturnBitfield3  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      tradeCaptureReportAcknowledgmentV2ReturnBitfield4  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      tradeCaptureReportAcknowledgmentV2ReturnBitfield5  : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeCaptureReportAcknowledgmentV2ReturnBitfield6  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      tradeCaptureReportAcknowledgmentV2ReturnBitfield7  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      tradeCaptureReportAcknowledgmentV2ReturnBitfield8  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      tradeCaptureReportAcknowledgmentV2ReturnBitfield9  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      tradeCaptureReportAcknowledgmentV2ReturnBitfield10 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      tradeCaptureReportAcknowledgmentV2ReturnBitfield11 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      tradeCaptureReportAcknowledgmentV2ReturnBitfield12 : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeCaptureReportAcknowledgmentV2ReturnBitfield13 : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeCaptureReportAcknowledgmentV2ReturnBitfield14 : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeCaptureReportAcknowledgmentV2ReturnBitfield15 : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeCaptureReportAcknowledgmentV2ReturnBitfield16 : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeCaptureReportAcknowledgmentV2ReturnBitfield17 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      tradeCaptureReportAcknowledgmentV2ReturnBitfield18 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      tradeCaptureReportAcknowledgmentV2ReturnBitfield19 : { << >> } \cup { <<held>> : held \in Sample(1) },
      trdCapAckSideGrp                                   : SampleLists(OneTrdCapAckSideGrp),
      symbolLong                                         : { << >> } \cup { <<held>> : held \in Sample(8) },
      idSource                                           : { << >> } \cup { <<held>> : held \in Sample(1) },
      securityId                                         : { << >> } \cup { <<held>> : held \in Sample(16) },
      clearingFirm                                       : { << >> } \cup { <<held>> : held \in Sample(4) },
      orderQty                                           : { << >> } \cup { <<held>> : held \in Sample(4) },
      extExecInst                                        : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeReportTypeReturn                              : { << >> } \cup { <<held>> : held \in Sample(2) },
      tradeReportRefId                                   : { << >> } \cup { <<held>> : held \in Sample(20) },
      orderCategory                                      : { << >> } \cup { <<held>> : held \in Sample(1) },
      liquidityProvision                                 : { << >> } \cup { <<held>> : held \in Sample(1) },
      priceFormation                                     : { << >> } \cup { <<held>> : held \in Sample(1) },
      algorithmicIndicator                               : { << >> } \cup { <<held>> : held \in Sample(1) } ]

EncodeTradeCaptureReportAcknowledgmentV2Message(message) ==
    message.transactionTime
        \o message.tradeReportId
        \o message.reserved1
        \o EncodeUIntBE(message.numberOfReturnBitfields, 1)
        \o (IF message.tradeCaptureReportAcknowledgmentV2ReturnBitfield1 = << >> THEN << >> ELSE EncodeUIntLE(message.tradeCaptureReportAcknowledgmentV2ReturnBitfield1[1], 1))
        \o (IF message.tradeCaptureReportAcknowledgmentV2ReturnBitfield2 = << >> THEN << >> ELSE EncodeUIntLE(message.tradeCaptureReportAcknowledgmentV2ReturnBitfield2[1], 1))
        \o (IF message.tradeCaptureReportAcknowledgmentV2ReturnBitfield3 = << >> THEN << >> ELSE EncodeUIntLE(message.tradeCaptureReportAcknowledgmentV2ReturnBitfield3[1], 1))
        \o (IF message.tradeCaptureReportAcknowledgmentV2ReturnBitfield4 = << >> THEN << >> ELSE EncodeUIntLE(message.tradeCaptureReportAcknowledgmentV2ReturnBitfield4[1], 1))
        \o (IF message.tradeCaptureReportAcknowledgmentV2ReturnBitfield5 = << >> THEN << >> ELSE message.tradeCaptureReportAcknowledgmentV2ReturnBitfield5[1])
        \o (IF message.tradeCaptureReportAcknowledgmentV2ReturnBitfield6 = << >> THEN << >> ELSE EncodeUIntLE(message.tradeCaptureReportAcknowledgmentV2ReturnBitfield6[1], 1))
        \o (IF message.tradeCaptureReportAcknowledgmentV2ReturnBitfield7 = << >> THEN << >> ELSE EncodeUIntLE(message.tradeCaptureReportAcknowledgmentV2ReturnBitfield7[1], 1))
        \o (IF message.tradeCaptureReportAcknowledgmentV2ReturnBitfield8 = << >> THEN << >> ELSE EncodeUIntLE(message.tradeCaptureReportAcknowledgmentV2ReturnBitfield8[1], 1))
        \o (IF message.tradeCaptureReportAcknowledgmentV2ReturnBitfield9 = << >> THEN << >> ELSE EncodeUIntLE(message.tradeCaptureReportAcknowledgmentV2ReturnBitfield9[1], 1))
        \o (IF message.tradeCaptureReportAcknowledgmentV2ReturnBitfield10 = << >> THEN << >> ELSE EncodeUIntLE(message.tradeCaptureReportAcknowledgmentV2ReturnBitfield10[1], 1))
        \o (IF message.tradeCaptureReportAcknowledgmentV2ReturnBitfield11 = << >> THEN << >> ELSE EncodeUIntLE(message.tradeCaptureReportAcknowledgmentV2ReturnBitfield11[1], 1))
        \o (IF message.tradeCaptureReportAcknowledgmentV2ReturnBitfield12 = << >> THEN << >> ELSE message.tradeCaptureReportAcknowledgmentV2ReturnBitfield12[1])
        \o (IF message.tradeCaptureReportAcknowledgmentV2ReturnBitfield13 = << >> THEN << >> ELSE message.tradeCaptureReportAcknowledgmentV2ReturnBitfield13[1])
        \o (IF message.tradeCaptureReportAcknowledgmentV2ReturnBitfield14 = << >> THEN << >> ELSE message.tradeCaptureReportAcknowledgmentV2ReturnBitfield14[1])
        \o (IF message.tradeCaptureReportAcknowledgmentV2ReturnBitfield15 = << >> THEN << >> ELSE message.tradeCaptureReportAcknowledgmentV2ReturnBitfield15[1])
        \o (IF message.tradeCaptureReportAcknowledgmentV2ReturnBitfield16 = << >> THEN << >> ELSE message.tradeCaptureReportAcknowledgmentV2ReturnBitfield16[1])
        \o (IF message.tradeCaptureReportAcknowledgmentV2ReturnBitfield17 = << >> THEN << >> ELSE EncodeUIntLE(message.tradeCaptureReportAcknowledgmentV2ReturnBitfield17[1], 1))
        \o (IF message.tradeCaptureReportAcknowledgmentV2ReturnBitfield18 = << >> THEN << >> ELSE EncodeUIntLE(message.tradeCaptureReportAcknowledgmentV2ReturnBitfield18[1], 1))
        \o (IF message.tradeCaptureReportAcknowledgmentV2ReturnBitfield19 = << >> THEN << >> ELSE message.tradeCaptureReportAcknowledgmentV2ReturnBitfield19[1])
        \o EncodeUIntBE(Len(message.trdCapAckSideGrp), 1)
        \o EncodeTrdCapAckSideGrpList(message.trdCapAckSideGrp)
        \o (IF message.symbolLong = << >> THEN << >> ELSE message.symbolLong[1])
        \o (IF message.idSource = << >> THEN << >> ELSE message.idSource[1])
        \o (IF message.securityId = << >> THEN << >> ELSE message.securityId[1])
        \o (IF message.clearingFirm = << >> THEN << >> ELSE message.clearingFirm[1])
        \o (IF message.orderQty = << >> THEN << >> ELSE message.orderQty[1])
        \o (IF message.extExecInst = << >> THEN << >> ELSE message.extExecInst[1])
        \o (IF message.tradeReportTypeReturn = << >> THEN << >> ELSE message.tradeReportTypeReturn[1])
        \o (IF message.tradeReportRefId = << >> THEN << >> ELSE message.tradeReportRefId[1])
        \o (IF message.orderCategory = << >> THEN << >> ELSE message.orderCategory[1])
        \o (IF message.liquidityProvision = << >> THEN << >> ELSE message.liquidityProvision[1])
        \o (IF message.priceFormation = << >> THEN << >> ELSE message.priceFormation[1])
        \o (IF message.algorithmicIndicator = << >> THEN << >> ELSE message.algorithmicIndicator[1])

DecodeTradeCaptureReportAcknowledgmentV2Message(bytes) ==
    LET transactionTime == ReadBytes(bytes, 8) IN IF ~transactionTime.ok THEN Fail ELSE
    LET tradeReportId == ReadBytes(transactionTime.rest, 20) IN IF ~tradeReportId.ok THEN Fail ELSE
    LET reserved1 == ReadBytes(tradeReportId.rest, 1) IN IF ~reserved1.ok THEN Fail ELSE
    LET numberOfReturnBitfields == ReadUIntBE(reserved1.rest, 1) IN IF ~numberOfReturnBitfields.ok THEN Fail ELSE
    LET tradeCaptureReportAcknowledgmentV2ReturnBitfield1 == ReadWhen(numberOfReturnBitfields.value >= 1, ReadUIntLE(numberOfReturnBitfields.rest, 1), numberOfReturnBitfields.rest) IN IF ~tradeCaptureReportAcknowledgmentV2ReturnBitfield1.ok THEN Fail ELSE
    LET tradeCaptureReportAcknowledgmentV2ReturnBitfield2 == ReadWhen(numberOfReturnBitfields.value >= 2, ReadUIntLE(tradeCaptureReportAcknowledgmentV2ReturnBitfield1.rest, 1), tradeCaptureReportAcknowledgmentV2ReturnBitfield1.rest) IN IF ~tradeCaptureReportAcknowledgmentV2ReturnBitfield2.ok THEN Fail ELSE
    LET tradeCaptureReportAcknowledgmentV2ReturnBitfield3 == ReadWhen(numberOfReturnBitfields.value >= 3, ReadUIntLE(tradeCaptureReportAcknowledgmentV2ReturnBitfield2.rest, 1), tradeCaptureReportAcknowledgmentV2ReturnBitfield2.rest) IN IF ~tradeCaptureReportAcknowledgmentV2ReturnBitfield3.ok THEN Fail ELSE
    LET tradeCaptureReportAcknowledgmentV2ReturnBitfield4 == ReadWhen(numberOfReturnBitfields.value >= 4, ReadUIntLE(tradeCaptureReportAcknowledgmentV2ReturnBitfield3.rest, 1), tradeCaptureReportAcknowledgmentV2ReturnBitfield3.rest) IN IF ~tradeCaptureReportAcknowledgmentV2ReturnBitfield4.ok THEN Fail ELSE
    LET tradeCaptureReportAcknowledgmentV2ReturnBitfield5 == ReadWhen(numberOfReturnBitfields.value >= 5, ReadBytes(tradeCaptureReportAcknowledgmentV2ReturnBitfield4.rest, 1), tradeCaptureReportAcknowledgmentV2ReturnBitfield4.rest) IN IF ~tradeCaptureReportAcknowledgmentV2ReturnBitfield5.ok THEN Fail ELSE
    LET tradeCaptureReportAcknowledgmentV2ReturnBitfield6 == ReadWhen(numberOfReturnBitfields.value >= 6, ReadUIntLE(tradeCaptureReportAcknowledgmentV2ReturnBitfield5.rest, 1), tradeCaptureReportAcknowledgmentV2ReturnBitfield5.rest) IN IF ~tradeCaptureReportAcknowledgmentV2ReturnBitfield6.ok THEN Fail ELSE
    LET tradeCaptureReportAcknowledgmentV2ReturnBitfield7 == ReadWhen(numberOfReturnBitfields.value >= 7, ReadUIntLE(tradeCaptureReportAcknowledgmentV2ReturnBitfield6.rest, 1), tradeCaptureReportAcknowledgmentV2ReturnBitfield6.rest) IN IF ~tradeCaptureReportAcknowledgmentV2ReturnBitfield7.ok THEN Fail ELSE
    LET tradeCaptureReportAcknowledgmentV2ReturnBitfield8 == ReadWhen(numberOfReturnBitfields.value >= 8, ReadUIntLE(tradeCaptureReportAcknowledgmentV2ReturnBitfield7.rest, 1), tradeCaptureReportAcknowledgmentV2ReturnBitfield7.rest) IN IF ~tradeCaptureReportAcknowledgmentV2ReturnBitfield8.ok THEN Fail ELSE
    LET tradeCaptureReportAcknowledgmentV2ReturnBitfield9 == ReadWhen(numberOfReturnBitfields.value >= 9, ReadUIntLE(tradeCaptureReportAcknowledgmentV2ReturnBitfield8.rest, 1), tradeCaptureReportAcknowledgmentV2ReturnBitfield8.rest) IN IF ~tradeCaptureReportAcknowledgmentV2ReturnBitfield9.ok THEN Fail ELSE
    LET tradeCaptureReportAcknowledgmentV2ReturnBitfield10 == ReadWhen(numberOfReturnBitfields.value >= 10, ReadUIntLE(tradeCaptureReportAcknowledgmentV2ReturnBitfield9.rest, 1), tradeCaptureReportAcknowledgmentV2ReturnBitfield9.rest) IN IF ~tradeCaptureReportAcknowledgmentV2ReturnBitfield10.ok THEN Fail ELSE
    LET tradeCaptureReportAcknowledgmentV2ReturnBitfield11 == ReadWhen(numberOfReturnBitfields.value >= 11, ReadUIntLE(tradeCaptureReportAcknowledgmentV2ReturnBitfield10.rest, 1), tradeCaptureReportAcknowledgmentV2ReturnBitfield10.rest) IN IF ~tradeCaptureReportAcknowledgmentV2ReturnBitfield11.ok THEN Fail ELSE
    LET tradeCaptureReportAcknowledgmentV2ReturnBitfield12 == ReadWhen(numberOfReturnBitfields.value >= 12, ReadBytes(tradeCaptureReportAcknowledgmentV2ReturnBitfield11.rest, 1), tradeCaptureReportAcknowledgmentV2ReturnBitfield11.rest) IN IF ~tradeCaptureReportAcknowledgmentV2ReturnBitfield12.ok THEN Fail ELSE
    LET tradeCaptureReportAcknowledgmentV2ReturnBitfield13 == ReadWhen(numberOfReturnBitfields.value >= 13, ReadBytes(tradeCaptureReportAcknowledgmentV2ReturnBitfield12.rest, 1), tradeCaptureReportAcknowledgmentV2ReturnBitfield12.rest) IN IF ~tradeCaptureReportAcknowledgmentV2ReturnBitfield13.ok THEN Fail ELSE
    LET tradeCaptureReportAcknowledgmentV2ReturnBitfield14 == ReadWhen(numberOfReturnBitfields.value >= 14, ReadBytes(tradeCaptureReportAcknowledgmentV2ReturnBitfield13.rest, 1), tradeCaptureReportAcknowledgmentV2ReturnBitfield13.rest) IN IF ~tradeCaptureReportAcknowledgmentV2ReturnBitfield14.ok THEN Fail ELSE
    LET tradeCaptureReportAcknowledgmentV2ReturnBitfield15 == ReadWhen(numberOfReturnBitfields.value >= 15, ReadBytes(tradeCaptureReportAcknowledgmentV2ReturnBitfield14.rest, 1), tradeCaptureReportAcknowledgmentV2ReturnBitfield14.rest) IN IF ~tradeCaptureReportAcknowledgmentV2ReturnBitfield15.ok THEN Fail ELSE
    LET tradeCaptureReportAcknowledgmentV2ReturnBitfield16 == ReadWhen(numberOfReturnBitfields.value >= 16, ReadBytes(tradeCaptureReportAcknowledgmentV2ReturnBitfield15.rest, 1), tradeCaptureReportAcknowledgmentV2ReturnBitfield15.rest) IN IF ~tradeCaptureReportAcknowledgmentV2ReturnBitfield16.ok THEN Fail ELSE
    LET tradeCaptureReportAcknowledgmentV2ReturnBitfield17 == ReadWhen(numberOfReturnBitfields.value >= 17, ReadUIntLE(tradeCaptureReportAcknowledgmentV2ReturnBitfield16.rest, 1), tradeCaptureReportAcknowledgmentV2ReturnBitfield16.rest) IN IF ~tradeCaptureReportAcknowledgmentV2ReturnBitfield17.ok THEN Fail ELSE
    LET tradeCaptureReportAcknowledgmentV2ReturnBitfield18 == ReadWhen(numberOfReturnBitfields.value >= 18, ReadUIntLE(tradeCaptureReportAcknowledgmentV2ReturnBitfield17.rest, 1), tradeCaptureReportAcknowledgmentV2ReturnBitfield17.rest) IN IF ~tradeCaptureReportAcknowledgmentV2ReturnBitfield18.ok THEN Fail ELSE
    LET tradeCaptureReportAcknowledgmentV2ReturnBitfield19 == ReadWhen(numberOfReturnBitfields.value >= 19, ReadBytes(tradeCaptureReportAcknowledgmentV2ReturnBitfield18.rest, 1), tradeCaptureReportAcknowledgmentV2ReturnBitfield18.rest) IN IF ~tradeCaptureReportAcknowledgmentV2ReturnBitfield19.ok THEN Fail ELSE
    LET noSides == ReadUIntBE(tradeCaptureReportAcknowledgmentV2ReturnBitfield19.rest, 1) IN IF ~noSides.ok THEN Fail ELSE
    LET trdCapAckSideGrp == ReadTrdCapAckSideGrpList(noSides.rest, noSides.value, numberOfReturnBitfields.value, tradeCaptureReportAcknowledgmentV2ReturnBitfield1.value, tradeCaptureReportAcknowledgmentV2ReturnBitfield2.value, tradeCaptureReportAcknowledgmentV2ReturnBitfield3.value, tradeCaptureReportAcknowledgmentV2ReturnBitfield4.value, tradeCaptureReportAcknowledgmentV2ReturnBitfield6.value, tradeCaptureReportAcknowledgmentV2ReturnBitfield17.value, tradeCaptureReportAcknowledgmentV2ReturnBitfield18.value) IN IF ~trdCapAckSideGrp.ok THEN Fail ELSE
    LET symbolLong == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (tradeCaptureReportAcknowledgmentV2ReturnBitfield2.value # << >> /\ tradeCaptureReportAcknowledgmentV2ReturnBitfield2.value[1] % 2 > 0), ReadBytes(trdCapAckSideGrp.rest, 8), trdCapAckSideGrp.rest) IN IF ~symbolLong.ok THEN Fail ELSE
    LET idSource == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (tradeCaptureReportAcknowledgmentV2ReturnBitfield2.value # << >> /\ (tradeCaptureReportAcknowledgmentV2ReturnBitfield2.value[1] \div 8) % 2 > 0), ReadBytes(symbolLong.rest, 1), symbolLong.rest) IN IF ~idSource.ok THEN Fail ELSE
    LET securityId == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (tradeCaptureReportAcknowledgmentV2ReturnBitfield2.value # << >> /\ (tradeCaptureReportAcknowledgmentV2ReturnBitfield2.value[1] \div 16) % 2 > 0), ReadBytes(idSource.rest, 16), idSource.rest) IN IF ~securityId.ok THEN Fail ELSE
    LET clearingFirm == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (tradeCaptureReportAcknowledgmentV2ReturnBitfield3.value # << >> /\ (tradeCaptureReportAcknowledgmentV2ReturnBitfield3.value[1] \div 2) % 2 > 0), ReadBytes(securityId.rest, 4), securityId.rest) IN IF ~clearingFirm.ok THEN Fail ELSE
    LET orderQty == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (tradeCaptureReportAcknowledgmentV2ReturnBitfield3.value # << >> /\ (tradeCaptureReportAcknowledgmentV2ReturnBitfield3.value[1] \div 64) % 2 > 0), ReadBytes(clearingFirm.rest, 4), clearingFirm.rest) IN IF ~orderQty.ok THEN Fail ELSE
    LET extExecInst == ReadWhen(numberOfReturnBitfields.value >= 6 /\ (tradeCaptureReportAcknowledgmentV2ReturnBitfield6.value # << >> /\ (tradeCaptureReportAcknowledgmentV2ReturnBitfield6.value[1] \div 16) % 2 > 0), ReadBytes(orderQty.rest, 1), orderQty.rest) IN IF ~extExecInst.ok THEN Fail ELSE
    LET tradeReportTypeReturn == ReadWhen(numberOfReturnBitfields.value >= 7 /\ (tradeCaptureReportAcknowledgmentV2ReturnBitfield7.value # << >> /\ (tradeCaptureReportAcknowledgmentV2ReturnBitfield7.value[1] \div 2) % 2 > 0), ReadBytes(extExecInst.rest, 2), extExecInst.rest) IN IF ~tradeReportTypeReturn.ok THEN Fail ELSE
    LET tradeReportRefId == ReadWhen(numberOfReturnBitfields.value >= 8 /\ (tradeCaptureReportAcknowledgmentV2ReturnBitfield8.value # << >> /\ (tradeCaptureReportAcknowledgmentV2ReturnBitfield8.value[1] \div 128) % 2 > 0), ReadBytes(tradeReportTypeReturn.rest, 20), tradeReportTypeReturn.rest) IN IF ~tradeReportRefId.ok THEN Fail ELSE
    LET orderCategory == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (tradeCaptureReportAcknowledgmentV2ReturnBitfield9.value # << >> /\ (tradeCaptureReportAcknowledgmentV2ReturnBitfield9.value[1] \div 8) % 2 > 0), ReadBytes(tradeReportRefId.rest, 1), tradeReportRefId.rest) IN IF ~orderCategory.ok THEN Fail ELSE
    LET liquidityProvision == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (tradeCaptureReportAcknowledgmentV2ReturnBitfield9.value # << >> /\ (tradeCaptureReportAcknowledgmentV2ReturnBitfield9.value[1] \div 16) % 2 > 0), ReadBytes(orderCategory.rest, 1), orderCategory.rest) IN IF ~liquidityProvision.ok THEN Fail ELSE
    LET priceFormation == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (tradeCaptureReportAcknowledgmentV2ReturnBitfield10.value # << >> /\ (tradeCaptureReportAcknowledgmentV2ReturnBitfield10.value[1] \div 64) % 2 > 0), ReadBytes(liquidityProvision.rest, 1), liquidityProvision.rest) IN IF ~priceFormation.ok THEN Fail ELSE
    LET algorithmicIndicator == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (tradeCaptureReportAcknowledgmentV2ReturnBitfield11.value # << >> /\ (tradeCaptureReportAcknowledgmentV2ReturnBitfield11.value[1] \div 16) % 2 > 0), ReadBytes(priceFormation.rest, 1), priceFormation.rest) IN IF ~algorithmicIndicator.ok THEN Fail ELSE
    Ok([ transactionTime                                    |-> transactionTime.value,
         tradeReportId                                      |-> tradeReportId.value,
         reserved1                                          |-> reserved1.value,
         numberOfReturnBitfields                            |-> numberOfReturnBitfields.value,
         tradeCaptureReportAcknowledgmentV2ReturnBitfield1  |-> tradeCaptureReportAcknowledgmentV2ReturnBitfield1.value,
         tradeCaptureReportAcknowledgmentV2ReturnBitfield2  |-> tradeCaptureReportAcknowledgmentV2ReturnBitfield2.value,
         tradeCaptureReportAcknowledgmentV2ReturnBitfield3  |-> tradeCaptureReportAcknowledgmentV2ReturnBitfield3.value,
         tradeCaptureReportAcknowledgmentV2ReturnBitfield4  |-> tradeCaptureReportAcknowledgmentV2ReturnBitfield4.value,
         tradeCaptureReportAcknowledgmentV2ReturnBitfield5  |-> tradeCaptureReportAcknowledgmentV2ReturnBitfield5.value,
         tradeCaptureReportAcknowledgmentV2ReturnBitfield6  |-> tradeCaptureReportAcknowledgmentV2ReturnBitfield6.value,
         tradeCaptureReportAcknowledgmentV2ReturnBitfield7  |-> tradeCaptureReportAcknowledgmentV2ReturnBitfield7.value,
         tradeCaptureReportAcknowledgmentV2ReturnBitfield8  |-> tradeCaptureReportAcknowledgmentV2ReturnBitfield8.value,
         tradeCaptureReportAcknowledgmentV2ReturnBitfield9  |-> tradeCaptureReportAcknowledgmentV2ReturnBitfield9.value,
         tradeCaptureReportAcknowledgmentV2ReturnBitfield10 |-> tradeCaptureReportAcknowledgmentV2ReturnBitfield10.value,
         tradeCaptureReportAcknowledgmentV2ReturnBitfield11 |-> tradeCaptureReportAcknowledgmentV2ReturnBitfield11.value,
         tradeCaptureReportAcknowledgmentV2ReturnBitfield12 |-> tradeCaptureReportAcknowledgmentV2ReturnBitfield12.value,
         tradeCaptureReportAcknowledgmentV2ReturnBitfield13 |-> tradeCaptureReportAcknowledgmentV2ReturnBitfield13.value,
         tradeCaptureReportAcknowledgmentV2ReturnBitfield14 |-> tradeCaptureReportAcknowledgmentV2ReturnBitfield14.value,
         tradeCaptureReportAcknowledgmentV2ReturnBitfield15 |-> tradeCaptureReportAcknowledgmentV2ReturnBitfield15.value,
         tradeCaptureReportAcknowledgmentV2ReturnBitfield16 |-> tradeCaptureReportAcknowledgmentV2ReturnBitfield16.value,
         tradeCaptureReportAcknowledgmentV2ReturnBitfield17 |-> tradeCaptureReportAcknowledgmentV2ReturnBitfield17.value,
         tradeCaptureReportAcknowledgmentV2ReturnBitfield18 |-> tradeCaptureReportAcknowledgmentV2ReturnBitfield18.value,
         tradeCaptureReportAcknowledgmentV2ReturnBitfield19 |-> tradeCaptureReportAcknowledgmentV2ReturnBitfield19.value,
         trdCapAckSideGrp                                   |-> trdCapAckSideGrp.value,
         symbolLong                                         |-> symbolLong.value,
         idSource                                           |-> idSource.value,
         securityId                                         |-> securityId.value,
         clearingFirm                                       |-> clearingFirm.value,
         orderQty                                           |-> orderQty.value,
         extExecInst                                        |-> extExecInst.value,
         tradeReportTypeReturn                              |-> tradeReportTypeReturn.value,
         tradeReportRefId                                   |-> tradeReportRefId.value,
         orderCategory                                      |-> orderCategory.value,
         liquidityProvision                                 |-> liquidityProvision.value,
         priceFormation                                     |-> priceFormation.value,
         algorithmicIndicator                               |-> algorithmicIndicator.value ], algorithmicIndicator.rest)

(* Trade Capture Report Acknowledgment V 2 Message with each field marked present by fields before it there exactly where they say *)
SettleTradeCaptureReportAcknowledgmentV2Message(message) ==
    LET settled1 == [message EXCEPT !.tradeCaptureReportAcknowledgmentV2ReturnBitfield1 = IF message.numberOfReturnBitfields >= 1 THEN (IF message.tradeCaptureReportAcknowledgmentV2ReturnBitfield1 = << >> THEN <<0>> ELSE message.tradeCaptureReportAcknowledgmentV2ReturnBitfield1) ELSE << >>]
        settled2 == [settled1 EXCEPT !.tradeCaptureReportAcknowledgmentV2ReturnBitfield2 = IF settled1.numberOfReturnBitfields >= 2 THEN (IF settled1.tradeCaptureReportAcknowledgmentV2ReturnBitfield2 = << >> THEN <<0>> ELSE settled1.tradeCaptureReportAcknowledgmentV2ReturnBitfield2) ELSE << >>]
        settled3 == [settled2 EXCEPT !.tradeCaptureReportAcknowledgmentV2ReturnBitfield3 = IF settled2.numberOfReturnBitfields >= 3 THEN (IF settled2.tradeCaptureReportAcknowledgmentV2ReturnBitfield3 = << >> THEN <<0>> ELSE settled2.tradeCaptureReportAcknowledgmentV2ReturnBitfield3) ELSE << >>]
        settled4 == [settled3 EXCEPT !.tradeCaptureReportAcknowledgmentV2ReturnBitfield4 = IF settled3.numberOfReturnBitfields >= 4 THEN (IF settled3.tradeCaptureReportAcknowledgmentV2ReturnBitfield4 = << >> THEN <<0>> ELSE settled3.tradeCaptureReportAcknowledgmentV2ReturnBitfield4) ELSE << >>]
        settled5 == [settled4 EXCEPT !.tradeCaptureReportAcknowledgmentV2ReturnBitfield5 = IF settled4.numberOfReturnBitfields >= 5 THEN (IF settled4.tradeCaptureReportAcknowledgmentV2ReturnBitfield5 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled4.tradeCaptureReportAcknowledgmentV2ReturnBitfield5) ELSE << >>]
        settled6 == [settled5 EXCEPT !.tradeCaptureReportAcknowledgmentV2ReturnBitfield6 = IF settled5.numberOfReturnBitfields >= 6 THEN (IF settled5.tradeCaptureReportAcknowledgmentV2ReturnBitfield6 = << >> THEN <<0>> ELSE settled5.tradeCaptureReportAcknowledgmentV2ReturnBitfield6) ELSE << >>]
        settled7 == [settled6 EXCEPT !.tradeCaptureReportAcknowledgmentV2ReturnBitfield7 = IF settled6.numberOfReturnBitfields >= 7 THEN (IF settled6.tradeCaptureReportAcknowledgmentV2ReturnBitfield7 = << >> THEN <<0>> ELSE settled6.tradeCaptureReportAcknowledgmentV2ReturnBitfield7) ELSE << >>]
        settled8 == [settled7 EXCEPT !.tradeCaptureReportAcknowledgmentV2ReturnBitfield8 = IF settled7.numberOfReturnBitfields >= 8 THEN (IF settled7.tradeCaptureReportAcknowledgmentV2ReturnBitfield8 = << >> THEN <<0>> ELSE settled7.tradeCaptureReportAcknowledgmentV2ReturnBitfield8) ELSE << >>]
        settled9 == [settled8 EXCEPT !.tradeCaptureReportAcknowledgmentV2ReturnBitfield9 = IF settled8.numberOfReturnBitfields >= 9 THEN (IF settled8.tradeCaptureReportAcknowledgmentV2ReturnBitfield9 = << >> THEN <<0>> ELSE settled8.tradeCaptureReportAcknowledgmentV2ReturnBitfield9) ELSE << >>]
        settled10 == [settled9 EXCEPT !.tradeCaptureReportAcknowledgmentV2ReturnBitfield10 = IF settled9.numberOfReturnBitfields >= 10 THEN (IF settled9.tradeCaptureReportAcknowledgmentV2ReturnBitfield10 = << >> THEN <<0>> ELSE settled9.tradeCaptureReportAcknowledgmentV2ReturnBitfield10) ELSE << >>]
        settled11 == [settled10 EXCEPT !.tradeCaptureReportAcknowledgmentV2ReturnBitfield11 = IF settled10.numberOfReturnBitfields >= 11 THEN (IF settled10.tradeCaptureReportAcknowledgmentV2ReturnBitfield11 = << >> THEN <<0>> ELSE settled10.tradeCaptureReportAcknowledgmentV2ReturnBitfield11) ELSE << >>]
        settled12 == [settled11 EXCEPT !.tradeCaptureReportAcknowledgmentV2ReturnBitfield12 = IF settled11.numberOfReturnBitfields >= 12 THEN (IF settled11.tradeCaptureReportAcknowledgmentV2ReturnBitfield12 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled11.tradeCaptureReportAcknowledgmentV2ReturnBitfield12) ELSE << >>]
        settled13 == [settled12 EXCEPT !.tradeCaptureReportAcknowledgmentV2ReturnBitfield13 = IF settled12.numberOfReturnBitfields >= 13 THEN (IF settled12.tradeCaptureReportAcknowledgmentV2ReturnBitfield13 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled12.tradeCaptureReportAcknowledgmentV2ReturnBitfield13) ELSE << >>]
        settled14 == [settled13 EXCEPT !.tradeCaptureReportAcknowledgmentV2ReturnBitfield14 = IF settled13.numberOfReturnBitfields >= 14 THEN (IF settled13.tradeCaptureReportAcknowledgmentV2ReturnBitfield14 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled13.tradeCaptureReportAcknowledgmentV2ReturnBitfield14) ELSE << >>]
        settled15 == [settled14 EXCEPT !.tradeCaptureReportAcknowledgmentV2ReturnBitfield15 = IF settled14.numberOfReturnBitfields >= 15 THEN (IF settled14.tradeCaptureReportAcknowledgmentV2ReturnBitfield15 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled14.tradeCaptureReportAcknowledgmentV2ReturnBitfield15) ELSE << >>]
        settled16 == [settled15 EXCEPT !.tradeCaptureReportAcknowledgmentV2ReturnBitfield16 = IF settled15.numberOfReturnBitfields >= 16 THEN (IF settled15.tradeCaptureReportAcknowledgmentV2ReturnBitfield16 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled15.tradeCaptureReportAcknowledgmentV2ReturnBitfield16) ELSE << >>]
        settled17 == [settled16 EXCEPT !.tradeCaptureReportAcknowledgmentV2ReturnBitfield17 = IF settled16.numberOfReturnBitfields >= 17 THEN (IF settled16.tradeCaptureReportAcknowledgmentV2ReturnBitfield17 = << >> THEN <<0>> ELSE settled16.tradeCaptureReportAcknowledgmentV2ReturnBitfield17) ELSE << >>]
        settled18 == [settled17 EXCEPT !.tradeCaptureReportAcknowledgmentV2ReturnBitfield18 = IF settled17.numberOfReturnBitfields >= 18 THEN (IF settled17.tradeCaptureReportAcknowledgmentV2ReturnBitfield18 = << >> THEN <<0>> ELSE settled17.tradeCaptureReportAcknowledgmentV2ReturnBitfield18) ELSE << >>]
        settled19 == [settled18 EXCEPT !.tradeCaptureReportAcknowledgmentV2ReturnBitfield19 = IF settled18.numberOfReturnBitfields >= 19 THEN (IF settled18.tradeCaptureReportAcknowledgmentV2ReturnBitfield19 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled18.tradeCaptureReportAcknowledgmentV2ReturnBitfield19) ELSE << >>]
        settled20 == [settled19 EXCEPT !.trdCapAckSideGrp = [i \in DOMAIN settled19.trdCapAckSideGrp |-> SettleTrdCapAckSideGrp(settled19.trdCapAckSideGrp[i], settled19.numberOfReturnBitfields, settled19.tradeCaptureReportAcknowledgmentV2ReturnBitfield1, settled19.tradeCaptureReportAcknowledgmentV2ReturnBitfield2, settled19.tradeCaptureReportAcknowledgmentV2ReturnBitfield3, settled19.tradeCaptureReportAcknowledgmentV2ReturnBitfield4, settled19.tradeCaptureReportAcknowledgmentV2ReturnBitfield6, settled19.tradeCaptureReportAcknowledgmentV2ReturnBitfield17, settled19.tradeCaptureReportAcknowledgmentV2ReturnBitfield18)]]
        settled21 == [settled20 EXCEPT !.symbolLong = IF settled20.numberOfReturnBitfields >= 2 /\ (settled20.tradeCaptureReportAcknowledgmentV2ReturnBitfield2 # << >> /\ settled20.tradeCaptureReportAcknowledgmentV2ReturnBitfield2[1] % 2 > 0) THEN (IF settled20.symbolLong = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled20.symbolLong) ELSE << >>]
        settled22 == [settled21 EXCEPT !.idSource = IF settled21.numberOfReturnBitfields >= 2 /\ (settled21.tradeCaptureReportAcknowledgmentV2ReturnBitfield2 # << >> /\ (settled21.tradeCaptureReportAcknowledgmentV2ReturnBitfield2[1] \div 8) % 2 > 0) THEN (IF settled21.idSource = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled21.idSource) ELSE << >>]
        settled23 == [settled22 EXCEPT !.securityId = IF settled22.numberOfReturnBitfields >= 2 /\ (settled22.tradeCaptureReportAcknowledgmentV2ReturnBitfield2 # << >> /\ (settled22.tradeCaptureReportAcknowledgmentV2ReturnBitfield2[1] \div 16) % 2 > 0) THEN (IF settled22.securityId = << >> THEN <<[i \in 1 .. 16 |-> 0]>> ELSE settled22.securityId) ELSE << >>]
        settled24 == [settled23 EXCEPT !.clearingFirm = IF settled23.numberOfReturnBitfields >= 3 /\ (settled23.tradeCaptureReportAcknowledgmentV2ReturnBitfield3 # << >> /\ (settled23.tradeCaptureReportAcknowledgmentV2ReturnBitfield3[1] \div 2) % 2 > 0) THEN (IF settled23.clearingFirm = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled23.clearingFirm) ELSE << >>]
        settled25 == [settled24 EXCEPT !.orderQty = IF settled24.numberOfReturnBitfields >= 3 /\ (settled24.tradeCaptureReportAcknowledgmentV2ReturnBitfield3 # << >> /\ (settled24.tradeCaptureReportAcknowledgmentV2ReturnBitfield3[1] \div 64) % 2 > 0) THEN (IF settled24.orderQty = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled24.orderQty) ELSE << >>]
        settled26 == [settled25 EXCEPT !.extExecInst = IF settled25.numberOfReturnBitfields >= 6 /\ (settled25.tradeCaptureReportAcknowledgmentV2ReturnBitfield6 # << >> /\ (settled25.tradeCaptureReportAcknowledgmentV2ReturnBitfield6[1] \div 16) % 2 > 0) THEN (IF settled25.extExecInst = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled25.extExecInst) ELSE << >>]
        settled27 == [settled26 EXCEPT !.tradeReportTypeReturn = IF settled26.numberOfReturnBitfields >= 7 /\ (settled26.tradeCaptureReportAcknowledgmentV2ReturnBitfield7 # << >> /\ (settled26.tradeCaptureReportAcknowledgmentV2ReturnBitfield7[1] \div 2) % 2 > 0) THEN (IF settled26.tradeReportTypeReturn = << >> THEN <<[i \in 1 .. 2 |-> 0]>> ELSE settled26.tradeReportTypeReturn) ELSE << >>]
        settled28 == [settled27 EXCEPT !.tradeReportRefId = IF settled27.numberOfReturnBitfields >= 8 /\ (settled27.tradeCaptureReportAcknowledgmentV2ReturnBitfield8 # << >> /\ (settled27.tradeCaptureReportAcknowledgmentV2ReturnBitfield8[1] \div 128) % 2 > 0) THEN (IF settled27.tradeReportRefId = << >> THEN <<[i \in 1 .. 20 |-> 0]>> ELSE settled27.tradeReportRefId) ELSE << >>]
        settled29 == [settled28 EXCEPT !.orderCategory = IF settled28.numberOfReturnBitfields >= 9 /\ (settled28.tradeCaptureReportAcknowledgmentV2ReturnBitfield9 # << >> /\ (settled28.tradeCaptureReportAcknowledgmentV2ReturnBitfield9[1] \div 8) % 2 > 0) THEN (IF settled28.orderCategory = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled28.orderCategory) ELSE << >>]
        settled30 == [settled29 EXCEPT !.liquidityProvision = IF settled29.numberOfReturnBitfields >= 9 /\ (settled29.tradeCaptureReportAcknowledgmentV2ReturnBitfield9 # << >> /\ (settled29.tradeCaptureReportAcknowledgmentV2ReturnBitfield9[1] \div 16) % 2 > 0) THEN (IF settled29.liquidityProvision = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled29.liquidityProvision) ELSE << >>]
        settled31 == [settled30 EXCEPT !.priceFormation = IF settled30.numberOfReturnBitfields >= 10 /\ (settled30.tradeCaptureReportAcknowledgmentV2ReturnBitfield10 # << >> /\ (settled30.tradeCaptureReportAcknowledgmentV2ReturnBitfield10[1] \div 64) % 2 > 0) THEN (IF settled30.priceFormation = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled30.priceFormation) ELSE << >>]
        settled32 == [settled31 EXCEPT !.algorithmicIndicator = IF settled31.numberOfReturnBitfields >= 11 /\ (settled31.tradeCaptureReportAcknowledgmentV2ReturnBitfield11 # << >> /\ (settled31.tradeCaptureReportAcknowledgmentV2ReturnBitfield11[1] \div 16) % 2 > 0) THEN (IF settled31.algorithmicIndicator = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled31.algorithmicIndicator) ELSE << >>]
    IN  settled32

ZeroTradeCaptureReportAcknowledgmentV2Message ==
    SettleTradeCaptureReportAcknowledgmentV2Message([ transactionTime                                    |-> [i \in 1 .. 8 |-> 0],
                                                      tradeReportId                                      |-> [i \in 1 .. 20 |-> 0],
                                                      reserved1                                          |-> [i \in 1 .. 1 |-> 0],
                                                      numberOfReturnBitfields                            |-> 0,
                                                      tradeCaptureReportAcknowledgmentV2ReturnBitfield1  |-> << >>,
                                                      tradeCaptureReportAcknowledgmentV2ReturnBitfield2  |-> << >>,
                                                      tradeCaptureReportAcknowledgmentV2ReturnBitfield3  |-> << >>,
                                                      tradeCaptureReportAcknowledgmentV2ReturnBitfield4  |-> << >>,
                                                      tradeCaptureReportAcknowledgmentV2ReturnBitfield5  |-> << >>,
                                                      tradeCaptureReportAcknowledgmentV2ReturnBitfield6  |-> << >>,
                                                      tradeCaptureReportAcknowledgmentV2ReturnBitfield7  |-> << >>,
                                                      tradeCaptureReportAcknowledgmentV2ReturnBitfield8  |-> << >>,
                                                      tradeCaptureReportAcknowledgmentV2ReturnBitfield9  |-> << >>,
                                                      tradeCaptureReportAcknowledgmentV2ReturnBitfield10 |-> << >>,
                                                      tradeCaptureReportAcknowledgmentV2ReturnBitfield11 |-> << >>,
                                                      tradeCaptureReportAcknowledgmentV2ReturnBitfield12 |-> << >>,
                                                      tradeCaptureReportAcknowledgmentV2ReturnBitfield13 |-> << >>,
                                                      tradeCaptureReportAcknowledgmentV2ReturnBitfield14 |-> << >>,
                                                      tradeCaptureReportAcknowledgmentV2ReturnBitfield15 |-> << >>,
                                                      tradeCaptureReportAcknowledgmentV2ReturnBitfield16 |-> << >>,
                                                      tradeCaptureReportAcknowledgmentV2ReturnBitfield17 |-> << >>,
                                                      tradeCaptureReportAcknowledgmentV2ReturnBitfield18 |-> << >>,
                                                      tradeCaptureReportAcknowledgmentV2ReturnBitfield19 |-> << >>,
                                                      trdCapAckSideGrp                                   |-> << >>,
                                                      symbolLong                                         |-> << >>,
                                                      idSource                                           |-> << >>,
                                                      securityId                                         |-> << >>,
                                                      clearingFirm                                       |-> << >>,
                                                      orderQty                                           |-> << >>,
                                                      extExecInst                                        |-> << >>,
                                                      tradeReportTypeReturn                              |-> << >>,
                                                      tradeReportRefId                                   |-> << >>,
                                                      orderCategory                                      |-> << >>,
                                                      liquidityProvision                                 |-> << >>,
                                                      priceFormation                                     |-> << >>,
                                                      algorithmicIndicator                               |-> << >> ])

(* Trade Capture Report Acknowledgment V 2 Message at zero, then each field in turn at the values it is checked at *)
CheckedTradeCaptureReportAcknowledgmentV2Message ==
    { ZeroTradeCaptureReportAcknowledgmentV2Message }
        \cup { SettleTradeCaptureReportAcknowledgmentV2Message([ZeroTradeCaptureReportAcknowledgmentV2Message EXCEPT !.transactionTime = one]) : one \in Sample(8) }
        \cup { SettleTradeCaptureReportAcknowledgmentV2Message([ZeroTradeCaptureReportAcknowledgmentV2Message EXCEPT !.tradeReportId = one]) : one \in Sample(20) }
        \cup { SettleTradeCaptureReportAcknowledgmentV2Message([ZeroTradeCaptureReportAcknowledgmentV2Message EXCEPT !.reserved1 = one]) : one \in Sample(1) }
        \cup { SettleTradeCaptureReportAcknowledgmentV2Message([ZeroTradeCaptureReportAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = one]) : one \in {0, 1, 255} }
        \cup { SettleTradeCaptureReportAcknowledgmentV2Message([ZeroTradeCaptureReportAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 1, !.tradeCaptureReportAcknowledgmentV2ReturnBitfield1 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleTradeCaptureReportAcknowledgmentV2Message([ZeroTradeCaptureReportAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 2, !.tradeCaptureReportAcknowledgmentV2ReturnBitfield2 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleTradeCaptureReportAcknowledgmentV2Message([ZeroTradeCaptureReportAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 3, !.tradeCaptureReportAcknowledgmentV2ReturnBitfield3 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleTradeCaptureReportAcknowledgmentV2Message([ZeroTradeCaptureReportAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 4, !.tradeCaptureReportAcknowledgmentV2ReturnBitfield4 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleTradeCaptureReportAcknowledgmentV2Message([ZeroTradeCaptureReportAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 5, !.tradeCaptureReportAcknowledgmentV2ReturnBitfield5 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCaptureReportAcknowledgmentV2Message([ZeroTradeCaptureReportAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 6, !.tradeCaptureReportAcknowledgmentV2ReturnBitfield6 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleTradeCaptureReportAcknowledgmentV2Message([ZeroTradeCaptureReportAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 7, !.tradeCaptureReportAcknowledgmentV2ReturnBitfield7 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleTradeCaptureReportAcknowledgmentV2Message([ZeroTradeCaptureReportAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 8, !.tradeCaptureReportAcknowledgmentV2ReturnBitfield8 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleTradeCaptureReportAcknowledgmentV2Message([ZeroTradeCaptureReportAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 9, !.tradeCaptureReportAcknowledgmentV2ReturnBitfield9 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleTradeCaptureReportAcknowledgmentV2Message([ZeroTradeCaptureReportAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 10, !.tradeCaptureReportAcknowledgmentV2ReturnBitfield10 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleTradeCaptureReportAcknowledgmentV2Message([ZeroTradeCaptureReportAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 11, !.tradeCaptureReportAcknowledgmentV2ReturnBitfield11 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleTradeCaptureReportAcknowledgmentV2Message([ZeroTradeCaptureReportAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 12, !.tradeCaptureReportAcknowledgmentV2ReturnBitfield12 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCaptureReportAcknowledgmentV2Message([ZeroTradeCaptureReportAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 13, !.tradeCaptureReportAcknowledgmentV2ReturnBitfield13 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCaptureReportAcknowledgmentV2Message([ZeroTradeCaptureReportAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 14, !.tradeCaptureReportAcknowledgmentV2ReturnBitfield14 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCaptureReportAcknowledgmentV2Message([ZeroTradeCaptureReportAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 15, !.tradeCaptureReportAcknowledgmentV2ReturnBitfield15 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCaptureReportAcknowledgmentV2Message([ZeroTradeCaptureReportAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 16, !.tradeCaptureReportAcknowledgmentV2ReturnBitfield16 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCaptureReportAcknowledgmentV2Message([ZeroTradeCaptureReportAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 17, !.tradeCaptureReportAcknowledgmentV2ReturnBitfield17 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleTradeCaptureReportAcknowledgmentV2Message([ZeroTradeCaptureReportAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 18, !.tradeCaptureReportAcknowledgmentV2ReturnBitfield18 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleTradeCaptureReportAcknowledgmentV2Message([ZeroTradeCaptureReportAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 19, !.tradeCaptureReportAcknowledgmentV2ReturnBitfield19 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCaptureReportAcknowledgmentV2Message([ZeroTradeCaptureReportAcknowledgmentV2Message EXCEPT !.trdCapAckSideGrp = one]) : one \in SampleLists(OneTrdCapAckSideGrp) }
        \cup { SettleTradeCaptureReportAcknowledgmentV2Message([ZeroTradeCaptureReportAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 1, !.tradeCaptureReportAcknowledgmentV2ReturnBitfield1 = <<1>>, !.trdCapAckSideGrp = one]) : one \in SampleLists(OneTrdCapAckSideGrp) }
        \cup { SettleTradeCaptureReportAcknowledgmentV2Message([ZeroTradeCaptureReportAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 2, !.tradeCaptureReportAcknowledgmentV2ReturnBitfield2 = <<64>>, !.trdCapAckSideGrp = one]) : one \in SampleLists(OneTrdCapAckSideGrp) }
        \cup { SettleTradeCaptureReportAcknowledgmentV2Message([ZeroTradeCaptureReportAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 3, !.tradeCaptureReportAcknowledgmentV2ReturnBitfield3 = <<1>>, !.trdCapAckSideGrp = one]) : one \in SampleLists(OneTrdCapAckSideGrp) }
        \cup { SettleTradeCaptureReportAcknowledgmentV2Message([ZeroTradeCaptureReportAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 4, !.tradeCaptureReportAcknowledgmentV2ReturnBitfield4 = <<64>>, !.trdCapAckSideGrp = one]) : one \in SampleLists(OneTrdCapAckSideGrp) }
        \cup { SettleTradeCaptureReportAcknowledgmentV2Message([ZeroTradeCaptureReportAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 6, !.tradeCaptureReportAcknowledgmentV2ReturnBitfield6 = <<128>>, !.trdCapAckSideGrp = one]) : one \in SampleLists(OneTrdCapAckSideGrp) }
        \cup { SettleTradeCaptureReportAcknowledgmentV2Message([ZeroTradeCaptureReportAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 4, !.tradeCaptureReportAcknowledgmentV2ReturnBitfield4 = <<8>>, !.trdCapAckSideGrp = one]) : one \in SampleLists(OneTrdCapAckSideGrp) }
        \cup { SettleTradeCaptureReportAcknowledgmentV2Message([ZeroTradeCaptureReportAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 17, !.tradeCaptureReportAcknowledgmentV2ReturnBitfield17 = <<128>>, !.trdCapAckSideGrp = one]) : one \in SampleLists(OneTrdCapAckSideGrp) }
        \cup { SettleTradeCaptureReportAcknowledgmentV2Message([ZeroTradeCaptureReportAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 18, !.tradeCaptureReportAcknowledgmentV2ReturnBitfield18 = <<1>>, !.trdCapAckSideGrp = one]) : one \in SampleLists(OneTrdCapAckSideGrp) }
        \cup { SettleTradeCaptureReportAcknowledgmentV2Message([ZeroTradeCaptureReportAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 2, !.tradeCaptureReportAcknowledgmentV2ReturnBitfield2 = <<1>>, !.symbolLong = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleTradeCaptureReportAcknowledgmentV2Message([ZeroTradeCaptureReportAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 2, !.tradeCaptureReportAcknowledgmentV2ReturnBitfield2 = <<8>>, !.idSource = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCaptureReportAcknowledgmentV2Message([ZeroTradeCaptureReportAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 2, !.tradeCaptureReportAcknowledgmentV2ReturnBitfield2 = <<16>>, !.securityId = one]) : one \in { <<held>> : held \in Sample(16) } }
        \cup { SettleTradeCaptureReportAcknowledgmentV2Message([ZeroTradeCaptureReportAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 3, !.tradeCaptureReportAcknowledgmentV2ReturnBitfield3 = <<2>>, !.clearingFirm = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleTradeCaptureReportAcknowledgmentV2Message([ZeroTradeCaptureReportAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 3, !.tradeCaptureReportAcknowledgmentV2ReturnBitfield3 = <<64>>, !.orderQty = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleTradeCaptureReportAcknowledgmentV2Message([ZeroTradeCaptureReportAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 6, !.tradeCaptureReportAcknowledgmentV2ReturnBitfield6 = <<16>>, !.extExecInst = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCaptureReportAcknowledgmentV2Message([ZeroTradeCaptureReportAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 7, !.tradeCaptureReportAcknowledgmentV2ReturnBitfield7 = <<2>>, !.tradeReportTypeReturn = one]) : one \in { <<held>> : held \in Sample(2) } }
        \cup { SettleTradeCaptureReportAcknowledgmentV2Message([ZeroTradeCaptureReportAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 8, !.tradeCaptureReportAcknowledgmentV2ReturnBitfield8 = <<128>>, !.tradeReportRefId = one]) : one \in { <<held>> : held \in Sample(20) } }
        \cup { SettleTradeCaptureReportAcknowledgmentV2Message([ZeroTradeCaptureReportAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 9, !.tradeCaptureReportAcknowledgmentV2ReturnBitfield9 = <<8>>, !.orderCategory = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCaptureReportAcknowledgmentV2Message([ZeroTradeCaptureReportAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 9, !.tradeCaptureReportAcknowledgmentV2ReturnBitfield9 = <<16>>, !.liquidityProvision = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCaptureReportAcknowledgmentV2Message([ZeroTradeCaptureReportAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 10, !.tradeCaptureReportAcknowledgmentV2ReturnBitfield10 = <<64>>, !.priceFormation = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleTradeCaptureReportAcknowledgmentV2Message([ZeroTradeCaptureReportAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 11, !.tradeCaptureReportAcknowledgmentV2ReturnBitfield11 = <<16>>, !.algorithmicIndicator = one]) : one \in { <<held>> : held \in Sample(1) } }

(***************************************************************************)
(* Trade Capture Report Reject V 2 Trd Cap Ack Side Grp                    *)
(***************************************************************************)

TradeCaptureReportRejectV2TrdCapAckSideGrp ==
    [ side                  : { << >> } \cup { <<held>> : held \in Sample(1) },
      capacity              : { << >> } \cup { <<held>> : held \in Sample(1) },
      account               : { << >> } \cup { <<held>> : held \in Sample(16) },
      partyId               : { << >> } \cup { <<held>> : held \in Sample(4) },
      partyRole             : { << >> } \cup { <<held>> : held \in Sample(1) },
      openClose             : { << >> } \cup { <<held>> : held \in Sample(1) },
      custOrderHandlingInst : { << >> } \cup { <<held>> : held \in Sample(1) },
      accountType           : { << >> } \cup { <<held>> : held \in Sample(1) } ]

EncodeTradeCaptureReportRejectV2TrdCapAckSideGrp(message) ==
    (IF message.side = << >> THEN << >> ELSE message.side[1])
        \o (IF message.capacity = << >> THEN << >> ELSE message.capacity[1])
        \o (IF message.account = << >> THEN << >> ELSE message.account[1])
        \o (IF message.partyId = << >> THEN << >> ELSE message.partyId[1])
        \o (IF message.partyRole = << >> THEN << >> ELSE message.partyRole[1])
        \o (IF message.openClose = << >> THEN << >> ELSE message.openClose[1])
        \o (IF message.custOrderHandlingInst = << >> THEN << >> ELSE message.custOrderHandlingInst[1])
        \o (IF message.accountType = << >> THEN << >> ELSE message.accountType[1])

DecodeTradeCaptureReportRejectV2TrdCapAckSideGrp(bytes, handedNumberOfReturnBitfields, handedTradeCaptureReportRejectV2ReturnBitfield1, handedTradeCaptureReportRejectV2ReturnBitfield2, handedTradeCaptureReportRejectV2ReturnBitfield3, handedTradeCaptureReportRejectV2ReturnBitfield4, handedTradeCaptureReportRejectV2ReturnBitfield6, handedTradeCaptureReportRejectV2ReturnBitfield17, handedTradeCaptureReportRejectV2ReturnBitfield18) ==
    LET side == ReadWhen(handedNumberOfReturnBitfields >= 1 /\ (handedTradeCaptureReportRejectV2ReturnBitfield1 # << >> /\ handedTradeCaptureReportRejectV2ReturnBitfield1[1] % 2 > 0), ReadBytes(bytes, 1), bytes) IN IF ~side.ok THEN Fail ELSE
    LET capacity == ReadWhen(handedNumberOfReturnBitfields >= 2 /\ (handedTradeCaptureReportRejectV2ReturnBitfield2 # << >> /\ (handedTradeCaptureReportRejectV2ReturnBitfield2[1] \div 64) % 2 > 0), ReadBytes(side.rest, 1), side.rest) IN IF ~capacity.ok THEN Fail ELSE
    LET account == ReadWhen(handedNumberOfReturnBitfields >= 3 /\ (handedTradeCaptureReportRejectV2ReturnBitfield3 # << >> /\ handedTradeCaptureReportRejectV2ReturnBitfield3[1] % 2 > 0), ReadBytes(capacity.rest, 16), capacity.rest) IN IF ~account.ok THEN Fail ELSE
    LET partyId == ReadWhen(handedNumberOfReturnBitfields >= 4 /\ (handedTradeCaptureReportRejectV2ReturnBitfield4 # << >> /\ (handedTradeCaptureReportRejectV2ReturnBitfield4[1] \div 64) % 2 > 0), ReadBytes(account.rest, 4), account.rest) IN IF ~partyId.ok THEN Fail ELSE
    LET partyRole == ReadWhen(handedNumberOfReturnBitfields >= 6 /\ (handedTradeCaptureReportRejectV2ReturnBitfield6 # << >> /\ (handedTradeCaptureReportRejectV2ReturnBitfield6[1] \div 128) % 2 > 0), ReadBytes(partyId.rest, 1), partyId.rest) IN IF ~partyRole.ok THEN Fail ELSE
    LET openClose == ReadWhen(handedNumberOfReturnBitfields >= 4 /\ (handedTradeCaptureReportRejectV2ReturnBitfield4 # << >> /\ (handedTradeCaptureReportRejectV2ReturnBitfield4[1] \div 8) % 2 > 0), ReadBytes(partyRole.rest, 1), partyRole.rest) IN IF ~openClose.ok THEN Fail ELSE
    LET custOrderHandlingInst == ReadWhen(handedNumberOfReturnBitfields >= 17 /\ (handedTradeCaptureReportRejectV2ReturnBitfield17 # << >> /\ (handedTradeCaptureReportRejectV2ReturnBitfield17[1] \div 128) % 2 > 0), ReadBytes(openClose.rest, 1), openClose.rest) IN IF ~custOrderHandlingInst.ok THEN Fail ELSE
    LET accountType == ReadWhen(handedNumberOfReturnBitfields >= 18 /\ (handedTradeCaptureReportRejectV2ReturnBitfield18 # << >> /\ handedTradeCaptureReportRejectV2ReturnBitfield18[1] % 2 > 0), ReadBytes(custOrderHandlingInst.rest, 1), custOrderHandlingInst.rest) IN IF ~accountType.ok THEN Fail ELSE
    Ok([ side                  |-> side.value,
         capacity              |-> capacity.value,
         account               |-> account.value,
         partyId               |-> partyId.value,
         partyRole             |-> partyRole.value,
         openClose             |-> openClose.value,
         custOrderHandlingInst |-> custOrderHandlingInst.value,
         accountType           |-> accountType.value ], accountType.rest)

(* Trade Capture Report Reject V 2 Trd Cap Ack Side Grp with each field marked present by fields before it there exactly where they say *)
SettleTradeCaptureReportRejectV2TrdCapAckSideGrp(message, handedNumberOfReturnBitfields, handedTradeCaptureReportRejectV2ReturnBitfield1, handedTradeCaptureReportRejectV2ReturnBitfield2, handedTradeCaptureReportRejectV2ReturnBitfield3, handedTradeCaptureReportRejectV2ReturnBitfield4, handedTradeCaptureReportRejectV2ReturnBitfield6, handedTradeCaptureReportRejectV2ReturnBitfield17, handedTradeCaptureReportRejectV2ReturnBitfield18) ==
    LET settled1 == [message EXCEPT !.side = IF handedNumberOfReturnBitfields >= 1 /\ (handedTradeCaptureReportRejectV2ReturnBitfield1 # << >> /\ handedTradeCaptureReportRejectV2ReturnBitfield1[1] % 2 > 0) THEN (IF message.side = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE message.side) ELSE << >>]
        settled2 == [settled1 EXCEPT !.capacity = IF handedNumberOfReturnBitfields >= 2 /\ (handedTradeCaptureReportRejectV2ReturnBitfield2 # << >> /\ (handedTradeCaptureReportRejectV2ReturnBitfield2[1] \div 64) % 2 > 0) THEN (IF settled1.capacity = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled1.capacity) ELSE << >>]
        settled3 == [settled2 EXCEPT !.account = IF handedNumberOfReturnBitfields >= 3 /\ (handedTradeCaptureReportRejectV2ReturnBitfield3 # << >> /\ handedTradeCaptureReportRejectV2ReturnBitfield3[1] % 2 > 0) THEN (IF settled2.account = << >> THEN <<[i \in 1 .. 16 |-> 0]>> ELSE settled2.account) ELSE << >>]
        settled4 == [settled3 EXCEPT !.partyId = IF handedNumberOfReturnBitfields >= 4 /\ (handedTradeCaptureReportRejectV2ReturnBitfield4 # << >> /\ (handedTradeCaptureReportRejectV2ReturnBitfield4[1] \div 64) % 2 > 0) THEN (IF settled3.partyId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled3.partyId) ELSE << >>]
        settled5 == [settled4 EXCEPT !.partyRole = IF handedNumberOfReturnBitfields >= 6 /\ (handedTradeCaptureReportRejectV2ReturnBitfield6 # << >> /\ (handedTradeCaptureReportRejectV2ReturnBitfield6[1] \div 128) % 2 > 0) THEN (IF settled4.partyRole = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled4.partyRole) ELSE << >>]
        settled6 == [settled5 EXCEPT !.openClose = IF handedNumberOfReturnBitfields >= 4 /\ (handedTradeCaptureReportRejectV2ReturnBitfield4 # << >> /\ (handedTradeCaptureReportRejectV2ReturnBitfield4[1] \div 8) % 2 > 0) THEN (IF settled5.openClose = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled5.openClose) ELSE << >>]
        settled7 == [settled6 EXCEPT !.custOrderHandlingInst = IF handedNumberOfReturnBitfields >= 17 /\ (handedTradeCaptureReportRejectV2ReturnBitfield17 # << >> /\ (handedTradeCaptureReportRejectV2ReturnBitfield17[1] \div 128) % 2 > 0) THEN (IF settled6.custOrderHandlingInst = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled6.custOrderHandlingInst) ELSE << >>]
        settled8 == [settled7 EXCEPT !.accountType = IF handedNumberOfReturnBitfields >= 18 /\ (handedTradeCaptureReportRejectV2ReturnBitfield18 # << >> /\ handedTradeCaptureReportRejectV2ReturnBitfield18[1] % 2 > 0) THEN (IF settled7.accountType = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled7.accountType) ELSE << >>]
    IN  settled8

ZeroTradeCaptureReportRejectV2TrdCapAckSideGrp ==
    SettleTradeCaptureReportRejectV2TrdCapAckSideGrp([ side                  |-> << >>,
                                                       capacity              |-> << >>,
                                                       account               |-> << >>,
                                                       partyId               |-> << >>,
                                                       partyRole             |-> << >>,
                                                       openClose             |-> << >>,
                                                       custOrderHandlingInst |-> << >>,
                                                       accountType           |-> << >> ], 0, << >>, << >>, << >>, << >>, << >>, << >>, << >>)

(* Trade Capture Report Reject V 2 Trd Cap Ack Side Grp at zero, then each field in turn at the values it is checked at *)
CheckedTradeCaptureReportRejectV2TrdCapAckSideGrp ==
    { [given |-> <<0, << >>, << >>, << >>, << >>, << >>, << >>, << >>>>, message |-> ZeroTradeCaptureReportRejectV2TrdCapAckSideGrp] }
        \cup { [given |-> <<1, <<1>>, << >>, << >>, << >>, << >>, << >>, << >>>>, message |-> SettleTradeCaptureReportRejectV2TrdCapAckSideGrp([ZeroTradeCaptureReportRejectV2TrdCapAckSideGrp EXCEPT !.side = one], 1, <<1>>, << >>, << >>, << >>, << >>, << >>, << >>)] : one \in { <<held>> : held \in Sample(1) } }
        \cup { [given |-> <<2, << >>, <<64>>, << >>, << >>, << >>, << >>, << >>>>, message |-> SettleTradeCaptureReportRejectV2TrdCapAckSideGrp([ZeroTradeCaptureReportRejectV2TrdCapAckSideGrp EXCEPT !.capacity = one], 2, << >>, <<64>>, << >>, << >>, << >>, << >>, << >>)] : one \in { <<held>> : held \in Sample(1) } }
        \cup { [given |-> <<3, << >>, << >>, <<1>>, << >>, << >>, << >>, << >>>>, message |-> SettleTradeCaptureReportRejectV2TrdCapAckSideGrp([ZeroTradeCaptureReportRejectV2TrdCapAckSideGrp EXCEPT !.account = one], 3, << >>, << >>, <<1>>, << >>, << >>, << >>, << >>)] : one \in { <<held>> : held \in Sample(16) } }
        \cup { [given |-> <<4, << >>, << >>, << >>, <<64>>, << >>, << >>, << >>>>, message |-> SettleTradeCaptureReportRejectV2TrdCapAckSideGrp([ZeroTradeCaptureReportRejectV2TrdCapAckSideGrp EXCEPT !.partyId = one], 4, << >>, << >>, << >>, <<64>>, << >>, << >>, << >>)] : one \in { <<held>> : held \in Sample(4) } }
        \cup { [given |-> <<6, << >>, << >>, << >>, << >>, <<128>>, << >>, << >>>>, message |-> SettleTradeCaptureReportRejectV2TrdCapAckSideGrp([ZeroTradeCaptureReportRejectV2TrdCapAckSideGrp EXCEPT !.partyRole = one], 6, << >>, << >>, << >>, << >>, <<128>>, << >>, << >>)] : one \in { <<held>> : held \in Sample(1) } }
        \cup { [given |-> <<4, << >>, << >>, << >>, <<8>>, << >>, << >>, << >>>>, message |-> SettleTradeCaptureReportRejectV2TrdCapAckSideGrp([ZeroTradeCaptureReportRejectV2TrdCapAckSideGrp EXCEPT !.openClose = one], 4, << >>, << >>, << >>, <<8>>, << >>, << >>, << >>)] : one \in { <<held>> : held \in Sample(1) } }
        \cup { [given |-> <<17, << >>, << >>, << >>, << >>, << >>, <<128>>, << >>>>, message |-> SettleTradeCaptureReportRejectV2TrdCapAckSideGrp([ZeroTradeCaptureReportRejectV2TrdCapAckSideGrp EXCEPT !.custOrderHandlingInst = one], 17, << >>, << >>, << >>, << >>, << >>, <<128>>, << >>)] : one \in { <<held>> : held \in Sample(1) } }
        \cup { [given |-> <<18, << >>, << >>, << >>, << >>, << >>, << >>, <<1>>>>, message |-> SettleTradeCaptureReportRejectV2TrdCapAckSideGrp([ZeroTradeCaptureReportRejectV2TrdCapAckSideGrp EXCEPT !.accountType = one], 18, << >>, << >>, << >>, << >>, << >>, << >>, <<1>>)] : one \in { <<held>> : held \in Sample(1) } }

(* A run of Trade Capture Report Reject V 2 Trd Cap Ack Side Grp, written one after another *)
RECURSIVE EncodeTradeCaptureReportRejectV2TrdCapAckSideGrpList(_)
EncodeTradeCaptureReportRejectV2TrdCapAckSideGrpList(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeTradeCaptureReportRejectV2TrdCapAckSideGrp(Head(messages)) \o EncodeTradeCaptureReportRejectV2TrdCapAckSideGrpList(Tail(messages))

(* As many Trade Capture Report Reject V 2 Trd Cap Ack Side Grp as the field that counts them says *)
RECURSIVE ReadTradeCaptureReportRejectV2TrdCapAckSideGrpList(_, _, _, _, _, _, _, _, _, _)
ReadTradeCaptureReportRejectV2TrdCapAckSideGrpList(bytes, count, handedNumberOfReturnBitfields, handedTradeCaptureReportRejectV2ReturnBitfield1, handedTradeCaptureReportRejectV2ReturnBitfield2, handedTradeCaptureReportRejectV2ReturnBitfield3, handedTradeCaptureReportRejectV2ReturnBitfield4, handedTradeCaptureReportRejectV2ReturnBitfield6, handedTradeCaptureReportRejectV2ReturnBitfield17, handedTradeCaptureReportRejectV2ReturnBitfield18) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeTradeCaptureReportRejectV2TrdCapAckSideGrp(bytes, handedNumberOfReturnBitfields, handedTradeCaptureReportRejectV2ReturnBitfield1, handedTradeCaptureReportRejectV2ReturnBitfield2, handedTradeCaptureReportRejectV2ReturnBitfield3, handedTradeCaptureReportRejectV2ReturnBitfield4, handedTradeCaptureReportRejectV2ReturnBitfield6, handedTradeCaptureReportRejectV2ReturnBitfield17, handedTradeCaptureReportRejectV2ReturnBitfield18)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadTradeCaptureReportRejectV2TrdCapAckSideGrpList(one.rest, count - 1, handedNumberOfReturnBitfields, handedTradeCaptureReportRejectV2ReturnBitfield1, handedTradeCaptureReportRejectV2ReturnBitfield2, handedTradeCaptureReportRejectV2ReturnBitfield3, handedTradeCaptureReportRejectV2ReturnBitfield4, handedTradeCaptureReportRejectV2ReturnBitfield6, handedTradeCaptureReportRejectV2ReturnBitfield17, handedTradeCaptureReportRejectV2ReturnBitfield18)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Trade Capture Report Reject V 2 Trd Cap Ack Side Grp of each kind, for the lists that carry them *)
OneTradeCaptureReportRejectV2TrdCapAckSideGrp == { ZeroTradeCaptureReportRejectV2TrdCapAckSideGrp }

(***************************************************************************)
(* Trade Capture Report Reject V 2 Message                                 *)
(***************************************************************************)

TradeCaptureReportRejectV2Message ==
    [ transactionTime                            : Sample(8),
      tradeReportId                              : Sample(20),
      reason                                     : Sample(1),
      text                                       : Sample(60),
      reserved1                                  : Sample(1),
      numberOfReturnBitfields                    : 0 .. 255,
      tradeCaptureReportRejectV2ReturnBitfield1  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      tradeCaptureReportRejectV2ReturnBitfield2  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      tradeCaptureReportRejectV2ReturnBitfield3  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      tradeCaptureReportRejectV2ReturnBitfield4  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      tradeCaptureReportRejectV2ReturnBitfield5  : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeCaptureReportRejectV2ReturnBitfield6  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      tradeCaptureReportRejectV2ReturnBitfield7  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      tradeCaptureReportRejectV2ReturnBitfield8  : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeCaptureReportRejectV2ReturnBitfield9  : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeCaptureReportRejectV2ReturnBitfield10 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      tradeCaptureReportRejectV2ReturnBitfield11 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      tradeCaptureReportRejectV2ReturnBitfield12 : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeCaptureReportRejectV2ReturnBitfield13 : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeCaptureReportRejectV2ReturnBitfield14 : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeCaptureReportRejectV2ReturnBitfield15 : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeCaptureReportRejectV2ReturnBitfield16 : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeCaptureReportRejectV2ReturnBitfield17 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      tradeCaptureReportRejectV2ReturnBitfield18 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      tradeCaptureReportRejectV2ReturnBitfield19 : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeCaptureReportRejectV2TrdCapAckSideGrp : SampleLists(OneTradeCaptureReportRejectV2TrdCapAckSideGrp),
      symbolLong                                 : { << >> } \cup { <<held>> : held \in Sample(8) },
      idSource                                   : { << >> } \cup { <<held>> : held \in Sample(1) },
      securityId                                 : { << >> } \cup { <<held>> : held \in Sample(16) },
      clearingFirm                               : { << >> } \cup { <<held>> : held \in Sample(4) },
      orderQty                                   : { << >> } \cup { <<held>> : held \in Sample(4) },
      extExecInst                                : { << >> } \cup { <<held>> : held \in Sample(1) },
      tradeReportTypeReturn                      : { << >> } \cup { <<held>> : held \in Sample(2) },
      tradePublishIndicator                      : { << >> } \cup { <<held>> : held \in Sample(1) },
      rptTime                                    : { << >> } \cup { <<held>> : held \in Sample(8) },
      priceFormation                             : { << >> } \cup { <<held>> : held \in Sample(1) },
      algorithmicIndicator                       : { << >> } \cup { <<held>> : held \in Sample(1) } ]

EncodeTradeCaptureReportRejectV2Message(message) ==
    message.transactionTime
        \o message.tradeReportId
        \o message.reason
        \o message.text
        \o message.reserved1
        \o EncodeUIntBE(message.numberOfReturnBitfields, 1)
        \o (IF message.tradeCaptureReportRejectV2ReturnBitfield1 = << >> THEN << >> ELSE EncodeUIntLE(message.tradeCaptureReportRejectV2ReturnBitfield1[1], 1))
        \o (IF message.tradeCaptureReportRejectV2ReturnBitfield2 = << >> THEN << >> ELSE EncodeUIntLE(message.tradeCaptureReportRejectV2ReturnBitfield2[1], 1))
        \o (IF message.tradeCaptureReportRejectV2ReturnBitfield3 = << >> THEN << >> ELSE EncodeUIntLE(message.tradeCaptureReportRejectV2ReturnBitfield3[1], 1))
        \o (IF message.tradeCaptureReportRejectV2ReturnBitfield4 = << >> THEN << >> ELSE EncodeUIntLE(message.tradeCaptureReportRejectV2ReturnBitfield4[1], 1))
        \o (IF message.tradeCaptureReportRejectV2ReturnBitfield5 = << >> THEN << >> ELSE message.tradeCaptureReportRejectV2ReturnBitfield5[1])
        \o (IF message.tradeCaptureReportRejectV2ReturnBitfield6 = << >> THEN << >> ELSE EncodeUIntLE(message.tradeCaptureReportRejectV2ReturnBitfield6[1], 1))
