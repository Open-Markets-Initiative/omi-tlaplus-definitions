(* Quote Restated Message: 52 bytes                                        *)
(***************************************************************************)

QuoteRestatedMessage ==
    [ transactionTime   : Sample(8),
      quoteUpdateId     : Sample(16),
      orderId           : Sample(8),
      leavesQty         : Sample(4),
      workingPrice      : Sample(8),
      symbolShort       : Sample(6),
      side              : Sample(1),
      restatementReason : Sample(1) ]

EncodeQuoteRestatedMessage(message) ==
    message.transactionTime
        \o message.quoteUpdateId
        \o message.orderId
        \o message.leavesQty
        \o message.workingPrice
        \o message.symbolShort
        \o message.side
        \o message.restatementReason

DecodeQuoteRestatedMessage(bytes) ==
    LET transactionTime == ReadBytes(bytes, 8) IN IF ~transactionTime.ok THEN Fail ELSE
    LET quoteUpdateId == ReadBytes(transactionTime.rest, 16) IN IF ~quoteUpdateId.ok THEN Fail ELSE
    LET orderId == ReadBytes(quoteUpdateId.rest, 8) IN IF ~orderId.ok THEN Fail ELSE
    LET leavesQty == ReadBytes(orderId.rest, 4) IN IF ~leavesQty.ok THEN Fail ELSE
    LET workingPrice == ReadBytes(leavesQty.rest, 8) IN IF ~workingPrice.ok THEN Fail ELSE
    LET symbolShort == ReadBytes(workingPrice.rest, 6) IN IF ~symbolShort.ok THEN Fail ELSE
    LET side == ReadBytes(symbolShort.rest, 1) IN IF ~side.ok THEN Fail ELSE
    LET restatementReason == ReadBytes(side.rest, 1) IN IF ~restatementReason.ok THEN Fail ELSE
    Ok([ transactionTime   |-> transactionTime.value,
         quoteUpdateId     |-> quoteUpdateId.value,
         orderId           |-> orderId.value,
         leavesQty         |-> leavesQty.value,
         workingPrice      |-> workingPrice.value,
         symbolShort       |-> symbolShort.value,
         side              |-> side.value,
         restatementReason |-> restatementReason.value ], restatementReason.rest)

ZeroQuoteRestatedMessage ==
    [ transactionTime   |-> [i \in 1 .. 8 |-> 0],
      quoteUpdateId     |-> [i \in 1 .. 16 |-> 0],
      orderId           |-> [i \in 1 .. 8 |-> 0],
      leavesQty         |-> [i \in 1 .. 4 |-> 0],
      workingPrice      |-> [i \in 1 .. 8 |-> 0],
      symbolShort       |-> [i \in 1 .. 6 |-> 0],
      side              |-> [i \in 1 .. 1 |-> 0],
      restatementReason |-> [i \in 1 .. 1 |-> 0] ]

(* Quote Restated Message at zero, then each field in turn at the values it is checked at *)
CheckedQuoteRestatedMessage ==
    { ZeroQuoteRestatedMessage }
        \cup { [ZeroQuoteRestatedMessage EXCEPT !.transactionTime = one] : one \in Sample(8) }
        \cup { [ZeroQuoteRestatedMessage EXCEPT !.quoteUpdateId = one] : one \in Sample(16) }
        \cup { [ZeroQuoteRestatedMessage EXCEPT !.orderId = one] : one \in Sample(8) }
        \cup { [ZeroQuoteRestatedMessage EXCEPT !.leavesQty = one] : one \in Sample(4) }
        \cup { [ZeroQuoteRestatedMessage EXCEPT !.workingPrice = one] : one \in Sample(8) }
        \cup { [ZeroQuoteRestatedMessage EXCEPT !.symbolShort = one] : one \in Sample(6) }
        \cup { [ZeroQuoteRestatedMessage EXCEPT !.side = one] : one \in Sample(1) }
        \cup { [ZeroQuoteRestatedMessage EXCEPT !.restatementReason = one] : one \in Sample(1) }

(***************************************************************************)
(* User Modify Rejected V 2 Message                                        *)
(***************************************************************************)

UserModifyRejectedV2Message ==
    [ transactionTime                      : Sample(8),
      clOrdId                              : Sample(20),
      modifyRejectReason                   : Sample(1),
      text                                 : Sample(60),
      reserved1                            : Sample(1),
      numberOfReturnBitfields              : 0 .. 255,
      userModifyRejectedV2ReturnBitfield1  : { << >> } \cup { <<held>> : held \in Sample(1) },
      userModifyRejectedV2ReturnBitfield2  : { << >> } \cup { <<held>> : held \in Sample(1) },
      userModifyRejectedV2ReturnBitfield3  : { << >> } \cup { <<held>> : held \in Sample(1) },
      userModifyRejectedV2ReturnBitfield4  : { << >> } \cup { <<held>> : held \in Sample(1) },
      userModifyRejectedV2ReturnBitfield5  : { << >> } \cup { <<held>> : held \in Sample(1) },
      userModifyRejectedV2ReturnBitfield6  : { << >> } \cup { <<held>> : held \in Sample(1) },
      userModifyRejectedV2ReturnBitfield7  : { << >> } \cup { <<held>> : held \in Sample(1) },
      userModifyRejectedV2ReturnBitfield8  : { << >> } \cup { <<held>> : held \in Sample(1) },
      userModifyRejectedV2ReturnBitfield9  : { << >> } \cup { <<held>> : held \in Sample(1) },
      userModifyRejectedV2ReturnBitfield10 : { << >> } \cup { <<held>> : held \in Sample(1) },
      userModifyRejectedV2ReturnBitfield11 : { << >> } \cup { <<held>> : held \in Sample(1) },
      userModifyRejectedV2ReturnBitfield12 : { << >> } \cup { <<held>> : held \in Sample(1) },
      userModifyRejectedV2ReturnBitfield13 : { << >> } \cup { <<held>> : held \in Sample(1) },
      userModifyRejectedV2ReturnBitfield14 : { << >> } \cup { <<held>> : held \in Sample(1) },
      userModifyRejectedV2ReturnBitfield15 : { << >> } \cup { <<held>> : held \in Sample(1) },
      userModifyRejectedV2ReturnBitfield16 : { << >> } \cup { <<held>> : held \in Sample(1) },
      userModifyRejectedV2ReturnBitfield17 : { << >> } \cup { <<held>> : held \in Sample(1) },
      userModifyRejectedV2ReturnBitfield18 : { << >> } \cup { <<held>> : held \in Sample(1) },
      userModifyRejectedV2ReturnBitfield19 : { << >> } \cup { <<held>> : held \in Sample(1) } ]

EncodeUserModifyRejectedV2Message(message) ==
    message.transactionTime
        \o message.clOrdId
        \o message.modifyRejectReason
        \o message.text
        \o message.reserved1
        \o EncodeUIntBE(message.numberOfReturnBitfields, 1)
        \o (IF message.userModifyRejectedV2ReturnBitfield1 = << >> THEN << >> ELSE message.userModifyRejectedV2ReturnBitfield1[1])
        \o (IF message.userModifyRejectedV2ReturnBitfield2 = << >> THEN << >> ELSE message.userModifyRejectedV2ReturnBitfield2[1])
        \o (IF message.userModifyRejectedV2ReturnBitfield3 = << >> THEN << >> ELSE message.userModifyRejectedV2ReturnBitfield3[1])
        \o (IF message.userModifyRejectedV2ReturnBitfield4 = << >> THEN << >> ELSE message.userModifyRejectedV2ReturnBitfield4[1])
        \o (IF message.userModifyRejectedV2ReturnBitfield5 = << >> THEN << >> ELSE message.userModifyRejectedV2ReturnBitfield5[1])
        \o (IF message.userModifyRejectedV2ReturnBitfield6 = << >> THEN << >> ELSE message.userModifyRejectedV2ReturnBitfield6[1])
        \o (IF message.userModifyRejectedV2ReturnBitfield7 = << >> THEN << >> ELSE message.userModifyRejectedV2ReturnBitfield7[1])
        \o (IF message.userModifyRejectedV2ReturnBitfield8 = << >> THEN << >> ELSE message.userModifyRejectedV2ReturnBitfield8[1])
        \o (IF message.userModifyRejectedV2ReturnBitfield9 = << >> THEN << >> ELSE message.userModifyRejectedV2ReturnBitfield9[1])
        \o (IF message.userModifyRejectedV2ReturnBitfield10 = << >> THEN << >> ELSE message.userModifyRejectedV2ReturnBitfield10[1])
        \o (IF message.userModifyRejectedV2ReturnBitfield11 = << >> THEN << >> ELSE message.userModifyRejectedV2ReturnBitfield11[1])
        \o (IF message.userModifyRejectedV2ReturnBitfield12 = << >> THEN << >> ELSE message.userModifyRejectedV2ReturnBitfield12[1])
        \o (IF message.userModifyRejectedV2ReturnBitfield13 = << >> THEN << >> ELSE message.userModifyRejectedV2ReturnBitfield13[1])
        \o (IF message.userModifyRejectedV2ReturnBitfield14 = << >> THEN << >> ELSE message.userModifyRejectedV2ReturnBitfield14[1])
        \o (IF message.userModifyRejectedV2ReturnBitfield15 = << >> THEN << >> ELSE message.userModifyRejectedV2ReturnBitfield15[1])
        \o (IF message.userModifyRejectedV2ReturnBitfield16 = << >> THEN << >> ELSE message.userModifyRejectedV2ReturnBitfield16[1])
        \o (IF message.userModifyRejectedV2ReturnBitfield17 = << >> THEN << >> ELSE message.userModifyRejectedV2ReturnBitfield17[1])
        \o (IF message.userModifyRejectedV2ReturnBitfield18 = << >> THEN << >> ELSE message.userModifyRejectedV2ReturnBitfield18[1])
        \o (IF message.userModifyRejectedV2ReturnBitfield19 = << >> THEN << >> ELSE message.userModifyRejectedV2ReturnBitfield19[1])

DecodeUserModifyRejectedV2Message(bytes) ==
    LET transactionTime == ReadBytes(bytes, 8) IN IF ~transactionTime.ok THEN Fail ELSE
    LET clOrdId == ReadBytes(transactionTime.rest, 20) IN IF ~clOrdId.ok THEN Fail ELSE
    LET modifyRejectReason == ReadBytes(clOrdId.rest, 1) IN IF ~modifyRejectReason.ok THEN Fail ELSE
    LET text == ReadBytes(modifyRejectReason.rest, 60) IN IF ~text.ok THEN Fail ELSE
    LET reserved1 == ReadBytes(text.rest, 1) IN IF ~reserved1.ok THEN Fail ELSE
    LET numberOfReturnBitfields == ReadUIntBE(reserved1.rest, 1) IN IF ~numberOfReturnBitfields.ok THEN Fail ELSE
    LET userModifyRejectedV2ReturnBitfield1 == ReadWhen(numberOfReturnBitfields.value >= 1, ReadBytes(numberOfReturnBitfields.rest, 1), numberOfReturnBitfields.rest) IN IF ~userModifyRejectedV2ReturnBitfield1.ok THEN Fail ELSE
    LET userModifyRejectedV2ReturnBitfield2 == ReadWhen(numberOfReturnBitfields.value >= 2, ReadBytes(userModifyRejectedV2ReturnBitfield1.rest, 1), userModifyRejectedV2ReturnBitfield1.rest) IN IF ~userModifyRejectedV2ReturnBitfield2.ok THEN Fail ELSE
    LET userModifyRejectedV2ReturnBitfield3 == ReadWhen(numberOfReturnBitfields.value >= 3, ReadBytes(userModifyRejectedV2ReturnBitfield2.rest, 1), userModifyRejectedV2ReturnBitfield2.rest) IN IF ~userModifyRejectedV2ReturnBitfield3.ok THEN Fail ELSE
    LET userModifyRejectedV2ReturnBitfield4 == ReadWhen(numberOfReturnBitfields.value >= 4, ReadBytes(userModifyRejectedV2ReturnBitfield3.rest, 1), userModifyRejectedV2ReturnBitfield3.rest) IN IF ~userModifyRejectedV2ReturnBitfield4.ok THEN Fail ELSE
    LET userModifyRejectedV2ReturnBitfield5 == ReadWhen(numberOfReturnBitfields.value >= 5, ReadBytes(userModifyRejectedV2ReturnBitfield4.rest, 1), userModifyRejectedV2ReturnBitfield4.rest) IN IF ~userModifyRejectedV2ReturnBitfield5.ok THEN Fail ELSE
    LET userModifyRejectedV2ReturnBitfield6 == ReadWhen(numberOfReturnBitfields.value >= 6, ReadBytes(userModifyRejectedV2ReturnBitfield5.rest, 1), userModifyRejectedV2ReturnBitfield5.rest) IN IF ~userModifyRejectedV2ReturnBitfield6.ok THEN Fail ELSE
    LET userModifyRejectedV2ReturnBitfield7 == ReadWhen(numberOfReturnBitfields.value >= 7, ReadBytes(userModifyRejectedV2ReturnBitfield6.rest, 1), userModifyRejectedV2ReturnBitfield6.rest) IN IF ~userModifyRejectedV2ReturnBitfield7.ok THEN Fail ELSE
    LET userModifyRejectedV2ReturnBitfield8 == ReadWhen(numberOfReturnBitfields.value >= 8, ReadBytes(userModifyRejectedV2ReturnBitfield7.rest, 1), userModifyRejectedV2ReturnBitfield7.rest) IN IF ~userModifyRejectedV2ReturnBitfield8.ok THEN Fail ELSE
    LET userModifyRejectedV2ReturnBitfield9 == ReadWhen(numberOfReturnBitfields.value >= 9, ReadBytes(userModifyRejectedV2ReturnBitfield8.rest, 1), userModifyRejectedV2ReturnBitfield8.rest) IN IF ~userModifyRejectedV2ReturnBitfield9.ok THEN Fail ELSE
    LET userModifyRejectedV2ReturnBitfield10 == ReadWhen(numberOfReturnBitfields.value >= 10, ReadBytes(userModifyRejectedV2ReturnBitfield9.rest, 1), userModifyRejectedV2ReturnBitfield9.rest) IN IF ~userModifyRejectedV2ReturnBitfield10.ok THEN Fail ELSE
    LET userModifyRejectedV2ReturnBitfield11 == ReadWhen(numberOfReturnBitfields.value >= 11, ReadBytes(userModifyRejectedV2ReturnBitfield10.rest, 1), userModifyRejectedV2ReturnBitfield10.rest) IN IF ~userModifyRejectedV2ReturnBitfield11.ok THEN Fail ELSE
    LET userModifyRejectedV2ReturnBitfield12 == ReadWhen(numberOfReturnBitfields.value >= 12, ReadBytes(userModifyRejectedV2ReturnBitfield11.rest, 1), userModifyRejectedV2ReturnBitfield11.rest) IN IF ~userModifyRejectedV2ReturnBitfield12.ok THEN Fail ELSE
    LET userModifyRejectedV2ReturnBitfield13 == ReadWhen(numberOfReturnBitfields.value >= 13, ReadBytes(userModifyRejectedV2ReturnBitfield12.rest, 1), userModifyRejectedV2ReturnBitfield12.rest) IN IF ~userModifyRejectedV2ReturnBitfield13.ok THEN Fail ELSE
    LET userModifyRejectedV2ReturnBitfield14 == ReadWhen(numberOfReturnBitfields.value >= 14, ReadBytes(userModifyRejectedV2ReturnBitfield13.rest, 1), userModifyRejectedV2ReturnBitfield13.rest) IN IF ~userModifyRejectedV2ReturnBitfield14.ok THEN Fail ELSE
    LET userModifyRejectedV2ReturnBitfield15 == ReadWhen(numberOfReturnBitfields.value >= 15, ReadBytes(userModifyRejectedV2ReturnBitfield14.rest, 1), userModifyRejectedV2ReturnBitfield14.rest) IN IF ~userModifyRejectedV2ReturnBitfield15.ok THEN Fail ELSE
    LET userModifyRejectedV2ReturnBitfield16 == ReadWhen(numberOfReturnBitfields.value >= 16, ReadBytes(userModifyRejectedV2ReturnBitfield15.rest, 1), userModifyRejectedV2ReturnBitfield15.rest) IN IF ~userModifyRejectedV2ReturnBitfield16.ok THEN Fail ELSE
    LET userModifyRejectedV2ReturnBitfield17 == ReadWhen(numberOfReturnBitfields.value >= 17, ReadBytes(userModifyRejectedV2ReturnBitfield16.rest, 1), userModifyRejectedV2ReturnBitfield16.rest) IN IF ~userModifyRejectedV2ReturnBitfield17.ok THEN Fail ELSE
    LET userModifyRejectedV2ReturnBitfield18 == ReadWhen(numberOfReturnBitfields.value >= 18, ReadBytes(userModifyRejectedV2ReturnBitfield17.rest, 1), userModifyRejectedV2ReturnBitfield17.rest) IN IF ~userModifyRejectedV2ReturnBitfield18.ok THEN Fail ELSE
    LET userModifyRejectedV2ReturnBitfield19 == ReadWhen(numberOfReturnBitfields.value >= 19, ReadBytes(userModifyRejectedV2ReturnBitfield18.rest, 1), userModifyRejectedV2ReturnBitfield18.rest) IN IF ~userModifyRejectedV2ReturnBitfield19.ok THEN Fail ELSE
    Ok([ transactionTime                      |-> transactionTime.value,
         clOrdId                              |-> clOrdId.value,
         modifyRejectReason                   |-> modifyRejectReason.value,
         text                                 |-> text.value,
         reserved1                            |-> reserved1.value,
         numberOfReturnBitfields              |-> numberOfReturnBitfields.value,
         userModifyRejectedV2ReturnBitfield1  |-> userModifyRejectedV2ReturnBitfield1.value,
         userModifyRejectedV2ReturnBitfield2  |-> userModifyRejectedV2ReturnBitfield2.value,
         userModifyRejectedV2ReturnBitfield3  |-> userModifyRejectedV2ReturnBitfield3.value,
         userModifyRejectedV2ReturnBitfield4  |-> userModifyRejectedV2ReturnBitfield4.value,
         userModifyRejectedV2ReturnBitfield5  |-> userModifyRejectedV2ReturnBitfield5.value,
         userModifyRejectedV2ReturnBitfield6  |-> userModifyRejectedV2ReturnBitfield6.value,
         userModifyRejectedV2ReturnBitfield7  |-> userModifyRejectedV2ReturnBitfield7.value,
         userModifyRejectedV2ReturnBitfield8  |-> userModifyRejectedV2ReturnBitfield8.value,
         userModifyRejectedV2ReturnBitfield9  |-> userModifyRejectedV2ReturnBitfield9.value,
         userModifyRejectedV2ReturnBitfield10 |-> userModifyRejectedV2ReturnBitfield10.value,
         userModifyRejectedV2ReturnBitfield11 |-> userModifyRejectedV2ReturnBitfield11.value,
         userModifyRejectedV2ReturnBitfield12 |-> userModifyRejectedV2ReturnBitfield12.value,
         userModifyRejectedV2ReturnBitfield13 |-> userModifyRejectedV2ReturnBitfield13.value,
         userModifyRejectedV2ReturnBitfield14 |-> userModifyRejectedV2ReturnBitfield14.value,
         userModifyRejectedV2ReturnBitfield15 |-> userModifyRejectedV2ReturnBitfield15.value,
         userModifyRejectedV2ReturnBitfield16 |-> userModifyRejectedV2ReturnBitfield16.value,
         userModifyRejectedV2ReturnBitfield17 |-> userModifyRejectedV2ReturnBitfield17.value,
         userModifyRejectedV2ReturnBitfield18 |-> userModifyRejectedV2ReturnBitfield18.value,
         userModifyRejectedV2ReturnBitfield19 |-> userModifyRejectedV2ReturnBitfield19.value ], userModifyRejectedV2ReturnBitfield19.rest)

(* User Modify Rejected V 2 Message with each field marked present by fields before it there exactly where they say *)
SettleUserModifyRejectedV2Message(message) ==
    LET settled1 == [message EXCEPT !.userModifyRejectedV2ReturnBitfield1 = IF message.numberOfReturnBitfields >= 1 THEN (IF message.userModifyRejectedV2ReturnBitfield1 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE message.userModifyRejectedV2ReturnBitfield1) ELSE << >>]
        settled2 == [settled1 EXCEPT !.userModifyRejectedV2ReturnBitfield2 = IF settled1.numberOfReturnBitfields >= 2 THEN (IF settled1.userModifyRejectedV2ReturnBitfield2 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled1.userModifyRejectedV2ReturnBitfield2) ELSE << >>]
        settled3 == [settled2 EXCEPT !.userModifyRejectedV2ReturnBitfield3 = IF settled2.numberOfReturnBitfields >= 3 THEN (IF settled2.userModifyRejectedV2ReturnBitfield3 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled2.userModifyRejectedV2ReturnBitfield3) ELSE << >>]
        settled4 == [settled3 EXCEPT !.userModifyRejectedV2ReturnBitfield4 = IF settled3.numberOfReturnBitfields >= 4 THEN (IF settled3.userModifyRejectedV2ReturnBitfield4 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled3.userModifyRejectedV2ReturnBitfield4) ELSE << >>]
        settled5 == [settled4 EXCEPT !.userModifyRejectedV2ReturnBitfield5 = IF settled4.numberOfReturnBitfields >= 5 THEN (IF settled4.userModifyRejectedV2ReturnBitfield5 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled4.userModifyRejectedV2ReturnBitfield5) ELSE << >>]
        settled6 == [settled5 EXCEPT !.userModifyRejectedV2ReturnBitfield6 = IF settled5.numberOfReturnBitfields >= 6 THEN (IF settled5.userModifyRejectedV2ReturnBitfield6 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled5.userModifyRejectedV2ReturnBitfield6) ELSE << >>]
        settled7 == [settled6 EXCEPT !.userModifyRejectedV2ReturnBitfield7 = IF settled6.numberOfReturnBitfields >= 7 THEN (IF settled6.userModifyRejectedV2ReturnBitfield7 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled6.userModifyRejectedV2ReturnBitfield7) ELSE << >>]
        settled8 == [settled7 EXCEPT !.userModifyRejectedV2ReturnBitfield8 = IF settled7.numberOfReturnBitfields >= 8 THEN (IF settled7.userModifyRejectedV2ReturnBitfield8 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled7.userModifyRejectedV2ReturnBitfield8) ELSE << >>]
        settled9 == [settled8 EXCEPT !.userModifyRejectedV2ReturnBitfield9 = IF settled8.numberOfReturnBitfields >= 9 THEN (IF settled8.userModifyRejectedV2ReturnBitfield9 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled8.userModifyRejectedV2ReturnBitfield9) ELSE << >>]
        settled10 == [settled9 EXCEPT !.userModifyRejectedV2ReturnBitfield10 = IF settled9.numberOfReturnBitfields >= 10 THEN (IF settled9.userModifyRejectedV2ReturnBitfield10 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled9.userModifyRejectedV2ReturnBitfield10) ELSE << >>]
        settled11 == [settled10 EXCEPT !.userModifyRejectedV2ReturnBitfield11 = IF settled10.numberOfReturnBitfields >= 11 THEN (IF settled10.userModifyRejectedV2ReturnBitfield11 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled10.userModifyRejectedV2ReturnBitfield11) ELSE << >>]
        settled12 == [settled11 EXCEPT !.userModifyRejectedV2ReturnBitfield12 = IF settled11.numberOfReturnBitfields >= 12 THEN (IF settled11.userModifyRejectedV2ReturnBitfield12 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled11.userModifyRejectedV2ReturnBitfield12) ELSE << >>]
        settled13 == [settled12 EXCEPT !.userModifyRejectedV2ReturnBitfield13 = IF settled12.numberOfReturnBitfields >= 13 THEN (IF settled12.userModifyRejectedV2ReturnBitfield13 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled12.userModifyRejectedV2ReturnBitfield13) ELSE << >>]
        settled14 == [settled13 EXCEPT !.userModifyRejectedV2ReturnBitfield14 = IF settled13.numberOfReturnBitfields >= 14 THEN (IF settled13.userModifyRejectedV2ReturnBitfield14 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled13.userModifyRejectedV2ReturnBitfield14) ELSE << >>]
        settled15 == [settled14 EXCEPT !.userModifyRejectedV2ReturnBitfield15 = IF settled14.numberOfReturnBitfields >= 15 THEN (IF settled14.userModifyRejectedV2ReturnBitfield15 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled14.userModifyRejectedV2ReturnBitfield15) ELSE << >>]
        settled16 == [settled15 EXCEPT !.userModifyRejectedV2ReturnBitfield16 = IF settled15.numberOfReturnBitfields >= 16 THEN (IF settled15.userModifyRejectedV2ReturnBitfield16 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled15.userModifyRejectedV2ReturnBitfield16) ELSE << >>]
        settled17 == [settled16 EXCEPT !.userModifyRejectedV2ReturnBitfield17 = IF settled16.numberOfReturnBitfields >= 17 THEN (IF settled16.userModifyRejectedV2ReturnBitfield17 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled16.userModifyRejectedV2ReturnBitfield17) ELSE << >>]
        settled18 == [settled17 EXCEPT !.userModifyRejectedV2ReturnBitfield18 = IF settled17.numberOfReturnBitfields >= 18 THEN (IF settled17.userModifyRejectedV2ReturnBitfield18 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled17.userModifyRejectedV2ReturnBitfield18) ELSE << >>]
        settled19 == [settled18 EXCEPT !.userModifyRejectedV2ReturnBitfield19 = IF settled18.numberOfReturnBitfields >= 19 THEN (IF settled18.userModifyRejectedV2ReturnBitfield19 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled18.userModifyRejectedV2ReturnBitfield19) ELSE << >>]
    IN  settled19

ZeroUserModifyRejectedV2Message ==
    SettleUserModifyRejectedV2Message([ transactionTime                      |-> [i \in 1 .. 8 |-> 0],
                                        clOrdId                              |-> [i \in 1 .. 20 |-> 0],
                                        modifyRejectReason                   |-> [i \in 1 .. 1 |-> 0],
                                        text                                 |-> [i \in 1 .. 60 |-> 0],
                                        reserved1                            |-> [i \in 1 .. 1 |-> 0],
                                        numberOfReturnBitfields              |-> 0,
                                        userModifyRejectedV2ReturnBitfield1  |-> << >>,
                                        userModifyRejectedV2ReturnBitfield2  |-> << >>,
                                        userModifyRejectedV2ReturnBitfield3  |-> << >>,
                                        userModifyRejectedV2ReturnBitfield4  |-> << >>,
                                        userModifyRejectedV2ReturnBitfield5  |-> << >>,
                                        userModifyRejectedV2ReturnBitfield6  |-> << >>,
                                        userModifyRejectedV2ReturnBitfield7  |-> << >>,
                                        userModifyRejectedV2ReturnBitfield8  |-> << >>,
                                        userModifyRejectedV2ReturnBitfield9  |-> << >>,
                                        userModifyRejectedV2ReturnBitfield10 |-> << >>,
                                        userModifyRejectedV2ReturnBitfield11 |-> << >>,
                                        userModifyRejectedV2ReturnBitfield12 |-> << >>,
                                        userModifyRejectedV2ReturnBitfield13 |-> << >>,
                                        userModifyRejectedV2ReturnBitfield14 |-> << >>,
                                        userModifyRejectedV2ReturnBitfield15 |-> << >>,
                                        userModifyRejectedV2ReturnBitfield16 |-> << >>,
                                        userModifyRejectedV2ReturnBitfield17 |-> << >>,
                                        userModifyRejectedV2ReturnBitfield18 |-> << >>,
                                        userModifyRejectedV2ReturnBitfield19 |-> << >> ])

(* User Modify Rejected V 2 Message at zero, then each field in turn at the values it is checked at *)
CheckedUserModifyRejectedV2Message ==
    { ZeroUserModifyRejectedV2Message }
        \cup { SettleUserModifyRejectedV2Message([ZeroUserModifyRejectedV2Message EXCEPT !.transactionTime = one]) : one \in Sample(8) }
        \cup { SettleUserModifyRejectedV2Message([ZeroUserModifyRejectedV2Message EXCEPT !.clOrdId = one]) : one \in Sample(20) }
        \cup { SettleUserModifyRejectedV2Message([ZeroUserModifyRejectedV2Message EXCEPT !.modifyRejectReason = one]) : one \in Sample(1) }
        \cup { SettleUserModifyRejectedV2Message([ZeroUserModifyRejectedV2Message EXCEPT !.text = one]) : one \in Sample(60) }
        \cup { SettleUserModifyRejectedV2Message([ZeroUserModifyRejectedV2Message EXCEPT !.reserved1 = one]) : one \in Sample(1) }
        \cup { SettleUserModifyRejectedV2Message([ZeroUserModifyRejectedV2Message EXCEPT !.numberOfReturnBitfields = one]) : one \in {0, 1, 255} }
        \cup { SettleUserModifyRejectedV2Message([ZeroUserModifyRejectedV2Message EXCEPT !.numberOfReturnBitfields = 1, !.userModifyRejectedV2ReturnBitfield1 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleUserModifyRejectedV2Message([ZeroUserModifyRejectedV2Message EXCEPT !.numberOfReturnBitfields = 2, !.userModifyRejectedV2ReturnBitfield2 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleUserModifyRejectedV2Message([ZeroUserModifyRejectedV2Message EXCEPT !.numberOfReturnBitfields = 3, !.userModifyRejectedV2ReturnBitfield3 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleUserModifyRejectedV2Message([ZeroUserModifyRejectedV2Message EXCEPT !.numberOfReturnBitfields = 4, !.userModifyRejectedV2ReturnBitfield4 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleUserModifyRejectedV2Message([ZeroUserModifyRejectedV2Message EXCEPT !.numberOfReturnBitfields = 5, !.userModifyRejectedV2ReturnBitfield5 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleUserModifyRejectedV2Message([ZeroUserModifyRejectedV2Message EXCEPT !.numberOfReturnBitfields = 6, !.userModifyRejectedV2ReturnBitfield6 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleUserModifyRejectedV2Message([ZeroUserModifyRejectedV2Message EXCEPT !.numberOfReturnBitfields = 7, !.userModifyRejectedV2ReturnBitfield7 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleUserModifyRejectedV2Message([ZeroUserModifyRejectedV2Message EXCEPT !.numberOfReturnBitfields = 8, !.userModifyRejectedV2ReturnBitfield8 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleUserModifyRejectedV2Message([ZeroUserModifyRejectedV2Message EXCEPT !.numberOfReturnBitfields = 9, !.userModifyRejectedV2ReturnBitfield9 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleUserModifyRejectedV2Message([ZeroUserModifyRejectedV2Message EXCEPT !.numberOfReturnBitfields = 10, !.userModifyRejectedV2ReturnBitfield10 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleUserModifyRejectedV2Message([ZeroUserModifyRejectedV2Message EXCEPT !.numberOfReturnBitfields = 11, !.userModifyRejectedV2ReturnBitfield11 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleUserModifyRejectedV2Message([ZeroUserModifyRejectedV2Message EXCEPT !.numberOfReturnBitfields = 12, !.userModifyRejectedV2ReturnBitfield12 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleUserModifyRejectedV2Message([ZeroUserModifyRejectedV2Message EXCEPT !.numberOfReturnBitfields = 13, !.userModifyRejectedV2ReturnBitfield13 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleUserModifyRejectedV2Message([ZeroUserModifyRejectedV2Message EXCEPT !.numberOfReturnBitfields = 14, !.userModifyRejectedV2ReturnBitfield14 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleUserModifyRejectedV2Message([ZeroUserModifyRejectedV2Message EXCEPT !.numberOfReturnBitfields = 15, !.userModifyRejectedV2ReturnBitfield15 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleUserModifyRejectedV2Message([ZeroUserModifyRejectedV2Message EXCEPT !.numberOfReturnBitfields = 16, !.userModifyRejectedV2ReturnBitfield16 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleUserModifyRejectedV2Message([ZeroUserModifyRejectedV2Message EXCEPT !.numberOfReturnBitfields = 17, !.userModifyRejectedV2ReturnBitfield17 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleUserModifyRejectedV2Message([ZeroUserModifyRejectedV2Message EXCEPT !.numberOfReturnBitfields = 18, !.userModifyRejectedV2ReturnBitfield18 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleUserModifyRejectedV2Message([ZeroUserModifyRejectedV2Message EXCEPT !.numberOfReturnBitfields = 19, !.userModifyRejectedV2ReturnBitfield19 = one]) : one \in { <<held>> : held \in Sample(1) } }

(***************************************************************************)
(* Order Cancelled V 2 Message                                             *)
(***************************************************************************)

OrderCancelledV2Message ==
    [ transactionTime                  : Sample(8),
      clOrdId                          : Sample(20),
      cancelReason                     : Sample(1),
      reserved1                        : Sample(1),
      numberOfReturnBitfields          : 0 .. 255,
      orderCancelledV2ReturnBitfield1  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderCancelledV2ReturnBitfield2  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderCancelledV2ReturnBitfield3  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderCancelledV2ReturnBitfield4  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderCancelledV2ReturnBitfield5  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderCancelledV2ReturnBitfield6  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderCancelledV2ReturnBitfield7  : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderCancelledV2ReturnBitfield8  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderCancelledV2ReturnBitfield9  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderCancelledV2ReturnBitfield10 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderCancelledV2ReturnBitfield11 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderCancelledV2ReturnBitfield12 : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderCancelledV2ReturnBitfield13 : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderCancelledV2ReturnBitfield14 : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderCancelledV2ReturnBitfield15 : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderCancelledV2ReturnBitfield16 : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderCancelledV2ReturnBitfield17 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderCancelledV2ReturnBitfield18 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderCancelledV2ReturnBitfield19 : { << >> } \cup { <<held>> : held \in Sample(1) },
      side                             : { << >> } \cup { <<held>> : held \in Sample(1) },
      price                            : { << >> } \cup { <<held>> : held \in Sample(8) },
      ordType                          : { << >> } \cup { <<held>> : held \in Sample(1) },
      timeInForce                      : { << >> } \cup { <<held>> : held \in Sample(1) },
      minQty                           : { << >> } \cup { <<held>> : held \in Sample(4) },
      symbolLong                       : { << >> } \cup { <<held>> : held \in Sample(8) },
      idSource                         : { << >> } \cup { <<held>> : held \in Sample(1) },
      securityId                       : { << >> } \cup { <<held>> : held \in Sample(16) },
      capacity                         : { << >> } \cup { <<held>> : held \in Sample(1) },
      account                          : { << >> } \cup { <<held>> : held \in Sample(16) },
      clearingFirm                     : { << >> } \cup { <<held>> : held \in Sample(4) },
      clearingAccount                  : { << >> } \cup { <<held>> : held \in Sample(4) },
      displayIndicator                 : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderQty                         : { << >> } \cup { <<held>> : held \in Sample(4) },
      preventMatch                     : { << >> } \cup { <<held>> : held \in Sample(3) },
      openClose                        : { << >> } \cup { <<held>> : held \in Sample(1) },
      origClOrdId                      : { << >> } \cup { <<held>> : held \in Sample(20) },
      leavesQty                        : { << >> } \cup { <<held>> : held \in Sample(4) },
      lastShares                       : { << >> } \cup { <<held>> : held \in Sample(4) },
      lastPx                           : { << >> } \cup { <<held>> : held \in Sample(8) },
      displayPrice                     : { << >> } \cup { <<held>> : held \in Sample(8) },
      workingPrice                     : { << >> } \cup { <<held>> : held \in Sample(8) },
      baseLiquidityIndicator           : { << >> } \cup { <<held>> : held \in Sample(1) },
      expireTime                       : { << >> } \cup { <<held>> : held \in Sample(8) },
      secondaryOrderId                 : { << >> } \cup { <<held>> : held \in Sample(8) },
      extExecInst                      : { << >> } \cup { <<held>> : held \in Sample(1) },
      stopPx                           : { << >> } \cup { <<held>> : held \in Sample(8) },
      routingInst                      : { << >> } \cup { <<held>> : held \in Sample(4) },
      liquidityProvision               : { << >> } \cup { <<held>> : held \in Sample(1) },
      clientQualifiedRole              : { << >> } \cup { <<held>> : held \in Sample(1) },
      clientId                         : { << >> } \cup { <<held>> : held \in Sample(4) },
      investorId                       : { << >> } \cup { <<held>> : held \in Sample(4) },
      executorId                       : { << >> } \cup { <<held>> : held \in Sample(4) },
      orderOrigination                 : { << >> } \cup { <<held>> : held \in Sample(1) },
      algorithmicIndicator             : { << >> } \cup { <<held>> : held \in Sample(1) },
      investorQualifiedRole            : { << >> } \cup { <<held>> : held \in Sample(1) },
      executorQualifiedRole            : { << >> } \cup { <<held>> : held \in Sample(1) },
      custOrderHandlingInst            : { << >> } \cup { <<held>> : held \in Sample(1) },
      subreason                        : { << >> } \cup { <<held>> : held \in Sample(1) } ]

EncodeOrderCancelledV2Message(message) ==
    message.transactionTime
        \o message.clOrdId
        \o message.cancelReason
        \o message.reserved1
        \o EncodeUIntBE(message.numberOfReturnBitfields, 1)
        \o (IF message.orderCancelledV2ReturnBitfield1 = << >> THEN << >> ELSE EncodeUIntLE(message.orderCancelledV2ReturnBitfield1[1], 1))
        \o (IF message.orderCancelledV2ReturnBitfield2 = << >> THEN << >> ELSE EncodeUIntLE(message.orderCancelledV2ReturnBitfield2[1], 1))
        \o (IF message.orderCancelledV2ReturnBitfield3 = << >> THEN << >> ELSE EncodeUIntLE(message.orderCancelledV2ReturnBitfield3[1], 1))
        \o (IF message.orderCancelledV2ReturnBitfield4 = << >> THEN << >> ELSE EncodeUIntLE(message.orderCancelledV2ReturnBitfield4[1], 1))
        \o (IF message.orderCancelledV2ReturnBitfield5 = << >> THEN << >> ELSE EncodeUIntLE(message.orderCancelledV2ReturnBitfield5[1], 1))
        \o (IF message.orderCancelledV2ReturnBitfield6 = << >> THEN << >> ELSE EncodeUIntLE(message.orderCancelledV2ReturnBitfield6[1], 1))
        \o (IF message.orderCancelledV2ReturnBitfield7 = << >> THEN << >> ELSE message.orderCancelledV2ReturnBitfield7[1])
        \o (IF message.orderCancelledV2ReturnBitfield8 = << >> THEN << >> ELSE EncodeUIntLE(message.orderCancelledV2ReturnBitfield8[1], 1))
        \o (IF message.orderCancelledV2ReturnBitfield9 = << >> THEN << >> ELSE EncodeUIntLE(message.orderCancelledV2ReturnBitfield9[1], 1))
        \o (IF message.orderCancelledV2ReturnBitfield10 = << >> THEN << >> ELSE EncodeUIntLE(message.orderCancelledV2ReturnBitfield10[1], 1))
        \o (IF message.orderCancelledV2ReturnBitfield11 = << >> THEN << >> ELSE EncodeUIntLE(message.orderCancelledV2ReturnBitfield11[1], 1))
        \o (IF message.orderCancelledV2ReturnBitfield12 = << >> THEN << >> ELSE message.orderCancelledV2ReturnBitfield12[1])
        \o (IF message.orderCancelledV2ReturnBitfield13 = << >> THEN << >> ELSE message.orderCancelledV2ReturnBitfield13[1])
        \o (IF message.orderCancelledV2ReturnBitfield14 = << >> THEN << >> ELSE message.orderCancelledV2ReturnBitfield14[1])
        \o (IF message.orderCancelledV2ReturnBitfield15 = << >> THEN << >> ELSE message.orderCancelledV2ReturnBitfield15[1])
        \o (IF message.orderCancelledV2ReturnBitfield16 = << >> THEN << >> ELSE message.orderCancelledV2ReturnBitfield16[1])
        \o (IF message.orderCancelledV2ReturnBitfield17 = << >> THEN << >> ELSE EncodeUIntLE(message.orderCancelledV2ReturnBitfield17[1], 1))
        \o (IF message.orderCancelledV2ReturnBitfield18 = << >> THEN << >> ELSE EncodeUIntLE(message.orderCancelledV2ReturnBitfield18[1], 1))
        \o (IF message.orderCancelledV2ReturnBitfield19 = << >> THEN << >> ELSE message.orderCancelledV2ReturnBitfield19[1])
        \o (IF message.side = << >> THEN << >> ELSE message.side[1])
        \o (IF message.price = << >> THEN << >> ELSE message.price[1])
        \o (IF message.ordType = << >> THEN << >> ELSE message.ordType[1])
        \o (IF message.timeInForce = << >> THEN << >> ELSE message.timeInForce[1])
        \o (IF message.minQty = << >> THEN << >> ELSE message.minQty[1])
        \o (IF message.symbolLong = << >> THEN << >> ELSE message.symbolLong[1])
        \o (IF message.idSource = << >> THEN << >> ELSE message.idSource[1])
        \o (IF message.securityId = << >> THEN << >> ELSE message.securityId[1])
        \o (IF message.capacity = << >> THEN << >> ELSE message.capacity[1])
        \o (IF message.account = << >> THEN << >> ELSE message.account[1])
        \o (IF message.clearingFirm = << >> THEN << >> ELSE message.clearingFirm[1])
        \o (IF message.clearingAccount = << >> THEN << >> ELSE message.clearingAccount[1])
        \o (IF message.displayIndicator = << >> THEN << >> ELSE message.displayIndicator[1])
        \o (IF message.orderQty = << >> THEN << >> ELSE message.orderQty[1])
        \o (IF message.preventMatch = << >> THEN << >> ELSE message.preventMatch[1])
        \o (IF message.openClose = << >> THEN << >> ELSE message.openClose[1])
        \o (IF message.origClOrdId = << >> THEN << >> ELSE message.origClOrdId[1])
        \o (IF message.leavesQty = << >> THEN << >> ELSE message.leavesQty[1])
        \o (IF message.lastShares = << >> THEN << >> ELSE message.lastShares[1])
        \o (IF message.lastPx = << >> THEN << >> ELSE message.lastPx[1])
        \o (IF message.displayPrice = << >> THEN << >> ELSE message.displayPrice[1])
        \o (IF message.workingPrice = << >> THEN << >> ELSE message.workingPrice[1])
        \o (IF message.baseLiquidityIndicator = << >> THEN << >> ELSE message.baseLiquidityIndicator[1])
        \o (IF message.expireTime = << >> THEN << >> ELSE message.expireTime[1])
        \o (IF message.secondaryOrderId = << >> THEN << >> ELSE message.secondaryOrderId[1])
        \o (IF message.extExecInst = << >> THEN << >> ELSE message.extExecInst[1])
        \o (IF message.stopPx = << >> THEN << >> ELSE message.stopPx[1])
        \o (IF message.routingInst = << >> THEN << >> ELSE message.routingInst[1])
        \o (IF message.liquidityProvision = << >> THEN << >> ELSE message.liquidityProvision[1])
        \o (IF message.clientQualifiedRole = << >> THEN << >> ELSE message.clientQualifiedRole[1])
        \o (IF message.clientId = << >> THEN << >> ELSE message.clientId[1])
        \o (IF message.investorId = << >> THEN << >> ELSE message.investorId[1])
        \o (IF message.executorId = << >> THEN << >> ELSE message.executorId[1])
        \o (IF message.orderOrigination = << >> THEN << >> ELSE message.orderOrigination[1])
        \o (IF message.algorithmicIndicator = << >> THEN << >> ELSE message.algorithmicIndicator[1])
        \o (IF message.investorQualifiedRole = << >> THEN << >> ELSE message.investorQualifiedRole[1])
        \o (IF message.executorQualifiedRole = << >> THEN << >> ELSE message.executorQualifiedRole[1])
        \o (IF message.custOrderHandlingInst = << >> THEN << >> ELSE message.custOrderHandlingInst[1])
        \o (IF message.subreason = << >> THEN << >> ELSE message.subreason[1])

DecodeOrderCancelledV2Message(bytes) ==
    LET transactionTime == ReadBytes(bytes, 8) IN IF ~transactionTime.ok THEN Fail ELSE
    LET clOrdId == ReadBytes(transactionTime.rest, 20) IN IF ~clOrdId.ok THEN Fail ELSE
    LET cancelReason == ReadBytes(clOrdId.rest, 1) IN IF ~cancelReason.ok THEN Fail ELSE
    LET reserved1 == ReadBytes(cancelReason.rest, 1) IN IF ~reserved1.ok THEN Fail ELSE
    LET numberOfReturnBitfields == ReadUIntBE(reserved1.rest, 1) IN IF ~numberOfReturnBitfields.ok THEN Fail ELSE
    LET orderCancelledV2ReturnBitfield1 == ReadWhen(numberOfReturnBitfields.value >= 1, ReadUIntLE(numberOfReturnBitfields.rest, 1), numberOfReturnBitfields.rest) IN IF ~orderCancelledV2ReturnBitfield1.ok THEN Fail ELSE
    LET orderCancelledV2ReturnBitfield2 == ReadWhen(numberOfReturnBitfields.value >= 2, ReadUIntLE(orderCancelledV2ReturnBitfield1.rest, 1), orderCancelledV2ReturnBitfield1.rest) IN IF ~orderCancelledV2ReturnBitfield2.ok THEN Fail ELSE
    LET orderCancelledV2ReturnBitfield3 == ReadWhen(numberOfReturnBitfields.value >= 3, ReadUIntLE(orderCancelledV2ReturnBitfield2.rest, 1), orderCancelledV2ReturnBitfield2.rest) IN IF ~orderCancelledV2ReturnBitfield3.ok THEN Fail ELSE
    LET orderCancelledV2ReturnBitfield4 == ReadWhen(numberOfReturnBitfields.value >= 4, ReadUIntLE(orderCancelledV2ReturnBitfield3.rest, 1), orderCancelledV2ReturnBitfield3.rest) IN IF ~orderCancelledV2ReturnBitfield4.ok THEN Fail ELSE
    LET orderCancelledV2ReturnBitfield5 == ReadWhen(numberOfReturnBitfields.value >= 5, ReadUIntLE(orderCancelledV2ReturnBitfield4.rest, 1), orderCancelledV2ReturnBitfield4.rest) IN IF ~orderCancelledV2ReturnBitfield5.ok THEN Fail ELSE
    LET orderCancelledV2ReturnBitfield6 == ReadWhen(numberOfReturnBitfields.value >= 6, ReadUIntLE(orderCancelledV2ReturnBitfield5.rest, 1), orderCancelledV2ReturnBitfield5.rest) IN IF ~orderCancelledV2ReturnBitfield6.ok THEN Fail ELSE
    LET orderCancelledV2ReturnBitfield7 == ReadWhen(numberOfReturnBitfields.value >= 7, ReadBytes(orderCancelledV2ReturnBitfield6.rest, 1), orderCancelledV2ReturnBitfield6.rest) IN IF ~orderCancelledV2ReturnBitfield7.ok THEN Fail ELSE
    LET orderCancelledV2ReturnBitfield8 == ReadWhen(numberOfReturnBitfields.value >= 8, ReadUIntLE(orderCancelledV2ReturnBitfield7.rest, 1), orderCancelledV2ReturnBitfield7.rest) IN IF ~orderCancelledV2ReturnBitfield8.ok THEN Fail ELSE
    LET orderCancelledV2ReturnBitfield9 == ReadWhen(numberOfReturnBitfields.value >= 9, ReadUIntLE(orderCancelledV2ReturnBitfield8.rest, 1), orderCancelledV2ReturnBitfield8.rest) IN IF ~orderCancelledV2ReturnBitfield9.ok THEN Fail ELSE
    LET orderCancelledV2ReturnBitfield10 == ReadWhen(numberOfReturnBitfields.value >= 10, ReadUIntLE(orderCancelledV2ReturnBitfield9.rest, 1), orderCancelledV2ReturnBitfield9.rest) IN IF ~orderCancelledV2ReturnBitfield10.ok THEN Fail ELSE
    LET orderCancelledV2ReturnBitfield11 == ReadWhen(numberOfReturnBitfields.value >= 11, ReadUIntLE(orderCancelledV2ReturnBitfield10.rest, 1), orderCancelledV2ReturnBitfield10.rest) IN IF ~orderCancelledV2ReturnBitfield11.ok THEN Fail ELSE
    LET orderCancelledV2ReturnBitfield12 == ReadWhen(numberOfReturnBitfields.value >= 12, ReadBytes(orderCancelledV2ReturnBitfield11.rest, 1), orderCancelledV2ReturnBitfield11.rest) IN IF ~orderCancelledV2ReturnBitfield12.ok THEN Fail ELSE
    LET orderCancelledV2ReturnBitfield13 == ReadWhen(numberOfReturnBitfields.value >= 13, ReadBytes(orderCancelledV2ReturnBitfield12.rest, 1), orderCancelledV2ReturnBitfield12.rest) IN IF ~orderCancelledV2ReturnBitfield13.ok THEN Fail ELSE
    LET orderCancelledV2ReturnBitfield14 == ReadWhen(numberOfReturnBitfields.value >= 14, ReadBytes(orderCancelledV2ReturnBitfield13.rest, 1), orderCancelledV2ReturnBitfield13.rest) IN IF ~orderCancelledV2ReturnBitfield14.ok THEN Fail ELSE
    LET orderCancelledV2ReturnBitfield15 == ReadWhen(numberOfReturnBitfields.value >= 15, ReadBytes(orderCancelledV2ReturnBitfield14.rest, 1), orderCancelledV2ReturnBitfield14.rest) IN IF ~orderCancelledV2ReturnBitfield15.ok THEN Fail ELSE
    LET orderCancelledV2ReturnBitfield16 == ReadWhen(numberOfReturnBitfields.value >= 16, ReadBytes(orderCancelledV2ReturnBitfield15.rest, 1), orderCancelledV2ReturnBitfield15.rest) IN IF ~orderCancelledV2ReturnBitfield16.ok THEN Fail ELSE
    LET orderCancelledV2ReturnBitfield17 == ReadWhen(numberOfReturnBitfields.value >= 17, ReadUIntLE(orderCancelledV2ReturnBitfield16.rest, 1), orderCancelledV2ReturnBitfield16.rest) IN IF ~orderCancelledV2ReturnBitfield17.ok THEN Fail ELSE
    LET orderCancelledV2ReturnBitfield18 == ReadWhen(numberOfReturnBitfields.value >= 18, ReadUIntLE(orderCancelledV2ReturnBitfield17.rest, 1), orderCancelledV2ReturnBitfield17.rest) IN IF ~orderCancelledV2ReturnBitfield18.ok THEN Fail ELSE
    LET orderCancelledV2ReturnBitfield19 == ReadWhen(numberOfReturnBitfields.value >= 19, ReadBytes(orderCancelledV2ReturnBitfield18.rest, 1), orderCancelledV2ReturnBitfield18.rest) IN IF ~orderCancelledV2ReturnBitfield19.ok THEN Fail ELSE
    LET side == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderCancelledV2ReturnBitfield1.value # << >> /\ orderCancelledV2ReturnBitfield1.value[1] % 2 > 0), ReadBytes(orderCancelledV2ReturnBitfield19.rest, 1), orderCancelledV2ReturnBitfield19.rest) IN IF ~side.ok THEN Fail ELSE
    LET price == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderCancelledV2ReturnBitfield1.value # << >> /\ (orderCancelledV2ReturnBitfield1.value[1] \div 4) % 2 > 0), ReadBytes(side.rest, 8), side.rest) IN IF ~price.ok THEN Fail ELSE
    LET ordType == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderCancelledV2ReturnBitfield1.value # << >> /\ (orderCancelledV2ReturnBitfield1.value[1] \div 16) % 2 > 0), ReadBytes(price.rest, 1), price.rest) IN IF ~ordType.ok THEN Fail ELSE
    LET timeInForce == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderCancelledV2ReturnBitfield1.value # << >> /\ (orderCancelledV2ReturnBitfield1.value[1] \div 32) % 2 > 0), ReadBytes(ordType.rest, 1), ordType.rest) IN IF ~timeInForce.ok THEN Fail ELSE
    LET minQty == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderCancelledV2ReturnBitfield1.value # << >> /\ (orderCancelledV2ReturnBitfield1.value[1] \div 64) % 2 > 0), ReadBytes(timeInForce.rest, 4), timeInForce.rest) IN IF ~minQty.ok THEN Fail ELSE
    LET symbolLong == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (orderCancelledV2ReturnBitfield2.value # << >> /\ orderCancelledV2ReturnBitfield2.value[1] % 2 > 0), ReadBytes(minQty.rest, 8), minQty.rest) IN IF ~symbolLong.ok THEN Fail ELSE
    LET idSource == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (orderCancelledV2ReturnBitfield2.value # << >> /\ (orderCancelledV2ReturnBitfield2.value[1] \div 8) % 2 > 0), ReadBytes(symbolLong.rest, 1), symbolLong.rest) IN IF ~idSource.ok THEN Fail ELSE
    LET securityId == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (orderCancelledV2ReturnBitfield2.value # << >> /\ (orderCancelledV2ReturnBitfield2.value[1] \div 16) % 2 > 0), ReadBytes(idSource.rest, 16), idSource.rest) IN IF ~securityId.ok THEN Fail ELSE
    LET capacity == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (orderCancelledV2ReturnBitfield2.value # << >> /\ (orderCancelledV2ReturnBitfield2.value[1] \div 64) % 2 > 0), ReadBytes(securityId.rest, 1), securityId.rest) IN IF ~capacity.ok THEN Fail ELSE
    LET account == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderCancelledV2ReturnBitfield3.value # << >> /\ orderCancelledV2ReturnBitfield3.value[1] % 2 > 0), ReadBytes(capacity.rest, 16), capacity.rest) IN IF ~account.ok THEN Fail ELSE
    LET clearingFirm == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderCancelledV2ReturnBitfield3.value # << >> /\ (orderCancelledV2ReturnBitfield3.value[1] \div 2) % 2 > 0), ReadBytes(account.rest, 4), account.rest) IN IF ~clearingFirm.ok THEN Fail ELSE
    LET clearingAccount == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderCancelledV2ReturnBitfield3.value # << >> /\ (orderCancelledV2ReturnBitfield3.value[1] \div 4) % 2 > 0), ReadBytes(clearingFirm.rest, 4), clearingFirm.rest) IN IF ~clearingAccount.ok THEN Fail ELSE
    LET displayIndicator == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderCancelledV2ReturnBitfield3.value # << >> /\ (orderCancelledV2ReturnBitfield3.value[1] \div 8) % 2 > 0), ReadBytes(clearingAccount.rest, 1), clearingAccount.rest) IN IF ~displayIndicator.ok THEN Fail ELSE
    LET orderQty == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderCancelledV2ReturnBitfield3.value # << >> /\ (orderCancelledV2ReturnBitfield3.value[1] \div 64) % 2 > 0), ReadBytes(displayIndicator.rest, 4), displayIndicator.rest) IN IF ~orderQty.ok THEN Fail ELSE
    LET preventMatch == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderCancelledV2ReturnBitfield3.value # << >> /\ (orderCancelledV2ReturnBitfield3.value[1] \div 128) % 2 > 0), ReadBytes(orderQty.rest, 3), orderQty.rest) IN IF ~preventMatch.ok THEN Fail ELSE
    LET openClose == ReadWhen(numberOfReturnBitfields.value >= 4 /\ (orderCancelledV2ReturnBitfield4.value # << >> /\ (orderCancelledV2ReturnBitfield4.value[1] \div 8) % 2 > 0), ReadBytes(preventMatch.rest, 1), preventMatch.rest) IN IF ~openClose.ok THEN Fail ELSE
    LET origClOrdId == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderCancelledV2ReturnBitfield5.value # << >> /\ orderCancelledV2ReturnBitfield5.value[1] % 2 > 0), ReadBytes(openClose.rest, 20), openClose.rest) IN IF ~origClOrdId.ok THEN Fail ELSE
    LET leavesQty == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderCancelledV2ReturnBitfield5.value # << >> /\ (orderCancelledV2ReturnBitfield5.value[1] \div 2) % 2 > 0), ReadBytes(origClOrdId.rest, 4), origClOrdId.rest) IN IF ~leavesQty.ok THEN Fail ELSE
    LET lastShares == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderCancelledV2ReturnBitfield5.value # << >> /\ (orderCancelledV2ReturnBitfield5.value[1] \div 4) % 2 > 0), ReadBytes(leavesQty.rest, 4), leavesQty.rest) IN IF ~lastShares.ok THEN Fail ELSE
    LET lastPx == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderCancelledV2ReturnBitfield5.value # << >> /\ (orderCancelledV2ReturnBitfield5.value[1] \div 8) % 2 > 0), ReadBytes(lastShares.rest, 8), lastShares.rest) IN IF ~lastPx.ok THEN Fail ELSE
    LET displayPrice == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderCancelledV2ReturnBitfield5.value # << >> /\ (orderCancelledV2ReturnBitfield5.value[1] \div 16) % 2 > 0), ReadBytes(lastPx.rest, 8), lastPx.rest) IN IF ~displayPrice.ok THEN Fail ELSE
    LET workingPrice == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderCancelledV2ReturnBitfield5.value # << >> /\ (orderCancelledV2ReturnBitfield5.value[1] \div 32) % 2 > 0), ReadBytes(displayPrice.rest, 8), displayPrice.rest) IN IF ~workingPrice.ok THEN Fail ELSE
    LET baseLiquidityIndicator == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderCancelledV2ReturnBitfield5.value # << >> /\ (orderCancelledV2ReturnBitfield5.value[1] \div 64) % 2 > 0), ReadBytes(workingPrice.rest, 1), workingPrice.rest) IN IF ~baseLiquidityIndicator.ok THEN Fail ELSE
    LET expireTime == ReadWhen(numberOfReturnBitfields.value >= 5 /\ (orderCancelledV2ReturnBitfield5.value # << >> /\ (orderCancelledV2ReturnBitfield5.value[1] \div 128) % 2 > 0), ReadBytes(baseLiquidityIndicator.rest, 8), baseLiquidityIndicator.rest) IN IF ~expireTime.ok THEN Fail ELSE
    LET secondaryOrderId == ReadWhen(numberOfReturnBitfields.value >= 6 /\ (orderCancelledV2ReturnBitfield6.value # << >> /\ orderCancelledV2ReturnBitfield6.value[1] % 2 > 0), ReadBytes(expireTime.rest, 8), expireTime.rest) IN IF ~secondaryOrderId.ok THEN Fail ELSE
    LET extExecInst == ReadWhen(numberOfReturnBitfields.value >= 6 /\ (orderCancelledV2ReturnBitfield6.value # << >> /\ (orderCancelledV2ReturnBitfield6.value[1] \div 16) % 2 > 0), ReadBytes(secondaryOrderId.rest, 1), secondaryOrderId.rest) IN IF ~extExecInst.ok THEN Fail ELSE
    LET stopPx == ReadWhen(numberOfReturnBitfields.value >= 8 /\ (orderCancelledV2ReturnBitfield8.value # << >> /\ (orderCancelledV2ReturnBitfield8.value[1] \div 4) % 2 > 0), ReadBytes(extExecInst.rest, 8), extExecInst.rest) IN IF ~stopPx.ok THEN Fail ELSE
    LET routingInst == ReadWhen(numberOfReturnBitfields.value >= 8 /\ (orderCancelledV2ReturnBitfield8.value # << >> /\ (orderCancelledV2ReturnBitfield8.value[1] \div 8) % 2 > 0), ReadBytes(stopPx.rest, 4), stopPx.rest) IN IF ~routingInst.ok THEN Fail ELSE
    LET liquidityProvision == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (orderCancelledV2ReturnBitfield9.value # << >> /\ (orderCancelledV2ReturnBitfield9.value[1] \div 16) % 2 > 0), ReadBytes(routingInst.rest, 1), routingInst.rest) IN IF ~liquidityProvision.ok THEN Fail ELSE
    LET clientQualifiedRole == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (orderCancelledV2ReturnBitfield10.value # << >> /\ (orderCancelledV2ReturnBitfield10.value[1] \div 128) % 2 > 0), ReadBytes(liquidityProvision.rest, 1), liquidityProvision.rest) IN IF ~clientQualifiedRole.ok THEN Fail ELSE
    LET clientId == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (orderCancelledV2ReturnBitfield11.value # << >> /\ orderCancelledV2ReturnBitfield11.value[1] % 2 > 0), ReadBytes(clientQualifiedRole.rest, 4), clientQualifiedRole.rest) IN IF ~clientId.ok THEN Fail ELSE
    LET investorId == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (orderCancelledV2ReturnBitfield11.value # << >> /\ (orderCancelledV2ReturnBitfield11.value[1] \div 2) % 2 > 0), ReadBytes(clientId.rest, 4), clientId.rest) IN IF ~investorId.ok THEN Fail ELSE
    LET executorId == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (orderCancelledV2ReturnBitfield11.value # << >> /\ (orderCancelledV2ReturnBitfield11.value[1] \div 4) % 2 > 0), ReadBytes(investorId.rest, 4), investorId.rest) IN IF ~executorId.ok THEN Fail ELSE
    LET orderOrigination == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (orderCancelledV2ReturnBitfield11.value # << >> /\ (orderCancelledV2ReturnBitfield11.value[1] \div 8) % 2 > 0), ReadBytes(executorId.rest, 1), executorId.rest) IN IF ~orderOrigination.ok THEN Fail ELSE
    LET algorithmicIndicator == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (orderCancelledV2ReturnBitfield11.value # << >> /\ (orderCancelledV2ReturnBitfield11.value[1] \div 16) % 2 > 0), ReadBytes(orderOrigination.rest, 1), orderOrigination.rest) IN IF ~algorithmicIndicator.ok THEN Fail ELSE
    LET investorQualifiedRole == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (orderCancelledV2ReturnBitfield11.value # << >> /\ (orderCancelledV2ReturnBitfield11.value[1] \div 64) % 2 > 0), ReadBytes(algorithmicIndicator.rest, 1), algorithmicIndicator.rest) IN IF ~investorQualifiedRole.ok THEN Fail ELSE
    LET executorQualifiedRole == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (orderCancelledV2ReturnBitfield11.value # << >> /\ (orderCancelledV2ReturnBitfield11.value[1] \div 128) % 2 > 0), ReadBytes(investorQualifiedRole.rest, 1), investorQualifiedRole.rest) IN IF ~executorQualifiedRole.ok THEN Fail ELSE
    LET custOrderHandlingInst == ReadWhen(numberOfReturnBitfields.value >= 17 /\ (orderCancelledV2ReturnBitfield17.value # << >> /\ (orderCancelledV2ReturnBitfield17.value[1] \div 128) % 2 > 0), ReadBytes(executorQualifiedRole.rest, 1), executorQualifiedRole.rest) IN IF ~custOrderHandlingInst.ok THEN Fail ELSE
    LET subreason == ReadWhen(numberOfReturnBitfields.value >= 18 /\ (orderCancelledV2ReturnBitfield18.value # << >> /\ (orderCancelledV2ReturnBitfield18.value[1] \div 4) % 2 > 0), ReadBytes(custOrderHandlingInst.rest, 1), custOrderHandlingInst.rest) IN IF ~subreason.ok THEN Fail ELSE
    Ok([ transactionTime                  |-> transactionTime.value,
         clOrdId                          |-> clOrdId.value,
         cancelReason                     |-> cancelReason.value,
         reserved1                        |-> reserved1.value,
         numberOfReturnBitfields          |-> numberOfReturnBitfields.value,
         orderCancelledV2ReturnBitfield1  |-> orderCancelledV2ReturnBitfield1.value,
         orderCancelledV2ReturnBitfield2  |-> orderCancelledV2ReturnBitfield2.value,
         orderCancelledV2ReturnBitfield3  |-> orderCancelledV2ReturnBitfield3.value,
         orderCancelledV2ReturnBitfield4  |-> orderCancelledV2ReturnBitfield4.value,
         orderCancelledV2ReturnBitfield5  |-> orderCancelledV2ReturnBitfield5.value,
         orderCancelledV2ReturnBitfield6  |-> orderCancelledV2ReturnBitfield6.value,
         orderCancelledV2ReturnBitfield7  |-> orderCancelledV2ReturnBitfield7.value,
         orderCancelledV2ReturnBitfield8  |-> orderCancelledV2ReturnBitfield8.value,
         orderCancelledV2ReturnBitfield9  |-> orderCancelledV2ReturnBitfield9.value,
         orderCancelledV2ReturnBitfield10 |-> orderCancelledV2ReturnBitfield10.value,
         orderCancelledV2ReturnBitfield11 |-> orderCancelledV2ReturnBitfield11.value,
         orderCancelledV2ReturnBitfield12 |-> orderCancelledV2ReturnBitfield12.value,
         orderCancelledV2ReturnBitfield13 |-> orderCancelledV2ReturnBitfield13.value,
         orderCancelledV2ReturnBitfield14 |-> orderCancelledV2ReturnBitfield14.value,
         orderCancelledV2ReturnBitfield15 |-> orderCancelledV2ReturnBitfield15.value,
         orderCancelledV2ReturnBitfield16 |-> orderCancelledV2ReturnBitfield16.value,
         orderCancelledV2ReturnBitfield17 |-> orderCancelledV2ReturnBitfield17.value,
         orderCancelledV2ReturnBitfield18 |-> orderCancelledV2ReturnBitfield18.value,
         orderCancelledV2ReturnBitfield19 |-> orderCancelledV2ReturnBitfield19.value,
         side                             |-> side.value,
         price                            |-> price.value,
         ordType                          |-> ordType.value,
         timeInForce                      |-> timeInForce.value,
         minQty                           |-> minQty.value,
         symbolLong                       |-> symbolLong.value,
         idSource                         |-> idSource.value,
         securityId                       |-> securityId.value,
         capacity                         |-> capacity.value,
         account                          |-> account.value,
         clearingFirm                     |-> clearingFirm.value,
         clearingAccount                  |-> clearingAccount.value,
         displayIndicator                 |-> displayIndicator.value,
         orderQty                         |-> orderQty.value,
         preventMatch                     |-> preventMatch.value,
         openClose                        |-> openClose.value,
         origClOrdId                      |-> origClOrdId.value,
         leavesQty                        |-> leavesQty.value,
         lastShares                       |-> lastShares.value,
         lastPx                           |-> lastPx.value,
         displayPrice                     |-> displayPrice.value,
         workingPrice                     |-> workingPrice.value,
         baseLiquidityIndicator           |-> baseLiquidityIndicator.value,
         expireTime                       |-> expireTime.value,
         secondaryOrderId                 |-> secondaryOrderId.value,
         extExecInst                      |-> extExecInst.value,
         stopPx                           |-> stopPx.value,
         routingInst                      |-> routingInst.value,
         liquidityProvision               |-> liquidityProvision.value,
         clientQualifiedRole              |-> clientQualifiedRole.value,
         clientId                         |-> clientId.value,
         investorId                       |-> investorId.value,
         executorId                       |-> executorId.value,
         orderOrigination                 |-> orderOrigination.value,
         algorithmicIndicator             |-> algorithmicIndicator.value,
         investorQualifiedRole            |-> investorQualifiedRole.value,
         executorQualifiedRole            |-> executorQualifiedRole.value,
         custOrderHandlingInst            |-> custOrderHandlingInst.value,
         subreason                        |-> subreason.value ], subreason.rest)

(* Order Cancelled V 2 Message with each field marked present by fields before it there exactly where they say *)
SettleOrderCancelledV2Message(message) ==
    LET settled1 == [message EXCEPT !.orderCancelledV2ReturnBitfield1 = IF message.numberOfReturnBitfields >= 1 THEN (IF message.orderCancelledV2ReturnBitfield1 = << >> THEN <<0>> ELSE message.orderCancelledV2ReturnBitfield1) ELSE << >>]
        settled2 == [settled1 EXCEPT !.orderCancelledV2ReturnBitfield2 = IF settled1.numberOfReturnBitfields >= 2 THEN (IF settled1.orderCancelledV2ReturnBitfield2 = << >> THEN <<0>> ELSE settled1.orderCancelledV2ReturnBitfield2) ELSE << >>]
        settled3 == [settled2 EXCEPT !.orderCancelledV2ReturnBitfield3 = IF settled2.numberOfReturnBitfields >= 3 THEN (IF settled2.orderCancelledV2ReturnBitfield3 = << >> THEN <<0>> ELSE settled2.orderCancelledV2ReturnBitfield3) ELSE << >>]
        settled4 == [settled3 EXCEPT !.orderCancelledV2ReturnBitfield4 = IF settled3.numberOfReturnBitfields >= 4 THEN (IF settled3.orderCancelledV2ReturnBitfield4 = << >> THEN <<0>> ELSE settled3.orderCancelledV2ReturnBitfield4) ELSE << >>]
        settled5 == [settled4 EXCEPT !.orderCancelledV2ReturnBitfield5 = IF settled4.numberOfReturnBitfields >= 5 THEN (IF settled4.orderCancelledV2ReturnBitfield5 = << >> THEN <<0>> ELSE settled4.orderCancelledV2ReturnBitfield5) ELSE << >>]
        settled6 == [settled5 EXCEPT !.orderCancelledV2ReturnBitfield6 = IF settled5.numberOfReturnBitfields >= 6 THEN (IF settled5.orderCancelledV2ReturnBitfield6 = << >> THEN <<0>> ELSE settled5.orderCancelledV2ReturnBitfield6) ELSE << >>]
        settled7 == [settled6 EXCEPT !.orderCancelledV2ReturnBitfield7 = IF settled6.numberOfReturnBitfields >= 7 THEN (IF settled6.orderCancelledV2ReturnBitfield7 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled6.orderCancelledV2ReturnBitfield7) ELSE << >>]
        settled8 == [settled7 EXCEPT !.orderCancelledV2ReturnBitfield8 = IF settled7.numberOfReturnBitfields >= 8 THEN (IF settled7.orderCancelledV2ReturnBitfield8 = << >> THEN <<0>> ELSE settled7.orderCancelledV2ReturnBitfield8) ELSE << >>]
        settled9 == [settled8 EXCEPT !.orderCancelledV2ReturnBitfield9 = IF settled8.numberOfReturnBitfields >= 9 THEN (IF settled8.orderCancelledV2ReturnBitfield9 = << >> THEN <<0>> ELSE settled8.orderCancelledV2ReturnBitfield9) ELSE << >>]
        settled10 == [settled9 EXCEPT !.orderCancelledV2ReturnBitfield10 = IF settled9.numberOfReturnBitfields >= 10 THEN (IF settled9.orderCancelledV2ReturnBitfield10 = << >> THEN <<0>> ELSE settled9.orderCancelledV2ReturnBitfield10) ELSE << >>]
        settled11 == [settled10 EXCEPT !.orderCancelledV2ReturnBitfield11 = IF settled10.numberOfReturnBitfields >= 11 THEN (IF settled10.orderCancelledV2ReturnBitfield11 = << >> THEN <<0>> ELSE settled10.orderCancelledV2ReturnBitfield11) ELSE << >>]
        settled12 == [settled11 EXCEPT !.orderCancelledV2ReturnBitfield12 = IF settled11.numberOfReturnBitfields >= 12 THEN (IF settled11.orderCancelledV2ReturnBitfield12 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled11.orderCancelledV2ReturnBitfield12) ELSE << >>]
        settled13 == [settled12 EXCEPT !.orderCancelledV2ReturnBitfield13 = IF settled12.numberOfReturnBitfields >= 13 THEN (IF settled12.orderCancelledV2ReturnBitfield13 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled12.orderCancelledV2ReturnBitfield13) ELSE << >>]
        settled14 == [settled13 EXCEPT !.orderCancelledV2ReturnBitfield14 = IF settled13.numberOfReturnBitfields >= 14 THEN (IF settled13.orderCancelledV2ReturnBitfield14 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled13.orderCancelledV2ReturnBitfield14) ELSE << >>]
        settled15 == [settled14 EXCEPT !.orderCancelledV2ReturnBitfield15 = IF settled14.numberOfReturnBitfields >= 15 THEN (IF settled14.orderCancelledV2ReturnBitfield15 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled14.orderCancelledV2ReturnBitfield15) ELSE << >>]
        settled16 == [settled15 EXCEPT !.orderCancelledV2ReturnBitfield16 = IF settled15.numberOfReturnBitfields >= 16 THEN (IF settled15.orderCancelledV2ReturnBitfield16 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled15.orderCancelledV2ReturnBitfield16) ELSE << >>]
        settled17 == [settled16 EXCEPT !.orderCancelledV2ReturnBitfield17 = IF settled16.numberOfReturnBitfields >= 17 THEN (IF settled16.orderCancelledV2ReturnBitfield17 = << >> THEN <<0>> ELSE settled16.orderCancelledV2ReturnBitfield17) ELSE << >>]
        settled18 == [settled17 EXCEPT !.orderCancelledV2ReturnBitfield18 = IF settled17.numberOfReturnBitfields >= 18 THEN (IF settled17.orderCancelledV2ReturnBitfield18 = << >> THEN <<0>> ELSE settled17.orderCancelledV2ReturnBitfield18) ELSE << >>]
        settled19 == [settled18 EXCEPT !.orderCancelledV2ReturnBitfield19 = IF settled18.numberOfReturnBitfields >= 19 THEN (IF settled18.orderCancelledV2ReturnBitfield19 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled18.orderCancelledV2ReturnBitfield19) ELSE << >>]
        settled20 == [settled19 EXCEPT !.side = IF settled19.numberOfReturnBitfields >= 1 /\ (settled19.orderCancelledV2ReturnBitfield1 # << >> /\ settled19.orderCancelledV2ReturnBitfield1[1] % 2 > 0) THEN (IF settled19.side = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled19.side) ELSE << >>]
        settled21 == [settled20 EXCEPT !.price = IF settled20.numberOfReturnBitfields >= 1 /\ (settled20.orderCancelledV2ReturnBitfield1 # << >> /\ (settled20.orderCancelledV2ReturnBitfield1[1] \div 4) % 2 > 0) THEN (IF settled20.price = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled20.price) ELSE << >>]
        settled22 == [settled21 EXCEPT !.ordType = IF settled21.numberOfReturnBitfields >= 1 /\ (settled21.orderCancelledV2ReturnBitfield1 # << >> /\ (settled21.orderCancelledV2ReturnBitfield1[1] \div 16) % 2 > 0) THEN (IF settled21.ordType = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled21.ordType) ELSE << >>]
        settled23 == [settled22 EXCEPT !.timeInForce = IF settled22.numberOfReturnBitfields >= 1 /\ (settled22.orderCancelledV2ReturnBitfield1 # << >> /\ (settled22.orderCancelledV2ReturnBitfield1[1] \div 32) % 2 > 0) THEN (IF settled22.timeInForce = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled22.timeInForce) ELSE << >>]
        settled24 == [settled23 EXCEPT !.minQty = IF settled23.numberOfReturnBitfields >= 1 /\ (settled23.orderCancelledV2ReturnBitfield1 # << >> /\ (settled23.orderCancelledV2ReturnBitfield1[1] \div 64) % 2 > 0) THEN (IF settled23.minQty = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled23.minQty) ELSE << >>]
        settled25 == [settled24 EXCEPT !.symbolLong = IF settled24.numberOfReturnBitfields >= 2 /\ (settled24.orderCancelledV2ReturnBitfield2 # << >> /\ settled24.orderCancelledV2ReturnBitfield2[1] % 2 > 0) THEN (IF settled24.symbolLong = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled24.symbolLong) ELSE << >>]
        settled26 == [settled25 EXCEPT !.idSource = IF settled25.numberOfReturnBitfields >= 2 /\ (settled25.orderCancelledV2ReturnBitfield2 # << >> /\ (settled25.orderCancelledV2ReturnBitfield2[1] \div 8) % 2 > 0) THEN (IF settled25.idSource = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled25.idSource) ELSE << >>]
        settled27 == [settled26 EXCEPT !.securityId = IF settled26.numberOfReturnBitfields >= 2 /\ (settled26.orderCancelledV2ReturnBitfield2 # << >> /\ (settled26.orderCancelledV2ReturnBitfield2[1] \div 16) % 2 > 0) THEN (IF settled26.securityId = << >> THEN <<[i \in 1 .. 16 |-> 0]>> ELSE settled26.securityId) ELSE << >>]
        settled28 == [settled27 EXCEPT !.capacity = IF settled27.numberOfReturnBitfields >= 2 /\ (settled27.orderCancelledV2ReturnBitfield2 # << >> /\ (settled27.orderCancelledV2ReturnBitfield2[1] \div 64) % 2 > 0) THEN (IF settled27.capacity = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled27.capacity) ELSE << >>]
        settled29 == [settled28 EXCEPT !.account = IF settled28.numberOfReturnBitfields >= 3 /\ (settled28.orderCancelledV2ReturnBitfield3 # << >> /\ settled28.orderCancelledV2ReturnBitfield3[1] % 2 > 0) THEN (IF settled28.account = << >> THEN <<[i \in 1 .. 16 |-> 0]>> ELSE settled28.account) ELSE << >>]
        settled30 == [settled29 EXCEPT !.clearingFirm = IF settled29.numberOfReturnBitfields >= 3 /\ (settled29.orderCancelledV2ReturnBitfield3 # << >> /\ (settled29.orderCancelledV2ReturnBitfield3[1] \div 2) % 2 > 0) THEN (IF settled29.clearingFirm = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled29.clearingFirm) ELSE << >>]
        settled31 == [settled30 EXCEPT !.clearingAccount = IF settled30.numberOfReturnBitfields >= 3 /\ (settled30.orderCancelledV2ReturnBitfield3 # << >> /\ (settled30.orderCancelledV2ReturnBitfield3[1] \div 4) % 2 > 0) THEN (IF settled30.clearingAccount = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled30.clearingAccount) ELSE << >>]
        settled32 == [settled31 EXCEPT !.displayIndicator = IF settled31.numberOfReturnBitfields >= 3 /\ (settled31.orderCancelledV2ReturnBitfield3 # << >> /\ (settled31.orderCancelledV2ReturnBitfield3[1] \div 8) % 2 > 0) THEN (IF settled31.displayIndicator = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled31.displayIndicator) ELSE << >>]
        settled33 == [settled32 EXCEPT !.orderQty = IF settled32.numberOfReturnBitfields >= 3 /\ (settled32.orderCancelledV2ReturnBitfield3 # << >> /\ (settled32.orderCancelledV2ReturnBitfield3[1] \div 64) % 2 > 0) THEN (IF settled32.orderQty = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled32.orderQty) ELSE << >>]
        settled34 == [settled33 EXCEPT !.preventMatch = IF settled33.numberOfReturnBitfields >= 3 /\ (settled33.orderCancelledV2ReturnBitfield3 # << >> /\ (settled33.orderCancelledV2ReturnBitfield3[1] \div 128) % 2 > 0) THEN (IF settled33.preventMatch = << >> THEN <<[i \in 1 .. 3 |-> 0]>> ELSE settled33.preventMatch) ELSE << >>]
        settled35 == [settled34 EXCEPT !.openClose = IF settled34.numberOfReturnBitfields >= 4 /\ (settled34.orderCancelledV2ReturnBitfield4 # << >> /\ (settled34.orderCancelledV2ReturnBitfield4[1] \div 8) % 2 > 0) THEN (IF settled34.openClose = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled34.openClose) ELSE << >>]
        settled36 == [settled35 EXCEPT !.origClOrdId = IF settled35.numberOfReturnBitfields >= 5 /\ (settled35.orderCancelledV2ReturnBitfield5 # << >> /\ settled35.orderCancelledV2ReturnBitfield5[1] % 2 > 0) THEN (IF settled35.origClOrdId = << >> THEN <<[i \in 1 .. 20 |-> 0]>> ELSE settled35.origClOrdId) ELSE << >>]
        settled37 == [settled36 EXCEPT !.leavesQty = IF settled36.numberOfReturnBitfields >= 5 /\ (settled36.orderCancelledV2ReturnBitfield5 # << >> /\ (settled36.orderCancelledV2ReturnBitfield5[1] \div 2) % 2 > 0) THEN (IF settled36.leavesQty = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled36.leavesQty) ELSE << >>]
        settled38 == [settled37 EXCEPT !.lastShares = IF settled37.numberOfReturnBitfields >= 5 /\ (settled37.orderCancelledV2ReturnBitfield5 # << >> /\ (settled37.orderCancelledV2ReturnBitfield5[1] \div 4) % 2 > 0) THEN (IF settled37.lastShares = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled37.lastShares) ELSE << >>]
        settled39 == [settled38 EXCEPT !.lastPx = IF settled38.numberOfReturnBitfields >= 5 /\ (settled38.orderCancelledV2ReturnBitfield5 # << >> /\ (settled38.orderCancelledV2ReturnBitfield5[1] \div 8) % 2 > 0) THEN (IF settled38.lastPx = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled38.lastPx) ELSE << >>]
        settled40 == [settled39 EXCEPT !.displayPrice = IF settled39.numberOfReturnBitfields >= 5 /\ (settled39.orderCancelledV2ReturnBitfield5 # << >> /\ (settled39.orderCancelledV2ReturnBitfield5[1] \div 16) % 2 > 0) THEN (IF settled39.displayPrice = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled39.displayPrice) ELSE << >>]
        settled41 == [settled40 EXCEPT !.workingPrice = IF settled40.numberOfReturnBitfields >= 5 /\ (settled40.orderCancelledV2ReturnBitfield5 # << >> /\ (settled40.orderCancelledV2ReturnBitfield5[1] \div 32) % 2 > 0) THEN (IF settled40.workingPrice = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled40.workingPrice) ELSE << >>]
        settled42 == [settled41 EXCEPT !.baseLiquidityIndicator = IF settled41.numberOfReturnBitfields >= 5 /\ (settled41.orderCancelledV2ReturnBitfield5 # << >> /\ (settled41.orderCancelledV2ReturnBitfield5[1] \div 64) % 2 > 0) THEN (IF settled41.baseLiquidityIndicator = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled41.baseLiquidityIndicator) ELSE << >>]
        settled43 == [settled42 EXCEPT !.expireTime = IF settled42.numberOfReturnBitfields >= 5 /\ (settled42.orderCancelledV2ReturnBitfield5 # << >> /\ (settled42.orderCancelledV2ReturnBitfield5[1] \div 128) % 2 > 0) THEN (IF settled42.expireTime = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled42.expireTime) ELSE << >>]
        settled44 == [settled43 EXCEPT !.secondaryOrderId = IF settled43.numberOfReturnBitfields >= 6 /\ (settled43.orderCancelledV2ReturnBitfield6 # << >> /\ settled43.orderCancelledV2ReturnBitfield6[1] % 2 > 0) THEN (IF settled43.secondaryOrderId = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled43.secondaryOrderId) ELSE << >>]
        settled45 == [settled44 EXCEPT !.extExecInst = IF settled44.numberOfReturnBitfields >= 6 /\ (settled44.orderCancelledV2ReturnBitfield6 # << >> /\ (settled44.orderCancelledV2ReturnBitfield6[1] \div 16) % 2 > 0) THEN (IF settled44.extExecInst = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled44.extExecInst) ELSE << >>]
        settled46 == [settled45 EXCEPT !.stopPx = IF settled45.numberOfReturnBitfields >= 8 /\ (settled45.orderCancelledV2ReturnBitfield8 # << >> /\ (settled45.orderCancelledV2ReturnBitfield8[1] \div 4) % 2 > 0) THEN (IF settled45.stopPx = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled45.stopPx) ELSE << >>]
        settled47 == [settled46 EXCEPT !.routingInst = IF settled46.numberOfReturnBitfields >= 8 /\ (settled46.orderCancelledV2ReturnBitfield8 # << >> /\ (settled46.orderCancelledV2ReturnBitfield8[1] \div 8) % 2 > 0) THEN (IF settled46.routingInst = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled46.routingInst) ELSE << >>]
        settled48 == [settled47 EXCEPT !.liquidityProvision = IF settled47.numberOfReturnBitfields >= 9 /\ (settled47.orderCancelledV2ReturnBitfield9 # << >> /\ (settled47.orderCancelledV2ReturnBitfield9[1] \div 16) % 2 > 0) THEN (IF settled47.liquidityProvision = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled47.liquidityProvision) ELSE << >>]
        settled49 == [settled48 EXCEPT !.clientQualifiedRole = IF settled48.numberOfReturnBitfields >= 10 /\ (settled48.orderCancelledV2ReturnBitfield10 # << >> /\ (settled48.orderCancelledV2ReturnBitfield10[1] \div 128) % 2 > 0) THEN (IF settled48.clientQualifiedRole = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled48.clientQualifiedRole) ELSE << >>]
        settled50 == [settled49 EXCEPT !.clientId = IF settled49.numberOfReturnBitfields >= 11 /\ (settled49.orderCancelledV2ReturnBitfield11 # << >> /\ settled49.orderCancelledV2ReturnBitfield11[1] % 2 > 0) THEN (IF settled49.clientId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled49.clientId) ELSE << >>]
        settled51 == [settled50 EXCEPT !.investorId = IF settled50.numberOfReturnBitfields >= 11 /\ (settled50.orderCancelledV2ReturnBitfield11 # << >> /\ (settled50.orderCancelledV2ReturnBitfield11[1] \div 2) % 2 > 0) THEN (IF settled50.investorId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled50.investorId) ELSE << >>]
        settled52 == [settled51 EXCEPT !.executorId = IF settled51.numberOfReturnBitfields >= 11 /\ (settled51.orderCancelledV2ReturnBitfield11 # << >> /\ (settled51.orderCancelledV2ReturnBitfield11[1] \div 4) % 2 > 0) THEN (IF settled51.executorId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled51.executorId) ELSE << >>]
        settled53 == [settled52 EXCEPT !.orderOrigination = IF settled52.numberOfReturnBitfields >= 11 /\ (settled52.orderCancelledV2ReturnBitfield11 # << >> /\ (settled52.orderCancelledV2ReturnBitfield11[1] \div 8) % 2 > 0) THEN (IF settled52.orderOrigination = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled52.orderOrigination) ELSE << >>]
        settled54 == [settled53 EXCEPT !.algorithmicIndicator = IF settled53.numberOfReturnBitfields >= 11 /\ (settled53.orderCancelledV2ReturnBitfield11 # << >> /\ (settled53.orderCancelledV2ReturnBitfield11[1] \div 16) % 2 > 0) THEN (IF settled53.algorithmicIndicator = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled53.algorithmicIndicator) ELSE << >>]
        settled55 == [settled54 EXCEPT !.investorQualifiedRole = IF settled54.numberOfReturnBitfields >= 11 /\ (settled54.orderCancelledV2ReturnBitfield11 # << >> /\ (settled54.orderCancelledV2ReturnBitfield11[1] \div 64) % 2 > 0) THEN (IF settled54.investorQualifiedRole = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled54.investorQualifiedRole) ELSE << >>]
        settled56 == [settled55 EXCEPT !.executorQualifiedRole = IF settled55.numberOfReturnBitfields >= 11 /\ (settled55.orderCancelledV2ReturnBitfield11 # << >> /\ (settled55.orderCancelledV2ReturnBitfield11[1] \div 128) % 2 > 0) THEN (IF settled55.executorQualifiedRole = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled55.executorQualifiedRole) ELSE << >>]
        settled57 == [settled56 EXCEPT !.custOrderHandlingInst = IF settled56.numberOfReturnBitfields >= 17 /\ (settled56.orderCancelledV2ReturnBitfield17 # << >> /\ (settled56.orderCancelledV2ReturnBitfield17[1] \div 128) % 2 > 0) THEN (IF settled56.custOrderHandlingInst = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled56.custOrderHandlingInst) ELSE << >>]
        settled58 == [settled57 EXCEPT !.subreason = IF settled57.numberOfReturnBitfields >= 18 /\ (settled57.orderCancelledV2ReturnBitfield18 # << >> /\ (settled57.orderCancelledV2ReturnBitfield18[1] \div 4) % 2 > 0) THEN (IF settled57.subreason = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled57.subreason) ELSE << >>]
    IN  settled58

ZeroOrderCancelledV2Message ==
    SettleOrderCancelledV2Message([ transactionTime                  |-> [i \in 1 .. 8 |-> 0],
                                    clOrdId                          |-> [i \in 1 .. 20 |-> 0],
                                    cancelReason                     |-> [i \in 1 .. 1 |-> 0],
                                    reserved1                        |-> [i \in 1 .. 1 |-> 0],
                                    numberOfReturnBitfields          |-> 0,
                                    orderCancelledV2ReturnBitfield1  |-> << >>,
                                    orderCancelledV2ReturnBitfield2  |-> << >>,
                                    orderCancelledV2ReturnBitfield3  |-> << >>,
                                    orderCancelledV2ReturnBitfield4  |-> << >>,
                                    orderCancelledV2ReturnBitfield5  |-> << >>,
                                    orderCancelledV2ReturnBitfield6  |-> << >>,
                                    orderCancelledV2ReturnBitfield7  |-> << >>,
                                    orderCancelledV2ReturnBitfield8  |-> << >>,
                                    orderCancelledV2ReturnBitfield9  |-> << >>,
                                    orderCancelledV2ReturnBitfield10 |-> << >>,
                                    orderCancelledV2ReturnBitfield11 |-> << >>,
                                    orderCancelledV2ReturnBitfield12 |-> << >>,
                                    orderCancelledV2ReturnBitfield13 |-> << >>,
                                    orderCancelledV2ReturnBitfield14 |-> << >>,
                                    orderCancelledV2ReturnBitfield15 |-> << >>,
                                    orderCancelledV2ReturnBitfield16 |-> << >>,
                                    orderCancelledV2ReturnBitfield17 |-> << >>,
                                    orderCancelledV2ReturnBitfield18 |-> << >>,
                                    orderCancelledV2ReturnBitfield19 |-> << >>,
                                    side                             |-> << >>,
                                    price                            |-> << >>,
                                    ordType                          |-> << >>,
                                    timeInForce                      |-> << >>,
                                    minQty                           |-> << >>,
                                    symbolLong                       |-> << >>,
                                    idSource                         |-> << >>,
                                    securityId                       |-> << >>,
                                    capacity                         |-> << >>,
                                    account                          |-> << >>,
                                    clearingFirm                     |-> << >>,
                                    clearingAccount                  |-> << >>,
                                    displayIndicator                 |-> << >>,
                                    orderQty                         |-> << >>,
                                    preventMatch                     |-> << >>,
                                    openClose                        |-> << >>,
                                    origClOrdId                      |-> << >>,
                                    leavesQty                        |-> << >>,
                                    lastShares                       |-> << >>,
                                    lastPx                           |-> << >>,
                                    displayPrice                     |-> << >>,
                                    workingPrice                     |-> << >>,
                                    baseLiquidityIndicator           |-> << >>,
                                    expireTime                       |-> << >>,
                                    secondaryOrderId                 |-> << >>,
                                    extExecInst                      |-> << >>,
                                    stopPx                           |-> << >>,
                                    routingInst                      |-> << >>,
                                    liquidityProvision               |-> << >>,
                                    clientQualifiedRole              |-> << >>,
                                    clientId                         |-> << >>,
                                    investorId                       |-> << >>,
                                    executorId                       |-> << >>,
                                    orderOrigination                 |-> << >>,
                                    algorithmicIndicator             |-> << >>,
                                    investorQualifiedRole            |-> << >>,
                                    executorQualifiedRole            |-> << >>,
                                    custOrderHandlingInst            |-> << >>,
                                    subreason                        |-> << >> ])

(* Order Cancelled V 2 Message at zero, then each field in turn at the values it is checked at *)
CheckedOrderCancelledV2Message ==
    { ZeroOrderCancelledV2Message }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.transactionTime = one]) : one \in Sample(8) }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.clOrdId = one]) : one \in Sample(20) }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.cancelReason = one]) : one \in Sample(1) }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.reserved1 = one]) : one \in Sample(1) }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = one]) : one \in {0, 1, 255} }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 1, !.orderCancelledV2ReturnBitfield1 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 2, !.orderCancelledV2ReturnBitfield2 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 3, !.orderCancelledV2ReturnBitfield3 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 4, !.orderCancelledV2ReturnBitfield4 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 5, !.orderCancelledV2ReturnBitfield5 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 6, !.orderCancelledV2ReturnBitfield6 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 7, !.orderCancelledV2ReturnBitfield7 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 8, !.orderCancelledV2ReturnBitfield8 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 9, !.orderCancelledV2ReturnBitfield9 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 10, !.orderCancelledV2ReturnBitfield10 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 11, !.orderCancelledV2ReturnBitfield11 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 12, !.orderCancelledV2ReturnBitfield12 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 13, !.orderCancelledV2ReturnBitfield13 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 14, !.orderCancelledV2ReturnBitfield14 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 15, !.orderCancelledV2ReturnBitfield15 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 16, !.orderCancelledV2ReturnBitfield16 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 17, !.orderCancelledV2ReturnBitfield17 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 18, !.orderCancelledV2ReturnBitfield18 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 19, !.orderCancelledV2ReturnBitfield19 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 1, !.orderCancelledV2ReturnBitfield1 = <<1>>, !.side = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 1, !.orderCancelledV2ReturnBitfield1 = <<4>>, !.price = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 1, !.orderCancelledV2ReturnBitfield1 = <<16>>, !.ordType = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 1, !.orderCancelledV2ReturnBitfield1 = <<32>>, !.timeInForce = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 1, !.orderCancelledV2ReturnBitfield1 = <<64>>, !.minQty = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 2, !.orderCancelledV2ReturnBitfield2 = <<1>>, !.symbolLong = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 2, !.orderCancelledV2ReturnBitfield2 = <<8>>, !.idSource = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 2, !.orderCancelledV2ReturnBitfield2 = <<16>>, !.securityId = one]) : one \in { <<held>> : held \in Sample(16) } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 2, !.orderCancelledV2ReturnBitfield2 = <<64>>, !.capacity = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 3, !.orderCancelledV2ReturnBitfield3 = <<1>>, !.account = one]) : one \in { <<held>> : held \in Sample(16) } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 3, !.orderCancelledV2ReturnBitfield3 = <<2>>, !.clearingFirm = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 3, !.orderCancelledV2ReturnBitfield3 = <<4>>, !.clearingAccount = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 3, !.orderCancelledV2ReturnBitfield3 = <<8>>, !.displayIndicator = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 3, !.orderCancelledV2ReturnBitfield3 = <<64>>, !.orderQty = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 3, !.orderCancelledV2ReturnBitfield3 = <<128>>, !.preventMatch = one]) : one \in { <<held>> : held \in Sample(3) } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 4, !.orderCancelledV2ReturnBitfield4 = <<8>>, !.openClose = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 5, !.orderCancelledV2ReturnBitfield5 = <<1>>, !.origClOrdId = one]) : one \in { <<held>> : held \in Sample(20) } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 5, !.orderCancelledV2ReturnBitfield5 = <<2>>, !.leavesQty = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 5, !.orderCancelledV2ReturnBitfield5 = <<4>>, !.lastShares = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 5, !.orderCancelledV2ReturnBitfield5 = <<8>>, !.lastPx = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 5, !.orderCancelledV2ReturnBitfield5 = <<16>>, !.displayPrice = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 5, !.orderCancelledV2ReturnBitfield5 = <<32>>, !.workingPrice = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 5, !.orderCancelledV2ReturnBitfield5 = <<64>>, !.baseLiquidityIndicator = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 5, !.orderCancelledV2ReturnBitfield5 = <<128>>, !.expireTime = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 6, !.orderCancelledV2ReturnBitfield6 = <<1>>, !.secondaryOrderId = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 6, !.orderCancelledV2ReturnBitfield6 = <<16>>, !.extExecInst = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 8, !.orderCancelledV2ReturnBitfield8 = <<4>>, !.stopPx = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 8, !.orderCancelledV2ReturnBitfield8 = <<8>>, !.routingInst = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 9, !.orderCancelledV2ReturnBitfield9 = <<16>>, !.liquidityProvision = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 10, !.orderCancelledV2ReturnBitfield10 = <<128>>, !.clientQualifiedRole = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 11, !.orderCancelledV2ReturnBitfield11 = <<1>>, !.clientId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 11, !.orderCancelledV2ReturnBitfield11 = <<2>>, !.investorId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 11, !.orderCancelledV2ReturnBitfield11 = <<4>>, !.executorId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 11, !.orderCancelledV2ReturnBitfield11 = <<8>>, !.orderOrigination = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 11, !.orderCancelledV2ReturnBitfield11 = <<16>>, !.algorithmicIndicator = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 11, !.orderCancelledV2ReturnBitfield11 = <<64>>, !.investorQualifiedRole = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 11, !.orderCancelledV2ReturnBitfield11 = <<128>>, !.executorQualifiedRole = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 17, !.orderCancelledV2ReturnBitfield17 = <<128>>, !.custOrderHandlingInst = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderCancelledV2Message([ZeroOrderCancelledV2Message EXCEPT !.numberOfReturnBitfields = 18, !.orderCancelledV2ReturnBitfield18 = <<4>>, !.subreason = one]) : one \in { <<held>> : held \in Sample(1) } }

(***************************************************************************)
(* Quote Cancelled Message: 41 bytes                                       *)
(***************************************************************************)

QuoteCancelledMessage ==
    [ transactionTime : Sample(8),
      quoteUpdateId   : Sample(16),
      orderId         : Sample(8),
      symbolShort     : Sample(6),
      side            : Sample(1),
      cancelReason    : Sample(1),
      cancelSubreason : Sample(1) ]

EncodeQuoteCancelledMessage(message) ==
    message.transactionTime
        \o message.quoteUpdateId
        \o message.orderId
        \o message.symbolShort
        \o message.side
        \o message.cancelReason
        \o message.cancelSubreason

DecodeQuoteCancelledMessage(bytes) ==
    LET transactionTime == ReadBytes(bytes, 8) IN IF ~transactionTime.ok THEN Fail ELSE
    LET quoteUpdateId == ReadBytes(transactionTime.rest, 16) IN IF ~quoteUpdateId.ok THEN Fail ELSE
    LET orderId == ReadBytes(quoteUpdateId.rest, 8) IN IF ~orderId.ok THEN Fail ELSE
    LET symbolShort == ReadBytes(orderId.rest, 6) IN IF ~symbolShort.ok THEN Fail ELSE
    LET side == ReadBytes(symbolShort.rest, 1) IN IF ~side.ok THEN Fail ELSE
    LET cancelReason == ReadBytes(side.rest, 1) IN IF ~cancelReason.ok THEN Fail ELSE
    LET cancelSubreason == ReadBytes(cancelReason.rest, 1) IN IF ~cancelSubreason.ok THEN Fail ELSE
    Ok([ transactionTime |-> transactionTime.value,
         quoteUpdateId   |-> quoteUpdateId.value,
         orderId         |-> orderId.value,
         symbolShort     |-> symbolShort.value,
         side            |-> side.value,
         cancelReason    |-> cancelReason.value,
         cancelSubreason |-> cancelSubreason.value ], cancelSubreason.rest)

ZeroQuoteCancelledMessage ==
    [ transactionTime |-> [i \in 1 .. 8 |-> 0],
      quoteUpdateId   |-> [i \in 1 .. 16 |-> 0],
      orderId         |-> [i \in 1 .. 8 |-> 0],
      symbolShort     |-> [i \in 1 .. 6 |-> 0],
      side            |-> [i \in 1 .. 1 |-> 0],
      cancelReason    |-> [i \in 1 .. 1 |-> 0],
      cancelSubreason |-> [i \in 1 .. 1 |-> 0] ]

(* Quote Cancelled Message at zero, then each field in turn at the values it is checked at *)
CheckedQuoteCancelledMessage ==
    { ZeroQuoteCancelledMessage }
        \cup { [ZeroQuoteCancelledMessage EXCEPT !.transactionTime = one] : one \in Sample(8) }
        \cup { [ZeroQuoteCancelledMessage EXCEPT !.quoteUpdateId = one] : one \in Sample(16) }
        \cup { [ZeroQuoteCancelledMessage EXCEPT !.orderId = one] : one \in Sample(8) }
        \cup { [ZeroQuoteCancelledMessage EXCEPT !.symbolShort = one] : one \in Sample(6) }
        \cup { [ZeroQuoteCancelledMessage EXCEPT !.side = one] : one \in Sample(1) }
        \cup { [ZeroQuoteCancelledMessage EXCEPT !.cancelReason = one] : one \in Sample(1) }
        \cup { [ZeroQuoteCancelledMessage EXCEPT !.cancelSubreason = one] : one \in Sample(1) }

(***************************************************************************)
(* Cross Order Cancelled Order Allocations                                 *)
(***************************************************************************)

CrossOrderCancelledOrderAllocations ==
    [ clOrdId               : Sample(20),
      orderId               : Sample(8),
      side                  : { << >> } \cup { <<held>> : held \in Sample(1) },
      allocQty              : { << >> } \cup { <<held>> : held \in Sample(4) },
      capacity              : { << >> } \cup { <<held>> : held \in Sample(1) },
      openClose             : { << >> } \cup { <<held>> : held \in Sample(1) },
      account               : { << >> } \cup { <<held>> : held \in Sample(16) },
      clearingAccount       : { << >> } \cup { <<held>> : held \in Sample(4) },
      clearingFirm          : { << >> } \cup { <<held>> : held \in Sample(4) },
      custOrderHandlingInst : { << >> } \cup { <<held>> : held \in Sample(1) },
      accountType           : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderOrigination      : { << >> } \cup { <<held>> : held \in Sample(1) },
      algorithmicIndicator  : { << >> } \cup { <<held>> : held \in Sample(1) },
      clientId              : { << >> } \cup { <<held>> : held \in Sample(4) },
      clientQualifiedRole   : { << >> } \cup { <<held>> : held \in Sample(1) },
      investorId            : { << >> } \cup { <<held>> : held \in Sample(4) },
      investorQualifiedRole : { << >> } \cup { <<held>> : held \in Sample(1) },
      executorId            : { << >> } \cup { <<held>> : held \in Sample(4) },
      executorQualifiedRole : { << >> } \cup { <<held>> : held \in Sample(1) } ]

EncodeCrossOrderCancelledOrderAllocations(message) ==
    message.clOrdId
        \o message.orderId
        \o (IF message.side = << >> THEN << >> ELSE message.side[1])
        \o (IF message.allocQty = << >> THEN << >> ELSE message.allocQty[1])
        \o (IF message.capacity = << >> THEN << >> ELSE message.capacity[1])
        \o (IF message.openClose = << >> THEN << >> ELSE message.openClose[1])
        \o (IF message.account = << >> THEN << >> ELSE message.account[1])
        \o (IF message.clearingAccount = << >> THEN << >> ELSE message.clearingAccount[1])
        \o (IF message.clearingFirm = << >> THEN << >> ELSE message.clearingFirm[1])
        \o (IF message.custOrderHandlingInst = << >> THEN << >> ELSE message.custOrderHandlingInst[1])
        \o (IF message.accountType = << >> THEN << >> ELSE message.accountType[1])
        \o (IF message.orderOrigination = << >> THEN << >> ELSE message.orderOrigination[1])
        \o (IF message.algorithmicIndicator = << >> THEN << >> ELSE message.algorithmicIndicator[1])
        \o (IF message.clientId = << >> THEN << >> ELSE message.clientId[1])
        \o (IF message.clientQualifiedRole = << >> THEN << >> ELSE message.clientQualifiedRole[1])
        \o (IF message.investorId = << >> THEN << >> ELSE message.investorId[1])
        \o (IF message.investorQualifiedRole = << >> THEN << >> ELSE message.investorQualifiedRole[1])
        \o (IF message.executorId = << >> THEN << >> ELSE message.executorId[1])
        \o (IF message.executorQualifiedRole = << >> THEN << >> ELSE message.executorQualifiedRole[1])

DecodeCrossOrderCancelledOrderAllocations(bytes, handedNumberOfReturnBitfields, handedCrossOrderCancelledReturnBitfield1, handedCrossOrderCancelledReturnBitfield2, handedCrossOrderCancelledReturnBitfield3, handedCrossOrderCancelledReturnBitfield4, handedCrossOrderCancelledReturnBitfield10, handedCrossOrderCancelledReturnBitfield11, handedCrossOrderCancelledReturnBitfield17, handedCrossOrderCancelledReturnBitfield18) ==
    LET clOrdId == ReadBytes(bytes, 20) IN IF ~clOrdId.ok THEN Fail ELSE
    LET orderId == ReadBytes(clOrdId.rest, 8) IN IF ~orderId.ok THEN Fail ELSE
    LET side == ReadWhen(handedNumberOfReturnBitfields >= 1 /\ (handedCrossOrderCancelledReturnBitfield1 # << >> /\ handedCrossOrderCancelledReturnBitfield1[1] % 2 > 0), ReadBytes(orderId.rest, 1), orderId.rest) IN IF ~side.ok THEN Fail ELSE
    LET allocQty == ReadWhen(handedNumberOfReturnBitfields >= 10 /\ (handedCrossOrderCancelledReturnBitfield10 # << >> /\ (handedCrossOrderCancelledReturnBitfield10[1] \div 2) % 2 > 0), ReadBytes(side.rest, 4), side.rest) IN IF ~allocQty.ok THEN Fail ELSE
    LET capacity == ReadWhen(handedNumberOfReturnBitfields >= 2 /\ (handedCrossOrderCancelledReturnBitfield2 # << >> /\ (handedCrossOrderCancelledReturnBitfield2[1] \div 64) % 2 > 0), ReadBytes(allocQty.rest, 1), allocQty.rest) IN IF ~capacity.ok THEN Fail ELSE
    LET openClose == ReadWhen(handedNumberOfReturnBitfields >= 4 /\ (handedCrossOrderCancelledReturnBitfield4 # << >> /\ (handedCrossOrderCancelledReturnBitfield4[1] \div 8) % 2 > 0), ReadBytes(capacity.rest, 1), capacity.rest) IN IF ~openClose.ok THEN Fail ELSE
    LET account == ReadWhen(handedNumberOfReturnBitfields >= 3 /\ (handedCrossOrderCancelledReturnBitfield3 # << >> /\ handedCrossOrderCancelledReturnBitfield3[1] % 2 > 0), ReadBytes(openClose.rest, 16), openClose.rest) IN IF ~account.ok THEN Fail ELSE
    LET clearingAccount == ReadWhen(handedNumberOfReturnBitfields >= 3 /\ (handedCrossOrderCancelledReturnBitfield3 # << >> /\ (handedCrossOrderCancelledReturnBitfield3[1] \div 4) % 2 > 0), ReadBytes(account.rest, 4), account.rest) IN IF ~clearingAccount.ok THEN Fail ELSE
    LET clearingFirm == ReadWhen(handedNumberOfReturnBitfields >= 3 /\ (handedCrossOrderCancelledReturnBitfield3 # << >> /\ (handedCrossOrderCancelledReturnBitfield3[1] \div 2) % 2 > 0), ReadBytes(clearingAccount.rest, 4), clearingAccount.rest) IN IF ~clearingFirm.ok THEN Fail ELSE
    LET custOrderHandlingInst == ReadWhen(handedNumberOfReturnBitfields >= 17 /\ (handedCrossOrderCancelledReturnBitfield17 # << >> /\ (handedCrossOrderCancelledReturnBitfield17[1] \div 128) % 2 > 0), ReadBytes(clearingFirm.rest, 1), clearingFirm.rest) IN IF ~custOrderHandlingInst.ok THEN Fail ELSE
    LET accountType == ReadWhen(handedNumberOfReturnBitfields >= 18 /\ (handedCrossOrderCancelledReturnBitfield18 # << >> /\ handedCrossOrderCancelledReturnBitfield18[1] % 2 > 0), ReadBytes(custOrderHandlingInst.rest, 1), custOrderHandlingInst.rest) IN IF ~accountType.ok THEN Fail ELSE
    LET orderOrigination == ReadWhen(handedNumberOfReturnBitfields >= 11 /\ (handedCrossOrderCancelledReturnBitfield11 # << >> /\ (handedCrossOrderCancelledReturnBitfield11[1] \div 8) % 2 > 0), ReadBytes(accountType.rest, 1), accountType.rest) IN IF ~orderOrigination.ok THEN Fail ELSE
    LET algorithmicIndicator == ReadWhen(handedNumberOfReturnBitfields >= 11 /\ (handedCrossOrderCancelledReturnBitfield11 # << >> /\ (handedCrossOrderCancelledReturnBitfield11[1] \div 16) % 2 > 0), ReadBytes(orderOrigination.rest, 1), orderOrigination.rest) IN IF ~algorithmicIndicator.ok THEN Fail ELSE
    LET clientId == ReadWhen(handedNumberOfReturnBitfields >= 11 /\ (handedCrossOrderCancelledReturnBitfield11 # << >> /\ handedCrossOrderCancelledReturnBitfield11[1] % 2 > 0), ReadBytes(algorithmicIndicator.rest, 4), algorithmicIndicator.rest) IN IF ~clientId.ok THEN Fail ELSE
    LET clientQualifiedRole == ReadWhen(handedNumberOfReturnBitfields >= 10 /\ (handedCrossOrderCancelledReturnBitfield10 # << >> /\ (handedCrossOrderCancelledReturnBitfield10[1] \div 128) % 2 > 0), ReadBytes(clientId.rest, 1), clientId.rest) IN IF ~clientQualifiedRole.ok THEN Fail ELSE
    LET investorId == ReadWhen(handedNumberOfReturnBitfields >= 11 /\ (handedCrossOrderCancelledReturnBitfield11 # << >> /\ (handedCrossOrderCancelledReturnBitfield11[1] \div 2) % 2 > 0), ReadBytes(clientQualifiedRole.rest, 4), clientQualifiedRole.rest) IN IF ~investorId.ok THEN Fail ELSE
    LET investorQualifiedRole == ReadWhen(handedNumberOfReturnBitfields >= 11 /\ (handedCrossOrderCancelledReturnBitfield11 # << >> /\ (handedCrossOrderCancelledReturnBitfield11[1] \div 64) % 2 > 0), ReadBytes(investorId.rest, 1), investorId.rest) IN IF ~investorQualifiedRole.ok THEN Fail ELSE
    LET executorId == ReadWhen(handedNumberOfReturnBitfields >= 11 /\ (handedCrossOrderCancelledReturnBitfield11 # << >> /\ (handedCrossOrderCancelledReturnBitfield11[1] \div 4) % 2 > 0), ReadBytes(investorQualifiedRole.rest, 4), investorQualifiedRole.rest) IN IF ~executorId.ok THEN Fail ELSE
    LET executorQualifiedRole == ReadWhen(handedNumberOfReturnBitfields >= 11 /\ (handedCrossOrderCancelledReturnBitfield11 # << >> /\ (handedCrossOrderCancelledReturnBitfield11[1] \div 128) % 2 > 0), ReadBytes(executorId.rest, 1), executorId.rest) IN IF ~executorQualifiedRole.ok THEN Fail ELSE
    Ok([ clOrdId               |-> clOrdId.value,
         orderId               |-> orderId.value,
         side                  |-> side.value,
         allocQty              |-> allocQty.value,
         capacity              |-> capacity.value,
         openClose             |-> openClose.value,
         account               |-> account.value,
         clearingAccount       |-> clearingAccount.value,
         clearingFirm          |-> clearingFirm.value,
         custOrderHandlingInst |-> custOrderHandlingInst.value,
         accountType           |-> accountType.value,
         orderOrigination      |-> orderOrigination.value,
         algorithmicIndicator  |-> algorithmicIndicator.value,
         clientId              |-> clientId.value,
         clientQualifiedRole   |-> clientQualifiedRole.value,
         investorId            |-> investorId.value,
         investorQualifiedRole |-> investorQualifiedRole.value,
         executorId            |-> executorId.value,
         executorQualifiedRole |-> executorQualifiedRole.value ], executorQualifiedRole.rest)

(* Cross Order Cancelled Order Allocations with each field marked present by fields before it there exactly where they say *)
SettleCrossOrderCancelledOrderAllocations(message, handedNumberOfReturnBitfields, handedCrossOrderCancelledReturnBitfield1, handedCrossOrderCancelledReturnBitfield2, handedCrossOrderCancelledReturnBitfield3, handedCrossOrderCancelledReturnBitfield4, handedCrossOrderCancelledReturnBitfield10, handedCrossOrderCancelledReturnBitfield11, handedCrossOrderCancelledReturnBitfield17, handedCrossOrderCancelledReturnBitfield18) ==
    LET settled1 == [message EXCEPT !.side = IF handedNumberOfReturnBitfields >= 1 /\ (handedCrossOrderCancelledReturnBitfield1 # << >> /\ handedCrossOrderCancelledReturnBitfield1[1] % 2 > 0) THEN (IF message.side = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE message.side) ELSE << >>]
        settled2 == [settled1 EXCEPT !.allocQty = IF handedNumberOfReturnBitfields >= 10 /\ (handedCrossOrderCancelledReturnBitfield10 # << >> /\ (handedCrossOrderCancelledReturnBitfield10[1] \div 2) % 2 > 0) THEN (IF settled1.allocQty = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled1.allocQty) ELSE << >>]
        settled3 == [settled2 EXCEPT !.capacity = IF handedNumberOfReturnBitfields >= 2 /\ (handedCrossOrderCancelledReturnBitfield2 # << >> /\ (handedCrossOrderCancelledReturnBitfield2[1] \div 64) % 2 > 0) THEN (IF settled2.capacity = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled2.capacity) ELSE << >>]
        settled4 == [settled3 EXCEPT !.openClose = IF handedNumberOfReturnBitfields >= 4 /\ (handedCrossOrderCancelledReturnBitfield4 # << >> /\ (handedCrossOrderCancelledReturnBitfield4[1] \div 8) % 2 > 0) THEN (IF settled3.openClose = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled3.openClose) ELSE << >>]
        settled5 == [settled4 EXCEPT !.account = IF handedNumberOfReturnBitfields >= 3 /\ (handedCrossOrderCancelledReturnBitfield3 # << >> /\ handedCrossOrderCancelledReturnBitfield3[1] % 2 > 0) THEN (IF settled4.account = << >> THEN <<[i \in 1 .. 16 |-> 0]>> ELSE settled4.account) ELSE << >>]
        settled6 == [settled5 EXCEPT !.clearingAccount = IF handedNumberOfReturnBitfields >= 3 /\ (handedCrossOrderCancelledReturnBitfield3 # << >> /\ (handedCrossOrderCancelledReturnBitfield3[1] \div 4) % 2 > 0) THEN (IF settled5.clearingAccount = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled5.clearingAccount) ELSE << >>]
        settled7 == [settled6 EXCEPT !.clearingFirm = IF handedNumberOfReturnBitfields >= 3 /\ (handedCrossOrderCancelledReturnBitfield3 # << >> /\ (handedCrossOrderCancelledReturnBitfield3[1] \div 2) % 2 > 0) THEN (IF settled6.clearingFirm = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled6.clearingFirm) ELSE << >>]
        settled8 == [settled7 EXCEPT !.custOrderHandlingInst = IF handedNumberOfReturnBitfields >= 17 /\ (handedCrossOrderCancelledReturnBitfield17 # << >> /\ (handedCrossOrderCancelledReturnBitfield17[1] \div 128) % 2 > 0) THEN (IF settled7.custOrderHandlingInst = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled7.custOrderHandlingInst) ELSE << >>]
        settled9 == [settled8 EXCEPT !.accountType = IF handedNumberOfReturnBitfields >= 18 /\ (handedCrossOrderCancelledReturnBitfield18 # << >> /\ handedCrossOrderCancelledReturnBitfield18[1] % 2 > 0) THEN (IF settled8.accountType = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled8.accountType) ELSE << >>]
        settled10 == [settled9 EXCEPT !.orderOrigination = IF handedNumberOfReturnBitfields >= 11 /\ (handedCrossOrderCancelledReturnBitfield11 # << >> /\ (handedCrossOrderCancelledReturnBitfield11[1] \div 8) % 2 > 0) THEN (IF settled9.orderOrigination = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled9.orderOrigination) ELSE << >>]
        settled11 == [settled10 EXCEPT !.algorithmicIndicator = IF handedNumberOfReturnBitfields >= 11 /\ (handedCrossOrderCancelledReturnBitfield11 # << >> /\ (handedCrossOrderCancelledReturnBitfield11[1] \div 16) % 2 > 0) THEN (IF settled10.algorithmicIndicator = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled10.algorithmicIndicator) ELSE << >>]
        settled12 == [settled11 EXCEPT !.clientId = IF handedNumberOfReturnBitfields >= 11 /\ (handedCrossOrderCancelledReturnBitfield11 # << >> /\ handedCrossOrderCancelledReturnBitfield11[1] % 2 > 0) THEN (IF settled11.clientId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled11.clientId) ELSE << >>]
        settled13 == [settled12 EXCEPT !.clientQualifiedRole = IF handedNumberOfReturnBitfields >= 10 /\ (handedCrossOrderCancelledReturnBitfield10 # << >> /\ (handedCrossOrderCancelledReturnBitfield10[1] \div 128) % 2 > 0) THEN (IF settled12.clientQualifiedRole = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled12.clientQualifiedRole) ELSE << >>]
        settled14 == [settled13 EXCEPT !.investorId = IF handedNumberOfReturnBitfields >= 11 /\ (handedCrossOrderCancelledReturnBitfield11 # << >> /\ (handedCrossOrderCancelledReturnBitfield11[1] \div 2) % 2 > 0) THEN (IF settled13.investorId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled13.investorId) ELSE << >>]
        settled15 == [settled14 EXCEPT !.investorQualifiedRole = IF handedNumberOfReturnBitfields >= 11 /\ (handedCrossOrderCancelledReturnBitfield11 # << >> /\ (handedCrossOrderCancelledReturnBitfield11[1] \div 64) % 2 > 0) THEN (IF settled14.investorQualifiedRole = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled14.investorQualifiedRole) ELSE << >>]
        settled16 == [settled15 EXCEPT !.executorId = IF handedNumberOfReturnBitfields >= 11 /\ (handedCrossOrderCancelledReturnBitfield11 # << >> /\ (handedCrossOrderCancelledReturnBitfield11[1] \div 4) % 2 > 0) THEN (IF settled15.executorId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled15.executorId) ELSE << >>]
        settled17 == [settled16 EXCEPT !.executorQualifiedRole = IF handedNumberOfReturnBitfields >= 11 /\ (handedCrossOrderCancelledReturnBitfield11 # << >> /\ (handedCrossOrderCancelledReturnBitfield11[1] \div 128) % 2 > 0) THEN (IF settled16.executorQualifiedRole = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled16.executorQualifiedRole) ELSE << >>]
    IN  settled17

ZeroCrossOrderCancelledOrderAllocations ==
    SettleCrossOrderCancelledOrderAllocations([ clOrdId               |-> [i \in 1 .. 20 |-> 0],
                                                orderId               |-> [i \in 1 .. 8 |-> 0],
                                                side                  |-> << >>,
                                                allocQty              |-> << >>,
                                                capacity              |-> << >>,
                                                openClose             |-> << >>,
                                                account               |-> << >>,
                                                clearingAccount       |-> << >>,
                                                clearingFirm          |-> << >>,
                                                custOrderHandlingInst |-> << >>,
                                                accountType           |-> << >>,
                                                orderOrigination      |-> << >>,
                                                algorithmicIndicator  |-> << >>,
                                                clientId              |-> << >>,
                                                clientQualifiedRole   |-> << >>,
                                                investorId            |-> << >>,
                                                investorQualifiedRole |-> << >>,
                                                executorId            |-> << >>,
                                                executorQualifiedRole |-> << >> ], 0, << >>, << >>, << >>, << >>, << >>, << >>, << >>, << >>)

(* Cross Order Cancelled Order Allocations at zero, then each field in turn at the values it is checked at *)
CheckedCrossOrderCancelledOrderAllocations ==
    { [given |-> <<0, << >>, << >>, << >>, << >>, << >>, << >>, << >>, << >>>>, message |-> ZeroCrossOrderCancelledOrderAllocations] }
        \cup { [given |-> <<0, << >>, << >>, << >>, << >>, << >>, << >>, << >>, << >>>>, message |-> SettleCrossOrderCancelledOrderAllocations([ZeroCrossOrderCancelledOrderAllocations EXCEPT !.clOrdId = one], 0, << >>, << >>, << >>, << >>, << >>, << >>, << >>, << >>)] : one \in Sample(20) }
        \cup { [given |-> <<0, << >>, << >>, << >>, << >>, << >>, << >>, << >>, << >>>>, message |-> SettleCrossOrderCancelledOrderAllocations([ZeroCrossOrderCancelledOrderAllocations EXCEPT !.orderId = one], 0, << >>, << >>, << >>, << >>, << >>, << >>, << >>, << >>)] : one \in Sample(8) }
        \cup { [given |-> <<1, <<1>>, << >>, << >>, << >>, << >>, << >>, << >>, << >>>>, message |-> SettleCrossOrderCancelledOrderAllocations([ZeroCrossOrderCancelledOrderAllocations EXCEPT !.side = one], 1, <<1>>, << >>, << >>, << >>, << >>, << >>, << >>, << >>)] : one \in { <<held>> : held \in Sample(1) } }
        \cup { [given |-> <<10, << >>, << >>, << >>, << >>, <<2>>, << >>, << >>, << >>>>, message |-> SettleCrossOrderCancelledOrderAllocations([ZeroCrossOrderCancelledOrderAllocations EXCEPT !.allocQty = one], 10, << >>, << >>, << >>, << >>, <<2>>, << >>, << >>, << >>)] : one \in { <<held>> : held \in Sample(4) } }
        \cup { [given |-> <<2, << >>, <<64>>, << >>, << >>, << >>, << >>, << >>, << >>>>, message |-> SettleCrossOrderCancelledOrderAllocations([ZeroCrossOrderCancelledOrderAllocations EXCEPT !.capacity = one], 2, << >>, <<64>>, << >>, << >>, << >>, << >>, << >>, << >>)] : one \in { <<held>> : held \in Sample(1) } }
        \cup { [given |-> <<4, << >>, << >>, << >>, <<8>>, << >>, << >>, << >>, << >>>>, message |-> SettleCrossOrderCancelledOrderAllocations([ZeroCrossOrderCancelledOrderAllocations EXCEPT !.openClose = one], 4, << >>, << >>, << >>, <<8>>, << >>, << >>, << >>, << >>)] : one \in { <<held>> : held \in Sample(1) } }
        \cup { [given |-> <<3, << >>, << >>, <<1>>, << >>, << >>, << >>, << >>, << >>>>, message |-> SettleCrossOrderCancelledOrderAllocations([ZeroCrossOrderCancelledOrderAllocations EXCEPT !.account = one], 3, << >>, << >>, <<1>>, << >>, << >>, << >>, << >>, << >>)] : one \in { <<held>> : held \in Sample(16) } }
        \cup { [given |-> <<3, << >>, << >>, <<4>>, << >>, << >>, << >>, << >>, << >>>>, message |-> SettleCrossOrderCancelledOrderAllocations([ZeroCrossOrderCancelledOrderAllocations EXCEPT !.clearingAccount = one], 3, << >>, << >>, <<4>>, << >>, << >>, << >>, << >>, << >>)] : one \in { <<held>> : held \in Sample(4) } }
        \cup { [given |-> <<3, << >>, << >>, <<2>>, << >>, << >>, << >>, << >>, << >>>>, message |-> SettleCrossOrderCancelledOrderAllocations([ZeroCrossOrderCancelledOrderAllocations EXCEPT !.clearingFirm = one], 3, << >>, << >>, <<2>>, << >>, << >>, << >>, << >>, << >>)] : one \in { <<held>> : held \in Sample(4) } }
        \cup { [given |-> <<17, << >>, << >>, << >>, << >>, << >>, << >>, <<128>>, << >>>>, message |-> SettleCrossOrderCancelledOrderAllocations([ZeroCrossOrderCancelledOrderAllocations EXCEPT !.custOrderHandlingInst = one], 17, << >>, << >>, << >>, << >>, << >>, << >>, <<128>>, << >>)] : one \in { <<held>> : held \in Sample(1) } }
        \cup { [given |-> <<18, << >>, << >>, << >>, << >>, << >>, << >>, << >>, <<1>>>>, message |-> SettleCrossOrderCancelledOrderAllocations([ZeroCrossOrderCancelledOrderAllocations EXCEPT !.accountType = one], 18, << >>, << >>, << >>, << >>, << >>, << >>, << >>, <<1>>)] : one \in { <<held>> : held \in Sample(1) } }
        \cup { [given |-> <<11, << >>, << >>, << >>, << >>, << >>, <<8>>, << >>, << >>>>, message |-> SettleCrossOrderCancelledOrderAllocations([ZeroCrossOrderCancelledOrderAllocations EXCEPT !.orderOrigination = one], 11, << >>, << >>, << >>, << >>, << >>, <<8>>, << >>, << >>)] : one \in { <<held>> : held \in Sample(1) } }
        \cup { [given |-> <<11, << >>, << >>, << >>, << >>, << >>, <<16>>, << >>, << >>>>, message |-> SettleCrossOrderCancelledOrderAllocations([ZeroCrossOrderCancelledOrderAllocations EXCEPT !.algorithmicIndicator = one], 11, << >>, << >>, << >>, << >>, << >>, <<16>>, << >>, << >>)] : one \in { <<held>> : held \in Sample(1) } }
        \cup { [given |-> <<11, << >>, << >>, << >>, << >>, << >>, <<1>>, << >>, << >>>>, message |-> SettleCrossOrderCancelledOrderAllocations([ZeroCrossOrderCancelledOrderAllocations EXCEPT !.clientId = one], 11, << >>, << >>, << >>, << >>, << >>, <<1>>, << >>, << >>)] : one \in { <<held>> : held \in Sample(4) } }
        \cup { [given |-> <<10, << >>, << >>, << >>, << >>, <<128>>, << >>, << >>, << >>>>, message |-> SettleCrossOrderCancelledOrderAllocations([ZeroCrossOrderCancelledOrderAllocations EXCEPT !.clientQualifiedRole = one], 10, << >>, << >>, << >>, << >>, <<128>>, << >>, << >>, << >>)] : one \in { <<held>> : held \in Sample(1) } }
        \cup { [given |-> <<11, << >>, << >>, << >>, << >>, << >>, <<2>>, << >>, << >>>>, message |-> SettleCrossOrderCancelledOrderAllocations([ZeroCrossOrderCancelledOrderAllocations EXCEPT !.investorId = one], 11, << >>, << >>, << >>, << >>, << >>, <<2>>, << >>, << >>)] : one \in { <<held>> : held \in Sample(4) } }
        \cup { [given |-> <<11, << >>, << >>, << >>, << >>, << >>, <<64>>, << >>, << >>>>, message |-> SettleCrossOrderCancelledOrderAllocations([ZeroCrossOrderCancelledOrderAllocations EXCEPT !.investorQualifiedRole = one], 11, << >>, << >>, << >>, << >>, << >>, <<64>>, << >>, << >>)] : one \in { <<held>> : held \in Sample(1) } }
        \cup { [given |-> <<11, << >>, << >>, << >>, << >>, << >>, <<4>>, << >>, << >>>>, message |-> SettleCrossOrderCancelledOrderAllocations([ZeroCrossOrderCancelledOrderAllocations EXCEPT !.executorId = one], 11, << >>, << >>, << >>, << >>, << >>, <<4>>, << >>, << >>)] : one \in { <<held>> : held \in Sample(4) } }
        \cup { [given |-> <<11, << >>, << >>, << >>, << >>, << >>, <<128>>, << >>, << >>>>, message |-> SettleCrossOrderCancelledOrderAllocations([ZeroCrossOrderCancelledOrderAllocations EXCEPT !.executorQualifiedRole = one], 11, << >>, << >>, << >>, << >>, << >>, <<128>>, << >>, << >>)] : one \in { <<held>> : held \in Sample(1) } }

(* A run of Cross Order Cancelled Order Allocations, written one after another *)
RECURSIVE EncodeCrossOrderCancelledOrderAllocationsList(_)
EncodeCrossOrderCancelledOrderAllocationsList(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeCrossOrderCancelledOrderAllocations(Head(messages)) \o EncodeCrossOrderCancelledOrderAllocationsList(Tail(messages))

(* As many Cross Order Cancelled Order Allocations as the field that counts them says *)
RECURSIVE ReadCrossOrderCancelledOrderAllocationsList(_, _, _, _, _, _, _, _, _, _, _)
ReadCrossOrderCancelledOrderAllocationsList(bytes, count, handedNumberOfReturnBitfields, handedCrossOrderCancelledReturnBitfield1, handedCrossOrderCancelledReturnBitfield2, handedCrossOrderCancelledReturnBitfield3, handedCrossOrderCancelledReturnBitfield4, handedCrossOrderCancelledReturnBitfield10, handedCrossOrderCancelledReturnBitfield11, handedCrossOrderCancelledReturnBitfield17, handedCrossOrderCancelledReturnBitfield18) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeCrossOrderCancelledOrderAllocations(bytes, handedNumberOfReturnBitfields, handedCrossOrderCancelledReturnBitfield1, handedCrossOrderCancelledReturnBitfield2, handedCrossOrderCancelledReturnBitfield3, handedCrossOrderCancelledReturnBitfield4, handedCrossOrderCancelledReturnBitfield10, handedCrossOrderCancelledReturnBitfield11, handedCrossOrderCancelledReturnBitfield17, handedCrossOrderCancelledReturnBitfield18)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadCrossOrderCancelledOrderAllocationsList(one.rest, count - 1, handedNumberOfReturnBitfields, handedCrossOrderCancelledReturnBitfield1, handedCrossOrderCancelledReturnBitfield2, handedCrossOrderCancelledReturnBitfield3, handedCrossOrderCancelledReturnBitfield4, handedCrossOrderCancelledReturnBitfield10, handedCrossOrderCancelledReturnBitfield11, handedCrossOrderCancelledReturnBitfield17, handedCrossOrderCancelledReturnBitfield18)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Cross Order Cancelled Order Allocations of each kind, for the lists that carry them *)
OneCrossOrderCancelledOrderAllocations == { ZeroCrossOrderCancelledOrderAllocations }

(***************************************************************************)
(* Cross Order Cancelled Message                                           *)
(***************************************************************************)

CrossOrderCancelledMessage ==
    [ transactionTime                     : Sample(8),
      crossId                             : Sample(20),
      cancelReason                        : Sample(1),
      reserved1                           : Sample(1),
      numberOfReturnBitfields             : 0 .. 255,
      crossOrderCancelledReturnBitfield1  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderCancelledReturnBitfield2  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderCancelledReturnBitfield3  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderCancelledReturnBitfield4  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderCancelledReturnBitfield5  : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderCancelledReturnBitfield6  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderCancelledReturnBitfield7  : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderCancelledReturnBitfield8  : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderCancelledReturnBitfield9  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderCancelledReturnBitfield10 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderCancelledReturnBitfield11 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderCancelledReturnBitfield12 : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderCancelledReturnBitfield13 : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderCancelledReturnBitfield14 : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderCancelledReturnBitfield15 : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderCancelledReturnBitfield16 : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderCancelledReturnBitfield17 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderCancelledReturnBitfield18 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderCancelledReturnBitfield19 : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderCancelledOrderAllocations : SampleLists(OneCrossOrderCancelledOrderAllocations),
      price                               : { << >> } \cup { <<held>> : held \in Sample(8) },
      symbolLong                          : { << >> } \cup { <<held>> : held \in Sample(8) },
      idSource                            : { << >> } \cup { <<held>> : held \in Sample(1) },
      securityId                          : { << >> } \cup { <<held>> : held \in Sample(16) },
      orderQty                            : { << >> } \cup { <<held>> : held \in Sample(4) },
      preventMatch                        : { << >> } \cup { <<held>> : held \in Sample(3) },
      extExecInst                         : { << >> } \cup { <<held>> : held \in Sample(1) },
      auctionId                           : { << >> } \cup { <<held>> : held \in Sample(8) },
      liquidityProvision                  : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossType                           : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossPrioritization                 : { << >> } \cup { <<held>> : held \in Sample(1) },
      routingFirmId                       : { << >> } \cup { <<held>> : held \in Sample(4) } ]

EncodeCrossOrderCancelledMessage(message) ==
    message.transactionTime
        \o message.crossId
        \o message.cancelReason
        \o message.reserved1
        \o EncodeUIntBE(message.numberOfReturnBitfields, 1)
        \o (IF message.crossOrderCancelledReturnBitfield1 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderCancelledReturnBitfield1[1], 1))
        \o (IF message.crossOrderCancelledReturnBitfield2 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderCancelledReturnBitfield2[1], 1))
        \o (IF message.crossOrderCancelledReturnBitfield3 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderCancelledReturnBitfield3[1], 1))
        \o (IF message.crossOrderCancelledReturnBitfield4 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderCancelledReturnBitfield4[1], 1))
        \o (IF message.crossOrderCancelledReturnBitfield5 = << >> THEN << >> ELSE message.crossOrderCancelledReturnBitfield5[1])
        \o (IF message.crossOrderCancelledReturnBitfield6 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderCancelledReturnBitfield6[1], 1))
        \o (IF message.crossOrderCancelledReturnBitfield7 = << >> THEN << >> ELSE message.crossOrderCancelledReturnBitfield7[1])
        \o (IF message.crossOrderCancelledReturnBitfield8 = << >> THEN << >> ELSE message.crossOrderCancelledReturnBitfield8[1])
        \o (IF message.crossOrderCancelledReturnBitfield9 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderCancelledReturnBitfield9[1], 1))
        \o (IF message.crossOrderCancelledReturnBitfield10 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderCancelledReturnBitfield10[1], 1))
        \o (IF message.crossOrderCancelledReturnBitfield11 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderCancelledReturnBitfield11[1], 1))
        \o (IF message.crossOrderCancelledReturnBitfield12 = << >> THEN << >> ELSE message.crossOrderCancelledReturnBitfield12[1])
        \o (IF message.crossOrderCancelledReturnBitfield13 = << >> THEN << >> ELSE message.crossOrderCancelledReturnBitfield13[1])
        \o (IF message.crossOrderCancelledReturnBitfield14 = << >> THEN << >> ELSE message.crossOrderCancelledReturnBitfield14[1])
        \o (IF message.crossOrderCancelledReturnBitfield15 = << >> THEN << >> ELSE message.crossOrderCancelledReturnBitfield15[1])
        \o (IF message.crossOrderCancelledReturnBitfield16 = << >> THEN << >> ELSE message.crossOrderCancelledReturnBitfield16[1])
        \o (IF message.crossOrderCancelledReturnBitfield17 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderCancelledReturnBitfield17[1], 1))
        \o (IF message.crossOrderCancelledReturnBitfield18 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderCancelledReturnBitfield18[1], 1))
        \o (IF message.crossOrderCancelledReturnBitfield19 = << >> THEN << >> ELSE message.crossOrderCancelledReturnBitfield19[1])
        \o EncodeUIntLE(Len(message.crossOrderCancelledOrderAllocations), 2)
        \o EncodeCrossOrderCancelledOrderAllocationsList(message.crossOrderCancelledOrderAllocations)
        \o (IF message.price = << >> THEN << >> ELSE message.price[1])
        \o (IF message.symbolLong = << >> THEN << >> ELSE message.symbolLong[1])
        \o (IF message.idSource = << >> THEN << >> ELSE message.idSource[1])
        \o (IF message.securityId = << >> THEN << >> ELSE message.securityId[1])
        \o (IF message.orderQty = << >> THEN << >> ELSE message.orderQty[1])
        \o (IF message.preventMatch = << >> THEN << >> ELSE message.preventMatch[1])
        \o (IF message.extExecInst = << >> THEN << >> ELSE message.extExecInst[1])
        \o (IF message.auctionId = << >> THEN << >> ELSE message.auctionId[1])
        \o (IF message.liquidityProvision = << >> THEN << >> ELSE message.liquidityProvision[1])
        \o (IF message.crossType = << >> THEN << >> ELSE message.crossType[1])
        \o (IF message.crossPrioritization = << >> THEN << >> ELSE message.crossPrioritization[1])
        \o (IF message.routingFirmId = << >> THEN << >> ELSE message.routingFirmId[1])

DecodeCrossOrderCancelledMessage(bytes) ==
    LET transactionTime == ReadBytes(bytes, 8) IN IF ~transactionTime.ok THEN Fail ELSE
    LET crossId == ReadBytes(transactionTime.rest, 20) IN IF ~crossId.ok THEN Fail ELSE
    LET cancelReason == ReadBytes(crossId.rest, 1) IN IF ~cancelReason.ok THEN Fail ELSE
    LET reserved1 == ReadBytes(cancelReason.rest, 1) IN IF ~reserved1.ok THEN Fail ELSE
    LET numberOfReturnBitfields == ReadUIntBE(reserved1.rest, 1) IN IF ~numberOfReturnBitfields.ok THEN Fail ELSE
    LET crossOrderCancelledReturnBitfield1 == ReadWhen(numberOfReturnBitfields.value >= 1, ReadUIntLE(numberOfReturnBitfields.rest, 1), numberOfReturnBitfields.rest) IN IF ~crossOrderCancelledReturnBitfield1.ok THEN Fail ELSE
    LET crossOrderCancelledReturnBitfield2 == ReadWhen(numberOfReturnBitfields.value >= 2, ReadUIntLE(crossOrderCancelledReturnBitfield1.rest, 1), crossOrderCancelledReturnBitfield1.rest) IN IF ~crossOrderCancelledReturnBitfield2.ok THEN Fail ELSE
    LET crossOrderCancelledReturnBitfield3 == ReadWhen(numberOfReturnBitfields.value >= 3, ReadUIntLE(crossOrderCancelledReturnBitfield2.rest, 1), crossOrderCancelledReturnBitfield2.rest) IN IF ~crossOrderCancelledReturnBitfield3.ok THEN Fail ELSE
    LET crossOrderCancelledReturnBitfield4 == ReadWhen(numberOfReturnBitfields.value >= 4, ReadUIntLE(crossOrderCancelledReturnBitfield3.rest, 1), crossOrderCancelledReturnBitfield3.rest) IN IF ~crossOrderCancelledReturnBitfield4.ok THEN Fail ELSE
    LET crossOrderCancelledReturnBitfield5 == ReadWhen(numberOfReturnBitfields.value >= 5, ReadBytes(crossOrderCancelledReturnBitfield4.rest, 1), crossOrderCancelledReturnBitfield4.rest) IN IF ~crossOrderCancelledReturnBitfield5.ok THEN Fail ELSE
    LET crossOrderCancelledReturnBitfield6 == ReadWhen(numberOfReturnBitfields.value >= 6, ReadUIntLE(crossOrderCancelledReturnBitfield5.rest, 1), crossOrderCancelledReturnBitfield5.rest) IN IF ~crossOrderCancelledReturnBitfield6.ok THEN Fail ELSE
    LET crossOrderCancelledReturnBitfield7 == ReadWhen(numberOfReturnBitfields.value >= 7, ReadBytes(crossOrderCancelledReturnBitfield6.rest, 1), crossOrderCancelledReturnBitfield6.rest) IN IF ~crossOrderCancelledReturnBitfield7.ok THEN Fail ELSE
    LET crossOrderCancelledReturnBitfield8 == ReadWhen(numberOfReturnBitfields.value >= 8, ReadBytes(crossOrderCancelledReturnBitfield7.rest, 1), crossOrderCancelledReturnBitfield7.rest) IN IF ~crossOrderCancelledReturnBitfield8.ok THEN Fail ELSE
    LET crossOrderCancelledReturnBitfield9 == ReadWhen(numberOfReturnBitfields.value >= 9, ReadUIntLE(crossOrderCancelledReturnBitfield8.rest, 1), crossOrderCancelledReturnBitfield8.rest) IN IF ~crossOrderCancelledReturnBitfield9.ok THEN Fail ELSE
    LET crossOrderCancelledReturnBitfield10 == ReadWhen(numberOfReturnBitfields.value >= 10, ReadUIntLE(crossOrderCancelledReturnBitfield9.rest, 1), crossOrderCancelledReturnBitfield9.rest) IN IF ~crossOrderCancelledReturnBitfield10.ok THEN Fail ELSE
    LET crossOrderCancelledReturnBitfield11 == ReadWhen(numberOfReturnBitfields.value >= 11, ReadUIntLE(crossOrderCancelledReturnBitfield10.rest, 1), crossOrderCancelledReturnBitfield10.rest) IN IF ~crossOrderCancelledReturnBitfield11.ok THEN Fail ELSE
    LET crossOrderCancelledReturnBitfield12 == ReadWhen(numberOfReturnBitfields.value >= 12, ReadBytes(crossOrderCancelledReturnBitfield11.rest, 1), crossOrderCancelledReturnBitfield11.rest) IN IF ~crossOrderCancelledReturnBitfield12.ok THEN Fail ELSE
    LET crossOrderCancelledReturnBitfield13 == ReadWhen(numberOfReturnBitfields.value >= 13, ReadBytes(crossOrderCancelledReturnBitfield12.rest, 1), crossOrderCancelledReturnBitfield12.rest) IN IF ~crossOrderCancelledReturnBitfield13.ok THEN Fail ELSE
    LET crossOrderCancelledReturnBitfield14 == ReadWhen(numberOfReturnBitfields.value >= 14, ReadBytes(crossOrderCancelledReturnBitfield13.rest, 1), crossOrderCancelledReturnBitfield13.rest) IN IF ~crossOrderCancelledReturnBitfield14.ok THEN Fail ELSE
    LET crossOrderCancelledReturnBitfield15 == ReadWhen(numberOfReturnBitfields.value >= 15, ReadBytes(crossOrderCancelledReturnBitfield14.rest, 1), crossOrderCancelledReturnBitfield14.rest) IN IF ~crossOrderCancelledReturnBitfield15.ok THEN Fail ELSE
    LET crossOrderCancelledReturnBitfield16 == ReadWhen(numberOfReturnBitfields.value >= 16, ReadBytes(crossOrderCancelledReturnBitfield15.rest, 1), crossOrderCancelledReturnBitfield15.rest) IN IF ~crossOrderCancelledReturnBitfield16.ok THEN Fail ELSE
    LET crossOrderCancelledReturnBitfield17 == ReadWhen(numberOfReturnBitfields.value >= 17, ReadUIntLE(crossOrderCancelledReturnBitfield16.rest, 1), crossOrderCancelledReturnBitfield16.rest) IN IF ~crossOrderCancelledReturnBitfield17.ok THEN Fail ELSE
    LET crossOrderCancelledReturnBitfield18 == ReadWhen(numberOfReturnBitfields.value >= 18, ReadUIntLE(crossOrderCancelledReturnBitfield17.rest, 1), crossOrderCancelledReturnBitfield17.rest) IN IF ~crossOrderCancelledReturnBitfield18.ok THEN Fail ELSE
    LET crossOrderCancelledReturnBitfield19 == ReadWhen(numberOfReturnBitfields.value >= 19, ReadBytes(crossOrderCancelledReturnBitfield18.rest, 1), crossOrderCancelledReturnBitfield18.rest) IN IF ~crossOrderCancelledReturnBitfield19.ok THEN Fail ELSE
    LET groupCnt == ReadUIntLE(crossOrderCancelledReturnBitfield19.rest, 2) IN IF ~groupCnt.ok THEN Fail ELSE
    LET crossOrderCancelledOrderAllocations == ReadCrossOrderCancelledOrderAllocationsList(groupCnt.rest, groupCnt.value, numberOfReturnBitfields.value, crossOrderCancelledReturnBitfield1.value, crossOrderCancelledReturnBitfield2.value, crossOrderCancelledReturnBitfield3.value, crossOrderCancelledReturnBitfield4.value, crossOrderCancelledReturnBitfield10.value, crossOrderCancelledReturnBitfield11.value, crossOrderCancelledReturnBitfield17.value, crossOrderCancelledReturnBitfield18.value) IN IF ~crossOrderCancelledOrderAllocations.ok THEN Fail ELSE
    LET price == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (crossOrderCancelledReturnBitfield1.value # << >> /\ (crossOrderCancelledReturnBitfield1.value[1] \div 4) % 2 > 0), ReadBytes(crossOrderCancelledOrderAllocations.rest, 8), crossOrderCancelledOrderAllocations.rest) IN IF ~price.ok THEN Fail ELSE
    LET symbolLong == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (crossOrderCancelledReturnBitfield2.value # << >> /\ crossOrderCancelledReturnBitfield2.value[1] % 2 > 0), ReadBytes(price.rest, 8), price.rest) IN IF ~symbolLong.ok THEN Fail ELSE
    LET idSource == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (crossOrderCancelledReturnBitfield2.value # << >> /\ (crossOrderCancelledReturnBitfield2.value[1] \div 8) % 2 > 0), ReadBytes(symbolLong.rest, 1), symbolLong.rest) IN IF ~idSource.ok THEN Fail ELSE
    LET securityId == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (crossOrderCancelledReturnBitfield2.value # << >> /\ (crossOrderCancelledReturnBitfield2.value[1] \div 16) % 2 > 0), ReadBytes(idSource.rest, 16), idSource.rest) IN IF ~securityId.ok THEN Fail ELSE
    LET orderQty == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (crossOrderCancelledReturnBitfield3.value # << >> /\ (crossOrderCancelledReturnBitfield3.value[1] \div 64) % 2 > 0), ReadBytes(securityId.rest, 4), securityId.rest) IN IF ~orderQty.ok THEN Fail ELSE
    LET preventMatch == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (crossOrderCancelledReturnBitfield3.value # << >> /\ (crossOrderCancelledReturnBitfield3.value[1] \div 128) % 2 > 0), ReadBytes(orderQty.rest, 3), orderQty.rest) IN IF ~preventMatch.ok THEN Fail ELSE
    LET extExecInst == ReadWhen(numberOfReturnBitfields.value >= 6 /\ (crossOrderCancelledReturnBitfield6.value # << >> /\ (crossOrderCancelledReturnBitfield6.value[1] \div 16) % 2 > 0), ReadBytes(preventMatch.rest, 1), preventMatch.rest) IN IF ~extExecInst.ok THEN Fail ELSE
    LET auctionId == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (crossOrderCancelledReturnBitfield9.value # << >> /\ (crossOrderCancelledReturnBitfield9.value[1] \div 4) % 2 > 0), ReadBytes(extExecInst.rest, 8), extExecInst.rest) IN IF ~auctionId.ok THEN Fail ELSE
    LET liquidityProvision == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (crossOrderCancelledReturnBitfield9.value # << >> /\ (crossOrderCancelledReturnBitfield9.value[1] \div 16) % 2 > 0), ReadBytes(auctionId.rest, 1), auctionId.rest) IN IF ~liquidityProvision.ok THEN Fail ELSE
    LET crossType == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (crossOrderCancelledReturnBitfield9.value # << >> /\ (crossOrderCancelledReturnBitfield9.value[1] \div 64) % 2 > 0), ReadBytes(liquidityProvision.rest, 1), liquidityProvision.rest) IN IF ~crossType.ok THEN Fail ELSE
    LET crossPrioritization == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (crossOrderCancelledReturnBitfield9.value # << >> /\ (crossOrderCancelledReturnBitfield9.value[1] \div 128) % 2 > 0), ReadBytes(crossType.rest, 1), crossType.rest) IN IF ~crossPrioritization.ok THEN Fail ELSE
    LET routingFirmId == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (crossOrderCancelledReturnBitfield10.value # << >> /\ (crossOrderCancelledReturnBitfield10.value[1] \div 8) % 2 > 0), ReadBytes(crossPrioritization.rest, 4), crossPrioritization.rest) IN IF ~routingFirmId.ok THEN Fail ELSE
    Ok([ transactionTime                     |-> transactionTime.value,
         crossId                             |-> crossId.value,
         cancelReason                        |-> cancelReason.value,
         reserved1                           |-> reserved1.value,
         numberOfReturnBitfields             |-> numberOfReturnBitfields.value,
         crossOrderCancelledReturnBitfield1  |-> crossOrderCancelledReturnBitfield1.value,
         crossOrderCancelledReturnBitfield2  |-> crossOrderCancelledReturnBitfield2.value,
         crossOrderCancelledReturnBitfield3  |-> crossOrderCancelledReturnBitfield3.value,
         crossOrderCancelledReturnBitfield4  |-> crossOrderCancelledReturnBitfield4.value,
         crossOrderCancelledReturnBitfield5  |-> crossOrderCancelledReturnBitfield5.value,
         crossOrderCancelledReturnBitfield6  |-> crossOrderCancelledReturnBitfield6.value,
         crossOrderCancelledReturnBitfield7  |-> crossOrderCancelledReturnBitfield7.value,
         crossOrderCancelledReturnBitfield8  |-> crossOrderCancelledReturnBitfield8.value,
         crossOrderCancelledReturnBitfield9  |-> crossOrderCancelledReturnBitfield9.value,
         crossOrderCancelledReturnBitfield10 |-> crossOrderCancelledReturnBitfield10.value,
         crossOrderCancelledReturnBitfield11 |-> crossOrderCancelledReturnBitfield11.value,
         crossOrderCancelledReturnBitfield12 |-> crossOrderCancelledReturnBitfield12.value,
         crossOrderCancelledReturnBitfield13 |-> crossOrderCancelledReturnBitfield13.value,
         crossOrderCancelledReturnBitfield14 |-> crossOrderCancelledReturnBitfield14.value,
         crossOrderCancelledReturnBitfield15 |-> crossOrderCancelledReturnBitfield15.value,
         crossOrderCancelledReturnBitfield16 |-> crossOrderCancelledReturnBitfield16.value,
         crossOrderCancelledReturnBitfield17 |-> crossOrderCancelledReturnBitfield17.value,
         crossOrderCancelledReturnBitfield18 |-> crossOrderCancelledReturnBitfield18.value,
         crossOrderCancelledReturnBitfield19 |-> crossOrderCancelledReturnBitfield19.value,
         crossOrderCancelledOrderAllocations |-> crossOrderCancelledOrderAllocations.value,
         price                               |-> price.value,
         symbolLong                          |-> symbolLong.value,
         idSource                            |-> idSource.value,
         securityId                          |-> securityId.value,
         orderQty                            |-> orderQty.value,
         preventMatch                        |-> preventMatch.value,
         extExecInst                         |-> extExecInst.value,
         auctionId                           |-> auctionId.value,
         liquidityProvision                  |-> liquidityProvision.value,
         crossType                           |-> crossType.value,
         crossPrioritization                 |-> crossPrioritization.value,
         routingFirmId                       |-> routingFirmId.value ], routingFirmId.rest)

(* Cross Order Cancelled Message with each field marked present by fields before it there exactly where they say *)
SettleCrossOrderCancelledMessage(message) ==
    LET settled1 == [message EXCEPT !.crossOrderCancelledReturnBitfield1 = IF message.numberOfReturnBitfields >= 1 THEN (IF message.crossOrderCancelledReturnBitfield1 = << >> THEN <<0>> ELSE message.crossOrderCancelledReturnBitfield1) ELSE << >>]
        settled2 == [settled1 EXCEPT !.crossOrderCancelledReturnBitfield2 = IF settled1.numberOfReturnBitfields >= 2 THEN (IF settled1.crossOrderCancelledReturnBitfield2 = << >> THEN <<0>> ELSE settled1.crossOrderCancelledReturnBitfield2) ELSE << >>]
        settled3 == [settled2 EXCEPT !.crossOrderCancelledReturnBitfield3 = IF settled2.numberOfReturnBitfields >= 3 THEN (IF settled2.crossOrderCancelledReturnBitfield3 = << >> THEN <<0>> ELSE settled2.crossOrderCancelledReturnBitfield3) ELSE << >>]
        settled4 == [settled3 EXCEPT !.crossOrderCancelledReturnBitfield4 = IF settled3.numberOfReturnBitfields >= 4 THEN (IF settled3.crossOrderCancelledReturnBitfield4 = << >> THEN <<0>> ELSE settled3.crossOrderCancelledReturnBitfield4) ELSE << >>]
        settled5 == [settled4 EXCEPT !.crossOrderCancelledReturnBitfield5 = IF settled4.numberOfReturnBitfields >= 5 THEN (IF settled4.crossOrderCancelledReturnBitfield5 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled4.crossOrderCancelledReturnBitfield5) ELSE << >>]
        settled6 == [settled5 EXCEPT !.crossOrderCancelledReturnBitfield6 = IF settled5.numberOfReturnBitfields >= 6 THEN (IF settled5.crossOrderCancelledReturnBitfield6 = << >> THEN <<0>> ELSE settled5.crossOrderCancelledReturnBitfield6) ELSE << >>]
        settled7 == [settled6 EXCEPT !.crossOrderCancelledReturnBitfield7 = IF settled6.numberOfReturnBitfields >= 7 THEN (IF settled6.crossOrderCancelledReturnBitfield7 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled6.crossOrderCancelledReturnBitfield7) ELSE << >>]
        settled8 == [settled7 EXCEPT !.crossOrderCancelledReturnBitfield8 = IF settled7.numberOfReturnBitfields >= 8 THEN (IF settled7.crossOrderCancelledReturnBitfield8 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled7.crossOrderCancelledReturnBitfield8) ELSE << >>]
        settled9 == [settled8 EXCEPT !.crossOrderCancelledReturnBitfield9 = IF settled8.numberOfReturnBitfields >= 9 THEN (IF settled8.crossOrderCancelledReturnBitfield9 = << >> THEN <<0>> ELSE settled8.crossOrderCancelledReturnBitfield9) ELSE << >>]
        settled10 == [settled9 EXCEPT !.crossOrderCancelledReturnBitfield10 = IF settled9.numberOfReturnBitfields >= 10 THEN (IF settled9.crossOrderCancelledReturnBitfield10 = << >> THEN <<0>> ELSE settled9.crossOrderCancelledReturnBitfield10) ELSE << >>]
        settled11 == [settled10 EXCEPT !.crossOrderCancelledReturnBitfield11 = IF settled10.numberOfReturnBitfields >= 11 THEN (IF settled10.crossOrderCancelledReturnBitfield11 = << >> THEN <<0>> ELSE settled10.crossOrderCancelledReturnBitfield11) ELSE << >>]
        settled12 == [settled11 EXCEPT !.crossOrderCancelledReturnBitfield12 = IF settled11.numberOfReturnBitfields >= 12 THEN (IF settled11.crossOrderCancelledReturnBitfield12 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled11.crossOrderCancelledReturnBitfield12) ELSE << >>]
        settled13 == [settled12 EXCEPT !.crossOrderCancelledReturnBitfield13 = IF settled12.numberOfReturnBitfields >= 13 THEN (IF settled12.crossOrderCancelledReturnBitfield13 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled12.crossOrderCancelledReturnBitfield13) ELSE << >>]
        settled14 == [settled13 EXCEPT !.crossOrderCancelledReturnBitfield14 = IF settled13.numberOfReturnBitfields >= 14 THEN (IF settled13.crossOrderCancelledReturnBitfield14 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled13.crossOrderCancelledReturnBitfield14) ELSE << >>]
        settled15 == [settled14 EXCEPT !.crossOrderCancelledReturnBitfield15 = IF settled14.numberOfReturnBitfields >= 15 THEN (IF settled14.crossOrderCancelledReturnBitfield15 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled14.crossOrderCancelledReturnBitfield15) ELSE << >>]
        settled16 == [settled15 EXCEPT !.crossOrderCancelledReturnBitfield16 = IF settled15.numberOfReturnBitfields >= 16 THEN (IF settled15.crossOrderCancelledReturnBitfield16 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled15.crossOrderCancelledReturnBitfield16) ELSE << >>]
        settled17 == [settled16 EXCEPT !.crossOrderCancelledReturnBitfield17 = IF settled16.numberOfReturnBitfields >= 17 THEN (IF settled16.crossOrderCancelledReturnBitfield17 = << >> THEN <<0>> ELSE settled16.crossOrderCancelledReturnBitfield17) ELSE << >>]
        settled18 == [settled17 EXCEPT !.crossOrderCancelledReturnBitfield18 = IF settled17.numberOfReturnBitfields >= 18 THEN (IF settled17.crossOrderCancelledReturnBitfield18 = << >> THEN <<0>> ELSE settled17.crossOrderCancelledReturnBitfield18) ELSE << >>]
        settled19 == [settled18 EXCEPT !.crossOrderCancelledReturnBitfield19 = IF settled18.numberOfReturnBitfields >= 19 THEN (IF settled18.crossOrderCancelledReturnBitfield19 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled18.crossOrderCancelledReturnBitfield19) ELSE << >>]
        settled20 == [settled19 EXCEPT !.crossOrderCancelledOrderAllocations = [i \in DOMAIN settled19.crossOrderCancelledOrderAllocations |-> SettleCrossOrderCancelledOrderAllocations(settled19.crossOrderCancelledOrderAllocations[i], settled19.numberOfReturnBitfields, settled19.crossOrderCancelledReturnBitfield1, settled19.crossOrderCancelledReturnBitfield2, settled19.crossOrderCancelledReturnBitfield3, settled19.crossOrderCancelledReturnBitfield4, settled19.crossOrderCancelledReturnBitfield10, settled19.crossOrderCancelledReturnBitfield11, settled19.crossOrderCancelledReturnBitfield17, settled19.crossOrderCancelledReturnBitfield18)]]
        settled21 == [settled20 EXCEPT !.price = IF settled20.numberOfReturnBitfields >= 1 /\ (settled20.crossOrderCancelledReturnBitfield1 # << >> /\ (settled20.crossOrderCancelledReturnBitfield1[1] \div 4) % 2 > 0) THEN (IF settled20.price = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled20.price) ELSE << >>]
        settled22 == [settled21 EXCEPT !.symbolLong = IF settled21.numberOfReturnBitfields >= 2 /\ (settled21.crossOrderCancelledReturnBitfield2 # << >> /\ settled21.crossOrderCancelledReturnBitfield2[1] % 2 > 0) THEN (IF settled21.symbolLong = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled21.symbolLong) ELSE << >>]
        settled23 == [settled22 EXCEPT !.idSource = IF settled22.numberOfReturnBitfields >= 2 /\ (settled22.crossOrderCancelledReturnBitfield2 # << >> /\ (settled22.crossOrderCancelledReturnBitfield2[1] \div 8) % 2 > 0) THEN (IF settled22.idSource = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled22.idSource) ELSE << >>]
        settled24 == [settled23 EXCEPT !.securityId = IF settled23.numberOfReturnBitfields >= 2 /\ (settled23.crossOrderCancelledReturnBitfield2 # << >> /\ (settled23.crossOrderCancelledReturnBitfield2[1] \div 16) % 2 > 0) THEN (IF settled23.securityId = << >> THEN <<[i \in 1 .. 16 |-> 0]>> ELSE settled23.securityId) ELSE << >>]
        settled25 == [settled24 EXCEPT !.orderQty = IF settled24.numberOfReturnBitfields >= 3 /\ (settled24.crossOrderCancelledReturnBitfield3 # << >> /\ (settled24.crossOrderCancelledReturnBitfield3[1] \div 64) % 2 > 0) THEN (IF settled24.orderQty = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled24.orderQty) ELSE << >>]
        settled26 == [settled25 EXCEPT !.preventMatch = IF settled25.numberOfReturnBitfields >= 3 /\ (settled25.crossOrderCancelledReturnBitfield3 # << >> /\ (settled25.crossOrderCancelledReturnBitfield3[1] \div 128) % 2 > 0) THEN (IF settled25.preventMatch = << >> THEN <<[i \in 1 .. 3 |-> 0]>> ELSE settled25.preventMatch) ELSE << >>]
        settled27 == [settled26 EXCEPT !.extExecInst = IF settled26.numberOfReturnBitfields >= 6 /\ (settled26.crossOrderCancelledReturnBitfield6 # << >> /\ (settled26.crossOrderCancelledReturnBitfield6[1] \div 16) % 2 > 0) THEN (IF settled26.extExecInst = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled26.extExecInst) ELSE << >>]
        settled28 == [settled27 EXCEPT !.auctionId = IF settled27.numberOfReturnBitfields >= 9 /\ (settled27.crossOrderCancelledReturnBitfield9 # << >> /\ (settled27.crossOrderCancelledReturnBitfield9[1] \div 4) % 2 > 0) THEN (IF settled27.auctionId = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled27.auctionId) ELSE << >>]
        settled29 == [settled28 EXCEPT !.liquidityProvision = IF settled28.numberOfReturnBitfields >= 9 /\ (settled28.crossOrderCancelledReturnBitfield9 # << >> /\ (settled28.crossOrderCancelledReturnBitfield9[1] \div 16) % 2 > 0) THEN (IF settled28.liquidityProvision = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled28.liquidityProvision) ELSE << >>]
        settled30 == [settled29 EXCEPT !.crossType = IF settled29.numberOfReturnBitfields >= 9 /\ (settled29.crossOrderCancelledReturnBitfield9 # << >> /\ (settled29.crossOrderCancelledReturnBitfield9[1] \div 64) % 2 > 0) THEN (IF settled29.crossType = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled29.crossType) ELSE << >>]
        settled31 == [settled30 EXCEPT !.crossPrioritization = IF settled30.numberOfReturnBitfields >= 9 /\ (settled30.crossOrderCancelledReturnBitfield9 # << >> /\ (settled30.crossOrderCancelledReturnBitfield9[1] \div 128) % 2 > 0) THEN (IF settled30.crossPrioritization = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled30.crossPrioritization) ELSE << >>]
        settled32 == [settled31 EXCEPT !.routingFirmId = IF settled31.numberOfReturnBitfields >= 10 /\ (settled31.crossOrderCancelledReturnBitfield10 # << >> /\ (settled31.crossOrderCancelledReturnBitfield10[1] \div 8) % 2 > 0) THEN (IF settled31.routingFirmId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled31.routingFirmId) ELSE << >>]
    IN  settled32

ZeroCrossOrderCancelledMessage ==
    SettleCrossOrderCancelledMessage([ transactionTime                     |-> [i \in 1 .. 8 |-> 0],
                                       crossId                             |-> [i \in 1 .. 20 |-> 0],
                                       cancelReason                        |-> [i \in 1 .. 1 |-> 0],
                                       reserved1                           |-> [i \in 1 .. 1 |-> 0],
                                       numberOfReturnBitfields             |-> 0,
                                       crossOrderCancelledReturnBitfield1  |-> << >>,
                                       crossOrderCancelledReturnBitfield2  |-> << >>,
                                       crossOrderCancelledReturnBitfield3  |-> << >>,
                                       crossOrderCancelledReturnBitfield4  |-> << >>,
                                       crossOrderCancelledReturnBitfield5  |-> << >>,
                                       crossOrderCancelledReturnBitfield6  |-> << >>,
                                       crossOrderCancelledReturnBitfield7  |-> << >>,
                                       crossOrderCancelledReturnBitfield8  |-> << >>,
                                       crossOrderCancelledReturnBitfield9  |-> << >>,
                                       crossOrderCancelledReturnBitfield10 |-> << >>,
                                       crossOrderCancelledReturnBitfield11 |-> << >>,
                                       crossOrderCancelledReturnBitfield12 |-> << >>,
                                       crossOrderCancelledReturnBitfield13 |-> << >>,
                                       crossOrderCancelledReturnBitfield14 |-> << >>,
                                       crossOrderCancelledReturnBitfield15 |-> << >>,
                                       crossOrderCancelledReturnBitfield16 |-> << >>,
                                       crossOrderCancelledReturnBitfield17 |-> << >>,
                                       crossOrderCancelledReturnBitfield18 |-> << >>,
                                       crossOrderCancelledReturnBitfield19 |-> << >>,
                                       crossOrderCancelledOrderAllocations |-> << >>,
                                       price                               |-> << >>,
                                       symbolLong                          |-> << >>,
                                       idSource                            |-> << >>,
                                       securityId                          |-> << >>,
                                       orderQty                            |-> << >>,
                                       preventMatch                        |-> << >>,
                                       extExecInst                         |-> << >>,
                                       auctionId                           |-> << >>,
                                       liquidityProvision                  |-> << >>,
                                       crossType                           |-> << >>,
                                       crossPrioritization                 |-> << >>,
                                       routingFirmId                       |-> << >> ])

(* Cross Order Cancelled Message at zero, then each field in turn at the values it is checked at *)
CheckedCrossOrderCancelledMessage ==
    { ZeroCrossOrderCancelledMessage }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.transactionTime = one]) : one \in Sample(8) }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.crossId = one]) : one \in Sample(20) }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.cancelReason = one]) : one \in Sample(1) }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.reserved1 = one]) : one \in Sample(1) }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = one]) : one \in {0, 1, 255} }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 1, !.crossOrderCancelledReturnBitfield1 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 2, !.crossOrderCancelledReturnBitfield2 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 3, !.crossOrderCancelledReturnBitfield3 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 4, !.crossOrderCancelledReturnBitfield4 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 5, !.crossOrderCancelledReturnBitfield5 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 6, !.crossOrderCancelledReturnBitfield6 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 7, !.crossOrderCancelledReturnBitfield7 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 8, !.crossOrderCancelledReturnBitfield8 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 9, !.crossOrderCancelledReturnBitfield9 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 10, !.crossOrderCancelledReturnBitfield10 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 11, !.crossOrderCancelledReturnBitfield11 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 12, !.crossOrderCancelledReturnBitfield12 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 13, !.crossOrderCancelledReturnBitfield13 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 14, !.crossOrderCancelledReturnBitfield14 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 15, !.crossOrderCancelledReturnBitfield15 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 16, !.crossOrderCancelledReturnBitfield16 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 17, !.crossOrderCancelledReturnBitfield17 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 18, !.crossOrderCancelledReturnBitfield18 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 19, !.crossOrderCancelledReturnBitfield19 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.crossOrderCancelledOrderAllocations = one]) : one \in SampleLists(OneCrossOrderCancelledOrderAllocations) }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 1, !.crossOrderCancelledReturnBitfield1 = <<1>>, !.crossOrderCancelledOrderAllocations = one]) : one \in SampleLists(OneCrossOrderCancelledOrderAllocations) }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 10, !.crossOrderCancelledReturnBitfield10 = <<2>>, !.crossOrderCancelledOrderAllocations = one]) : one \in SampleLists(OneCrossOrderCancelledOrderAllocations) }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 2, !.crossOrderCancelledReturnBitfield2 = <<64>>, !.crossOrderCancelledOrderAllocations = one]) : one \in SampleLists(OneCrossOrderCancelledOrderAllocations) }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 4, !.crossOrderCancelledReturnBitfield4 = <<8>>, !.crossOrderCancelledOrderAllocations = one]) : one \in SampleLists(OneCrossOrderCancelledOrderAllocations) }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 3, !.crossOrderCancelledReturnBitfield3 = <<1>>, !.crossOrderCancelledOrderAllocations = one]) : one \in SampleLists(OneCrossOrderCancelledOrderAllocations) }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 3, !.crossOrderCancelledReturnBitfield3 = <<4>>, !.crossOrderCancelledOrderAllocations = one]) : one \in SampleLists(OneCrossOrderCancelledOrderAllocations) }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 3, !.crossOrderCancelledReturnBitfield3 = <<2>>, !.crossOrderCancelledOrderAllocations = one]) : one \in SampleLists(OneCrossOrderCancelledOrderAllocations) }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 17, !.crossOrderCancelledReturnBitfield17 = <<128>>, !.crossOrderCancelledOrderAllocations = one]) : one \in SampleLists(OneCrossOrderCancelledOrderAllocations) }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 18, !.crossOrderCancelledReturnBitfield18 = <<1>>, !.crossOrderCancelledOrderAllocations = one]) : one \in SampleLists(OneCrossOrderCancelledOrderAllocations) }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 11, !.crossOrderCancelledReturnBitfield11 = <<8>>, !.crossOrderCancelledOrderAllocations = one]) : one \in SampleLists(OneCrossOrderCancelledOrderAllocations) }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 11, !.crossOrderCancelledReturnBitfield11 = <<16>>, !.crossOrderCancelledOrderAllocations = one]) : one \in SampleLists(OneCrossOrderCancelledOrderAllocations) }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 11, !.crossOrderCancelledReturnBitfield11 = <<1>>, !.crossOrderCancelledOrderAllocations = one]) : one \in SampleLists(OneCrossOrderCancelledOrderAllocations) }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 10, !.crossOrderCancelledReturnBitfield10 = <<128>>, !.crossOrderCancelledOrderAllocations = one]) : one \in SampleLists(OneCrossOrderCancelledOrderAllocations) }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 11, !.crossOrderCancelledReturnBitfield11 = <<2>>, !.crossOrderCancelledOrderAllocations = one]) : one \in SampleLists(OneCrossOrderCancelledOrderAllocations) }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 11, !.crossOrderCancelledReturnBitfield11 = <<64>>, !.crossOrderCancelledOrderAllocations = one]) : one \in SampleLists(OneCrossOrderCancelledOrderAllocations) }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 11, !.crossOrderCancelledReturnBitfield11 = <<4>>, !.crossOrderCancelledOrderAllocations = one]) : one \in SampleLists(OneCrossOrderCancelledOrderAllocations) }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 11, !.crossOrderCancelledReturnBitfield11 = <<128>>, !.crossOrderCancelledOrderAllocations = one]) : one \in SampleLists(OneCrossOrderCancelledOrderAllocations) }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 1, !.crossOrderCancelledReturnBitfield1 = <<4>>, !.price = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 2, !.crossOrderCancelledReturnBitfield2 = <<1>>, !.symbolLong = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 2, !.crossOrderCancelledReturnBitfield2 = <<8>>, !.idSource = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 2, !.crossOrderCancelledReturnBitfield2 = <<16>>, !.securityId = one]) : one \in { <<held>> : held \in Sample(16) } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 3, !.crossOrderCancelledReturnBitfield3 = <<64>>, !.orderQty = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 3, !.crossOrderCancelledReturnBitfield3 = <<128>>, !.preventMatch = one]) : one \in { <<held>> : held \in Sample(3) } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 6, !.crossOrderCancelledReturnBitfield6 = <<16>>, !.extExecInst = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 9, !.crossOrderCancelledReturnBitfield9 = <<4>>, !.auctionId = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 9, !.crossOrderCancelledReturnBitfield9 = <<16>>, !.liquidityProvision = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 9, !.crossOrderCancelledReturnBitfield9 = <<64>>, !.crossType = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 9, !.crossOrderCancelledReturnBitfield9 = <<128>>, !.crossPrioritization = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderCancelledMessage([ZeroCrossOrderCancelledMessage EXCEPT !.numberOfReturnBitfields = 10, !.crossOrderCancelledReturnBitfield10 = <<8>>, !.routingFirmId = one]) : one \in { <<held>> : held \in Sample(4) } }

(***************************************************************************)
(* Cancel Rejected V 2 Message                                             *)
(***************************************************************************)

CancelRejectedV2Message ==
    [ transactionTime                  : Sample(8),
      clOrdId                          : Sample(20),
      cancelRejectReason               : Sample(1),
      text                             : Sample(60),
      reserved1                        : Sample(1),
      numberOfReturnBitfields          : 0 .. 255,
      cancelRejectedV2ReturnBitfield1  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      cancelRejectedV2ReturnBitfield2  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      cancelRejectedV2ReturnBitfield3  : { << >> } \cup { <<held>> : held \in Sample(1) },
      cancelRejectedV2ReturnBitfield4  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      cancelRejectedV2ReturnBitfield5  : { << >> } \cup { <<held>> : held \in Sample(1) },
      cancelRejectedV2ReturnBitfield6  : { << >> } \cup { <<held>> : held \in Sample(1) },
      cancelRejectedV2ReturnBitfield7  : { << >> } \cup { <<held>> : held \in Sample(1) },
      cancelRejectedV2ReturnBitfield8  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      cancelRejectedV2ReturnBitfield9  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      cancelRejectedV2ReturnBitfield10 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      cancelRejectedV2ReturnBitfield11 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      cancelRejectedV2ReturnBitfield12 : { << >> } \cup { <<held>> : held \in Sample(1) },
      cancelRejectedV2ReturnBitfield13 : { << >> } \cup { <<held>> : held \in Sample(1) },
      cancelRejectedV2ReturnBitfield14 : { << >> } \cup { <<held>> : held \in Sample(1) },
      cancelRejectedV2ReturnBitfield15 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      cancelRejectedV2ReturnBitfield16 : { << >> } \cup { <<held>> : held \in Sample(1) },
      cancelRejectedV2ReturnBitfield17 : { << >> } \cup { <<held>> : held \in Sample(1) },
      cancelRejectedV2ReturnBitfield18 : { << >> } \cup { <<held>> : held \in Sample(1) },
      cancelRejectedV2ReturnBitfield19 : { << >> } \cup { <<held>> : held \in Sample(1) },
      side                             : { << >> } \cup { <<held>> : held \in Sample(1) },
      price                            : { << >> } \cup { <<held>> : held \in Sample(8) },
      ordType                          : { << >> } \cup { <<held>> : held \in Sample(1) },
      timeInForce                      : { << >> } \cup { <<held>> : held \in Sample(1) },
      minQty                           : { << >> } \cup { <<held>> : held \in Sample(4) },
      symbolLong                       : { << >> } \cup { <<held>> : held \in Sample(8) },
      idSource                         : { << >> } \cup { <<held>> : held \in Sample(1) },
      securityId                       : { << >> } \cup { <<held>> : held \in Sample(16) },
      capacity                         : { << >> } \cup { <<held>> : held \in Sample(1) },
      openClose                        : { << >> } \cup { <<held>> : held \in Sample(1) },
      stopPx                           : { << >> } \cup { <<held>> : held \in Sample(8) },
      liquidityProvision               : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossId                          : { << >> } \cup { <<held>> : held \in Sample(20) },
      allocQty                         : { << >> } \cup { <<held>> : held \in Sample(4) },
      clientQualifiedRole              : { << >> } \cup { <<held>> : held \in Sample(1) },
      clientId                         : { << >> } \cup { <<held>> : held \in Sample(4) },
      investorId                       : { << >> } \cup { <<held>> : held \in Sample(4) },
      executorId                       : { << >> } \cup { <<held>> : held \in Sample(4) },
      orderOrigination                 : { << >> } \cup { <<held>> : held \in Sample(1) },
      algorithmicIndicator             : { << >> } \cup { <<held>> : held \in Sample(1) },
      investorQualifiedRole            : { << >> } \cup { <<held>> : held \in Sample(1) },
      executorQualifiedRole            : { << >> } \cup { <<held>> : held \in Sample(1) },
      massCancelId                     : { << >> } \cup { <<held>> : held \in Sample(20) } ]

EncodeCancelRejectedV2Message(message) ==
    message.transactionTime
        \o message.clOrdId
        \o message.cancelRejectReason
        \o message.text
        \o message.reserved1
        \o EncodeUIntBE(message.numberOfReturnBitfields, 1)
        \o (IF message.cancelRejectedV2ReturnBitfield1 = << >> THEN << >> ELSE EncodeUIntLE(message.cancelRejectedV2ReturnBitfield1[1], 1))
        \o (IF message.cancelRejectedV2ReturnBitfield2 = << >> THEN << >> ELSE EncodeUIntLE(message.cancelRejectedV2ReturnBitfield2[1], 1))
        \o (IF message.cancelRejectedV2ReturnBitfield3 = << >> THEN << >> ELSE message.cancelRejectedV2ReturnBitfield3[1])
        \o (IF message.cancelRejectedV2ReturnBitfield4 = << >> THEN << >> ELSE EncodeUIntLE(message.cancelRejectedV2ReturnBitfield4[1], 1))
        \o (IF message.cancelRejectedV2ReturnBitfield5 = << >> THEN << >> ELSE message.cancelRejectedV2ReturnBitfield5[1])
        \o (IF message.cancelRejectedV2ReturnBitfield6 = << >> THEN << >> ELSE message.cancelRejectedV2ReturnBitfield6[1])
        \o (IF message.cancelRejectedV2ReturnBitfield7 = << >> THEN << >> ELSE message.cancelRejectedV2ReturnBitfield7[1])
        \o (IF message.cancelRejectedV2ReturnBitfield8 = << >> THEN << >> ELSE EncodeUIntLE(message.cancelRejectedV2ReturnBitfield8[1], 1))
        \o (IF message.cancelRejectedV2ReturnBitfield9 = << >> THEN << >> ELSE EncodeUIntLE(message.cancelRejectedV2ReturnBitfield9[1], 1))
        \o (IF message.cancelRejectedV2ReturnBitfield10 = << >> THEN << >> ELSE EncodeUIntLE(message.cancelRejectedV2ReturnBitfield10[1], 1))
        \o (IF message.cancelRejectedV2ReturnBitfield11 = << >> THEN << >> ELSE EncodeUIntLE(message.cancelRejectedV2ReturnBitfield11[1], 1))
        \o (IF message.cancelRejectedV2ReturnBitfield12 = << >> THEN << >> ELSE message.cancelRejectedV2ReturnBitfield12[1])
        \o (IF message.cancelRejectedV2ReturnBitfield13 = << >> THEN << >> ELSE message.cancelRejectedV2ReturnBitfield13[1])
        \o (IF message.cancelRejectedV2ReturnBitfield14 = << >> THEN << >> ELSE message.cancelRejectedV2ReturnBitfield14[1])
        \o (IF message.cancelRejectedV2ReturnBitfield15 = << >> THEN << >> ELSE EncodeUIntLE(message.cancelRejectedV2ReturnBitfield15[1], 1))
        \o (IF message.cancelRejectedV2ReturnBitfield16 = << >> THEN << >> ELSE message.cancelRejectedV2ReturnBitfield16[1])
        \o (IF message.cancelRejectedV2ReturnBitfield17 = << >> THEN << >> ELSE message.cancelRejectedV2ReturnBitfield17[1])
        \o (IF message.cancelRejectedV2ReturnBitfield18 = << >> THEN << >> ELSE message.cancelRejectedV2ReturnBitfield18[1])
        \o (IF message.cancelRejectedV2ReturnBitfield19 = << >> THEN << >> ELSE message.cancelRejectedV2ReturnBitfield19[1])
        \o (IF message.side = << >> THEN << >> ELSE message.side[1])
        \o (IF message.price = << >> THEN << >> ELSE message.price[1])
        \o (IF message.ordType = << >> THEN << >> ELSE message.ordType[1])
        \o (IF message.timeInForce = << >> THEN << >> ELSE message.timeInForce[1])
        \o (IF message.minQty = << >> THEN << >> ELSE message.minQty[1])
        \o (IF message.symbolLong = << >> THEN << >> ELSE message.symbolLong[1])
        \o (IF message.idSource = << >> THEN << >> ELSE message.idSource[1])
        \o (IF message.securityId = << >> THEN << >> ELSE message.securityId[1])
        \o (IF message.capacity = << >> THEN << >> ELSE message.capacity[1])
        \o (IF message.openClose = << >> THEN << >> ELSE message.openClose[1])
        \o (IF message.stopPx = << >> THEN << >> ELSE message.stopPx[1])
        \o (IF message.liquidityProvision = << >> THEN << >> ELSE message.liquidityProvision[1])
        \o (IF message.crossId = << >> THEN << >> ELSE message.crossId[1])
        \o (IF message.allocQty = << >> THEN << >> ELSE message.allocQty[1])
        \o (IF message.clientQualifiedRole = << >> THEN << >> ELSE message.clientQualifiedRole[1])
        \o (IF message.clientId = << >> THEN << >> ELSE message.clientId[1])
        \o (IF message.investorId = << >> THEN << >> ELSE message.investorId[1])
        \o (IF message.executorId = << >> THEN << >> ELSE message.executorId[1])
        \o (IF message.orderOrigination = << >> THEN << >> ELSE message.orderOrigination[1])
        \o (IF message.algorithmicIndicator = << >> THEN << >> ELSE message.algorithmicIndicator[1])
        \o (IF message.investorQualifiedRole = << >> THEN << >> ELSE message.investorQualifiedRole[1])
        \o (IF message.executorQualifiedRole = << >> THEN << >> ELSE message.executorQualifiedRole[1])
        \o (IF message.massCancelId = << >> THEN << >> ELSE message.massCancelId[1])

DecodeCancelRejectedV2Message(bytes) ==
    LET transactionTime == ReadBytes(bytes, 8) IN IF ~transactionTime.ok THEN Fail ELSE
    LET clOrdId == ReadBytes(transactionTime.rest, 20) IN IF ~clOrdId.ok THEN Fail ELSE
    LET cancelRejectReason == ReadBytes(clOrdId.rest, 1) IN IF ~cancelRejectReason.ok THEN Fail ELSE
    LET text == ReadBytes(cancelRejectReason.rest, 60) IN IF ~text.ok THEN Fail ELSE
    LET reserved1 == ReadBytes(text.rest, 1) IN IF ~reserved1.ok THEN Fail ELSE
    LET numberOfReturnBitfields == ReadUIntBE(reserved1.rest, 1) IN IF ~numberOfReturnBitfields.ok THEN Fail ELSE
    LET cancelRejectedV2ReturnBitfield1 == ReadWhen(numberOfReturnBitfields.value >= 1, ReadUIntLE(numberOfReturnBitfields.rest, 1), numberOfReturnBitfields.rest) IN IF ~cancelRejectedV2ReturnBitfield1.ok THEN Fail ELSE
    LET cancelRejectedV2ReturnBitfield2 == ReadWhen(numberOfReturnBitfields.value >= 2, ReadUIntLE(cancelRejectedV2ReturnBitfield1.rest, 1), cancelRejectedV2ReturnBitfield1.rest) IN IF ~cancelRejectedV2ReturnBitfield2.ok THEN Fail ELSE
    LET cancelRejectedV2ReturnBitfield3 == ReadWhen(numberOfReturnBitfields.value >= 3, ReadBytes(cancelRejectedV2ReturnBitfield2.rest, 1), cancelRejectedV2ReturnBitfield2.rest) IN IF ~cancelRejectedV2ReturnBitfield3.ok THEN Fail ELSE
    LET cancelRejectedV2ReturnBitfield4 == ReadWhen(numberOfReturnBitfields.value >= 4, ReadUIntLE(cancelRejectedV2ReturnBitfield3.rest, 1), cancelRejectedV2ReturnBitfield3.rest) IN IF ~cancelRejectedV2ReturnBitfield4.ok THEN Fail ELSE
    LET cancelRejectedV2ReturnBitfield5 == ReadWhen(numberOfReturnBitfields.value >= 5, ReadBytes(cancelRejectedV2ReturnBitfield4.rest, 1), cancelRejectedV2ReturnBitfield4.rest) IN IF ~cancelRejectedV2ReturnBitfield5.ok THEN Fail ELSE
    LET cancelRejectedV2ReturnBitfield6 == ReadWhen(numberOfReturnBitfields.value >= 6, ReadBytes(cancelRejectedV2ReturnBitfield5.rest, 1), cancelRejectedV2ReturnBitfield5.rest) IN IF ~cancelRejectedV2ReturnBitfield6.ok THEN Fail ELSE
    LET cancelRejectedV2ReturnBitfield7 == ReadWhen(numberOfReturnBitfields.value >= 7, ReadBytes(cancelRejectedV2ReturnBitfield6.rest, 1), cancelRejectedV2ReturnBitfield6.rest) IN IF ~cancelRejectedV2ReturnBitfield7.ok THEN Fail ELSE
    LET cancelRejectedV2ReturnBitfield8 == ReadWhen(numberOfReturnBitfields.value >= 8, ReadUIntLE(cancelRejectedV2ReturnBitfield7.rest, 1), cancelRejectedV2ReturnBitfield7.rest) IN IF ~cancelRejectedV2ReturnBitfield8.ok THEN Fail ELSE
    LET cancelRejectedV2ReturnBitfield9 == ReadWhen(numberOfReturnBitfields.value >= 9, ReadUIntLE(cancelRejectedV2ReturnBitfield8.rest, 1), cancelRejectedV2ReturnBitfield8.rest) IN IF ~cancelRejectedV2ReturnBitfield9.ok THEN Fail ELSE
    LET cancelRejectedV2ReturnBitfield10 == ReadWhen(numberOfReturnBitfields.value >= 10, ReadUIntLE(cancelRejectedV2ReturnBitfield9.rest, 1), cancelRejectedV2ReturnBitfield9.rest) IN IF ~cancelRejectedV2ReturnBitfield10.ok THEN Fail ELSE
    LET cancelRejectedV2ReturnBitfield11 == ReadWhen(numberOfReturnBitfields.value >= 11, ReadUIntLE(cancelRejectedV2ReturnBitfield10.rest, 1), cancelRejectedV2ReturnBitfield10.rest) IN IF ~cancelRejectedV2ReturnBitfield11.ok THEN Fail ELSE
    LET cancelRejectedV2ReturnBitfield12 == ReadWhen(numberOfReturnBitfields.value >= 12, ReadBytes(cancelRejectedV2ReturnBitfield11.rest, 1), cancelRejectedV2ReturnBitfield11.rest) IN IF ~cancelRejectedV2ReturnBitfield12.ok THEN Fail ELSE
    LET cancelRejectedV2ReturnBitfield13 == ReadWhen(numberOfReturnBitfields.value >= 13, ReadBytes(cancelRejectedV2ReturnBitfield12.rest, 1), cancelRejectedV2ReturnBitfield12.rest) IN IF ~cancelRejectedV2ReturnBitfield13.ok THEN Fail ELSE
    LET cancelRejectedV2ReturnBitfield14 == ReadWhen(numberOfReturnBitfields.value >= 14, ReadBytes(cancelRejectedV2ReturnBitfield13.rest, 1), cancelRejectedV2ReturnBitfield13.rest) IN IF ~cancelRejectedV2ReturnBitfield14.ok THEN Fail ELSE
    LET cancelRejectedV2ReturnBitfield15 == ReadWhen(numberOfReturnBitfields.value >= 15, ReadUIntLE(cancelRejectedV2ReturnBitfield14.rest, 1), cancelRejectedV2ReturnBitfield14.rest) IN IF ~cancelRejectedV2ReturnBitfield15.ok THEN Fail ELSE
    LET cancelRejectedV2ReturnBitfield16 == ReadWhen(numberOfReturnBitfields.value >= 16, ReadBytes(cancelRejectedV2ReturnBitfield15.rest, 1), cancelRejectedV2ReturnBitfield15.rest) IN IF ~cancelRejectedV2ReturnBitfield16.ok THEN Fail ELSE
    LET cancelRejectedV2ReturnBitfield17 == ReadWhen(numberOfReturnBitfields.value >= 17, ReadBytes(cancelRejectedV2ReturnBitfield16.rest, 1), cancelRejectedV2ReturnBitfield16.rest) IN IF ~cancelRejectedV2ReturnBitfield17.ok THEN Fail ELSE
    LET cancelRejectedV2ReturnBitfield18 == ReadWhen(numberOfReturnBitfields.value >= 18, ReadBytes(cancelRejectedV2ReturnBitfield17.rest, 1), cancelRejectedV2ReturnBitfield17.rest) IN IF ~cancelRejectedV2ReturnBitfield18.ok THEN Fail ELSE
    LET cancelRejectedV2ReturnBitfield19 == ReadWhen(numberOfReturnBitfields.value >= 19, ReadBytes(cancelRejectedV2ReturnBitfield18.rest, 1), cancelRejectedV2ReturnBitfield18.rest) IN IF ~cancelRejectedV2ReturnBitfield19.ok THEN Fail ELSE
    LET side == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (cancelRejectedV2ReturnBitfield1.value # << >> /\ cancelRejectedV2ReturnBitfield1.value[1] % 2 > 0), ReadBytes(cancelRejectedV2ReturnBitfield19.rest, 1), cancelRejectedV2ReturnBitfield19.rest) IN IF ~side.ok THEN Fail ELSE
    LET price == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (cancelRejectedV2ReturnBitfield1.value # << >> /\ (cancelRejectedV2ReturnBitfield1.value[1] \div 4) % 2 > 0), ReadBytes(side.rest, 8), side.rest) IN IF ~price.ok THEN Fail ELSE
    LET ordType == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (cancelRejectedV2ReturnBitfield1.value # << >> /\ (cancelRejectedV2ReturnBitfield1.value[1] \div 16) % 2 > 0), ReadBytes(price.rest, 1), price.rest) IN IF ~ordType.ok THEN Fail ELSE
    LET timeInForce == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (cancelRejectedV2ReturnBitfield1.value # << >> /\ (cancelRejectedV2ReturnBitfield1.value[1] \div 32) % 2 > 0), ReadBytes(ordType.rest, 1), ordType.rest) IN IF ~timeInForce.ok THEN Fail ELSE
    LET minQty == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (cancelRejectedV2ReturnBitfield1.value # << >> /\ (cancelRejectedV2ReturnBitfield1.value[1] \div 64) % 2 > 0), ReadBytes(timeInForce.rest, 4), timeInForce.rest) IN IF ~minQty.ok THEN Fail ELSE
    LET symbolLong == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (cancelRejectedV2ReturnBitfield2.value # << >> /\ cancelRejectedV2ReturnBitfield2.value[1] % 2 > 0), ReadBytes(minQty.rest, 8), minQty.rest) IN IF ~symbolLong.ok THEN Fail ELSE
    LET idSource == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (cancelRejectedV2ReturnBitfield2.value # << >> /\ (cancelRejectedV2ReturnBitfield2.value[1] \div 8) % 2 > 0), ReadBytes(symbolLong.rest, 1), symbolLong.rest) IN IF ~idSource.ok THEN Fail ELSE
    LET securityId == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (cancelRejectedV2ReturnBitfield2.value # << >> /\ (cancelRejectedV2ReturnBitfield2.value[1] \div 16) % 2 > 0), ReadBytes(idSource.rest, 16), idSource.rest) IN IF ~securityId.ok THEN Fail ELSE
    LET capacity == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (cancelRejectedV2ReturnBitfield2.value # << >> /\ (cancelRejectedV2ReturnBitfield2.value[1] \div 64) % 2 > 0), ReadBytes(securityId.rest, 1), securityId.rest) IN IF ~capacity.ok THEN Fail ELSE
    LET openClose == ReadWhen(numberOfReturnBitfields.value >= 4 /\ (cancelRejectedV2ReturnBitfield4.value # << >> /\ (cancelRejectedV2ReturnBitfield4.value[1] \div 8) % 2 > 0), ReadBytes(capacity.rest, 1), capacity.rest) IN IF ~openClose.ok THEN Fail ELSE
    LET stopPx == ReadWhen(numberOfReturnBitfields.value >= 8 /\ (cancelRejectedV2ReturnBitfield8.value # << >> /\ (cancelRejectedV2ReturnBitfield8.value[1] \div 4) % 2 > 0), ReadBytes(openClose.rest, 8), openClose.rest) IN IF ~stopPx.ok THEN Fail ELSE
    LET liquidityProvision == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (cancelRejectedV2ReturnBitfield9.value # << >> /\ (cancelRejectedV2ReturnBitfield9.value[1] \div 16) % 2 > 0), ReadBytes(stopPx.rest, 1), stopPx.rest) IN IF ~liquidityProvision.ok THEN Fail ELSE
    LET crossId == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (cancelRejectedV2ReturnBitfield10.value # << >> /\ cancelRejectedV2ReturnBitfield10.value[1] % 2 > 0), ReadBytes(liquidityProvision.rest, 20), liquidityProvision.rest) IN IF ~crossId.ok THEN Fail ELSE
    LET allocQty == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (cancelRejectedV2ReturnBitfield10.value # << >> /\ (cancelRejectedV2ReturnBitfield10.value[1] \div 2) % 2 > 0), ReadBytes(crossId.rest, 4), crossId.rest) IN IF ~allocQty.ok THEN Fail ELSE
    LET clientQualifiedRole == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (cancelRejectedV2ReturnBitfield10.value # << >> /\ (cancelRejectedV2ReturnBitfield10.value[1] \div 128) % 2 > 0), ReadBytes(allocQty.rest, 1), allocQty.rest) IN IF ~clientQualifiedRole.ok THEN Fail ELSE
    LET clientId == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (cancelRejectedV2ReturnBitfield11.value # << >> /\ cancelRejectedV2ReturnBitfield11.value[1] % 2 > 0), ReadBytes(clientQualifiedRole.rest, 4), clientQualifiedRole.rest) IN IF ~clientId.ok THEN Fail ELSE
    LET investorId == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (cancelRejectedV2ReturnBitfield11.value # << >> /\ (cancelRejectedV2ReturnBitfield11.value[1] \div 2) % 2 > 0), ReadBytes(clientId.rest, 4), clientId.rest) IN IF ~investorId.ok THEN Fail ELSE
    LET executorId == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (cancelRejectedV2ReturnBitfield11.value # << >> /\ (cancelRejectedV2ReturnBitfield11.value[1] \div 4) % 2 > 0), ReadBytes(investorId.rest, 4), investorId.rest) IN IF ~executorId.ok THEN Fail ELSE
    LET orderOrigination == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (cancelRejectedV2ReturnBitfield11.value # << >> /\ (cancelRejectedV2ReturnBitfield11.value[1] \div 8) % 2 > 0), ReadBytes(executorId.rest, 1), executorId.rest) IN IF ~orderOrigination.ok THEN Fail ELSE
    LET algorithmicIndicator == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (cancelRejectedV2ReturnBitfield11.value # << >> /\ (cancelRejectedV2ReturnBitfield11.value[1] \div 16) % 2 > 0), ReadBytes(orderOrigination.rest, 1), orderOrigination.rest) IN IF ~algorithmicIndicator.ok THEN Fail ELSE
    LET investorQualifiedRole == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (cancelRejectedV2ReturnBitfield11.value # << >> /\ (cancelRejectedV2ReturnBitfield11.value[1] \div 64) % 2 > 0), ReadBytes(algorithmicIndicator.rest, 1), algorithmicIndicator.rest) IN IF ~investorQualifiedRole.ok THEN Fail ELSE
    LET executorQualifiedRole == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (cancelRejectedV2ReturnBitfield11.value # << >> /\ (cancelRejectedV2ReturnBitfield11.value[1] \div 128) % 2 > 0), ReadBytes(investorQualifiedRole.rest, 1), investorQualifiedRole.rest) IN IF ~executorQualifiedRole.ok THEN Fail ELSE
    LET massCancelId == ReadWhen(numberOfReturnBitfields.value >= 15 /\ (cancelRejectedV2ReturnBitfield15.value # << >> /\ (cancelRejectedV2ReturnBitfield15.value[1] \div 8) % 2 > 0), ReadBytes(executorQualifiedRole.rest, 20), executorQualifiedRole.rest) IN IF ~massCancelId.ok THEN Fail ELSE
    Ok([ transactionTime                  |-> transactionTime.value,
         clOrdId                          |-> clOrdId.value,
         cancelRejectReason               |-> cancelRejectReason.value,
         text                             |-> text.value,
         reserved1                        |-> reserved1.value,
         numberOfReturnBitfields          |-> numberOfReturnBitfields.value,
         cancelRejectedV2ReturnBitfield1  |-> cancelRejectedV2ReturnBitfield1.value,
         cancelRejectedV2ReturnBitfield2  |-> cancelRejectedV2ReturnBitfield2.value,
         cancelRejectedV2ReturnBitfield3  |-> cancelRejectedV2ReturnBitfield3.value,
         cancelRejectedV2ReturnBitfield4  |-> cancelRejectedV2ReturnBitfield4.value,
         cancelRejectedV2ReturnBitfield5  |-> cancelRejectedV2ReturnBitfield5.value,
         cancelRejectedV2ReturnBitfield6  |-> cancelRejectedV2ReturnBitfield6.value,
         cancelRejectedV2ReturnBitfield7  |-> cancelRejectedV2ReturnBitfield7.value,
         cancelRejectedV2ReturnBitfield8  |-> cancelRejectedV2ReturnBitfield8.value,
         cancelRejectedV2ReturnBitfield9  |-> cancelRejectedV2ReturnBitfield9.value,
         cancelRejectedV2ReturnBitfield10 |-> cancelRejectedV2ReturnBitfield10.value,
         cancelRejectedV2ReturnBitfield11 |-> cancelRejectedV2ReturnBitfield11.value,
         cancelRejectedV2ReturnBitfield12 |-> cancelRejectedV2ReturnBitfield12.value,
         cancelRejectedV2ReturnBitfield13 |-> cancelRejectedV2ReturnBitfield13.value,
         cancelRejectedV2ReturnBitfield14 |-> cancelRejectedV2ReturnBitfield14.value,
         cancelRejectedV2ReturnBitfield15 |-> cancelRejectedV2ReturnBitfield15.value,
         cancelRejectedV2ReturnBitfield16 |-> cancelRejectedV2ReturnBitfield16.value,
         cancelRejectedV2ReturnBitfield17 |-> cancelRejectedV2ReturnBitfield17.value,
         cancelRejectedV2ReturnBitfield18 |-> cancelRejectedV2ReturnBitfield18.value,
         cancelRejectedV2ReturnBitfield19 |-> cancelRejectedV2ReturnBitfield19.value,
         side                             |-> side.value,
         price                            |-> price.value,
         ordType                          |-> ordType.value,
         timeInForce                      |-> timeInForce.value,
         minQty                           |-> minQty.value,
         symbolLong                       |-> symbolLong.value,
         idSource                         |-> idSource.value,
         securityId                       |-> securityId.value,
         capacity                         |-> capacity.value,
         openClose                        |-> openClose.value,
         stopPx                           |-> stopPx.value,
         liquidityProvision               |-> liquidityProvision.value,
         crossId                          |-> crossId.value,
         allocQty                         |-> allocQty.value,
         clientQualifiedRole              |-> clientQualifiedRole.value,
         clientId                         |-> clientId.value,
         investorId                       |-> investorId.value,
         executorId                       |-> executorId.value,
         orderOrigination                 |-> orderOrigination.value,
         algorithmicIndicator             |-> algorithmicIndicator.value,
         investorQualifiedRole            |-> investorQualifiedRole.value,
         executorQualifiedRole            |-> executorQualifiedRole.value,
         massCancelId                     |-> massCancelId.value ], massCancelId.rest)

(* Cancel Rejected V 2 Message with each field marked present by fields before it there exactly where they say *)
SettleCancelRejectedV2Message(message) ==
    LET settled1 == [message EXCEPT !.cancelRejectedV2ReturnBitfield1 = IF message.numberOfReturnBitfields >= 1 THEN (IF message.cancelRejectedV2ReturnBitfield1 = << >> THEN <<0>> ELSE message.cancelRejectedV2ReturnBitfield1) ELSE << >>]
        settled2 == [settled1 EXCEPT !.cancelRejectedV2ReturnBitfield2 = IF settled1.numberOfReturnBitfields >= 2 THEN (IF settled1.cancelRejectedV2ReturnBitfield2 = << >> THEN <<0>> ELSE settled1.cancelRejectedV2ReturnBitfield2) ELSE << >>]
        settled3 == [settled2 EXCEPT !.cancelRejectedV2ReturnBitfield3 = IF settled2.numberOfReturnBitfields >= 3 THEN (IF settled2.cancelRejectedV2ReturnBitfield3 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled2.cancelRejectedV2ReturnBitfield3) ELSE << >>]
        settled4 == [settled3 EXCEPT !.cancelRejectedV2ReturnBitfield4 = IF settled3.numberOfReturnBitfields >= 4 THEN (IF settled3.cancelRejectedV2ReturnBitfield4 = << >> THEN <<0>> ELSE settled3.cancelRejectedV2ReturnBitfield4) ELSE << >>]
        settled5 == [settled4 EXCEPT !.cancelRejectedV2ReturnBitfield5 = IF settled4.numberOfReturnBitfields >= 5 THEN (IF settled4.cancelRejectedV2ReturnBitfield5 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled4.cancelRejectedV2ReturnBitfield5) ELSE << >>]
        settled6 == [settled5 EXCEPT !.cancelRejectedV2ReturnBitfield6 = IF settled5.numberOfReturnBitfields >= 6 THEN (IF settled5.cancelRejectedV2ReturnBitfield6 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled5.cancelRejectedV2ReturnBitfield6) ELSE << >>]
        settled7 == [settled6 EXCEPT !.cancelRejectedV2ReturnBitfield7 = IF settled6.numberOfReturnBitfields >= 7 THEN (IF settled6.cancelRejectedV2ReturnBitfield7 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled6.cancelRejectedV2ReturnBitfield7) ELSE << >>]
        settled8 == [settled7 EXCEPT !.cancelRejectedV2ReturnBitfield8 = IF settled7.numberOfReturnBitfields >= 8 THEN (IF settled7.cancelRejectedV2ReturnBitfield8 = << >> THEN <<0>> ELSE settled7.cancelRejectedV2ReturnBitfield8) ELSE << >>]
        settled9 == [settled8 EXCEPT !.cancelRejectedV2ReturnBitfield9 = IF settled8.numberOfReturnBitfields >= 9 THEN (IF settled8.cancelRejectedV2ReturnBitfield9 = << >> THEN <<0>> ELSE settled8.cancelRejectedV2ReturnBitfield9) ELSE << >>]
        settled10 == [settled9 EXCEPT !.cancelRejectedV2ReturnBitfield10 = IF settled9.numberOfReturnBitfields >= 10 THEN (IF settled9.cancelRejectedV2ReturnBitfield10 = << >> THEN <<0>> ELSE settled9.cancelRejectedV2ReturnBitfield10) ELSE << >>]
        settled11 == [settled10 EXCEPT !.cancelRejectedV2ReturnBitfield11 = IF settled10.numberOfReturnBitfields >= 11 THEN (IF settled10.cancelRejectedV2ReturnBitfield11 = << >> THEN <<0>> ELSE settled10.cancelRejectedV2ReturnBitfield11) ELSE << >>]
        settled12 == [settled11 EXCEPT !.cancelRejectedV2ReturnBitfield12 = IF settled11.numberOfReturnBitfields >= 12 THEN (IF settled11.cancelRejectedV2ReturnBitfield12 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled11.cancelRejectedV2ReturnBitfield12) ELSE << >>]
        settled13 == [settled12 EXCEPT !.cancelRejectedV2ReturnBitfield13 = IF settled12.numberOfReturnBitfields >= 13 THEN (IF settled12.cancelRejectedV2ReturnBitfield13 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled12.cancelRejectedV2ReturnBitfield13) ELSE << >>]
        settled14 == [settled13 EXCEPT !.cancelRejectedV2ReturnBitfield14 = IF settled13.numberOfReturnBitfields >= 14 THEN (IF settled13.cancelRejectedV2ReturnBitfield14 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled13.cancelRejectedV2ReturnBitfield14) ELSE << >>]
        settled15 == [settled14 EXCEPT !.cancelRejectedV2ReturnBitfield15 = IF settled14.numberOfReturnBitfields >= 15 THEN (IF settled14.cancelRejectedV2ReturnBitfield15 = << >> THEN <<0>> ELSE settled14.cancelRejectedV2ReturnBitfield15) ELSE << >>]
        settled16 == [settled15 EXCEPT !.cancelRejectedV2ReturnBitfield16 = IF settled15.numberOfReturnBitfields >= 16 THEN (IF settled15.cancelRejectedV2ReturnBitfield16 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled15.cancelRejectedV2ReturnBitfield16) ELSE << >>]
        settled17 == [settled16 EXCEPT !.cancelRejectedV2ReturnBitfield17 = IF settled16.numberOfReturnBitfields >= 17 THEN (IF settled16.cancelRejectedV2ReturnBitfield17 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled16.cancelRejectedV2ReturnBitfield17) ELSE << >>]
        settled18 == [settled17 EXCEPT !.cancelRejectedV2ReturnBitfield18 = IF settled17.numberOfReturnBitfields >= 18 THEN (IF settled17.cancelRejectedV2ReturnBitfield18 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled17.cancelRejectedV2ReturnBitfield18) ELSE << >>]
        settled19 == [settled18 EXCEPT !.cancelRejectedV2ReturnBitfield19 = IF settled18.numberOfReturnBitfields >= 19 THEN (IF settled18.cancelRejectedV2ReturnBitfield19 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled18.cancelRejectedV2ReturnBitfield19) ELSE << >>]
        settled20 == [settled19 EXCEPT !.side = IF settled19.numberOfReturnBitfields >= 1 /\ (settled19.cancelRejectedV2ReturnBitfield1 # << >> /\ settled19.cancelRejectedV2ReturnBitfield1[1] % 2 > 0) THEN (IF settled19.side = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled19.side) ELSE << >>]
        settled21 == [settled20 EXCEPT !.price = IF settled20.numberOfReturnBitfields >= 1 /\ (settled20.cancelRejectedV2ReturnBitfield1 # << >> /\ (settled20.cancelRejectedV2ReturnBitfield1[1] \div 4) % 2 > 0) THEN (IF settled20.price = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled20.price) ELSE << >>]
        settled22 == [settled21 EXCEPT !.ordType = IF settled21.numberOfReturnBitfields >= 1 /\ (settled21.cancelRejectedV2ReturnBitfield1 # << >> /\ (settled21.cancelRejectedV2ReturnBitfield1[1] \div 16) % 2 > 0) THEN (IF settled21.ordType = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled21.ordType) ELSE << >>]
        settled23 == [settled22 EXCEPT !.timeInForce = IF settled22.numberOfReturnBitfields >= 1 /\ (settled22.cancelRejectedV2ReturnBitfield1 # << >> /\ (settled22.cancelRejectedV2ReturnBitfield1[1] \div 32) % 2 > 0) THEN (IF settled22.timeInForce = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled22.timeInForce) ELSE << >>]
        settled24 == [settled23 EXCEPT !.minQty = IF settled23.numberOfReturnBitfields >= 1 /\ (settled23.cancelRejectedV2ReturnBitfield1 # << >> /\ (settled23.cancelRejectedV2ReturnBitfield1[1] \div 64) % 2 > 0) THEN (IF settled23.minQty = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled23.minQty) ELSE << >>]
        settled25 == [settled24 EXCEPT !.symbolLong = IF settled24.numberOfReturnBitfields >= 2 /\ (settled24.cancelRejectedV2ReturnBitfield2 # << >> /\ settled24.cancelRejectedV2ReturnBitfield2[1] % 2 > 0) THEN (IF settled24.symbolLong = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled24.symbolLong) ELSE << >>]
        settled26 == [settled25 EXCEPT !.idSource = IF settled25.numberOfReturnBitfields >= 2 /\ (settled25.cancelRejectedV2ReturnBitfield2 # << >> /\ (settled25.cancelRejectedV2ReturnBitfield2[1] \div 8) % 2 > 0) THEN (IF settled25.idSource = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled25.idSource) ELSE << >>]
        settled27 == [settled26 EXCEPT !.securityId = IF settled26.numberOfReturnBitfields >= 2 /\ (settled26.cancelRejectedV2ReturnBitfield2 # << >> /\ (settled26.cancelRejectedV2ReturnBitfield2[1] \div 16) % 2 > 0) THEN (IF settled26.securityId = << >> THEN <<[i \in 1 .. 16 |-> 0]>> ELSE settled26.securityId) ELSE << >>]
        settled28 == [settled27 EXCEPT !.capacity = IF settled27.numberOfReturnBitfields >= 2 /\ (settled27.cancelRejectedV2ReturnBitfield2 # << >> /\ (settled27.cancelRejectedV2ReturnBitfield2[1] \div 64) % 2 > 0) THEN (IF settled27.capacity = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled27.capacity) ELSE << >>]
        settled29 == [settled28 EXCEPT !.openClose = IF settled28.numberOfReturnBitfields >= 4 /\ (settled28.cancelRejectedV2ReturnBitfield4 # << >> /\ (settled28.cancelRejectedV2ReturnBitfield4[1] \div 8) % 2 > 0) THEN (IF settled28.openClose = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled28.openClose) ELSE << >>]
        settled30 == [settled29 EXCEPT !.stopPx = IF settled29.numberOfReturnBitfields >= 8 /\ (settled29.cancelRejectedV2ReturnBitfield8 # << >> /\ (settled29.cancelRejectedV2ReturnBitfield8[1] \div 4) % 2 > 0) THEN (IF settled29.stopPx = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled29.stopPx) ELSE << >>]
        settled31 == [settled30 EXCEPT !.liquidityProvision = IF settled30.numberOfReturnBitfields >= 9 /\ (settled30.cancelRejectedV2ReturnBitfield9 # << >> /\ (settled30.cancelRejectedV2ReturnBitfield9[1] \div 16) % 2 > 0) THEN (IF settled30.liquidityProvision = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled30.liquidityProvision) ELSE << >>]
        settled32 == [settled31 EXCEPT !.crossId = IF settled31.numberOfReturnBitfields >= 10 /\ (settled31.cancelRejectedV2ReturnBitfield10 # << >> /\ settled31.cancelRejectedV2ReturnBitfield10[1] % 2 > 0) THEN (IF settled31.crossId = << >> THEN <<[i \in 1 .. 20 |-> 0]>> ELSE settled31.crossId) ELSE << >>]
        settled33 == [settled32 EXCEPT !.allocQty = IF settled32.numberOfReturnBitfields >= 10 /\ (settled32.cancelRejectedV2ReturnBitfield10 # << >> /\ (settled32.cancelRejectedV2ReturnBitfield10[1] \div 2) % 2 > 0) THEN (IF settled32.allocQty = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled32.allocQty) ELSE << >>]
        settled34 == [settled33 EXCEPT !.clientQualifiedRole = IF settled33.numberOfReturnBitfields >= 10 /\ (settled33.cancelRejectedV2ReturnBitfield10 # << >> /\ (settled33.cancelRejectedV2ReturnBitfield10[1] \div 128) % 2 > 0) THEN (IF settled33.clientQualifiedRole = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled33.clientQualifiedRole) ELSE << >>]
        settled35 == [settled34 EXCEPT !.clientId = IF settled34.numberOfReturnBitfields >= 11 /\ (settled34.cancelRejectedV2ReturnBitfield11 # << >> /\ settled34.cancelRejectedV2ReturnBitfield11[1] % 2 > 0) THEN (IF settled34.clientId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled34.clientId) ELSE << >>]
        settled36 == [settled35 EXCEPT !.investorId = IF settled35.numberOfReturnBitfields >= 11 /\ (settled35.cancelRejectedV2ReturnBitfield11 # << >> /\ (settled35.cancelRejectedV2ReturnBitfield11[1] \div 2) % 2 > 0) THEN (IF settled35.investorId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled35.investorId) ELSE << >>]
        settled37 == [settled36 EXCEPT !.executorId = IF settled36.numberOfReturnBitfields >= 11 /\ (settled36.cancelRejectedV2ReturnBitfield11 # << >> /\ (settled36.cancelRejectedV2ReturnBitfield11[1] \div 4) % 2 > 0) THEN (IF settled36.executorId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled36.executorId) ELSE << >>]
        settled38 == [settled37 EXCEPT !.orderOrigination = IF settled37.numberOfReturnBitfields >= 11 /\ (settled37.cancelRejectedV2ReturnBitfield11 # << >> /\ (settled37.cancelRejectedV2ReturnBitfield11[1] \div 8) % 2 > 0) THEN (IF settled37.orderOrigination = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled37.orderOrigination) ELSE << >>]
        settled39 == [settled38 EXCEPT !.algorithmicIndicator = IF settled38.numberOfReturnBitfields >= 11 /\ (settled38.cancelRejectedV2ReturnBitfield11 # << >> /\ (settled38.cancelRejectedV2ReturnBitfield11[1] \div 16) % 2 > 0) THEN (IF settled38.algorithmicIndicator = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled38.algorithmicIndicator) ELSE << >>]
        settled40 == [settled39 EXCEPT !.investorQualifiedRole = IF settled39.numberOfReturnBitfields >= 11 /\ (settled39.cancelRejectedV2ReturnBitfield11 # << >> /\ (settled39.cancelRejectedV2ReturnBitfield11[1] \div 64) % 2 > 0) THEN (IF settled39.investorQualifiedRole = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled39.investorQualifiedRole) ELSE << >>]
        settled41 == [settled40 EXCEPT !.executorQualifiedRole = IF settled40.numberOfReturnBitfields >= 11 /\ (settled40.cancelRejectedV2ReturnBitfield11 # << >> /\ (settled40.cancelRejectedV2ReturnBitfield11[1] \div 128) % 2 > 0) THEN (IF settled40.executorQualifiedRole = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled40.executorQualifiedRole) ELSE << >>]
        settled42 == [settled41 EXCEPT !.massCancelId = IF settled41.numberOfReturnBitfields >= 15 /\ (settled41.cancelRejectedV2ReturnBitfield15 # << >> /\ (settled41.cancelRejectedV2ReturnBitfield15[1] \div 8) % 2 > 0) THEN (IF settled41.massCancelId = << >> THEN <<[i \in 1 .. 20 |-> 0]>> ELSE settled41.massCancelId) ELSE << >>]
    IN  settled42

ZeroCancelRejectedV2Message ==
    SettleCancelRejectedV2Message([ transactionTime                  |-> [i \in 1 .. 8 |-> 0],
                                    clOrdId                          |-> [i \in 1 .. 20 |-> 0],
                                    cancelRejectReason               |-> [i \in 1 .. 1 |-> 0],
                                    text                             |-> [i \in 1 .. 60 |-> 0],
                                    reserved1                        |-> [i \in 1 .. 1 |-> 0],
                                    numberOfReturnBitfields          |-> 0,
                                    cancelRejectedV2ReturnBitfield1  |-> << >>,
                                    cancelRejectedV2ReturnBitfield2  |-> << >>,
                                    cancelRejectedV2ReturnBitfield3  |-> << >>,
                                    cancelRejectedV2ReturnBitfield4  |-> << >>,
                                    cancelRejectedV2ReturnBitfield5  |-> << >>,
                                    cancelRejectedV2ReturnBitfield6  |-> << >>,
                                    cancelRejectedV2ReturnBitfield7  |-> << >>,
                                    cancelRejectedV2ReturnBitfield8  |-> << >>,
                                    cancelRejectedV2ReturnBitfield9  |-> << >>,
                                    cancelRejectedV2ReturnBitfield10 |-> << >>,
                                    cancelRejectedV2ReturnBitfield11 |-> << >>,
                                    cancelRejectedV2ReturnBitfield12 |-> << >>,
                                    cancelRejectedV2ReturnBitfield13 |-> << >>,
                                    cancelRejectedV2ReturnBitfield14 |-> << >>,
                                    cancelRejectedV2ReturnBitfield15 |-> << >>,
                                    cancelRejectedV2ReturnBitfield16 |-> << >>,
                                    cancelRejectedV2ReturnBitfield17 |-> << >>,
                                    cancelRejectedV2ReturnBitfield18 |-> << >>,
                                    cancelRejectedV2ReturnBitfield19 |-> << >>,
                                    side                             |-> << >>,
                                    price                            |-> << >>,
                                    ordType                          |-> << >>,
                                    timeInForce                      |-> << >>,
                                    minQty                           |-> << >>,
                                    symbolLong                       |-> << >>,
                                    idSource                         |-> << >>,
                                    securityId                       |-> << >>,
                                    capacity                         |-> << >>,
                                    openClose                        |-> << >>,
                                    stopPx                           |-> << >>,
                                    liquidityProvision               |-> << >>,
                                    crossId                          |-> << >>,
                                    allocQty                         |-> << >>,
                                    clientQualifiedRole              |-> << >>,
                                    clientId                         |-> << >>,
                                    investorId                       |-> << >>,
                                    executorId                       |-> << >>,
                                    orderOrigination                 |-> << >>,
                                    algorithmicIndicator             |-> << >>,
                                    investorQualifiedRole            |-> << >>,
                                    executorQualifiedRole            |-> << >>,
                                    massCancelId                     |-> << >> ])

(* Cancel Rejected V 2 Message at zero, then each field in turn at the values it is checked at *)
CheckedCancelRejectedV2Message ==
    { ZeroCancelRejectedV2Message }
        \cup { SettleCancelRejectedV2Message([ZeroCancelRejectedV2Message EXCEPT !.transactionTime = one]) : one \in Sample(8) }
        \cup { SettleCancelRejectedV2Message([ZeroCancelRejectedV2Message EXCEPT !.clOrdId = one]) : one \in Sample(20) }
        \cup { SettleCancelRejectedV2Message([ZeroCancelRejectedV2Message EXCEPT !.cancelRejectReason = one]) : one \in Sample(1) }
        \cup { SettleCancelRejectedV2Message([ZeroCancelRejectedV2Message EXCEPT !.text = one]) : one \in Sample(60) }
        \cup { SettleCancelRejectedV2Message([ZeroCancelRejectedV2Message EXCEPT !.reserved1 = one]) : one \in Sample(1) }
        \cup { SettleCancelRejectedV2Message([ZeroCancelRejectedV2Message EXCEPT !.numberOfReturnBitfields = one]) : one \in {0, 1, 255} }
        \cup { SettleCancelRejectedV2Message([ZeroCancelRejectedV2Message EXCEPT !.numberOfReturnBitfields = 1, !.cancelRejectedV2ReturnBitfield1 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCancelRejectedV2Message([ZeroCancelRejectedV2Message EXCEPT !.numberOfReturnBitfields = 2, !.cancelRejectedV2ReturnBitfield2 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCancelRejectedV2Message([ZeroCancelRejectedV2Message EXCEPT !.numberOfReturnBitfields = 3, !.cancelRejectedV2ReturnBitfield3 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCancelRejectedV2Message([ZeroCancelRejectedV2Message EXCEPT !.numberOfReturnBitfields = 4, !.cancelRejectedV2ReturnBitfield4 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCancelRejectedV2Message([ZeroCancelRejectedV2Message EXCEPT !.numberOfReturnBitfields = 5, !.cancelRejectedV2ReturnBitfield5 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCancelRejectedV2Message([ZeroCancelRejectedV2Message EXCEPT !.numberOfReturnBitfields = 6, !.cancelRejectedV2ReturnBitfield6 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCancelRejectedV2Message([ZeroCancelRejectedV2Message EXCEPT !.numberOfReturnBitfields = 7, !.cancelRejectedV2ReturnBitfield7 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCancelRejectedV2Message([ZeroCancelRejectedV2Message EXCEPT !.numberOfReturnBitfields = 8, !.cancelRejectedV2ReturnBitfield8 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCancelRejectedV2Message([ZeroCancelRejectedV2Message EXCEPT !.numberOfReturnBitfields = 9, !.cancelRejectedV2ReturnBitfield9 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCancelRejectedV2Message([ZeroCancelRejectedV2Message EXCEPT !.numberOfReturnBitfields = 10, !.cancelRejectedV2ReturnBitfield10 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCancelRejectedV2Message([ZeroCancelRejectedV2Message EXCEPT !.numberOfReturnBitfields = 11, !.cancelRejectedV2ReturnBitfield11 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCancelRejectedV2Message([ZeroCancelRejectedV2Message EXCEPT !.numberOfReturnBitfields = 12, !.cancelRejectedV2ReturnBitfield12 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCancelRejectedV2Message([ZeroCancelRejectedV2Message EXCEPT !.numberOfReturnBitfields = 13, !.cancelRejectedV2ReturnBitfield13 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCancelRejectedV2Message([ZeroCancelRejectedV2Message EXCEPT !.numberOfReturnBitfields = 14, !.cancelRejectedV2ReturnBitfield14 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCancelRejectedV2Message([ZeroCancelRejectedV2Message EXCEPT !.numberOfReturnBitfields = 15, !.cancelRejectedV2ReturnBitfield15 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCancelRejectedV2Message([ZeroCancelRejectedV2Message EXCEPT !.numberOfReturnBitfields = 16, !.cancelRejectedV2ReturnBitfield16 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCancelRejectedV2Message([ZeroCancelRejectedV2Message EXCEPT !.numberOfReturnBitfields = 17, !.cancelRejectedV2ReturnBitfield17 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCancelRejectedV2Message([ZeroCancelRejectedV2Message EXCEPT !.numberOfReturnBitfields = 18, !.cancelRejectedV2ReturnBitfield18 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCancelRejectedV2Message([ZeroCancelRejectedV2Message EXCEPT !.numberOfReturnBitfields = 19, !.cancelRejectedV2ReturnBitfield19 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCancelRejectedV2Message([ZeroCancelRejectedV2Message EXCEPT !.numberOfReturnBitfields = 1, !.cancelRejectedV2ReturnBitfield1 = <<1>>, !.side = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCancelRejectedV2Message([ZeroCancelRejectedV2Message EXCEPT !.numberOfReturnBitfields = 1, !.cancelRejectedV2ReturnBitfield1 = <<4>>, !.price = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleCancelRejectedV2Message([ZeroCancelRejectedV2Message EXCEPT !.numberOfReturnBitfields = 1, !.cancelRejectedV2ReturnBitfield1 = <<16>>, !.ordType = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCancelRejectedV2Message([ZeroCancelRejectedV2Message EXCEPT !.numberOfReturnBitfields = 1, !.cancelRejectedV2ReturnBitfield1 = <<32>>, !.timeInForce = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCancelRejectedV2Message([ZeroCancelRejectedV2Message EXCEPT !.numberOfReturnBitfields = 1, !.cancelRejectedV2ReturnBitfield1 = <<64>>, !.minQty = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleCancelRejectedV2Message([ZeroCancelRejectedV2Message EXCEPT !.numberOfReturnBitfields = 2, !.cancelRejectedV2ReturnBitfield2 = <<1>>, !.symbolLong = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleCancelRejectedV2Message([ZeroCancelRejectedV2Message EXCEPT !.numberOfReturnBitfields = 2, !.cancelRejectedV2ReturnBitfield2 = <<8>>, !.idSource = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCancelRejectedV2Message([ZeroCancelRejectedV2Message EXCEPT !.numberOfReturnBitfields = 2, !.cancelRejectedV2ReturnBitfield2 = <<16>>, !.securityId = one]) : one \in { <<held>> : held \in Sample(16) } }
        \cup { SettleCancelRejectedV2Message([ZeroCancelRejectedV2Message EXCEPT !.numberOfReturnBitfields = 2, !.cancelRejectedV2ReturnBitfield2 = <<64>>, !.capacity = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCancelRejectedV2Message([ZeroCancelRejectedV2Message EXCEPT !.numberOfReturnBitfields = 4, !.cancelRejectedV2ReturnBitfield4 = <<8>>, !.openClose = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCancelRejectedV2Message([ZeroCancelRejectedV2Message EXCEPT !.numberOfReturnBitfields = 8, !.cancelRejectedV2ReturnBitfield8 = <<4>>, !.stopPx = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleCancelRejectedV2Message([ZeroCancelRejectedV2Message EXCEPT !.numberOfReturnBitfields = 9, !.cancelRejectedV2ReturnBitfield9 = <<16>>, !.liquidityProvision = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCancelRejectedV2Message([ZeroCancelRejectedV2Message EXCEPT !.numberOfReturnBitfields = 10, !.cancelRejectedV2ReturnBitfield10 = <<1>>, !.crossId = one]) : one \in { <<held>> : held \in Sample(20) } }
        \cup { SettleCancelRejectedV2Message([ZeroCancelRejectedV2Message EXCEPT !.numberOfReturnBitfields = 10, !.cancelRejectedV2ReturnBitfield10 = <<2>>, !.allocQty = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleCancelRejectedV2Message([ZeroCancelRejectedV2Message EXCEPT !.numberOfReturnBitfields = 10, !.cancelRejectedV2ReturnBitfield10 = <<128>>, !.clientQualifiedRole = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCancelRejectedV2Message([ZeroCancelRejectedV2Message EXCEPT !.numberOfReturnBitfields = 11, !.cancelRejectedV2ReturnBitfield11 = <<1>>, !.clientId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleCancelRejectedV2Message([ZeroCancelRejectedV2Message EXCEPT !.numberOfReturnBitfields = 11, !.cancelRejectedV2ReturnBitfield11 = <<2>>, !.investorId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleCancelRejectedV2Message([ZeroCancelRejectedV2Message EXCEPT !.numberOfReturnBitfields = 11, !.cancelRejectedV2ReturnBitfield11 = <<4>>, !.executorId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleCancelRejectedV2Message([ZeroCancelRejectedV2Message EXCEPT !.numberOfReturnBitfields = 11, !.cancelRejectedV2ReturnBitfield11 = <<8>>, !.orderOrigination = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCancelRejectedV2Message([ZeroCancelRejectedV2Message EXCEPT !.numberOfReturnBitfields = 11, !.cancelRejectedV2ReturnBitfield11 = <<16>>, !.algorithmicIndicator = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCancelRejectedV2Message([ZeroCancelRejectedV2Message EXCEPT !.numberOfReturnBitfields = 11, !.cancelRejectedV2ReturnBitfield11 = <<64>>, !.investorQualifiedRole = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCancelRejectedV2Message([ZeroCancelRejectedV2Message EXCEPT !.numberOfReturnBitfields = 11, !.cancelRejectedV2ReturnBitfield11 = <<128>>, !.executorQualifiedRole = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCancelRejectedV2Message([ZeroCancelRejectedV2Message EXCEPT !.numberOfReturnBitfields = 15, !.cancelRejectedV2ReturnBitfield15 = <<8>>, !.massCancelId = one]) : one \in { <<held>> : held \in Sample(20) } }

(***************************************************************************)
(* Order Execution V 2 Message                                             *)
(***************************************************************************)

OrderExecutionV2Message ==
    [ transactionTime                  : Sample(8),
      clOrdId                          : Sample(20),
      execId                           : Sample(8),
      lastShares                       : Sample(4),
      lastPx                           : Sample(8),
      leavesQty                        : Sample(4),
      baseLiquidityIndicator           : Sample(1),
      subLiquidityIndicator            : Sample(1),
      contraBroker                     : Sample(4),
      reserved1                        : Sample(1),
      numberOfReturnBitfields          : 0 .. 255,
      orderExecutionV2ReturnBitfield1  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderExecutionV2ReturnBitfield2  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderExecutionV2ReturnBitfield3  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderExecutionV2ReturnBitfield4  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderExecutionV2ReturnBitfield5  : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderExecutionV2ReturnBitfield6  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderExecutionV2ReturnBitfield7  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderExecutionV2ReturnBitfield8  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderExecutionV2ReturnBitfield9  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderExecutionV2ReturnBitfield10 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderExecutionV2ReturnBitfield11 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderExecutionV2ReturnBitfield12 : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderExecutionV2ReturnBitfield13 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderExecutionV2ReturnBitfield14 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderExecutionV2ReturnBitfield15 : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderExecutionV2ReturnBitfield16 : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderExecutionV2ReturnBitfield17 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderExecutionV2ReturnBitfield18 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderExecutionV2ReturnBitfield19 : { << >> } \cup { <<held>> : held \in Sample(1) },
      side                             : { << >> } \cup { <<held>> : held \in Sample(1) },
      price                            : { << >> } \cup { <<held>> : held \in Sample(8) },
      ordType                          : { << >> } \cup { <<held>> : held \in Sample(1) },
      timeInForce                      : { << >> } \cup { <<held>> : held \in Sample(1) },
      minQty                           : { << >> } \cup { <<held>> : held \in Sample(4) },
      symbolLong                       : { << >> } \cup { <<held>> : held \in Sample(8) },
      idSource                         : { << >> } \cup { <<held>> : held \in Sample(1) },
      securityId                       : { << >> } \cup { <<held>> : held \in Sample(16) },
      capacity                         : { << >> } \cup { <<held>> : held \in Sample(1) },
      account                          : { << >> } \cup { <<held>> : held \in Sample(16) },
      clearingFirm                     : { << >> } \cup { <<held>> : held \in Sample(4) },
      clearingAccount                  : { << >> } \cup { <<held>> : held \in Sample(4) },
      displayIndicator                 : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderQty                         : { << >> } \cup { <<held>> : held \in Sample(4) },
      preventMatch                     : { << >> } \cup { <<held>> : held \in Sample(3) },
      openClose                        : { << >> } \cup { <<held>> : held \in Sample(1) },
      extExecInst                      : { << >> } \cup { <<held>> : held \in Sample(1) },
      lastMkt                          : { << >> } \cup { <<held>> : held \in Sample(4) },
      feeCode                          : { << >> } \cup { <<held>> : held \in Sample(2) },
      stopPx                           : { << >> } \cup { <<held>> : held \in Sample(8) },
      routingInst                      : { << >> } \cup { <<held>> : held \in Sample(4) },
      crossType                        : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossPrioritization              : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossId                          : { << >> } \cup { <<held>> : held \in Sample(20) },
      allocQty                         : { << >> } \cup { <<held>> : held \in Sample(4) },
      clientQualifiedRole              : { << >> } \cup { <<held>> : held \in Sample(1) },
      clientId                         : { << >> } \cup { <<held>> : held \in Sample(4) },
      investorId                       : { << >> } \cup { <<held>> : held \in Sample(4) },
      executorId                       : { << >> } \cup { <<held>> : held \in Sample(4) },
      orderOrigination                 : { << >> } \cup { <<held>> : held \in Sample(1) },
      algorithmicIndicator             : { << >> } \cup { <<held>> : held \in Sample(1) },
      investorQualifiedRole            : { << >> } \cup { <<held>> : held \in Sample(1) },
      executorQualifiedRole            : { << >> } \cup { <<held>> : held \in Sample(1) },
      drillThruProtection              : { << >> } \cup { <<held>> : held \in Sample(8) },
      multilegReportingType            : { << >> } \cup { <<held>> : held \in Sample(1) },
      secondaryExecId                  : { << >> } \cup { <<held>> : held \in Sample(8) },
      custOrderHandlingInst            : { << >> } \cup { <<held>> : held \in Sample(1) },
      accountType                      : { << >> } \cup { <<held>> : held \in Sample(1) } ]

EncodeOrderExecutionV2Message(message) ==
    message.transactionTime
        \o message.clOrdId
        \o message.execId
        \o message.lastShares
        \o message.lastPx
        \o message.leavesQty
        \o message.baseLiquidityIndicator
        \o message.subLiquidityIndicator
        \o message.contraBroker
        \o message.reserved1
        \o EncodeUIntBE(message.numberOfReturnBitfields, 1)
        \o (IF message.orderExecutionV2ReturnBitfield1 = << >> THEN << >> ELSE EncodeUIntLE(message.orderExecutionV2ReturnBitfield1[1], 1))
        \o (IF message.orderExecutionV2ReturnBitfield2 = << >> THEN << >> ELSE EncodeUIntLE(message.orderExecutionV2ReturnBitfield2[1], 1))
        \o (IF message.orderExecutionV2ReturnBitfield3 = << >> THEN << >> ELSE EncodeUIntLE(message.orderExecutionV2ReturnBitfield3[1], 1))
        \o (IF message.orderExecutionV2ReturnBitfield4 = << >> THEN << >> ELSE EncodeUIntLE(message.orderExecutionV2ReturnBitfield4[1], 1))
        \o (IF message.orderExecutionV2ReturnBitfield5 = << >> THEN << >> ELSE message.orderExecutionV2ReturnBitfield5[1])
        \o (IF message.orderExecutionV2ReturnBitfield6 = << >> THEN << >> ELSE EncodeUIntLE(message.orderExecutionV2ReturnBitfield6[1], 1))
        \o (IF message.orderExecutionV2ReturnBitfield7 = << >> THEN << >> ELSE EncodeUIntLE(message.orderExecutionV2ReturnBitfield7[1], 1))
        \o (IF message.orderExecutionV2ReturnBitfield8 = << >> THEN << >> ELSE EncodeUIntLE(message.orderExecutionV2ReturnBitfield8[1], 1))
        \o (IF message.orderExecutionV2ReturnBitfield9 = << >> THEN << >> ELSE EncodeUIntLE(message.orderExecutionV2ReturnBitfield9[1], 1))
        \o (IF message.orderExecutionV2ReturnBitfield10 = << >> THEN << >> ELSE EncodeUIntLE(message.orderExecutionV2ReturnBitfield10[1], 1))
        \o (IF message.orderExecutionV2ReturnBitfield11 = << >> THEN << >> ELSE EncodeUIntLE(message.orderExecutionV2ReturnBitfield11[1], 1))
        \o (IF message.orderExecutionV2ReturnBitfield12 = << >> THEN << >> ELSE message.orderExecutionV2ReturnBitfield12[1])
        \o (IF message.orderExecutionV2ReturnBitfield13 = << >> THEN << >> ELSE EncodeUIntLE(message.orderExecutionV2ReturnBitfield13[1], 1))
        \o (IF message.orderExecutionV2ReturnBitfield14 = << >> THEN << >> ELSE EncodeUIntLE(message.orderExecutionV2ReturnBitfield14[1], 1))
        \o (IF message.orderExecutionV2ReturnBitfield15 = << >> THEN << >> ELSE message.orderExecutionV2ReturnBitfield15[1])
        \o (IF message.orderExecutionV2ReturnBitfield16 = << >> THEN << >> ELSE message.orderExecutionV2ReturnBitfield16[1])
        \o (IF message.orderExecutionV2ReturnBitfield17 = << >> THEN << >> ELSE EncodeUIntLE(message.orderExecutionV2ReturnBitfield17[1], 1))
        \o (IF message.orderExecutionV2ReturnBitfield18 = << >> THEN << >> ELSE EncodeUIntLE(message.orderExecutionV2ReturnBitfield18[1], 1))
        \o (IF message.orderExecutionV2ReturnBitfield19 = << >> THEN << >> ELSE message.orderExecutionV2ReturnBitfield19[1])
        \o (IF message.side = << >> THEN << >> ELSE message.side[1])
        \o (IF message.price = << >> THEN << >> ELSE message.price[1])
        \o (IF message.ordType = << >> THEN << >> ELSE message.ordType[1])
        \o (IF message.timeInForce = << >> THEN << >> ELSE message.timeInForce[1])
        \o (IF message.minQty = << >> THEN << >> ELSE message.minQty[1])
        \o (IF message.symbolLong = << >> THEN << >> ELSE message.symbolLong[1])
        \o (IF message.idSource = << >> THEN << >> ELSE message.idSource[1])
        \o (IF message.securityId = << >> THEN << >> ELSE message.securityId[1])
        \o (IF message.capacity = << >> THEN << >> ELSE message.capacity[1])
        \o (IF message.account = << >> THEN << >> ELSE message.account[1])
        \o (IF message.clearingFirm = << >> THEN << >> ELSE message.clearingFirm[1])
        \o (IF message.clearingAccount = << >> THEN << >> ELSE message.clearingAccount[1])
        \o (IF message.displayIndicator = << >> THEN << >> ELSE message.displayIndicator[1])
        \o (IF message.orderQty = << >> THEN << >> ELSE message.orderQty[1])
        \o (IF message.preventMatch = << >> THEN << >> ELSE message.preventMatch[1])
        \o (IF message.openClose = << >> THEN << >> ELSE message.openClose[1])
        \o (IF message.extExecInst = << >> THEN << >> ELSE message.extExecInst[1])
        \o (IF message.lastMkt = << >> THEN << >> ELSE message.lastMkt[1])
        \o (IF message.feeCode = << >> THEN << >> ELSE message.feeCode[1])
        \o (IF message.stopPx = << >> THEN << >> ELSE message.stopPx[1])
        \o (IF message.routingInst = << >> THEN << >> ELSE message.routingInst[1])
        \o (IF message.crossType = << >> THEN << >> ELSE message.crossType[1])
        \o (IF message.crossPrioritization = << >> THEN << >> ELSE message.crossPrioritization[1])
        \o (IF message.crossId = << >> THEN << >> ELSE message.crossId[1])
        \o (IF message.allocQty = << >> THEN << >> ELSE message.allocQty[1])
        \o (IF message.clientQualifiedRole = << >> THEN << >> ELSE message.clientQualifiedRole[1])
        \o (IF message.clientId = << >> THEN << >> ELSE message.clientId[1])
        \o (IF message.investorId = << >> THEN << >> ELSE message.investorId[1])
        \o (IF message.executorId = << >> THEN << >> ELSE message.executorId[1])
        \o (IF message.orderOrigination = << >> THEN << >> ELSE message.orderOrigination[1])
        \o (IF message.algorithmicIndicator = << >> THEN << >> ELSE message.algorithmicIndicator[1])
        \o (IF message.investorQualifiedRole = << >> THEN << >> ELSE message.investorQualifiedRole[1])
        \o (IF message.executorQualifiedRole = << >> THEN << >> ELSE message.executorQualifiedRole[1])
        \o (IF message.drillThruProtection = << >> THEN << >> ELSE message.drillThruProtection[1])
        \o (IF message.multilegReportingType = << >> THEN << >> ELSE message.multilegReportingType[1])
        \o (IF message.secondaryExecId = << >> THEN << >> ELSE message.secondaryExecId[1])
        \o (IF message.custOrderHandlingInst = << >> THEN << >> ELSE message.custOrderHandlingInst[1])
        \o (IF message.accountType = << >> THEN << >> ELSE message.accountType[1])

DecodeOrderExecutionV2Message(bytes) ==
    LET transactionTime == ReadBytes(bytes, 8) IN IF ~transactionTime.ok THEN Fail ELSE
    LET clOrdId == ReadBytes(transactionTime.rest, 20) IN IF ~clOrdId.ok THEN Fail ELSE
    LET execId == ReadBytes(clOrdId.rest, 8) IN IF ~execId.ok THEN Fail ELSE
    LET lastShares == ReadBytes(execId.rest, 4) IN IF ~lastShares.ok THEN Fail ELSE
    LET lastPx == ReadBytes(lastShares.rest, 8) IN IF ~lastPx.ok THEN Fail ELSE
    LET leavesQty == ReadBytes(lastPx.rest, 4) IN IF ~leavesQty.ok THEN Fail ELSE
    LET baseLiquidityIndicator == ReadBytes(leavesQty.rest, 1) IN IF ~baseLiquidityIndicator.ok THEN Fail ELSE
    LET subLiquidityIndicator == ReadBytes(baseLiquidityIndicator.rest, 1) IN IF ~subLiquidityIndicator.ok THEN Fail ELSE
    LET contraBroker == ReadBytes(subLiquidityIndicator.rest, 4) IN IF ~contraBroker.ok THEN Fail ELSE
    LET reserved1 == ReadBytes(contraBroker.rest, 1) IN IF ~reserved1.ok THEN Fail ELSE
    LET numberOfReturnBitfields == ReadUIntBE(reserved1.rest, 1) IN IF ~numberOfReturnBitfields.ok THEN Fail ELSE
    LET orderExecutionV2ReturnBitfield1 == ReadWhen(numberOfReturnBitfields.value >= 1, ReadUIntLE(numberOfReturnBitfields.rest, 1), numberOfReturnBitfields.rest) IN IF ~orderExecutionV2ReturnBitfield1.ok THEN Fail ELSE
    LET orderExecutionV2ReturnBitfield2 == ReadWhen(numberOfReturnBitfields.value >= 2, ReadUIntLE(orderExecutionV2ReturnBitfield1.rest, 1), orderExecutionV2ReturnBitfield1.rest) IN IF ~orderExecutionV2ReturnBitfield2.ok THEN Fail ELSE
    LET orderExecutionV2ReturnBitfield3 == ReadWhen(numberOfReturnBitfields.value >= 3, ReadUIntLE(orderExecutionV2ReturnBitfield2.rest, 1), orderExecutionV2ReturnBitfield2.rest) IN IF ~orderExecutionV2ReturnBitfield3.ok THEN Fail ELSE
    LET orderExecutionV2ReturnBitfield4 == ReadWhen(numberOfReturnBitfields.value >= 4, ReadUIntLE(orderExecutionV2ReturnBitfield3.rest, 1), orderExecutionV2ReturnBitfield3.rest) IN IF ~orderExecutionV2ReturnBitfield4.ok THEN Fail ELSE
    LET orderExecutionV2ReturnBitfield5 == ReadWhen(numberOfReturnBitfields.value >= 5, ReadBytes(orderExecutionV2ReturnBitfield4.rest, 1), orderExecutionV2ReturnBitfield4.rest) IN IF ~orderExecutionV2ReturnBitfield5.ok THEN Fail ELSE
    LET orderExecutionV2ReturnBitfield6 == ReadWhen(numberOfReturnBitfields.value >= 6, ReadUIntLE(orderExecutionV2ReturnBitfield5.rest, 1), orderExecutionV2ReturnBitfield5.rest) IN IF ~orderExecutionV2ReturnBitfield6.ok THEN Fail ELSE
    LET orderExecutionV2ReturnBitfield7 == ReadWhen(numberOfReturnBitfields.value >= 7, ReadUIntLE(orderExecutionV2ReturnBitfield6.rest, 1), orderExecutionV2ReturnBitfield6.rest) IN IF ~orderExecutionV2ReturnBitfield7.ok THEN Fail ELSE
    LET orderExecutionV2ReturnBitfield8 == ReadWhen(numberOfReturnBitfields.value >= 8, ReadUIntLE(orderExecutionV2ReturnBitfield7.rest, 1), orderExecutionV2ReturnBitfield7.rest) IN IF ~orderExecutionV2ReturnBitfield8.ok THEN Fail ELSE
    LET orderExecutionV2ReturnBitfield9 == ReadWhen(numberOfReturnBitfields.value >= 9, ReadUIntLE(orderExecutionV2ReturnBitfield8.rest, 1), orderExecutionV2ReturnBitfield8.rest) IN IF ~orderExecutionV2ReturnBitfield9.ok THEN Fail ELSE
    LET orderExecutionV2ReturnBitfield10 == ReadWhen(numberOfReturnBitfields.value >= 10, ReadUIntLE(orderExecutionV2ReturnBitfield9.rest, 1), orderExecutionV2ReturnBitfield9.rest) IN IF ~orderExecutionV2ReturnBitfield10.ok THEN Fail ELSE
    LET orderExecutionV2ReturnBitfield11 == ReadWhen(numberOfReturnBitfields.value >= 11, ReadUIntLE(orderExecutionV2ReturnBitfield10.rest, 1), orderExecutionV2ReturnBitfield10.rest) IN IF ~orderExecutionV2ReturnBitfield11.ok THEN Fail ELSE
    LET orderExecutionV2ReturnBitfield12 == ReadWhen(numberOfReturnBitfields.value >= 12, ReadBytes(orderExecutionV2ReturnBitfield11.rest, 1), orderExecutionV2ReturnBitfield11.rest) IN IF ~orderExecutionV2ReturnBitfield12.ok THEN Fail ELSE
    LET orderExecutionV2ReturnBitfield13 == ReadWhen(numberOfReturnBitfields.value >= 13, ReadUIntLE(orderExecutionV2ReturnBitfield12.rest, 1), orderExecutionV2ReturnBitfield12.rest) IN IF ~orderExecutionV2ReturnBitfield13.ok THEN Fail ELSE
    LET orderExecutionV2ReturnBitfield14 == ReadWhen(numberOfReturnBitfields.value >= 14, ReadUIntLE(orderExecutionV2ReturnBitfield13.rest, 1), orderExecutionV2ReturnBitfield13.rest) IN IF ~orderExecutionV2ReturnBitfield14.ok THEN Fail ELSE
    LET orderExecutionV2ReturnBitfield15 == ReadWhen(numberOfReturnBitfields.value >= 15, ReadBytes(orderExecutionV2ReturnBitfield14.rest, 1), orderExecutionV2ReturnBitfield14.rest) IN IF ~orderExecutionV2ReturnBitfield15.ok THEN Fail ELSE
    LET orderExecutionV2ReturnBitfield16 == ReadWhen(numberOfReturnBitfields.value >= 16, ReadBytes(orderExecutionV2ReturnBitfield15.rest, 1), orderExecutionV2ReturnBitfield15.rest) IN IF ~orderExecutionV2ReturnBitfield16.ok THEN Fail ELSE
    LET orderExecutionV2ReturnBitfield17 == ReadWhen(numberOfReturnBitfields.value >= 17, ReadUIntLE(orderExecutionV2ReturnBitfield16.rest, 1), orderExecutionV2ReturnBitfield16.rest) IN IF ~orderExecutionV2ReturnBitfield17.ok THEN Fail ELSE
    LET orderExecutionV2ReturnBitfield18 == ReadWhen(numberOfReturnBitfields.value >= 18, ReadUIntLE(orderExecutionV2ReturnBitfield17.rest, 1), orderExecutionV2ReturnBitfield17.rest) IN IF ~orderExecutionV2ReturnBitfield18.ok THEN Fail ELSE
    LET orderExecutionV2ReturnBitfield19 == ReadWhen(numberOfReturnBitfields.value >= 19, ReadBytes(orderExecutionV2ReturnBitfield18.rest, 1), orderExecutionV2ReturnBitfield18.rest) IN IF ~orderExecutionV2ReturnBitfield19.ok THEN Fail ELSE
    LET side == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderExecutionV2ReturnBitfield1.value # << >> /\ orderExecutionV2ReturnBitfield1.value[1] % 2 > 0), ReadBytes(orderExecutionV2ReturnBitfield19.rest, 1), orderExecutionV2ReturnBitfield19.rest) IN IF ~side.ok THEN Fail ELSE
    LET price == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderExecutionV2ReturnBitfield1.value # << >> /\ (orderExecutionV2ReturnBitfield1.value[1] \div 4) % 2 > 0), ReadBytes(side.rest, 8), side.rest) IN IF ~price.ok THEN Fail ELSE
    LET ordType == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderExecutionV2ReturnBitfield1.value # << >> /\ (orderExecutionV2ReturnBitfield1.value[1] \div 16) % 2 > 0), ReadBytes(price.rest, 1), price.rest) IN IF ~ordType.ok THEN Fail ELSE
    LET timeInForce == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderExecutionV2ReturnBitfield1.value # << >> /\ (orderExecutionV2ReturnBitfield1.value[1] \div 32) % 2 > 0), ReadBytes(ordType.rest, 1), ordType.rest) IN IF ~timeInForce.ok THEN Fail ELSE
    LET minQty == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderExecutionV2ReturnBitfield1.value # << >> /\ (orderExecutionV2ReturnBitfield1.value[1] \div 64) % 2 > 0), ReadBytes(timeInForce.rest, 4), timeInForce.rest) IN IF ~minQty.ok THEN Fail ELSE
    LET symbolLong == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (orderExecutionV2ReturnBitfield2.value # << >> /\ orderExecutionV2ReturnBitfield2.value[1] % 2 > 0), ReadBytes(minQty.rest, 8), minQty.rest) IN IF ~symbolLong.ok THEN Fail ELSE
    LET idSource == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (orderExecutionV2ReturnBitfield2.value # << >> /\ (orderExecutionV2ReturnBitfield2.value[1] \div 8) % 2 > 0), ReadBytes(symbolLong.rest, 1), symbolLong.rest) IN IF ~idSource.ok THEN Fail ELSE
    LET securityId == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (orderExecutionV2ReturnBitfield2.value # << >> /\ (orderExecutionV2ReturnBitfield2.value[1] \div 16) % 2 > 0), ReadBytes(idSource.rest, 16), idSource.rest) IN IF ~securityId.ok THEN Fail ELSE
    LET capacity == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (orderExecutionV2ReturnBitfield2.value # << >> /\ (orderExecutionV2ReturnBitfield2.value[1] \div 64) % 2 > 0), ReadBytes(securityId.rest, 1), securityId.rest) IN IF ~capacity.ok THEN Fail ELSE
    LET account == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderExecutionV2ReturnBitfield3.value # << >> /\ orderExecutionV2ReturnBitfield3.value[1] % 2 > 0), ReadBytes(capacity.rest, 16), capacity.rest) IN IF ~account.ok THEN Fail ELSE
    LET clearingFirm == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderExecutionV2ReturnBitfield3.value # << >> /\ (orderExecutionV2ReturnBitfield3.value[1] \div 2) % 2 > 0), ReadBytes(account.rest, 4), account.rest) IN IF ~clearingFirm.ok THEN Fail ELSE
    LET clearingAccount == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderExecutionV2ReturnBitfield3.value # << >> /\ (orderExecutionV2ReturnBitfield3.value[1] \div 4) % 2 > 0), ReadBytes(clearingFirm.rest, 4), clearingFirm.rest) IN IF ~clearingAccount.ok THEN Fail ELSE
    LET displayIndicator == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderExecutionV2ReturnBitfield3.value # << >> /\ (orderExecutionV2ReturnBitfield3.value[1] \div 8) % 2 > 0), ReadBytes(clearingAccount.rest, 1), clearingAccount.rest) IN IF ~displayIndicator.ok THEN Fail ELSE
    LET orderQty == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderExecutionV2ReturnBitfield3.value # << >> /\ (orderExecutionV2ReturnBitfield3.value[1] \div 64) % 2 > 0), ReadBytes(displayIndicator.rest, 4), displayIndicator.rest) IN IF ~orderQty.ok THEN Fail ELSE
    LET preventMatch == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderExecutionV2ReturnBitfield3.value # << >> /\ (orderExecutionV2ReturnBitfield3.value[1] \div 128) % 2 > 0), ReadBytes(orderQty.rest, 3), orderQty.rest) IN IF ~preventMatch.ok THEN Fail ELSE
    LET openClose == ReadWhen(numberOfReturnBitfields.value >= 4 /\ (orderExecutionV2ReturnBitfield4.value # << >> /\ (orderExecutionV2ReturnBitfield4.value[1] \div 8) % 2 > 0), ReadBytes(preventMatch.rest, 1), preventMatch.rest) IN IF ~openClose.ok THEN Fail ELSE
    LET extExecInst == ReadWhen(numberOfReturnBitfields.value >= 6 /\ (orderExecutionV2ReturnBitfield6.value # << >> /\ (orderExecutionV2ReturnBitfield6.value[1] \div 16) % 2 > 0), ReadBytes(openClose.rest, 1), openClose.rest) IN IF ~extExecInst.ok THEN Fail ELSE
    LET lastMkt == ReadWhen(numberOfReturnBitfields.value >= 7 /\ (orderExecutionV2ReturnBitfield7.value # << >> /\ (orderExecutionV2ReturnBitfield7.value[1] \div 128) % 2 > 0), ReadBytes(extExecInst.rest, 4), extExecInst.rest) IN IF ~lastMkt.ok THEN Fail ELSE
    LET feeCode == ReadWhen(numberOfReturnBitfields.value >= 8 /\ (orderExecutionV2ReturnBitfield8.value # << >> /\ orderExecutionV2ReturnBitfield8.value[1] % 2 > 0), ReadBytes(lastMkt.rest, 2), lastMkt.rest) IN IF ~feeCode.ok THEN Fail ELSE
    LET stopPx == ReadWhen(numberOfReturnBitfields.value >= 8 /\ (orderExecutionV2ReturnBitfield8.value # << >> /\ (orderExecutionV2ReturnBitfield8.value[1] \div 4) % 2 > 0), ReadBytes(feeCode.rest, 8), feeCode.rest) IN IF ~stopPx.ok THEN Fail ELSE
    LET routingInst == ReadWhen(numberOfReturnBitfields.value >= 8 /\ (orderExecutionV2ReturnBitfield8.value # << >> /\ (orderExecutionV2ReturnBitfield8.value[1] \div 8) % 2 > 0), ReadBytes(stopPx.rest, 4), stopPx.rest) IN IF ~routingInst.ok THEN Fail ELSE
    LET crossType == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (orderExecutionV2ReturnBitfield9.value # << >> /\ (orderExecutionV2ReturnBitfield9.value[1] \div 64) % 2 > 0), ReadBytes(routingInst.rest, 1), routingInst.rest) IN IF ~crossType.ok THEN Fail ELSE
    LET crossPrioritization == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (orderExecutionV2ReturnBitfield9.value # << >> /\ (orderExecutionV2ReturnBitfield9.value[1] \div 128) % 2 > 0), ReadBytes(crossType.rest, 1), crossType.rest) IN IF ~crossPrioritization.ok THEN Fail ELSE
    LET crossId == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (orderExecutionV2ReturnBitfield10.value # << >> /\ orderExecutionV2ReturnBitfield10.value[1] % 2 > 0), ReadBytes(crossPrioritization.rest, 20), crossPrioritization.rest) IN IF ~crossId.ok THEN Fail ELSE
    LET allocQty == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (orderExecutionV2ReturnBitfield10.value # << >> /\ (orderExecutionV2ReturnBitfield10.value[1] \div 2) % 2 > 0), ReadBytes(crossId.rest, 4), crossId.rest) IN IF ~allocQty.ok THEN Fail ELSE
    LET clientQualifiedRole == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (orderExecutionV2ReturnBitfield10.value # << >> /\ (orderExecutionV2ReturnBitfield10.value[1] \div 128) % 2 > 0), ReadBytes(allocQty.rest, 1), allocQty.rest) IN IF ~clientQualifiedRole.ok THEN Fail ELSE
    LET clientId == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (orderExecutionV2ReturnBitfield11.value # << >> /\ orderExecutionV2ReturnBitfield11.value[1] % 2 > 0), ReadBytes(clientQualifiedRole.rest, 4), clientQualifiedRole.rest) IN IF ~clientId.ok THEN Fail ELSE
    LET investorId == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (orderExecutionV2ReturnBitfield11.value # << >> /\ (orderExecutionV2ReturnBitfield11.value[1] \div 2) % 2 > 0), ReadBytes(clientId.rest, 4), clientId.rest) IN IF ~investorId.ok THEN Fail ELSE
    LET executorId == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (orderExecutionV2ReturnBitfield11.value # << >> /\ (orderExecutionV2ReturnBitfield11.value[1] \div 4) % 2 > 0), ReadBytes(investorId.rest, 4), investorId.rest) IN IF ~executorId.ok THEN Fail ELSE
    LET orderOrigination == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (orderExecutionV2ReturnBitfield11.value # << >> /\ (orderExecutionV2ReturnBitfield11.value[1] \div 8) % 2 > 0), ReadBytes(executorId.rest, 1), executorId.rest) IN IF ~orderOrigination.ok THEN Fail ELSE
    LET algorithmicIndicator == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (orderExecutionV2ReturnBitfield11.value # << >> /\ (orderExecutionV2ReturnBitfield11.value[1] \div 16) % 2 > 0), ReadBytes(orderOrigination.rest, 1), orderOrigination.rest) IN IF ~algorithmicIndicator.ok THEN Fail ELSE
    LET investorQualifiedRole == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (orderExecutionV2ReturnBitfield11.value # << >> /\ (orderExecutionV2ReturnBitfield11.value[1] \div 64) % 2 > 0), ReadBytes(algorithmicIndicator.rest, 1), algorithmicIndicator.rest) IN IF ~investorQualifiedRole.ok THEN Fail ELSE
    LET executorQualifiedRole == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (orderExecutionV2ReturnBitfield11.value # << >> /\ (orderExecutionV2ReturnBitfield11.value[1] \div 128) % 2 > 0), ReadBytes(investorQualifiedRole.rest, 1), investorQualifiedRole.rest) IN IF ~executorQualifiedRole.ok THEN Fail ELSE
    LET drillThruProtection == ReadWhen(numberOfReturnBitfields.value >= 13 /\ (orderExecutionV2ReturnBitfield13.value # << >> /\ (orderExecutionV2ReturnBitfield13.value[1] \div 64) % 2 > 0), ReadBytes(executorQualifiedRole.rest, 8), executorQualifiedRole.rest) IN IF ~drillThruProtection.ok THEN Fail ELSE
    LET multilegReportingType == ReadWhen(numberOfReturnBitfields.value >= 13 /\ (orderExecutionV2ReturnBitfield13.value # << >> /\ (orderExecutionV2ReturnBitfield13.value[1] \div 128) % 2 > 0), ReadBytes(drillThruProtection.rest, 1), drillThruProtection.rest) IN IF ~multilegReportingType.ok THEN Fail ELSE
    LET secondaryExecId == ReadWhen(numberOfReturnBitfields.value >= 14 /\ (orderExecutionV2ReturnBitfield14.value # << >> /\ (orderExecutionV2ReturnBitfield14.value[1] \div 16) % 2 > 0), ReadBytes(multilegReportingType.rest, 8), multilegReportingType.rest) IN IF ~secondaryExecId.ok THEN Fail ELSE
    LET custOrderHandlingInst == ReadWhen(numberOfReturnBitfields.value >= 17 /\ (orderExecutionV2ReturnBitfield17.value # << >> /\ (orderExecutionV2ReturnBitfield17.value[1] \div 128) % 2 > 0), ReadBytes(secondaryExecId.rest, 1), secondaryExecId.rest) IN IF ~custOrderHandlingInst.ok THEN Fail ELSE
    LET accountType == ReadWhen(numberOfReturnBitfields.value >= 18 /\ (orderExecutionV2ReturnBitfield18.value # << >> /\ orderExecutionV2ReturnBitfield18.value[1] % 2 > 0), ReadBytes(custOrderHandlingInst.rest, 1), custOrderHandlingInst.rest) IN IF ~accountType.ok THEN Fail ELSE
    Ok([ transactionTime                  |-> transactionTime.value,
         clOrdId                          |-> clOrdId.value,
         execId                           |-> execId.value,
         lastShares                       |-> lastShares.value,
         lastPx                           |-> lastPx.value,
         leavesQty                        |-> leavesQty.value,
         baseLiquidityIndicator           |-> baseLiquidityIndicator.value,
         subLiquidityIndicator            |-> subLiquidityIndicator.value,
         contraBroker                     |-> contraBroker.value,
         reserved1                        |-> reserved1.value,
         numberOfReturnBitfields          |-> numberOfReturnBitfields.value,
         orderExecutionV2ReturnBitfield1  |-> orderExecutionV2ReturnBitfield1.value,
         orderExecutionV2ReturnBitfield2  |-> orderExecutionV2ReturnBitfield2.value,
         orderExecutionV2ReturnBitfield3  |-> orderExecutionV2ReturnBitfield3.value,
         orderExecutionV2ReturnBitfield4  |-> orderExecutionV2ReturnBitfield4.value,
         orderExecutionV2ReturnBitfield5  |-> orderExecutionV2ReturnBitfield5.value,
         orderExecutionV2ReturnBitfield6  |-> orderExecutionV2ReturnBitfield6.value,
         orderExecutionV2ReturnBitfield7  |-> orderExecutionV2ReturnBitfield7.value,
         orderExecutionV2ReturnBitfield8  |-> orderExecutionV2ReturnBitfield8.value,
         orderExecutionV2ReturnBitfield9  |-> orderExecutionV2ReturnBitfield9.value,
         orderExecutionV2ReturnBitfield10 |-> orderExecutionV2ReturnBitfield10.value,
         orderExecutionV2ReturnBitfield11 |-> orderExecutionV2ReturnBitfield11.value,
         orderExecutionV2ReturnBitfield12 |-> orderExecutionV2ReturnBitfield12.value,
         orderExecutionV2ReturnBitfield13 |-> orderExecutionV2ReturnBitfield13.value,
         orderExecutionV2ReturnBitfield14 |-> orderExecutionV2ReturnBitfield14.value,
         orderExecutionV2ReturnBitfield15 |-> orderExecutionV2ReturnBitfield15.value,
         orderExecutionV2ReturnBitfield16 |-> orderExecutionV2ReturnBitfield16.value,
         orderExecutionV2ReturnBitfield17 |-> orderExecutionV2ReturnBitfield17.value,
         orderExecutionV2ReturnBitfield18 |-> orderExecutionV2ReturnBitfield18.value,
         orderExecutionV2ReturnBitfield19 |-> orderExecutionV2ReturnBitfield19.value,
         side                             |-> side.value,
         price                            |-> price.value,
         ordType                          |-> ordType.value,
         timeInForce                      |-> timeInForce.value,
         minQty                           |-> minQty.value,
         symbolLong                       |-> symbolLong.value,
         idSource                         |-> idSource.value,
         securityId                       |-> securityId.value,
         capacity                         |-> capacity.value,
         account                          |-> account.value,
         clearingFirm                     |-> clearingFirm.value,
         clearingAccount                  |-> clearingAccount.value,
         displayIndicator                 |-> displayIndicator.value,
         orderQty                         |-> orderQty.value,
         preventMatch                     |-> preventMatch.value,
         openClose                        |-> openClose.value,
         extExecInst                      |-> extExecInst.value,
         lastMkt                          |-> lastMkt.value,
         feeCode                          |-> feeCode.value,
         stopPx                           |-> stopPx.value,
         routingInst                      |-> routingInst.value,
         crossType                        |-> crossType.value,
         crossPrioritization              |-> crossPrioritization.value,
         crossId                          |-> crossId.value,
         allocQty                         |-> allocQty.value,
         clientQualifiedRole              |-> clientQualifiedRole.value,
         clientId                         |-> clientId.value,
         investorId                       |-> investorId.value,
         executorId                       |-> executorId.value,
         orderOrigination                 |-> orderOrigination.value,
         algorithmicIndicator             |-> algorithmicIndicator.value,
         investorQualifiedRole            |-> investorQualifiedRole.value,
         executorQualifiedRole            |-> executorQualifiedRole.value,
         drillThruProtection              |-> drillThruProtection.value,
         multilegReportingType            |-> multilegReportingType.value,
         secondaryExecId                  |-> secondaryExecId.value,
         custOrderHandlingInst            |-> custOrderHandlingInst.value,
         accountType                      |-> accountType.value ], accountType.rest)

(* Order Execution V 2 Message with each field marked present by fields before it there exactly where they say *)
SettleOrderExecutionV2Message(message) ==
    LET settled1 == [message EXCEPT !.orderExecutionV2ReturnBitfield1 = IF message.numberOfReturnBitfields >= 1 THEN (IF message.orderExecutionV2ReturnBitfield1 = << >> THEN <<0>> ELSE message.orderExecutionV2ReturnBitfield1) ELSE << >>]
        settled2 == [settled1 EXCEPT !.orderExecutionV2ReturnBitfield2 = IF settled1.numberOfReturnBitfields >= 2 THEN (IF settled1.orderExecutionV2ReturnBitfield2 = << >> THEN <<0>> ELSE settled1.orderExecutionV2ReturnBitfield2) ELSE << >>]
        settled3 == [settled2 EXCEPT !.orderExecutionV2ReturnBitfield3 = IF settled2.numberOfReturnBitfields >= 3 THEN (IF settled2.orderExecutionV2ReturnBitfield3 = << >> THEN <<0>> ELSE settled2.orderExecutionV2ReturnBitfield3) ELSE << >>]
        settled4 == [settled3 EXCEPT !.orderExecutionV2ReturnBitfield4 = IF settled3.numberOfReturnBitfields >= 4 THEN (IF settled3.orderExecutionV2ReturnBitfield4 = << >> THEN <<0>> ELSE settled3.orderExecutionV2ReturnBitfield4) ELSE << >>]
        settled5 == [settled4 EXCEPT !.orderExecutionV2ReturnBitfield5 = IF settled4.numberOfReturnBitfields >= 5 THEN (IF settled4.orderExecutionV2ReturnBitfield5 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled4.orderExecutionV2ReturnBitfield5) ELSE << >>]
        settled6 == [settled5 EXCEPT !.orderExecutionV2ReturnBitfield6 = IF settled5.numberOfReturnBitfields >= 6 THEN (IF settled5.orderExecutionV2ReturnBitfield6 = << >> THEN <<0>> ELSE settled5.orderExecutionV2ReturnBitfield6) ELSE << >>]
        settled7 == [settled6 EXCEPT !.orderExecutionV2ReturnBitfield7 = IF settled6.numberOfReturnBitfields >= 7 THEN (IF settled6.orderExecutionV2ReturnBitfield7 = << >> THEN <<0>> ELSE settled6.orderExecutionV2ReturnBitfield7) ELSE << >>]
        settled8 == [settled7 EXCEPT !.orderExecutionV2ReturnBitfield8 = IF settled7.numberOfReturnBitfields >= 8 THEN (IF settled7.orderExecutionV2ReturnBitfield8 = << >> THEN <<0>> ELSE settled7.orderExecutionV2ReturnBitfield8) ELSE << >>]
        settled9 == [settled8 EXCEPT !.orderExecutionV2ReturnBitfield9 = IF settled8.numberOfReturnBitfields >= 9 THEN (IF settled8.orderExecutionV2ReturnBitfield9 = << >> THEN <<0>> ELSE settled8.orderExecutionV2ReturnBitfield9) ELSE << >>]
        settled10 == [settled9 EXCEPT !.orderExecutionV2ReturnBitfield10 = IF settled9.numberOfReturnBitfields >= 10 THEN (IF settled9.orderExecutionV2ReturnBitfield10 = << >> THEN <<0>> ELSE settled9.orderExecutionV2ReturnBitfield10) ELSE << >>]
        settled11 == [settled10 EXCEPT !.orderExecutionV2ReturnBitfield11 = IF settled10.numberOfReturnBitfields >= 11 THEN (IF settled10.orderExecutionV2ReturnBitfield11 = << >> THEN <<0>> ELSE settled10.orderExecutionV2ReturnBitfield11) ELSE << >>]
        settled12 == [settled11 EXCEPT !.orderExecutionV2ReturnBitfield12 = IF settled11.numberOfReturnBitfields >= 12 THEN (IF settled11.orderExecutionV2ReturnBitfield12 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled11.orderExecutionV2ReturnBitfield12) ELSE << >>]
        settled13 == [settled12 EXCEPT !.orderExecutionV2ReturnBitfield13 = IF settled12.numberOfReturnBitfields >= 13 THEN (IF settled12.orderExecutionV2ReturnBitfield13 = << >> THEN <<0>> ELSE settled12.orderExecutionV2ReturnBitfield13) ELSE << >>]
        settled14 == [settled13 EXCEPT !.orderExecutionV2ReturnBitfield14 = IF settled13.numberOfReturnBitfields >= 14 THEN (IF settled13.orderExecutionV2ReturnBitfield14 = << >> THEN <<0>> ELSE settled13.orderExecutionV2ReturnBitfield14) ELSE << >>]
        settled15 == [settled14 EXCEPT !.orderExecutionV2ReturnBitfield15 = IF settled14.numberOfReturnBitfields >= 15 THEN (IF settled14.orderExecutionV2ReturnBitfield15 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled14.orderExecutionV2ReturnBitfield15) ELSE << >>]
        settled16 == [settled15 EXCEPT !.orderExecutionV2ReturnBitfield16 = IF settled15.numberOfReturnBitfields >= 16 THEN (IF settled15.orderExecutionV2ReturnBitfield16 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled15.orderExecutionV2ReturnBitfield16) ELSE << >>]
