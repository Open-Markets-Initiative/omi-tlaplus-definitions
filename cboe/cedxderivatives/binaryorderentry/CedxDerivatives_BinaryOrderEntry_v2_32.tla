        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 6, !.orderAcknowledgmentV2ReturnBitfield6 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 7, !.orderAcknowledgmentV2ReturnBitfield7 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 8, !.orderAcknowledgmentV2ReturnBitfield8 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 9, !.orderAcknowledgmentV2ReturnBitfield9 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 10, !.orderAcknowledgmentV2ReturnBitfield10 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 11, !.orderAcknowledgmentV2ReturnBitfield11 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 12, !.orderAcknowledgmentV2ReturnBitfield12 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 13, !.orderAcknowledgmentV2ReturnBitfield13 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 14, !.orderAcknowledgmentV2ReturnBitfield14 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 15, !.orderAcknowledgmentV2ReturnBitfield15 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 16, !.orderAcknowledgmentV2ReturnBitfield16 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 17, !.orderAcknowledgmentV2ReturnBitfield17 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 18, !.orderAcknowledgmentV2ReturnBitfield18 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 19, !.orderAcknowledgmentV2ReturnBitfield19 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 1, !.orderAcknowledgmentV2ReturnBitfield1 = <<1>>, !.side = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 1, !.orderAcknowledgmentV2ReturnBitfield1 = <<4>>, !.price = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 1, !.orderAcknowledgmentV2ReturnBitfield1 = <<16>>, !.ordType = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 1, !.orderAcknowledgmentV2ReturnBitfield1 = <<32>>, !.timeInForce = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 1, !.orderAcknowledgmentV2ReturnBitfield1 = <<64>>, !.minQty = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 2, !.orderAcknowledgmentV2ReturnBitfield2 = <<1>>, !.symbolLong = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 2, !.orderAcknowledgmentV2ReturnBitfield2 = <<8>>, !.idSource = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 2, !.orderAcknowledgmentV2ReturnBitfield2 = <<16>>, !.securityId = one]) : one \in { <<held>> : held \in Sample(16) } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 2, !.orderAcknowledgmentV2ReturnBitfield2 = <<64>>, !.capacity = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 3, !.orderAcknowledgmentV2ReturnBitfield3 = <<1>>, !.account = one]) : one \in { <<held>> : held \in Sample(16) } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 3, !.orderAcknowledgmentV2ReturnBitfield3 = <<2>>, !.clearingFirm = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 3, !.orderAcknowledgmentV2ReturnBitfield3 = <<4>>, !.clearingAccount = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 3, !.orderAcknowledgmentV2ReturnBitfield3 = <<8>>, !.displayIndicator = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 3, !.orderAcknowledgmentV2ReturnBitfield3 = <<64>>, !.orderQty = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 3, !.orderAcknowledgmentV2ReturnBitfield3 = <<128>>, !.preventMatch = one]) : one \in { <<held>> : held \in Sample(3) } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 4, !.orderAcknowledgmentV2ReturnBitfield4 = <<8>>, !.openClose = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 5, !.orderAcknowledgmentV2ReturnBitfield5 = <<1>>, !.origClOrdId = one]) : one \in { <<held>> : held \in Sample(20) } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 5, !.orderAcknowledgmentV2ReturnBitfield5 = <<2>>, !.leavesQty = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 5, !.orderAcknowledgmentV2ReturnBitfield5 = <<4>>, !.lastShares = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 5, !.orderAcknowledgmentV2ReturnBitfield5 = <<8>>, !.lastPx = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 5, !.orderAcknowledgmentV2ReturnBitfield5 = <<16>>, !.displayPrice = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 5, !.orderAcknowledgmentV2ReturnBitfield5 = <<32>>, !.workingPrice = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 5, !.orderAcknowledgmentV2ReturnBitfield5 = <<64>>, !.baseLiquidityIndicator = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 5, !.orderAcknowledgmentV2ReturnBitfield5 = <<128>>, !.expireTime = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 6, !.orderAcknowledgmentV2ReturnBitfield6 = <<1>>, !.secondaryOrderId = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 6, !.orderAcknowledgmentV2ReturnBitfield6 = <<16>>, !.extExecInst = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 7, !.orderAcknowledgmentV2ReturnBitfield7 = <<1>>, !.subLiquidityIndicator = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 8, !.orderAcknowledgmentV2ReturnBitfield8 = <<4>>, !.stopPx = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 8, !.orderAcknowledgmentV2ReturnBitfield8 = <<8>>, !.routingInst = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 9, !.orderAcknowledgmentV2ReturnBitfield9 = <<4>>, !.auctionId = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 9, !.orderAcknowledgmentV2ReturnBitfield9 = <<16>>, !.liquidityProvision = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 10, !.orderAcknowledgmentV2ReturnBitfield10 = <<128>>, !.clientQualifiedRole = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 11, !.orderAcknowledgmentV2ReturnBitfield11 = <<1>>, !.clientId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 11, !.orderAcknowledgmentV2ReturnBitfield11 = <<2>>, !.investorId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 11, !.orderAcknowledgmentV2ReturnBitfield11 = <<4>>, !.executorId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 11, !.orderAcknowledgmentV2ReturnBitfield11 = <<8>>, !.orderOrigination = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 11, !.orderAcknowledgmentV2ReturnBitfield11 = <<16>>, !.algorithmicIndicator = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 11, !.orderAcknowledgmentV2ReturnBitfield11 = <<64>>, !.investorQualifiedRole = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 11, !.orderAcknowledgmentV2ReturnBitfield11 = <<128>>, !.executorQualifiedRole = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 13, !.orderAcknowledgmentV2ReturnBitfield13 = <<64>>, !.drillThruProtection = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 17, !.orderAcknowledgmentV2ReturnBitfield17 = <<128>>, !.custOrderHandlingInst = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleOrderAcknowledgmentV2Message([ZeroOrderAcknowledgmentV2Message EXCEPT !.numberOfReturnBitfields = 18, !.orderAcknowledgmentV2ReturnBitfield18 = <<1>>, !.accountType = one]) : one \in { <<held>> : held \in Sample(1) } }

(***************************************************************************)
(* Cross Order Acknowledgment Order Allocations                            *)
(***************************************************************************)

CrossOrderAcknowledgmentOrderAllocations ==
    [ clOrdId               : Sample(20),
      orderId               : Sample(8),
      side                  : { << >> } \cup { <<held>> : held \in Sample(1) },
      allocQty              : { << >> } \cup { <<held>> : held \in Sample(4) },
      capacity              : { << >> } \cup { <<held>> : held \in Sample(1) },
      openClose             : { << >> } \cup { <<held>> : held \in Sample(1) },
      account               : { << >> } \cup { <<held>> : held \in Sample(16) },
      clearingAccount       : { << >> } \cup { <<held>> : held \in Sample(4) },
      clearingFirm          : { << >> } \cup { <<held>> : held \in Sample(4) },
      custOrderHandlingInst : { << >> } \cup { <<held>> : held \in Sample(1) },
      accountType           : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderOrigination      : { << >> } \cup { <<held>> : held \in Sample(1) },
      algorithmicIndicator  : { << >> } \cup { <<held>> : held \in Sample(1) },
      clientId              : { << >> } \cup { <<held>> : held \in Sample(4) },
      clientQualifiedRole   : { << >> } \cup { <<held>> : held \in Sample(1) },
      investorId            : { << >> } \cup { <<held>> : held \in Sample(4) },
      investorQualifiedRole : { << >> } \cup { <<held>> : held \in Sample(1) },
      executorId            : { << >> } \cup { <<held>> : held \in Sample(4) },
      executorQualifiedRole : { << >> } \cup { <<held>> : held \in Sample(1) } ]

EncodeCrossOrderAcknowledgmentOrderAllocations(message) ==
    message.clOrdId
        \o message.orderId
        \o (IF message.side = << >> THEN << >> ELSE message.side[1])
        \o (IF message.allocQty = << >> THEN << >> ELSE message.allocQty[1])
        \o (IF message.capacity = << >> THEN << >> ELSE message.capacity[1])
        \o (IF message.openClose = << >> THEN << >> ELSE message.openClose[1])
        \o (IF message.account = << >> THEN << >> ELSE message.account[1])
        \o (IF message.clearingAccount = << >> THEN << >> ELSE message.clearingAccount[1])
        \o (IF message.clearingFirm = << >> THEN << >> ELSE message.clearingFirm[1])
        \o (IF message.custOrderHandlingInst = << >> THEN << >> ELSE message.custOrderHandlingInst[1])
        \o (IF message.accountType = << >> THEN << >> ELSE message.accountType[1])
        \o (IF message.orderOrigination = << >> THEN << >> ELSE message.orderOrigination[1])
        \o (IF message.algorithmicIndicator = << >> THEN << >> ELSE message.algorithmicIndicator[1])
        \o (IF message.clientId = << >> THEN << >> ELSE message.clientId[1])
        \o (IF message.clientQualifiedRole = << >> THEN << >> ELSE message.clientQualifiedRole[1])
        \o (IF message.investorId = << >> THEN << >> ELSE message.investorId[1])
        \o (IF message.investorQualifiedRole = << >> THEN << >> ELSE message.investorQualifiedRole[1])
        \o (IF message.executorId = << >> THEN << >> ELSE message.executorId[1])
        \o (IF message.executorQualifiedRole = << >> THEN << >> ELSE message.executorQualifiedRole[1])

DecodeCrossOrderAcknowledgmentOrderAllocations(bytes, handedNumberOfReturnBitfields, handedCrossOrderAcknowledgmentReturnBitfield1, handedCrossOrderAcknowledgmentReturnBitfield2, handedCrossOrderAcknowledgmentReturnBitfield3, handedCrossOrderAcknowledgmentReturnBitfield4, handedCrossOrderAcknowledgmentReturnBitfield10, handedCrossOrderAcknowledgmentReturnBitfield11, handedCrossOrderAcknowledgmentReturnBitfield17, handedCrossOrderAcknowledgmentReturnBitfield18) ==
    LET clOrdId == ReadBytes(bytes, 20) IN IF ~clOrdId.ok THEN Fail ELSE
    LET orderId == ReadBytes(clOrdId.rest, 8) IN IF ~orderId.ok THEN Fail ELSE
    LET side == ReadWhen(handedNumberOfReturnBitfields >= 1 /\ (handedCrossOrderAcknowledgmentReturnBitfield1 # << >> /\ handedCrossOrderAcknowledgmentReturnBitfield1[1] % 2 > 0), ReadBytes(orderId.rest, 1), orderId.rest) IN IF ~side.ok THEN Fail ELSE
    LET allocQty == ReadWhen(handedNumberOfReturnBitfields >= 10 /\ (handedCrossOrderAcknowledgmentReturnBitfield10 # << >> /\ (handedCrossOrderAcknowledgmentReturnBitfield10[1] \div 2) % 2 > 0), ReadBytes(side.rest, 4), side.rest) IN IF ~allocQty.ok THEN Fail ELSE
    LET capacity == ReadWhen(handedNumberOfReturnBitfields >= 2 /\ (handedCrossOrderAcknowledgmentReturnBitfield2 # << >> /\ (handedCrossOrderAcknowledgmentReturnBitfield2[1] \div 64) % 2 > 0), ReadBytes(allocQty.rest, 1), allocQty.rest) IN IF ~capacity.ok THEN Fail ELSE
    LET openClose == ReadWhen(handedNumberOfReturnBitfields >= 4 /\ (handedCrossOrderAcknowledgmentReturnBitfield4 # << >> /\ (handedCrossOrderAcknowledgmentReturnBitfield4[1] \div 8) % 2 > 0), ReadBytes(capacity.rest, 1), capacity.rest) IN IF ~openClose.ok THEN Fail ELSE
    LET account == ReadWhen(handedNumberOfReturnBitfields >= 3 /\ (handedCrossOrderAcknowledgmentReturnBitfield3 # << >> /\ handedCrossOrderAcknowledgmentReturnBitfield3[1] % 2 > 0), ReadBytes(openClose.rest, 16), openClose.rest) IN IF ~account.ok THEN Fail ELSE
    LET clearingAccount == ReadWhen(handedNumberOfReturnBitfields >= 3 /\ (handedCrossOrderAcknowledgmentReturnBitfield3 # << >> /\ (handedCrossOrderAcknowledgmentReturnBitfield3[1] \div 4) % 2 > 0), ReadBytes(account.rest, 4), account.rest) IN IF ~clearingAccount.ok THEN Fail ELSE
    LET clearingFirm == ReadWhen(handedNumberOfReturnBitfields >= 3 /\ (handedCrossOrderAcknowledgmentReturnBitfield3 # << >> /\ (handedCrossOrderAcknowledgmentReturnBitfield3[1] \div 2) % 2 > 0), ReadBytes(clearingAccount.rest, 4), clearingAccount.rest) IN IF ~clearingFirm.ok THEN Fail ELSE
    LET custOrderHandlingInst == ReadWhen(handedNumberOfReturnBitfields >= 17 /\ (handedCrossOrderAcknowledgmentReturnBitfield17 # << >> /\ (handedCrossOrderAcknowledgmentReturnBitfield17[1] \div 128) % 2 > 0), ReadBytes(clearingFirm.rest, 1), clearingFirm.rest) IN IF ~custOrderHandlingInst.ok THEN Fail ELSE
    LET accountType == ReadWhen(handedNumberOfReturnBitfields >= 18 /\ (handedCrossOrderAcknowledgmentReturnBitfield18 # << >> /\ handedCrossOrderAcknowledgmentReturnBitfield18[1] % 2 > 0), ReadBytes(custOrderHandlingInst.rest, 1), custOrderHandlingInst.rest) IN IF ~accountType.ok THEN Fail ELSE
    LET orderOrigination == ReadWhen(handedNumberOfReturnBitfields >= 11 /\ (handedCrossOrderAcknowledgmentReturnBitfield11 # << >> /\ (handedCrossOrderAcknowledgmentReturnBitfield11[1] \div 8) % 2 > 0), ReadBytes(accountType.rest, 1), accountType.rest) IN IF ~orderOrigination.ok THEN Fail ELSE
    LET algorithmicIndicator == ReadWhen(handedNumberOfReturnBitfields >= 11 /\ (handedCrossOrderAcknowledgmentReturnBitfield11 # << >> /\ (handedCrossOrderAcknowledgmentReturnBitfield11[1] \div 16) % 2 > 0), ReadBytes(orderOrigination.rest, 1), orderOrigination.rest) IN IF ~algorithmicIndicator.ok THEN Fail ELSE
    LET clientId == ReadWhen(handedNumberOfReturnBitfields >= 11 /\ (handedCrossOrderAcknowledgmentReturnBitfield11 # << >> /\ handedCrossOrderAcknowledgmentReturnBitfield11[1] % 2 > 0), ReadBytes(algorithmicIndicator.rest, 4), algorithmicIndicator.rest) IN IF ~clientId.ok THEN Fail ELSE
    LET clientQualifiedRole == ReadWhen(handedNumberOfReturnBitfields >= 10 /\ (handedCrossOrderAcknowledgmentReturnBitfield10 # << >> /\ (handedCrossOrderAcknowledgmentReturnBitfield10[1] \div 128) % 2 > 0), ReadBytes(clientId.rest, 1), clientId.rest) IN IF ~clientQualifiedRole.ok THEN Fail ELSE
    LET investorId == ReadWhen(handedNumberOfReturnBitfields >= 11 /\ (handedCrossOrderAcknowledgmentReturnBitfield11 # << >> /\ (handedCrossOrderAcknowledgmentReturnBitfield11[1] \div 2) % 2 > 0), ReadBytes(clientQualifiedRole.rest, 4), clientQualifiedRole.rest) IN IF ~investorId.ok THEN Fail ELSE
    LET investorQualifiedRole == ReadWhen(handedNumberOfReturnBitfields >= 11 /\ (handedCrossOrderAcknowledgmentReturnBitfield11 # << >> /\ (handedCrossOrderAcknowledgmentReturnBitfield11[1] \div 64) % 2 > 0), ReadBytes(investorId.rest, 1), investorId.rest) IN IF ~investorQualifiedRole.ok THEN Fail ELSE
    LET executorId == ReadWhen(handedNumberOfReturnBitfields >= 11 /\ (handedCrossOrderAcknowledgmentReturnBitfield11 # << >> /\ (handedCrossOrderAcknowledgmentReturnBitfield11[1] \div 4) % 2 > 0), ReadBytes(investorQualifiedRole.rest, 4), investorQualifiedRole.rest) IN IF ~executorId.ok THEN Fail ELSE
    LET executorQualifiedRole == ReadWhen(handedNumberOfReturnBitfields >= 11 /\ (handedCrossOrderAcknowledgmentReturnBitfield11 # << >> /\ (handedCrossOrderAcknowledgmentReturnBitfield11[1] \div 128) % 2 > 0), ReadBytes(executorId.rest, 1), executorId.rest) IN IF ~executorQualifiedRole.ok THEN Fail ELSE
    Ok([ clOrdId               |-> clOrdId.value,
         orderId               |-> orderId.value,
         side                  |-> side.value,
         allocQty              |-> allocQty.value,
         capacity              |-> capacity.value,
         openClose             |-> openClose.value,
         account               |-> account.value,
         clearingAccount       |-> clearingAccount.value,
         clearingFirm          |-> clearingFirm.value,
         custOrderHandlingInst |-> custOrderHandlingInst.value,
         accountType           |-> accountType.value,
         orderOrigination      |-> orderOrigination.value,
         algorithmicIndicator  |-> algorithmicIndicator.value,
         clientId              |-> clientId.value,
         clientQualifiedRole   |-> clientQualifiedRole.value,
         investorId            |-> investorId.value,
         investorQualifiedRole |-> investorQualifiedRole.value,
         executorId            |-> executorId.value,
         executorQualifiedRole |-> executorQualifiedRole.value ], executorQualifiedRole.rest)

(* Cross Order Acknowledgment Order Allocations with each field marked present by fields before it there exactly where they say *)
SettleCrossOrderAcknowledgmentOrderAllocations(message, handedNumberOfReturnBitfields, handedCrossOrderAcknowledgmentReturnBitfield1, handedCrossOrderAcknowledgmentReturnBitfield2, handedCrossOrderAcknowledgmentReturnBitfield3, handedCrossOrderAcknowledgmentReturnBitfield4, handedCrossOrderAcknowledgmentReturnBitfield10, handedCrossOrderAcknowledgmentReturnBitfield11, handedCrossOrderAcknowledgmentReturnBitfield17, handedCrossOrderAcknowledgmentReturnBitfield18) ==
    LET settled1 == [message EXCEPT !.side = IF handedNumberOfReturnBitfields >= 1 /\ (handedCrossOrderAcknowledgmentReturnBitfield1 # << >> /\ handedCrossOrderAcknowledgmentReturnBitfield1[1] % 2 > 0) THEN (IF message.side = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE message.side) ELSE << >>]
        settled2 == [settled1 EXCEPT !.allocQty = IF handedNumberOfReturnBitfields >= 10 /\ (handedCrossOrderAcknowledgmentReturnBitfield10 # << >> /\ (handedCrossOrderAcknowledgmentReturnBitfield10[1] \div 2) % 2 > 0) THEN (IF settled1.allocQty = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled1.allocQty) ELSE << >>]
        settled3 == [settled2 EXCEPT !.capacity = IF handedNumberOfReturnBitfields >= 2 /\ (handedCrossOrderAcknowledgmentReturnBitfield2 # << >> /\ (handedCrossOrderAcknowledgmentReturnBitfield2[1] \div 64) % 2 > 0) THEN (IF settled2.capacity = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled2.capacity) ELSE << >>]
        settled4 == [settled3 EXCEPT !.openClose = IF handedNumberOfReturnBitfields >= 4 /\ (handedCrossOrderAcknowledgmentReturnBitfield4 # << >> /\ (handedCrossOrderAcknowledgmentReturnBitfield4[1] \div 8) % 2 > 0) THEN (IF settled3.openClose = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled3.openClose) ELSE << >>]
        settled5 == [settled4 EXCEPT !.account = IF handedNumberOfReturnBitfields >= 3 /\ (handedCrossOrderAcknowledgmentReturnBitfield3 # << >> /\ handedCrossOrderAcknowledgmentReturnBitfield3[1] % 2 > 0) THEN (IF settled4.account = << >> THEN <<[i \in 1 .. 16 |-> 0]>> ELSE settled4.account) ELSE << >>]
        settled6 == [settled5 EXCEPT !.clearingAccount = IF handedNumberOfReturnBitfields >= 3 /\ (handedCrossOrderAcknowledgmentReturnBitfield3 # << >> /\ (handedCrossOrderAcknowledgmentReturnBitfield3[1] \div 4) % 2 > 0) THEN (IF settled5.clearingAccount = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled5.clearingAccount) ELSE << >>]
        settled7 == [settled6 EXCEPT !.clearingFirm = IF handedNumberOfReturnBitfields >= 3 /\ (handedCrossOrderAcknowledgmentReturnBitfield3 # << >> /\ (handedCrossOrderAcknowledgmentReturnBitfield3[1] \div 2) % 2 > 0) THEN (IF settled6.clearingFirm = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled6.clearingFirm) ELSE << >>]
        settled8 == [settled7 EXCEPT !.custOrderHandlingInst = IF handedNumberOfReturnBitfields >= 17 /\ (handedCrossOrderAcknowledgmentReturnBitfield17 # << >> /\ (handedCrossOrderAcknowledgmentReturnBitfield17[1] \div 128) % 2 > 0) THEN (IF settled7.custOrderHandlingInst = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled7.custOrderHandlingInst) ELSE << >>]
        settled9 == [settled8 EXCEPT !.accountType = IF handedNumberOfReturnBitfields >= 18 /\ (handedCrossOrderAcknowledgmentReturnBitfield18 # << >> /\ handedCrossOrderAcknowledgmentReturnBitfield18[1] % 2 > 0) THEN (IF settled8.accountType = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled8.accountType) ELSE << >>]
        settled10 == [settled9 EXCEPT !.orderOrigination = IF handedNumberOfReturnBitfields >= 11 /\ (handedCrossOrderAcknowledgmentReturnBitfield11 # << >> /\ (handedCrossOrderAcknowledgmentReturnBitfield11[1] \div 8) % 2 > 0) THEN (IF settled9.orderOrigination = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled9.orderOrigination) ELSE << >>]
        settled11 == [settled10 EXCEPT !.algorithmicIndicator = IF handedNumberOfReturnBitfields >= 11 /\ (handedCrossOrderAcknowledgmentReturnBitfield11 # << >> /\ (handedCrossOrderAcknowledgmentReturnBitfield11[1] \div 16) % 2 > 0) THEN (IF settled10.algorithmicIndicator = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled10.algorithmicIndicator) ELSE << >>]
        settled12 == [settled11 EXCEPT !.clientId = IF handedNumberOfReturnBitfields >= 11 /\ (handedCrossOrderAcknowledgmentReturnBitfield11 # << >> /\ handedCrossOrderAcknowledgmentReturnBitfield11[1] % 2 > 0) THEN (IF settled11.clientId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled11.clientId) ELSE << >>]
        settled13 == [settled12 EXCEPT !.clientQualifiedRole = IF handedNumberOfReturnBitfields >= 10 /\ (handedCrossOrderAcknowledgmentReturnBitfield10 # << >> /\ (handedCrossOrderAcknowledgmentReturnBitfield10[1] \div 128) % 2 > 0) THEN (IF settled12.clientQualifiedRole = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled12.clientQualifiedRole) ELSE << >>]
        settled14 == [settled13 EXCEPT !.investorId = IF handedNumberOfReturnBitfields >= 11 /\ (handedCrossOrderAcknowledgmentReturnBitfield11 # << >> /\ (handedCrossOrderAcknowledgmentReturnBitfield11[1] \div 2) % 2 > 0) THEN (IF settled13.investorId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled13.investorId) ELSE << >>]
        settled15 == [settled14 EXCEPT !.investorQualifiedRole = IF handedNumberOfReturnBitfields >= 11 /\ (handedCrossOrderAcknowledgmentReturnBitfield11 # << >> /\ (handedCrossOrderAcknowledgmentReturnBitfield11[1] \div 64) % 2 > 0) THEN (IF settled14.investorQualifiedRole = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled14.investorQualifiedRole) ELSE << >>]
        settled16 == [settled15 EXCEPT !.executorId = IF handedNumberOfReturnBitfields >= 11 /\ (handedCrossOrderAcknowledgmentReturnBitfield11 # << >> /\ (handedCrossOrderAcknowledgmentReturnBitfield11[1] \div 4) % 2 > 0) THEN (IF settled15.executorId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled15.executorId) ELSE << >>]
        settled17 == [settled16 EXCEPT !.executorQualifiedRole = IF handedNumberOfReturnBitfields >= 11 /\ (handedCrossOrderAcknowledgmentReturnBitfield11 # << >> /\ (handedCrossOrderAcknowledgmentReturnBitfield11[1] \div 128) % 2 > 0) THEN (IF settled16.executorQualifiedRole = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled16.executorQualifiedRole) ELSE << >>]
    IN  settled17

ZeroCrossOrderAcknowledgmentOrderAllocations ==
    SettleCrossOrderAcknowledgmentOrderAllocations([ clOrdId               |-> [i \in 1 .. 20 |-> 0],
                                                     orderId               |-> [i \in 1 .. 8 |-> 0],
                                                     side                  |-> << >>,
                                                     allocQty              |-> << >>,
                                                     capacity              |-> << >>,
                                                     openClose             |-> << >>,
                                                     account               |-> << >>,
                                                     clearingAccount       |-> << >>,
                                                     clearingFirm          |-> << >>,
                                                     custOrderHandlingInst |-> << >>,
                                                     accountType           |-> << >>,
                                                     orderOrigination      |-> << >>,
                                                     algorithmicIndicator  |-> << >>,
                                                     clientId              |-> << >>,
                                                     clientQualifiedRole   |-> << >>,
                                                     investorId            |-> << >>,
                                                     investorQualifiedRole |-> << >>,
                                                     executorId            |-> << >>,
                                                     executorQualifiedRole |-> << >> ], 0, << >>, << >>, << >>, << >>, << >>, << >>, << >>, << >>)

(* Cross Order Acknowledgment Order Allocations at zero, then each field in turn at the values it is checked at *)
CheckedCrossOrderAcknowledgmentOrderAllocations ==
    { [given |-> <<0, << >>, << >>, << >>, << >>, << >>, << >>, << >>, << >>>>, message |-> ZeroCrossOrderAcknowledgmentOrderAllocations] }
        \cup { [given |-> <<0, << >>, << >>, << >>, << >>, << >>, << >>, << >>, << >>>>, message |-> SettleCrossOrderAcknowledgmentOrderAllocations([ZeroCrossOrderAcknowledgmentOrderAllocations EXCEPT !.clOrdId = one], 0, << >>, << >>, << >>, << >>, << >>, << >>, << >>, << >>)] : one \in Sample(20) }
        \cup { [given |-> <<0, << >>, << >>, << >>, << >>, << >>, << >>, << >>, << >>>>, message |-> SettleCrossOrderAcknowledgmentOrderAllocations([ZeroCrossOrderAcknowledgmentOrderAllocations EXCEPT !.orderId = one], 0, << >>, << >>, << >>, << >>, << >>, << >>, << >>, << >>)] : one \in Sample(8) }
        \cup { [given |-> <<1, <<1>>, << >>, << >>, << >>, << >>, << >>, << >>, << >>>>, message |-> SettleCrossOrderAcknowledgmentOrderAllocations([ZeroCrossOrderAcknowledgmentOrderAllocations EXCEPT !.side = one], 1, <<1>>, << >>, << >>, << >>, << >>, << >>, << >>, << >>)] : one \in { <<held>> : held \in Sample(1) } }
        \cup { [given |-> <<10, << >>, << >>, << >>, << >>, <<2>>, << >>, << >>, << >>>>, message |-> SettleCrossOrderAcknowledgmentOrderAllocations([ZeroCrossOrderAcknowledgmentOrderAllocations EXCEPT !.allocQty = one], 10, << >>, << >>, << >>, << >>, <<2>>, << >>, << >>, << >>)] : one \in { <<held>> : held \in Sample(4) } }
        \cup { [given |-> <<2, << >>, <<64>>, << >>, << >>, << >>, << >>, << >>, << >>>>, message |-> SettleCrossOrderAcknowledgmentOrderAllocations([ZeroCrossOrderAcknowledgmentOrderAllocations EXCEPT !.capacity = one], 2, << >>, <<64>>, << >>, << >>, << >>, << >>, << >>, << >>)] : one \in { <<held>> : held \in Sample(1) } }
        \cup { [given |-> <<4, << >>, << >>, << >>, <<8>>, << >>, << >>, << >>, << >>>>, message |-> SettleCrossOrderAcknowledgmentOrderAllocations([ZeroCrossOrderAcknowledgmentOrderAllocations EXCEPT !.openClose = one], 4, << >>, << >>, << >>, <<8>>, << >>, << >>, << >>, << >>)] : one \in { <<held>> : held \in Sample(1) } }
        \cup { [given |-> <<3, << >>, << >>, <<1>>, << >>, << >>, << >>, << >>, << >>>>, message |-> SettleCrossOrderAcknowledgmentOrderAllocations([ZeroCrossOrderAcknowledgmentOrderAllocations EXCEPT !.account = one], 3, << >>, << >>, <<1>>, << >>, << >>, << >>, << >>, << >>)] : one \in { <<held>> : held \in Sample(16) } }
        \cup { [given |-> <<3, << >>, << >>, <<4>>, << >>, << >>, << >>, << >>, << >>>>, message |-> SettleCrossOrderAcknowledgmentOrderAllocations([ZeroCrossOrderAcknowledgmentOrderAllocations EXCEPT !.clearingAccount = one], 3, << >>, << >>, <<4>>, << >>, << >>, << >>, << >>, << >>)] : one \in { <<held>> : held \in Sample(4) } }
        \cup { [given |-> <<3, << >>, << >>, <<2>>, << >>, << >>, << >>, << >>, << >>>>, message |-> SettleCrossOrderAcknowledgmentOrderAllocations([ZeroCrossOrderAcknowledgmentOrderAllocations EXCEPT !.clearingFirm = one], 3, << >>, << >>, <<2>>, << >>, << >>, << >>, << >>, << >>)] : one \in { <<held>> : held \in Sample(4) } }
        \cup { [given |-> <<17, << >>, << >>, << >>, << >>, << >>, << >>, <<128>>, << >>>>, message |-> SettleCrossOrderAcknowledgmentOrderAllocations([ZeroCrossOrderAcknowledgmentOrderAllocations EXCEPT !.custOrderHandlingInst = one], 17, << >>, << >>, << >>, << >>, << >>, << >>, <<128>>, << >>)] : one \in { <<held>> : held \in Sample(1) } }
        \cup { [given |-> <<18, << >>, << >>, << >>, << >>, << >>, << >>, << >>, <<1>>>>, message |-> SettleCrossOrderAcknowledgmentOrderAllocations([ZeroCrossOrderAcknowledgmentOrderAllocations EXCEPT !.accountType = one], 18, << >>, << >>, << >>, << >>, << >>, << >>, << >>, <<1>>)] : one \in { <<held>> : held \in Sample(1) } }
        \cup { [given |-> <<11, << >>, << >>, << >>, << >>, << >>, <<8>>, << >>, << >>>>, message |-> SettleCrossOrderAcknowledgmentOrderAllocations([ZeroCrossOrderAcknowledgmentOrderAllocations EXCEPT !.orderOrigination = one], 11, << >>, << >>, << >>, << >>, << >>, <<8>>, << >>, << >>)] : one \in { <<held>> : held \in Sample(1) } }
        \cup { [given |-> <<11, << >>, << >>, << >>, << >>, << >>, <<16>>, << >>, << >>>>, message |-> SettleCrossOrderAcknowledgmentOrderAllocations([ZeroCrossOrderAcknowledgmentOrderAllocations EXCEPT !.algorithmicIndicator = one], 11, << >>, << >>, << >>, << >>, << >>, <<16>>, << >>, << >>)] : one \in { <<held>> : held \in Sample(1) } }
        \cup { [given |-> <<11, << >>, << >>, << >>, << >>, << >>, <<1>>, << >>, << >>>>, message |-> SettleCrossOrderAcknowledgmentOrderAllocations([ZeroCrossOrderAcknowledgmentOrderAllocations EXCEPT !.clientId = one], 11, << >>, << >>, << >>, << >>, << >>, <<1>>, << >>, << >>)] : one \in { <<held>> : held \in Sample(4) } }
        \cup { [given |-> <<10, << >>, << >>, << >>, << >>, <<128>>, << >>, << >>, << >>>>, message |-> SettleCrossOrderAcknowledgmentOrderAllocations([ZeroCrossOrderAcknowledgmentOrderAllocations EXCEPT !.clientQualifiedRole = one], 10, << >>, << >>, << >>, << >>, <<128>>, << >>, << >>, << >>)] : one \in { <<held>> : held \in Sample(1) } }
        \cup { [given |-> <<11, << >>, << >>, << >>, << >>, << >>, <<2>>, << >>, << >>>>, message |-> SettleCrossOrderAcknowledgmentOrderAllocations([ZeroCrossOrderAcknowledgmentOrderAllocations EXCEPT !.investorId = one], 11, << >>, << >>, << >>, << >>, << >>, <<2>>, << >>, << >>)] : one \in { <<held>> : held \in Sample(4) } }
        \cup { [given |-> <<11, << >>, << >>, << >>, << >>, << >>, <<64>>, << >>, << >>>>, message |-> SettleCrossOrderAcknowledgmentOrderAllocations([ZeroCrossOrderAcknowledgmentOrderAllocations EXCEPT !.investorQualifiedRole = one], 11, << >>, << >>, << >>, << >>, << >>, <<64>>, << >>, << >>)] : one \in { <<held>> : held \in Sample(1) } }
        \cup { [given |-> <<11, << >>, << >>, << >>, << >>, << >>, <<4>>, << >>, << >>>>, message |-> SettleCrossOrderAcknowledgmentOrderAllocations([ZeroCrossOrderAcknowledgmentOrderAllocations EXCEPT !.executorId = one], 11, << >>, << >>, << >>, << >>, << >>, <<4>>, << >>, << >>)] : one \in { <<held>> : held \in Sample(4) } }
        \cup { [given |-> <<11, << >>, << >>, << >>, << >>, << >>, <<128>>, << >>, << >>>>, message |-> SettleCrossOrderAcknowledgmentOrderAllocations([ZeroCrossOrderAcknowledgmentOrderAllocations EXCEPT !.executorQualifiedRole = one], 11, << >>, << >>, << >>, << >>, << >>, <<128>>, << >>, << >>)] : one \in { <<held>> : held \in Sample(1) } }

(* A run of Cross Order Acknowledgment Order Allocations, written one after another *)
RECURSIVE EncodeCrossOrderAcknowledgmentOrderAllocationsList(_)
EncodeCrossOrderAcknowledgmentOrderAllocationsList(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeCrossOrderAcknowledgmentOrderAllocations(Head(messages)) \o EncodeCrossOrderAcknowledgmentOrderAllocationsList(Tail(messages))

(* As many Cross Order Acknowledgment Order Allocations as the field that counts them says *)
RECURSIVE ReadCrossOrderAcknowledgmentOrderAllocationsList(_, _, _, _, _, _, _, _, _, _, _)
ReadCrossOrderAcknowledgmentOrderAllocationsList(bytes, count, handedNumberOfReturnBitfields, handedCrossOrderAcknowledgmentReturnBitfield1, handedCrossOrderAcknowledgmentReturnBitfield2, handedCrossOrderAcknowledgmentReturnBitfield3, handedCrossOrderAcknowledgmentReturnBitfield4, handedCrossOrderAcknowledgmentReturnBitfield10, handedCrossOrderAcknowledgmentReturnBitfield11, handedCrossOrderAcknowledgmentReturnBitfield17, handedCrossOrderAcknowledgmentReturnBitfield18) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeCrossOrderAcknowledgmentOrderAllocations(bytes, handedNumberOfReturnBitfields, handedCrossOrderAcknowledgmentReturnBitfield1, handedCrossOrderAcknowledgmentReturnBitfield2, handedCrossOrderAcknowledgmentReturnBitfield3, handedCrossOrderAcknowledgmentReturnBitfield4, handedCrossOrderAcknowledgmentReturnBitfield10, handedCrossOrderAcknowledgmentReturnBitfield11, handedCrossOrderAcknowledgmentReturnBitfield17, handedCrossOrderAcknowledgmentReturnBitfield18)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadCrossOrderAcknowledgmentOrderAllocationsList(one.rest, count - 1, handedNumberOfReturnBitfields, handedCrossOrderAcknowledgmentReturnBitfield1, handedCrossOrderAcknowledgmentReturnBitfield2, handedCrossOrderAcknowledgmentReturnBitfield3, handedCrossOrderAcknowledgmentReturnBitfield4, handedCrossOrderAcknowledgmentReturnBitfield10, handedCrossOrderAcknowledgmentReturnBitfield11, handedCrossOrderAcknowledgmentReturnBitfield17, handedCrossOrderAcknowledgmentReturnBitfield18)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Cross Order Acknowledgment Order Allocations of each kind, for the lists that carry them *)
OneCrossOrderAcknowledgmentOrderAllocations == { ZeroCrossOrderAcknowledgmentOrderAllocations }

(***************************************************************************)
(* Cross Order Acknowledgment Message                                      *)
(***************************************************************************)

CrossOrderAcknowledgmentMessage ==
    [ transactionTime                          : Sample(8),
      crossId                                  : Sample(20),
      auctionId                                : Sample(8),
      reserved1                                : Sample(1),
      numberOfReturnBitfields                  : 0 .. 255,
      crossOrderAcknowledgmentReturnBitfield1  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderAcknowledgmentReturnBitfield2  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderAcknowledgmentReturnBitfield3  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderAcknowledgmentReturnBitfield4  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderAcknowledgmentReturnBitfield5  : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderAcknowledgmentReturnBitfield6  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderAcknowledgmentReturnBitfield7  : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderAcknowledgmentReturnBitfield8  : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderAcknowledgmentReturnBitfield9  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderAcknowledgmentReturnBitfield10 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderAcknowledgmentReturnBitfield11 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderAcknowledgmentReturnBitfield12 : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderAcknowledgmentReturnBitfield13 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderAcknowledgmentReturnBitfield14 : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderAcknowledgmentReturnBitfield15 : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderAcknowledgmentReturnBitfield16 : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderAcknowledgmentReturnBitfield17 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderAcknowledgmentReturnBitfield18 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      crossOrderAcknowledgmentReturnBitfield19 : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossOrderAcknowledgmentOrderAllocations : SampleLists(OneCrossOrderAcknowledgmentOrderAllocations),
      price                                    : { << >> } \cup { <<held>> : held \in Sample(8) },
      symbolLong                               : { << >> } \cup { <<held>> : held \in Sample(8) },
      idSource                                 : { << >> } \cup { <<held>> : held \in Sample(1) },
      securityId                               : { << >> } \cup { <<held>> : held \in Sample(16) },
      orderQty                                 : { << >> } \cup { <<held>> : held \in Sample(4) },
      preventMatch                             : { << >> } \cup { <<held>> : held \in Sample(3) },
      extExecInst                              : { << >> } \cup { <<held>> : held \in Sample(1) },
      liquidityProvision                       : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossType                                : { << >> } \cup { <<held>> : held \in Sample(1) },
      crossPrioritization                      : { << >> } \cup { <<held>> : held \in Sample(1) },
      routingFirmId                            : { << >> } \cup { <<held>> : held \in Sample(4) },
      drillThruProtection                      : { << >> } \cup { <<held>> : held \in Sample(8) } ]

EncodeCrossOrderAcknowledgmentMessage(message) ==
    message.transactionTime
        \o message.crossId
        \o message.auctionId
        \o message.reserved1
        \o EncodeUIntBE(message.numberOfReturnBitfields, 1)
        \o (IF message.crossOrderAcknowledgmentReturnBitfield1 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderAcknowledgmentReturnBitfield1[1], 1))
        \o (IF message.crossOrderAcknowledgmentReturnBitfield2 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderAcknowledgmentReturnBitfield2[1], 1))
        \o (IF message.crossOrderAcknowledgmentReturnBitfield3 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderAcknowledgmentReturnBitfield3[1], 1))
        \o (IF message.crossOrderAcknowledgmentReturnBitfield4 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderAcknowledgmentReturnBitfield4[1], 1))
        \o (IF message.crossOrderAcknowledgmentReturnBitfield5 = << >> THEN << >> ELSE message.crossOrderAcknowledgmentReturnBitfield5[1])
        \o (IF message.crossOrderAcknowledgmentReturnBitfield6 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderAcknowledgmentReturnBitfield6[1], 1))
        \o (IF message.crossOrderAcknowledgmentReturnBitfield7 = << >> THEN << >> ELSE message.crossOrderAcknowledgmentReturnBitfield7[1])
        \o (IF message.crossOrderAcknowledgmentReturnBitfield8 = << >> THEN << >> ELSE message.crossOrderAcknowledgmentReturnBitfield8[1])
        \o (IF message.crossOrderAcknowledgmentReturnBitfield9 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderAcknowledgmentReturnBitfield9[1], 1))
        \o (IF message.crossOrderAcknowledgmentReturnBitfield10 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderAcknowledgmentReturnBitfield10[1], 1))
        \o (IF message.crossOrderAcknowledgmentReturnBitfield11 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderAcknowledgmentReturnBitfield11[1], 1))
        \o (IF message.crossOrderAcknowledgmentReturnBitfield12 = << >> THEN << >> ELSE message.crossOrderAcknowledgmentReturnBitfield12[1])
        \o (IF message.crossOrderAcknowledgmentReturnBitfield13 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderAcknowledgmentReturnBitfield13[1], 1))
        \o (IF message.crossOrderAcknowledgmentReturnBitfield14 = << >> THEN << >> ELSE message.crossOrderAcknowledgmentReturnBitfield14[1])
        \o (IF message.crossOrderAcknowledgmentReturnBitfield15 = << >> THEN << >> ELSE message.crossOrderAcknowledgmentReturnBitfield15[1])
        \o (IF message.crossOrderAcknowledgmentReturnBitfield16 = << >> THEN << >> ELSE message.crossOrderAcknowledgmentReturnBitfield16[1])
        \o (IF message.crossOrderAcknowledgmentReturnBitfield17 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderAcknowledgmentReturnBitfield17[1], 1))
        \o (IF message.crossOrderAcknowledgmentReturnBitfield18 = << >> THEN << >> ELSE EncodeUIntLE(message.crossOrderAcknowledgmentReturnBitfield18[1], 1))
        \o (IF message.crossOrderAcknowledgmentReturnBitfield19 = << >> THEN << >> ELSE message.crossOrderAcknowledgmentReturnBitfield19[1])
        \o EncodeUIntLE(Len(message.crossOrderAcknowledgmentOrderAllocations), 2)
        \o EncodeCrossOrderAcknowledgmentOrderAllocationsList(message.crossOrderAcknowledgmentOrderAllocations)
        \o (IF message.price = << >> THEN << >> ELSE message.price[1])
        \o (IF message.symbolLong = << >> THEN << >> ELSE message.symbolLong[1])
        \o (IF message.idSource = << >> THEN << >> ELSE message.idSource[1])
        \o (IF message.securityId = << >> THEN << >> ELSE message.securityId[1])
        \o (IF message.orderQty = << >> THEN << >> ELSE message.orderQty[1])
        \o (IF message.preventMatch = << >> THEN << >> ELSE message.preventMatch[1])
        \o (IF message.extExecInst = << >> THEN << >> ELSE message.extExecInst[1])
        \o (IF message.liquidityProvision = << >> THEN << >> ELSE message.liquidityProvision[1])
        \o (IF message.crossType = << >> THEN << >> ELSE message.crossType[1])
        \o (IF message.crossPrioritization = << >> THEN << >> ELSE message.crossPrioritization[1])
        \o (IF message.routingFirmId = << >> THEN << >> ELSE message.routingFirmId[1])
        \o (IF message.drillThruProtection = << >> THEN << >> ELSE message.drillThruProtection[1])

DecodeCrossOrderAcknowledgmentMessage(bytes) ==
    LET transactionTime == ReadBytes(bytes, 8) IN IF ~transactionTime.ok THEN Fail ELSE
    LET crossId == ReadBytes(transactionTime.rest, 20) IN IF ~crossId.ok THEN Fail ELSE
    LET auctionId == ReadBytes(crossId.rest, 8) IN IF ~auctionId.ok THEN Fail ELSE
    LET reserved1 == ReadBytes(auctionId.rest, 1) IN IF ~reserved1.ok THEN Fail ELSE
    LET numberOfReturnBitfields == ReadUIntBE(reserved1.rest, 1) IN IF ~numberOfReturnBitfields.ok THEN Fail ELSE
    LET crossOrderAcknowledgmentReturnBitfield1 == ReadWhen(numberOfReturnBitfields.value >= 1, ReadUIntLE(numberOfReturnBitfields.rest, 1), numberOfReturnBitfields.rest) IN IF ~crossOrderAcknowledgmentReturnBitfield1.ok THEN Fail ELSE
    LET crossOrderAcknowledgmentReturnBitfield2 == ReadWhen(numberOfReturnBitfields.value >= 2, ReadUIntLE(crossOrderAcknowledgmentReturnBitfield1.rest, 1), crossOrderAcknowledgmentReturnBitfield1.rest) IN IF ~crossOrderAcknowledgmentReturnBitfield2.ok THEN Fail ELSE
    LET crossOrderAcknowledgmentReturnBitfield3 == ReadWhen(numberOfReturnBitfields.value >= 3, ReadUIntLE(crossOrderAcknowledgmentReturnBitfield2.rest, 1), crossOrderAcknowledgmentReturnBitfield2.rest) IN IF ~crossOrderAcknowledgmentReturnBitfield3.ok THEN Fail ELSE
    LET crossOrderAcknowledgmentReturnBitfield4 == ReadWhen(numberOfReturnBitfields.value >= 4, ReadUIntLE(crossOrderAcknowledgmentReturnBitfield3.rest, 1), crossOrderAcknowledgmentReturnBitfield3.rest) IN IF ~crossOrderAcknowledgmentReturnBitfield4.ok THEN Fail ELSE
    LET crossOrderAcknowledgmentReturnBitfield5 == ReadWhen(numberOfReturnBitfields.value >= 5, ReadBytes(crossOrderAcknowledgmentReturnBitfield4.rest, 1), crossOrderAcknowledgmentReturnBitfield4.rest) IN IF ~crossOrderAcknowledgmentReturnBitfield5.ok THEN Fail ELSE
    LET crossOrderAcknowledgmentReturnBitfield6 == ReadWhen(numberOfReturnBitfields.value >= 6, ReadUIntLE(crossOrderAcknowledgmentReturnBitfield5.rest, 1), crossOrderAcknowledgmentReturnBitfield5.rest) IN IF ~crossOrderAcknowledgmentReturnBitfield6.ok THEN Fail ELSE
    LET crossOrderAcknowledgmentReturnBitfield7 == ReadWhen(numberOfReturnBitfields.value >= 7, ReadBytes(crossOrderAcknowledgmentReturnBitfield6.rest, 1), crossOrderAcknowledgmentReturnBitfield6.rest) IN IF ~crossOrderAcknowledgmentReturnBitfield7.ok THEN Fail ELSE
    LET crossOrderAcknowledgmentReturnBitfield8 == ReadWhen(numberOfReturnBitfields.value >= 8, ReadBytes(crossOrderAcknowledgmentReturnBitfield7.rest, 1), crossOrderAcknowledgmentReturnBitfield7.rest) IN IF ~crossOrderAcknowledgmentReturnBitfield8.ok THEN Fail ELSE
    LET crossOrderAcknowledgmentReturnBitfield9 == ReadWhen(numberOfReturnBitfields.value >= 9, ReadUIntLE(crossOrderAcknowledgmentReturnBitfield8.rest, 1), crossOrderAcknowledgmentReturnBitfield8.rest) IN IF ~crossOrderAcknowledgmentReturnBitfield9.ok THEN Fail ELSE
    LET crossOrderAcknowledgmentReturnBitfield10 == ReadWhen(numberOfReturnBitfields.value >= 10, ReadUIntLE(crossOrderAcknowledgmentReturnBitfield9.rest, 1), crossOrderAcknowledgmentReturnBitfield9.rest) IN IF ~crossOrderAcknowledgmentReturnBitfield10.ok THEN Fail ELSE
    LET crossOrderAcknowledgmentReturnBitfield11 == ReadWhen(numberOfReturnBitfields.value >= 11, ReadUIntLE(crossOrderAcknowledgmentReturnBitfield10.rest, 1), crossOrderAcknowledgmentReturnBitfield10.rest) IN IF ~crossOrderAcknowledgmentReturnBitfield11.ok THEN Fail ELSE
    LET crossOrderAcknowledgmentReturnBitfield12 == ReadWhen(numberOfReturnBitfields.value >= 12, ReadBytes(crossOrderAcknowledgmentReturnBitfield11.rest, 1), crossOrderAcknowledgmentReturnBitfield11.rest) IN IF ~crossOrderAcknowledgmentReturnBitfield12.ok THEN Fail ELSE
    LET crossOrderAcknowledgmentReturnBitfield13 == ReadWhen(numberOfReturnBitfields.value >= 13, ReadUIntLE(crossOrderAcknowledgmentReturnBitfield12.rest, 1), crossOrderAcknowledgmentReturnBitfield12.rest) IN IF ~crossOrderAcknowledgmentReturnBitfield13.ok THEN Fail ELSE
    LET crossOrderAcknowledgmentReturnBitfield14 == ReadWhen(numberOfReturnBitfields.value >= 14, ReadBytes(crossOrderAcknowledgmentReturnBitfield13.rest, 1), crossOrderAcknowledgmentReturnBitfield13.rest) IN IF ~crossOrderAcknowledgmentReturnBitfield14.ok THEN Fail ELSE
    LET crossOrderAcknowledgmentReturnBitfield15 == ReadWhen(numberOfReturnBitfields.value >= 15, ReadBytes(crossOrderAcknowledgmentReturnBitfield14.rest, 1), crossOrderAcknowledgmentReturnBitfield14.rest) IN IF ~crossOrderAcknowledgmentReturnBitfield15.ok THEN Fail ELSE
    LET crossOrderAcknowledgmentReturnBitfield16 == ReadWhen(numberOfReturnBitfields.value >= 16, ReadBytes(crossOrderAcknowledgmentReturnBitfield15.rest, 1), crossOrderAcknowledgmentReturnBitfield15.rest) IN IF ~crossOrderAcknowledgmentReturnBitfield16.ok THEN Fail ELSE
    LET crossOrderAcknowledgmentReturnBitfield17 == ReadWhen(numberOfReturnBitfields.value >= 17, ReadUIntLE(crossOrderAcknowledgmentReturnBitfield16.rest, 1), crossOrderAcknowledgmentReturnBitfield16.rest) IN IF ~crossOrderAcknowledgmentReturnBitfield17.ok THEN Fail ELSE
    LET crossOrderAcknowledgmentReturnBitfield18 == ReadWhen(numberOfReturnBitfields.value >= 18, ReadUIntLE(crossOrderAcknowledgmentReturnBitfield17.rest, 1), crossOrderAcknowledgmentReturnBitfield17.rest) IN IF ~crossOrderAcknowledgmentReturnBitfield18.ok THEN Fail ELSE
    LET crossOrderAcknowledgmentReturnBitfield19 == ReadWhen(numberOfReturnBitfields.value >= 19, ReadBytes(crossOrderAcknowledgmentReturnBitfield18.rest, 1), crossOrderAcknowledgmentReturnBitfield18.rest) IN IF ~crossOrderAcknowledgmentReturnBitfield19.ok THEN Fail ELSE
    LET groupCnt == ReadUIntLE(crossOrderAcknowledgmentReturnBitfield19.rest, 2) IN IF ~groupCnt.ok THEN Fail ELSE
    LET crossOrderAcknowledgmentOrderAllocations == ReadCrossOrderAcknowledgmentOrderAllocationsList(groupCnt.rest, groupCnt.value, numberOfReturnBitfields.value, crossOrderAcknowledgmentReturnBitfield1.value, crossOrderAcknowledgmentReturnBitfield2.value, crossOrderAcknowledgmentReturnBitfield3.value, crossOrderAcknowledgmentReturnBitfield4.value, crossOrderAcknowledgmentReturnBitfield10.value, crossOrderAcknowledgmentReturnBitfield11.value, crossOrderAcknowledgmentReturnBitfield17.value, crossOrderAcknowledgmentReturnBitfield18.value) IN IF ~crossOrderAcknowledgmentOrderAllocations.ok THEN Fail ELSE
    LET price == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (crossOrderAcknowledgmentReturnBitfield1.value # << >> /\ (crossOrderAcknowledgmentReturnBitfield1.value[1] \div 4) % 2 > 0), ReadBytes(crossOrderAcknowledgmentOrderAllocations.rest, 8), crossOrderAcknowledgmentOrderAllocations.rest) IN IF ~price.ok THEN Fail ELSE
    LET symbolLong == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (crossOrderAcknowledgmentReturnBitfield2.value # << >> /\ crossOrderAcknowledgmentReturnBitfield2.value[1] % 2 > 0), ReadBytes(price.rest, 8), price.rest) IN IF ~symbolLong.ok THEN Fail ELSE
    LET idSource == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (crossOrderAcknowledgmentReturnBitfield2.value # << >> /\ (crossOrderAcknowledgmentReturnBitfield2.value[1] \div 8) % 2 > 0), ReadBytes(symbolLong.rest, 1), symbolLong.rest) IN IF ~idSource.ok THEN Fail ELSE
    LET securityId == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (crossOrderAcknowledgmentReturnBitfield2.value # << >> /\ (crossOrderAcknowledgmentReturnBitfield2.value[1] \div 16) % 2 > 0), ReadBytes(idSource.rest, 16), idSource.rest) IN IF ~securityId.ok THEN Fail ELSE
    LET orderQty == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (crossOrderAcknowledgmentReturnBitfield3.value # << >> /\ (crossOrderAcknowledgmentReturnBitfield3.value[1] \div 64) % 2 > 0), ReadBytes(securityId.rest, 4), securityId.rest) IN IF ~orderQty.ok THEN Fail ELSE
    LET preventMatch == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (crossOrderAcknowledgmentReturnBitfield3.value # << >> /\ (crossOrderAcknowledgmentReturnBitfield3.value[1] \div 128) % 2 > 0), ReadBytes(orderQty.rest, 3), orderQty.rest) IN IF ~preventMatch.ok THEN Fail ELSE
    LET extExecInst == ReadWhen(numberOfReturnBitfields.value >= 6 /\ (crossOrderAcknowledgmentReturnBitfield6.value # << >> /\ (crossOrderAcknowledgmentReturnBitfield6.value[1] \div 16) % 2 > 0), ReadBytes(preventMatch.rest, 1), preventMatch.rest) IN IF ~extExecInst.ok THEN Fail ELSE
    LET liquidityProvision == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (crossOrderAcknowledgmentReturnBitfield9.value # << >> /\ (crossOrderAcknowledgmentReturnBitfield9.value[1] \div 16) % 2 > 0), ReadBytes(extExecInst.rest, 1), extExecInst.rest) IN IF ~liquidityProvision.ok THEN Fail ELSE
    LET crossType == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (crossOrderAcknowledgmentReturnBitfield9.value # << >> /\ (crossOrderAcknowledgmentReturnBitfield9.value[1] \div 64) % 2 > 0), ReadBytes(liquidityProvision.rest, 1), liquidityProvision.rest) IN IF ~crossType.ok THEN Fail ELSE
    LET crossPrioritization == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (crossOrderAcknowledgmentReturnBitfield9.value # << >> /\ (crossOrderAcknowledgmentReturnBitfield9.value[1] \div 128) % 2 > 0), ReadBytes(crossType.rest, 1), crossType.rest) IN IF ~crossPrioritization.ok THEN Fail ELSE
    LET routingFirmId == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (crossOrderAcknowledgmentReturnBitfield10.value # << >> /\ (crossOrderAcknowledgmentReturnBitfield10.value[1] \div 8) % 2 > 0), ReadBytes(crossPrioritization.rest, 4), crossPrioritization.rest) IN IF ~routingFirmId.ok THEN Fail ELSE
    LET drillThruProtection == ReadWhen(numberOfReturnBitfields.value >= 13 /\ (crossOrderAcknowledgmentReturnBitfield13.value # << >> /\ (crossOrderAcknowledgmentReturnBitfield13.value[1] \div 64) % 2 > 0), ReadBytes(routingFirmId.rest, 8), routingFirmId.rest) IN IF ~drillThruProtection.ok THEN Fail ELSE
    Ok([ transactionTime                          |-> transactionTime.value,
         crossId                                  |-> crossId.value,
         auctionId                                |-> auctionId.value,
         reserved1                                |-> reserved1.value,
         numberOfReturnBitfields                  |-> numberOfReturnBitfields.value,
         crossOrderAcknowledgmentReturnBitfield1  |-> crossOrderAcknowledgmentReturnBitfield1.value,
         crossOrderAcknowledgmentReturnBitfield2  |-> crossOrderAcknowledgmentReturnBitfield2.value,
         crossOrderAcknowledgmentReturnBitfield3  |-> crossOrderAcknowledgmentReturnBitfield3.value,
         crossOrderAcknowledgmentReturnBitfield4  |-> crossOrderAcknowledgmentReturnBitfield4.value,
         crossOrderAcknowledgmentReturnBitfield5  |-> crossOrderAcknowledgmentReturnBitfield5.value,
         crossOrderAcknowledgmentReturnBitfield6  |-> crossOrderAcknowledgmentReturnBitfield6.value,
         crossOrderAcknowledgmentReturnBitfield7  |-> crossOrderAcknowledgmentReturnBitfield7.value,
         crossOrderAcknowledgmentReturnBitfield8  |-> crossOrderAcknowledgmentReturnBitfield8.value,
         crossOrderAcknowledgmentReturnBitfield9  |-> crossOrderAcknowledgmentReturnBitfield9.value,
         crossOrderAcknowledgmentReturnBitfield10 |-> crossOrderAcknowledgmentReturnBitfield10.value,
         crossOrderAcknowledgmentReturnBitfield11 |-> crossOrderAcknowledgmentReturnBitfield11.value,
         crossOrderAcknowledgmentReturnBitfield12 |-> crossOrderAcknowledgmentReturnBitfield12.value,
         crossOrderAcknowledgmentReturnBitfield13 |-> crossOrderAcknowledgmentReturnBitfield13.value,
         crossOrderAcknowledgmentReturnBitfield14 |-> crossOrderAcknowledgmentReturnBitfield14.value,
         crossOrderAcknowledgmentReturnBitfield15 |-> crossOrderAcknowledgmentReturnBitfield15.value,
         crossOrderAcknowledgmentReturnBitfield16 |-> crossOrderAcknowledgmentReturnBitfield16.value,
         crossOrderAcknowledgmentReturnBitfield17 |-> crossOrderAcknowledgmentReturnBitfield17.value,
         crossOrderAcknowledgmentReturnBitfield18 |-> crossOrderAcknowledgmentReturnBitfield18.value,
         crossOrderAcknowledgmentReturnBitfield19 |-> crossOrderAcknowledgmentReturnBitfield19.value,
         crossOrderAcknowledgmentOrderAllocations |-> crossOrderAcknowledgmentOrderAllocations.value,
         price                                    |-> price.value,
         symbolLong                               |-> symbolLong.value,
         idSource                                 |-> idSource.value,
         securityId                               |-> securityId.value,
         orderQty                                 |-> orderQty.value,
         preventMatch                             |-> preventMatch.value,
         extExecInst                              |-> extExecInst.value,
         liquidityProvision                       |-> liquidityProvision.value,
         crossType                                |-> crossType.value,
         crossPrioritization                      |-> crossPrioritization.value,
         routingFirmId                            |-> routingFirmId.value,
         drillThruProtection                      |-> drillThruProtection.value ], drillThruProtection.rest)

(* Cross Order Acknowledgment Message with each field marked present by fields before it there exactly where they say *)
SettleCrossOrderAcknowledgmentMessage(message) ==
    LET settled1 == [message EXCEPT !.crossOrderAcknowledgmentReturnBitfield1 = IF message.numberOfReturnBitfields >= 1 THEN (IF message.crossOrderAcknowledgmentReturnBitfield1 = << >> THEN <<0>> ELSE message.crossOrderAcknowledgmentReturnBitfield1) ELSE << >>]
        settled2 == [settled1 EXCEPT !.crossOrderAcknowledgmentReturnBitfield2 = IF settled1.numberOfReturnBitfields >= 2 THEN (IF settled1.crossOrderAcknowledgmentReturnBitfield2 = << >> THEN <<0>> ELSE settled1.crossOrderAcknowledgmentReturnBitfield2) ELSE << >>]
        settled3 == [settled2 EXCEPT !.crossOrderAcknowledgmentReturnBitfield3 = IF settled2.numberOfReturnBitfields >= 3 THEN (IF settled2.crossOrderAcknowledgmentReturnBitfield3 = << >> THEN <<0>> ELSE settled2.crossOrderAcknowledgmentReturnBitfield3) ELSE << >>]
        settled4 == [settled3 EXCEPT !.crossOrderAcknowledgmentReturnBitfield4 = IF settled3.numberOfReturnBitfields >= 4 THEN (IF settled3.crossOrderAcknowledgmentReturnBitfield4 = << >> THEN <<0>> ELSE settled3.crossOrderAcknowledgmentReturnBitfield4) ELSE << >>]
        settled5 == [settled4 EXCEPT !.crossOrderAcknowledgmentReturnBitfield5 = IF settled4.numberOfReturnBitfields >= 5 THEN (IF settled4.crossOrderAcknowledgmentReturnBitfield5 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled4.crossOrderAcknowledgmentReturnBitfield5) ELSE << >>]
        settled6 == [settled5 EXCEPT !.crossOrderAcknowledgmentReturnBitfield6 = IF settled5.numberOfReturnBitfields >= 6 THEN (IF settled5.crossOrderAcknowledgmentReturnBitfield6 = << >> THEN <<0>> ELSE settled5.crossOrderAcknowledgmentReturnBitfield6) ELSE << >>]
        settled7 == [settled6 EXCEPT !.crossOrderAcknowledgmentReturnBitfield7 = IF settled6.numberOfReturnBitfields >= 7 THEN (IF settled6.crossOrderAcknowledgmentReturnBitfield7 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled6.crossOrderAcknowledgmentReturnBitfield7) ELSE << >>]
        settled8 == [settled7 EXCEPT !.crossOrderAcknowledgmentReturnBitfield8 = IF settled7.numberOfReturnBitfields >= 8 THEN (IF settled7.crossOrderAcknowledgmentReturnBitfield8 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled7.crossOrderAcknowledgmentReturnBitfield8) ELSE << >>]
        settled9 == [settled8 EXCEPT !.crossOrderAcknowledgmentReturnBitfield9 = IF settled8.numberOfReturnBitfields >= 9 THEN (IF settled8.crossOrderAcknowledgmentReturnBitfield9 = << >> THEN <<0>> ELSE settled8.crossOrderAcknowledgmentReturnBitfield9) ELSE << >>]
        settled10 == [settled9 EXCEPT !.crossOrderAcknowledgmentReturnBitfield10 = IF settled9.numberOfReturnBitfields >= 10 THEN (IF settled9.crossOrderAcknowledgmentReturnBitfield10 = << >> THEN <<0>> ELSE settled9.crossOrderAcknowledgmentReturnBitfield10) ELSE << >>]
        settled11 == [settled10 EXCEPT !.crossOrderAcknowledgmentReturnBitfield11 = IF settled10.numberOfReturnBitfields >= 11 THEN (IF settled10.crossOrderAcknowledgmentReturnBitfield11 = << >> THEN <<0>> ELSE settled10.crossOrderAcknowledgmentReturnBitfield11) ELSE << >>]
        settled12 == [settled11 EXCEPT !.crossOrderAcknowledgmentReturnBitfield12 = IF settled11.numberOfReturnBitfields >= 12 THEN (IF settled11.crossOrderAcknowledgmentReturnBitfield12 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled11.crossOrderAcknowledgmentReturnBitfield12) ELSE << >>]
        settled13 == [settled12 EXCEPT !.crossOrderAcknowledgmentReturnBitfield13 = IF settled12.numberOfReturnBitfields >= 13 THEN (IF settled12.crossOrderAcknowledgmentReturnBitfield13 = << >> THEN <<0>> ELSE settled12.crossOrderAcknowledgmentReturnBitfield13) ELSE << >>]
        settled14 == [settled13 EXCEPT !.crossOrderAcknowledgmentReturnBitfield14 = IF settled13.numberOfReturnBitfields >= 14 THEN (IF settled13.crossOrderAcknowledgmentReturnBitfield14 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled13.crossOrderAcknowledgmentReturnBitfield14) ELSE << >>]
        settled15 == [settled14 EXCEPT !.crossOrderAcknowledgmentReturnBitfield15 = IF settled14.numberOfReturnBitfields >= 15 THEN (IF settled14.crossOrderAcknowledgmentReturnBitfield15 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled14.crossOrderAcknowledgmentReturnBitfield15) ELSE << >>]
        settled16 == [settled15 EXCEPT !.crossOrderAcknowledgmentReturnBitfield16 = IF settled15.numberOfReturnBitfields >= 16 THEN (IF settled15.crossOrderAcknowledgmentReturnBitfield16 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled15.crossOrderAcknowledgmentReturnBitfield16) ELSE << >>]
        settled17 == [settled16 EXCEPT !.crossOrderAcknowledgmentReturnBitfield17 = IF settled16.numberOfReturnBitfields >= 17 THEN (IF settled16.crossOrderAcknowledgmentReturnBitfield17 = << >> THEN <<0>> ELSE settled16.crossOrderAcknowledgmentReturnBitfield17) ELSE << >>]
        settled18 == [settled17 EXCEPT !.crossOrderAcknowledgmentReturnBitfield18 = IF settled17.numberOfReturnBitfields >= 18 THEN (IF settled17.crossOrderAcknowledgmentReturnBitfield18 = << >> THEN <<0>> ELSE settled17.crossOrderAcknowledgmentReturnBitfield18) ELSE << >>]
        settled19 == [settled18 EXCEPT !.crossOrderAcknowledgmentReturnBitfield19 = IF settled18.numberOfReturnBitfields >= 19 THEN (IF settled18.crossOrderAcknowledgmentReturnBitfield19 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled18.crossOrderAcknowledgmentReturnBitfield19) ELSE << >>]
        settled20 == [settled19 EXCEPT !.crossOrderAcknowledgmentOrderAllocations = [i \in DOMAIN settled19.crossOrderAcknowledgmentOrderAllocations |-> SettleCrossOrderAcknowledgmentOrderAllocations(settled19.crossOrderAcknowledgmentOrderAllocations[i], settled19.numberOfReturnBitfields, settled19.crossOrderAcknowledgmentReturnBitfield1, settled19.crossOrderAcknowledgmentReturnBitfield2, settled19.crossOrderAcknowledgmentReturnBitfield3, settled19.crossOrderAcknowledgmentReturnBitfield4, settled19.crossOrderAcknowledgmentReturnBitfield10, settled19.crossOrderAcknowledgmentReturnBitfield11, settled19.crossOrderAcknowledgmentReturnBitfield17, settled19.crossOrderAcknowledgmentReturnBitfield18)]]
        settled21 == [settled20 EXCEPT !.price = IF settled20.numberOfReturnBitfields >= 1 /\ (settled20.crossOrderAcknowledgmentReturnBitfield1 # << >> /\ (settled20.crossOrderAcknowledgmentReturnBitfield1[1] \div 4) % 2 > 0) THEN (IF settled20.price = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled20.price) ELSE << >>]
        settled22 == [settled21 EXCEPT !.symbolLong = IF settled21.numberOfReturnBitfields >= 2 /\ (settled21.crossOrderAcknowledgmentReturnBitfield2 # << >> /\ settled21.crossOrderAcknowledgmentReturnBitfield2[1] % 2 > 0) THEN (IF settled21.symbolLong = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled21.symbolLong) ELSE << >>]
        settled23 == [settled22 EXCEPT !.idSource = IF settled22.numberOfReturnBitfields >= 2 /\ (settled22.crossOrderAcknowledgmentReturnBitfield2 # << >> /\ (settled22.crossOrderAcknowledgmentReturnBitfield2[1] \div 8) % 2 > 0) THEN (IF settled22.idSource = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled22.idSource) ELSE << >>]
        settled24 == [settled23 EXCEPT !.securityId = IF settled23.numberOfReturnBitfields >= 2 /\ (settled23.crossOrderAcknowledgmentReturnBitfield2 # << >> /\ (settled23.crossOrderAcknowledgmentReturnBitfield2[1] \div 16) % 2 > 0) THEN (IF settled23.securityId = << >> THEN <<[i \in 1 .. 16 |-> 0]>> ELSE settled23.securityId) ELSE << >>]
        settled25 == [settled24 EXCEPT !.orderQty = IF settled24.numberOfReturnBitfields >= 3 /\ (settled24.crossOrderAcknowledgmentReturnBitfield3 # << >> /\ (settled24.crossOrderAcknowledgmentReturnBitfield3[1] \div 64) % 2 > 0) THEN (IF settled24.orderQty = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled24.orderQty) ELSE << >>]
        settled26 == [settled25 EXCEPT !.preventMatch = IF settled25.numberOfReturnBitfields >= 3 /\ (settled25.crossOrderAcknowledgmentReturnBitfield3 # << >> /\ (settled25.crossOrderAcknowledgmentReturnBitfield3[1] \div 128) % 2 > 0) THEN (IF settled25.preventMatch = << >> THEN <<[i \in 1 .. 3 |-> 0]>> ELSE settled25.preventMatch) ELSE << >>]
        settled27 == [settled26 EXCEPT !.extExecInst = IF settled26.numberOfReturnBitfields >= 6 /\ (settled26.crossOrderAcknowledgmentReturnBitfield6 # << >> /\ (settled26.crossOrderAcknowledgmentReturnBitfield6[1] \div 16) % 2 > 0) THEN (IF settled26.extExecInst = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled26.extExecInst) ELSE << >>]
        settled28 == [settled27 EXCEPT !.liquidityProvision = IF settled27.numberOfReturnBitfields >= 9 /\ (settled27.crossOrderAcknowledgmentReturnBitfield9 # << >> /\ (settled27.crossOrderAcknowledgmentReturnBitfield9[1] \div 16) % 2 > 0) THEN (IF settled27.liquidityProvision = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled27.liquidityProvision) ELSE << >>]
        settled29 == [settled28 EXCEPT !.crossType = IF settled28.numberOfReturnBitfields >= 9 /\ (settled28.crossOrderAcknowledgmentReturnBitfield9 # << >> /\ (settled28.crossOrderAcknowledgmentReturnBitfield9[1] \div 64) % 2 > 0) THEN (IF settled28.crossType = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled28.crossType) ELSE << >>]
        settled30 == [settled29 EXCEPT !.crossPrioritization = IF settled29.numberOfReturnBitfields >= 9 /\ (settled29.crossOrderAcknowledgmentReturnBitfield9 # << >> /\ (settled29.crossOrderAcknowledgmentReturnBitfield9[1] \div 128) % 2 > 0) THEN (IF settled29.crossPrioritization = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled29.crossPrioritization) ELSE << >>]
        settled31 == [settled30 EXCEPT !.routingFirmId = IF settled30.numberOfReturnBitfields >= 10 /\ (settled30.crossOrderAcknowledgmentReturnBitfield10 # << >> /\ (settled30.crossOrderAcknowledgmentReturnBitfield10[1] \div 8) % 2 > 0) THEN (IF settled30.routingFirmId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled30.routingFirmId) ELSE << >>]
        settled32 == [settled31 EXCEPT !.drillThruProtection = IF settled31.numberOfReturnBitfields >= 13 /\ (settled31.crossOrderAcknowledgmentReturnBitfield13 # << >> /\ (settled31.crossOrderAcknowledgmentReturnBitfield13[1] \div 64) % 2 > 0) THEN (IF settled31.drillThruProtection = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled31.drillThruProtection) ELSE << >>]
    IN  settled32

ZeroCrossOrderAcknowledgmentMessage ==
    SettleCrossOrderAcknowledgmentMessage([ transactionTime                          |-> [i \in 1 .. 8 |-> 0],
                                            crossId                                  |-> [i \in 1 .. 20 |-> 0],
                                            auctionId                                |-> [i \in 1 .. 8 |-> 0],
                                            reserved1                                |-> [i \in 1 .. 1 |-> 0],
                                            numberOfReturnBitfields                  |-> 0,
                                            crossOrderAcknowledgmentReturnBitfield1  |-> << >>,
                                            crossOrderAcknowledgmentReturnBitfield2  |-> << >>,
                                            crossOrderAcknowledgmentReturnBitfield3  |-> << >>,
                                            crossOrderAcknowledgmentReturnBitfield4  |-> << >>,
                                            crossOrderAcknowledgmentReturnBitfield5  |-> << >>,
                                            crossOrderAcknowledgmentReturnBitfield6  |-> << >>,
                                            crossOrderAcknowledgmentReturnBitfield7  |-> << >>,
                                            crossOrderAcknowledgmentReturnBitfield8  |-> << >>,
                                            crossOrderAcknowledgmentReturnBitfield9  |-> << >>,
                                            crossOrderAcknowledgmentReturnBitfield10 |-> << >>,
                                            crossOrderAcknowledgmentReturnBitfield11 |-> << >>,
                                            crossOrderAcknowledgmentReturnBitfield12 |-> << >>,
                                            crossOrderAcknowledgmentReturnBitfield13 |-> << >>,
                                            crossOrderAcknowledgmentReturnBitfield14 |-> << >>,
                                            crossOrderAcknowledgmentReturnBitfield15 |-> << >>,
                                            crossOrderAcknowledgmentReturnBitfield16 |-> << >>,
                                            crossOrderAcknowledgmentReturnBitfield17 |-> << >>,
                                            crossOrderAcknowledgmentReturnBitfield18 |-> << >>,
                                            crossOrderAcknowledgmentReturnBitfield19 |-> << >>,
                                            crossOrderAcknowledgmentOrderAllocations |-> << >>,
                                            price                                    |-> << >>,
                                            symbolLong                               |-> << >>,
                                            idSource                                 |-> << >>,
                                            securityId                               |-> << >>,
                                            orderQty                                 |-> << >>,
                                            preventMatch                             |-> << >>,
                                            extExecInst                              |-> << >>,
                                            liquidityProvision                       |-> << >>,
                                            crossType                                |-> << >>,
                                            crossPrioritization                      |-> << >>,
                                            routingFirmId                            |-> << >>,
                                            drillThruProtection                      |-> << >> ])

(* Cross Order Acknowledgment Message at zero, then each field in turn at the values it is checked at *)
CheckedCrossOrderAcknowledgmentMessage ==
    { ZeroCrossOrderAcknowledgmentMessage }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.transactionTime = one]) : one \in Sample(8) }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.crossId = one]) : one \in Sample(20) }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.auctionId = one]) : one \in Sample(8) }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.reserved1 = one]) : one \in Sample(1) }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = one]) : one \in {0, 1, 255} }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 1, !.crossOrderAcknowledgmentReturnBitfield1 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 2, !.crossOrderAcknowledgmentReturnBitfield2 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 3, !.crossOrderAcknowledgmentReturnBitfield3 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 4, !.crossOrderAcknowledgmentReturnBitfield4 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 5, !.crossOrderAcknowledgmentReturnBitfield5 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 6, !.crossOrderAcknowledgmentReturnBitfield6 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 7, !.crossOrderAcknowledgmentReturnBitfield7 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 8, !.crossOrderAcknowledgmentReturnBitfield8 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 9, !.crossOrderAcknowledgmentReturnBitfield9 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 10, !.crossOrderAcknowledgmentReturnBitfield10 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 11, !.crossOrderAcknowledgmentReturnBitfield11 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 12, !.crossOrderAcknowledgmentReturnBitfield12 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 13, !.crossOrderAcknowledgmentReturnBitfield13 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 14, !.crossOrderAcknowledgmentReturnBitfield14 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 15, !.crossOrderAcknowledgmentReturnBitfield15 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 16, !.crossOrderAcknowledgmentReturnBitfield16 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 17, !.crossOrderAcknowledgmentReturnBitfield17 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 18, !.crossOrderAcknowledgmentReturnBitfield18 = one]) : one \in { <<held>> : held \in {0, 1, 255} } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 19, !.crossOrderAcknowledgmentReturnBitfield19 = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.crossOrderAcknowledgmentOrderAllocations = one]) : one \in SampleLists(OneCrossOrderAcknowledgmentOrderAllocations) }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 1, !.crossOrderAcknowledgmentReturnBitfield1 = <<1>>, !.crossOrderAcknowledgmentOrderAllocations = one]) : one \in SampleLists(OneCrossOrderAcknowledgmentOrderAllocations) }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 10, !.crossOrderAcknowledgmentReturnBitfield10 = <<2>>, !.crossOrderAcknowledgmentOrderAllocations = one]) : one \in SampleLists(OneCrossOrderAcknowledgmentOrderAllocations) }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 2, !.crossOrderAcknowledgmentReturnBitfield2 = <<64>>, !.crossOrderAcknowledgmentOrderAllocations = one]) : one \in SampleLists(OneCrossOrderAcknowledgmentOrderAllocations) }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 4, !.crossOrderAcknowledgmentReturnBitfield4 = <<8>>, !.crossOrderAcknowledgmentOrderAllocations = one]) : one \in SampleLists(OneCrossOrderAcknowledgmentOrderAllocations) }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 3, !.crossOrderAcknowledgmentReturnBitfield3 = <<1>>, !.crossOrderAcknowledgmentOrderAllocations = one]) : one \in SampleLists(OneCrossOrderAcknowledgmentOrderAllocations) }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 3, !.crossOrderAcknowledgmentReturnBitfield3 = <<4>>, !.crossOrderAcknowledgmentOrderAllocations = one]) : one \in SampleLists(OneCrossOrderAcknowledgmentOrderAllocations) }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 3, !.crossOrderAcknowledgmentReturnBitfield3 = <<2>>, !.crossOrderAcknowledgmentOrderAllocations = one]) : one \in SampleLists(OneCrossOrderAcknowledgmentOrderAllocations) }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 17, !.crossOrderAcknowledgmentReturnBitfield17 = <<128>>, !.crossOrderAcknowledgmentOrderAllocations = one]) : one \in SampleLists(OneCrossOrderAcknowledgmentOrderAllocations) }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 18, !.crossOrderAcknowledgmentReturnBitfield18 = <<1>>, !.crossOrderAcknowledgmentOrderAllocations = one]) : one \in SampleLists(OneCrossOrderAcknowledgmentOrderAllocations) }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 11, !.crossOrderAcknowledgmentReturnBitfield11 = <<8>>, !.crossOrderAcknowledgmentOrderAllocations = one]) : one \in SampleLists(OneCrossOrderAcknowledgmentOrderAllocations) }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 11, !.crossOrderAcknowledgmentReturnBitfield11 = <<16>>, !.crossOrderAcknowledgmentOrderAllocations = one]) : one \in SampleLists(OneCrossOrderAcknowledgmentOrderAllocations) }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 11, !.crossOrderAcknowledgmentReturnBitfield11 = <<1>>, !.crossOrderAcknowledgmentOrderAllocations = one]) : one \in SampleLists(OneCrossOrderAcknowledgmentOrderAllocations) }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 10, !.crossOrderAcknowledgmentReturnBitfield10 = <<128>>, !.crossOrderAcknowledgmentOrderAllocations = one]) : one \in SampleLists(OneCrossOrderAcknowledgmentOrderAllocations) }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 11, !.crossOrderAcknowledgmentReturnBitfield11 = <<2>>, !.crossOrderAcknowledgmentOrderAllocations = one]) : one \in SampleLists(OneCrossOrderAcknowledgmentOrderAllocations) }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 11, !.crossOrderAcknowledgmentReturnBitfield11 = <<64>>, !.crossOrderAcknowledgmentOrderAllocations = one]) : one \in SampleLists(OneCrossOrderAcknowledgmentOrderAllocations) }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 11, !.crossOrderAcknowledgmentReturnBitfield11 = <<4>>, !.crossOrderAcknowledgmentOrderAllocations = one]) : one \in SampleLists(OneCrossOrderAcknowledgmentOrderAllocations) }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 11, !.crossOrderAcknowledgmentReturnBitfield11 = <<128>>, !.crossOrderAcknowledgmentOrderAllocations = one]) : one \in SampleLists(OneCrossOrderAcknowledgmentOrderAllocations) }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 1, !.crossOrderAcknowledgmentReturnBitfield1 = <<4>>, !.price = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 2, !.crossOrderAcknowledgmentReturnBitfield2 = <<1>>, !.symbolLong = one]) : one \in { <<held>> : held \in Sample(8) } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 2, !.crossOrderAcknowledgmentReturnBitfield2 = <<8>>, !.idSource = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 2, !.crossOrderAcknowledgmentReturnBitfield2 = <<16>>, !.securityId = one]) : one \in { <<held>> : held \in Sample(16) } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 3, !.crossOrderAcknowledgmentReturnBitfield3 = <<64>>, !.orderQty = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 3, !.crossOrderAcknowledgmentReturnBitfield3 = <<128>>, !.preventMatch = one]) : one \in { <<held>> : held \in Sample(3) } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 6, !.crossOrderAcknowledgmentReturnBitfield6 = <<16>>, !.extExecInst = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 9, !.crossOrderAcknowledgmentReturnBitfield9 = <<16>>, !.liquidityProvision = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 9, !.crossOrderAcknowledgmentReturnBitfield9 = <<64>>, !.crossType = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 9, !.crossOrderAcknowledgmentReturnBitfield9 = <<128>>, !.crossPrioritization = one]) : one \in { <<held>> : held \in Sample(1) } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 10, !.crossOrderAcknowledgmentReturnBitfield10 = <<8>>, !.routingFirmId = one]) : one \in { <<held>> : held \in Sample(4) } }
        \cup { SettleCrossOrderAcknowledgmentMessage([ZeroCrossOrderAcknowledgmentMessage EXCEPT !.numberOfReturnBitfields = 13, !.crossOrderAcknowledgmentReturnBitfield13 = <<64>>, !.drillThruProtection = one]) : one \in { <<held>> : held \in Sample(8) } }

(***************************************************************************)
(* Quote Update Acknowledgment Quote: 16 bytes                             *)
(***************************************************************************)

QuoteUpdateAcknowledgmentQuote ==
    [ orderId               : Sample(8),
      quoteResult           : Sample(1),
      subLiquidityIndicator : Sample(1),
      subreason             : Sample(1),
      reserved5             : Sample(5) ]

EncodeQuoteUpdateAcknowledgmentQuote(message) ==
    message.orderId
        \o message.quoteResult
        \o message.subLiquidityIndicator
        \o message.subreason
        \o message.reserved5

DecodeQuoteUpdateAcknowledgmentQuote(bytes) ==
    LET orderId == ReadBytes(bytes, 8) IN IF ~orderId.ok THEN Fail ELSE
    LET quoteResult == ReadBytes(orderId.rest, 1) IN IF ~quoteResult.ok THEN Fail ELSE
    LET subLiquidityIndicator == ReadBytes(quoteResult.rest, 1) IN IF ~subLiquidityIndicator.ok THEN Fail ELSE
    LET subreason == ReadBytes(subLiquidityIndicator.rest, 1) IN IF ~subreason.ok THEN Fail ELSE
    LET reserved5 == ReadBytes(subreason.rest, 5) IN IF ~reserved5.ok THEN Fail ELSE
    Ok([ orderId               |-> orderId.value,
         quoteResult           |-> quoteResult.value,
         subLiquidityIndicator |-> subLiquidityIndicator.value,
         subreason             |-> subreason.value,
         reserved5             |-> reserved5.value ], reserved5.rest)

ZeroQuoteUpdateAcknowledgmentQuote ==
    [ orderId               |-> [i \in 1 .. 8 |-> 0],
      quoteResult           |-> [i \in 1 .. 1 |-> 0],
      subLiquidityIndicator |-> [i \in 1 .. 1 |-> 0],
      subreason             |-> [i \in 1 .. 1 |-> 0],
      reserved5             |-> [i \in 1 .. 5 |-> 0] ]

(* Quote Update Acknowledgment Quote at zero, then each field in turn at the values it is checked at *)
CheckedQuoteUpdateAcknowledgmentQuote ==
    { ZeroQuoteUpdateAcknowledgmentQuote }
        \cup { [ZeroQuoteUpdateAcknowledgmentQuote EXCEPT !.orderId = one] : one \in Sample(8) }
        \cup { [ZeroQuoteUpdateAcknowledgmentQuote EXCEPT !.quoteResult = one] : one \in Sample(1) }
        \cup { [ZeroQuoteUpdateAcknowledgmentQuote EXCEPT !.subLiquidityIndicator = one] : one \in Sample(1) }
        \cup { [ZeroQuoteUpdateAcknowledgmentQuote EXCEPT !.subreason = one] : one \in Sample(1) }
        \cup { [ZeroQuoteUpdateAcknowledgmentQuote EXCEPT !.reserved5 = one] : one \in Sample(5) }

(* A run of Quote Update Acknowledgment Quote, written one after another *)
RECURSIVE EncodeQuoteUpdateAcknowledgmentQuoteList(_)
EncodeQuoteUpdateAcknowledgmentQuoteList(messages) ==
    IF messages = << >>
    THEN << >>
    ELSE EncodeQuoteUpdateAcknowledgmentQuote(Head(messages)) \o EncodeQuoteUpdateAcknowledgmentQuoteList(Tail(messages))

(* As many Quote Update Acknowledgment Quote as the field that counts them says *)
RECURSIVE ReadQuoteUpdateAcknowledgmentQuoteList(_, _)
ReadQuoteUpdateAcknowledgmentQuoteList(bytes, count) ==
    IF count = 0
    THEN Ok(<< >>, bytes)
    ELSE LET one == DecodeQuoteUpdateAcknowledgmentQuote(bytes)
         IN  IF ~one.ok THEN Fail
             ELSE LET more == ReadQuoteUpdateAcknowledgmentQuoteList(one.rest, count - 1)
                  IN  IF ~more.ok THEN Fail
                      ELSE Ok(<<one.value>> \o more.value, more.rest)

(* One Quote Update Acknowledgment Quote of each kind, for the lists that carry them *)
OneQuoteUpdateAcknowledgmentQuote == { ZeroQuoteUpdateAcknowledgmentQuote }

(***************************************************************************)
(* Quote Update Acknowledgment Message                                     *)
(***************************************************************************)

QuoteUpdateAcknowledgmentMessage ==
    [ transactionTime                : Sample(8),
      quoteUpdateId                  : Sample(16),
      quoteRejectReason              : Sample(1),
      reserved17                     : Sample(17),
      quoteUpdateAcknowledgmentQuote : SampleLists(OneQuoteUpdateAcknowledgmentQuote) ]

EncodeQuoteUpdateAcknowledgmentMessage(message) ==
    message.transactionTime
        \o message.quoteUpdateId
        \o message.quoteRejectReason
        \o message.reserved17
        \o EncodeUIntBE(Len(message.quoteUpdateAcknowledgmentQuote), 1)
        \o EncodeQuoteUpdateAcknowledgmentQuoteList(message.quoteUpdateAcknowledgmentQuote)

DecodeQuoteUpdateAcknowledgmentMessage(bytes) ==
    LET transactionTime == ReadBytes(bytes, 8) IN IF ~transactionTime.ok THEN Fail ELSE
    LET quoteUpdateId == ReadBytes(transactionTime.rest, 16) IN IF ~quoteUpdateId.ok THEN Fail ELSE
    LET quoteRejectReason == ReadBytes(quoteUpdateId.rest, 1) IN IF ~quoteRejectReason.ok THEN Fail ELSE
    LET reserved17 == ReadBytes(quoteRejectReason.rest, 17) IN IF ~reserved17.ok THEN Fail ELSE
    LET quoteCnt == ReadUIntBE(reserved17.rest, 1) IN IF ~quoteCnt.ok THEN Fail ELSE
    LET quoteUpdateAcknowledgmentQuote == ReadQuoteUpdateAcknowledgmentQuoteList(quoteCnt.rest, quoteCnt.value) IN IF ~quoteUpdateAcknowledgmentQuote.ok THEN Fail ELSE
    Ok([ transactionTime                |-> transactionTime.value,
         quoteUpdateId                  |-> quoteUpdateId.value,
         quoteRejectReason              |-> quoteRejectReason.value,
         reserved17                     |-> reserved17.value,
         quoteUpdateAcknowledgmentQuote |-> quoteUpdateAcknowledgmentQuote.value ], quoteUpdateAcknowledgmentQuote.rest)

ZeroQuoteUpdateAcknowledgmentMessage ==
    [ transactionTime                |-> [i \in 1 .. 8 |-> 0],
      quoteUpdateId                  |-> [i \in 1 .. 16 |-> 0],
      quoteRejectReason              |-> [i \in 1 .. 1 |-> 0],
      reserved17                     |-> [i \in 1 .. 17 |-> 0],
      quoteUpdateAcknowledgmentQuote |-> << >> ]

(* Quote Update Acknowledgment Message at zero, then each field in turn at the values it is checked at *)
CheckedQuoteUpdateAcknowledgmentMessage ==
    { ZeroQuoteUpdateAcknowledgmentMessage }
        \cup { [ZeroQuoteUpdateAcknowledgmentMessage EXCEPT !.transactionTime = one] : one \in Sample(8) }
        \cup { [ZeroQuoteUpdateAcknowledgmentMessage EXCEPT !.quoteUpdateId = one] : one \in Sample(16) }
        \cup { [ZeroQuoteUpdateAcknowledgmentMessage EXCEPT !.quoteRejectReason = one] : one \in Sample(1) }
        \cup { [ZeroQuoteUpdateAcknowledgmentMessage EXCEPT !.reserved17 = one] : one \in Sample(17) }
        \cup { [ZeroQuoteUpdateAcknowledgmentMessage EXCEPT !.quoteUpdateAcknowledgmentQuote = one] : one \in SampleLists(OneQuoteUpdateAcknowledgmentQuote) }

(***************************************************************************)
(* Order Rejected V 2 Message                                              *)
(***************************************************************************)

OrderRejectedV2Message ==
    [ transactionTime                 : Sample(8),
      clOrdId                         : Sample(20),
      orderRejectReason               : Sample(1),
      text                            : Sample(60),
      reserved1                       : Sample(1),
      numberOfReturnBitfields         : 0 .. 255,
      orderRejectedV2ReturnBitfield1  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderRejectedV2ReturnBitfield2  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderRejectedV2ReturnBitfield3  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderRejectedV2ReturnBitfield4  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderRejectedV2ReturnBitfield5  : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderRejectedV2ReturnBitfield6  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderRejectedV2ReturnBitfield7  : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderRejectedV2ReturnBitfield8  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderRejectedV2ReturnBitfield9  : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderRejectedV2ReturnBitfield10 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderRejectedV2ReturnBitfield11 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderRejectedV2ReturnBitfield12 : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderRejectedV2ReturnBitfield13 : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderRejectedV2ReturnBitfield14 : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderRejectedV2ReturnBitfield15 : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderRejectedV2ReturnBitfield16 : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderRejectedV2ReturnBitfield17 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderRejectedV2ReturnBitfield18 : { << >> } \cup { <<held>> : held \in 0 .. 255 },
      orderRejectedV2ReturnBitfield19 : { << >> } \cup { <<held>> : held \in Sample(1) },
      side                            : { << >> } \cup { <<held>> : held \in Sample(1) },
      price                           : { << >> } \cup { <<held>> : held \in Sample(8) },
      ordType                         : { << >> } \cup { <<held>> : held \in Sample(1) },
      timeInForce                     : { << >> } \cup { <<held>> : held \in Sample(1) },
      minQty                          : { << >> } \cup { <<held>> : held \in Sample(4) },
      symbolLong                      : { << >> } \cup { <<held>> : held \in Sample(8) },
      idSource                        : { << >> } \cup { <<held>> : held \in Sample(1) },
      securityId                      : { << >> } \cup { <<held>> : held \in Sample(16) },
      capacity                        : { << >> } \cup { <<held>> : held \in Sample(1) },
      account                         : { << >> } \cup { <<held>> : held \in Sample(16) },
      clearingFirm                    : { << >> } \cup { <<held>> : held \in Sample(4) },
      clearingAccount                 : { << >> } \cup { <<held>> : held \in Sample(4) },
      displayIndicator                : { << >> } \cup { <<held>> : held \in Sample(1) },
      orderQty                        : { << >> } \cup { <<held>> : held \in Sample(4) },
      preventMatch                    : { << >> } \cup { <<held>> : held \in Sample(3) },
      openClose                       : { << >> } \cup { <<held>> : held \in Sample(1) },
      secondaryOrderId                : { << >> } \cup { <<held>> : held \in Sample(8) },
      extExecInst                     : { << >> } \cup { <<held>> : held \in Sample(1) },
      stopPx                          : { << >> } \cup { <<held>> : held \in Sample(8) },
      routingInst                     : { << >> } \cup { <<held>> : held \in Sample(4) },
      liquidityProvision              : { << >> } \cup { <<held>> : held \in Sample(1) },
      clientQualifiedRole             : { << >> } \cup { <<held>> : held \in Sample(1) },
      clientId                        : { << >> } \cup { <<held>> : held \in Sample(4) },
      investorId                      : { << >> } \cup { <<held>> : held \in Sample(4) },
      executorId                      : { << >> } \cup { <<held>> : held \in Sample(4) },
      orderOrigination                : { << >> } \cup { <<held>> : held \in Sample(1) },
      algorithmicIndicator            : { << >> } \cup { <<held>> : held \in Sample(1) },
      investorQualifiedRole           : { << >> } \cup { <<held>> : held \in Sample(1) },
      executorQualifiedRole           : { << >> } \cup { <<held>> : held \in Sample(1) },
      custOrderHandlingInst           : { << >> } \cup { <<held>> : held \in Sample(1) },
      accountType                     : { << >> } \cup { <<held>> : held \in Sample(1) },
      subreason                       : { << >> } \cup { <<held>> : held \in Sample(1) } ]

EncodeOrderRejectedV2Message(message) ==
    message.transactionTime
        \o message.clOrdId
        \o message.orderRejectReason
        \o message.text
        \o message.reserved1
        \o EncodeUIntBE(message.numberOfReturnBitfields, 1)
        \o (IF message.orderRejectedV2ReturnBitfield1 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRejectedV2ReturnBitfield1[1], 1))
        \o (IF message.orderRejectedV2ReturnBitfield2 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRejectedV2ReturnBitfield2[1], 1))
        \o (IF message.orderRejectedV2ReturnBitfield3 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRejectedV2ReturnBitfield3[1], 1))
        \o (IF message.orderRejectedV2ReturnBitfield4 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRejectedV2ReturnBitfield4[1], 1))
        \o (IF message.orderRejectedV2ReturnBitfield5 = << >> THEN << >> ELSE message.orderRejectedV2ReturnBitfield5[1])
        \o (IF message.orderRejectedV2ReturnBitfield6 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRejectedV2ReturnBitfield6[1], 1))
        \o (IF message.orderRejectedV2ReturnBitfield7 = << >> THEN << >> ELSE message.orderRejectedV2ReturnBitfield7[1])
        \o (IF message.orderRejectedV2ReturnBitfield8 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRejectedV2ReturnBitfield8[1], 1))
        \o (IF message.orderRejectedV2ReturnBitfield9 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRejectedV2ReturnBitfield9[1], 1))
        \o (IF message.orderRejectedV2ReturnBitfield10 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRejectedV2ReturnBitfield10[1], 1))
        \o (IF message.orderRejectedV2ReturnBitfield11 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRejectedV2ReturnBitfield11[1], 1))
        \o (IF message.orderRejectedV2ReturnBitfield12 = << >> THEN << >> ELSE message.orderRejectedV2ReturnBitfield12[1])
        \o (IF message.orderRejectedV2ReturnBitfield13 = << >> THEN << >> ELSE message.orderRejectedV2ReturnBitfield13[1])
        \o (IF message.orderRejectedV2ReturnBitfield14 = << >> THEN << >> ELSE message.orderRejectedV2ReturnBitfield14[1])
        \o (IF message.orderRejectedV2ReturnBitfield15 = << >> THEN << >> ELSE message.orderRejectedV2ReturnBitfield15[1])
        \o (IF message.orderRejectedV2ReturnBitfield16 = << >> THEN << >> ELSE message.orderRejectedV2ReturnBitfield16[1])
        \o (IF message.orderRejectedV2ReturnBitfield17 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRejectedV2ReturnBitfield17[1], 1))
        \o (IF message.orderRejectedV2ReturnBitfield18 = << >> THEN << >> ELSE EncodeUIntLE(message.orderRejectedV2ReturnBitfield18[1], 1))
        \o (IF message.orderRejectedV2ReturnBitfield19 = << >> THEN << >> ELSE message.orderRejectedV2ReturnBitfield19[1])
        \o (IF message.side = << >> THEN << >> ELSE message.side[1])
        \o (IF message.price = << >> THEN << >> ELSE message.price[1])
        \o (IF message.ordType = << >> THEN << >> ELSE message.ordType[1])
        \o (IF message.timeInForce = << >> THEN << >> ELSE message.timeInForce[1])
        \o (IF message.minQty = << >> THEN << >> ELSE message.minQty[1])
        \o (IF message.symbolLong = << >> THEN << >> ELSE message.symbolLong[1])
        \o (IF message.idSource = << >> THEN << >> ELSE message.idSource[1])
        \o (IF message.securityId = << >> THEN << >> ELSE message.securityId[1])
        \o (IF message.capacity = << >> THEN << >> ELSE message.capacity[1])
        \o (IF message.account = << >> THEN << >> ELSE message.account[1])
        \o (IF message.clearingFirm = << >> THEN << >> ELSE message.clearingFirm[1])
        \o (IF message.clearingAccount = << >> THEN << >> ELSE message.clearingAccount[1])
        \o (IF message.displayIndicator = << >> THEN << >> ELSE message.displayIndicator[1])
        \o (IF message.orderQty = << >> THEN << >> ELSE message.orderQty[1])
        \o (IF message.preventMatch = << >> THEN << >> ELSE message.preventMatch[1])
        \o (IF message.openClose = << >> THEN << >> ELSE message.openClose[1])
        \o (IF message.secondaryOrderId = << >> THEN << >> ELSE message.secondaryOrderId[1])
        \o (IF message.extExecInst = << >> THEN << >> ELSE message.extExecInst[1])
        \o (IF message.stopPx = << >> THEN << >> ELSE message.stopPx[1])
        \o (IF message.routingInst = << >> THEN << >> ELSE message.routingInst[1])
        \o (IF message.liquidityProvision = << >> THEN << >> ELSE message.liquidityProvision[1])
        \o (IF message.clientQualifiedRole = << >> THEN << >> ELSE message.clientQualifiedRole[1])
        \o (IF message.clientId = << >> THEN << >> ELSE message.clientId[1])
        \o (IF message.investorId = << >> THEN << >> ELSE message.investorId[1])
        \o (IF message.executorId = << >> THEN << >> ELSE message.executorId[1])
        \o (IF message.orderOrigination = << >> THEN << >> ELSE message.orderOrigination[1])
        \o (IF message.algorithmicIndicator = << >> THEN << >> ELSE message.algorithmicIndicator[1])
        \o (IF message.investorQualifiedRole = << >> THEN << >> ELSE message.investorQualifiedRole[1])
        \o (IF message.executorQualifiedRole = << >> THEN << >> ELSE message.executorQualifiedRole[1])
        \o (IF message.custOrderHandlingInst = << >> THEN << >> ELSE message.custOrderHandlingInst[1])
        \o (IF message.accountType = << >> THEN << >> ELSE message.accountType[1])
        \o (IF message.subreason = << >> THEN << >> ELSE message.subreason[1])

DecodeOrderRejectedV2Message(bytes) ==
    LET transactionTime == ReadBytes(bytes, 8) IN IF ~transactionTime.ok THEN Fail ELSE
    LET clOrdId == ReadBytes(transactionTime.rest, 20) IN IF ~clOrdId.ok THEN Fail ELSE
    LET orderRejectReason == ReadBytes(clOrdId.rest, 1) IN IF ~orderRejectReason.ok THEN Fail ELSE
    LET text == ReadBytes(orderRejectReason.rest, 60) IN IF ~text.ok THEN Fail ELSE
    LET reserved1 == ReadBytes(text.rest, 1) IN IF ~reserved1.ok THEN Fail ELSE
    LET numberOfReturnBitfields == ReadUIntBE(reserved1.rest, 1) IN IF ~numberOfReturnBitfields.ok THEN Fail ELSE
    LET orderRejectedV2ReturnBitfield1 == ReadWhen(numberOfReturnBitfields.value >= 1, ReadUIntLE(numberOfReturnBitfields.rest, 1), numberOfReturnBitfields.rest) IN IF ~orderRejectedV2ReturnBitfield1.ok THEN Fail ELSE
    LET orderRejectedV2ReturnBitfield2 == ReadWhen(numberOfReturnBitfields.value >= 2, ReadUIntLE(orderRejectedV2ReturnBitfield1.rest, 1), orderRejectedV2ReturnBitfield1.rest) IN IF ~orderRejectedV2ReturnBitfield2.ok THEN Fail ELSE
    LET orderRejectedV2ReturnBitfield3 == ReadWhen(numberOfReturnBitfields.value >= 3, ReadUIntLE(orderRejectedV2ReturnBitfield2.rest, 1), orderRejectedV2ReturnBitfield2.rest) IN IF ~orderRejectedV2ReturnBitfield3.ok THEN Fail ELSE
    LET orderRejectedV2ReturnBitfield4 == ReadWhen(numberOfReturnBitfields.value >= 4, ReadUIntLE(orderRejectedV2ReturnBitfield3.rest, 1), orderRejectedV2ReturnBitfield3.rest) IN IF ~orderRejectedV2ReturnBitfield4.ok THEN Fail ELSE
    LET orderRejectedV2ReturnBitfield5 == ReadWhen(numberOfReturnBitfields.value >= 5, ReadBytes(orderRejectedV2ReturnBitfield4.rest, 1), orderRejectedV2ReturnBitfield4.rest) IN IF ~orderRejectedV2ReturnBitfield5.ok THEN Fail ELSE
    LET orderRejectedV2ReturnBitfield6 == ReadWhen(numberOfReturnBitfields.value >= 6, ReadUIntLE(orderRejectedV2ReturnBitfield5.rest, 1), orderRejectedV2ReturnBitfield5.rest) IN IF ~orderRejectedV2ReturnBitfield6.ok THEN Fail ELSE
    LET orderRejectedV2ReturnBitfield7 == ReadWhen(numberOfReturnBitfields.value >= 7, ReadBytes(orderRejectedV2ReturnBitfield6.rest, 1), orderRejectedV2ReturnBitfield6.rest) IN IF ~orderRejectedV2ReturnBitfield7.ok THEN Fail ELSE
    LET orderRejectedV2ReturnBitfield8 == ReadWhen(numberOfReturnBitfields.value >= 8, ReadUIntLE(orderRejectedV2ReturnBitfield7.rest, 1), orderRejectedV2ReturnBitfield7.rest) IN IF ~orderRejectedV2ReturnBitfield8.ok THEN Fail ELSE
    LET orderRejectedV2ReturnBitfield9 == ReadWhen(numberOfReturnBitfields.value >= 9, ReadUIntLE(orderRejectedV2ReturnBitfield8.rest, 1), orderRejectedV2ReturnBitfield8.rest) IN IF ~orderRejectedV2ReturnBitfield9.ok THEN Fail ELSE
    LET orderRejectedV2ReturnBitfield10 == ReadWhen(numberOfReturnBitfields.value >= 10, ReadUIntLE(orderRejectedV2ReturnBitfield9.rest, 1), orderRejectedV2ReturnBitfield9.rest) IN IF ~orderRejectedV2ReturnBitfield10.ok THEN Fail ELSE
    LET orderRejectedV2ReturnBitfield11 == ReadWhen(numberOfReturnBitfields.value >= 11, ReadUIntLE(orderRejectedV2ReturnBitfield10.rest, 1), orderRejectedV2ReturnBitfield10.rest) IN IF ~orderRejectedV2ReturnBitfield11.ok THEN Fail ELSE
    LET orderRejectedV2ReturnBitfield12 == ReadWhen(numberOfReturnBitfields.value >= 12, ReadBytes(orderRejectedV2ReturnBitfield11.rest, 1), orderRejectedV2ReturnBitfield11.rest) IN IF ~orderRejectedV2ReturnBitfield12.ok THEN Fail ELSE
    LET orderRejectedV2ReturnBitfield13 == ReadWhen(numberOfReturnBitfields.value >= 13, ReadBytes(orderRejectedV2ReturnBitfield12.rest, 1), orderRejectedV2ReturnBitfield12.rest) IN IF ~orderRejectedV2ReturnBitfield13.ok THEN Fail ELSE
    LET orderRejectedV2ReturnBitfield14 == ReadWhen(numberOfReturnBitfields.value >= 14, ReadBytes(orderRejectedV2ReturnBitfield13.rest, 1), orderRejectedV2ReturnBitfield13.rest) IN IF ~orderRejectedV2ReturnBitfield14.ok THEN Fail ELSE
    LET orderRejectedV2ReturnBitfield15 == ReadWhen(numberOfReturnBitfields.value >= 15, ReadBytes(orderRejectedV2ReturnBitfield14.rest, 1), orderRejectedV2ReturnBitfield14.rest) IN IF ~orderRejectedV2ReturnBitfield15.ok THEN Fail ELSE
    LET orderRejectedV2ReturnBitfield16 == ReadWhen(numberOfReturnBitfields.value >= 16, ReadBytes(orderRejectedV2ReturnBitfield15.rest, 1), orderRejectedV2ReturnBitfield15.rest) IN IF ~orderRejectedV2ReturnBitfield16.ok THEN Fail ELSE
    LET orderRejectedV2ReturnBitfield17 == ReadWhen(numberOfReturnBitfields.value >= 17, ReadUIntLE(orderRejectedV2ReturnBitfield16.rest, 1), orderRejectedV2ReturnBitfield16.rest) IN IF ~orderRejectedV2ReturnBitfield17.ok THEN Fail ELSE
    LET orderRejectedV2ReturnBitfield18 == ReadWhen(numberOfReturnBitfields.value >= 18, ReadUIntLE(orderRejectedV2ReturnBitfield17.rest, 1), orderRejectedV2ReturnBitfield17.rest) IN IF ~orderRejectedV2ReturnBitfield18.ok THEN Fail ELSE
    LET orderRejectedV2ReturnBitfield19 == ReadWhen(numberOfReturnBitfields.value >= 19, ReadBytes(orderRejectedV2ReturnBitfield18.rest, 1), orderRejectedV2ReturnBitfield18.rest) IN IF ~orderRejectedV2ReturnBitfield19.ok THEN Fail ELSE
    LET side == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderRejectedV2ReturnBitfield1.value # << >> /\ orderRejectedV2ReturnBitfield1.value[1] % 2 > 0), ReadBytes(orderRejectedV2ReturnBitfield19.rest, 1), orderRejectedV2ReturnBitfield19.rest) IN IF ~side.ok THEN Fail ELSE
    LET price == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderRejectedV2ReturnBitfield1.value # << >> /\ (orderRejectedV2ReturnBitfield1.value[1] \div 4) % 2 > 0), ReadBytes(side.rest, 8), side.rest) IN IF ~price.ok THEN Fail ELSE
    LET ordType == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderRejectedV2ReturnBitfield1.value # << >> /\ (orderRejectedV2ReturnBitfield1.value[1] \div 16) % 2 > 0), ReadBytes(price.rest, 1), price.rest) IN IF ~ordType.ok THEN Fail ELSE
    LET timeInForce == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderRejectedV2ReturnBitfield1.value # << >> /\ (orderRejectedV2ReturnBitfield1.value[1] \div 32) % 2 > 0), ReadBytes(ordType.rest, 1), ordType.rest) IN IF ~timeInForce.ok THEN Fail ELSE
    LET minQty == ReadWhen(numberOfReturnBitfields.value >= 1 /\ (orderRejectedV2ReturnBitfield1.value # << >> /\ (orderRejectedV2ReturnBitfield1.value[1] \div 64) % 2 > 0), ReadBytes(timeInForce.rest, 4), timeInForce.rest) IN IF ~minQty.ok THEN Fail ELSE
    LET symbolLong == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (orderRejectedV2ReturnBitfield2.value # << >> /\ orderRejectedV2ReturnBitfield2.value[1] % 2 > 0), ReadBytes(minQty.rest, 8), minQty.rest) IN IF ~symbolLong.ok THEN Fail ELSE
    LET idSource == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (orderRejectedV2ReturnBitfield2.value # << >> /\ (orderRejectedV2ReturnBitfield2.value[1] \div 8) % 2 > 0), ReadBytes(symbolLong.rest, 1), symbolLong.rest) IN IF ~idSource.ok THEN Fail ELSE
    LET securityId == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (orderRejectedV2ReturnBitfield2.value # << >> /\ (orderRejectedV2ReturnBitfield2.value[1] \div 16) % 2 > 0), ReadBytes(idSource.rest, 16), idSource.rest) IN IF ~securityId.ok THEN Fail ELSE
    LET capacity == ReadWhen(numberOfReturnBitfields.value >= 2 /\ (orderRejectedV2ReturnBitfield2.value # << >> /\ (orderRejectedV2ReturnBitfield2.value[1] \div 64) % 2 > 0), ReadBytes(securityId.rest, 1), securityId.rest) IN IF ~capacity.ok THEN Fail ELSE
    LET account == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderRejectedV2ReturnBitfield3.value # << >> /\ orderRejectedV2ReturnBitfield3.value[1] % 2 > 0), ReadBytes(capacity.rest, 16), capacity.rest) IN IF ~account.ok THEN Fail ELSE
    LET clearingFirm == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderRejectedV2ReturnBitfield3.value # << >> /\ (orderRejectedV2ReturnBitfield3.value[1] \div 2) % 2 > 0), ReadBytes(account.rest, 4), account.rest) IN IF ~clearingFirm.ok THEN Fail ELSE
    LET clearingAccount == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderRejectedV2ReturnBitfield3.value # << >> /\ (orderRejectedV2ReturnBitfield3.value[1] \div 4) % 2 > 0), ReadBytes(clearingFirm.rest, 4), clearingFirm.rest) IN IF ~clearingAccount.ok THEN Fail ELSE
    LET displayIndicator == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderRejectedV2ReturnBitfield3.value # << >> /\ (orderRejectedV2ReturnBitfield3.value[1] \div 8) % 2 > 0), ReadBytes(clearingAccount.rest, 1), clearingAccount.rest) IN IF ~displayIndicator.ok THEN Fail ELSE
    LET orderQty == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderRejectedV2ReturnBitfield3.value # << >> /\ (orderRejectedV2ReturnBitfield3.value[1] \div 64) % 2 > 0), ReadBytes(displayIndicator.rest, 4), displayIndicator.rest) IN IF ~orderQty.ok THEN Fail ELSE
    LET preventMatch == ReadWhen(numberOfReturnBitfields.value >= 3 /\ (orderRejectedV2ReturnBitfield3.value # << >> /\ (orderRejectedV2ReturnBitfield3.value[1] \div 128) % 2 > 0), ReadBytes(orderQty.rest, 3), orderQty.rest) IN IF ~preventMatch.ok THEN Fail ELSE
    LET openClose == ReadWhen(numberOfReturnBitfields.value >= 4 /\ (orderRejectedV2ReturnBitfield4.value # << >> /\ (orderRejectedV2ReturnBitfield4.value[1] \div 8) % 2 > 0), ReadBytes(preventMatch.rest, 1), preventMatch.rest) IN IF ~openClose.ok THEN Fail ELSE
    LET secondaryOrderId == ReadWhen(numberOfReturnBitfields.value >= 6 /\ (orderRejectedV2ReturnBitfield6.value # << >> /\ orderRejectedV2ReturnBitfield6.value[1] % 2 > 0), ReadBytes(openClose.rest, 8), openClose.rest) IN IF ~secondaryOrderId.ok THEN Fail ELSE
    LET extExecInst == ReadWhen(numberOfReturnBitfields.value >= 6 /\ (orderRejectedV2ReturnBitfield6.value # << >> /\ (orderRejectedV2ReturnBitfield6.value[1] \div 16) % 2 > 0), ReadBytes(secondaryOrderId.rest, 1), secondaryOrderId.rest) IN IF ~extExecInst.ok THEN Fail ELSE
    LET stopPx == ReadWhen(numberOfReturnBitfields.value >= 8 /\ (orderRejectedV2ReturnBitfield8.value # << >> /\ (orderRejectedV2ReturnBitfield8.value[1] \div 4) % 2 > 0), ReadBytes(extExecInst.rest, 8), extExecInst.rest) IN IF ~stopPx.ok THEN Fail ELSE
    LET routingInst == ReadWhen(numberOfReturnBitfields.value >= 8 /\ (orderRejectedV2ReturnBitfield8.value # << >> /\ (orderRejectedV2ReturnBitfield8.value[1] \div 8) % 2 > 0), ReadBytes(stopPx.rest, 4), stopPx.rest) IN IF ~routingInst.ok THEN Fail ELSE
    LET liquidityProvision == ReadWhen(numberOfReturnBitfields.value >= 9 /\ (orderRejectedV2ReturnBitfield9.value # << >> /\ (orderRejectedV2ReturnBitfield9.value[1] \div 16) % 2 > 0), ReadBytes(routingInst.rest, 1), routingInst.rest) IN IF ~liquidityProvision.ok THEN Fail ELSE
    LET clientQualifiedRole == ReadWhen(numberOfReturnBitfields.value >= 10 /\ (orderRejectedV2ReturnBitfield10.value # << >> /\ (orderRejectedV2ReturnBitfield10.value[1] \div 128) % 2 > 0), ReadBytes(liquidityProvision.rest, 1), liquidityProvision.rest) IN IF ~clientQualifiedRole.ok THEN Fail ELSE
    LET clientId == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (orderRejectedV2ReturnBitfield11.value # << >> /\ orderRejectedV2ReturnBitfield11.value[1] % 2 > 0), ReadBytes(clientQualifiedRole.rest, 4), clientQualifiedRole.rest) IN IF ~clientId.ok THEN Fail ELSE
    LET investorId == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (orderRejectedV2ReturnBitfield11.value # << >> /\ (orderRejectedV2ReturnBitfield11.value[1] \div 2) % 2 > 0), ReadBytes(clientId.rest, 4), clientId.rest) IN IF ~investorId.ok THEN Fail ELSE
    LET executorId == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (orderRejectedV2ReturnBitfield11.value # << >> /\ (orderRejectedV2ReturnBitfield11.value[1] \div 4) % 2 > 0), ReadBytes(investorId.rest, 4), investorId.rest) IN IF ~executorId.ok THEN Fail ELSE
    LET orderOrigination == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (orderRejectedV2ReturnBitfield11.value # << >> /\ (orderRejectedV2ReturnBitfield11.value[1] \div 8) % 2 > 0), ReadBytes(executorId.rest, 1), executorId.rest) IN IF ~orderOrigination.ok THEN Fail ELSE
    LET algorithmicIndicator == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (orderRejectedV2ReturnBitfield11.value # << >> /\ (orderRejectedV2ReturnBitfield11.value[1] \div 16) % 2 > 0), ReadBytes(orderOrigination.rest, 1), orderOrigination.rest) IN IF ~algorithmicIndicator.ok THEN Fail ELSE
    LET investorQualifiedRole == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (orderRejectedV2ReturnBitfield11.value # << >> /\ (orderRejectedV2ReturnBitfield11.value[1] \div 64) % 2 > 0), ReadBytes(algorithmicIndicator.rest, 1), algorithmicIndicator.rest) IN IF ~investorQualifiedRole.ok THEN Fail ELSE
    LET executorQualifiedRole == ReadWhen(numberOfReturnBitfields.value >= 11 /\ (orderRejectedV2ReturnBitfield11.value # << >> /\ (orderRejectedV2ReturnBitfield11.value[1] \div 128) % 2 > 0), ReadBytes(investorQualifiedRole.rest, 1), investorQualifiedRole.rest) IN IF ~executorQualifiedRole.ok THEN Fail ELSE
    LET custOrderHandlingInst == ReadWhen(numberOfReturnBitfields.value >= 17 /\ (orderRejectedV2ReturnBitfield17.value # << >> /\ (orderRejectedV2ReturnBitfield17.value[1] \div 128) % 2 > 0), ReadBytes(executorQualifiedRole.rest, 1), executorQualifiedRole.rest) IN IF ~custOrderHandlingInst.ok THEN Fail ELSE
    LET accountType == ReadWhen(numberOfReturnBitfields.value >= 18 /\ (orderRejectedV2ReturnBitfield18.value # << >> /\ orderRejectedV2ReturnBitfield18.value[1] % 2 > 0), ReadBytes(custOrderHandlingInst.rest, 1), custOrderHandlingInst.rest) IN IF ~accountType.ok THEN Fail ELSE
    LET subreason == ReadWhen(numberOfReturnBitfields.value >= 18 /\ (orderRejectedV2ReturnBitfield18.value # << >> /\ (orderRejectedV2ReturnBitfield18.value[1] \div 4) % 2 > 0), ReadBytes(accountType.rest, 1), accountType.rest) IN IF ~subreason.ok THEN Fail ELSE
    Ok([ transactionTime                 |-> transactionTime.value,
         clOrdId                         |-> clOrdId.value,
         orderRejectReason               |-> orderRejectReason.value,
         text                            |-> text.value,
         reserved1                       |-> reserved1.value,
         numberOfReturnBitfields         |-> numberOfReturnBitfields.value,
         orderRejectedV2ReturnBitfield1  |-> orderRejectedV2ReturnBitfield1.value,
         orderRejectedV2ReturnBitfield2  |-> orderRejectedV2ReturnBitfield2.value,
         orderRejectedV2ReturnBitfield3  |-> orderRejectedV2ReturnBitfield3.value,
         orderRejectedV2ReturnBitfield4  |-> orderRejectedV2ReturnBitfield4.value,
         orderRejectedV2ReturnBitfield5  |-> orderRejectedV2ReturnBitfield5.value,
         orderRejectedV2ReturnBitfield6  |-> orderRejectedV2ReturnBitfield6.value,
         orderRejectedV2ReturnBitfield7  |-> orderRejectedV2ReturnBitfield7.value,
         orderRejectedV2ReturnBitfield8  |-> orderRejectedV2ReturnBitfield8.value,
         orderRejectedV2ReturnBitfield9  |-> orderRejectedV2ReturnBitfield9.value,
         orderRejectedV2ReturnBitfield10 |-> orderRejectedV2ReturnBitfield10.value,
         orderRejectedV2ReturnBitfield11 |-> orderRejectedV2ReturnBitfield11.value,
         orderRejectedV2ReturnBitfield12 |-> orderRejectedV2ReturnBitfield12.value,
         orderRejectedV2ReturnBitfield13 |-> orderRejectedV2ReturnBitfield13.value,
         orderRejectedV2ReturnBitfield14 |-> orderRejectedV2ReturnBitfield14.value,
         orderRejectedV2ReturnBitfield15 |-> orderRejectedV2ReturnBitfield15.value,
         orderRejectedV2ReturnBitfield16 |-> orderRejectedV2ReturnBitfield16.value,
         orderRejectedV2ReturnBitfield17 |-> orderRejectedV2ReturnBitfield17.value,
         orderRejectedV2ReturnBitfield18 |-> orderRejectedV2ReturnBitfield18.value,
         orderRejectedV2ReturnBitfield19 |-> orderRejectedV2ReturnBitfield19.value,
         side                            |-> side.value,
         price                           |-> price.value,
         ordType                         |-> ordType.value,
         timeInForce                     |-> timeInForce.value,
         minQty                          |-> minQty.value,
         symbolLong                      |-> symbolLong.value,
         idSource                        |-> idSource.value,
         securityId                      |-> securityId.value,
         capacity                        |-> capacity.value,
         account                         |-> account.value,
         clearingFirm                    |-> clearingFirm.value,
         clearingAccount                 |-> clearingAccount.value,
         displayIndicator                |-> displayIndicator.value,
         orderQty                        |-> orderQty.value,
         preventMatch                    |-> preventMatch.value,
         openClose                       |-> openClose.value,
         secondaryOrderId                |-> secondaryOrderId.value,
         extExecInst                     |-> extExecInst.value,
         stopPx                          |-> stopPx.value,
         routingInst                     |-> routingInst.value,
         liquidityProvision              |-> liquidityProvision.value,
         clientQualifiedRole             |-> clientQualifiedRole.value,
         clientId                        |-> clientId.value,
         investorId                      |-> investorId.value,
         executorId                      |-> executorId.value,
         orderOrigination                |-> orderOrigination.value,
         algorithmicIndicator            |-> algorithmicIndicator.value,
         investorQualifiedRole           |-> investorQualifiedRole.value,
         executorQualifiedRole           |-> executorQualifiedRole.value,
         custOrderHandlingInst           |-> custOrderHandlingInst.value,
         accountType                     |-> accountType.value,
         subreason                       |-> subreason.value ], subreason.rest)

(* Order Rejected V 2 Message with each field marked present by fields before it there exactly where they say *)
SettleOrderRejectedV2Message(message) ==
    LET settled1 == [message EXCEPT !.orderRejectedV2ReturnBitfield1 = IF message.numberOfReturnBitfields >= 1 THEN (IF message.orderRejectedV2ReturnBitfield1 = << >> THEN <<0>> ELSE message.orderRejectedV2ReturnBitfield1) ELSE << >>]
        settled2 == [settled1 EXCEPT !.orderRejectedV2ReturnBitfield2 = IF settled1.numberOfReturnBitfields >= 2 THEN (IF settled1.orderRejectedV2ReturnBitfield2 = << >> THEN <<0>> ELSE settled1.orderRejectedV2ReturnBitfield2) ELSE << >>]
        settled3 == [settled2 EXCEPT !.orderRejectedV2ReturnBitfield3 = IF settled2.numberOfReturnBitfields >= 3 THEN (IF settled2.orderRejectedV2ReturnBitfield3 = << >> THEN <<0>> ELSE settled2.orderRejectedV2ReturnBitfield3) ELSE << >>]
        settled4 == [settled3 EXCEPT !.orderRejectedV2ReturnBitfield4 = IF settled3.numberOfReturnBitfields >= 4 THEN (IF settled3.orderRejectedV2ReturnBitfield4 = << >> THEN <<0>> ELSE settled3.orderRejectedV2ReturnBitfield4) ELSE << >>]
        settled5 == [settled4 EXCEPT !.orderRejectedV2ReturnBitfield5 = IF settled4.numberOfReturnBitfields >= 5 THEN (IF settled4.orderRejectedV2ReturnBitfield5 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled4.orderRejectedV2ReturnBitfield5) ELSE << >>]
        settled6 == [settled5 EXCEPT !.orderRejectedV2ReturnBitfield6 = IF settled5.numberOfReturnBitfields >= 6 THEN (IF settled5.orderRejectedV2ReturnBitfield6 = << >> THEN <<0>> ELSE settled5.orderRejectedV2ReturnBitfield6) ELSE << >>]
        settled7 == [settled6 EXCEPT !.orderRejectedV2ReturnBitfield7 = IF settled6.numberOfReturnBitfields >= 7 THEN (IF settled6.orderRejectedV2ReturnBitfield7 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled6.orderRejectedV2ReturnBitfield7) ELSE << >>]
        settled8 == [settled7 EXCEPT !.orderRejectedV2ReturnBitfield8 = IF settled7.numberOfReturnBitfields >= 8 THEN (IF settled7.orderRejectedV2ReturnBitfield8 = << >> THEN <<0>> ELSE settled7.orderRejectedV2ReturnBitfield8) ELSE << >>]
        settled9 == [settled8 EXCEPT !.orderRejectedV2ReturnBitfield9 = IF settled8.numberOfReturnBitfields >= 9 THEN (IF settled8.orderRejectedV2ReturnBitfield9 = << >> THEN <<0>> ELSE settled8.orderRejectedV2ReturnBitfield9) ELSE << >>]
        settled10 == [settled9 EXCEPT !.orderRejectedV2ReturnBitfield10 = IF settled9.numberOfReturnBitfields >= 10 THEN (IF settled9.orderRejectedV2ReturnBitfield10 = << >> THEN <<0>> ELSE settled9.orderRejectedV2ReturnBitfield10) ELSE << >>]
        settled11 == [settled10 EXCEPT !.orderRejectedV2ReturnBitfield11 = IF settled10.numberOfReturnBitfields >= 11 THEN (IF settled10.orderRejectedV2ReturnBitfield11 = << >> THEN <<0>> ELSE settled10.orderRejectedV2ReturnBitfield11) ELSE << >>]
        settled12 == [settled11 EXCEPT !.orderRejectedV2ReturnBitfield12 = IF settled11.numberOfReturnBitfields >= 12 THEN (IF settled11.orderRejectedV2ReturnBitfield12 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled11.orderRejectedV2ReturnBitfield12) ELSE << >>]
        settled13 == [settled12 EXCEPT !.orderRejectedV2ReturnBitfield13 = IF settled12.numberOfReturnBitfields >= 13 THEN (IF settled12.orderRejectedV2ReturnBitfield13 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled12.orderRejectedV2ReturnBitfield13) ELSE << >>]
        settled14 == [settled13 EXCEPT !.orderRejectedV2ReturnBitfield14 = IF settled13.numberOfReturnBitfields >= 14 THEN (IF settled13.orderRejectedV2ReturnBitfield14 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled13.orderRejectedV2ReturnBitfield14) ELSE << >>]
        settled15 == [settled14 EXCEPT !.orderRejectedV2ReturnBitfield15 = IF settled14.numberOfReturnBitfields >= 15 THEN (IF settled14.orderRejectedV2ReturnBitfield15 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled14.orderRejectedV2ReturnBitfield15) ELSE << >>]
        settled16 == [settled15 EXCEPT !.orderRejectedV2ReturnBitfield16 = IF settled15.numberOfReturnBitfields >= 16 THEN (IF settled15.orderRejectedV2ReturnBitfield16 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled15.orderRejectedV2ReturnBitfield16) ELSE << >>]
        settled17 == [settled16 EXCEPT !.orderRejectedV2ReturnBitfield17 = IF settled16.numberOfReturnBitfields >= 17 THEN (IF settled16.orderRejectedV2ReturnBitfield17 = << >> THEN <<0>> ELSE settled16.orderRejectedV2ReturnBitfield17) ELSE << >>]
        settled18 == [settled17 EXCEPT !.orderRejectedV2ReturnBitfield18 = IF settled17.numberOfReturnBitfields >= 18 THEN (IF settled17.orderRejectedV2ReturnBitfield18 = << >> THEN <<0>> ELSE settled17.orderRejectedV2ReturnBitfield18) ELSE << >>]
        settled19 == [settled18 EXCEPT !.orderRejectedV2ReturnBitfield19 = IF settled18.numberOfReturnBitfields >= 19 THEN (IF settled18.orderRejectedV2ReturnBitfield19 = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled18.orderRejectedV2ReturnBitfield19) ELSE << >>]
        settled20 == [settled19 EXCEPT !.side = IF settled19.numberOfReturnBitfields >= 1 /\ (settled19.orderRejectedV2ReturnBitfield1 # << >> /\ settled19.orderRejectedV2ReturnBitfield1[1] % 2 > 0) THEN (IF settled19.side = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled19.side) ELSE << >>]
        settled21 == [settled20 EXCEPT !.price = IF settled20.numberOfReturnBitfields >= 1 /\ (settled20.orderRejectedV2ReturnBitfield1 # << >> /\ (settled20.orderRejectedV2ReturnBitfield1[1] \div 4) % 2 > 0) THEN (IF settled20.price = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled20.price) ELSE << >>]
        settled22 == [settled21 EXCEPT !.ordType = IF settled21.numberOfReturnBitfields >= 1 /\ (settled21.orderRejectedV2ReturnBitfield1 # << >> /\ (settled21.orderRejectedV2ReturnBitfield1[1] \div 16) % 2 > 0) THEN (IF settled21.ordType = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled21.ordType) ELSE << >>]
        settled23 == [settled22 EXCEPT !.timeInForce = IF settled22.numberOfReturnBitfields >= 1 /\ (settled22.orderRejectedV2ReturnBitfield1 # << >> /\ (settled22.orderRejectedV2ReturnBitfield1[1] \div 32) % 2 > 0) THEN (IF settled22.timeInForce = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled22.timeInForce) ELSE << >>]
        settled24 == [settled23 EXCEPT !.minQty = IF settled23.numberOfReturnBitfields >= 1 /\ (settled23.orderRejectedV2ReturnBitfield1 # << >> /\ (settled23.orderRejectedV2ReturnBitfield1[1] \div 64) % 2 > 0) THEN (IF settled23.minQty = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled23.minQty) ELSE << >>]
        settled25 == [settled24 EXCEPT !.symbolLong = IF settled24.numberOfReturnBitfields >= 2 /\ (settled24.orderRejectedV2ReturnBitfield2 # << >> /\ settled24.orderRejectedV2ReturnBitfield2[1] % 2 > 0) THEN (IF settled24.symbolLong = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled24.symbolLong) ELSE << >>]
        settled26 == [settled25 EXCEPT !.idSource = IF settled25.numberOfReturnBitfields >= 2 /\ (settled25.orderRejectedV2ReturnBitfield2 # << >> /\ (settled25.orderRejectedV2ReturnBitfield2[1] \div 8) % 2 > 0) THEN (IF settled25.idSource = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled25.idSource) ELSE << >>]
        settled27 == [settled26 EXCEPT !.securityId = IF settled26.numberOfReturnBitfields >= 2 /\ (settled26.orderRejectedV2ReturnBitfield2 # << >> /\ (settled26.orderRejectedV2ReturnBitfield2[1] \div 16) % 2 > 0) THEN (IF settled26.securityId = << >> THEN <<[i \in 1 .. 16 |-> 0]>> ELSE settled26.securityId) ELSE << >>]
        settled28 == [settled27 EXCEPT !.capacity = IF settled27.numberOfReturnBitfields >= 2 /\ (settled27.orderRejectedV2ReturnBitfield2 # << >> /\ (settled27.orderRejectedV2ReturnBitfield2[1] \div 64) % 2 > 0) THEN (IF settled27.capacity = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled27.capacity) ELSE << >>]
        settled29 == [settled28 EXCEPT !.account = IF settled28.numberOfReturnBitfields >= 3 /\ (settled28.orderRejectedV2ReturnBitfield3 # << >> /\ settled28.orderRejectedV2ReturnBitfield3[1] % 2 > 0) THEN (IF settled28.account = << >> THEN <<[i \in 1 .. 16 |-> 0]>> ELSE settled28.account) ELSE << >>]
        settled30 == [settled29 EXCEPT !.clearingFirm = IF settled29.numberOfReturnBitfields >= 3 /\ (settled29.orderRejectedV2ReturnBitfield3 # << >> /\ (settled29.orderRejectedV2ReturnBitfield3[1] \div 2) % 2 > 0) THEN (IF settled29.clearingFirm = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled29.clearingFirm) ELSE << >>]
        settled31 == [settled30 EXCEPT !.clearingAccount = IF settled30.numberOfReturnBitfields >= 3 /\ (settled30.orderRejectedV2ReturnBitfield3 # << >> /\ (settled30.orderRejectedV2ReturnBitfield3[1] \div 4) % 2 > 0) THEN (IF settled30.clearingAccount = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled30.clearingAccount) ELSE << >>]
        settled32 == [settled31 EXCEPT !.displayIndicator = IF settled31.numberOfReturnBitfields >= 3 /\ (settled31.orderRejectedV2ReturnBitfield3 # << >> /\ (settled31.orderRejectedV2ReturnBitfield3[1] \div 8) % 2 > 0) THEN (IF settled31.displayIndicator = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled31.displayIndicator) ELSE << >>]
        settled33 == [settled32 EXCEPT !.orderQty = IF settled32.numberOfReturnBitfields >= 3 /\ (settled32.orderRejectedV2ReturnBitfield3 # << >> /\ (settled32.orderRejectedV2ReturnBitfield3[1] \div 64) % 2 > 0) THEN (IF settled32.orderQty = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled32.orderQty) ELSE << >>]
        settled34 == [settled33 EXCEPT !.preventMatch = IF settled33.numberOfReturnBitfields >= 3 /\ (settled33.orderRejectedV2ReturnBitfield3 # << >> /\ (settled33.orderRejectedV2ReturnBitfield3[1] \div 128) % 2 > 0) THEN (IF settled33.preventMatch = << >> THEN <<[i \in 1 .. 3 |-> 0]>> ELSE settled33.preventMatch) ELSE << >>]
        settled35 == [settled34 EXCEPT !.openClose = IF settled34.numberOfReturnBitfields >= 4 /\ (settled34.orderRejectedV2ReturnBitfield4 # << >> /\ (settled34.orderRejectedV2ReturnBitfield4[1] \div 8) % 2 > 0) THEN (IF settled34.openClose = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled34.openClose) ELSE << >>]
        settled36 == [settled35 EXCEPT !.secondaryOrderId = IF settled35.numberOfReturnBitfields >= 6 /\ (settled35.orderRejectedV2ReturnBitfield6 # << >> /\ settled35.orderRejectedV2ReturnBitfield6[1] % 2 > 0) THEN (IF settled35.secondaryOrderId = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled35.secondaryOrderId) ELSE << >>]
        settled37 == [settled36 EXCEPT !.extExecInst = IF settled36.numberOfReturnBitfields >= 6 /\ (settled36.orderRejectedV2ReturnBitfield6 # << >> /\ (settled36.orderRejectedV2ReturnBitfield6[1] \div 16) % 2 > 0) THEN (IF settled36.extExecInst = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled36.extExecInst) ELSE << >>]
        settled38 == [settled37 EXCEPT !.stopPx = IF settled37.numberOfReturnBitfields >= 8 /\ (settled37.orderRejectedV2ReturnBitfield8 # << >> /\ (settled37.orderRejectedV2ReturnBitfield8[1] \div 4) % 2 > 0) THEN (IF settled37.stopPx = << >> THEN <<[i \in 1 .. 8 |-> 0]>> ELSE settled37.stopPx) ELSE << >>]
        settled39 == [settled38 EXCEPT !.routingInst = IF settled38.numberOfReturnBitfields >= 8 /\ (settled38.orderRejectedV2ReturnBitfield8 # << >> /\ (settled38.orderRejectedV2ReturnBitfield8[1] \div 8) % 2 > 0) THEN (IF settled38.routingInst = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled38.routingInst) ELSE << >>]
        settled40 == [settled39 EXCEPT !.liquidityProvision = IF settled39.numberOfReturnBitfields >= 9 /\ (settled39.orderRejectedV2ReturnBitfield9 # << >> /\ (settled39.orderRejectedV2ReturnBitfield9[1] \div 16) % 2 > 0) THEN (IF settled39.liquidityProvision = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled39.liquidityProvision) ELSE << >>]
        settled41 == [settled40 EXCEPT !.clientQualifiedRole = IF settled40.numberOfReturnBitfields >= 10 /\ (settled40.orderRejectedV2ReturnBitfield10 # << >> /\ (settled40.orderRejectedV2ReturnBitfield10[1] \div 128) % 2 > 0) THEN (IF settled40.clientQualifiedRole = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled40.clientQualifiedRole) ELSE << >>]
        settled42 == [settled41 EXCEPT !.clientId = IF settled41.numberOfReturnBitfields >= 11 /\ (settled41.orderRejectedV2ReturnBitfield11 # << >> /\ settled41.orderRejectedV2ReturnBitfield11[1] % 2 > 0) THEN (IF settled41.clientId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled41.clientId) ELSE << >>]
        settled43 == [settled42 EXCEPT !.investorId = IF settled42.numberOfReturnBitfields >= 11 /\ (settled42.orderRejectedV2ReturnBitfield11 # << >> /\ (settled42.orderRejectedV2ReturnBitfield11[1] \div 2) % 2 > 0) THEN (IF settled42.investorId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled42.investorId) ELSE << >>]
        settled44 == [settled43 EXCEPT !.executorId = IF settled43.numberOfReturnBitfields >= 11 /\ (settled43.orderRejectedV2ReturnBitfield11 # << >> /\ (settled43.orderRejectedV2ReturnBitfield11[1] \div 4) % 2 > 0) THEN (IF settled43.executorId = << >> THEN <<[i \in 1 .. 4 |-> 0]>> ELSE settled43.executorId) ELSE << >>]
        settled45 == [settled44 EXCEPT !.orderOrigination = IF settled44.numberOfReturnBitfields >= 11 /\ (settled44.orderRejectedV2ReturnBitfield11 # << >> /\ (settled44.orderRejectedV2ReturnBitfield11[1] \div 8) % 2 > 0) THEN (IF settled44.orderOrigination = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled44.orderOrigination) ELSE << >>]
        settled46 == [settled45 EXCEPT !.algorithmicIndicator = IF settled45.numberOfReturnBitfields >= 11 /\ (settled45.orderRejectedV2ReturnBitfield11 # << >> /\ (settled45.orderRejectedV2ReturnBitfield11[1] \div 16) % 2 > 0) THEN (IF settled45.algorithmicIndicator = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled45.algorithmicIndicator) ELSE << >>]
        settled47 == [settled46 EXCEPT !.investorQualifiedRole = IF settled46.numberOfReturnBitfields >= 11 /\ (settled46.orderRejectedV2ReturnBitfield11 # << >> /\ (settled46.orderRejectedV2ReturnBitfield11[1] \div 64) % 2 > 0) THEN (IF settled46.investorQualifiedRole = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled46.investorQualifiedRole) ELSE << >>]
        settled48 == [settled47 EXCEPT !.executorQualifiedRole = IF settled47.numberOfReturnBitfields >= 11 /\ (settled47.orderRejectedV2ReturnBitfield11 # << >> /\ (settled47.orderRejectedV2ReturnBitfield11[1] \div 128) % 2 > 0) THEN (IF settled47.executorQualifiedRole = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled47.executorQualifiedRole) ELSE << >>]
        settled49 == [settled48 EXCEPT !.custOrderHandlingInst = IF settled48.numberOfReturnBitfields >= 17 /\ (settled48.orderRejectedV2ReturnBitfield17 # << >> /\ (settled48.orderRejectedV2ReturnBitfield17[1] \div 128) % 2 > 0) THEN (IF settled48.custOrderHandlingInst = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled48.custOrderHandlingInst) ELSE << >>]
        settled50 == [settled49 EXCEPT !.accountType = IF settled49.numberOfReturnBitfields >= 18 /\ (settled49.orderRejectedV2ReturnBitfield18 # << >> /\ settled49.orderRejectedV2ReturnBitfield18[1] % 2 > 0) THEN (IF settled49.accountType = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled49.accountType) ELSE << >>]
        settled51 == [settled50 EXCEPT !.subreason = IF settled50.numberOfReturnBitfields >= 18 /\ (settled50.orderRejectedV2ReturnBitfield18 # << >> /\ (settled50.orderRejectedV2ReturnBitfield18[1] \div 4) % 2 > 0) THEN (IF settled50.subreason = << >> THEN <<[i \in 1 .. 1 |-> 0]>> ELSE settled50.subreason) ELSE << >>]
    IN  settled51

ZeroOrderRejectedV2Message ==
    SettleOrderRejectedV2Message([ transactionTime                 |-> [i \in 1 .. 8 |-> 0],
                                   clOrdId                         |-> [i \in 1 .. 20 |-> 0],
                                   orderRejectReason               |-> [i \in 1 .. 1 |-> 0],
                                   text                            |-> [i \in 1 .. 60 |-> 0],
                                   reserved1                       |-> [i \in 1 .. 1 |-> 0],
                                   numberOfReturnBitfields         |-> 0,
                                   orderRejectedV2ReturnBitfield1  |-> << >>,
                                   orderRejectedV2ReturnBitfield2  |-> << >>,
                                   orderRejectedV2ReturnBitfield3  |-> << >>,
                                   orderRejectedV2ReturnBitfield4  |-> << >>,
                                   orderRejectedV2ReturnBitfield5  |-> << >>,
